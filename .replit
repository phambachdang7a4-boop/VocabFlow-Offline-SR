modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["unar", "unrar"]

[objectStorage]
defaultBucketID = "replit-objstore-cb294c0c-4491-4c26-9252-8dc15f702b14"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[userenv]

[userenv.shared]
CLOUDFLARE_R2_ACCOUNT_ID = "6ceb4a10c8ad2e4879888af9eafb9837"
CLOUDFLARE_R2_BUCKET_NAME = "vocabflowdata-18-11"
CLOUDFLARE_R2_PUBLIC_BASE_URL = "https://pub-48eed62f98c44487841ad2069da22829.r2.dev"
