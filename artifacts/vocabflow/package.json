{
  "name": "@workspace/vocabflow",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PUBLIC_CLERK_PROXY_URL=${CLERK_PROXY_URL:-} EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:speech": "node scripts/check-speech.cjs",
    "check:sound-effects": "node scripts/check-sound-effects.cjs",
    "check:tab-music": "node scripts/check-tab-background-music.cjs",
    "check:pan-loading": "node scripts/check-pan-loading.cjs",
    "check:auth-sync": "node scripts/check-auth-sync.cjs",
    "check:notebook-filter": "node scripts/check-notebook-filter.cjs",
    "check:account-backup": "node scripts/check-account-backup.cjs",
    "check:daily-missions": "node scripts/check-daily-missions.cjs",
    "check:daily-mission-artwork": "node scripts/check-daily-mission-artwork.cjs",
    "check:tab-navigation": "node scripts/check-tab-navigation.cjs",
    "check:daily-mission-storage": "node scripts/check-daily-mission-storage.cjs",
    "check:mission-shop": "node scripts/check-mission-shop.cjs && node scripts/check-mission-shop-storage.cjs",
    "check:stone-investments": "node scripts/check-stone-investment.cjs",
    "check:mission-chests": "node scripts/check-mission-chests.cjs",
    "check:review-session": "node scripts/check-review-session.cjs",
    "check:review-modes": "node scripts/check-review-modes.cjs",
    "check:learning-goal": "node scripts/check-learning-goal.cjs",
    "check:basic-vocabulary-course": "node scripts/check-basic-vocabulary-course.cjs",
    "check:review-ui": "node scripts/check-review-ui.cjs && node scripts/check-review-match-game.cjs",
    "check:course-word-selection": "node scripts/check-course-word-selection.cjs",
    "course:build-dictionary-index": "node scripts/build-course-dictionary-index.cjs",
    "check:course-dictionary-index": "node scripts/check-course-dictionary-index.cjs",
    "check:review-statistics": "node scripts/check-review-statistics.cjs && node scripts/check-review-sessions.cjs",
    "check:reset-and-offline-data": "node scripts/check-reset-and-offline-data.cjs",
    "check:offline-audio-download": "node scripts/check-offline-audio-download.cjs",
    "check:known-example-repair": "node scripts/check-known-example-repair.cjs",
    "check:regional-ipa": "node scripts/check-regional-pronunciations.cjs && node scripts/check-regional-ipa-parts.cjs",
    "check:conjunction-course": "node scripts/check-conjunction-course.cjs && node scripts/check-conjunction-course-ui.cjs",
    "check:office-apps-course": "node scripts/check-office-apps-course.cjs && node scripts/check-conjunction-course-ui.cjs",
    "course:build-idioms": "node scripts/build-idiom-course-data.cjs",
    "course:build-phrasal-verbs": "node scripts/build-phrasal-verb-course-data.cjs",
    "check:idiom-course": "node scripts/check-idiom-course.cjs && node scripts/check-conjunction-course-ui.cjs",
    "check:phrasal-verbs": "node scripts/check-phrasal-verb-course.cjs && node scripts/check-conjunction-course-ui.cjs",
    "check:vocabulary-extraction": "node scripts/check-vocabulary-extraction.cjs",
    "check:ielts-topic-course-data": "node scripts/check-ielts-topic-course-data.cjs && node scripts/check-conjunction-course-ui.cjs",
    "course:build-ielts-cefr-review": "node scripts/build-ielts-cefr-review.cjs",
    "check:toeic-topic-course-data": "node scripts/check-toeic-topic-course-data.cjs",
    "check:historical-portrait-labels": "node scripts/check-historical-portrait-labels.cjs",
    "check:collection-biographies": "node scripts/check-collection-biographies.cjs",
    "check:statue-puzzle": "node scripts/check-statue-puzzle.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.4.1",
    "expo": "~58.0.24",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.21",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@clerk/expo": "^4.15.1",
    "@noble/hashes": "^2.4.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-auth-session": "~58.0.18",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-sqlite": "~58.0.16",
    "uisfx": "^0.4.0"
  }
}
