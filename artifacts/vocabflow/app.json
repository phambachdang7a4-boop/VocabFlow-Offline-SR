{
  "expo": {
    "name": "VocabFlow",
    "slug": "vocabflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/corvi-app-icon.png",
    "scheme": "vocabflow",
    "splash": {
      "image": "./assets/images/corvi-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F1E3"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/corvi-app-icon.png",
        "backgroundColor": "#1E2130"
      },
      "package": "com.vocabflow.app"
    },
    "web": {
      "favicon": "./assets/images/corvi-app-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
