rm":"interpreting","prompt":"She was _____ the poem for us.","choices":["interpreting","shelf","site","slab"]},{"term":"interpretive","prompt":"The _____ guide explained the painting well.","choices":["interpretive","stair","stonemason","stonework"]},{"term":"dialect","prompt":"My grandmother speaks a local _____.","choices":["dialect","aiming","aims","attend"]},{"term":"dialectal","prompt":"The _____ word sounded different to her.","choices":["dialectal","grammar","pronunciation","translation"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-lesson-4","title":"Bài 161","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"accent","prompt":"Please put an acute _____ on that letter.","choices":["accent","upland","waterside","atom"]},{"term":"accented","prompt":"He _____ the final syllable carefully.","choices":["accented","sweetener","taro","topping"]},{"term":"verbal","prompt":"Please provide a _____ explanation for your absence.","choices":["verbal","undeniably","underestimate","underlie"]},{"term":"verbalise","prompt":"She will _____ her answer after the break.","choices":["verbalise","admirer","adversity","affection"]},{"term":"verbalism","prompt":"His writing relied on simple _____.","choices":["verbalism","symbolize","vivid","wigs"]},{"term":"verbalist","prompt":"The _____ loved careful language and detail.","choices":["verbalist","broadcasting","adverted","adverting"]},{"term":"verbalization","prompt":"The _____ of his idea took some time.","choices":["verbalization","ripen","salty","sown"]},{"term":"verbalize","prompt":"We _____ the noun by adding a suffix.","choices":["verbalize","soul","spirit","spite"]},{"term":"speech","prompt":"He lost the power of _____ recently.","choices":["speech","earn","economically","expensive"]},{"term":"speechless","prompt":"I was _____ with rage at his actions.","choices":["speechless","commuter","commuting","bicycle"]},{"term":"writing","prompt":"She spent all afternoon busy in _____ her novel.","choices":["writing","collision","combination","comer"]},{"term":"reading","prompt":"She spent the whole afternoon fond of _____ books.","choices":["reading","detector","digit","directory"]},{"term":"expression","prompt":"Cold _____ is used to extract oil from seeds without heat.","choices":["expression","posture","pregnancy","prescription"]},{"term":"expressionism","prompt":"_____ often uses bold colors and shapes.","choices":["expressionism","prey","aquatics","nature"]},{"term":"expressionist","prompt":"The _____ used bold colors and shapes.","choices":["expressionist","beak","beast","beaver"]},{"term":"expressionless","prompt":"He gave an _____ answer to the question.","choices":["expressionless","persuasion","pessimist","pleasure"]},{"term":"fluency","prompt":"Her _____ in English improved quickly.","choices":["fluency","seal","signature","soldier"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-reading-lesson-1","title":"Reading · Bài 1","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"affirmative","prompt":"Please give me an _____ answer by tomorrow morning.","choices":["affirmative","pastes","pasting","pastor"]},{"term":"allude","prompt":"Did you _____ to his secret plan?","choices":["allude","student","scholar","scholarship"]},{"term":"alphabet","prompt":"Children learn the _____ before reading.","choices":["alphabet","status","straggler","stranger"]},{"term":"alphabetic","prompt":"The _____ code uses letters instead of numbers.","choices":["alphabetic","plenty","portfolio","possess"]},{"term":"anecdote","prompt":"He told an _____ about school days.","choices":["anecdote","contamination","resource","desert"]},{"term":"aptly","prompt":"She answered _____ and smiled.","choices":["aptly","prejudice","stereotype","stereotypes"]},{"term":"articulation","prompt":"The _____ of the toy arm was loose.","choices":["articulation","prediction","predictor","preliminary"]},{"term":"asked","prompt":"She _____ a simple question in class.","choices":["asked","recognize","relax","remember"]},{"term":"asking","prompt":"He is _____ for help with homework.","choices":["asking","intellectual","intensive","junior"]},{"term":"asks","prompt":"He _____ for directions when lost.","choices":["asks","refine","talc","zinc"]},{"term":"babble","prompt":"His _____ made the meeting hard to follow.","choices":["babble","tropical","undisturbed","unprotected"]},{"term":"buzzword","prompt":"The team used the same _____ again.","choices":["buzzword","literature","museum","tradition"]},{"term":"caller","prompt":"A _____ asked for directions at the door.","choices":["caller","appreciate","arouse","aspire"]},{"term":"chat","prompt":"We _____ about our day every morning.","choices":["chat","esteem","excitability","expectation"]},{"term":"chatter","prompt":"I heard _____ from my teeth in the cold.","choices":["chatter","withdraw","withstand","wobble"]},{"term":"comment","prompt":"The teacher added a _____ beside the answer.","choices":["comment","fuzzy","gappy","gather"]},{"term":"commentary","prompt":"Read the _____ at the bottom of the page.","choices":["commentary","excess","exchange","expansion"]},{"term":"communicate","prompt":"Please _____ the news to the whole team.","choices":["communicate","fade","fail","fend"]},{"term":"concise","prompt":"Please give a _____ answer to the question.","choices":["concise","vagueness","validate","validity"]},{"term":"conjunction","prompt":"Their success came by a rare _____ of luck.","choices":["conjunction","schools","university","academy"]},{"term":"consonant","prompt":"The new plan is _____ with our main goals.","choices":["consonant","rover","skies","space"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-reading-lesson-2","title":"Reading · Bài 2","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"context","prompt":"You must consider the _____ before making a judgment.","choices":["context","file","filter","finder"]},{"term":"contextual","prompt":"Please consider the _____ meaning of this phrase.","choices":["contextual","glance","glimpse","glow"]},{"term":"contraction","prompt":"He suffered from a _____ of a bad habit.","choices":["contraction","pose","prose","purist"]},{"term":"conversation","prompt":"I enjoyed having a long _____ with my old friend.","choices":["conversation","excel","expel","facilitate"]},{"term":"converse","prompt":"We _____ after dinner about school and friends.","choices":["converse","stuff","stump","substantial"]},{"term":"conversely","prompt":"The over-confident driver may drive too fast. _____ the under-confident person may also cause problems by driving too slowly.","choices":["conversely","impairment","indigestible","inflammation"]},{"term":"convey","prompt":"Please _____ my best wishes to your family.","choices":["convey","consumable","consumer","market"]},{"term":"correspond","prompt":"Your actions do not _____ to your words.","choices":["correspond","support","supporter","teeming"]},{"term":"correspondence","prompt":"There is a close _____ between the two lists.","choices":["correspondence","mower","mulch","mutton"]},{"term":"define","prompt":"Can you _____ this new word for me?","choices":["define","harness","heat","kerosene"]},{"term":"definite","prompt":"Please give me a _____ time for the meeting.","choices":["definite","organization","organize","organizer"]},{"term":"definitely","prompt":"She spoke _____ during the meeting.","choices":["definitely","concentrate","concentration","confidence"]},{"term":"definition","prompt":"Please write the _____ in simple words.","choices":["definition","blast","diesel","gasoline"]},{"term":"definitive","prompt":"We need a _____ answer by tomorrow morning.","choices":["definitive","urbanize","population","community"]},{"term":"definitively","prompt":"She spoke _____ during the meeting.","choices":["definitively","loose","lose","loss"]},{"term":"denote","prompt":"The symbol can _____ a warning.","choices":["denote","tannin","tension","trace"]},{"term":"describe","prompt":"Can you _____ a circle using these tools?","choices":["describe","endangered","organism","prey"]},{"term":"description","prompt":"The beauty of the sunset was beyond _____.","choices":["description","boundary","cave","coastline"]},{"term":"dialogue","prompt":"She enjoyed reading a _____ between two friends.","choices":["dialogue","television","radio","message"]},{"term":"dictionary","prompt":"The report was written in a _____ style.","choices":["dictionary","manage","manageable","manual"]},{"term":"disagree","prompt":"Do these two accounts _____ on the price?","choices":["disagree","accumulate","borrow","bought"]},{"term":"disagreement","prompt":"The map showed a _____ in the labels.","choices":["disagreement","resist","resistant","resonant"]},{"term":"discuss","prompt":"He can really _____ a full plate of rice.","choices":["discuss","archive","aristocracy","battlefield"]},{"term":"discussion","prompt":"The topic is currently under _____ by the board.","choices":["discussion","asks","babble","buzzword"]},{"term":"emphasis","prompt":"The speaker used _____ on the main word.","choices":["emphasis","invader","invasion","kingdom"]},{"term":"emphasize","prompt":"Please _____ the main idea in your talk.","choices":["emphasize","virus","biotechnology","affinity"]},{"term":"exaggerate","prompt":"Please do not _____ the problem.","choices":["exaggerate","overexpose","penetrate","pressurize"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-reading-lesson-3","title":"Reading · Bài 3","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"exclaim","prompt":"She had to _____ when she saw the score.","choices":["exclaim","paperless","phone","photocell"]},{"term":"explain","prompt":"Can you _____ this rule again?","choices":["explain","traffic","vehicle","road"]},{"term":"explanation","prompt":"Her _____ was clear and easy to follow.","choices":["explanation","thesis","undergraduate","biodiversity"]},{"term":"explicitly","prompt":"Religion is _____ mentioned four times in the text.","choices":["explicitly","nineteenth","nineties","nobody"]},{"term":"express","prompt":"Please give me an _____ order for some coffee.","choices":["express","credibility","criteria","criticise"]},{"term":"expressive","prompt":"Her _____ eyes showed real worry.","choices":["expressive","postwar","prehistoric","preindustrial"]},{"term":"fluent","prompt":"She is _____ in three languages.","choices":["fluent","national","rights","constitutional"]},{"term":"gesture","prompt":"He made a small _____ to thank her.","choices":["gesture","session","specialist","specialization"]},{"term":"grammarian","prompt":"The _____ explained the rule clearly.","choices":["grammarian","woolly","worst","worthwhile"]},{"term":"grammatical","prompt":"Please check your essay for any _____ errors.","choices":["grammatical","reduce","reduction","revenue"]},{"term":"greet","prompt":"You should _____ your guests with a warm smile.","choices":["greet","import","importable","importance"]},{"term":"greeting","prompt":"Their _____ marked the start of the meeting.","choices":["greeting","pair","patch","pick"]},{"term":"indicative","prompt":"He used the _____ form in the sentence.","choices":["indicative","introduce","introduction","invite"]},{"term":"interrupt","prompt":"Please do not _____ me while I speak.","choices":["interrupt","topple","tots","tries"]},{"term":"interruption","prompt":"A power cut caused an _____ in the game.","choices":["interruption","postwar","predate","prehistoric"]},{"term":"intonation","prompt":"His _____ changed when he asked the question.","choices":["intonation","planning","neighborly","municipal"]},{"term":"jargon","prompt":"The bird's _____ sounded soft and clear.","choices":["jargon","inside","insignificant","instantly"]},{"term":"linguistics","prompt":"_____ helps us study how language changes.","choices":["linguistics","alive","animate","avian"]},{"term":"listen","prompt":"You should _____ to me carefully now.","choices":["listen","cheap","circulation","client"]},{"term":"listener","prompt":"You need to be a good _____ today.","choices":["listener","internship","workforce","union"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-reading-lesson-4","title":"Reading · Bài 4","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"literal","prompt":"Please provide a _____ translation of this poem.","choices":["literal","traveller","trek","trip"]},{"term":"literally","prompt":"The room was _____ filled with smoke.","choices":["literally","headmaster","ignorance","ignorant"]},{"term":"mandarin","prompt":"She speaks _____ at home with her family.","choices":["mandarin","pace","pair","patch"]},{"term":"meaningful","prompt":"Her story had a _____ message.","choices":["meaningful","buyer","buying","candle"]},{"term":"meaningless","prompt":"The answer was _____ without context.","choices":["meaningless","system","technique","term"]},{"term":"mention","prompt":"He got a _____ for his brave work.","choices":["mention","pontifical","popular","popularize"]},{"term":"metaphor","prompt":"She used a _____ to explain the feeling.","choices":["metaphor","blacksmith","boss","builder"]},{"term":"misinterpret","prompt":"Do not _____ my short reply.","choices":["misinterpret","immoral","improper","inmate"]},{"term":"mistranslation","prompt":"We found a _____ in the old book.","choices":["mistranslation","revolutionise","revolutionize","colonizing"]},{"term":"misunderstanding","prompt":"A _____ caused the meeting to end.","choices":["misunderstanding","pegged","plentiful","possess"]},{"term":"misunderstand","prompt":"They _____ each other sometimes.","choices":["misunderstand","postpone","potter","pour"]},{"term":"namely","prompt":"The team finished _____ and left.","choices":["namely","organization","organize","organizer"]},{"term":"narrative","prompt":"The report was written in a _____ tone.","choices":["narrative","vegetarian","weedy","global"]},{"term":"narrator","prompt":"The _____ spoke clearly through the entire story.","choices":["narrator","separately","seventeenth","seventy"]},{"term":"nevertheless","prompt":"It was raining; _____, we went outside.","choices":["nevertheless","reintroduce","reject","rejection"]},{"term":"nickname","prompt":"His _____ was given by his friends.","choices":["nickname","extensive","extensively","external"]},{"term":"nonetheless","prompt":"It was hard, _____, she finished.","choices":["nonetheless","audio","banner","blockbuster"]},{"term":"nonsense","prompt":"Stop talking _____ and listen to me now.","choices":["nonsense","wealth","profit","account"]},{"term":"noun","prompt":"A _____ names a person, place, or thing.","choices":["noun","frustrate","fussy","glad"]},{"term":"obscure","prompt":"The poem was written in an _____ style.","choices":["obscure","publicise","publicist","publicity"]},{"term":"overemphasize","prompt":"Do not _____ one small mistake.","choices":["overemphasize","adversity","affection","afraid"]},{"term":"phrase","prompt":"She saw the _____ near the door.","choices":["phrase","dose","drool","drug"]},{"term":"pronounce","prompt":"The doctor will _____ a patient out of danger soon.","choices":["pronounce","outsource","oversee","practise"]},{"term":"punctuate","prompt":"He raised his hand to _____ his point.","choices":["punctuate","ethnic","ethos","event"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-reading-lesson-5","title":"Reading · Bài 5","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"relate","prompt":"Can you _____ a story about your childhood?","choices":["relate","malnutrition","mealy","medicinal"]},{"term":"relation","prompt":"What is the _____ between these two events?","choices":["relation","barrel","benefit","billion"]},{"term":"remark","prompt":"She made no _____ about his messy room.","choices":["remark","underlie","underlying","undermine"]},{"term":"repeat","prompt":"Look for the _____ mark in the pattern.","choices":["repeat","eating","eats","farmland"]},{"term":"repetition","prompt":"The _____ helped him learn the new words.","choices":["repetition","equally","urban","urbanise"]},{"term":"repetitious","prompt":"His _____ speech bored the class.","choices":["repetitious","rubber","silicate","silicone"]},{"term":"repetitive","prompt":"The _____ task tired her quickly.","choices":["repetitive","speak","syllable","talk"]},{"term":"reply","prompt":"I received your _____ in the mail today.","choices":["reply","advertize","press","pressed"]},{"term":"respond","prompt":"How did you _____ to her sudden question?","choices":["respond","select","selection","selective"]},{"term":"response","prompt":"She gave a quick _____ to my email.","choices":["response","towel","township","villa"]},{"term":"retract","prompt":"You should _____ your statement about the missing money.","choices":["retract","myrrh","olive","onion"]},{"term":"rewrite","prompt":"Please _____ the note in clear words.","choices":["rewrite","luck","lucky","mania"]},{"term":"saying","prompt":"As the _____ goes, time is money.","choices":["saying","destroy","destructive","devastate"]},{"term":"script","prompt":"He kept the _____ in a drawer.","choices":["script","sensation","sensitivity","sentiment"]},{"term":"shorthand","prompt":"She took notes in _____ during class.","choices":["shorthand","maximum","mean","merchant"]},{"term":"sign","prompt":"Look for a _____ of life in the desert.","choices":["sign","climate change","carbon footprint","environment"]},{"term":"speaker","prompt":"The _____ stood up and began to talk.","choices":["speaker","production","export","exportation"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-language-reading-lesson-6","title":"Reading · Bài 6","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"speak","prompt":"I will _____ to him about the plan.","choices":["speak","bilingual","multilingual","illiteracy"]},{"term":"syllable","prompt":"He did not speak a single _____ today.","choices":["syllable","murdering","murderous","accuse"]},{"term":"talk","prompt":"He is all _____ and no action today.","choices":["talk","perimeter","pole","pond"]},{"term":"talker","prompt":"He is a good _____ and keeps people interested.","choices":["talker","connection","controller","desktop"]},{"term":"tense","prompt":"Please conjugate this verb in the present _____.","choices":["tense","paint","painting","painty"]},{"term":"thou","prompt":"_____ should stay and help us.","choices":["thou","release","removal","remove"]},{"term":"tongue","prompt":"She speaks three different mother _____ languages fluently.","choices":["tongue","type","underneath","unit"]},{"term":"translate","prompt":"Can you _____ this letter into French?","choices":["translate","attack","capture","conspiracy"]},{"term":"translator","prompt":"The _____ helped us understand the letter.","choices":["translator","content","copy","coverage"]},{"term":"underline","prompt":"Please _____ the most important words in this text.","choices":["underline","sees","sharpen","shelve"]},{"term":"unless","prompt":"You cannot enter the club _____ you have a ticket.","choices":["unless","predict","predictable","prediction"]},{"term":"unstressed","prompt":"The last word was _____ in the sentence.","choices":["unstressed","traditionalism","traditionalist","traditionalize"]},{"term":"usage","prompt":"He suffered from hard _____ by his cruel boss.","choices":["usage","building","construction","suburb"]},{"term":"utterance","prompt":"Her _____ was calm and easy to hear.","choices":["utterance","punishment","penalty","legalisation"]},{"term":"utter","prompt":"The room was in _____ darkness for an hour.","choices":["utter","exaggerate","exclaim","explain"]},{"term":"verb","prompt":"Please provide a _____ to complete this sentence.","choices":["verb","coot","crab","cricket"]},{"term":"vocal","prompt":"The _____ organs are essential for human speech.","choices":["vocal","alarm","alert","appeal"]},{"term":"vocalization","prompt":"The child improved her _____ quickly.","choices":["vocalization","retailed","retailing","spend"]},{"term":"voice","prompt":"Every employee should have a _____ in the matter.","choices":["voice","forecaster","geochemistry","glaciation"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-lesson-1","title":"Bài 237","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"correlation","prompt":"The researchers observed a strong _____ between sleep duration and examination performance.","choices":["correlation","humanness","relationship","relationships"]},{"term":"methodological","prompt":"The report discusses _____ limitations arising from nonrandom sampling and inconsistent measurement procedures.","choices":["methodological","journal","journalism","journalist"]},{"term":"methodology","prompt":"A transparent _____ enables readers to evaluate how data were collected, analysed, and interpreted.","choices":["methodology","racial","poor","poorly"]},{"term":"qualitative","prompt":"_____ interviews revealed how residents understood risks that numerical surveys had overlooked.","choices":["qualitative","encode","engine","equipment"]},{"term":"quantitative","prompt":"_____ analysis showed that income predicted access to reliable public transport.","choices":["quantitative","elder","elderly","human"]},{"term":"sample","prompt":"The researchers selected a representative _____ of households from five coastal communities.","choices":["sample","orientation","playground","professor"]},{"term":"statistic","prompt":"One _____, the median response time, exposed substantial differences between the two hospitals.","choices":["statistic","planing","interior","exterior"]},{"term":"statistical","prompt":"_____ models controlled for age, income, and education when estimating treatment effects.","choices":["statistical","dweller","enclose","estate"]},{"term":"statistics","prompt":"Researchers used _____ to compare health outcomes across the two treatment groups.","choices":["statistics","swallow","syndrome","taste"]},{"term":"survey","prompt":"The _____ collected responses from 1,200 households about access to clean water.","choices":["survey","antiseptic","anxious","aphasic"]},{"term":"variable","prompt":"Researchers treated household income as a _____ influencing participation in higher education.","choices":["variable","corporate","cost","costly"]},{"term":"logic","prompt":"The argument's _____ depends on distinguishing correlation from causation.","choices":["logic","beneath","besides","betoken"]},{"term":"logical","prompt":"A _____ interpretation of the evidence requires consideration of alternative explanations.","choices":["logical","void","whatsoever","whitish"]},{"term":"moral","prompt":"The policy raises _____ questions about fairness, responsibility, and access to essential services.","choices":["moral","muscular","nervous","neural"]},{"term":"morally","prompt":"The committee judged the proposed experiment _____ acceptable after reviewing its potential risks.","choices":["morally","embody","emerge","emergence"]},{"term":"philosopher","prompt":"The _____ argued that justice requires institutions to protect the vulnerable.","choices":["philosopher","innovating","innovative","robotic"]},{"term":"philosophical","prompt":"Her _____ discussion distinguishes moral responsibility from legal accountability.","choices":["philosophical","product","production","export"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-lesson-2","title":"Bài 238","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"philosophy","prompt":"His _____ connects personal freedom with responsibility toward the wider community.","choices":["philosophy","fraught","freely","frequent"]},{"term":"rational","prompt":"A _____ explanation must account for evidence that challenges the initial hypothesis.","choices":["rational","courtesy","craze","crisis"]},{"term":"rationalist","prompt":"The _____ rejected tradition when it conflicted with clear logical principles.","choices":["rationalist","drop","droplet","echo"]},{"term":"virtue","prompt":"The study argues that patience is a _____ essential to effective scientific collaboration.","choices":["virtue","coin","compensation","competitor"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-1","title":"Reading · Bài 1","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"abstract","prompt":"The idea was too _____ for young learners.","choices":["abstract","countless","crimson","cryptic"]},{"term":"analogy","prompt":"He used an _____ to explain the complex idea.","choices":["analogy","silver","solder","steel"]},{"term":"analyse","prompt":"We _____ the data before making a choice.","choices":["analyse","dehumanise","depend","deprive"]},{"term":"analysis","prompt":"Her _____ was clear and useful.","choices":["analysis","saleable","priceless","pricey"]},{"term":"analytical","prompt":"Her _____ mind solved the problem fast.","choices":["analytical","instruct","instruction","instructor"]},{"term":"analyze","prompt":"We _____ the data every Friday.","choices":["analyze","advertize","press","pressed"]},{"term":"annotate","prompt":"Please _____ the page with useful notes.","choices":["annotate","innocent","intruder","intrusion"]},{"term":"anticipate","prompt":"The company will _____ a large profit this year.","choices":["anticipate","barred","base","beat"]},{"term":"anticipation","prompt":"We bought gifts in _____ of the party.","choices":["anticipation","ginkgo","gnat","gorilla"]},{"term":"approach","prompt":"This mountain is very easy of _____ for hikers.","choices":["approach","sister","spouse","teenager"]},{"term":"arguably","prompt":"He moved _____ through the crowd.","choices":["arguably","honeymoon","housework","husband"]},{"term":"argue","prompt":"They began to _____ about the new rules.","choices":["argue","roller","rough","roughly"]},{"term":"argument","prompt":"He presented a strong _____ for the new policy.","choices":["argument","dental","detoxify","diagnose"]},{"term":"aspect","prompt":"The garden has a gentle _____ and many trees.","choices":["aspect","murder","murdered","murdering"]},{"term":"assert","prompt":"You must _____ your rights in this situation.","choices":["assert","mushroom","nest","nestful"]},{"term":"assume","prompt":"He will _____ the name of his father.","choices":["assume","populate","preside","prevail"]},{"term":"assumption","prompt":"His _____ of power surprised everyone in the small town.","choices":["assumption","faint","fatty","flex"]},{"term":"attributable","prompt":"The delay is _____ to heavy rain.","choices":["attributable","therapy","hospital","hospitalisation"]},{"term":"attribute","prompt":"Honesty is a key _____ of a leader.","choices":["attribute","thermostat","tool","transmission"]},{"term":"authoritative","prompt":"She gave an _____ report on the new project.","choices":["authoritative","botany","bract","branch"]},{"term":"basis","prompt":"The soldiers returned to the _____ at dawn.","choices":["basis","deserts","marine","oceanic"]},{"term":"benchmark","prompt":"This test score is the _____ for success.","choices":["benchmark","feminise","biased","biasing"]},{"term":"bombard","prompt":"The coach would _____ the players with questions.","choices":["bombard","margin","mark","marker"]},{"term":"breadth","prompt":"We need to broaden our _____ of view.","choices":["breadth","microphone","modem","monitor"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-2","title":"Reading · Bài 2","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"brief","prompt":"Please send me a _____ note by tomorrow.","choices":["brief","correlate","count","credibility"]},{"term":"briefly","prompt":"She answered _____ and smiled.","choices":["briefly","conjure","convent","conventional"]},{"term":"calculate","prompt":"She _____ the risk before starting the trip.","choices":["calculate","undeveloped","purchase","advertising"]},{"term":"calculation","prompt":"Her _____ was correct on the first try.","choices":["calculation","spend","spendable","packaging"]},{"term":"capability","prompt":"The _____ was important at work.","choices":["capability","sunrise","temperature","thaw"]},{"term":"capable","prompt":"You should show your teacher what you are _____ of.","choices":["capable","item","jeans","jewelry"]},{"term":"categorize","prompt":"We _____ the books by topic.","choices":["categorize","homeless","rentable","develop"]},{"term":"category","prompt":"Books are organized by _____ in this library.","choices":["category","squeeze","stack","stagger"]},{"term":"causal","prompt":"Scientists studied the _____ link between the two events.","choices":["causal","surveillance","suspect","suspicion"]},{"term":"chart","prompt":"Please check the weather _____ before we leave.","choices":["chart","sees","seldom","selfsame"]},{"term":"chronologically","prompt":"The team finished _____ and left.","choices":["chronologically","mutation","nutrient","physiologist"]},{"term":"cite","prompt":"You must _____ your sources in this essay.","choices":["cite","perfect","perfectly","perhaps"]},{"term":"clarify","prompt":"Please _____ the rules before the game starts.","choices":["clarify","latitude","location","longitude"]},{"term":"clarity","prompt":"She dreamed, with great _____, that she had seen her own death.","choices":["clarity","bedecking","begin","beneath"]},{"term":"classification","prompt":"The teacher explained the _____ of animals.","choices":["classification","exclusiveness","excuse","extension"]},{"term":"collate","prompt":"Please _____ the data before you write the report.","choices":["collate","bequeath","conquer","invade"]},{"term":"comparable","prompt":"Their scores are _____ across both tests.","choices":["comparable","reorganize","repair","requirement"]},{"term":"comparative","prompt":"They used the _____ method of studying history.","choices":["comparative","neurologist","neurology","neuroscience"]},{"term":"comparatively","prompt":"The cost of living here is _____ low, though not the lowest.","choices":["comparatively","examine","examiner","excel"]},{"term":"compare","prompt":"Please _____ the original with the new copy.","choices":["compare","pregnancy","pregnant","prenatal"]},{"term":"comparison","prompt":"This new model does not bear _____ with it.","choices":["comparison","tremendous","tricky","tries"]},{"term":"compilation","prompt":"The book is a _____ of short stories.","choices":["compilation","clerk","collaboration","colleague"]},{"term":"compile","prompt":"They _____ a list of useful words.","choices":["compile","ceremonious","ceremony","champagne"]},{"term":"concept","prompt":"The _____ was easy for the class to understand.","choices":["concept","mayor","monarch","negotiation"]},{"term":"conclude","prompt":"They will _____ the meeting at five o'clock sharp.","choices":["conclude","claim","clearly","clever"]},{"term":"conclusion","prompt":"We reached the _____ at sunset.","choices":["conclusion","dart","defeat","dive"]},{"term":"conclusively","prompt":"I read the note _____.","choices":["conclusively","speechless","writing","reading"]},{"term":"confirm","prompt":"Work can _____ someone in his chain-smoking.","choices":["confirm","medulla","microbe","microbial"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-3","title":"Reading · Bài 3","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"conjecture","prompt":"His _____ about the missing keys was correct.","choices":["conjecture","hospitalization","vaccination","infection"]},{"term":"consecutive","prompt":"She won the race for three _____ days.","choices":["consecutive","sports","athlete","athletics"]},{"term":"consequence","prompt":"Every action has a _____ that we must face.","choices":["consequence","specify","speculate","speculation"]},{"term":"consequently","prompt":"He did not wake up early in the morning. _____, he was late to work.","choices":["consequently","thermostat","tool","transmission"]},{"term":"consider","prompt":"Please _____ the price before you buy it.","choices":["consider","intervention","license","lobbyist"]},{"term":"consideration","prompt":"Your proposal is currently under _____ by the board.","choices":["consideration","unsafe","untraceable","violent"]},{"term":"consistent","prompt":"Her actions are always _____ with her words.","choices":["consistent","opposition","organisation","organization"]},{"term":"consistently","prompt":"Her work was _____ careful and complete.","choices":["consistently","predetermine","predict","predictable"]},{"term":"contradict","prompt":"Please do not _____ your mother's advice.","choices":["contradict","dose","drool","drug"]},{"term":"contradictory","prompt":"They gave _____ statements to the local police.","choices":["contradictory","remark","repeat","repetition"]},{"term":"contrast","prompt":"The _____ between day and night is clear.","choices":["contrast","reminder","resemblance","resentment"]},{"term":"correlate","prompt":"Price and demand are a _____ pair.","choices":["correlate","philanthropy","playboy","playmate"]},{"term":"count","prompt":"The final _____ showed that we won the game.","choices":["count","aquatics","nature","planter"]},{"term":"credibility","prompt":"His honesty helped build his _____ with us.","choices":["credibility","unreconstructed","wars","female"]},{"term":"criteria","prompt":"We used clear _____ to choose a winner.","choices":["criteria","bean","beef","beer"]},{"term":"critical","prompt":"He is _____ and never likes the food.","choices":["critical","approximately","approximation","balance"]},{"term":"criticise","prompt":"Teachers should _____ the work kindly and clearly.","choices":["criticise","beetle","birch","bird"]},{"term":"criticism","prompt":"His _____ helped me improve.","choices":["criticism","zone","travel","traveled"]},{"term":"criticize","prompt":"They _____ the plan at every meeting.","choices":["criticize","decisive","delight","denial"]},{"term":"critique","prompt":"He studied the art of _____ for years.","choices":["critique","oily","efficient","efficiently"]},{"term":"crucial","prompt":"The first step is _____ for our success.","choices":["crucial","painter","painting","sculpt"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-4","title":"Reading · Bài 4","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"crucially","prompt":"He moved _____ through the crowd.","choices":["crucially","maturation","medulla","microbe"]},{"term":"cumulative","prompt":"The _____ evidence proves his guilt beyond doubt.","choices":["cumulative","pollen","predation","primate"]},{"term":"cumulatively","prompt":"She spoke _____ during the meeting.","choices":["cumulatively","throes","thrust","thwack"]},{"term":"debate","prompt":"They _____ the best way to save money.","choices":["debate","crash","crystal","crystalline"]},{"term":"deduce","prompt":"From the clues, we can _____ the answer.","choices":["deduce","prevent","prevented","diagnoses"]},{"term":"deduction","prompt":"His _____ was that the key was lost.","choices":["deduction","data","software","telecommunication"]},{"term":"delve","prompt":"They found a small _____ in the hill.","choices":["delve","razor","refrigerator","ribbon"]},{"term":"demonstrate","prompt":"They will _____ in the city center tomorrow.","choices":["demonstrate","specify","speculate","speculation"]},{"term":"demonstration","prompt":"She gave a _____ of her new dance moves.","choices":["demonstration","pronunciation","translation","interpretation"]},{"term":"detail","prompt":"The report included every _____ of the trip.","choices":["detail","customs","festival","theater"]},{"term":"determine","prompt":"We must _____ the meaning of these words.","choices":["determine","language","linguist","linguistic"]},{"term":"diagram","prompt":"The _____ helped explain the idea.","choices":["diagram","artifact","monument","preservation"]},{"term":"differentiate","prompt":"Can you _____ between these two colors?","choices":["differentiate","market","marketable","trade"]},{"term":"discrepancy","prompt":"The records show a _____ in the totals.","choices":["discrepancy","collector","collision","combination"]},{"term":"distinguish","prompt":"Can you _____ between these two similar colors?","choices":["distinguish","beneath","besides","beyond"]},{"term":"divider","prompt":"She worked as a _____ in the store.","choices":["divider","detained","arrested","arresting"]},{"term":"emulation","prompt":"There is strong _____ between the two teams.","choices":["emulation","retract","rewrite","shorthand"]},{"term":"equate","prompt":"The teacher asked us to _____ the two expressions.","choices":["equate","geographically","globe","hectare"]},{"term":"equation","prompt":"The teacher showed the _____ of the error.","choices":["equation","divulge","double","downright"]},{"term":"equivalent","prompt":"Dolphins have very large brains, roughly _____ to the size of a human brain.","choices":["equivalent","lawless","legislative","administrative"]},{"term":"erroneous","prompt":"The report was _____ and needed correction.","choices":["erroneous","geometric","geometrical","infinite"]},{"term":"error","prompt":"Please double check your work to avoid any _____.","choices":["error","crowd","cult","decorum"]},{"term":"evaluate","prompt":"We _____ the results before the meeting.","choices":["evaluate","event","everybody","faith"]},{"term":"evaluation","prompt":"We asked for an _____ of the old house.","choices":["evaluation","twitch","uncertainty","uplift"]},{"term":"evident","prompt":"It is _____ that she practiced a lot.","choices":["evident","candle","catalogue","conditioner"]},{"term":"exemplify","prompt":"These results _____ our hard work this month.","choices":["exemplify","professor","proficient","programme"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-5","title":"Reading · Bài 5","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"extract","prompt":"I read a short _____ from the book.","choices":["extract","trainable","trained","motored"]},{"term":"factor","prompt":"The human _____ is important in every project.","choices":["factor","transited","transitive","fuel"]},{"term":"factual","prompt":"The report gave a _____ account of the accident.","choices":["factual","scorpion","seaweed","sedge"]},{"term":"falsehood","prompt":"The report was based on _____.","choices":["falsehood","mention","metaphor","mistranslation"]},{"term":"falsely","prompt":"The team finished _____ and left.","choices":["falsely","inform","informative","interview"]},{"term":"fault","prompt":"It was my _____ that we missed the train.","choices":["fault","gnat","gorilla","grasshopper"]},{"term":"faulty","prompt":"The _____ option was chosen.","choices":["faulty","amidst","amongst","anyplace"]},{"term":"feasible","prompt":"Is it _____ to finish this project today?","choices":["feasible","compensate","compensation","competitor"]},{"term":"flaw","prompt":"There is a small _____ in this new design.","choices":["flaw","rhythm","romance","sampler"]},{"term":"focus","prompt":"The camera lost _____ in the dark room.","choices":["focus","discriminative","discriminatory","childless"]},{"term":"foresee","prompt":"I _____ a busy day ahead.","choices":["foresee","ballad","banquet","beautiful"]},{"term":"foreseeable","prompt":"Rain is _____ during the wet season.","choices":["foreseeable","bund","comfortably","convenience"]},{"term":"foreseen","prompt":"The result had been _____ by everyone.","choices":["foreseen","visual","weight","energy"]},{"term":"formulate","prompt":"She tried to _____ her idea clearly.","choices":["formulate","wasteland","waterlogged","wilderness"]},{"term":"fragment","prompt":"The story was only a _____ of truth.","choices":["fragment","emissions","conservation","habitat"]},{"term":"fundamental","prompt":"We must follow the _____ rules of the school.","choices":["fundamental","worry","yawn","yawner"]},{"term":"fundamentally","prompt":"Their ideas are _____ different from each other.","choices":["fundamentally","poorly","charity","charitable"]},{"term":"glean","prompt":"I managed to _____ news from the locals.","choices":["glean","power","powered","powerful"]},{"term":"graph","prompt":"The _____ shows sales rising each month.","choices":["graph","overwhelm","pamper","passionate"]},{"term":"grasp","prompt":"You must have a thorough _____ of math.","choices":["grasp","muscular","mutate","nervous"]},{"term":"groundwork","prompt":"They laid _____ for the new path.","choices":["groundwork","industrialize","industrially","adequate"]},{"term":"guess","prompt":"Can you make a lucky _____ about the winner?","choices":["guess","dialect","accent","verbalism"]},{"term":"heed","prompt":"You must pay _____ to the safety signs.","choices":["heed","womb","worm","continent"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-6","title":"Reading · Bài 6","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"illogical","prompt":"That is an _____ argument for a scientist.","choices":["illogical","detective","disorderly","guilty"]},{"term":"illuminate","prompt":"They will _____ the street with bright lights.","choices":["illuminate","tunnel","housing","develop"]},{"term":"illustrate","prompt":"They _____ the book with bright drawings.","choices":["illustrate","eggs","fatten","feed"]},{"term":"implication","prompt":"There is a close _____ between the two ideas.","choices":["implication","bullrush","burrow","cage"]},{"term":"implicit","prompt":"There was an _____ threat in his cold voice.","choices":["implicit","fighter","flee","formally"]},{"term":"imply","prompt":"do you _____ that I am not telling the truth?","choices":["imply","feign","flinch","forget"]},{"term":"imprecise","prompt":"The map was _____ and hard to read.","choices":["imprecise","sunlit","sunny","temperate"]},{"term":"inaccuracy","prompt":"There was an _____ in the final count.","choices":["inaccuracy","respective","respectively","retrace"]},{"term":"inaccurate","prompt":"The map was _____ and confusing.","choices":["inaccurate","airborne","naval","seagoing"]},{"term":"inconsistency","prompt":"The _____ in his story made us doubt him.","choices":["inconsistency","dialogue","dictionary","disagreement"]},{"term":"inconsistent","prompt":"His words were _____ with his actual deeds.","choices":["inconsistent","prop","rebuild","recess"]},{"term":"inconsistently","prompt":"She spoke _____ during the meeting.","choices":["inconsistently","describe","description","dialogue"]},{"term":"incorrect","prompt":"His voice stayed _____ all night.","choices":["incorrect","restoration","restore","restorer"]},{"term":"indisputable","prompt":"It is _____ that water is wet.","choices":["indisputable","context","contraction","conversation"]},{"term":"indisputably","prompt":"They worked _____ all day.","choices":["indisputably","layout","mason","moat"]},{"term":"infer","prompt":"We can _____ the answer from the clues.","choices":["infer","signal","socket","stereo"]},{"term":"inquire","prompt":"The police will _____ into the cause of the accident.","choices":["inquire","inland","islander","lagoon"]},{"term":"insight","prompt":"He showed _____ during the discussion.","choices":["insight","gain","getting","goodwill"]},{"term":"insist","prompt":"Please _____ on clear instructions.","choices":["insist","artifact","monument","monumental"]},{"term":"insistence","prompt":"The teacher's _____ on homework was clear.","choices":["insistence","garment","glee","glory"]},{"term":"instance","prompt":"You can see that for _____ in his work.","choices":["instance","bout","caffeine","calcium"]},{"term":"integral","prompt":"We learned how to find the _____ of the function.","choices":["integral","charcoal","chisel","clay"]},{"term":"interdisciplinary","prompt":"They attended an _____ seminar on climate change.","choices":["interdisciplinary","suggestive","summarise","summarize"]},{"term":"intrinsic","prompt":"We must consider the _____ value of this gift.","choices":["intrinsic","socialism","socialist","socialization"]},{"term":"intrinsically","prompt":"She spoke _____ during the meeting.","choices":["intrinsically","punish","punishable","punishing"]},{"term":"invariably","prompt":"He moved _____ through the crowd.","choices":["invariably","visitor","attraction","sightseeing"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-topic-vocabulary-v1-academic-methods-reading-lesson-7","title":"Reading · Bài 7","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"invariant","prompt":"The rules stayed _____ all year.","choices":["invariant","toss","volley","volleyball"]},{"term":"investigate","prompt":"The police will _____ the missing phone.","choices":["investigate","craftsman","critic","cuisine"]},{"term":"investigation","prompt":"The _____ took several weeks.","choices":["investigation","edge","elevation","equator"]},{"term":"irrespective","prompt":"The rules apply _____ of your age.","choices":["irrespective","stamina","starvation","starve"]},{"term":"iterative","prompt":"The lesson used an _____ drill for practice.","choices":["iterative","throes","throughout","thrust"]},{"term":"justify","prompt":"She tried to _____ her choice with clear facts.","choices":["justify","eleven","elsewhere","emergence"]},{"term":"likelihood","prompt":"In all _____, it will rain this afternoon.","choices":["likelihood","cinema","film","entertainer"]},{"term":"liken","prompt":"They _____ the two tools for size.","choices":["liken","disposal","drain","drip"]},{"term":"linear","prompt":"He drew a long _____ mark across the page.","choices":["linear","handle","hang","haphazardly"]},{"term":"locus","prompt":"The exact _____ of the shop is here.","choices":["locus","kohl","label","luxury"]},{"term":"logically","prompt":"They worked _____ all day.","choices":["logically","constructive","courseware","cram"]},{"term":"misdate","prompt":"I _____ the letter and wrote the wrong year.","choices":["misdate","computing","internet","automatic"]},{"term":"negative","prompt":"I received a _____ response to my job application.","choices":["negative","unfamiliar","unfilled","unforeseen"]},{"term":"notation","prompt":"The map used clear _____ for each road.","choices":["notation","artist","arts","music"]},{"term":"objective","prompt":"A journalist must always provide an _____ opinion.","choices":["objective","termite","tern","tiger"]},{"term":"omission","prompt":"The _____ in the form caused trouble.","choices":["omission","grammatical","greet","indicative"]},{"term":"omit","prompt":"Please _____ the last line from the note.","choices":["omit","convey","correspond","define"]},{"term":"outline","prompt":"The _____ showed the shape of the house.","choices":["outline","tour","tourism","tourist"]},{"term":"overview","prompt":"The report gives an _____ of the whole plan.","choices":["overview","passenger","passer","pickup"]},{"term":"paradox","prompt":"It was a _____ that the room felt crowded and empty.","choices":["paradox","unspectacular","unstuck","unsuitable"]},{"term":"parse","prompt":"Please _____ the sentence 