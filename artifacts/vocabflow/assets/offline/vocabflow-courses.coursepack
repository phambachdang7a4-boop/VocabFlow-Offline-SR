"]},{"term":"paragraph alignment","prompt":"Set the font color and _____, then apply text highlight.","choices":["paragraph alignment","find","replace","navigation pane"]}]},{"id":"office-apps-vocabulary-v1-word-lesson-3","title":"Microsoft Word · Bài 3","focus":"Từ vựng soạn thảo, định dạng trang, rà soát và chia sẻ tài liệu.","topicId":"word","topicTitle":"Microsoft Word","questions":[{"term":"bullet list","prompt":"Choose a _____, numbered list, or multilevel list for the outline.","choices":["bullet list","section break","line break","character spacing"]},{"term":"numbered list","prompt":"Choose a bullet list, _____, or multilevel list for the outline.","choices":["numbered list","revision markup","accept changes","reject changes"]},{"term":"multilevel list","prompt":"Choose a bullet list, numbered list, or _____ for the outline.","choices":["multilevel list","bold","italic","underline"]},{"term":"style","prompt":"Apply a heading _____ and match it to the document theme.","choices":["style","find","replace","navigation pane"]},{"term":"heading","prompt":"Apply a _____ style and match it to the document theme.","choices":["heading","reject changes","mail merge","recipient list"]},{"term":"document theme","prompt":"Apply a heading style and match it to the _____.","choices":["document theme","hyperlink","bookmark","cross-reference"]},{"term":"document template","prompt":"Start from a _____, add a page border, and format text in columns.","choices":["document template","cross-reference","footnote","endnote"]},{"term":"page border","prompt":"Start from a document template, add a _____, and format text in columns.","choices":["page border","document template","columns","table of contents"]},{"term":"columns","prompt":"Start from a document template, add a page border, and format text in _____.","choices":["columns","document","page layout","page margin"]},{"term":"table of contents","prompt":"Insert a table and generate a _____ and index.","choices":["table of contents","table row","table column","cell shading"]},{"term":"index","prompt":"Insert a table and generate a table of contents and _____.","choices":["index","replace","navigation pane","spell check"]},{"term":"table","prompt":"Insert a _____ and generate a table of contents and index.","choices":["table","underline","strikethrough","text highlight"]}]},{"id":"office-apps-vocabulary-v1-word-lesson-4","title":"Microsoft Word · Bài 4","focus":"Từ vựng soạn thảo, định dạng trang, rà soát và chia sẻ tài liệu.","topicId":"word","topicTitle":"Microsoft Word","questions":[{"term":"table row","prompt":"Format a _____ and table column, then apply cell shading.","choices":["table row","page border","columns","table of contents"]},{"term":"table column","prompt":"Format a table row and _____, then apply cell shading.","choices":["table column","document template","page border","columns"]},{"term":"cell shading","prompt":"Format a table row and table column, then apply _____.","choices":["cell shading","endnote","find","replace"]},{"term":"table border","prompt":"Set a _____, add a caption, and link to a source with a hyperlink.","choices":["table border","page break","section break","line break"]},{"term":"caption","prompt":"Set a table border, add a _____, and link to a source with a hyperlink.","choices":["caption","header","footer","page number"]},{"term":"hyperlink","prompt":"Set a table border, add a caption, and link to a source with a _____.","choices":["hyperlink","tab stop","page break","section break"]},{"term":"bookmark","prompt":"Add a _____, cite it with a cross-reference, and insert a footnote.","choices":["bookmark","hyperlink","cross-reference","footnote"]},{"term":"cross-reference","prompt":"Add a bookmark, cite it with a _____, and insert a footnote.","choices":["cross-reference","header","footer","page number"]},{"term":"footnote","prompt":"Add a bookmark, cite it with a cross-reference, and insert a _____.","choices":["footnote","word count","comment","track cha