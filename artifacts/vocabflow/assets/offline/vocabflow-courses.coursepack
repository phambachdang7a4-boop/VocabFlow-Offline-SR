t.","choices":["pollen","spokesman","spokesperson","spokeswoman"]},{"term":"predation","prompt":"The cat's _____ kept the garden clear of mice.","choices":["predation","keynote","logo","magazine"]},{"term":"primate","prompt":"A _____ helped the team.","choices":["primate","broken","budge","bums"]},{"term":"primatologist","prompt":"The _____ observed monkeys for hours.","choices":["primatologist","song","spectacle","spell"]},{"term":"reproduce","prompt":"Can you _____ this image in black and white?","choices":["reproduce","outsource","oversee","practise"]},{"term":"reproductive","prompt":"Plants use _____ cells to make new life.","choices":["reproductive","toured","tourism","tourist"]},{"term":"rhesus","prompt":"A _____ climbed quickly across the branches.","choices":["rhesus","leak","outflow","pump"]},{"term":"root","prompt":"The tree has a very deep and strong _____.","choices":["root","emphasis","explanation","fluent"]},{"term":"rump","prompt":"The dog's _____ was covered in mud.","choices":["rump","realism","repertoire","revelation"]},{"term":"scape","prompt":"A feather _____ felt smooth in her hand.","choices":["scape","inborn","innards","innate"]},{"term":"scapose","prompt":"The plant has a long _____ stem.","choices":["scapose","linear","negative","objective"]},{"term":"scent","prompt":"The sweet _____ of roses filled the room.","choices":["scent","scare","scowl","scream"]}],"chapterId":"science-technology","chapterTitle":"Khoa học & công nghệ","chapterNumber":5},{"id":"ielts-topic-vocabulary-v1-biology-reading-lesson-7","title":"Reading · Bài 7","focus":"Tế bào, di truyền, tiến hóa, miễn dịch và sinh lý học.","topicId":"biology","topicTitle":"Sinh học","questions":[{"term":"sensory","prompt":"The _____ system helps us notice pain.","choices":["sensory","beautiful","ceremonious","classic"]},{"term":"sepal","prompt":"A green _____ protected the small flower.","choices":["sepal","kilometre","length","lens"]},{"term":"shoulder","prompt":"He _____ the crowd to rea