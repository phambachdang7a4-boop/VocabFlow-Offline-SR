iness-lesson-94","title":"Bài 94","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"track down","prompt":"We need to _____ the source of the recent shipping delay.","choices":["track down","turn into","trade on","collect a parcel"],"componentWords":[{"term":"track","definition":"Theo vết, theo dõi, đi tìm, lùng bắt, truy nã."}]},{"term":"trade on","prompt":"He tried to _____ his father's reputation to secure the deal.","choices":["trade on","turn into","track down","shop around"],"componentWords":[{"term":"trade","definition":"Buôn bán, trao đổi mậu dịch."}]},{"term":"turn into","prompt":"Small businesses can often _____ global brands with enough innovation.","choices":["turn into","trade on","track down","show the appreciation"],"componentWords":[{"term":"turn","definition":"Quay, xoay, vặn."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-95","title":"Bài 95","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"urge upon","prompt":"Management decided to _____ the staff the importance of meeting the deadline.","choices":["urge upon","wade into","usher in","go on to"],"componentWords":[{"term":"urge","definition":"Thúc, thúc giục, giục giã."}]},{"term":"usher in","prompt":"The new CEO hopes to _____ a period of significant growth for the company.","choices":["usher in","wade into","urge upon","mess up"],"componentWords":[{"term":"usher","definition":"Đưa, dẫn."}]},{"term":"wade into","prompt":"He decided to _____ the market by investing in new technologies.","choices":["wade into","urge upon","usher in","cover up"],"componentWords":[{"term":"wade","definition":"Lội, lội qua."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-96","title":"Bài 96","focus":"Hợp đồ