d-collocations-v1-entertainment-events-lesson-9":["toeic-topic-collocations-v2-entertainment-events-lesson-2"],"toeic-advanced-collocations-v1-entertainment-events-lesson-10":["toeic-topic-collocations-v2-entertainment-events-lesson-2"],"toeic-advanced-collocations-v1-entertainment-events-lesson-11":["toeic-topic-collocations-v2-entertainment-events-lesson-2"],"toeic-advanced-collocations-v1-entertainment-events-lesson-12":["toeic-topic-collocations-v2-entertainment-events-lesson-2","toeic-topic-collocations-v2-entertainment-events-lesson-3"],"toeic-advanced-collocations-v1-entertainment-events-lesson-13":["toeic-topic-collocations-v2-entertainment-events-lesson-3"],"toeic-advanced-collocations-v1-entertainment-events-lesson-14":["toeic-topic-collocations-v2-entertainment-events-lesson-3"],"toeic-advanced-collocations-v1-entertainment-events-lesson-15":["toeic-topic-collocations-v2-entertainment-events-lesson-3"],"toeic-advanced-collocations-v1-entertainment-events-lesson-16":["toeic-topic-collocations-v2-entertainment-events-lesson-4"],"toeic-advanced-collocations-v1-entertainment-events-lesson-17":["toeic-topic-collocations-v2-entertainment-events-lesson-4"],"toeic-advanced-collocations-v1-entertainment-events-lesson-18":["toeic-topic-collocations-v2-entertainment-events-lesson-4"],"toeic-advanced-collocations-v1-entertainment-events-lesson-19":["toeic-topic-collocations-v2-entertainment-events-lesson-4"],"toeic-advanced-collocations-v1-entertainment-events-lesson-20":["toeic-topic-collocations-v2-entertainment-events-lesson-4"],"toeic-advanced-collocations-v1-entertainment-events-lesson-21":["toeic-topic-collocations-v2-entertainment-events-lesson-4","toeic-topic-collocations-v2-entertainment-events-lesson-5"],"toeic-advanced-collocations-v1-entertainment-events-lesson-22":["toeic-topic-collocations-v2-entertainment-events-lesson-5"],"toeic-advanced-collocations-v1-entertainment-events-lesson-23":["toeic-topic-collocations-v2-entertainment-events-lesson-5"],"toeic-advanced-collocations-v1-entertainment-events-lesson-24":["toeic-topic-collocations-v2-entertainment-events-lesson-5"],"toeic-advanced-collocations-v1-entertainment-events-lesson-25":["toeic-topic-collocations-v2-entertainment-events-lesson-5"],"toeic-advanced-collocations-v1-entertainment-events-lesson-26":["toeic-topic-collocations-v2-entertainment-events-lesson-6"],"toeic-advanced-collocations-v1-entertainment-events-lesson-27":["toeic-topic-collocations-v2-entertainment-events-lesson-6"],"toeic-advanced-collocations-v1-entertainment-events-lesson-28":["toeic-topic-collocations-v2-entertainment-events-lesson-6"],"toeic-advanced-collocations-v1-entertainment-events-lesson-29":["toeic-topic-collocations-v2-entertainment-events-lesson-6"],"toeic-advanced-collocations-v1-entertainment-events-lesson-30":["toeic-topic-collocations-v2-entertainment-events-lesson-7","toeic-topic-collocations-v2-entertainment-events-lesson-8"],"toeic-advanced-collocations-v1-entertainment-events-lesson-31":["toeic-topic-collocations-v2-entertainment-events-lesson-8"],"toeic-advanced-collocations-v1-entertainment-events-lesson-32":["toeic-topic-collocations-v2-entertainment-events-lesson-8"]}},"sentenceStructureDistractorExplanations":{"either … or":{"neither … nor":"The sentence requires one of two options, not neither option.","not only … but also":"This asserts both options, which conflicts with “not both.”","whether … or":"This introduces alternatives for consideration but does not express the required choice."},"neither … nor":{"both … and":"The prompt says the plan lacked both listed features.","either … or":"This presents a choice instead of denying both features.","not only … but also":"This asserts that both features were present, the opposite of the prompt."},"not only … but also":{"either … or":"The prompt explicitly says both advantages apply.","neither … nor":"This denies both advantages instead of emphasizing them.","whether … or":"This frames alternatives rather than asserting both advantages."},"no matter how":{"as long as":"This sets a condition and cannot form “as long as carefully the team checked.”","provided that":"This sets a condition and cannot precede the adverb “carefully” in this structure.","even though":"This cannot form the required “even though carefully” clause."},"so … that":{"such … that":"“Such” needs a noun phrase here, as in “such a vast archive.”","too … to":"This cannot connect the adjective “vast” to the finite clause after the second blank.","as … as":"This requires a comparison, not the result clause “the researchers needed several weeks.”"},"the more … the more":{"as … as":"This comparison does not form the paired-correlative structure in the sentence.","so … that":"This requires a result clause rather than two changing quantities.","not only … but also":"This requires two parallel features, not a comparative relationship."},"not only did":{"not only does":"The sentence locates the result in last year's pilot, so present-tense “does” conflicts with the time frame.","not only has":"“Has the revised schedule reduce” is not grammatical; perfect inversion needs “reduced.”","not only was":"“Was the revised schedule reduce” is not grammatical; “was” cannot support this base-form verb."},"no sooner … than":{"hardly … than":"The standard paired form is “hardly … when/before,” not “hardly … than.”","not until … than":"“Not until” does not pair with “than” to express this immediate sequence.","as soon as … than":"“As soon as” does not take “than” as its paired connector."},"it was … that":{"there was … which":"This existential construction does not cleft the object as required by “a simple water filter.”","it had … when":"This does not form an object-focused cleft and “when” cannot introduce the object.","there were … where":"This does not form an object-focused cleft and “where” cannot introduce the object."},"having completed":{"completed having":"The auxiliary and participle are in the wrong order.","to have complete":"The perfect infinitive requires the past participle “completed,” not “complete.”","having been complete":"“Complete” is an adjective here; this form does not express the engineer finishing the inspection."},"so do I":{"neither do I":"This disagrees with the positive statement “I enjoy reading.”","so have I":"The original uses present simple “enjoy,” not the present perfect.","neither I do":"This has incorrect word order for an agreeing response."},"neither have I":{"so have I":"This agrees with a positive statement, but the speaker says “haven't.”","neither I have":"This has incorrect word order for the agreeing negative response.","I haven't neither":"This uses a nonstandard double negative rather than the required response pattern."},"one / ones":{"it / them":"These pronouns refer to specific objects and do not replace the repeated count nouns in the adjective phrases.","this / those":"These demonstratives do not serve as the stated singular/plural noun substitutes.","some / any":"These are quantifiers and do not complete “the smaller” and “the cheaper” as noun substitutes."},"in advance":{"at advance":"The time expression takes “in,” not “at.”","on advance":"The time expression takes “in,” not “on.”","by advance":"“By advance” is not the standard expression for registering ahead of time."},"at risk of":{"in risk of":"The fixed expression is “at risk,” not “in risk.”","on risk of":"The fixed expression is “at risk,” not “on risk.”","at risk to":"The risk is followed by “of” before the potential event."},"on behalf of":{"at behalf of":"The fixed expression is “on behalf of,” not “at behalf of.”","by behalf of":"The fixed expression is “on behalf of,” not “by behalf of.”","on behalf to":"The represented group is introduced by “of,” not “to.”"},"rely on":{"rely to":"The verb “rely” takes “on,” not “to,” for the source of support.","rely for":"“For” does not introduce the people providing the directions after “rely.”","rely with":"The verb “rely” takes “on” before the guides being trusted."},"apologize for":{"apologize of":"The thing being apologized for is introduced by “for.”","apologize with":"“With” does not introduce the delay as the reason for the apology.","apologize from":"“From” does not introduce the event being apologized for."},"be responsible for":{"be responsible of":"The adjective takes “for” before a duty or action.","be responsible with":"“With” does not introduce the project lead's assigned duty.","be responsible from":"“From” does not introduce a responsibility."},"be familiar with":{"be familiar on":"The adjective takes “with” before a process someone knows.","be familiar from":"“From” does not introduce the subject someone knows.","be familiar over":"“Over” does not introduce the subject someone knows."},"access to":{"access for":"The noun “access” takes “to” before the resource available.","access with":"“With” does not introduce the resource available to students.","access on":"The noun “access” takes “to,” not “on,” before the resource."},"prevent someone from":{"prevent someone to":"The verb pattern is “prevent someone from doing,” not an infinitive with “to.”","prevent someone of":"The verb pattern requires “from” before the action.","prevent someone with":"“With” does not introduce the action being prevented."},"take part in":{"take part at":"The fixed expression is “take part in” an event.","take part of":"“Part of” means a portion of something and does not mean participate in it.","take part by":"“By” does not introduce the event someone participates in."},"in September":{"on September":"A month without a specific date takes “in.”","at September":"A month without a specific date takes “in.”","in the September":"Month names used this way do not take “the.”"},"on 2 June":{"in 2 June":"A specific calendar date takes “on,” not “in.”","at 2 June":"A specific calendar date takes “on,” not “at.”","on the 2 June":"The date is conventionally written “on 2 June” without “the.”"},"at 8:30 a.m.":{"in 8:30 a.m.":"A specific clock time takes “at.”","on 8:30 a.m.":"A specific clock time takes “at,” not “on.”","on the 8:30 a.m.":"A clock time takes “at”; “on the 8:30 a.m.” is not a grammatical time phrase."},"in the morning":{"on the morning":"The general period of a day takes “in” in this expression.","at the morning":"The general period of a day takes “in” in this expression.","in morning":"This general time expression requires the article “the.”"},"at night":{"in night":"The standard general time expression is “at night.”","on night":"The standard general time expression is “at night.”","at the night":"The general time expression normally omits “the.”"},"in a small drawer":{"on a small drawer":"The key is inside the drawer, not on its surface.","at a small drawer":"“At” identifies a point or location, not containment inside a drawer.","over a small drawer":"“Over” places the key above the drawer rather than inside it."},"on the desk":{"in the desk":"The prompt specifies the top surface, not inside the desk.","at the desk":"This means at the desk location, not resting on its top surface.","under the desk":"This places the form below the desk, contrary to the prompt."},"at the main entrance":{"in the main entrance":"The speaker waits outside the building, not inside an entrance area.","on the main entrance":"“On” would place the person on the entrance structure, not at the location.","through the main entrance":"“Through” describes movement via the entrance, not waiting outside it."},"in Singapore":{"on Singapore":"A city or country is expressed with “in.”","at Singapore":"A city or country is expressed with “in,” not “at.”","through Singapore":"“Through” describes movement across a place, not living there."},"believe in":{"believe on":"The fixed expression meaning have faith in a principle is “believe in.”","believe at":"“At” does not introduce the principle someone accepts as valuable.","believe for":"“For” does not introduce the object of belief in this meaning."},"focus on":{"focus in":"The verb takes “on” before the subject receiving attention.","focus at":"“At” does not introduce the topic receiving attention.","focus for":"“For” does not introduce the topic receiving attention."},"good at":{"good in":"The usual pattern for ability at an activity is “good at.”","good on":"“On” does not introduce an activity someone performs well.","good for":"“Good for” means beneficial or suitable, not skilled at an activity."},"interested in":{"interested on":"The adjective takes “in” before a subject of interest.","interested at":"“At” does not introduce the subject someone wants to learn about.","interested for":"The adjective takes “in” before the subject of interest."}},"courses":[{"id":"basic-vocabulary-a1-a2-v1","title":"Từ vựng tiếng Anh cơ bản","description":"Học 300 từ A1–A2 qua 25 bài ngắn, luyện chọn từ theo nghĩa tiếng Việt.","lessons":[{"id":"basic-vocabulary-a1-a2-v1-people-family-lesson-1","title":"Con người và gia đình · Người và gia đình","focus":"Những từ thường dùng khi nói về con người, người thân và thông tin cá nhân.","topicId":"people-family","topicTitle":"Con người và gia đình","questions":[{"term":"person","prompt":"Từ tiếng Anh nào có nghĩa “người”?","choices":["person","parent","friend","people"]},{"term":"people","prompt":"Từ tiếng Anh nào có nghĩa “mọi người”?","choices":["people","mother","father","parent"]},{"term":"man","prompt":"Từ tiếng Anh nào có nghĩa “đàn ông”?","choices":["man","person","people","woman"]},{"term":"woman","prompt":"Từ tiếng Anh nào có nghĩa “phụ nữ”?","choices":["woman","boy","girl","family"]},{"term":"child","prompt":"Từ tiếng Anh nào có nghĩa “trẻ em”?","choices":["child","person","people","man"]},{"term":"boy","prompt":"Từ tiếng Anh nào có nghĩa “cậu bé”?","choices":["boy","girl","family","mother"]},{"term":"girl","prompt":"Từ tiếng Anh nào có nghĩa “cô bé”?","choices":["girl","child","boy","family"]},{"term":"family","prompt":"Từ tiếng Anh nào có nghĩa “gia đình”?","choices":["family","mother","father","parent"]},{"term":"mother","prompt":"Từ tiếng Anh nào có nghĩa “mẹ”?","choices":["mother","parent","friend","person"]},{"term":"father","prompt":"Từ tiếng Anh nào có nghĩa “bố”?","choices":["father","parent","friend","person"]},{"term":"parent","prompt":"Từ tiếng Anh nào có nghĩa “cha hoặc mẹ”?","choices":["parent","family","mother","father"]},{"term":"friend","prompt":"Từ tiếng Anh nào có nghĩa “bạn”?","choices":["friend","girl","family","mother"]}]},{"id":"basic-vocabulary-a1-a2-v1-people-family-lesson-2","title":"Con người và gia đình · Người thân","focus":"Những từ thường dùng khi nói về con người, người thân và thông tin cá nhân.","topicId":"people-family","topicTitle":"Con người và gia đình","questions":[{"term":"sister","prompt":"Từ tiếng Anh nào có nghĩa “chị hoặc em gái”?","choices":["sister","cousin","grandmother","grandfather"]},{"term":"brother","prompt":"Từ tiếng Anh nào có nghĩa “anh hoặc em trai”?","choices":["brother","grandmother","grandfather","sister"]},{"term":"son","prompt":"Từ tiếng Anh nào có nghĩa “con trai”?","choices":["son","uncle","cousin","grandmother"]},{"term":"daughter","prompt":"Từ tiếng Anh nào có nghĩa “con gái”?","choices":["daughter","wife","baby","aunt"]},{"term":"husband","prompt":"Từ tiếng Anh nào có nghĩa “chồng”?","choices":["husband","brother","son","daughter"]},{"term":"wife","prompt":"Từ tiếng Anh nào có nghĩa “vợ”?","choices":["wife","daughter","husband","baby"]},{"term":"baby","prompt":"Từ tiếng Anh nào có nghĩa “em bé”?","choices":["baby","son","daughter","husband"]},{"term":"aunt","prompt":"Từ tiếng Anh nào có nghĩa “cô, dì hoặc bác gái”?","choices":["aunt","baby","uncle","cousin"]},{"term":"uncle","prompt":"Từ tiếng Anh nào có nghĩa “chú, cậu hoặc bác trai”?","choices":["uncle","cousin","grandmother","grandfather"]},{"term":"cousin","prompt":"Từ tiếng Anh nào có nghĩa “anh, chị hoặc em họ”?","choices":["cousin","brother","son","daughter"]},{"term":"grandmother","prompt":"Từ tiếng Anh nào có nghĩa “bà”?","choices":["grandmother","husband","wife","baby"]},{"term":"grandfather","prompt":"Từ tiếng Anh nào có nghĩa “ông”?","choices":["grandfather","husband","wife","baby"]}]},{"id":"basic-vocabulary-a1-a2-v1-people-family-lesson-3","title":"Con người và gia đình · Thông tin cá nhân","focus":"Những từ thường dùng khi nói về con người, người thân và thông tin cá nhân.","topicId":"people-family","topicTitle":"Con người và gia đình","questions":[{"term":"guest","prompt":"Từ tiếng Anh nào có nghĩa “khách”?","choices":["guest","partner","colleague","adult"]},{"term":"customer","prompt":"Từ tiếng Anh nào có nghĩa “khách hàng”?","choices":["customer","colleague","adult","teenager"]},{"term":"partner","prompt":"Từ tiếng Anh nào có nghĩa “bạn đời hoặc đối tác”?","choices":["partner","marriage","surname","address"]},{"term":"colleague","prompt":"Từ tiếng Anh nào có nghĩa “đồng nghiệp”?","choices":["colleague","surname","address","age"]},{"term":"adult","prompt":"Từ tiếng Anh nào có nghĩa “người trưởng thành”?","choices":["adult","age","birthday","guest"]},{"term":"teenager","prompt":"Từ tiếng Anh nào có nghĩa “thiếu niên”?","choices":["teenager","customer","partner","colleague"]},{"term":"couple","prompt":"Từ tiếng Anh nào có nghĩa “cặp đôi”?","choices":["couple","surname","address","age"]},{"term":"marriage","prompt":"Từ tiếng Anh nào có nghĩa “hôn nhân”?","choices":["marriage","customer","partner","colleague"]},{"term":"surname","prompt":"Từ tiếng Anh nào có nghĩa “họ”?","choices":["surname","teenager","couple","marriage"]},{"term":"address","prompt":"Từ tiếng Anh nào có nghĩa “địa chỉ”?","choices":["address","guest","customer","partner"]},{"term":"age","prompt":"Từ tiếng Anh nào có nghĩa “tuổi”?","choices":["age","surname","address","birthday"]},{"term":"birthday","prompt":"Từ tiếng Anh nào có nghĩa “sinh nhật”?","choices":["birthday","adult","teenager","couple"]}]},{"id":"basic-vocabulary-a1-a2-v1-home-lesson-1","title":"Nhà cửa và đồ dùng · Phòng trong nhà","focus":"Từ gọi tên các phòng, vật dụng và đồ dùng quen thuộc trong nhà.","topicId":"home","topicTitle":"Nhà cửa và đồ dùng","questions":[{"term":"house","prompt":"Từ tiếng Anh nào có nghĩa “ngôi nhà”?","choices":["house","bedroom","bathroom","door"]},{"term":"home","prompt":"Từ tiếng Anh nào có nghĩa “nhà, nơi ở”?","choices":["home","apartment","room","kitchen"]},{"term":"apartment","prompt":"Từ tiếng Anh nào có nghĩa “căn hộ”?","choices":["apartment","garden","house","home"]},{"term":"room","prompt":"Từ tiếng Anh nào có nghĩa “phòng”?","choices":["room","apartment","kitchen","bedroom"]},{"term":"kitchen","prompt":"Từ tiếng Anh nào có nghĩa “nhà bếp”?","choices":["kitchen","room","bedroom","bathroom"]},{"term":"bedroom","prompt":"Từ tiếng Anh nào có nghĩa “phòng ngủ”?","choices":["bedroom","wall","floor","garden"]},{"term":"bathroom","prompt":"Từ tiếng Anh nào có nghĩa “phòng tắm”?","choices":["bathroom","kitchen","bedroom","door"]},{"term":"door","prompt":"Từ tiếng Anh nào có nghĩa “cửa ra vào”?","choices":["door","floor","garden","house"]},{"term":"window","prompt":"Từ tiếng Anh nào có nghĩa “cửa sổ”?","choices":["window","bathroom","door","wall"]},{"term":"wall","prompt":"Từ tiếng Anh nào có nghĩa “bức tường”?","choices":["wall","garden","house","home"]},{"term":"floor","prompt":"Từ tiếng Anh nào có nghĩa “sàn nhà”?","choices":["floor","kitchen","bedroom","bathroom"]},{"term":"garden","prompt":"Từ tiếng Anh nào có nghĩa “khu vườn”?","choices":["garden","bathroom","door","window"]}]},{"id":"basic-vocabulary-a1-a2-v1-home-lesson-2","title":"Nhà cửa và đồ dùng · Đồ dùng quen thuộc","focus":"Từ gọi tên các phòng, vật dụng và đồ dùng quen thuộc trong nhà.","topicId":"home","topicTitle":"Nhà cửa và đồ dùng","questions":[{"term":"table","prompt":"Từ tiếng Anh nào có nghĩa “cái bàn”?","choices":["table","lamp","mirror","key"]},{"term":"chair","prompt":"Từ tiếng Anh nào có nghĩa “cái ghế”?","choices":["chair","fork","table","bed"]},{"term":"bed","prompt":"Từ tiếng Anh nào có nghĩ