rowth.","choices":["refine a corporate strategy","record payment transactions","record the payments","settle a balance"],"componentWords":[{"term":"refine","definition":"Lọc, lọc trong, luyện tinh, tinh chế."}]}]},{"id":"toeic-advanced-collocations-v1-general-business-lesson-46","title":"Bài 46","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"strengthen market position","prompt":"We need to invest in new advertising to _____ against our rivals.","choices":["strengthen market position","carry on with","cash in on","restart the server"],"componentWords":[{"term":"position","definition":"Vị trí, chỗ (của một vật gì)."}]},{"term":"carry on with","prompt":"Please _____ your tasks while I attend to the client's request.","choices":["carry on with","strengthen market position","cash in on","exceed the budget"],"componentWords":[{"term":"carry","definition":"Mang, vác, khuân, chở; ẵm."}]},{"term":"cash in on","prompt":"The company hopes to _____ the growing demand for sustainable products.","choices":["cash in on","strengthen market position","carry on with","draft a contract"],"componentWords":[{"term":"cash","definition":"Trả tiền mặt, lĩnh tiền mặt."}]}]},{"id":"toeic-advanced-collocations-v1-general-business-lesson-47","title":"Bài 47","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"catch up with","prompt":"If you don't update your skills, the rapid technological changes will eventually _____ you.","choices":["catch up with","build customer loyalty","evaluate vendor performance","manage a company merger"],"componentWords":[{"term":"catch","definition":"Bắt lấy, nắm lấy, tóm lấy, chộp lấy."}]},{"term":"build customer loyalty","prompt":"Providing quality support helps _____ effectively.","