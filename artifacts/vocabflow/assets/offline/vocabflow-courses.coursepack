ittee"]},{"term":"bind","prompt":"They had to _____ his hands and feet tightly.","choices":["bind","severely","situation","sociology"]},{"term":"bizarre","prompt":"The room had a _____ smell and look.","choices":["bizarre","startling","stash","steadily"]},{"term":"bland","prompt":"She gave a _____ smile and left quietly.","choices":["bland","crowbar","crush","cryptic"]},{"term":"blank","prompt":"He stared at me with a _____ expression.","choices":["blank","damp","damper","dead"]},{"term":"blemish","prompt":"There was a small _____ on the apple.","choices":["blemish","modernisation","modernism","modernist"]},{"term":"blend","prompt":"These two colors _____ well together in this painting.","choices":["blend","safeguard","seal","signature"]},{"term":"blur","prompt":"The hill was only a _____ in the fog.","choices":["blur","immune","alive","animate"]},{"term":"boggle","prompt":"He did _____ at the huge price.","choices":["boggle","involvement","jointly","kiss"]},{"term":"bold","prompt":"It was _____ to speak in class.","choices":["bold","excellence","expel","facilitate"]},{"term":"bolster","prompt":"She leaned on a soft _____.","choices":["bolster","center","central","centre"]},{"term":"boob","prompt":"Don't be a _____ and forget your keys.","choices":["boob","festival","theater","cinema"]},{"term":"boring","prompt":"The _____ made a clean hole through the wood.","choices":["boring","dental","detoxify","diagnose"]},{"term":"bounce","prompt":"He got the _____ after staying too late.","choices":["bounce","profit","account","accumulation"]},{"term":"boundless","prompt":"The children played in the _____ ocean.","choices":["boundless","fitness","exercise","wellness"]},{"term":"break","prompt":"He rode in a _____ behind the team.","choices":["break","composition","concert","convent"]},{"term":"breezily","prompt":"The team finished _____ and left.","choices":["breezily","language","linguist","linguistic"]}],"chapterId":"academic-reading","chapterTitle":"Đọc hiểu học thuật","chapterNumber":10},{"id":"ielts-topic-vocabulary-v1-general-reading-reading-lesson-5","title":"Reading · Bài 5","focus":"Từ vựng học thuật và các từ thường gặp trong bài đọc IELTS.","topicId":"general-reading","topicTitle":"Đọc hiểu tổng hợp","questions":[{"term":"bright","prompt":"The _____ sunshine warmed my face this morning.","choices":["bright","traveler","traveling","tour"]},{"term":"brilliant","prompt":"The _____ sunshine woke me up early this morning.","choices":["brilliant","contradict","contrast","correlate"]},{"term":"brisk","prompt":"We walked at a _____ pace toward the station.","choices":["brisk","extra","extraordinary","extreme"]},{"term":"broad","prompt":"They walked down a _____ street in the city.","choices":["broad","confidence","confidently","confuse"]},{"term":"broaden","prompt":"Travel can _____ your view of life.","choices":["broaden","agency","agent","ambitious"]},{"term":"broadly","prompt":"She answered _____ and smiled.","choices":["broadly","aeroplane","airborne","aircraft"]},{"term":"broke","prompt":"He _____ the glass by accident.","choices":["broke","ozone","atmosphere","basin"]},{"term":"broken","prompt":"Be careful because that glass vase is _____.","choices":["broken","outline","overview","paradox"]},{"term":"brown","prompt":"He found a small _____ coin on the floor.","choices":["brown","illogical","illuminate","illustrate"]},{"term":"brush","prompt":"Give your clothes a good _____ before leaving.","choices":["brush","potent","pressurize","quantifiable"]},{"term":"bubble","prompt":"The plan turned out to be a _____.","choices":["bubble","collaboration","colleague","competence"]},{"term":"budge","prompt":"The heavy door will not _____ at all.","choices":["budge","staple","stark","startling"]},{"term":"buildup","prompt":"Snow _____ on roads makes for hazardous driving.","choices":["buildup","wooden","zinc","afterward"]},{"term":"bump","prompt":"She has a natural _____ for learning languages.","choices":["bump","poverty","urbanisation","p