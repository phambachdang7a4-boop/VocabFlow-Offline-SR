e","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"In the pink","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"In the red","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-041"]}},{"term":"in the same boat","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-041"]}},{"term":"In the sticks","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-041"]}},{"term":"In the way","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-041"]}},{"term":"in-room dining","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-dining-hospitality-lesson-2"]},"senses":[{"definition":"dịch vụ ăn uống tại phòng","example":"Guests can request in-room dining by calling the reception.","pos":"Phrase","subPos":null}]},{"term":"inability","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-psychology-reading-lesson-8"]}},{"term":"inaccessible","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-20"]}},{"term":"inaccuracy","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-academic-methods-reading-lesson-6"]}},{"term":"inaccurate","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-academic-methods-reading-lesson-6"]}},{"term":"inactive","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-21"]}},{"term":"inadequate","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vo