r.","choices":["run out of ink","put an end to","submit an insurance claim","book specialist appointment"],"componentWords":[]},{"term":"put an end to","prompt":"Management decided to _____ the informal dress code policy.","choices":["put an end to","request a printout","run out of ink","dental insurance policy"],"componentWords":[{"term":"put","definition":"Để, đặt, bỏ, đút, cho vào (ở đâu, vào cái gì... )."},{"term":"end","definition":"Sự kết thúc"}]}]},{"id":"toeic-advanced-collocations-v1-office-issues-lesson-60","title":"Bài 158","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"draft a report","prompt":"I will _____ on the current sales performance.","choices":["draft a report","edit the slides","access patient portal","monitor patient vital signs"],"componentWords":[]},{"term":"verify the figures","prompt":"The accountant needs to _____ before finalizing the report.","choices":["verify the figures","edit the slides","prepare a guest list","analyze guest feedback"],"componentWords":[{"term":"figures","definition":"Hình dáng."}]},{"term":"edit the slides","prompt":"He will _____ for the meeting tomorrow.","choices":["edit the slides","draft a report","verify the figures","notify the staff"],"componentWords":[{"term":"slides","definition":"Sự trượt."}]}]},{"id":"toeic-advanced-collocations-v1-office-issues-lesson-61","title":"Bài 159","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"update the logs","prompt":"Ensure that employees _____ for equipment daily.","choices":["update the logs","cancel an appointment","adjust the schedule","prepare a guest list"],"componentWords":[{"term":"logs","definition":"Khúc gỗ mới đốn, khúc gỗ mới xẻ."}]},{"term":"adjust the schedule","prompt":"We must _____ to accommodate the guest speaker.","choices":["adju