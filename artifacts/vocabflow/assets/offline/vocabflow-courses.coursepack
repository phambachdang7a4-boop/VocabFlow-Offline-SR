y","modify","multiply"]},{"term":"poultry","prompt":"They kept _____ in a clean yard.","choices":["poultry","holocaust","invader","invasion"]},{"term":"produce","prompt":"The factory's annual _____ is very high.","choices":["produce","suggest","suggestive","summarise"]},{"term":"pumpkin","prompt":"We carved a _____ for the porch.","choices":["pumpkin","chew","childbirth","chill"]}],"chapterId":"environment-resources","chapterTitle":"Môi trường & tài nguyên","chapterNumber":4},{"id":"ielts-topic-vocabulary-v1-agriculture-reading-lesson-7","title":"Reading · Bài 7","focus":"Trồng trọt, chăn nuôi, nguồn cung thực phẩm và dinh dưỡng.","topicId":"agriculture","topicTitle":"Nông nghiệp và thực phẩm","questions":[{"term":"pungency","prompt":"The soup had a pleasant _____ from garlic.","choices":["pungency","language","linguist","illiteracy"]},{"term":"ranch","prompt":"They bought fresh eggs from the _____.","choices":["ranch","forsaken","frantic","frenzied"]},{"term":"recipe","prompt":"The doctor wrote a _____ for the medicine.","choices":["recipe","banana","barbecue","bean"]},{"term":"rice","prompt":"We bought some white _____ at the market.","choices":["rice","lion","lizard","lobster"]},{"term":"ripe","prompt":"I picked a _____ apple from the tree.","choices":["ripe","drive","driver","exit"]},{"term":"ripen","prompt":"Let the fruit _____ before you eat it.","choices":["ripen","thesis","undergraduate","uneducated"]},{"term":"salmon","prompt":"We had grilled _____ for dinner.","choices":["salmon","lose","loud","lower"]},{"term":"salt","prompt":"Do you need to add more _____ to soup?","choices":["salt","sunlit","sunny","temperate"]},{"term":"salty","prompt":"The plan looked _____ in practice.","choices":["salty","nursery","orientation","pass"]},{"term":"sausage","prompt":"The old _____ floated high above the field.","choices":["sausage","barren","bogs","conserve"]},{"term":"seed","prompt":"They hope to raise up _____ for future generations.","choices":["seed","genus","geneticist","germ"]},{"term":"seedling","prompt":"A _____ pushed up through the soil.","choices":["seedling","double","downright","drastic"]},{"term":"sesame","prompt":"We sprinkled _____ seeds on the bread.","choices":["sesame","cannibalism","cemetery","clan"]},{"term":"sheep","prompt":"He felt like a _____ at the party.","choices":["sheep","sway","sweep","table"]},{"term":"shell","prompt":"The _____ was important at work.","choices":["shell","manipulate","mechanical","operate"]},{"term":"slaughter","prompt":"The _____ of the cow took place quietly.","choices":["slaughter","necessarily","necessary","necessitate"]},{"term":"slice","prompt":"Would you like a _____ of chocolate cake?","choices":["slice","suburban","uncrowded","uptown"]},{"term":"snack","prompt":"I ate a _____ before the long walk.","choices":["snack","binder","biscuit","boil"]},{"term":"soda","prompt":"Add _____ to the mixture carefully.","choices":["soda","backtrack","bagged","bags"]},{"term":"soup","prompt":"I would like a bowl of hot _____.","choices":["soup","stark","startling","stash"]},{"term":"sown","prompt":"He _____ seeds in neat rows.","choices":["sown","unimpeded","unique","uniquely"]},{"term":"spade","prompt":"He drew a _____ from the deck.","choices":["spade","woolly","worst","worthwhile"]},{"term":"spice","prompt":"Her stories bring _____ to our quiet evenings.","choices":["spice","autobiography","ballad","banquet"]},{"term":"sprout","prompt":"Small green leaves begin to _____ from the ground.","choices":["sprout","democracy","dictatorship","execution"]}],"chapterId":"environment-resources","chapterTitle":"Môi trường & tài nguyên","chapterNumber":4},{"id":"ielts-topic-vocabulary-v1-agriculture-reading-lesson-8","title":"Reading · Bài 8","focus":"Trồng trọt, chăn nuôi, nguồn cung thực phẩm và dinh dưỡng.","topicId":"agriculture","topicTitle":"Nông nghiệp và thực phẩm","questions":[{"term":"straw","prompt":"She wore a _____ hat at the beach.","choices":["straw","liver","lotion","lung"]},{"term":"strawberry","prompt":"A _____ grew well in the small garden.","choices":["strawberry","conserve","cool","destroy"]},{"term":"sugar","prompt":"I need to buy some white _____ today.","choices":["sugar","hospitalization","vaccination","infection"]},{"term":"sweet","prompt":"We need to find some fresh _____ water.","choices":["sweet","senior","severe","teeming"]},{"term":"sweetener","prompt":"I used a natural _____ in my drink.","choices":["sweetener","inherent","inherently","inhibit"]},{"term":"taro","prompt":"The _____ was soft and sweet after boiling.","choices":["taro","hint","holder","hole"]},{"term":"teas","prompt":"She _____ the hair with a comb.","choices":["teas","equaled","equalise","equalize"]},{"term":"topping","prompt":"We did the _____ to keep the tree small.","choices":["topping","sister","spouse","teenager"]},{"term":"tractor","prompt":"The _____ pulled the heavy cart across the field.","choices":["tractor","evacuate","excommunication","faithful"]},{"term":"vanilla","prompt":"The _____ plant grew well in the warm garden.","choices":["vanilla","ageing","baby","brother"]},{"term":"vegetable","prompt":"Plants are part of the diverse _____ kingdom.","choices":["vegetable","honest","impolite","inconsiderate"]},{"term":"vegetarian","prompt":"I prefer to eat _____ food for my health.","choices":["vegetarian","fellow","fight","fighter"]},{"term":"vine","prompt":"The _____ climbed slowly over the wall.","choices":["vine","lure","lurk","maintain"]},{"term":"waffle","prompt":"He ate a _____ with fruit and honey.","choices":["waffle","passive","perceive","perceptional"]},{"term":"walnut","prompt":"I cracked a _____ and ate the nut.","choices":["walnut","justify","liken","linear"]},{"term":"weed","prompt":"The garden was full of _____.","choices":["weed","incidental","incompatible","incomplete"]},{"term":"weedkiller","prompt":"Spray the path with _____ today.","choices":["weedkiller","sunburn","supplement","surgeon"]},{"term":"weedy","prompt":"He was pale and _____ after the illness.","choices":["weedy","plausible","positive","potential"]},{"term":"wool","prompt":"My grandmother knitted a soft ball of _____.","choices":["wool","beyond","blemish","blur"]},{"term":"yield","prompt":"The farm had a high _____ of corn.","choices":["yield","premature","prematurely","prepare"]}],"chapterId":"environment-resources","chapterTitle":"Môi trường & tài nguyên","chapterNumber":4},{"id":"ielts-topic-vocabulary-v1-earth-science-lesson-1","title":"Bài 230","focus":"Địa chất, địa mạo, khí quyển, trầm tích và biến đổi khí hậu.","topicId":"earth-science","topicTitle":"Khoa học Trái Đất và khí hậu","questions":[{"term":"atmospheric","prompt":"_____ pressure decreases as altitude increases, affecting boiling points and weather patterns.","choices":["atmospheric","inflammation","inhale","inject"]},{"term":"continent","prompt":"Africa is the second-largest _____ and contains diverse climatic and geological regions.","choices":["continent","family","child","childhood"]},{"term":"continental","prompt":"_____ crust is generally thicker and less dense than oceanic crust.","choices":["continental","overturn","overwhelmingly","pace"]},{"term":"earthquake","prompt":"An _____ occurs when accumulated stress is suddenly released along a geological fault.","choices":["earthquake","phosphate","pigment","platinum"]},{"term":"geological","prompt":"_____ mapping can reveal buried faults that influence regional earthquake risk.","choices":["geological","vastly","vaunt","volume"]},{"term":"geologist","prompt":"The _____ analysed sediment layers to reconstruct ancient changes in the river valley.","choices":["geologist","disappearance","distinction","doom"]},{"term":"geology","prompt":"_____ helps researchers explain how volcanic activity has shaped the island.","choices":["geology","arrow","ascent","aside"]},{"term":"glacier","prompt":"The _____ is retreating rapidly as regional temperatures continue to rise.","choices":["glacier","aimed","aiming","aims"]},{"term":"meteorological","prompt":"_____ records reveal significant changes in rainfall patterns over recent decades.","choices":["meteorological","larva","legs","limb"]},{"term":"meteorologist","prompt":"The _____ predicted severe storms by analysing pressure and wind patterns.","choices":["meteorologist","otter","pack","parrot"]},{"term":"meteorology","prompt":"_____ combines atmospheric observations with mathematical models to improve weather forecasts.","choices":["meteorology","tolerate","tribal","unapproachable"]},{"term":"sediment","prompt":"Heavy rainfall carried _____ from the hills into the coastal estuary.","choices":["sediment","available","borrow","bought"]},{"term":"sedimentation","prompt":"Rapid _____ can bury organic material before oxygen fully decomposes it.","choices":["sedimentation","undeniably","underestimate","underlie"]},{"term":"tectonic","prompt":"_____ movements gradually raise mountain ranges and reshape drainage patterns across continents.","choices":["tectonic","sexologist","sexually","sicken"]},{"term":"tidal","prompt":"_____ currents transport fine sediments into coastal marshes and shallow estuaries.","choices":["tidal","dialogue","dictionary","disagree"]},{"term":"volcanic","prompt":"_____ ash can travel thousands of kilometres and temporarily reduce air quality.","choices":["volcanic","feminist","feminization","bias"]},{"term":"climate","prompt":"_____ records reveal that prolonged droughts are becoming more frequent across several agricultural regions.","choices":["climate","stamp","staple","stench"]},{"term":"dioxide","prompt":"Industrial emissions release carbon _____, which traps heat and contributes to global warming.","choices":["dioxide","spot","sprang","spray"]},{"term":"ozone","prompt":"Stratospheric _____ absorbs ultraviolet radiation and protects living organisms from harmful solar exposure.","choices":["ozone","posterior","postpone","potter"]}],"chapterId":"environment-resources","chapterTitle":"Môi trường & tài nguyên","chapterNumber":4},{"id":"ielts-topic-vocabulary-v1-earth-science-reading-lesson-1","title":"Reading · Bài 1","focus":"Địa chất, địa mạo, khí quyển, trầm tích và biến đổi khí hậu.","topicId":"earth-science","topicTitle":"Khoa học Trái Đất và khí hậu","questions":[{"term":"atmosphere","prompt":"Spacecraft can travel into the upper _____ of our planet.","choices":["atmosphere","extensive","extensively","external"]},{"term":"basin","prompt":"Farmers live in the _____ below the mountains.","choices":["basin","enroll","graduating","lecturing"]},{"term":"blizzard","prompt":"A _____ kept us indoors all day.","choices":["blizzard","sing","sonnet","spectacular"]},{"term":"blow","prompt":"He dealt a heavy _____ to the wooden door.","choices":["blow","dried","drying","eaten"]},{"term":"calm","prompt":"The sea was _____ and quiet at dawn.","choices":["calm","manatee","mastodon","meow"]},{"term":"cataract","prompt":"A _____ fell for hours on the road.","choices":["cataract","nervous","neural","numb"]},{"term":"catastrophe","prompt":"The flood was a _____ for the village.","choices":["catastrophe","constriction","cure","danger"]},{"term":"catastrophic","prompt":"The storm caused _____ damage downtown.","choices":["catastrophic","meat","milk","millet"]},{"term":"clime","prompt":"She dreamed of living in a warm _____.","choices":["clime","customary","customise","customize"]},{"term":"cloud","prompt":"A _____ of dust rose from the road.","choices":["cloud","discriminating","discriminative","discriminatory"]},{"term":"core","prompt":"You must understand the _____ of this subject.","choices":["core","basin","blizzard","blow"]},{"term":"crater","prompt":"The hikers looked into the _____ from the edge.","choices":["crater","inform","informative","late"]},{"term":"crust","prompt":"I left a _____ of bread on the plate.","choices":["crust","pear","pest","pizza"]},{"term":"digging","prompt":"_____ took most of the afternoon.","choices":["digging","ruthlessly","satisfy","scary"]},{"term":"digs","pro