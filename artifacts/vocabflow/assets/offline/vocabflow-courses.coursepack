ittle","prompt":"He carried a _____ in his pocket.","choices":["whittle","sums","suppose","systematic"]},{"term":"whizz","prompt":"A _____ passed overhead in the night.","choices":["whizz","excited","exciting","expect"]}],"chapterId":"academic-reading","chapterTitle":"Đọc hiểu học thuật","chapterNumber":10},{"id":"ielts-topic-vocabulary-v1-general-reading-reading-lesson-46","title":"Reading · Bài 46","focus":"Từ vựng học thuật và các từ thường gặp trong bài đọc IELTS.","topicId":"general-reading","topicTitle":"Đọc hiểu tổng hợp","questions":[{"term":"wholly","prompt":"I do not _____ agree with your opinion.","choices":["wholly","dissolve","dyes","enamel"]},{"term":"widely","prompt":"This book is _____ read by students all over.","choices":["widely","baseline","beaker","breakthrough"]},{"term":"widen","prompt":"They _____ the road next month.","choices":["widen","fresh","fruit","garden"]},{"term":"widespread","prompt":"The rumor became _____ in the town.","choices":["widespread","adrenalin","aggravate","ailment"]},{"term":"width","prompt":"The road has a great _____ for large trucks.","choices":["width","lucrative","merge","minimise"]},{"term":"wipe","prompt":"The child got a playful _____ on the arm.","choices":["wipe","successful","superior","tactical"]},{"term":"withdraw","prompt":"The army will _____ troops from the border.","choices":["withdraw","interactive","interface","keyboard"]},{"term":"withdrawal","prompt":"His _____ from the debate ended the argument.","choices":["withdrawal","colonial","colonialist","past"]},{"term":"withstand","prompt":"The old bridge can _____ the heavy storm.","choices":["withstand","elector","parliament","parliamentary"]},{"term":"wobble","prompt":"The boat began to _____ in the water.","choices":["wobble","poacher","rampage","rape"]},{"term":"wonderful","prompt":"It was a _____ day at the beach.","choices":["wonderful","recognize","recollection","relax"]},{"term":"woolly","prompt":"His description of the plan was a bit _____.","choices":["woolly","computer","computing","internet"]},{"term":"worse","prompt":"I fear that there was something _____ to come.","choices":["worse","path","pathway","peak"]},{"term":"worst","prompt":"That was the _____ day of my week.","choices":["worst","stealth","sued","surveillance"]},{"term":"worthwhile","prompt":"It is _____ to visit the museum.","choices":["worthwhile","frigid","geologic","geophysical"]},{"term":"worthy","prompt":"We must respect all _____ people in our town.","choices":["worthy","cooperation","courtesy","craze"]},{"term":"wreak","prompt":"Do not _____ vengeance upon those who helped you.","choices":["wreak","platform","port","queue"]},{"term":"wrench","prompt":"He felt a sharp _____ in his ankle.","choices":["wrench","yellow","yowl","zero"]},{"term":"wrinkle","prompt":"He gave me a _____ about the secret plan.","choices":["wrinkle","knowledge","ability","absence"]},{"term":"yard","prompt":"The sailors adjusted the _____ on the ship.","choices":["yard","react","reactive","rectangular"]},{"term":"yellow","prompt":"The autumn leaves turned _____ on the trees.","choices":["yellow","lesser","lest","level"]},{"term":"yowl","prompt":"The _____ from the cat startled me.","choices":["yowl","consistently","contradict","contradictory"]},{"term":"zero","prompt":"The temperature reached _____ during the cold night.","choices":["zero","inferior","inflate","infuse"]},{"term":"zoom","prompt":"They discussed the _____ today.","choices":["zoom","hare","hatch","hatchling"]}],"chapterId":"academic-reading","chapterTitle":"Đọc hiểu học thuật","chapterNumber":10}],"entriesByTerm":{"curriculum":{"definition":"Chương trình giảng dạy.","example":"The new curriculum includes more writing practice.","exampleTranslation":"Chương trình giảng dạy mới có thêm phần luyện viết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"literacy":{"definition":"Khả năng đọc và viết.","example":"Reading practice can improve literacy quickly.","exampleTranslation":"Việc luyện đọc có thể nhanh chóng cải thiện khả năng đọc viết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"tuition":{"definition":"Học phí; tiền phải trả cho việc học.","example":"The tuition was lower than expected.","exampleTranslation":"Học phí thấp hơn dự kiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"compulsory":{"definition":"Bắt buộc; phải thực hiện theo quy định.","example":"Wearing a uniform is compulsory for all students.","exampleTranslation":"Tất cả học sinh đều bắt buộc phải mặc đồng phục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"assessment":{"definition":"Sự đánh giá; quá trình xem xét mức độ hoặc kết quả.","example":"Her assessment of the problem was very accurate.","exampleTranslation":"Đánh giá của cô ấy về vấn đề rất chính xác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"educated":{"definition":"Quá khứ và phân từ quá khứ của educate","example":"They educated the children at home.","exampleTranslation":"Họ đã giáo dục con cái tại nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"educat"},"education":{"definition":"Sự giáo dục, sự cho ăn học.","example":"Education can change a child's future.","exampleTranslation":"Giáo dục có thể thay đổi tương lai của một đứa trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"educat"},"educative":{"definition":"Có tác dụng giáo dục.","example":"The story had an educative lesson.","exampleTranslation":"Câu chuyện mang một bài học có tính giáo dục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"educat"},"educator":{"definition":"Thầy dạy.","example":"The educator answered every student question.","exampleTranslation":"Nhà giáo dục đã trả lời mọi câu hỏi của học sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"educat"},"learned":{"definition":"Hay chữ, có học thức, thông thái, uyên bác.","example":"The learned man spent his life studying ancient books.","exampleTranslation":"Người đàn ông uyên bác ấy đã dành cả đời để nghiên cứu các cuốn sách cổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"learn"},"learner":{"definition":"Người học, học trò, người mới học.","example":"She is a learner and asks many questions.","exampleTranslation":"Cô ấy là người ham học hỏi và đặt nhiều câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"learn"},"learning":{"definition":"Sự hiểu biết; kiến thức.","example":"He is a man of great learning and wisdom.","exampleTranslation":"Ông ấy là người uyên bác và thông thái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"learn"},"teach":{"definition":"Dạy, dạy học; dạy bảo, dạy dỗ.","example":"She will teach us how to cook.","exampleTranslation":"Cô ấy sẽ dạy chúng tôi cách nấu ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"teach"},"teacher":{"definition":"Giáo viên, cán bộ giảng dạy.","example":"The teacher explained the lesson with care.","exampleTranslation":"Người giáo viên đã giải thích bài học một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"teach"},"teaching":{"definition":"Sự dạy, sự giảng dạy; sự dạy bảo.","example":"Teaching takes patience and clear speech.","exampleTranslation":"Việc giảng dạy đòi hỏi sự kiên nhẫn và cách nói năng rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"teach"},"school":{"definition":"Trường học, học đường.","example":"My younger brother goes to a local school.","exampleTranslation":"Em trai tôi theo học tại một trường học ở địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"school"},"schooled":{"definition":"Quá khứ và phân từ quá khứ của school","example":"She schooled the child in good manners.","exampleTranslation":"Cô ấy đã dạy dỗ đứa trẻ về cách cư xử đúng mực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"school"},"schooling":{"definition":"Sự dạy dỗ ở nhà trường, sự giáo dục ở nhà trường.","example":"Her schooling helped her find a good job.","exampleTranslation":"Quá trình học tập đã giúp cô ấy tìm được một công việc tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"school"},"schools":{"definition":"Trường học; các cơ sở giáo dục dành cho học sinh.","example":"Many local schools offer free lunch to students.","exampleTranslation":"Nhiều trường học ở địa phương cung cấp bữa trưa miễn phí cho học sinh.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"school"},"university":{"definition":"trường đại học","example":"A doctor studies for many years at a university before going to work in a hospital.","exampleTranslation":"Một bác sĩ phải học nhiều năm tại trường đại học trước khi đi làm tại bệnh viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"universit"},"academic":{"definition":"Có tính chất học thuật.","example":"They had a long academic debate about history.","exampleTranslation":"Họ đã có một cuộc tranh luận học thuật dài về lịch sử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academ"},"academy":{"definition":"Học viện.","example":"He wants to join the military academy next year.","exampleTranslation":"Anh ấy muốn tham gia học viện quân sự vào năm sau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academ"},"exam":{"definition":"(viết tắt) của examination.","example":"I need to study hard for my final exam.","exampleTranslation":"Tôi cần học tập chăm chỉ cho kỳ thi cuối khóa của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"exam"},"assess":{"definition":"Định giá (tài sản, hoa lợi... ) để đánh thuế; đánh giá; ước định.","example":"They assess the house before setting the tax.","exampleTranslation":"Họ đánh giá ngôi nhà trước khi đặt mức thuế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"assess"},"student":{"definition":"Học sinh đại học, sinh viên.","example":"The student asked a smart question.","exampleTranslation":"Học sinh đã đặt một câu hỏi rất thông minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"student"},"scholar":{"definition":"Học giả; người có kiến thức chuyên sâu, thường tham gia nghiên cứu.","example":"As a scholar, she loved learning new ideas.","exampleTranslation":"Với tư cách là một học giả, cô ấy thích tìm hiểu những ý tưởng mới.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"scholar"},"scholarship":{"definition":"Học bổng.","example":"She worked hard to win a full scholarship.","exampleTranslation":"Cô ấy đã làm việc chăm chỉ để giành được một suất học bổng toàn phần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"scholar"},"tutor":{"definition":"Gia sư; người dạy kèm cho một cá nhân hoặc nhóm nhỏ.","example":"The tutor met the student after class.","exampleTranslation":"Gia sư đã gặp học sinh sau giờ học.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tutor"},"tutored":{"definition":"Quá khứ và phân từ quá khứ của tutor","example":"He tutored me in math last year.","exampleTranslation":"Anh ấy đã dạy kèm môn toán cho tôi vào năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"tutor"},"enroll":{"definition":"Đăng ký hoặc ghi danh tham gia khóa học, trường học hay chương trình.","example":"Students can enroll in the course online before classes begin.","exampleTranslation":"Học sinh có thể đăng ký khóa học trực tuyến trước khi lớp bắt đầu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"enroll"},"enrollment":{"definition":"Như enrolment.","example":"Enrollment starts next week for new students.","exampleTranslation":"Việc ghi danh bắt đầu vào tuần tới cho các học sinh mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"enroll"},"graduating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của graduate.","example":"He is graduating this spring.","exampleTranslation":"Anh ấy sẽ tốt nghiệp vào mùa xuân này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"graduat"},"graduation":{"definition":"Lễ tốt nghiệp; việc hoàn thành một chương trình học.","example":"She celebrated her graduation after completing her degree.","exampleTranslation":"Cô ấy ăn mừng lễ tốt nghiệp sau khi hoàn thành chương trình học.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"graduat"},"classroom":{"definition":"Lớp học; phòng học trong trường.","example":"The students waited quietly in the classroom.","exampleTranslation":"Các học sinh đợi trong lớp học một cách lặng lẽ.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"classroom"},"lecturer":{"definition":"Người diễn thuyết, người thuyết trình.","example":"The lecturer spoke clearly and kept our attention.","exampleTranslation":"Giảng viên đã nói rất rõ ràng và giữ được sự chú ý của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"lectur"},"lecturing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của lecture.","example":"She is lecturing on healthy habits today.","exampleTranslation":"Hôm nay, cô ấy đang giảng về những thói quen lành mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"lectur"},"knowledge":{"definition":"Sự biết.","example":"I have no knowledge of his secret plans.","exampleTranslation":"Tôi không biết gì về những kế hoạch bí mật của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"knowledge"},"knowledgeable":{"definition":"Thông thạo, biết nhiều.","example":"She is knowledgeable about plants and birds.","exampleTranslation":"Cô ấy rất am hiểu về các loài thực vật và chim chóc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"knowledge"},"ability":{"definition":"Tài năng, tài cán.","example":"He has the ability to speak three languages.","exampleTranslation":"Anh ấy có khả năng nói ba ngôn ngữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"absence":{"definition":"Sự vắng mặt, sự nghỉ (học), sự đi vắng; thời gian vắng mặt, lúc đi vắng.","example":"His long absence from school worried his parents.","exampleTranslation":"Việc vắng mặt lâu ngày ở trường của anh ấy đã làm cha mẹ lo lắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"absent":{"definition":"Lơ đãng.","example":"An absent look crossed her face during class.","exampleTranslation":"Một vẻ mặt lơ đãng hiện lên trên khuôn mặt cô ấy trong giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"accomplish":{"definition":"Hoàn thành, làm xong, làm trọn.","example":"You can accomplish your goals with hard work.","exampleTranslation":"Bạn có thể hoàn thành mục tiêu của mình bằng sự chăm chỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"accomplishment":{"definition":"Sự thực hiện (mục đích... ).","example":"The accomplishment of the goal took many years.","exampleTranslation":"Việc hoàn thành mục tiêu đó đã mất nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"achievable":{"definition":"Có thể đạt được, có thể thực hiện được.","example":"Setting these goals is an achievable task for us.","exampleTranslation":"Việc đặt ra những mục tiêu này là một nhiệm vụ có thể thực hiện được đối với chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"achieve":{"definition":"Đạt được, giành được.","example":"We hope to achieve our goals by next year.","exampleTranslation":"Chúng tôi hy vọng sẽ đạt được mục tiêu của mình vào năm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"achievement":{"definition":"Thành tích, thành tựu.","example":"Winning the gold medal was a great achievement.","exampleTranslation":"Việc giành huy chương vàng là một thành tựu to lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"adept":{"definition":"Người giỏi, người tinh thông, người thông thạo, người lão luyện (nghề hay vấn đề gì).","example":"He is an adept in ancient philosophy studies.","exampleTranslation":"Anh ấy là một người tinh thông trong các nghiên cứu triết học cổ đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"admit":{"definition":"Chứa được, nhận được, có đủ chỗ cho.","example":"This large hall can admit over five hundred people.","exampleTranslation":"Đại sảnh rộng lớn này có thể chứa được hơn năm trăm người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"advice":{"definition":"Lời khuyên, lời chỉ bảo.","example":"She decided to act on my sincere advice.","exampleTranslation":"Cô ấy đã quyết định hành động theo lời khuyên chân thành của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"advise":{"definition":"Báo cho biết.","example":"Please advise me of any changes to the schedule.","exampleTranslation":"Vui lòng báo cho tôi biết về bất kỳ thay đổi nào đối với lịch trình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"adviser":{"definition":"Người khuyên bảo, người chỉ bảo, cố vấn.","example":"She works as a legal adviser for the firm.","exampleTranslation":"Cô ấy làm việc như một cố vấn pháp lý cho công ty.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"advisor":{"definition":"Người khuyên bảo, người chỉ bảo, cố vấn.","example":"My advisor helped me choose a course.","exampleTranslation":"Cố vấn của tôi đã giúp tôi chọn một khóa học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"aimed":{"definition":"Quá khứ và phân từ quá khứ của aim","example":"He aimed carefully and hit the target.","exampleTranslation":"Anh ấy đã nhắm mục tiêu cẩn thận và trúng đích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"aiming":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của aim.","example":"She is aiming for the top shelf.","exampleTranslation":"Cô ấy đang nhắm vào giá sách trên cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"aims":{"definition":"Động từ chia ở ngôi thứ ba số ít của aim","example":"The teacher aims to help every student.","exampleTranslation":"Người giáo viên nhắm đến việc giúp đỡ mọi học sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"algebra":{"definition":"(không đếm được, toán học) Đại số học.","example":"She is studying linear algebra in her college class.","exampleTranslation":"Cô ấy đang học đại số tuyến tính trong lớp đại học của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"arithmetic":{"definition":"Sách số học.","example":"I found an old arithmetic on the shelf.","exampleTranslation":"Tôi tìm thấy một cuốn sách số học cũ trên giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"assign":{"definition":"Người được quyền thừa hưởng (tài sản, quyền lợi).","example":"The house passed to the assign after the will.","exampleTranslation":"Ngôi nhà đã thuộc về người thừa hưởng sau khi có di chúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"assignment":{"definition":"Sự cho là, sự quy cho.","example":"The assignment of reason is a complex philosophical concept.","exampleTranslation":"Sự cho là lý do là một khái niệm triết học phức tạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"attainment":{"definition":"Sự đạt được.","example":"Her academic attainment is truly impressive to all her peers.","exampleTranslation":"Sự đạt được thành tích học tập của cô ấy thực sự gây ấn tượng với tất cả bạn bè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"attempt":{"definition":"Sự cố gắng, sự thử.","example":"She made an attempt at climbing the hill.","exampleTranslation":"Cô ấy đã thực hiện một sự cố gắng leo lên ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"attend":{"definition":"Chăm sóc, phục vụ, phục dịch.","example":"The nurse must attend a patient in room five.","exampleTranslation":"Y tá phải chăm sóc một bệnh nhân trong phòng số năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"attendance":{"definition":"Sự dự, sự có mặt.","example":"The teacher requested everyone's attendance for the trip.","exampleTranslation":"Người giáo viên yêu cầu sự có mặt của mọi người cho chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"attendant":{"definition":"Tham dự, có mặt.","example":"The flight attendant helped the passengers with their bags.","exampleTranslation":"Tiếp viên chuyến bay đã giúp hành khách với hành lý của họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"attention":{"definition":"Sự chăm sóc.","example":"The patient received great attention at the hospital.","exampleTranslation":"Bệnh nhân đã nhận được sự chăm sóc tuyệt vời tại bệnh viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"attentive":{"definition":"Ân cần, chu đáo.","example":"You must be attentive during the safety lecture.","exampleTranslation":"Bạn phải ân cần trong suốt buổi diễn thuyết về an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"basic":{"definition":"Cơ bản, cơ sở.","example":"We need to learn the basic rules first.","exampleTranslation":"Chúng ta cần học các quy tắc cơ bản trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"board":{"definition":"Bảng.","example":"Please write your name on the notice board.","exampleTranslation":"Vui lòng viết tên bạn lên bảng thông báo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"campus":{"definition":"Khu trường sở, khuôn viên trường.","example":"The new library stands at the center of campus.","exampleTranslation":"Thư viện mới nằm tại trung tâm khuôn viên trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"certificate":{"definition":"Giấy chứng nhận; bằng.","example":"She received her birth certificate yesterday morning.","exampleTranslation":"Cô ấy đã nhận được giấy chứng nhận khai sinh của mình vào sáng hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"certification":{"definition":"Sự cấp giấy chứng nhận.","example":"The school asked for certification.","exampleTranslation":"Nhà trường đã yêu cầu cấp giấy chứng nhận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"certify":{"definition":"Chứng nhận là mắc bệnh tinh thần.","example":"The doctor did not certify him as mentally ill.","exampleTranslation":"Bác sĩ đã không chứng nhận anh ấy mắc bệnh tinh thần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"chair":{"definition":"Chức giáo sư đại học.","example":"She holds the chair in the history department.","exampleTranslation":"Cô ấy nắm giữ chức giáo sư trong khoa lịch sử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"chapter":{"definition":"Chương (sách).","example":"This chapter explains the main idea.","exampleTranslation":"Chương này giải thích ý tưởng chính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"classmate":{"definition":"Bạn cùng lớp.","example":"My classmate helped me study for the test.","exampleTranslation":"Bạn cùng lớp đã giúp tôi ôn thi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"college":{"definition":"Trường đại học, trường cao đẳng.","example":"She wants to attend a community college nearby.","exampleTranslation":"Cô ấy muốn theo học một trường cao đẳng cộng đồng gần đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"comprehension":{"definition":"Sự hiểu, sự lĩnh hội, sự nhận thức.","example":"This complex math problem is beyond my comprehension.","exampleTranslation":"Bài toán phức tạp này vượt quá sự hiểu biết của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"comprehensive":{"definition":"Có đầy đủ thông tin một cách toàn diện.","example":"Please provide a comprehensive list of all items.","exampleTranslation":"Vui lòng cung cấp một danh sách toàn diện tất cả các mục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"constructive":{"definition":"Có tính cách xây dựng.","example":"Please provide some constructive criticism on my new project.","exampleTranslation":"Vui lòng đưa ra một số phê bình có tính xây dựng cho dự án mới của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"courseware":{"definition":"Chương trình dạy học [máy điện toán].","example":"The courseware helped students study at home.","exampleTranslation":"Chương trình dạy học đã giúp học sinh học tập tại nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"cram":{"definition":"Đám đông chật ních.","example":"The train was a cram at rush hour.","exampleTranslation":"Chuyến tàu là một đám đông chật ních vào giờ cao điểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"developmental":{"definition":"Phát triển, nảy nở.","example":"Early childhood is a critical developmental stage for kids.","exampleTranslation":"Thời thơ ấu sớm là một giai đoạn phát triển quan trọng đối với trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"disciple":{"definition":"Môn đồ, môn đệ, học trò.","example":"The disciple listened closely to every lesson.","exampleTranslation":"Người môn đồ lắng nghe chăm chú từng bài học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"discipline":{"definition":"Kỷ luật.","example":"The soldiers lived under strict discipline every day.","exampleTranslation":"Những người lính sống dưới kỷ luật nghiêm ngặt mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"educate":{"definition":"Giáo dục, cho ăn học.","example":"Parents must educate children with patience.","exampleTranslation":"Cha mẹ phải giáo dục con cái bằng sự kiên nhẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"encourage":{"definition":"Làm can đảm, làm mạnh dạn.","example":"Teachers should encourage quiet students.","exampleTranslation":"Giáo viên nên khuyến khích những học sinh trầm tính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"encyclopedia":{"definition":"Bộ sách bách khoa.","example":"He borrowed an encyclopedia from the library.","exampleTranslation":"Anh ấy mượn một bộ sách bách khoa từ thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"enrolment":{"definition":"Sự tuyển (quân... ).","example":"Enrolment begins next week at the school.","exampleTranslation":"Sự tuyển quân bắt đầu vào tuần tới tại trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"essay":{"definition":"Sự làm thử; sự làm cố gắng.","example":"This essay will test your writing skill.","exampleTranslation":"Sự làm thử này sẽ kiểm tra kỹ năng viết của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"examination":{"definition":"Sự thi cử; kỳ thi.","example":"She went to the school for a medical examination.","exampleTranslation":"Cô ấy đã đến trường để tham gia một kỳ thi y tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"examine":{"definition":"Khám xét, xem xét, thẩm tra, khảo sát, nghiên cứu.","example":"The nurse will examine the wound closely.","exampleTranslation":"Y tá sẽ xem xét vết thương thật kỹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"examiner":{"definition":"Examinant.","example":"The examiner asked difficult questions about grammar.","exampleTranslation":"Người khảo sát đã hỏi những câu hỏi khó về ngữ pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"excel":{"definition":"Hơn, trội hơn (người khác về mặt nào... ).","example":"She can excel others in courage.","exampleTranslation":"Cô ấy có thể trội hơn người khác về lòng dũng cảm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"excellence":{"definition":"Sự trội hơn, sự xuất sắc, sự ưu tú; tính ưu tú.","example":"The team won praise for its excellence.","exampleTranslation":"Nhóm đã giành được sự khen ngợi vì sự xuất sắc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"expel":{"definition":"Trục xuất, đuổi, làm bật ra, tống ra.","example":"The school will expel anyone who cheats.","exampleTranslation":"Nhà trường sẽ trục xuất bất cứ ai gian lận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"facilitate":{"definition":"Làm cho dễ dàng; làm cho thuận tiện.","example":"Good tools facilitate learning for beginners.","exampleTranslation":"Các công cụ tốt làm cho dễ dàng việc học cho người mới bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"faculty":{"definition":"Tính năng, khả năng; (từ Mỹ, nghĩa Mỹ) khả năng quản trị.","example":"She has a natural faculty for learning languages.","exampleTranslation":"Cô ấy có một khả năng tự nhiên cho việc học ngoại ngữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"familiarization":{"definition":"Sự phổ biến (một vấn đề).","example":"The guide began familiarization with the controls.","exampleTranslation":"Hướng dẫn viên bắt đầu sự phổ biến với các nút điều khiển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"grade":{"definition":"Điểm, điểm số (của học sinh).","example":"Did you get a good grade on the test?","exampleTranslation":"Bạn có đạt điểm số tốt trong bài kiểm tra không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"graduate":{"definition":"Cô đặc dần (bằng cách cho bay hơi).","example":"They graduate the syrup by heating it slowly.","exampleTranslation":"Họ cô đặc dần xi-rô bằng cách đun nóng từ từ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"guidance":{"definition":"Sự chỉ đạo, sự hướng dẫn; sự dìu dắt.","example":"Her guidance helped me choose well.","exampleTranslation":"Sự chỉ đạo của cô ấy đã giúp tôi lựa chọn đúng đắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"headmaster":{"definition":"Ông hiệu trưởng.","example":"The headmaster greeted the new students kindly.","exampleTranslation":"Ông hiệu trưởng đã chào đón những học sinh mới một cách tử tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"ignorance":{"definition":"vô minh","example":"Ignorance is often the root cause of many problems.","exampleTranslation":"Sự vô minh thường là nguyên nhân gốc rễ của nhiều vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"ignorant":{"definition":"Ngu dốt, dốt nát.","example":"It was ignorant to speak without checking facts.","exampleTranslation":"Thật là dốt nát khi nói mà không kiểm tra sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"impart":{"definition":"Truyền đạt, kể cho hay, phổ biến.","example":"Please impart your wisdom to the younger generation.","exampleTranslation":"Xin hãy truyền đạt sự khôn ngoan của bạn cho thế hệ trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"inattention":{"definition":"Inattentiveness.","example":"His inattention caused the missed detail.","exampleTranslation":"Sự thiếu chú ý của anh ấy đã gây ra việc bỏ lỡ chi tiết đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"instill":{"definition":"Truyền đạt (ý nghĩ, tình cảm... ) cho, làm cho thấm nhuần dần.","example":"Teachers try to instill confidence in their young students.","exampleTranslation":"Giáo viên cố gắng truyền đạt sự tự tin cho các học sinh trẻ của họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"institute":{"definition":"Tiến hành.","example":"The company decided to institute a lawsuit today.","exampleTranslation":"Công ty đã quyết định tiến hành một vụ kiện hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"institution":{"definition":"Sự mở (một cuộc điều tra).","example":"The institution of the survey took several days.","exampleTranslation":"Sự mở cuộc khảo sát đã mất vài ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"instruct":{"definition":"Chỉ dẫn, chỉ thị cho.","example":"Please instruct me on the next step.","exampleTranslation":"Xin hãy chỉ dẫn cho tôi về bước tiếp theo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"instruction":{"definition":"Sự dạy.","example":"The teacher gave clear instruction.","exampleTranslation":"Giáo viên đã đưa ra sự dạy rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"instructional":{"definition":"Kiến thức truyền cho; có tính chất tin tức cung cấp cho, có tính chất là tài liệu cung cấp cho.","example":"The note was instructional and easy to follow.","exampleTranslation":"Ghi chú đó có tính chất truyền thông tin và dễ làm theo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"instructive":{"definition":"Để dạy, để làm bài học.","example":"The teacher gave an instructive example.","exampleTranslation":"Giáo viên đã đưa ra một ví dụ để dạy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"instructor":{"definition":"Người dạy, thầy giáo.","example":"Our instructor explained the lesson slowly.","exampleTranslation":"Người dạy của chúng tôi đã giải thích bài học một cách chậm rãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"intellectual":{"definition":"Có trí thức, hiểu biết rộng; tài trí.","example":"She is an intellectual student with wide interests.","exampleTranslation":"Cô ấy là một học sinh có trí thức với nhiều sở thích rộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"intensive":{"definition":"Tập trung sâu.","example":"The students took part in an intensive training course.","exampleTranslation":"Các học sinh đã tham gia một khóa đào tạo tập trung sâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"junior":{"definition":"Trẻ tuổi hơn; em, con (ghi sau tên họ người).","example":"John Brown Junior started his first job last year.","exampleTranslation":"John Brown Junior đã bắt đầu công việc đầu tiên của mình năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"lecture":{"definition":"Lời la mắng, lời quở trách.","example":"My father gave me a long lecture about safety.","exampleTranslation":"Cha tôi đã cho tôi một lời la mắng dài về sự an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"lesson":{"definition":"Lời quở trách; sự trừng phạt, sự cảnh cáo.","example":"The teacher will read him a stern lesson.","exampleTranslation":"Giáo viên sẽ đọc cho anh ấy một lời quở trách nghiêm khắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"librarian":{"definition":"Thủ thư.","example":"The librarian found my lost book quickly.","exampleTranslation":"Thủ thư đã tìm thấy cuốn sách bị mất của tôi một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"library":{"definition":"Thư viện, phòng đọc sách.","example":"I need to return these books to the library.","exampleTranslation":"Tôi cần trả những cuốn sách này về thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"literate":{"definition":"Có học; hay chữ.","example":"She is literate and enjoys reading difficult books.","exampleTranslation":"Cô ấy là người có học và thích đọc những cuốn sách khó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"master":{"definition":"Chủ, chủ nhân.","example":"Who is the master of this large house?","exampleTranslation":"Ai là chủ nhân của ngôi lâu đài lớn này?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"mastery":{"definition":"Ưu thế, thế hơn, thế thắng lợi.","example":"She worked hard to gain mastery of the language.","exampleTranslation":"Cô ấy đã làm việc chăm chỉ để đạt được ưu thế của ngôn ngữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"memorization":{"definition":"Cách viết khác : memorisation.","example":"Memorization helped her learn the short poem.","exampleTranslation":"Sự ghi nhớ đã giúp cô ấy học bài thơ ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"mentor":{"definition":"Người thầy thông thái, người cố vấn dày kinh nghiệm.","example":"Her mentor gave calm advice before the exam.","exampleTranslation":"Người thầy thông thái của cô ấy đã đưa ra lời khuyên bình tĩnh trước kỳ thi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"module":{"definition":"Đơn vị đo.","example":"Each module fits into the larger system.","exampleTranslation":"Mỗi mô-đun phù hợp với hệ thống lớn hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"novice":{"definition":"Người tập việc; người mới học, người chưa có kinh nghiệm.","example":"A novice often needs clear and patient guidance.","exampleTranslation":"Người mới học thường cần sự hướng dẫn rõ ràng và kiên nhẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"numeracy":{"definition":"Sự giỏi toán.","example":"Good numeracy helps in daily shopping.","exampleTranslation":"Sự giỏi toán giúp ích trong việc mua sắm hàng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"nursery":{"definition":"Nhà trẻ.","example":"Our son goes to nursery three mornings a week.","exampleTranslation":"Con trai chúng tôi đến nhà trẻ ba buổi sáng một tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"orientation":{"definition":"Sự định hướng.","example":"New students need orientation on the first day.","exampleTranslation":"Học sinh mới cần sự định hướng vào ngày đầu tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"pass":{"definition":"Trải qua.","example":"They had to pass through many hardships during winter.","exampleTranslation":"Họ đã phải trải qua nhiều gian khổ trong suốt mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"playground":{"definition":"Sân chơi, sân thể thao (trường học).","example":"Children played on the playground after school.","exampleTranslation":"Lũ trẻ chơi trên sân chơi sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"practical":{"definition":"Thực hành (đối với lý thuyết).","example":"You need practical agriculture skills to run this farm.","exampleTranslation":"Bạn cần các kỹ năng nông nghiệp thực hành để điều hành trang trại này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"primary":{"definition":"Gốc, nguyên, căn bản.","example":"What is the primary meaning of this word?","exampleTranslation":"Ý nghĩa chính của từ này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"principal":{"definition":"Chính, chủ yếu.","example":"The principal of the school gave a long speech.","exampleTranslation":"Hiệu trưởng nhà trường đã có một bài phát biểu dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"principally":{"definition":"Chính, chủ yếu; phần lớn.","example":"They worked principally all day.","exampleTranslation":"Họ làm việc chủ yếu cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"education"},"professor":{"definition":"Giáo sư (đại học).","example":"The professor gave a very long lecture.","exampleTranslation":"Giáo sư đã có một bài giảng rất dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"proficient":{"definition":"Tài giỏi, giỏi giang, thành thạo.","example":"She is proficient in three different languages.","exampleTranslation":"Cô ấy thông thạo ba ngôn ngữ khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"programme":{"definition":"Chương trình (công tác, biểu diễn văn nghệ... ).","example":"They discussed the programme today.","exampleTranslation":"Họ đã thảo luận về chương trình ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"promise":{"definition":"Triển vọng, hứa hẹn.","example":"The young man is a person of promise.","exampleTranslation":"Chàng thanh niên trẻ là một người có triển vọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"pupil":{"definition":"Con ngươi, đồng tử (của mắt).","example":"The doctor checked the pupil with a light.","exampleTranslation":"Bác sĩ đã kiểm tra đồng tử của cậu bé bằng một chiếc đèn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"reader":{"definition":"Người đọc bản thảo (ở nhà xuất bản) ((cũng) publisher's reader).","example":"The publisher's reader liked the first chapter.","exampleTranslation":"Người đọc bản thảo","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"recite":{"definition":"Kể lại, thuật lại, kể lể.","example":"The student will recite her poem in class.","exampleTranslation":"Học sinh sẽ đọc thuộc lòng bài thơ của cô ấy trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education"},"refresher":{"definition":"Tiền trả thêm (cho luật sư khi vụ kiện kéo dài).","example":"The client paid a refresher for the long case.","exampleTranslation":"Khách hàng đã trả một khoản phí bồi dưỡng cho vụ kiện kéo dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"secondary":{"definition":"Thứ hai, thứ nhì, thứ, phụ, không quan trọng.","example":"This is just a secondary matter for our team.","exampleTranslation":"Đây chỉ là một vấn đề thứ yếu đối với nhóm chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"seminar":{"definition":"Xêmina, hội nghị chuyên đề.","example":"Our seminar starts at nine.","exampleTranslation":"Hội nghị chuyên đề của chúng tôi bắt đầu lúc chín giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"session":{"definition":"Một khoảng thời gian dành cho công việc nào đó.","example":"A session helped the team.","exampleTranslation":"Một khoảng thời gian dành cho công việc đã giúp ích cho cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"specialise":{"definition":"Thay đổi; hạn chế (ý kiến... ).","example":"We must specialise the plan for this case.","exampleTranslation":"Chúng ta phải thay đổi kế hoạch cho trường hợp này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education","spellingNote":"Alternate spelling: specialize."},"specialist":{"definition":"Chuyên gia, chuyên viên, nhà chuyên khoa.","example":"The eye specialist examined my vision today.","exampleTranslation":"Chuyên gia về mắt đã kiểm tra thị lực của tôi hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"specialization":{"definition":"Sự chuyên môn hoá, sự chuyên khoa.","example":"Specialization helps workers learn one skill well.","exampleTranslation":"Sự chuyên môn hoá giúp công nhân học tốt một kỹ năng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"specialize":{"definition":"Chuyên môn hoá về, trở thành chuyên về (một việc gì).","example":"She wants to specialize in international law soon.","exampleTranslation":"Cô ấy muốn trở thành chuyên về luật quốc tế sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"education","spellingNote":"British spelling: specialise."},"subject":{"definition":"Chủ đề; vấn đề.","example":"What is your favorite subject for the debate?","exampleTranslation":"Chủ đề yêu thích của bạn cho cuộc tranh luận là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"syllabus":{"definition":"Đề cương bài giảng; đề cương khoá học.","example":"Please read the syllabus before class.","exampleTranslation":"Vui lòng đọc đề cương bài giảng trước khi vào lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"talent":{"definition":"Talăng (đơn vị trọng lượng; tiền tệ cổ Hy Lạp).","example":"A talent was a heavy unit long ago.","exampleTranslation":"Một talăng là một đơn vị trọng lượng nặng ngày xưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"thesis":{"definition":"Luận văn, luận án.","example":"She worked hard to uphold her thesis.","exampleTranslation":"Cô ấy đã làm việc chăm chỉ để ủng hộ luận văn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"undergraduate":{"definition":"Sinh viên đại học chưa tốt nghiệp.","example":"The undergraduate studied late every night.","exampleTranslation":"Sinh viên đại học chưa tốt nghiệp đã học muộn mỗi đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"education"},"uneducated":{"definition":"Không được giáo dục.","example":"The uneducated boy learned quickly at school.","exampleTranslation":"Cậu bé không được giáo dục đã học hỏi nhanh chóng ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"unprepared":{"definition":"Không sẵn sàng, không chuẩn bị trước.","example":"He gave an unprepared speech at the meeting.","exampleTranslation":"Anh ấy đã có một bài phát biểu không sẵn sàng tại cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"biodiversity":{"definition":"Đa dạng sinh học; sự phong phú về các loài sinh vật.","example":"The biodiversity of tropical rain forests is high.","exampleTranslation":"Rừng mưa nhiệt đới có mức độ đa dạng sinh học cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"environment"},"emissions":{"definition":"Khí thải hoặc lượng chất thải được thải ra môi trường.","example":"Strict limits on vehicle emissions can improve urban air quality.","exampleTranslation":"Giới hạn nghiêm ngặt khí thải xe cộ có thể cải thiện chất lượng không khí đô thị.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"noun","posGroup":"noun","family":"environment"},"conservation":{"definition":"Sự bảo tồn hoặc gìn giữ tài nguyên và thiên nhiên.","example":"We must focus on the conservation of water.","exampleTranslation":"Chúng ta cần chú trọng việc bảo tồn nguồn nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"sustainable":{"definition":"Bền vững; có thể duy trì lâu dài mà không gây cạn kiệt.","example":"This plan is sustainable for a long time.","exampleTranslation":"Kế hoạch này có thể được duy trì lâu dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"habitat":{"definition":"Môi trường sống tự nhiên của một loài động vật hoặc thực vật.","example":"This lake is the bird's habitat.","exampleTranslation":"Hồ này là môi trường sống của loài chim đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"climate change":{"definition":"Sự thay đổi lâu dài của nhiệt độ và các kiểu thời tiết trên Trái Đất.","example":"Climate change is increasing the frequency of heat waves.","exampleTranslation":"Biến đổi khí hậu đang làm các đợt nắng nóng xảy ra thường xuyên hơn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"environment"},"carbon footprint":{"definition":"Tổng lượng khí nhà kính phát sinh trực tiếp và gián tiếp từ một cá nhân, hoạt động hoặc sản phẩm.","example":"Public transport can reduce a city's carbon footprint.","exampleTranslation":"Giao thông công cộng có thể làm giảm dấu chân carbon của một thành phố.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"environment"},"environment":{"definition":"Môi trường, hoàn cảnh, những vật xung quanh.","example":"A quiet environment helps me study.","exampleTranslation":"Một môi trường yên tĩnh giúp tôi học tập tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"environmental":{"definition":"Thuộc về môi trường.","example":"The report covers environmental problems.","exampleTranslation":"Báo cáo bao gồm các vấn đề về môi trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"pollutant":{"definition":"Chất gây ô nhiễm (do xe cộ, động cơ thải ra).","example":"Smoke from cars can release a pollutant.","exampleTranslation":"Khói từ xe cộ có thể giải phóng chất gây ô nhiễm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"pollut"},"polluted":{"definition":"Bị ô nhiễm; chứa chất gây ô nhiễm hoặc bị làm bẩn.","example":"Polluted rivers can threaten wildlife and the health of nearby communities.","exampleTranslation":"Những con sông bị ô nhiễm có thể đe dọa động vật hoang dã và sức khỏe của các cộng đồng lân cận.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"pollut"},"polluter":{"definition":"Nguồn (quốc gia) gây ô nhiễm.","example":"One polluter can harm the whole river.","exampleTranslation":"Một tác nhân gây ô nhiễm có thể gây hại cho cả con sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"pollut"},"polluting":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của pollute.","example":"Factories are polluting the river again.","exampleTranslation":"Các nhà máy đang làm ô nhiễm con sông trở lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"pollut"},"pollution":{"definition":"Sự làm ô uế, sự ô nhiễm, sự làm mất thiêng liêng.","example":"Air pollution is a serious global problem.","exampleTranslation":"Ô nhiễm không khí là một vấn đề toàn cầu nghiêm trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"pollut"},"ecologic":{"definition":"Sinh thái học.","example":"The ecologic balance in the pond is fragile.","exampleTranslation":"Sự cân bằng sinh thái trong ao rất mong manh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"ecolog"},"ecological":{"definition":"Sinh thái học.","example":"Ecological systems are important for the environment.","exampleTranslation":"Các hệ thống sinh thái rất quan trọng đối với môi trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"ecolog"},"ecologist":{"definition":"Nhà sinh thái học.","example":"The ecologist warned about damage to rivers.","exampleTranslation":"Nhà sinh thái học đã cảnh báo về những thiệt hại đối với các con sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ecolog"},"ecology":{"definition":"Sinh thái học.","example":"Ecology teaches how plants and animals connect.","exampleTranslation":"Sinh thái học dạy về cách thực vật và động vật kết nối với nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ecolog"},"climatic":{"definition":"Khí hậu, (thuộc) thời tiết.","example":"Farmers must adapt to changing climatic conditions.","exampleTranslation":"Người nông dân phải thích nghi với các điều kiện khí hậu đang thay đổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"climat"},"conservative":{"definition":"Thận trọng, có xu hướng giữ nguyên hiện trạng hoặc truyền thống.","example":"The museum used conservative methods to save paper.","exampleTranslation":"Bảo tàng đã sử dụng các phương pháp bảo tồn để tiết kiệm giấy.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"conserv"},"conserving":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của conserve.","example":"We are conserving water during the dry season.","exampleTranslation":"Chúng ta đang tiết kiệm nước trong mùa khô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"conserv"},"sustain":{"definition":"Giữ vững được.","example":"Is there enough food to sustain life here?","exampleTranslation":"Liệu có đủ thực phẩm để duy trì sự sống ở đây không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sustain"},"sustained":{"definition":"Quá khứ và phân từ quá khứ của sustain","example":"They sustained their focus through the long meeting.","exampleTranslation":"Họ đã duy trì sự tập trung trong suốt buổi họp dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sustain"},"sustaining":{"definition":"Sự chống đỡ.","example":"Her sustaining helped the team finish the project.","exampleTranslation":"Sự tiếp sức của cô ấy đã giúp nhóm hoàn thành dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sustain"},"renew":{"definition":"Thay mới, đổi mới.","example":"They decided to renew their membership for another year.","exampleTranslation":"Họ quyết định gia hạn tư cách thành viên thêm một năm nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"renew"},"renewable":{"definition":"Có thể hồi phục lại.","example":"Solar power is a renewable resource.","exampleTranslation":"Năng lượng mặt trời là một nguồn tài nguyên tái tạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"renew"},"renewal":{"definition":"Sự làm lại, sự nối lại, sự nhắc lại, sự tiếp tục lại.","example":"We saw a renewal of the old bond.","exampleTranslation":"Chúng tôi chứng kiến mối gắn kết cũ được khôi phục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"renew"},"renewed":{"definition":"Quá khứ và phân từ quá khứ của renew","example":"He renewed his order for another month.","exampleTranslation":"Anh ấy đã gia hạn đơn đặt hàng thêm một tháng nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"renew"},"deforest":{"definition":"Phá rừng; phát quang.","example":"They deforest hills for farmland too quickly.","exampleTranslation":"Họ phá rừng trên đồi để làm đất nông nghiệp quá nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"deforest"},"deforestation":{"definition":"Sự phá rừng; sự phát quang.","example":"Deforestation has hurt many forest animals.","exampleTranslation":"Nạn phá rừng đã làm tổn thương nhiều loài động vật rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"deforest"},"deforested":{"definition":"Quá khứ và phân từ quá khứ của deforest","example":"The company deforested a large area.","exampleTranslation":"Công ty đã phá rừng một khu vực rộng lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"deforest"},"habitation":{"definition":"Sự ở, sự cư trú.","example":"The cave is not suitable for human habitation.","exampleTranslation":"Hang động này không phù hợp cho con người cư trú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"habitat"},"emission":{"definition":"Lượng chất hoặc khí được thải ra, thường là chất gây ô nhiễm.","example":"The factory reduced its carbon emission by switching to renewable energy.","exampleTranslation":"Nhà máy đã giảm lượng khí thải carbon bằng cách chuyển sang năng lượng tái tạo.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"emission"},"carbon":{"definition":"Cacbon; nguyên tố hóa học có trong than đá và khí thải carbon.","example":"Reducing carbon emissions is essential to limit climate change.","exampleTranslation":"Giảm lượng khí thải carbon là điều cần thiết để hạn chế biến đổi khí hậu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"carbon"},"carbonate":{"definition":"Cacbonat.","example":"The test found carbonate in the water.","exampleTranslation":"Cuộc kiểm tra đã tìm thấy muối carbonate trong nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"carbon"},"carbonization":{"definition":"Sự đốt thành than.","example":"Carbonization turns wood into charcoal.","exampleTranslation":"Quá trình cacbon hóa biến gỗ thành than.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"carbon"},"carbonized":{"definition":"Quá khứ và phân từ quá khứ của carbonize","example":"The heat carbonized the scraps in minutes.","exampleTranslation":"Nhiệt độ đã làm các mảnh vụn bị cacbon hóa trong vài phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"carbon"},"recycling":{"definition":"tái chế","example":"Recycling helps reduce waste in our town.","exampleTranslation":"Tái chế giúp giảm thiểu rác thải trong thị trấn của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"recycl"},"waste":{"definition":"Bỏ hoang, hoang vu (đất).","example":"The council converted the waste land into a public park.","exampleTranslation":"Hội đồng đã chuyển vùng đất hoang thành công viên công cộng.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"waste"},"wasteful":{"definition":"Lãng phí, hoang phí, tốn phí.","example":"Wasteful expenditure can hurt our small budget.","exampleTranslation":"Việc chi tiêu lãng phí có thể gây ảnh hưởng đến ngân sách nhỏ của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"waste"},"drought":{"definition":"Đợt hạn hán kéo dài do thiếu mưa.","example":"The region suffered a severe drought after months without rain.","exampleTranslation":"Khu vực này đã trải qua một đợt hạn hán nghiêm trọng sau nhiều tháng không có mưa.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"drought"},"flood":{"definition":"Lũ, lụt, nạn lụt.","example":"The heavy rain caused a sudden flood last night.","exampleTranslation":"Cơn mưa lớn đã gây ra một trận lụt bất ngờ đêm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"flood"},"flooded":{"definition":"Quá khứ và phân từ quá khứ của flood","example":"Heavy rain flooded the street last night.","exampleTranslation":"Mưa lớn đã làm ngập con phố vào đêm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"flood"},"flooding":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của flood.","example":"Flooding washed mud across the road.","exampleTranslation":"Lũ lụt đã cuốn trôi bùn đất khắp con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"flood"},"species":{"definition":"Loài.","example":"Scientists are studying every species in the forest.","exampleTranslation":"Các nhà khoa học đang nghiên cứu mọi loài trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"species"},"extinct":{"definition":"Tuyệt giống, tuyệt chủng.","example":"That bird is now extinct in this area.","exampleTranslation":"Loài chim đó hiện đã tuyệt chủng ở khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"extinct"},"extinction":{"definition":"Sự dập tắt; sự làm tan vỡ; sự làm mất đi.","example":"Fire suppression caused the extinction of the flame.","exampleTranslation":"Việc ngăn chặn hỏa hoạn đã dẫn đến sự tắt ngấm của ngọn lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"extinct"},"ecosystem":{"definition":"Hệ sinh thái.","example":"A healthy ecosystem needs plants, animals, and water.","exampleTranslation":"Một hệ sinh thái khỏe mạnh cần có thực vật, động vật và nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ecosystem"},"forest":{"definition":"Rừng.","example":"We walked deep into the forest.","exampleTranslation":"Chúng tôi đã đi sâu vào trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"forest"},"forestation":{"definition":"Sự trồng cây gây rừng.","example":"Forestation brought birds back to the area.","exampleTranslation":"Việc trồng rừng đã thu hút các loài chim quay trở lại khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"forest"},"forested":{"definition":"Quá khứ và phân từ quá khứ của forest","example":"The group forested the dry land.","exampleTranslation":"Nhóm đã phủ xanh vùng đất khô cằn bằng cách trồng rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"forest"},"forester":{"definition":"Cán bộ lâm nghiệp; nhân viên quản lý rừng.","example":"The forester checked the young trees.","exampleTranslation":"Người kiểm lâm đã kiểm tra những cái cây non.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"forest"},"forests":{"definition":"Trồng cây gây rừng trên một khu vực đất.","example":"The city forests its hillsides to reduce soil erosion.","exampleTranslation":"Thành phố trồng rừng trên các sườn đồi để giảm xói mòn đất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"forest"},"wildlife":{"definition":"Sự bảo tồn những loài thú, chim rừng.","example":"We saw many types of wildlife in the park.","exampleTranslation":"Chúng tôi đã thấy nhiều loại động vật hoang dã trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wildlife"},"greenhouse":{"definition":"Nhà kính (trồng rau, hoa).","example":"Tomatoes grew well in the greenhouse.","exampleTranslation":"Cà chua phát triển tốt trong nhà kính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"greenhouse"},"contaminate":{"definition":"Làm bẩn, làm ô uế.","example":"Dirty water can contaminate the well.","exampleTranslation":"Nước bẩn có thể làm ô nhiễm giếng nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"contamin"},"contamination":{"definition":"Sự nhiễm (bệnh).","example":"Doctors worried about contamination after the wound opened.","exampleTranslation":"Các bác sĩ lo ngại về sự nhiễm khuẩn sau khi vết thương bị hở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"contamin"},"resource":{"definition":"Phương sách, phương kế, thủ đoạn, cách xoay xở; chỗ trông mong vào (khi gặp thế bí).","example":"We found a good resource in the guidebook.","exampleTranslation":"Chúng tôi đã tìm thấy một nguồn tài nguyên hữu ích trong cuốn sách hướng dẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"resource"},"resourceful":{"definition":"Có tài xoay xở, tháo vát, nhiều thủ đoạn, nhiều tài vặt.","example":"She is resourceful and fixes problems fast.","exampleTranslation":"Cô ấy là người tháo vát và giải quyết vấn đề rất nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"resource"},"desert":{"definition":"Sa mạc; vùng đất khô cằn có rất ít mưa.","example":"Farmers in the region must adapt to the harsh desert climate.","exampleTranslation":"Nông dân trong khu vực phải thích nghi với khí hậu sa mạc khắc nghiệt.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"desert"},"deserted":{"definition":"Quá khứ và phân từ quá khứ của desert","example":"She deserted the shop and walked home.","exampleTranslation":"Cô ấy rời bỏ cửa hàng và đi bộ về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"desert"},"deserter":{"definition":"Người bỏ ra đi, kẻ bỏ trốn; kẻ đào ngũ.","example":"The deserter left the group during the storm.","exampleTranslation":"Kẻ đào ngũ đã rời khỏi nhóm trong cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"desert"},"desertion":{"definition":"Sự ruồng bỏ, sự bỏ rơi, sự không nhìn nhận đến.","example":"His desertion from the army caused many problems.","exampleTranslation":"Việc anh ấy đào ngũ khỏi quân đội đã gây ra nhiều vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"desert"},"deserts":{"definition":"Động từ chia ở ngôi thứ ba số ít của desert","example":"She deserts her team whenever work gets hard.","exampleTranslation":"Cô ấy bỏ rơi đội của mình bất cứ khi nào công việc trở nên khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"desert"},"marine":{"definition":"Biển.","example":"We saw many types of marine plant today.","exampleTranslation":"Chúng tôi đã nhìn thấy nhiều loại thực vật biển ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"marine"},"ocean":{"definition":"Đại dương, biển.","example":"The blue ocean looks beautiful from the shore.","exampleTranslation":"Đại dương xanh trông thật đẹp từ bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ocean"},"oceanic":{"definition":"Đại dương, (thuộc) biển; như đại dương; như biển.","example":"They sailed across the oceanic wind.","exampleTranslation":"Họ đã đi thuyền xuyên qua luồng gió đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"ocean"},"abundance":{"definition":"Sự dạt dào (tình cảm, cảm xúc).","example":"She showed an abundance of love for her children.","exampleTranslation":"Cô ấy thể hiện một tình yêu dạt dào dành cho những đứa con của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"abundant":{"definition":"Phong phú, nhiều, chan chứa; thừa thãi, dư dật.","example":"The garden is abundant in beautiful red roses.","exampleTranslation":"Khu vườn phong phú với những đóa hồng đỏ xinh đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"aerosol":{"definition":"Bình phun (nước hoa, thuốc trừ sâu).","example":"She shook the aerosol before spraying it.","exampleTranslation":"Cô ấy đã lắc bình phun trước khi xịt nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"arid":{"definition":"Khô cằn (đất).","example":"The arid field needed water after the heat.","exampleTranslation":"Cánh đồng khô cằn cần nước sau sức nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"barren":{"definition":"Không đem lại kết quả.","example":"Their barren efforts yielded no results this year.","exampleTranslation":"Những nỗ lực không đem lại kết quả của họ trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"bogs":{"definition":"Động từ chia ở ngôi thứ ba số ít của bog","example":"The path bogs down after heavy rain.","exampleTranslation":"Con đường bị lầy lội sau trận mưa lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"cascade":{"definition":"Thác nước.","example":"Water fell over the rocks in a cascade.","exampleTranslation":"Nước đổ qua những hòn đá thành một thác nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"compost":{"definition":"Phân trộn, phân compôt.","example":"Farmers use organic waste to make healthy compost.","exampleTranslation":"Nông dân sử dụng chất thải hữu cơ để làm phân trộn khỏe mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"conserve":{"definition":"Giữ gìn, duy trì, bảo tồn, bảo toàn.","example":"We must conserve water during this long dry summer.","exampleTranslation":"Chúng ta phải duy trì nước trong mùa hè khô hạn kéo dài này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"cool":{"definition":"Mát mẻ, mát; hơi lạnh, nguội.","example":"It is getting cool outside during the autumn evening.","exampleTranslation":"Thời tiết bên ngoài đang trở nên mát mẻ vào buổi tối mùa thu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"debris":{"definition":"Mảnh vỡ, mảnh vụn.","example":"Broken glass lay among the debris.","exampleTranslation":"Thủy tinh vỡ nằm giữa các mảnh vụn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"depletion":{"definition":"Sự tản máu; sự tiêu dịch.","example":"The doctor noted a depletion of body fluid.","exampleTranslation":"Bác sĩ lưu ý sự tiêu dịch của dịch cơ thể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"destroy":{"definition":"Phá, phá hoại, phá huỷ, tàn phá, tiêu diệt.","example":"Strong wind can destroy a weak roof.","exampleTranslation":"Gió mạnh có thể phá hủy một mái nhà yếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"destruction":{"definition":"Sự phá hoại, sự phá huỷ, sự tiêu diệt, sự diệt tận; tình trạng bị tàn phá, tình trạng bị tiêu diệt.","example":"The destruction of the old bridge took weeks.","exampleTranslation":"Sự phá hủy cây cầu cũ mất vài tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"destructive":{"definition":"Phá hoại, phá huỷ, tàn phá, huỷ diệt.","example":"A destructive war can ruin an entire nation.","exampleTranslation":"Một cuộc chiến tranh phá hoại có thể làm tàn phá toàn bộ quốc gia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"devastate":{"definition":"Tàn phá, phá hủy, phá phách.","example":"The storm can devastate small farms.","exampleTranslation":"Cơn bão có thể tàn phá các trang trại nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"devastation":{"definition":"Sự để uổng các động sản của người đã chết (người thi hành di chúc).","example":"The lawyer noted the devastation of the estate.","exampleTranslation":"Luật sư đã lưu ý sự tàn phá của tài sản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"dirt":{"definition":"Đồ bẩn thỉu, đồ dơ bẩn, đồ dơ dáy.","example":"Mud and dirt covered his shoes.","exampleTranslation":"Bùn và đồ bẩn bám đầy trên giày của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"disaster":{"definition":"Tai hoạ, thảm hoạ, tai ách.","example":"The heavy rain caused a terrible disaster.","exampleTranslation":"Cơn mưa lớn đã gây ra một thảm họa khủng khiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"disastrous":{"definition":"Tai hại, thảm khốc.","example":"The storm had disastrous effects on the village.","exampleTranslation":"Cơn bão đã có những ảnh hưởng thảm khốc lên ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"disturbance":{"definition":"Sự làm nhiễu loạn; sự nhiễu loạn.","example":"The storm caused a magnetic disturbance in the area.","exampleTranslation":"Cơn bão đã gây ra sự nhiễu loạn từ tính trong khu vực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"disturb":{"definition":"Làm mất yên tĩnh, làm náo động; quấy rầy, làm bối rối, làm lo âu; làm xáo trộn.","example":"Please do not disturb the class during the test.","exampleTranslation":"Vui lòng đừng làm náo động lớp học trong suốt bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"driftwood":{"definition":"Gỗ trôi giạt, củi rều.","example":"Driftwood washed up on the beach.","exampleTranslation":"Củi rều trôi dạt trên bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"environmentalist":{"definition":"Nhà hoạt động môi trường: người quan tâm bảo vệ môi trường.","example":"The environmentalist planted trees in the park.","exampleTranslation":"Nhà hoạt động môi trường đã trồng cây trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"environmentally":{"definition":"Về phương diện môi trường.","example":"The team finished environmentally and left.","exampleTranslation":"Cả đội đã kết thúc về phương diện môi trường và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"environment"},"escape":{"definition":"Cây trồng mọc tự nhiên (không do gieo trồng... ).","example":"That plant is an escape from the garden.","exampleTranslation":"Loại cây đó là một loại cây trồng mọc tự nhiên từ khu vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"exposure":{"definition":"Sự phơi.","example":"Long exposure to sun can dry your skin.","exampleTranslation":"Sự phơi lâu dưới nắng có thể làm khô da bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"fallout":{"definition":"Bụi phóng xạ (từ vụ nổ hạt nhân).","example":"The nuclear fallout caused a lot of damage.","exampleTranslation":"Bụi phóng xạ hạt nhân gây ra rất nhiều thiệt hại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"footprint":{"definition":"Dấu chân, vết chân.","example":"We found a footprint near the tent.","exampleTranslation":"Chúng tôi tìm thấy một dấu chân gần lều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"grass":{"definition":"Bãi cỏ, thảm cỏ (ở công viên).","example":"Please do not walk on the grass here.","exampleTranslation":"Vui lòng không đi bộ trên thảm cỏ ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"grassland":{"definition":"Đồng cỏ, bãi cỏ.","example":"Cows grazed quietly in the grassland.","exampleTranslation":"Những con bò gặm cỏ lặng lẽ trên đồng cỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"grove":{"definition":"Lùm cây, khu rừng nhỏ.","example":"We walked through a quiet grove.","exampleTranslation":"Chúng tôi đi dạo qua một lùm cây yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"hazard":{"definition":"Vật vướng, vật chướng ngại (trên bâi đánh gôn).","example":"A rock became a hazard on the path.","exampleTranslation":"Một tảng đá trở thành vật chướng ngại trên lối đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"hazardous":{"definition":"Liều, mạo hiểm; nguy hiểm.","example":"It was hazardous to walk on the wet rocks.","exampleTranslation":"Thật nguy hiểm khi đi bộ trên những tảng đá ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"hedgerow":{"definition":"Hàng rào cây (hàng cây làm hàng rào).","example":"Birds nested in the hedgerow beside the road.","exampleTranslation":"Chim đã làm tổ trong hàng rào cây bên cạnh con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"jungle":{"definition":"Rừng nhiệt đới.","example":"We walked through the jungle at noon.","exampleTranslation":"Chúng tôi đi bộ qua khu rừng nhiệt đới vào buổi trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"litter":{"definition":"Rác rưởi bừa bãi.","example":"Please pick up the litter in the park.","exampleTranslation":"Làm ơn nhặt rác bừa bãi trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"logging":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của log.","example":"She was logging every hour of the trip.","exampleTranslation":"Cô ấy đang ghi chép lại mọi giờ của chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"lush":{"definition":"Căng nhựa (cỏ cây).","example":"The hills were lush and green in spring.","exampleTranslation":"Những ngọn đồi căng nhựa và xanh tươi vào mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"marsh":{"definition":"Đầm lầy.","example":"The path crossed a wet marsh.","exampleTranslation":"Con đường mòn băng qua một đầm lầy ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"moist":{"definition":"Ẩm; ẩm ướt, ướt lấp nhấp.","example":"The soil must be moist before we plant seeds.","exampleTranslation":"Đất phải ẩm trước khi chúng ta gieo hạt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"moisture":{"definition":"Hơi ẩm; nước ẩm đọng lại; nước ẩm rịn ra.","example":"Moisture gathered on the cold window.","exampleTranslation":"Hơi ẩm đọng lại trên cửa sổ lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"murky":{"definition":"Tối tăm, u ám, âm u.","example":"The water in the lake was very murky.","exampleTranslation":"Nước trong hồ rất âm u.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"overabundance":{"definition":"Sự thừa mứa, sự thừa thãi, sự quá phong phú.","example":"The overabundance of fruit filled the basket.","exampleTranslation":"Sự thừa thãi của trái cây lấp đầy cái giỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"overfish":{"definition":"Đánh hết cá, đánh cạn cá (ở một khúc sông... ).","example":"They overfish the lake every summer.","exampleTranslation":"Họ đánh bắt cá quá mức tại hồ này vào mỗi mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"overgrown":{"definition":"Mọc tràn ra, mọc che kín; mọc cao lên.","example":"The yard was overgrown with tall weeds.","exampleTranslation":"Cái sân đã bị cỏ dại mọc che kín.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"parch":{"definition":"Rang.","example":"The dry heat will parch the beans quickly.","exampleTranslation":"Cái nóng khô sẽ làm rang các hạt đậu nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"plume":{"definition":"Vật giống lông chim, vật nhẹ như lông chim; (động vật học) cấu tạo hình lông chim.","example":"A plume of smoke rose into the air.","exampleTranslation":"Một cột khói bốc lên không trung.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"pollute":{"definition":"Làm ô uế, làm mất thiêng liêng.","example":"Smoke can pollute the air quickly.","exampleTranslation":"Khói có thể làm ô uế không khí nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"preserve":{"definition":"Giữ, giữ gìn, bảo quản, bảo tồn, duy trì.","example":"We must preserve our natural resources for the future.","exampleTranslation":"Chúng ta phải bảo tồn các nguồn tài nguyên thiên nhiên cho tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"protect":{"definition":"Bảo vệ, bảo hộ, che chở.","example":"We must work together to protect the environment.","exampleTranslation":"Chúng ta phải hợp tác để bảo vệ môi trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"environment"},"protection":{"definition":"Người bảo vệ, người che chở; vật bảo vệ, vật che chở.","example":"Wear a helmet for better protection while riding.","exampleTranslation":"Hãy đội mũ bảo hiểm để được bảo vệ tốt hơn khi lái xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"protective":{"definition":"Bảo vệ, bảo hộ, che chở.","example":"The soldier wore protective gear during the training.","exampleTranslation":"Người lính đã mặc đồ bảo hộ trong suốt quá trình huấn luyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"puddle":{"definition":"Đất sét nhào (để láng lòng kênh... ).","example":"They used puddle to seal the canal floor.","exampleTranslation":"Họ đã sử dụng đất sét để bịt kín sàn kênh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"reclaim":{"definition":"Việc cải tạo.","example":"The land is beyond reclaim for farming now.","exampleTranslation":"Vùng đất này giờ đã quá muộn để cải tạo cho việc trồng trọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"reed":{"definition":"Thơ đồng quê.","example":"He wrote a reed about the quiet farm.","exampleTranslation":"Anh ấy đã viết một bài thơ về trang trại yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"treeless":{"definition":"Không có cây.","example":"They walked across a wide and treeless plain.","exampleTranslation":"Họ đã đi bộ ngang qua một đồng bằng rộng và không có cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"tropical":{"definition":"Nhiệt đới.","example":"We enjoyed some tropical fruit on our vacation.","exampleTranslation":"Chúng tôi đã thưởng thức vài loại trái cây nhiệt đới trong kỳ nghỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"undergrowth":{"definition":"Sự chậm lớn, sự còi cọc.","example":"The plant showed undergrowth after weeks of cold.","exampleTranslation":"Cái cây cho thấy sự còi cọc sau nhiều tuần lạnh giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"undisturbed":{"definition":"Yên tĩnh (cảnh); không bị phá rối (giấc ngủ... ); không bị làm phiền, không bị quấy rầy, không lo âu (người); không bị xáo lộn (giấy tờ).","example":"The baby slept undisturbed all night.","exampleTranslation":"Đứa bé ngủ yên tĩnh suốt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"unprotected":{"definition":"Không được bảo vệ, không được bảo hộ, không được che chở.","example":"The child felt unprotected in the storm.","exampleTranslation":"Đứa trẻ cảm thấy không được bảo vệ trong cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"upwind":{"definition":"Theo chiều gió đang thổi.","example":"We parked upwind of the fire pit.","exampleTranslation":"Chúng tôi đỗ xe theo chiều gió của hố lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"vegetation":{"definition":"Sự sinh dưỡng.","example":"Dense vegetation covered the hill after the storm.","exampleTranslation":"Sự sinh dưỡng dày đặc đã bao phủ ngọn đồi sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"warm":{"definition":"nóng: có nhiệt độ cao","example":"The weather is warm and pleasant today.","exampleTranslation":"Thời tiết hôm nay nóng và dễ chịu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"wasteland":{"definition":"Đất hoang, đất khô cằn; khu đất không thể sử dụng được, khu đất không sử dụng.","example":"Nothing grew on the dry wasteland.","exampleTranslation":"Không có gì mọc trên đất hoang khô cằn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"waterlogged":{"definition":"Úng nước, ngập nước (đất).","example":"The garden was waterlogged after days of rain.","exampleTranslation":"Khu vườn đã úng nước sau nhiều ngày mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"environment"},"wilderness":{"definition":"Nơi vắng vẻ tiêu điều, nơi hoang tàn.","example":"They spent the weekend hiking through the deep wilderness.","exampleTranslation":"Họ đã dành cuối tuần để đi bộ đường dài xuyên qua vùng hoang dã sâu thẳm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"woodland":{"definition":"(thuộc) rừng.","example":"We took a long walk through the woodland.","exampleTranslation":"Chúng tôi đã đi bộ một quãng đường dài xuyên qua vùng rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"environment"},"automation":{"definition":"Sự tự động hóa; việc dùng máy móc để thực hiện công việc.","example":"Automation saved time in the factory.","exampleTranslation":"Tự động hóa giúp nhà máy tiết kiệm thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"innovation":{"definition":"Sự đổi mới; ý tưởng hoặc phương pháp mới.","example":"The company grew through constant innovation.","exampleTranslation":"Công ty phát triển nhờ liên tục đổi mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"privacy":{"definition":"Sự riêng tư; quyền giữ kín thông tin cá nhân.","example":"She asked for privacy while making the call.","exampleTranslation":"Cô ấy muốn có sự riêng tư khi gọi điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"access":{"definition":"Quyền hoặc khả năng tiếp cận, sử dụng một nguồn lực.","example":"The building provides easy access for all guests.","exampleTranslation":"Tòa nhà giúp mọi khách tham quan dễ dàng tiếp cận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"digital":{"definition":"Thuộc công nghệ điện tử dùng dữ liệu dạng số.","example":"The watch shows the time in digital numbers.","exampleTranslation":"Đồng hồ hiển thị thời gian bằng chữ số điện tử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"computed":{"definition":"Được tính toán, đã tính xong.","example":"The answer was computed correctly.","exampleTranslation":"Câu trả lời đã được tính toán một cách chính xác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"comput"},"computer":{"definition":"Máy tính, máy vi tính, máy điện toán, máy tính điện tử","example":"I need a new computer for my work.","exampleTranslation":"Tôi cần một chiếc máy tính mới cho công việc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"comput"},"computing":{"definition":"Điện toán; tính toán; máy điện toán.","example":"Computing helps students solve hard problems.","exampleTranslation":"Tin học giúp học sinh giải quyết các vấn đề khó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"comput"},"internet":{"definition":"Internet.","example":"The internet helps me study every day.","exampleTranslation":"Internet giúp tôi học tập mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"internet"},"automated":{"definition":"Được tự động hóa; vận hành bằng hệ thống hoặc thiết bị tự động.","example":"Automated systems can reduce errors in large manufacturing plants.","exampleTranslation":"Các hệ thống tự động có thể giảm lỗi trong những nhà máy sản xuất lớn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"automat"},"automatic":{"definition":"Tự động.","example":"The new machine has an automatic cleaning system.","exampleTranslation":"Chiếc máy mới có một hệ thống làm sạch tự động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"automat"},"automating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của automate.","example":"They are automating the checkout process.","exampleTranslation":"Họ đang tự động hóa quy trình thanh toán.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"automat"},"innovating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của innovate.","example":"They were innovating in small steps.","exampleTranslation":"Họ đã đổi mới theo từng bước nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"innovat"},"innovative":{"definition":"Có tính chất đổi mới; có tính chất là một sáng kiến.","example":"They chose an innovative way to store books.","exampleTranslation":"Họ đã chọn một cách sáng tạo để lưu trữ sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"innovat"},"innovator":{"definition":"Người đưa vào những cái mới; người có sáng kiến về (cái gì).","example":"She is an innovator in small home tools.","exampleTranslation":"Cô ấy là một nhà đổi mới trong lĩnh vực dụng cụ gia đình nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"innovat"},"robot":{"definition":"Người máy.","example":"Starwars C-3PO is a golden robot.","exampleTranslation":"C-3PO trong Starwars là một người máy màu vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"robot"},"robotic":{"definition":"Như người máy; cứng nhắc, máy móc.","example":"Her answer sounded robotic and very stiff.","exampleTranslation":"Câu trả lời của cô ấy nghe như máy móc và rất cứng nhắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"robot"},"robotize":{"definition":"Tự động hoá.","example":"They want to robotize the packing line soon.","exampleTranslation":"Họ muốn sớm robot hóa dây chuyền đóng gói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"robot"},"artificial":{"definition":"Nhân tạo.","example":"She bought some artificial silk for her new dress.","exampleTranslation":"Cô ấy đã mua một ít lụa nhân tạo cho chiếc váy mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"artificial"},"artificially":{"definition":"Bằng cách nhân tạo hoặc do con người tạo ra, không phải tự nhiên.","example":"The lake's water level was artificially maintained during the drought.","exampleTranslation":"Mực nước hồ được duy trì nhân tạo trong đợt hạn hán.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"artificial"},"data":{"definition":"(Thường dùng như số ít) số liệu, dữ kiện, tài liệu, cứ liệu (cung cấp những điều cần thiết).","example":"The data showed a clear rise in sales.","exampleTranslation":"Dữ liệu cho thấy doanh số bán hàng tăng rõ rệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"data"},"software":{"definition":"Phần mềm","example":"This software makes my work easier.","exampleTranslation":"Phần mềm này giúp công việc của tôi dễ dàng hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"software"},"telecommunication":{"definition":"Viễn thông, sự thông tin từ xa.","example":"Telecommunication links distant offices quickly.","exampleTranslation":"Viễn thông giúp kết nối các văn phòng ở xa một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"telecommunicat"},"online":{"definition":"Trực tuyến.","example":"The class met online after lunch.","exampleTranslation":"Lớp học đã gặp mặt trực tuyến sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"online"},"virtual":{"definition":"Thực sự, thực tế.","example":"He is the virtual leader of our small group.","exampleTranslation":"Anh ấy là lãnh đạo ảo của nhóm nhỏ chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"virtual"},"virtuality":{"definition":"Tính chất thực sự.","example":"They discussed the virtuality today.","exampleTranslation":"Họ đã thảo luận về tính ảo ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"virtual"},"algorithm":{"definition":"Thuật toán.","example":"The algorithm found the shortest route.","exampleTranslation":"Thuật toán đã tìm ra lộ trình ngắn nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"algorithm"},"device":{"definition":"Phương sách, phương kế; chước mưu.","example":"The teacher used a simple device to open the jar.","exampleTranslation":"Giáo viên đã sử dụng một thiết bị đơn giản để mở cái lọ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"device"},"encrypt":{"definition":"Mã hóa, viết lại thành mật mã.","example":"They encrypt the file for safety.","exampleTranslation":"Họ mã hóa tập tin để bảo mật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"encrypt"},"encrypted":{"definition":"Quá khứ và phân từ quá khứ của encrypt","example":"They encrypted the message before sending it.","exampleTranslation":"Họ đã mã hóa tin nhắn trước khi gửi đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"encrypt"},"encryption":{"definition":"Sự mật mã hóa.","example":"Encryption keeps private messages safe online.","exampleTranslation":"Mã hóa giúp giữ cho các tin nhắn cá nhân được an toàn trên mạng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"encrypt"},"program":{"definition":"Chương trình (công tác, biểu diễn văn nghệ... ).","example":"The television program starts at eight o'clock tonight.","exampleTranslation":"Chương trình truyền hình bắt đầu lúc tám giờ tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"program","spellingNote":"British spelling: programme."},"network":{"definition":"Lưới, đồ dùng kiểu lưới.","example":"She carried a small network purse for her keys.","exampleTranslation":"Cô ấy mang theo một chiếc ví lưới nhỏ để đựng chìa khóa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"network"},"database":{"definition":"Trong khoa học máy tính. Cơ sở dữ liệu.","example":"A database stores all the customer information.","exampleTranslation":"Một cơ sở dữ liệu lưu trữ tất cả thông tin khách hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"database"},"mobile":{"definition":"chuyển động, di động; lưu động.","example":"My mobile phone is ringing on the table.","exampleTranslation":"Điện thoại di động của tôi đang đổ chuông trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"mobile"},"electronic":{"definition":"Điện tử.","example":"I bought a new electronic watch yesterday.","exampleTranslation":"Tôi đã mua một chiếc đồng hồ điện tử mới vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"electronic"},"electronics":{"definition":"Điện tử học.","example":"He studied electronics at school.","exampleTranslation":"Anh ấy đã học về điện tử ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"electronic"},"information":{"definition":"Sự cung cấp tin tức; sự thông tin.","example":"We need more information before we decide.","exampleTranslation":"Chúng ta cần thêm thông tin trước khi đưa ra quyết định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"information"},"informational":{"definition":"Sự truyền tin, (thuộc) sự thông tin.","example":"The report gave informational support for the claim.","exampleTranslation":"Bản báo cáo đã cung cấp hỗ trợ thông tin cho luận điểm đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"information"},"activate":{"definition":"Hoạt hoá, làm hoạt động.","example":"Press the button to activate the lamp.","exampleTranslation":"Nhấn nút để hoạt hoá chiếc đèn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"activation":{"definition":"Sự làm phóng xạ.","example":"The activation of the sample made it glow.","exampleTranslation":"Sự làm phóng xạ mẫu thử đã làm nó phát sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"adjust":{"definition":"Sửa lại cho đúng, điều chỉnh.","example":"I need to adjust my watch every morning.","exampleTranslation":"Tôi cần điều chỉnh đồng hồ của mình mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"adjustment":{"definition":"Sự sửa lại cho đúng, sự điều chỉnh, sự chỉnh lý.","example":"A small adjustment in direction helped us arrive.","exampleTranslation":"Một sự điều chỉnh nhỏ về hướng đi đã giúp chúng tôi đến nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"align":{"definition":"Sắp cho thẳng hàng.","example":"Please align the chairs in a straight row.","exampleTranslation":"Vui lòng sắp xếp các chiếc ghế cho thẳng hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"analog":{"definition":"Vật Tương tự (Một cách biểu diễn đối với các giá trị biến đổi của các thiết bị chỉ thị khi bộ phận trỏ của nó có thể thay đổi liên tục).","example":"The analog showed a slow, steady change.","exampleTranslation":"Vật tương tự đã chỉ ra một sự thay đổi chậm, ổn định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"antenna":{"definition":"Râu (của sâu bọ).","example":"The antenna on the radio was broken.","exampleTranslation":"Râu trên đài phát thanh đã bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"application":{"definition":"Sự gắn vào, sự áp vào, sự ghép vào, sự đính vào, sự đắp vào, sự tra vào ((cũng) appliance).","example":"She put the plaster on with careful application.","exampleTranslation":"Cô ấy đã băng bó với sự áp vào cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"array":{"definition":"Dãy sắp xếp ngay ngắn; hàng ngũ chỉnh tề.","example":"An array of flowers decorated the long table.","exampleTranslation":"Một dãy sắp xếp các loài hoa đã trang trí chiếc bàn dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"assemble":{"definition":"Tập hợp, tụ tập, nhóm họp.","example":"We assemble here before the trip begins.","exampleTranslation":"Chúng ta tập hợp tại đây trước khi chuyến đi bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"assembly":{"definition":"Hội đồng.","example":"The national assembly met to discuss the new law.","exampleTranslation":"Hội đồng quốc gia đã nhóm họp để thảo luận về luật mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"attach":{"definition":"Tham, gia, gia nhập.","example":"He decided to attach himself to a party.","exampleTranslation":"Anh ấy quyết định tham gia vào một đảng phái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"automatically":{"definition":"tự động; một cách tự động","example":"The door closed and locked automatically behind him.","exampleTranslation":"Cánh cửa đóng lại và tự động khóa sau lưng anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"technology"},"automaton":{"definition":"Người máy ((nghĩa đen) & (nghĩa bóng)).","example":"You must act like a human, not an automaton.","exampleTranslation":"Bạn phải hành động như một con người, không phải một người máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"autopilot":{"definition":"Máy lái tự động.","example":"The plane stayed steady on autopilot.","exampleTranslation":"Máy bay vẫn giữ vững hành trình trên chế độ máy lái tự động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"band":{"definition":"Dải băng.","example":"The radio station operates on a specific frequency band.","exampleTranslation":"Đài phát thanh hoạt động trên một dải tần số cụ thể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"bandwidth":{"definition":"Dải thông, bề rộng băng tần, dãy sóng.","example":"The video needs more bandwidth to load.","exampleTranslation":"Video cần thêm dải thông để tải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"beep":{"definition":"Tiếng bíp (phát từ máy).","example":"The alarm gave a short beep in the hall.","exampleTranslation":"Chuông báo động phát ra một tiếng bíp ngắn ở hành lang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"beta":{"definition":"Bêta (chữ cái Hy lạp).","example":"The beta played a key role.","exampleTranslation":"Bêta đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"boot":{"definition":"Giày tra tấn (dụng cụ tra tấn hình giày ống).","example":"The boot was part of an old story.","exampleTranslation":"Đôi giày tra tấn là một phần của câu chuyện cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"browse":{"definition":"Duyệt, điều hướng.","example":"I like to browse the internet for new news.","exampleTranslation":"Tôi thích duyệt internet để tìm tin tức mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"browser":{"definition":"Người kiểm tra hàng hóa để bán nhưng không mua gì.","example":"The browser watched the window, then walked away.","exampleTranslation":"Người kiểm tra hàng hóa đã quan sát cửa sổ, rồi bỏ đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"buffer":{"definition":"Old buffer ông bạn già; người cũ kỹ bất tài.","example":"The old buffer told the same story again.","exampleTranslation":"Ông bạn già đã kể cùng một câu chuyện đó lần nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"button":{"definition":"Cái khuy, cái cúc (áo).","example":"A button fell off my shirt.","exampleTranslation":"Một cái cúc đã rơi khỏi áo sơ mi của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"cable":{"definition":"Cáp xuyên đại dương.","example":"The cable crossed the ocean under the sea.","exampleTranslation":"Cáp xuyên đại dương vắt ngang qua dưới biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"cache":{"definition":"Nơi giấu, nơi trữ (lương thực, đạn dược... nhất là các nhà thám hiểm để dùng sau này).","example":"They made a cache of food for winter.","exampleTranslation":"Họ tạo một nơi trữ lương thực cho mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"camera":{"definition":"Tên một họ.","example":"The camera family moved into the old house.","exampleTranslation":"Gia đình Camera đã chuyển vào ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"card":{"definition":"Cạc, các, thiếp, thiệp, thẻ, phiếu, bìa.","example":"I forgot to bring my credit card today.","exampleTranslation":"Tôi quên mang thẻ tín dụng của mình hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"cats":{"definition":"Hệ thống treo điện tử tự động điều chỉnh độ cứng theo điều kiện vận hành.","example":"The cats adjusted the ride on rough roads.","exampleTranslation":"Hệ thống treo điện tử tự động điều chỉnh độ cứng theo điều kiện vận hành đã giúp chuyến đi trên những con đường gồ ghề dễ dàng hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"chip":{"definition":"Làm sứt, làm mẻ.","example":"Be careful not to chip the glass cup.","exampleTranslation":"Hãy cẩn thận đừng làm sứt chiếc cốc thủy tinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"circuit":{"definition":"Chu vi, đường vòng quanh.","example":"The runners completed one full circuit of the track.","exampleTranslation":"Những người chạy bộ đã hoàn thành một vòng chu vi đầy đủ của đường đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"circuitry":{"definition":"Mạch điện; hệ thống mạch điện.","example":"The radio has simple circuitry inside.","exampleTranslation":"Chiếc radio có mạch điện đơn giản bên trong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"click":{"definition":"Tật đá chân vào nhau; sự đá chân vào nhau (ngựa).","example":"The horse had a bad click in its legs.","exampleTranslation":"Con ngựa đã có tật đá chân vào nhau trong các bước chạy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"clock":{"definition":"Ghi giờ.","example":"Please remember to clock in when you arrive.","exampleTranslation":"Vui lòng nhớ ghi giờ khi bạn đến nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"code":{"definition":"Bộ luật, luật.","example":"You must follow the labor code strictly.","exampleTranslation":"Bạn phải tuân theo bộ luật lao động một cách nghiêm ngặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"compatibility":{"definition":"tính tương thích; sự phù hợp","example":"There is good compatibility with all versions of Windows.","exampleTranslation":"Có tính tương thích tốt với tất cả các phiên bản của Windows.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"technology"},"compatible":{"definition":"Hợp, thích hợp, tương hợp.","example":"This charger is compatible with my phone.","exampleTranslation":"Bộ sạc này thích hợp với điện thoại của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"component":{"definition":"Hợp thành, cấu thành.","example":"Each component of the machine must work perfectly.","exampleTranslation":"Mỗi bộ phận hợp thành của cỗ máy phải hoạt động hoàn hảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"computerization":{"definition":"Điện toán hóa, dùng máy điện toán.","example":"Computerization made the office work faster.","exampleTranslation":"Việc điện toán hóa đã làm cho công việc văn phòng nhanh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"computerize":{"definition":"Trang bị máy điện toán.","example":"We plan to computerize the library records.","exampleTranslation":"Chúng tôi dự định điện toán hóa các hồ sơ thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"connect":{"definition":"Nối nhau, nối tiếp nhau.","example":"The two trains connect at the main station.","exampleTranslation":"Hai chuyến tàu nối nhau tại nhà ga chính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"connection":{"definition":"Sự liên quan, sự liên lạc, mối quan hệ; sự chấp nối, sự kết nối.","example":"Is there a connection between these two events?","exampleTranslation":"Có một sự liên quan giữa hai sự kiện này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"controller":{"definition":"Người kiểm tra, người kiểm soát.","example":"The controller checked each ticket carefully.","exampleTranslation":"Người kiểm soát đã kiểm tra từng vé một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"desktop":{"definition":"Mặt bàn","example":"The desktop played a key role.","exampleTranslation":"Mặt bàn đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"detector":{"definition":"Máy dò.","example":"The security guard installed a metal detector at the door.","exampleTranslation":"Nhân viên bảo vệ đã lắp đặt một máy dò kim loại ở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"digit":{"definition":"Ngón chân, ngón tay.","example":"He cut his finger on a sharp digit.","exampleTranslation":"Anh ấy bị cắt ngón tay trên một chữ số sắc nhọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"digitize":{"definition":"Số hoá, rời rạc hoá, lượng tử hoá.","example":"We digitize old photos to save them.","exampleTranslation":"Chúng tôi số hoá các bức ảnh cũ để lưu giữ chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"directory":{"definition":"Sách chỉ dẫn, sách hướng dẫn.","example":"I need to find his name in the directory.","exampleTranslation":"Tôi cần tìm tên anh ấy trong sách chỉ dẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"disc":{"definition":"Đĩa hát.","example":"He put the old disc on the player.","exampleTranslation":"Anh ấy đặt chiếc đĩa hát cũ lên máy phát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"disconnect":{"definition":"Làm rời ra, cắt rời ra, tháo rời ra; phân cách ra.","example":"Please disconnect the cable from the computer.","exampleTranslation":"Vui lòng tháo rời cáp khỏi máy tính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"dismantle":{"definition":"Gỡ hết vật che đậy, dỡ hết vật che đậy, lột bỏ vật phủ ngoài.","example":"Please dismantle the old shelf carefully.","exampleTranslation":"Vui lòng dỡ bỏ chiếc kệ cũ một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"display":{"definition":"Một buổi trình diễn.","example":"There is a lovely display of flowers here.","exampleTranslation":"Có một buổi trình diễn hoa đáng yêu ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"domain":{"definition":"Miền, tên miền (mạng máy tính).","example":"They bought a new domain for the website.","exampleTranslation":"Họ đã mua một tên miền mới cho trang web.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"download":{"definition":"Nạp xuống; viễn nạp.","example":"The download finished before lunch.","exampleTranslation":"Việc nạp xuống đã hoàn tất trước bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"eject":{"definition":"Tống ra, làm vọt ra (tia nước, tia hơi... ).","example":"The machine can eject steam through the pipe.","exampleTranslation":"Cỗ máy có thể tống ra hơi nước qua đường ống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"email":{"definition":"Thư điện tử.","example":"I sent an email before lunch.","exampleTranslation":"Tôi đã gửi một thư điện tử trước bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"enable":{"definition":"Làm cho có thể (làm gì), làm cho có khả năng (làm gì).","example":"This ape can enable faster learning at home.","exampleTranslation":"Con vượn này có thể làm cho việc học ở nhà nhanh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"encode":{"definition":"mã hóa.","example":"We encode the message before sending it.","exampleTranslation":"Chúng tôi mã hóa thông điệp trước khi gửi nó đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"engine":{"definition":"Dụng cụ, phương tiện.","example":"They used every engine to achieve their goal.","exampleTranslation":"Họ sử dụng mọi phương tiện để đạt được mục tiêu của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"equipment":{"definition":"Đồ trang bị, thiết bị, dụng cụ, đồ dùng cần thiết (cho một cuộc đi, cho một nhà máy... ).","example":"We need to buy new electrical equipment for the lab.","exampleTranslation":"Chúng tôi cần mua thiết bị điện mới cho phòng thí nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"escapement":{"definition":"Lối thoát ra.","example":"The small window was the only escapement.","exampleTranslation":"Cửa sổ nhỏ là lối thoát ra duy nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"file":{"definition":"Cái giũa.","example":"Use a file to smooth the rough metal surface.","exampleTranslation":"Sử dụng cái giũa để làm mịn bề mặt kim loại thô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"filter":{"definition":"Cái lọc, máy lọc (xăng, không khí).","example":"The filter caught the dust quickly.","exampleTranslation":"Cái lọc đã bắt bụi một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"finder":{"definition":"Bộ tìm.","example":"The device has a finder on the side.","exampleTranslation":"Thiết bị có một bộ tìm ở bên cạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"flash":{"definition":"Ánh sáng loé lên; tia.","example":"A bright flash of lightning lit up the sky.","exampleTranslation":"Một tia sáng chớp loé lên của sấm sét đã làm bừng sáng bầu trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"format":{"definition":"Tạo ra hay sửa đổi định dạng của tài liệu","example":"He learned to format the tool.","exampleTranslation":"Anh ấy đã học cách tạo ra định dạng công cụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"futuristic":{"definition":"Thuộc về thuyết vị lai.","example":"Her room had a futuristic look and feel.","exampleTranslation":"Căn phòng của cô ấy có diện mạo thuộc về thuyết vị lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"gadget":{"definition":"Đồ dùng, đồ vật, công cụ, thiết bị đặc biệt.","example":"He bought a small gadget for his desk.","exampleTranslation":"Anh ấy đã mua một thiết bị nhỏ cho bàn làm việc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"gear":{"definition":"Bánh răng; sự truyền động bánh răng; hộp số (ô tô, xe máy).","example":"You need to shift into first gear now.","exampleTranslation":"Bạn cần chuyển sang số một ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"generate":{"definition":"Phát, phát ra.","example":"Solar panels can generate electricity for the house.","exampleTranslation":"Các tấm pin mặt trời có thể phát ra điện cho ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"grid":{"definition":"Vỉ (nướng chả).","example":"He cooked the meat on a hot grid.","exampleTranslation":"Anh ấy đã nấu thịt trên một chiếc vỉ nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"hack":{"definition":"Búa, rìu; cuốc chim (của công nhân mỏ).","example":"He used a hack to break the ice.","exampleTranslation":"Anh ấy đã dùng một cái búa để phá băng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"headphone":{"definition":"Ống nghe (điện đài).","example":"I wear a headphone for clear radio calls.","exampleTranslation":"Tôi đeo ống nghe để có các cuộc gọi radio rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"headset":{"definition":"Bộ ống nghe (điện đài).","example":"He wore a headset during the video call.","exampleTranslation":"Anh ấy đeo bộ ống nghe trong suốt cuộc gọi video.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"hydrophone":{"definition":"Ống nghe dưới nước.","example":"The team lowered a hydrophone into the sea.","exampleTranslation":"Cả đội đã hạ một ống nghe dưới nước xuống biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"icon":{"definition":"biểu tượng.","example":"The red heart became an icon on the screen.","exampleTranslation":"Trái tim đỏ đã trở thành một biểu tượng trên màn hình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"inbox":{"definition":"Hộp thư đến (trong phòng việc).","example":"The inbox was useful in class.","exampleTranslation":"Hộp thư đến đã hữu ích trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"inbuilt":{"definition":"Gắn liền; vốn có; sẵn có; cố hữu.","example":"Curiosity is an inbuilt part of learning.","exampleTranslation":"Sự tò mò là một phần vốn có của việc học tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"innovate":{"definition":"Đưa vào những cái mới.","example":"Our team must innovate to stay useful.","exampleTranslation":"Đội của chúng tôi phải đưa vào những cái mới để duy trì sự hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"input":{"definition":"Số tiền cúng.","example":"Each guest left a small input for the event.","exampleTranslation":"Mỗi vị khách đã để lại một số tiền cúng nhỏ cho sự kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"installation":{"definition":"Lễ nhậm chức.","example":"Her installation as leader was simple.","exampleTranslation":"Lễ nhậm chức của cô ấy với tư cách lãnh đạo rất đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"intelligence":{"definition":"Sự hiểu biết.","example":"Her intelligence solved the problem quickly.","exampleTranslation":"Sự hiểu biết của cô ấy đã giải quyết vấn đề nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"intelligent":{"definition":"Thông minh, sáng dạ.","example":"She is intelligent and solves problems quickly.","exampleTranslation":"Cô ấy thông minh và giải quyết vấn đề nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"interactive":{"definition":"Tương tác, ảnh hưởng lẫn nhau, tác động qua lại.","example":"The ape offers an interactive lesson.","exampleTranslation":"Con vượn đưa ra một bài học có sự tác động qua lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"interface":{"definition":"Bề mặt chung (cho hai vật... ); mặt phân giới.","example":"The two materials meet at a smooth interface.","exampleTranslation":"Hai vật liệu gặp nhau tại một bề mặt chung phẳng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"keyboard":{"definition":"Bàn phím (pianô); bàn chữ (máy chữ).","example":"Please type your name on the keyboard.","exampleTranslation":"Xin hãy gõ tên bạn trên bàn phím.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"keyed":{"definition":"Đã được chèn, đóng chốt.","example":"The keyed block held the shelf in place.","exampleTranslation":"Khối gỗ đã được chèn giữ cái kệ ở đúng vị trí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"laptop":{"definition":"Máy tính laptop, máy tính xách tay.","example":"I write notes on my laptop every day.","exampleTranslation":"Tôi viết ghi chú trên máy tính xách tay của mình mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"link":{"definition":"Trong đời sống. Liên kết, mối liên hệ giữa các vật thể, hiện tượng.","example":"There is a clear link between health and diet.","exampleTranslation":"Có một mối liên hệ rõ ràng giữa sức khỏe và chế độ ăn uống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"linkage":{"definition":"Sự nối lại với nhau, sự kết hợp, sự liên hợp.","example":"Their teamwork showed strong linkage between the groups.","exampleTranslation":"Sự làm việc nhóm của họ cho thấy sự liên kết chặt chẽ giữa các nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"logs":{"definition":"Động từ chia ở ngôi thứ ba số ít của log","example":"The ape logs every action you take.","exampleTranslation":"Hệ thống ghi lại mọi hành động bạn thực hiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"loop":{"definition":"Thòng lọng; cái khâu, cái móc, khuyết áo.","example":"The rope made a loop around the post.","exampleTranslation":"Sợi dây tạo thành một thòng lọng quanh cột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"loudspeaker":{"definition":"Loa phóng thanh ((cũng) speaker).","example":"The loudspeaker announced the train delay.","exampleTranslation":"Loa phóng thanh thông báo chuyến tàu bị hoãn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"machinery":{"definition":"Máy móc,cơ giới","example":"They do not use much big machinery that uses gasoline.","exampleTranslation":"Họ không sử dụng nhiều máy móc cơ giới lớn chạy bằng xăng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"malfunction":{"definition":"Sự chạy, trục trặc.","example":"The engine had a sudden malfunction.","exampleTranslation":"Động cơ gặp một sự chạy trục trặc bất ngờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"manipulate":{"definition":"Vận dụng bằng tay, thao tác.","example":"She can manipulate the controls with one hand.","exampleTranslation":"Cô ấy có thể vận dụng bằng tay các nút điều khiển bằng một tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"manipulation":{"definition":"Sự vận dụng bằng tay, sự thao tác.","example":"Careful manipulation of the knobs changed the sound.","exampleTranslation":"Sự thao tác cẩn thận các núm xoay làm thay đổi âm thanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"mechanical":{"definition":"Máy móc; (thuộc) cơ khí; (thuộc) cơ học.","example":"The factory hired a skilled mechanical engineer.","exampleTranslation":"Nhà máy đã thuê một kỹ sư cơ khí lành nghề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"mechanic":{"definition":"Thợ máy, công nhân cơ khí.","example":"The mechanic fixed my bike quickly.","exampleTranslation":"Thợ máy đã sửa xe đạp của tôi nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"microphone":{"definition":"Micrô, ống nói, máy vi âm.","example":"Please speak closer to the microphone.","exampleTranslation":"Làm ơn nói gần micrô hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"modem":{"definition":"Bộ điều giải, modem.","example":"The modem blinked before the internet connection started.","exampleTranslation":"Modem nhấp nháy trước khi kết nối internet bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"monitor":{"definition":"Trưởng lớp, cán bộ lớp (ở trường học).","example":"The class monitor kept everyone quiet.","exampleTranslation":"Trưởng lớp giữ cho mọi người im lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"operate":{"definition":"Hoạt động (máy... ).","example":"Can you show me how to operate this machine?","exampleTranslation":"Bạn có thể chỉ cho tôi cách vận hành chiếc máy này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"operation":{"definition":"Sự hoạt động; quá trình hoạt động.","example":"The new factory will come into operation soon.","exampleTranslation":"Nhà máy mới sẽ sớm đi vào hoạt động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"operator":{"definition":"người thợ máy; người sử dụng máy móc.","example":"The operator fixed the broken line.","exampleTranslation":"Người thợ máy đã sửa chữa đường dây bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"outdated":{"definition":"Lỗi thời, cổ.","example":"That phone looks outdated now.","exampleTranslation":"Chiếc điện thoại đó trông lỗi thời bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"outmoded":{"definition":"Không phải mốt, không còn mốt nữa, cổ lỗ sĩ, lỗi thời.","example":"That outmoded machine is no longer useful.","exampleTranslation":"Chiếc máy lỗi thời đó không còn hữu ích nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"overload":{"definition":"Lượng quá tải.","example":"The machine stopped because of overload in the circuit.","exampleTranslation":"Chiếc máy đã dừng lại vì quá tải trong mạch điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"paperless":{"definition":"Không giấy tờ (paperless office: văn phòng không giấy).","example":"The company moved to a paperless office.","exampleTranslation":"Công ty đã chuyển sang văn phòng không giấy tờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"phone":{"definition":"Điện thoại, máy điện thoại, dây nói, phôn.","example":"I am currently talking on the phone.","exampleTranslation":"Tôi hiện đang nói chuyện trên điện thoại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"photocell":{"definition":"tế bào quang điện","example":"The photocell opened the door when it sensed light.","exampleTranslation":"Tế bào quang điện đã mở cửa khi nó cảm nhận được ánh sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"plug":{"definition":"Cái phích.","example":"I need to buy a new three-pin plug.","exampleTranslation":"Tôi cần mua một cái phích cắm ba chấu mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"portable":{"definition":"Có thể mang theo, xách tay.","example":"I bought a portable radio for my camping trip.","exampleTranslation":"Tôi đã mua một cái radio xách tay cho chuyến cắm trại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"processor":{"definition":"Máy chế biến, máy xử lý.","example":"The processor cut the vegetables in seconds.","exampleTranslation":"Máy chế biến đã cắt rau củ trong vài giây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"programmer":{"definition":"Người lập trình (trên máy tính).","example":"The programmer fixed the bug before lunch.","exampleTranslation":"Lập trình viên đã sửa lỗi trước bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"remote":{"definition":"Xa, xa xôi, xa xăm.","example":"They live in a remote village far away.","exampleTranslation":"Họ sống trong một ngôi làng hẻo lánh ở rất xa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"remotely":{"definition":"Ở mức rất nhỏ; rất mơ hồ; rất xa.","example":"She spoke remotely during the meeting.","exampleTranslation":"Cô ấy đã phát biểu từ xa trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"technology"},"remoteness":{"definition":"Sự xa xôi.","example":"The remoteness of the village made travel slow.","exampleTranslation":"Sự xa xôi của ngôi làng khiến việc đi lại chậm chạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"reset":{"definition":"Mài lại (một dụng cụ); căng lại (lò xo... ).","example":"She had to reset the knife on the stone.","exampleTranslation":"Cô ấy phải mài lại con dao trên đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"retrieve":{"definition":"Khôi phục lại được (tiếng tăm); phục hồi được (công việc làm ăn); xây dựng lại được (cơ nghiệp).","example":"He worked hard to retrieve his lost fortune.","exampleTranslation":"Anh ấy đã làm việc chăm chỉ để khôi phục lại gia sản đã mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"rewire":{"definition":"Mắc lại dây điện của (một toà nhà ).","example":"They will rewire the house next week.","exampleTranslation":"Họ sẽ mắc lại dây điện cho ngôi nhà vào tuần tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"screen":{"definition":"Bình phong, màn che.","example":"A large screen of trees blocked our view.","exampleTranslation":"Một bình phong cây lớn đã chặn tầm nhìn của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"secure":{"definition":"An toàn, kiên cố, vững chắc, chắc.","example":"The mountain provides a secure retreat for us.","exampleTranslation":"Ngọn núi cung cấp một chỗ ẩn náu an toàn cho chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"sensor":{"definition":", (vật lý) phần tử nhạy.","example":"The sensor detected heat from the oven.","exampleTranslation":"Phần tử nhạy đã phát hiện nhiệt từ lò nướng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"server":{"definition":"Người hoặc máy móc phục vụ.","example":"The server was useful in class.","exampleTranslation":"Máy móc phục vụ đã được sử dụng trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"shortcut":{"definition":"Phím rút gọn, phím tắt.","example":"Use a shortcut to open the folder faster.","exampleTranslation":"Sử dụng phím tắt để mở thư mục nhanh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"signal":{"definition":"Dấu hiệu, tín hiệu; hiệu lệnh.","example":"Please give the signal for us to advance now.","exampleTranslation":"Vui lòng ra hiệu lệnh cho chúng tôi tiến lên ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"socket":{"definition":"Đế, giá đỡ.","example":"Please place the light bulb into the socket.","exampleTranslation":"Vui lòng đặt bóng đèn vào đế cắm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"stereo":{"definition":"Bản in đúc.","example":"The old stereo was still sitting on the shelf.","exampleTranslation":"Chiếc bản in đúc cũ vẫn nằm trên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"storage":{"definition":"Ổ chứa.","example":"We need more storage for our new equipment.","exampleTranslation":"Chúng tôi cần nhiều ổ chứa hơn cho thiết bị mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"streamline":{"definition":"Có dáng thuôn, có dáng khí động.","example":"The company designed a streamline boat for racing.","exampleTranslation":"Công ty thiết kế con thuyền có dáng khí động cho cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"switch":{"definition":"Cành cây mềm; gậy mềm.","example":"He cut a switch from the willow tree.","exampleTranslation":"Anh ấy cắt một cành cây mềm từ cây liễu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"tablet":{"definition":"Tấm, bản, thẻ, phiến (bằng gỗ, ngà để viết, khắc).","example":"He wrote the date on the tablet.","exampleTranslation":"Anh ấy đã viết ngày tháng lên tấm bảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"tape":{"definition":"Băng.","example":"I need to buy a new roll of tape.","exampleTranslation":"Tôi cần mua một cuộn băng mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"tech":{"definition":"(thuộc) Kỹ thuật cao, (thuộc) công nghệ cao.","example":"They bought a tech phone for school.","exampleTranslation":"Họ đã mua một chiếc điện thoại kỹ thuật cao cho trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"technical":{"definition":"Kỹ thuật, chuyên môn.","example":"He attends a technical school to learn engineering.","exampleTranslation":"Anh ấy theo học một trường kỹ thuật để học kỹ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"technician":{"definition":"Nhà kỹ thuật, nhà chuyên môn.","example":"The technician fixed the broken screen.","exampleTranslation":"Nhà kỹ thuật đã sửa màn hình bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"technological":{"definition":"Kỹ thuật, có tính chất kỹ thuật.","example":"The factory faced technological change.","exampleTranslation":"Nhà máy đối mặt với thay đổi kỹ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"technology"},"telecommunications":{"definition":"Viễn thông, sự thông tin từ xa.","example":"Telecommunications connect people across long distances.","exampleTranslation":"Viễn thông kết nối mọi người qua những khoảng cách xa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"telephone":{"definition":"Dây nói, điện thoại.","example":"Please answer the telephone before it rings again.","exampleTranslation":"Vui lòng trả lời điện thoại trước khi nó rung lần nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"thermostat":{"definition":"Máy điều nhiệt.","example":"The thermostat kept the room comfortable.","exampleTranslation":"Máy điều nhiệt giữ cho căn phòng dễ chịu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"tool":{"definition":"Công cụ; lợi khí; tay sai.","example":"He used a heavy tool to open the box.","exampleTranslation":"Anh ấy đã sử dụng một công cụ nặng để mở hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"transmission":{"definition":"Sự chuyển giao, sự truyền.","example":"The transmission of news happened very quickly.","exampleTranslation":"Sự truyền tin tức đã xảy ra rất nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"transmit":{"definition":"Chuyển giao, truyền.","example":"Please transmit the data to our main office.","exampleTranslation":"Vui lòng chuyển giao dữ liệu đến văn phòng chính của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"trigger":{"definition":"Cò súng.","example":"The soldier had to pull the trigger at once.","exampleTranslation":"Người lính đã phải bóp cò súng ngay lập tức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"tweak":{"definition":"Cái véo, cái vặn.","example":"A small tweak fixed the sound.","exampleTranslation":"Một cái vặn nhỏ đã làm chỉnh lại âm thanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"typewriter":{"definition":"Máy chữ.","example":"The typewriter sat on the desk.","exampleTranslation":"Chiếc máy chữ đặt trên bàn làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"unlock":{"definition":"Mở, mở khoá.","example":"You can unlock the door with this silver key.","exampleTranslation":"Bạn có thể mở khóa cửa bằng chìa khóa bạc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"unmanned":{"definition":"Quá khứ và phân từ quá khứ của unman","example":"The soldier was unmanned by the loud noise.","exampleTranslation":"Người lính đã bị hoảng loạn bởi tiếng ồn lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"update":{"definition":"Bản cập nhật.","example":"Please download the latest update for your phone.","exampleTranslation":"Vui lòng tải xuống bản cập nhật mới nhất cho điện thoại của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"upgrade":{"definition":"Đưa lên cấp bậc cao hơn, nâng cấp.","example":"We need to upgrade the old computer.","exampleTranslation":"Chúng tôi cần nâng cấp chiếc máy tính cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"user":{"definition":"Người dùng, người hay dùng.","example":"Every telephone user should know how to stay safe.","exampleTranslation":"Mỗi người dùng điện thoại nên biết cách để giữ an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"website":{"definition":"Trang web, trang thông tin điện tử.","example":"You can find more information about our services on the official website.","exampleTranslation":"Bạn có thể tìm thấy thêm thông tin về các dịch vụ của chúng tôi trên trang web chính thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"wiki":{"definition":"Loại ứng dụng xây dựng và quản lý các trang thông tin của website đó.","example":"Our team built a wiki for class notes.","exampleTranslation":"Nhóm của chúng tôi đã xây dựng một wiki cho ghi chú của lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"wireless":{"definition":"Đánh điện bằng rađiô.","example":"They will wireless a message to the base.","exampleTranslation":"Họ sẽ đánh điện bằng rađiô một thông điệp về căn cứ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"technology"},"nutrition":{"definition":"Dinh dưỡng; quá trình cơ thể nhận và sử dụng thức ăn.","example":"Good nutrition helps children grow strong.","exampleTranslation":"Dinh dưỡng tốt giúp trẻ em phát triển khỏe mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"prevention":{"definition":"Sự phòng ngừa; hành động ngăn điều xấu xảy ra.","example":"Early prevention is better than late cure.","exampleTranslation":"Phòng ngừa sớm tốt hơn chữa trị khi đã muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"sedentary":{"definition":"Ít vận động; thường ngồi hoặc ở yên một chỗ.","example":"A sedentary lifestyle can lead to health problems.","exampleTranslation":"Lối sống ít vận động có thể dẫn đến các vấn đề sức khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"obesity":{"definition":"Béo phì; tình trạng tích tụ mỡ thừa có thể ảnh hưởng sức khỏe.","example":"Regular exercise and healthy meals can reduce the risk of obesity.","exampleTranslation":"Tập thể dục thường xuyên và ăn uống lành mạnh có thể giảm nguy cơ béo phì.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"health"},"wellbeing":{"definition":"Sức khỏe và trạng thái an lành về thể chất lẫn tinh thần.","example":"Work-life balance is crucial for maintaining physical and mental wellbeing.","exampleTranslation":"Cân bằng công việc và cuộc sống rất quan trọng để duy trì sức khỏe thể chất và tinh thần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"screening":{"definition":"Quá trình kiểm tra một nhóm người để phát hiện sớm bệnh hoặc nguy cơ sức khỏe.","example":"Early screening can detect the condition before symptoms become severe.","exampleTranslation":"Sàng lọc sớm có thể phát hiện tình trạng bệnh trước khi triệu chứng trở nên nghiêm trọng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"health"},"health":{"definition":"Sự lành mạnh.","example":"The garden showed the health of the soil.","exampleTranslation":"Khu vườn cho thấy tình trạng sức khỏe của đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"healthful":{"definition":"Lành mạnh.","example":"Fresh air is healthful for children.","exampleTranslation":"Không khí trong lành rất có lợi cho sức khỏe của trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"healthy":{"definition":"khỏe mạnh; có lợi cho sức khỏe","example":"I need three young, healthy people to help me.","exampleTranslation":"Tôi cần ba người trẻ, khỏe mạnh để giúp tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"health"},"medical":{"definition":"Y, y học.","example":"She wants to study at a medical school.","exampleTranslation":"Cô ấy muốn học tại một trường y.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"medic"},"medicate":{"definition":"Bốc thuốc, cho thuốc.","example":"The nurse medicate the child with care.","exampleTranslation":"Người y tá cẩn thận cho đứa trẻ uống thuốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"medic"},"medication":{"definition":"Sự tẩm thuốc, sự ngâm thuốc.","example":"They used medication to soak the cloth overnight.","exampleTranslation":"Họ đã sử dụng dung dịch thuốc để ngâm vải qua đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"medic"},"disease":{"definition":"Bệnh, bệnh tật.","example":"A cold often grows into a worse disease.","exampleTranslation":"Cảm lạnh thường phát triển thành một căn bệnh tồi tệ hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"disease"},"nutritional":{"definition":"Dinh dưỡng.","example":"This soup is quite nutritional and filling.","exampleTranslation":"Món súp này khá giàu dinh dưỡng và gây no.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"nutrition"},"nutritionist":{"definition":"Nhà nghiên cứu về lĩnh vực dinh dưỡng.","example":"A nutritionist planned her meals for health.","exampleTranslation":"Một chuyên gia dinh dưỡng đã lên kế hoạch cho các bữa ăn để đảm bảo sức khỏe cho cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"nutrition"},"prevent":{"definition":"Đón trước, làm trước, giải quyết trước, chặn trước, đối phó trước.","example":"He tried to prevent her wishes from coming true.","exampleTranslation":"Anh ấy đã cố gắng ngăn cản những mong muốn của cô ấy trở thành hiện thực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"prevent"},"preventable":{"definition":"Có thể ngăn cản, có thể ngăn ngừa, phòng tránh được.","example":"Most delays are preventable with planning.","exampleTranslation":"Hầu hết các sự chậm trễ đều có thể ngăn ngừa được bằng cách lập kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"prevent"},"preventative":{"definition":"Ngăn ngừa, phòng ngừa.","example":"Wear a mask as a preventative measure now.","exampleTranslation":"Hãy đeo khẩu trang như một biện pháp phòng ngừa ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"prevent"},"prevented":{"definition":"Quá khứ và phân từ quá khứ của prevent","example":"The delay prevented a longer wait.","exampleTranslation":"Sự chậm trễ đã ngăn chặn một thời gian chờ đợi lâu hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"prevent"},"preventive":{"definition":"Phòng bệnh.","example":"Regular exercise is an important preventive measure for health.","exampleTranslation":"Tập thể dục thường xuyên là một biện pháp phòng ngừa quan trọng cho sức khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"prevent"},"diagnoses":{"definition":"Động từ chia ở ngôi thứ ba số ít của diagnose","example":"She diagnoses the problem very quickly.","exampleTranslation":"Cô ấy chẩn đoán vấn đề rất nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"diagnos"},"diagnosing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của diagnose.","example":"He is diagnosing the issue with a simple test.","exampleTranslation":"Anh ấy đang chẩn đoán vấn đề bằng một bài kiểm tra đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"diagnos"},"treat":{"definition":"Sự đãi, sự thết đãi.","example":"Please let me give you a treat today.","exampleTranslation":"Hôm nay, hãy để tôi đãi bạn một món nhé.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"treat"},"treatable":{"definition":"Có thể xử lý.","example":"This stain is treatable with the right cleaner.","exampleTranslation":"Vết bẩn này có thể xử lý được bằng chất tẩy rửa phù hợp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"treat"},"treated":{"definition":"Quá khứ và phân từ quá khứ của treat","example":"She treated the cut with clean water.","exampleTranslation":"Cô ấy đã xử lý vết cắt bằng nước sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"treat"},"treater":{"definition":"người điều đình, người thương lượng, người ký kết.","example":"The treater helped both sides reach an agreement.","exampleTranslation":"Người thương lượng đã giúp cả hai bên đạt được thỏa thuận.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"treat"},"treatment":{"definition":"Sự điều trị; phép trị bệnh.","example":"The patient is currently under medical treatment at home.","exampleTranslation":"Bệnh nhân hiện đang được điều trị y tế tại nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"treat"},"treaty":{"definition":"Hiệp ước.","example":"The two countries signed a peace treaty today.","exampleTranslation":"Hai quốc gia đã ký một hiệp ước hòa bình ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"treat"},"therapy":{"definition":"Phép chữa bệnh.","example":"She needed therapy after the long illness.","exampleTranslation":"Cô ấy cần trị liệu sau căn bệnh kéo dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"therapy"},"mental":{"definition":"Trí tuệ, (thuộc) trí óc.","example":"We must develop our mental powers every day.","exampleTranslation":"Chúng ta phải phát triển năng lực trí tuệ của mình mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"mental"},"hospital":{"definition":"Bệnh viện, nhà thương.","example":"He was taken to the hospital.","exampleTranslation":"Anh ấy đã được đưa đến bệnh viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"hospital"},"hospitalisation":{"definition":"Sự đưa vào bệnh viện.","example":"The hospitalisation was useful in class.","exampleTranslation":"Việc nhập viện có ích trong lớp học.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"hospital","spellingNote":"Alternate spelling: hospitalization."},"hospitalise":{"definition":"Đưa vào bệnh viện, nằm bệnh viện.","example":"Doctors hospitalise severe cases after midnight.","exampleTranslation":"Các bác sĩ cho nhập viện những ca nghiêm trọng sau nửa đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"hospital","spellingNote":"Alternate spelling: hospitalize."},"hospitality":{"definition":"lòng hiếu khách; ngành khách sạn","example":"They showed great hospitality by offering food and a place to stay.","exampleTranslation":"Họ thể hiện lòng hiếu khách tuyệt vời bằng cách mời ăn uống và cung cấp chỗ ở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"hospital"},"hospitalization":{"definition":"Sự đưa vào bệnh viện.","example":"His hospitalization lasted only three days.","exampleTranslation":"Việc nhập viện của anh ấy chỉ kéo dài ba ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"hospital","spellingNote":"British spelling: hospitalisation."},"hospitalize":{"definition":"Đưa vào bệnh viện, nằm bệnh viện.","example":"The doctor had to hospitalize him overnight.","exampleTranslation":"Bác sĩ phải cho anh ấy nhập viện qua đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"hospital","spellingNote":"British spelling: hospitalise."},"vaccinate":{"definition":"Chủng, tiêm chủng.","example":"The clinic will vaccinate children against measles before the school year begins.","exampleTranslation":"Phòng khám sẽ tiêm vắc-xin phòng bệnh sởi cho trẻ em trước khi năm học bắt đầu.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"vaccin"},"vaccination":{"definition":"Sự chủng, sự tiêm chủng.","example":"Vaccination protects people from serious diseases.","exampleTranslation":"Tiêm chủng giúp bảo vệ mọi người khỏi các bệnh nguy hiểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"vaccin"},"infect":{"definition":"Nhiễm, làm nhiễm độc, làm nhiễm trùng.","example":"Dirty water can infect a wound.","exampleTranslation":"Nước bẩn có thể làm nhiễm trùng vết thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"infect"},"infection":{"definition":"Sự tiêm nhiễm, sự đầu độc.","example":"The bad rumor caused an infection of fear.","exampleTranslation":"Tin đồn xấu đã gây ra một sự lan truyền nỗi sợ hãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"infect"},"infectious":{"definition":"Lây, nhiễm.","example":"The disease is infectious and spreads fast.","exampleTranslation":"Căn bệnh này có tính truyền nhiễm và lây lan nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"infect"},"infective":{"definition":"Lây, nhiễm.","example":"The child had an infective cough.","exampleTranslation":"Đứa trẻ bị ho có khả năng truyền nhiễm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"infect"},"symptom":{"definition":"Triệu chứng.","example":"A cough can be a symptom of flu.","exampleTranslation":"Ho có thể là một triệu chứng của bệnh cúm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"symptom"},"fitness":{"definition":"Sự thích hợp, sự phù hợp, sự vừa vặn; sự xứng dáng.","example":"The jacket has the fitness for winter.","exampleTranslation":"Chiếc áo khoác này rất phù hợp cho mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"fitness"},"exercise":{"definition":"Thực thi hoặc sử dụng (quyền, quyền lực hay trách nhiệm).","example":"You may exercise your right to speak freely.","exampleTranslation":"Bạn có thể thực hiện quyền tự do ngôn luận của mình.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"exercise"},"wellness":{"definition":"Sức khỏe, tình trạng khoẻ mạnh","example":"The program focuses on wellness.","exampleTranslation":"Chương trình tập trung vào việc chăm sóc sức khỏe toàn diện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"n","posGroup":"noun","family":"wellness"},"patient":{"definition":"Kiên nhẫn, nhẫn nại, bền chí, kiên trì.","example":"You must be patient while waiting for the bus.","exampleTranslation":"Bạn phải kiên nhẫn khi chờ xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"patient"},"clinic":{"definition":"Sự lên lớp ở buồng bệnh, sự thực hành ở buồng bệnh.","example":"The doctor gave a clinic on wound care.","exampleTranslation":"Bác sĩ đã tổ chức một buổi chuyên đề về chăm sóc vết thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"clinic"},"clinical":{"definition":"Buồng bệnh, ở buồng bệnh, (thuộc) lâm sàng.","example":"The students attended several clinical lectures this week.","exampleTranslation":"Các sinh viên đã tham dự vài buổi giảng lâm sàng trong tuần này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"clinic"},"surgery":{"definition":"Khoa phẫu thuật.","example":"She decided to have plastic surgery for her nose.","exampleTranslation":"Cô ấy quyết định thực hiện phẫu thuật thẩm mỹ cho mũi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"surgery"},"psychological":{"definition":"Tâm lý.","example":"Stress can have a negative psychological effect on kids.","exampleTranslation":"Căng thẳng có thể gây ra ảnh hưởng tâm lý tiêu cực lên trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psycholog"},"psychologise":{"definition":"Giải thích hoặc phân tích một vấn đề theo góc độ tâm lý.","example":"Some researchers psychologise social problems instead of examining their economic causes.","exampleTranslation":"Một số nhà nghiên cứu lý giải các vấn đề xã hội bằng tâm lý thay vì xem xét nguyên nhân kinh tế.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"psycholog","spellingNote":"Alternate spelling: psychologize."},"psychologist":{"definition":"Nhà tâm lý học.","example":"The psychologist helped her handle worry.","exampleTranslation":"Nhà tâm lý học đã giúp cô ấy vượt qua nỗi lo âu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psycholog"},"psychologize":{"definition":"Nghiên cứu tâm lý.","example":"They psychologize his fear after the loss.","exampleTranslation":"Họ phân tích tâm lý nỗi sợ của anh ấy sau sự mất mát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psycholog","spellingNote":"British spelling: psychologise."},"psychology":{"definition":"Khái luận về tâm lý; hệ tâm lý.","example":"The team's psychology changed after the win.","exampleTranslation":"Tâm lý của cả đội đã thay đổi sau chiến thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psycholog"},"chronic":{"definition":"Ăn sâu, bám chặt, thâm căn cố đế; thành thói quen.","example":"They have chronic doubts about the new plan.","exampleTranslation":"Họ có những nghi ngờ kéo dài về kế hoạch mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"chronic"},"abdominal":{"definition":"Bụng; ở bụng.","example":"The doctor performed an abdominal operation on him.","exampleTranslation":"Bác sĩ đã thực hiện một ca phẫu thuật bụng cho anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"abnormal":{"definition":"Không bình thường, khác thường; dị thường.","example":"A fever made his test result abnormal.","exampleTranslation":"Một cơn sốt đã làm cho kết quả kiểm tra của anh ấy trở nên bất thường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"adrenalin":{"definition":"Adrenalin.","example":"Adrenalin made her heart race.","exampleTranslation":"Adrenalin làm tim cô ấy đập nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"aerobic":{"definition":"Đói không khí, thiếu không khí.","example":"The runner felt aerobic stress at the top hill.","exampleTranslation":"Vận động viên cảm thấy căng thẳng vì đói không khí tại đỉnh đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"aggravate":{"definition":"Làm trầm trọng thêm, làm nặng thêm, làm nguy ngập thêm, làm xấu thêm.","example":"Do not aggravate the situation with your angry words.","exampleTranslation":"Đừng làm trầm trọng thêm tình hình bằng những lời lẽ giận dữ của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"ailment":{"definition":"Sự đau đớn, sự phiền não, sự lo lắng.","example":"A minor ailment kept her home for a day.","exampleTranslation":"Một sự phiền não nhỏ khiến cô ấy ở nhà một ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"alcohol":{"definition":"Rượu cồn.","example":"Do not drink too much alcohol before driving home.","exampleTranslation":"Đừng uống quá nhiều rượu trước khi lái xe về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"antibiotic":{"definition":"Thuốc kháng sinh, thuốc trụ sinh.","example":"The doctor prescribed an antibiotic for my infection.","exampleTranslation":"Bác sĩ đã kê đơn thuốc kháng sinh cho tình trạng nhiễm trùng của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"antiseptic":{"definition":"Khử trùng.","example":"Keep the wound antiseptic and clean.","exampleTranslation":"Hãy giữ vết thương khử trùng và sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"anxiety":{"definition":"lo âu, căng thẳng","example":"The thought of going to the dentist filled him with anxiety.","exampleTranslation":"Suy nghĩ về việc đi nha sĩ lấp đầy anh ấy với sự lo âu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"health"},"anxious":{"definition":"Áy náy, lo âu, lo lắng, băn khoăn.","example":"I am anxious about my final exam results.","exampleTranslation":"Tôi đang lo âu về kết quả kỳ thi cuối kỳ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"aphasic":{"definition":"(thuộc) chứng mất ngôn ngữ.","example":"The aphasic patient used gestures to communicate.","exampleTranslation":"Bệnh nhân bị chứng mất ngôn ngữ đã sử dụng cử chỉ để giao tiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"audiologist":{"definition":"Nhà thính học.","example":"The audiologist tested her hearing in silence.","exampleTranslation":"Nhà thính học đã kiểm tra thính giác của cô ấy trong sự im lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"auditory":{"definition":"Sự nghe; (thuộc) thính giác.","example":"The auditory nerves help us hear sounds clearly.","exampleTranslation":"Các dây thính giác giúp chúng ta nghe âm thanh rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"autism":{"definition":"Tính tự kỷ, bệnh tự kỷ.","example":"The doctor explained autism with care and patience.","exampleTranslation":"Bác sĩ đã giải thích về bệnh tự kỷ với sự quan tâm và kiên nhẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"balm":{"definition":"Niềm an ủi.","example":"Her kind words were a balm to him.","exampleTranslation":"Những lời tử tế của cô ấy là niềm an ủi đối với anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"bathe":{"definition":"Sự tắm (ở hồ, sông, biển, bể bơi).","example":"We went to the lake for a quick bathe.","exampleTranslation":"Chúng tôi đến hồ để tắm một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"belly":{"definition":"Bụng; dạ dày.","example":"The hungry child had an empty belly all day.","exampleTranslation":"Đứa trẻ đói bụng đã phải chịu cảnh trống rỗng ở dạ dày suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"beneficial":{"definition":"Có ích; có lợi; tốt.","example":"Fresh air is beneficial for children.","exampleTranslation":"Không khí trong lành có ích cho trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"benign":{"definition":"Lành; tốt; nhân từ.","example":"She gave a benign smile to the child.","exampleTranslation":"Cô ấy đã trao một nụ cười nhân từ cho đứa trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"bite":{"definition":"Sự cắn, sự ngoạm; miếng cắn; vết cắn.","example":"The dog gave my hand a small bite.","exampleTranslation":"Con chó đã ngoạm một miếng nhỏ vào tay tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"blind":{"definition":"Đui mù.","example":"He was born blind in his left eye.","exampleTranslation":"Anh ấy sinh ra đã bị đui mù mắt trái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"bout":{"definition":"Lần, lượt, đợi.","example":"They had a bout of fighting in the street.","exampleTranslation":"Họ đã có một lần ẩu đả trên phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"breathe":{"definition":"Thốt ra, nói lộ ra.","example":"You must not breathe a word about it.","exampleTranslation":"Bạn không được phép thốt ra một lời nào về việc đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"caffeine":{"definition":"Cafêin.","example":"Too much caffeine kept him awake all night.","exampleTranslation":"Quá nhiều cafêin khiến anh ấy thức suốt đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"calcium":{"definition":"Canxi.","example":"Milk is a good source of calcium.","exampleTranslation":"Sữa là một nguồn canxi tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"calory":{"definition":"Calo.","example":"They discussed the calory today.","exampleTranslation":"Họ đã thảo luận về calo ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"cancer":{"definition":"Bệnh ung thư.","example":"The doctor said he survived cancer last year.","exampleTranslation":"Bác sĩ nói anh ấy đã sống sót sau bệnh ung thư năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"canker":{"definition":"Bệnh viêm loét miệng.","example":"The sore in her mouth was a canker.","exampleTranslation":"Vết loét trong miệng cô ấy là một bệnh viêm loét miệng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"chemotherapy":{"definition":"Phép chữa hoá học.","example":"She started chemotherapy last week.","exampleTranslation":"Cô ấy đã bắt đầu trị liệu hóa học từ tuần trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"chew":{"definition":"Sự nhai.","example":"He took a chew at the piece of meat.","exampleTranslation":"Anh ấy cắn nhai miếng thịt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"childbirth":{"definition":"Sự sinh đẻ.","example":"Childbirth can be tiring and joyful.","exampleTranslation":"Việc sinh đẻ có thể rất mệt mỏi nhưng cũng đầy niềm vui.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"chill":{"definition":"Sự ớn lạnh, sự rùng mình (vì lạnh).","example":"He felt a sudden chill in the room.","exampleTranslation":"Anh ấy cảm thấy một luồng ớn lạnh đột ngột trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"choke":{"definition":"Chỗ thắt lại, chỗ co lại, chỗ bóp lại.","example":"There is a choke near the bottle neck.","exampleTranslation":"Có một chỗ thắt lại gần cổ chai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"cigarette":{"definition":"Điếu thuốc lá.","example":"He dropped his cigarette in the ashtray.","exampleTranslation":"Anh ấy đã vứt điếu thuốc lá vào gạt tàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"complication":{"definition":"Sự phức tạp, sự rắc rối.","example":"The complication made the task much slower.","exampleTranslation":"Sự phức tạp đã làm cho nhiệm vụ chậm hơn rất nhiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"constriction":{"definition":"Sự thắt, sự siết, sự co khít.","example":"The pipe had a constriction near the end.","exampleTranslation":"Đường ống có một chỗ thắt lại gần đầu kia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"contagious":{"definition":"Lây ((nghĩa đen) & (nghĩa bóng)).","example":"Please wash your hands to avoid contagious diseases.","exampleTranslation":"Vui lòng rửa tay để tránh các bệnh lây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"cure":{"definition":"Thuốc, phương thuốc.","example":"Is there a good cure for this cold?","exampleTranslation":"Có phương thuốc nào tốt cho cơn cảm lạnh này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"danger":{"definition":"Sự nguy hiểm, mối hiểm nghèo.","example":"You are in danger if you go alone now.","exampleTranslation":"Bạn đang gặp nguy hiểm nếu bạn đi một mình bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"dangerous":{"definition":"Nham hiểm, lợi hại, dữ tợn.","example":"It is dangerous to walk alone at night.","exampleTranslation":"Đi bộ một mình vào ban đêm rất nham hiểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"deadly":{"definition":"Làm chết người, trí mạng, chí tử.","example":"Be careful of that deadly poison in the garden.","exampleTranslation":"Hãy cẩn thận với chất độc làm chết người đó trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"death":{"definition":"Sự tiêu tan, sự tan vỡ, sự kết liễu, sự chấm dứt.","example":"The failure brought the death of his hopes.","exampleTranslation":"Sự thất bại đã mang đến sự tan vỡ những hy vọng của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"deficiency":{"definition":"Số tiền thiếu hụt; lượng thiếu hụt.","example":"The company had to make up a deficiency.","exampleTranslation":"Công ty phải bù đắp một số tiền thiếu hụt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"dehydration":{"definition":"Sự khử nước, sự loại nước.","example":"Heat and exercise can cause dehydration quickly.","exampleTranslation":"Nhiệt độ và tập thể dục có thể gây ra sự khử nước nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"dental":{"definition":"(Thuộc) răng.","example":"She had to go for some dental work today.","exampleTranslation":"Cô ấy phải đi làm công việc nha khoa hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"detoxify":{"definition":"Giải độc.","example":"Doctors work to detoxify the body after illness.","exampleTranslation":"Bác sĩ làm việc để giải độc cơ thể sau cơn bệnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"diabetes":{"definition":"Bệnh tiểu đường, bệnh đái đường.","example":"She manages her diabetes with careful meals.","exampleTranslation":"Cô ấy quản lý bệnh tiểu đường với các bữa ăn cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"diagnose":{"definition":"Chẩn đoán (bệnh).","example":"The doctor will diagnose the rash tomorrow.","exampleTranslation":"Bác sĩ sẽ chẩn đoán phát ban vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"diagnosis":{"definition":"Phép chẩn đoán; sự chẩn đoán; lời chẩn đoán.","example":"The doctor gave a clear diagnosis.","exampleTranslation":"Bác sĩ đã đưa ra một lời chẩn đoán rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"diagnostic":{"definition":"Số nhiều phép chẩn đoán; chẩn đoán học.","example":"The doctor ordered an X-ray diagnostic for the patient.","exampleTranslation":"Bác sĩ đã yêu cầu một phép chẩn đoán X-quang cho bệnh nhân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"dietician":{"definition":"Thầy thuốc chuyên khoa ăn uống.","example":"A dietician helped him plan healthier meals.","exampleTranslation":"Thầy thuốc chuyên khoa ăn uống đã giúp anh ấy lên kế hoạch các bữa ăn lành mạnh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"digestive":{"definition":"Giúp cho dễ tiêu.","example":"Mint tea is digestive after a heavy lunch.","exampleTranslation":"Trà bạc hà giúp cho dễ tiêu sau một bữa trưa nặng nề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"disability":{"definition":"Sự bất tài, sự bất lực.","example":"The disability was useful in class.","exampleTranslation":"Sự bất tài đó lại hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"disable":{"definition":"Làm cho bất lực, làm cho không đủ năng lực (làm gì).","example":"The accident may disable the old machine.","exampleTranslation":"Tai nạn có thể làm cho cỗ máy cũ đó không thể hoạt động được nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"disorder":{"definition":"Làm mất trật tự, làm bừa bãi, làm lộn xộn.","example":"Do not disorder the files on my desk.","exampleTranslation":"Đừng làm lộn xộn các tệp tin trên bàn của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"dispense":{"definition":"Làm (lễ).","example":"The priest will dispense the holy sacraments tonight.","exampleTranslation":"Vị linh mục sẽ làm lễ các bí tích thánh đêm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"dispenser":{"definition":"Nhà bào chế, người pha chế thuốc (theo đơn).","example":"The dispenser filled each bottle with medicine.","exampleTranslation":"Người pha chế thuốc đã đổ đầy thuốc vào từng chai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"doctor":{"definition":"Bác sĩ y khoa.","example":"The doctor checked my fever and listened carefully.","exampleTranslation":"Vị bác sĩ đã kiểm tra cơn sốt của tôi và lắng nghe cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"dose":{"definition":"Liều lượng, liều thuốc.","example":"Take one dose of this medicine every day.","exampleTranslation":"Hãy uống một liều thuốc này mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"drool":{"definition":"Nước dãi, mũi dãi.","example":"There was drool on the baby's chin.","exampleTranslation":"Có nước dãi trên cằm của em bé.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"drown":{"definition":"Chết đuối.","example":"Without a jacket, you could drown in that river.","exampleTranslation":"Nếu không có áo phao, bạn có thể bị chết đuối trong dòng sông đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"drug":{"definition":"Thuốc, dược phẩm.","example":"The drug played a key role.","exampleTranslation":"Loại thuốc đó đóng vai trò then chốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"ears":{"definition":"Động từ chia ở ngôi thứ ba số ít của ear","example":"He ears the music through his headphones.","exampleTranslation":"Anh ấy nghe nhạc qua tai nghe của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"exhaust":{"definition":"Sự rút khí, sự thoát khí.","example":"The exhaust from the machine filled the room.","exampleTranslation":"Khí thoát từ máy đã làm đầy căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"eyebrow":{"definition":"Lông mày.","example":"A small scar sat above her left eyebrow.","exampleTranslation":"Một vết sẹo nhỏ nằm trên lông mày trái của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"eyelid":{"definition":"Mi mắt.","example":"A speck of dust hit my eyelid.","exampleTranslation":"Một hạt bụi nhỏ đã bay vào mi mắt của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"eyes":{"definition":"Động từ chia ở ngôi thứ ba số ít của eye","example":"He eyes the cake from across the table.","exampleTranslation":"Anh ấy nhìn chăm chú cái bánh từ bên kia bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"facial":{"definition":"Sự xoa bóp mặt.","example":"She booked a facial for Saturday.","exampleTranslation":"Cô ấy đã đặt một suất xoa bóp mặt cho thứ Bảy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"faint":{"definition":"Yếu ớt.","example":"I heard a faint sound in the hallway.","exampleTranslation":"Tôi đã nghe một âm thanh yếu ớt ở ngoài hành lang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"fatty":{"definition":"Béo; như mỡ; có nhiều mỡ.","example":"You should avoid eating too much fatty food.","exampleTranslation":"Bạn nên tránh ăn quá nhiều thực phẩm béo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"feces":{"definition":"Cặn, chất lắng.","example":"The river left dark feces on the rocks.","exampleTranslation":"Con sông để lại cặn tối trên các tảng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"fever":{"definition":"Sự xúc động, sự bồn chồn.","example":"She was in a fever of anxiety all night.","exampleTranslation":"Cô ấy đã ở trong một sự xúc động bồn chồn suốt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"finger":{"definition":"Ngón tay.","example":"She raised one finger to ask a question.","exampleTranslation":"Cô ấy giơ một ngón tay lên để đặt một câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"flex":{"definition":"Làm cong, uốn cong.","example":"You can flex the wire into a circle.","exampleTranslation":"Bạn có thể uốn cong dây thép thành một vòng tròn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"forefinger":{"definition":"Ngón tay trỏ.","example":"Point with your forefinger, not your thumb.","exampleTranslation":"Chỉ bằng ngón tay trỏ, đừng dùng ngón cái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"forehead":{"definition":"Trán.","example":"He hit his forehead on the door.","exampleTranslation":"Anh ấy đập trán vào cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"frail":{"definition":"Tạm bợ, mỏng manh.","example":"She lived a frail life in the old house.","exampleTranslation":"Cô ấy sống một cuộc sống tạm bợ trong ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"gait":{"definition":"Dáng đi.","example":"The old man had a very slow gait.","exampleTranslation":"Ông lão có dáng đi rất chậm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"gravel":{"definition":"Bệnh sỏi thận.","example":"The doctor said he has a case of gravel.","exampleTranslation":"Bác sĩ nói anh ấy mắc bệnh sỏi thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"gums":{"definition":"Động từ chia ở ngôi thứ ba số ít của gum","example":"The sticky paste gums the wheels.","exampleTranslation":"Hỗn hợp dính này làm kẹt các bánh xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"hair":{"definition":"Tóc, lông (người, thú, cây... ); bộ lông (thú).","example":"She spends a lot of time on her hair.","exampleTranslation":"Cô ấy dành rất nhiều thời gian cho bộ tóc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"hangover":{"definition":"Dư vị khó chịu do dùng thức uống có nồng độ cồn cao.","example":"He had a headache after a long hangover.","exampleTranslation":"Anh ấy bị đau đầu sau một cơn dư vị khó chịu dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"harm":{"definition":"Hại, tai hại, tổn hao, thiệt hại.","example":"His actions caused serious harm to the local environment.","exampleTranslation":"Hành động của anh ta gây ra thiệt hại nghiêm trọng cho môi trường địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"harmful":{"definition":"Gây tai hại, có hại.","example":"Too much sugar can be harmful.","exampleTranslation":"Quá nhiều đường có thể gây hại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"headache":{"definition":"Chứng nhức đầu.","example":"I have a terrible headache from working all night.","exampleTranslation":"Tôi bị chứng nhức đầu khủng khiếp vì làm việc suốt đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"heal":{"definition":"Chữa khỏi (bệnh... ), làm lành (vết thương... ).","example":"Time will help heal your broken heart soon.","exampleTranslation":"Thời gian sẽ giúp chữa khỏi trái tim tan vỡ của bạn sớm thôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"hiccup":{"definition":"Vừa nói vừa nấc.","example":"The child started to hiccup after laughing.","exampleTranslation":"Đứa trẻ bắt đầu vừa nói vừa nấc sau khi cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"hunger":{"definition":"Đói, cảm thấy đói.","example":"I hunger for a warm meal after school.","exampleTranslation":"Tôi đói một bữa ăn ấm nóng sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"hungry":{"definition":"Làm cho thấy đói, gợi thèm (ăn).","example":"The advertisement created a hungry air for the food.","exampleTranslation":"Quảng cáo đã tạo ra một cảm giác gợi thèm cho thức ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"hydrate":{"definition":"Hydrat.","example":"The crystal is a hydrate.","exampleTranslation":"Tinh thể đó là một hydrat.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"hygienic":{"definition":"Vệ sinh, hợp vệ sinh.","example":"Please ensure that all kitchen surfaces are hygienic.","exampleTranslation":"Vui lòng đảm bảo rằng tất cả các bề mặt bếp đều hợp vệ sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"hygienist":{"definition":"Vệ sinh viên.","example":"A hygienist checked the school's food safety rules.","exampleTranslation":"Một vệ sinh viên đã kiểm tra các quy tắc an toàn thực phẩm của trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"hypodermic":{"definition":"Mũi tiêm dưới da.","example":"The nurse prepared a hypodermic for the shot.","exampleTranslation":"Y tá đã chuẩn bị một ống tiêm cho mũi tiêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"impairment":{"definition":"Sự làm suy yếu, sự làm sút kém; sự suy yếu, sự sút kém.","example":"The injury caused some memory impairment.","exampleTranslation":"Chấn thương đã gây ra một số sự suy yếu về trí nhớ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"indigestible":{"definition":"khó tiêu hoá; không thể tiêu hoá.","example":"This meat is indigestible for some people.","exampleTranslation":"Thịt này là khó tiêu hoá đối với một số người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"inflammation":{"definition":"Sự đốt cháy; sự bốc cháy.","example":"The skin showed signs of inflammation.","exampleTranslation":"Làn da cho thấy các dấu hiệu của sự đốt cháy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"inhale":{"definition":"Hít vào.","example":"Breathe in slowly and inhale the clean air.","exampleTranslation":"Hít vào từ từ và hít không khí sạch vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"inject":{"definition":"Của injection (trong đơn thuốc).","example":"The doctor wrote one inject on the form.","exampleTranslation":"Bác sĩ đã viết một mũi tiêm trong đơn thuốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"injury":{"definition":"Sự xúc phạm, sự vi phạm quyền lợi; sự đối xử bất công.","example":"The unfair rule caused real injury to workers.","exampleTranslation":"Quy tắc không công bằng đã gây ra sự xúc phạm thực sự cho công nhân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"insulin":{"definition":"Isulin.","example":"She takes insulin before each meal.","exampleTranslation":"Cô ấy dùng Insulin trước mỗi bữa ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"intestine":{"definition":"Ruột.","example":"The small intestine is part of the digestive system.","exampleTranslation":"Ruột non là một phần của hệ tiêu hóa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"knee":{"definition":"Đầu gối.","example":"The water reached up to my knee in the pool.","exampleTranslation":"Nước trong hồ dâng lên tới đầu gối tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"lethal":{"definition":"Làm chết người, gây chết người, chết người.","example":"The snake has a lethal venom.","exampleTranslation":"Con rắn có nọc độc làm chết người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"lighten":{"definition":"Chiếu sáng, rọi sáng, soi sáng.","example":"The lamp will lighten this dark corner.","exampleTranslation":"Chiếc đèn sẽ chiếu sáng góc tối này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"liver":{"definition":"Người sống.","example":"He is a liver in this big city.","exampleTranslation":"Anh ấy là một người sống ở thành phố lớn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"lotion":{"definition":"Nước thơm (để gội đầu, để tắm).","example":"She bought lotion for her dry hands.","exampleTranslation":"Cô ấy mua nước thơm cho đôi bàn tay khô của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"lung":{"definition":"Nơi thoáng đãng (ở trong hoặc gần thành phố).","example":"The park is a lung of the city.","exampleTranslation":"Công viên là nơi thoáng đãng của thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"malaria":{"definition":"Bệnh sốt rét.","example":"Mosquitoes can spread malaria in warm areas.","exampleTranslation":"Muỗi có thể truyền bệnh sốt rét ở những khu vực ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"malnutrition":{"definition":"Sự kém dinh dưỡng, sự thiếu ăn.","example":"Poor diet can lead to malnutrition.","exampleTranslation":"Chế độ ăn kém có thể dẫn đến sự kém dinh dưỡng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"massage":{"definition":"Xoa bóp.","example":"He can massage the knot out of my back.","exampleTranslation":"Anh ấy có thể xoa bóp chỗ đau trên lưng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"mealy":{"definition":"Xanh xao, tái nhợt, trắng bệch (da).","example":"She looked pale and had a mealy complexion.","exampleTranslation":"Cô ấy trông xanh xao và có làn da trắng bệch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"medicinal":{"definition":"Thuốc; dùng làm thuốc.","example":"These medicinal herbs can help soothe your cough.","exampleTranslation":"Những loại thảo dược dùng làm thuốc này có thể giúp làm dịu cơn ho của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"medicine":{"definition":"y học, y khoa","example":"Medicine can help reduce fever and pain.","exampleTranslation":"Thuốc có thể giúp giảm sốt và đau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"menstruate":{"definition":"Thấy kinh.","example":"She may menstruate earlier after stress or illness.","exampleTranslation":"Cô ấy có thể thấy kinh sớm hơn sau khi căng thẳng hoặc ốm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"migraine":{"definition":"Chứng đau nửa đầu.","example":"His migraine kept him in bed all day.","exampleTranslation":"Chứng đau nửa đầu khiến anh ấy nằm trên giường cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"nausea":{"definition":"Sự buồn nôn; sự lộn mửa.","example":"I felt nausea after the long bus ride.","exampleTranslation":"Tôi cảm thấy buồn nôn sau chuyến xe buýt dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"neuro":{"definition":"(đếm được, không chính thức) Bác sĩ thần kinh.","example":"My neuro explained the scan results clearly.","exampleTranslation":"Bác sĩ thần kinh của tôi đã giải thích kết quả chụp quét một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"neurological":{"definition":"Thần kinh, (thuộc) hệ thần kinh.","example":"The doctor studied neurological problems.","exampleTranslation":"Bác sĩ đã nghiên cứu các vấn đề thần kinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"neurologist":{"definition":"Thầy thuốc chuyên khoa thần kinh.","example":"The neurologist explained the cause of his headaches.","exampleTranslation":"Thầy thuốc chuyên khoa thần kinh đã giải thích nguyên nhân gây ra những cơn đau đầu của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"neurology":{"definition":"Khoa thần kinh, thần kinh học.","example":"She studied neurology at the medical school.","exampleTranslation":"Cô ấy đã học khoa thần kinh tại trường y.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"neuroscience":{"definition":"Thần kinh học","example":"She studies neuroscience at the university.","exampleTranslation":"Cô ấy nghiên cứu thần kinh học tại trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"neuroses":{"definition":"Chứng loạn thần kinh chức năng.","example":"Many people struggle with neuroses under stress.","exampleTranslation":"Nhiều người phải vật lộn với chứng loạn thần kinh chức năng khi bị áp lực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"niacin":{"definition":"Y niaxin.","example":"The doctor said niacin can help your diet.","exampleTranslation":"Bác sĩ nói y niaxin có thể giúp chế độ ăn uống của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"nutritious":{"definition":"Bổ, có chất bổ; dinh dưỡng.","example":"She packed a nutritious lunch for school.","exampleTranslation":"Cô ấy đã đóng gói một bữa trưa bổ dưỡng cho trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"obese":{"definition":"Béo phị, trệ.","example":"The obese cat moved very slowly.","exampleTranslation":"Con mèo béo phị di chuyển rất chậm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"ointment":{"definition":"Thuốc mỡ.","example":"Apply the ointment twice a day.","exampleTranslation":"Thoa thuốc mỡ hai lần một ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"opium":{"definition":"Thuốc phiện.","example":"Opium can harm health and thinking.","exampleTranslation":"Thuốc phiện có thể gây hại cho sức khỏe và tư duy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"oral":{"definition":"Bằng lời nói, nói miệng.","example":"The test includes an oral interview.","exampleTranslation":"Bài kiểm tra bao gồm một cuộc phỏng vấn bằng lời nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"outbreak":{"definition":"Sự phun lửa (núi lửa).","example":"The volcano had a sudden outbreak of smoke.","exampleTranslation":"Núi lửa có một sự phun lửa khói đột ngột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"overdose":{"definition":"Liều quá mức.","example":"Too much medicine can cause an overdose.","exampleTranslation":"Quá nhiều thuốc có thể gây ra liều quá mức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"overweight":{"definition":"Trọng lượng trội ((nghĩa đen) & (nghĩa bóng)).","example":"The bag had too much overweight for the scale.","exampleTranslation":"Chiếc túi đã quá nặng so với cái cân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"pain":{"definition":"Sự đau đớn, sự đau khổ (thể chất, tinh thần).","example":"I feel a sharp pain in my shoulder.","exampleTranslation":"Tôi cảm thấy một cơn đau nhói ở vai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"painful":{"definition":"Vất vả, khó nhọc, mất nhiều công sức.","example":"This painful job took all morning to finish.","exampleTranslation":"Công việc vất vả này đã tốn cả buổi sáng để hoàn thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"paralysis":{"definition":"Chứng liệt.","example":"The injury caused paralysis in his left leg.","exampleTranslation":"Chấn thương đã gây ra chứng liệt ở chân trái của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"paralyze":{"definition":"Làm tê liệt, làm đờ ra.","example":"Fear can paralyze a person during a test.","exampleTranslation":"Sự sợ hãi có thể làm một người tê liệt trong suốt bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"pathology":{"definition":"Bệnh học; bệnh lý.","example":"She chose pathology as her main field of study.","exampleTranslation":"Cô ấy đã chọn bệnh học làm lĩnh vực nghiên cứu chính của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"perspiration":{"definition":"Sự đổ mồ hôi.","example":"He began to break into perspiration during the race.","exampleTranslation":"Anh ấy bắt đầu đổ mồ hôi trong suốt cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"perspire":{"definition":"Toát (nước... ) ra (như mồ hôi).","example":"Water began to perspire through the warm glass.","exampleTranslation":"Nước bắt đầu toát qua lớp kính ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"pharmacist":{"definition":"Dược sĩ; người buôn dược phẩm.","example":"The pharmacist prepared my medicine quickly.","exampleTranslation":"Dược sĩ đã chuẩn bị thuốc cho tôi một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"physician":{"definition":"Thầy thuốc.","example":"The physician examined my sore throat.","exampleTranslation":"Thầy thuốc đã khám cổ họng bị đau của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"pill":{"definition":"Điều cay đắng, điều tủi nhục, điều sỉ nhục.","example":"Losing his job was a bitter pill to swallow.","exampleTranslation":"Mất việc làm là một điều cay đắng phải nuốt trôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"plague":{"definition":"Bệnh dịch.","example":"People feared the plague during the middle ages.","exampleTranslation":"Mọi người từng sợ hãi bệnh dịch trong thời trung cổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"plaque":{"definition":"Thẻ, bài (bằng ngà... ghi chức tước... ).","example":"He wore a small plaque with his name.","exampleTranslation":"Anh ấy đeo một tấm thẻ nhỏ ghi tên mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"poison":{"definition":"Chất độc, thuốc độc.","example":"The snake's bite contains a deadly poison.","exampleTranslation":"Vết cắn của con rắn chứa một chất độc chết người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"poisoner":{"definition":"Kẻ đầu độc.","example":"The poisoner was arrested before dawn.","exampleTranslation":"Kẻ đầu độc đã bị bắt trước bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"poisonous":{"definition":"Độc, có chất độc.","example":"This mushroom is poisonous and unsafe.","exampleTranslation":"Loại nấm này có chất độc và không an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"posture":{"definition":"Tình thế, tình hình.","example":"We must consider the present posture of affairs.","exampleTranslation":"Chúng ta phải xem xét tình thế hiện tại của công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"precautionary":{"definition":"Để phòng ngừa, để đề phòng; giữ gìn thận trọng.","example":"You should take precautionary measures before your trip.","exampleTranslation":"Bạn nên thực hiện các biện pháp đề phòng trước chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"pregnancy":{"definition":"Sự phong phú, sự dồi dào, sự giàu (trí tưởng tượng... ).","example":"The writer showed pregnancy of ideas in every chapter.","exampleTranslation":"Tác giả đã thể hiện sự phong phú về ý tưởng trong mỗi chương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"pregnant":{"definition":"Giàu trí tưởng tượng, giàu trí sáng tạo, dồi dào tư tưởng ý tứ.","example":"He had a pregnant mind and many fresh ideas.","exampleTranslation":"Anh ấy có một trí tuệ phong phú và nhiều ý tưởng mới mẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"prenatal":{"definition":"Trước khi sinh.","example":"Prenatal care helps mothers stay healthy.","exampleTranslation":"Chăm sóc tiền sản giúp các bà mẹ giữ sức khỏe tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"prescribe":{"definition":"Ra lệnh, truyền lệnh, sai khiến, bắt phải.","example":"The doctor will prescribe some medicine for your cough.","exampleTranslation":"Bác sĩ sẽ kê một ít thuốc cho cơn ho của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"prescription":{"definition":"Sự ra lệnh, sự truyền lệnh, sự sai khiến.","example":"The doctor wrote a prescription for her cough.","exampleTranslation":"Bác sĩ đã viết đơn thuốc cho cơn ho của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"prone":{"definition":"Úp, sấp; nằm sóng soài.","example":"The athlete fell prone on the grass field.","exampleTranslation":"Vận động viên ngã sấp trên sân cỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"protein":{"definition":"Protein.","example":"Eggs are a good source of protein.","exampleTranslation":"Trứng là một nguồn cung cấp protein tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"psychiatrist":{"definition":"Thầy thuốc bệnh tinh thần, thầy thuốc bệnh tâm thần.","example":"The psychiatrist explained his mood changes kindly.","exampleTranslation":"Bác sĩ tâm thần","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"psychiatry":{"definition":"Bệnh học tinh thần, bệnh học tâm thần.","example":"She wants to study psychiatry in college.","exampleTranslation":"Cô ấy muốn học ngành tâm thần học ở đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"recover":{"definition":"Lấy lại, giành lại, tìm lại được.","example":"He tried hard to recover what was lost in fire.","exampleTranslation":"Anh ấy đã cố gắng hết sức để khôi phục những gì đã mất trong vụ hỏa hoạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"recoverable":{"definition":"Có thể lấy lại, có thể giành lại, có thể tìm lại.","example":"The lost key was recoverable after the move.","exampleTranslation":"Có thể giành lại","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"recovery":{"definition":"Sự đòi lại được (món nợ... ).","example":"The company asked for recovery of the debt.","exampleTranslation":"Sự đòi lại được","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"regimen":{"definition":"Chế độ, chính thể.","example":"The country changed its regimen after the vote.","exampleTranslation":"Đất nước đã thay đổi chế độ của mình sau cuộc bỏ phiếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"rehabilitate":{"definition":"Sắp xếp lại bậc (cho công nhân... ).","example":"The company will rehabilitate staff into new roles.","exampleTranslation":"Sắp xếp lại bậc","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"relief":{"definition":"Sự giảm nhẹ, sự bớt đi, sự làm khuây (đau đớn, buồn rầu).","example":"This new medicine gives relief from chronic pain.","exampleTranslation":"Loại thuốc mới này giúp giảm đau mãn tính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"relieve":{"definition":"Làm an tâm, làm yên lòng, làm dịu, làm khuây khoả, an ủi.","example":"Good news will always relieve your heavy heart.","exampleTranslation":"Tin tốt sẽ luôn làm vơi đi trái tim nặng nề của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"reliever":{"definition":"Người cứu tế, người cứu viện, người cứu trợ.","example":"The reliever arrived to help the tired team.","exampleTranslation":"Người thay thế đã đến để giúp đỡ đội đang mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"remedy":{"definition":"Sự đền bù; sự bồi thường.","example":"The company offered a remedy for the delay.","exampleTranslation":"Công ty đã đưa ra một biện pháp khắc phục cho sự chậm trễ. [L23]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"respiration":{"definition":"Hơi thở.","example":"I could hear her respiration in the quiet room.","exampleTranslation":"Tôi có thể nghe thấy tiếng thở của cô ấy trong căn phòng yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"respiratory":{"definition":"Sự thở, (thuộc) hô hấp.","example":"He has a chronic respiratory infection from smoking.","exampleTranslation":"Anh ấy bị nhiễm trùng hô hấp mãn tính do hút thuốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"robust":{"definition":"Làm mạnh khoẻ; đòi hỏi sức mạnh.","example":"He enjoys robust exercise every morning at the gym.","exampleTranslation":"Anh ấy thích bài tập đòi hỏi sức mạnh mỗi sáng tại phòng tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"scrawny":{"definition":"Gầy gò, khẳng khiu.","example":"The scrawny cat ate very slowly.","exampleTranslation":"Con mèo gầy gò ăn rất chậm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"sexologist":{"definition":"Chuyên gia về tình dục học.","example":"The sexologist answered questions about healthy relationships.","exampleTranslation":"Chuyên gia về tình dục học đã trả lời các câu hỏi về mối quan hệ lành mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"sexual":{"definition":"Giới tính; sinh dục.","example":"They are studying human sexual health in school.","exampleTranslation":"Họ đang nghiên cứu sức khỏe tình dục con người tại trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"sexually":{"definition":"Giới tính; nhục dục; (thuộc) các vấn đề sinh lý.","example":"He left sexually after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách nhục dục sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"health"},"sick":{"definition":"Cần sửa lại, cần chữa lại.","example":"The plan is sick and needs a full fix.","exampleTranslation":"Kế hoạch này có khiếm khuyết và cần sửa lại toàn bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"sicken":{"definition":"Cảm thấy ốm, có triệu chứng ốm.","example":"The food smell began to sicken him.","exampleTranslation":"Mùi thức ăn bắt đầu làm anh ấy cảm thấy ốm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"sinus":{"definition":"Lõm gian thuỳ.","example":"The shape had a sinus between the two hills.","exampleTranslation":"Hình dáng đó có một phần lõm giữa hai quả đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"sleep":{"definition":"Giấc ngủ; sự ngủ.","example":"A long sleep is good for your health.","exampleTranslation":"Một giấc ngủ dài tốt cho sức khỏe của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"sluggish":{"definition":"Chậm chạp; uể oải, lờ đờ, lờ phờ.","example":"He felt sluggish after a very long day.","exampleTranslation":"Anh ấy cảm thấy uể oải sau một ngày rất dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"smoke":{"definition":"Khói.","example":"A thick column of smoke rose into the air.","exampleTranslation":"Một cột khói dày bốc lên không trung.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"snore":{"definition":"Ngáy.","example":"My grandfather started to snore during the movie.","exampleTranslation":"Ông tôi bắt đầu ngáy trong lúc xem phim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"sober":{"definition":"Không say rượu, không say xỉn.","example":"I promised to stay sober during the party.","exampleTranslation":"Tôi hứa sẽ giữ mình không say rượu trong bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"stamina":{"definition":"Sức chịu đựng; khả năng chịu đựng.","example":"She ran far because of her strong stamina.","exampleTranslation":"Cô ấy chạy xa vì sức chịu đựng mạnh mẽ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"starvation":{"definition":"Sự chết đói.","example":"The village faced starvation after the long drought.","exampleTranslation":"Ngôi làng phải đối mặt với sự chết đói sau đợt hạn hán dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"starve":{"definition":"Thiếu ăn.","example":"I starve for a meal after the long hike.","exampleTranslation":"Tôi thiếu ăn cho một bữa cơm sau chuyến đi dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"stomach":{"definition":"Bụng.","example":"My stomach feels very full after that big meal.","exampleTranslation":"Bụng tôi cảm thấy rất no sau bữa ăn lớn đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"stone":{"definition":"Sỏi (thận, bóng đái... ).","example":"A stone hurt his foot in the shoe.","exampleTranslation":"Một hòn sỏi làm đau chân anh ấy trong giày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"strain":{"definition":"Sự căng, sự căng thẳng; trạng thái căng, trạng thái căng thẳng.","example":"The heavy rope broke under the extreme strain.","exampleTranslation":"Sợi dây dày bị đứt dưới sự căng thẳng cực độ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"stroke":{"definition":"Cú, cú đánh, đòn.","example":"The soldier delivered a powerful stroke of sword.","exampleTranslation":"Người lính thực hiện một cú đánh mạnh bằng kiếm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"suffer":{"definition":"Cho phép; dung thứ, chịu đựng.","example":"I cannot suffer such rude behavior in class.","exampleTranslation":"Tôi không thể dung thứ hành vi thô lỗ như vậy trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"suicide":{"definition":"Sự tự sát, sự tự tử, sự tự vẫn.","example":"The news about his suicide shocked the whole town.","exampleTranslation":"Tin tức về vụ tự sát của ông ấy đã làm chấn động cả thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"sunburn":{"definition":"Sự rám nắng, sự sạm nắng.","example":"His sunburn made his nose feel hot.","exampleTranslation":"Vết rám nắng khiến mũi anh ấy cảm thấy nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"supplement":{"definition":"Phần bổ sung, phần phụ thêm.","example":"The book includes a useful supplement.","exampleTranslation":"Cuốn sách bao gồm một phần bổ sung hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"surgeon":{"definition":"Nhà phẫu thuật, bác sĩ phẫu thuật.","example":"The surgeon explained the operation clearly.","exampleTranslation":"Nhà phẫu thuật đã giải thích ca mổ một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"surgical":{"definition":"Phẫu thuật, (thuộc) mổ.","example":"The doctor kept all the surgical instruments very clean.","exampleTranslation":"Bác sĩ giữ cho tất cả các dụng cụ phẫu thuật rất sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"svelte":{"definition":"Mảnh khảnh, mảnh dẻ (người).","example":"She looked svelte in the simple black dress.","exampleTranslation":"Cô ấy trông mảnh khảnh trong chiếc váy đen đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"swallow":{"definition":"Sự nuốt.","example":"One swallow can be hard for a sick throat.","exampleTranslation":"Một lần nuốt có thể gây khó khăn cho một cổ họng bị đau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"syndrome":{"definition":"Hội chứng.","example":"The syndrome caused him constant fatigue.","exampleTranslation":"Hội chứng đó khiến anh ấy luôn mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"syringe":{"definition":"Thụt (nước tưới cây... ).","example":"She used a syringe to water the plant.","exampleTranslation":"Cô ấy đã sử dụng một ống thụt để tưới nước cho cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"taste":{"definition":"Sự nếm; sự nếm mùi, sự thưởng thức, sự trải qua, sự hưởng.","example":"She got a taste of his angry tantrum.","exampleTranslation":"Cô ấy đã trải qua sự nếm mùi của cơn giận dữ của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"telemedicine":{"definition":"Hệ thống thầy thuốc từ xa.","example":"Telemedicine saved him a long trip.","exampleTranslation":"Hệ thống thầy thuốc từ xa đã giúp anh ấy tránh một chuyến đi dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"therapeutic":{"definition":"(thuộc) phép chữa bệnh.","example":"The therapeutic bath helped her relax.","exampleTranslation":"Bồn tắm thuộc phép chữa bệnh đã giúp cô ấy thư giãn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"therapist":{"definition":"Nhà trị liệu, bác sĩ chuyên khoa về một phép chữa bệnh nào đó.","example":"The therapist listened carefully and took notes.","exampleTranslation":"Nhà trị liệu đã lắng nghe cẩn thận và ghi chú lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"thirst":{"definition":"Sự thèm khát, sự khao khát.","example":"She has a great thirst for new knowledge.","exampleTranslation":"Cô ấy có một sự khao khát lớn đối với tri thức mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"throat":{"definition":"Họng, cuống họng.","example":"The giant reached out to grip him by the throat.","exampleTranslation":"Người khổng lồ vươn tay để túm lấy anh ta bằng họng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"tincture":{"definition":"Cồn thuốc.","example":"The doctor gave me a tincture of iodine.","exampleTranslation":"Bác sĩ đã đưa cho tôi một cồn thuốc i-ốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"tired":{"definition":"Mệt, mệt mỏi, nhọc.","example":"I am so tired after working all day.","exampleTranslation":"Tôi rất mệt mỏi sau khi làm việc cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"toes":{"definition":"Động từ chia ở ngôi thứ ba số ít của toe","example":"The dancer toes forward with grace.","exampleTranslation":"Vũ công kiễng chân về phía trước một cách duyên dáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"tooth":{"definition":"Răng.","example":"The baby just lost her first tooth today.","exampleTranslation":"Em bé vừa rụng chiếc răng đầu tiên hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"toxin":{"definition":"Độc tố toxin.","example":"This toxin can harm animals in small amounts.","exampleTranslation":"Độc tố này có thể gây hại cho động vật với số lượng nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"tumour":{"definition":"Khối u, u, bướu.","example":"The doctor checked the small tumour carefully.","exampleTranslation":"Bác sĩ đã kiểm tra khối u nhỏ một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"ultrasound":{"definition":"Siêu âm; sóng siêu âm; âm thanh có tần số siêu âm.","example":"The ultrasound showed the baby's hand.","exampleTranslation":"Kết quả siêu âm cho thấy bàn tay của em bé.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"underfed":{"definition":"Cho thiếu ăn, cho ăn đói.","example":"The underfed dog needed better care.","exampleTranslation":"Chú chó bị cho thiếu ăn cần được chăm sóc tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"health"},"undernourished":{"definition":"Thiếu ăn, không được ăn đầy đủ (thức ăn cần thiết cho sức khoẻ và sự phát triển bình thường).","example":"The undernourished puppy needed careful feeding.","exampleTranslation":"Chú chó con bị thiếu ăn cần được cho ăn cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"uninfected":{"definition":"Không bị lây nhiễm, không bị nhiễm.","example":"The wound is uninfected and healing well.","exampleTranslation":"Vết thương không bị lây nhiễm và đang lành tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"urine":{"definition":"Nước đái, nước tiểu.","example":"The urine was important at work.","exampleTranslation":"Nước tiểu quan trọng tại nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"vaccine":{"definition":"Vắc-xin.","example":"The doctor gave him a new vaccine for protection.","exampleTranslation":"Bác sĩ đã cho anh ấy một loại vắc-xin mới để bảo vệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"vigor":{"definition":"(như) vigour.","example":"The runner finished with great vigor.","exampleTranslation":"Người chạy bộ đã hoàn thành với sức mạnh lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"vigorous":{"definition":"Mạnh khoẻ, cường tráng.","example":"He is a vigorous man who exercises every day.","exampleTranslation":"Anh ấy là một người đàn ông mạnh khỏe, người tập thể dục mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"viral":{"definition":"Virut.","example":"A viral spread quickly under the microscope.","exampleTranslation":"Một virut lan rộng nhanh chóng dưới kính hiển vi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"vital":{"definition":"Sống còn, quan trọng.","example":"This is a vital question for our team.","exampleTranslation":"Đây là một câu hỏi sống còn cho đội của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"health"},"vitality":{"definition":"Khả năng tồn tại lâu dài.","example":"Exercise can help you maintain your physical vitality.","exampleTranslation":"Tập thể dục có thể giúp bạn duy trì khả năng tồn tại lâu dài thể chất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"vitamin":{"definition":"Sinh tố, chất bổ, vi-ta-min.","example":"This fruit has a lot of vitamin C.","exampleTranslation":"Loại quả này có rất nhiều sinh tố C.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"vomit":{"definition":"Chất nôn mửa ra.","example":"There was vomit on the floor after lunch.","exampleTranslation":"Có chất nôn mửa trên sàn sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"wound":{"definition":"Vết băm, vết chém (trên cây).","example":"The tree has a deep wound on its bark.","exampleTranslation":"Cây có một vết chém sâu trên vỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"health"},"employment":{"definition":"Việc làm; tình trạng có công việc được trả lương.","example":"She is currently looking for full-time employment.","exampleTranslation":"Cô ấy hiện đang tìm việc làm toàn thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"inequality":{"definition":"Sự bất bình đẳng; tình trạng thiếu công bằng hoặc ngang bằng.","example":"The report examines income inequality between rural and urban households.","exampleTranslation":"Báo cáo xem xét bất bình đẳng thu nhập giữa các hộ gia đình nông thôn và thành thị.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"noun","posGroup":"noun","family":"society-work"},"urbanization":{"definition":"Đô thị hóa; quá trình dân cư và hoạt động tập trung vào thành phố.","example":"Rapid urbanization can increase the demand for city housing.","exampleTranslation":"Đô thị hóa nhanh có thể làm tăng nhu cầu nhà ở trong thành phố.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"noun","posGroup":"noun","family":"society-work","spellingNote":"British spelling: urbanisation."},"infrastructure":{"definition":"Cơ sở hạ tầng như đường sá, cầu cống, điện và nước.","example":"Good infrastructure supports daily life.","exampleTranslation":"Cơ sở hạ tầng tốt hỗ trợ đời sống hằng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"unemployment":{"definition":"Tình trạng thất nghiệp; không có việc làm dù đang tìm việc.","example":"Unemployment rose after the factory closed.","exampleTranslation":"Tỷ lệ thất nghiệp tăng sau khi nhà máy đóng cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"abandon":{"definition":"Bộm (nhiếp ảnh)","example":"They abandon the old plan at dawn.","exampleTranslation":"Họ từ bỏ kế hoạch cũ vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society-work"},"abandonment":{"definition":"Sự phóng túng, sự tự do, sự buông thả.","example":"Her abandonment at the party made her dance.","exampleTranslation":"Sự phóng túng của cô ấy tại bữa tiệc khiến cô ấy nhảy múa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"action":{"definition":"Hành động, hành vi; hoạt động; công việc, việc làm.","example":"She is a woman of action who loves hiking.","exampleTranslation":"Cô ấy là một người phụ nữ của hành động, người yêu thích đi bộ đường dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"active":{"definition":"Tích cực, hoạt động; nhanh nhẹn, linh lợi.","example":"She is an active member of the club.","exampleTranslation":"Cô ấy là một thành viên tích cực của câu lạc bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society-work"},"agency":{"definition":"Tác dụng, lực.","example":"His words had a quiet agency in the room.","exampleTranslation":"Lời nói của anh ấy có một tác dụng lặng lẽ trong căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"agent":{"definition":"Tác thể","example":"A moral agent must take responsibility for actions.","exampleTranslation":"Một tác thể đạo đức phải chịu trách nhiệm cho các hành động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"ambitious":{"definition":"Có nhiều hoài bão, có nhiều khát vọng.","example":"She is ambitious and studies every night.","exampleTranslation":"Cô ấy có nhiều hoài bão và học tập mỗi đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society-work"},"combat":{"definition":"Đánh nhau, chiến đấu.","example":"Soldiers must combat with courage during the war.","exampleTranslation":"Người lính phải chiến đấu với lòng can đảm trong chiến tranh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society-work"},"deliver":{"definition":"Đọc, phát biểu, giãi bày, bày tỏ.","example":"He will deliver a speech at the party.","exampleTranslation":"Anh ấy sẽ đọc một bài phát biểu tại bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society-work"},"delivery":{"definition":"Cách nói; sự đọc, sự bày tỏ, sự phát biểu (ý kiến).","example":"His speech was good but his delivery was slow.","exampleTranslation":"Bài phát biểu của anh ấy hay nhưng cách nói của anh ấy thì chậm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"dismiss":{"definition":"Đuổi ra, thải hồi, sa thải (người làm... ).","example":"The company will dismiss him after repeated mistakes.","exampleTranslation":"Công ty sẽ sa thải anh ấy sau những lỗi lầm lặp lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society-work"},"guard":{"definition":"Sự thủ thế, sự giữ miếng (đấu gươm, quyền Anh... ).","example":"He took a defensive guard during the match.","exampleTranslation":"Anh ấy đã thực hiện một tư thế thủ thế trong trận đấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"initiative":{"definition":"Bắt đầu, khởi đầu.","example":"She took an initiative step at the meeting.","exampleTranslation":"Cô ấy đã thực hiện một bước bắt đầu tại cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society-work"},"scheme":{"definition":"Sự sắp xếp theo hệ thống, sự phối hợp.","example":"I really like the color scheme of this room.","exampleTranslation":"Tôi thực sự thích sự sắp xếp màu sắc của căn phòng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society-work"},"strike":{"definition":"Đánh, đập.","example":"Please do not strike your hand on the table.","exampleTranslation":"Vui lòng đừng đánh tay bạn trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society-work"},"uncooperative":{"definition":"Bất hợp tác, không vui lòng hợp tác với người khác.","example":"Her uncooperative reply slowed the whole team.","exampleTranslation":"Câu trả lời bất hợp tác của cô ấy đã làm chậm tiến độ của cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society-work"},"underappreciated":{"definition":"Không được đánh giá đúng mức; bị đánh giá thấp; bị coi thường.","example":"This quiet gem is underappreciated by many readers.","exampleTranslation":"Viên ngọc quý thầm lặng này bị đánh giá thấp bởi nhiều độc giả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society-work"},"uniform":{"definition":"Đồng dạng, cùng một kiểu, giống nhau.","example":"All students must wear a uniform to school.","exampleTranslation":"Tất cả học sinh phải mặc đồng dạng một kiểu đến trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society-work"},"societal":{"definition":"Thuộc xã hội.","example":"The study looks at societal changes over time.","exampleTranslation":"Nghiên cứu này xem xét những thay đổi của xã hội theo thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"societ"},"society":{"definition":"Xã hội.","example":"We all have certain duties towards our local society.","exampleTranslation":"Tất cả chúng ta đều có những nghĩa vụ nhất định đối với xã hội địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"societ"},"social":{"definition":"Thuộc về xã hội hoặc các mối quan hệ giữa người với người.","example":"Social inequality can limit access to education and healthcare.","exampleTranslation":"Bất bình đẳng xã hội có thể hạn chế khả năng tiếp cận giáo dục và chăm sóc sức khỏe.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"social"},"socialise":{"definition":"Xã hội hoá.","example":"Children socialise easily at the park.","exampleTranslation":"Trẻ em dễ dàng giao lưu với nhau ở công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"social","spellingNote":"Alternate spelling: socialize."},"socialism":{"definition":"Chủ nghĩa xã hội.","example":"Many people study scientific socialism in college.","exampleTranslation":"Nhiều người học về chủ nghĩa xã hội khoa học ở trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"social"},"socialist":{"definition":"Đảng viên đảng Xã hội.","example":"He is a socialist who cares about fairness.","exampleTranslation":"Anh ấy là một người theo chủ nghĩa xã hội, người quan tâm đến sự công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"social"},"socialization":{"definition":"Sự xã hội hoá.","example":"School supports socialization through play and talk.","exampleTranslation":"Trường học hỗ trợ quá trình xã hội hóa thông qua vui chơi và trò chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"social"},"socialize":{"definition":"Xã hội hoá.","example":"The city plans to socialize the local bus system.","exampleTranslation":"Thành phố có kế hoạch xã hội hóa hệ thống xe buýt địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"social","spellingNote":"British spelling: socialise."},"socially":{"definition":"Chung cho xã hội.","example":"Volunteering helps people connect socially with their neighbors.","exampleTranslation":"Hoạt động tình nguyện giúp mọi người kết nối với hàng xóm.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"social"},"equal":{"definition":"Ngang, bằng.","example":"Their scores were equal at the end.","exampleTranslation":"Điểm số của họ ngang bằng nhau vào lúc kết thúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"equal"},"equaled":{"definition":"Quá khứ và phân từ quá khứ của equal","example":"The new plan equaled the old one.","exampleTranslation":"Kế hoạch mới đã ngang bằng với kế hoạch cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"equal"},"equalise":{"definition":"Làm bằng nhau, làm ngang nhau.","example":"The teacher will equalise the scores before lunch.","exampleTranslation":"Giáo viên sẽ cân bằng lại điểm số trước giờ ăn trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"equal","spellingNote":"Alternate spelling: equalize."},"equalization":{"definition":"Sự làm bằng nhau, sự làm ngang nhau.","example":"The reform aimed at equalization of school fees.","exampleTranslation":"Cải cách này nhắm đến sự bình đẳng hóa học phí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"equal"},"equalize":{"definition":"Gỡ hoà (bóng đá... ).","example":"They equalize the game in the final minute.","exampleTranslation":"Họ cân bằng tỷ số trận đấu trong phút cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"equal","spellingNote":"British spelling: equalise."},"equalized":{"definition":"Quá khứ và phân từ quá khứ của equalize","example":"The technician equalized the levels on both speakers.","exampleTranslation":"Kỹ thuật viên đã cân bằng các mức âm lượng trên cả hai loa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"equal"},"equally":{"definition":"Bằng nhau, ngang nhau, như nhau; đều.","example":"He moved equally through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách đồng đều qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"equal"},"poverty":{"definition":"Sự nghèo nàn; cảnh nghèo nàn, cảnh bần cùng.","example":"Extreme poverty can affect many people in this region.","exampleTranslation":"Cảnh nghèo đói cùng cực có thể ảnh hưởng đến nhiều người trong khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"poverty"},"urban":{"definition":"Thành phố, (thuộc) thành thị; ở thành phố, ở thành thị.","example":"Many people prefer living in an urban environment.","exampleTranslation":"Nhiều người thích sống trong môi trường đô thị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"urban"},"urbanisation":{"definition":"Sự thành thị hoá.","example":"The rapid urbanisation of rural areas has changed the landscape.","exampleTranslation":"Quá trình đô thị hóa nhanh chóng ở các vùng nông thôn đã làm thay đổi cảnh quan.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"urban","spellingNote":"US spelling: urbanization."},"urbanise":{"definition":"Thành thị hoá.","example":"New roads can urbanise a quiet village.","exampleTranslation":"Những con đường mới có thể làm đô thị hóa một ngôi làng yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"urban","spellingNote":"Alternate spelling: urbanize."},"urbanize":{"definition":"Thành thị hoá.","example":"The village began to urbanize after the road opened.","exampleTranslation":"Ngôi làng bắt đầu đô thị hóa sau khi con đường được mở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"urban","spellingNote":"British spelling: urbanise."},"population":{"definition":"Dân cư.","example":"The population of the town is growing fast.","exampleTranslation":"Dân số của thị trấn đang tăng lên nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"population"},"community":{"definition":"cộng đồng","example":"Most Libyan policemen were members of the community where they worked.","exampleTranslation":"Hầu hết các cảnh sát người Libya đều là thành viên của cộng đồng nơi họ làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"communit"},"culture":{"definition":"Sự mở mang, sự tu dưỡng, sự trao đổi.","example":"Education is essential for the culture of mind.","exampleTranslation":"Giáo dục là yếu tố cần thiết cho sự phát triển văn hóa tư duy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"ethic":{"definition":"Đạo đức, (thuộc) luân thường đạo lý, (thuộc) luân lý.","example":"A strong ethic of fairness should guide every public decision.","exampleTranslation":"Tinh thần đề cao sự công bằng nên định hướng mọi quyết định công.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"ethic"},"ethical":{"definition":"Đạo đức, (thuộc) luân thường đạo lý, thuộc luân lý.","example":"We discussed the ethical side of the decision.","exampleTranslation":"Chúng tôi đã thảo luận về khía cạnh đạo đức của quyết định đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"ethic"},"ethics":{"definition":"Đạo đức, luân lý, luân thường đạo lý.","example":"Good ethics guide honest work.","exampleTranslation":"Đạo đức tốt dẫn dắt công việc trung thực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ethic"},"welfare":{"definition":"Hạnh phúc; phúc lợi.","example":"The government works for the welfare of citizens.","exampleTranslation":"Chính phủ làm việc vì phúc lợi của người dân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"welfare"},"migration":{"definition":"Sự di trú.","example":"Bird migration begins when the weather turns cold.","exampleTranslation":"Sự di cư của các loài chim bắt đầu khi thời tiết trở nên lạnh giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"migration"},"immigrating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của immigrate.","example":"They are immigrating for better job opportunities.","exampleTranslation":"Họ đang nhập cư để có cơ hội việc làm tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"immigrat"},"immigration":{"definition":"Sự nhập cư.","example":"Immigration changed the city quickly.","exampleTranslation":"Việc nhập cư đã làm thay đổi thành phố một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"immigrat"},"divers":{"definition":"; (đùa cợt) nhiều, linh tinh, khác nhau.","example":"He hid the treasures in divers places around town.","exampleTranslation":"Anh ấy đã giấu những kho báu ở nhiều nơi khác nhau xung quanh thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"divers"},"diversion":{"definition":"Sự làm trệch đi; sự trệch đi.","example":"A loud noise caused a diversion in the crowd.","exampleTranslation":"Một tiếng động lớn đã gây ra sự xao nhãng trong đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"divers"},"diversity":{"definition":"đa dạng","example":"Racial diversity is very low in Japan and very high in Toronto.","exampleTranslation":"Sự đa dạng chủng tộc rất thấp ở Nhật Bản và rất cao ở Toronto.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"divers"},"discriminating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của discriminate.","example":"She is discriminating between similar answers.","exampleTranslation":"Cô ấy đang phân biệt sự khác biệt giữa các câu trả lời tương tự nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"discriminat"},"discrimination":{"definition":"Sự đối xử phân biệt.","example":"We must fight against all forms of discrimination.","exampleTranslation":"Chúng ta phải đấu tranh chống lại mọi hình thức phân biệt đối xử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"discriminat"},"discriminative":{"definition":"Rõ ràng, tách bạch.","example":"She gave a discriminative answer to each point.","exampleTranslation":"Cô ấy đã đưa ra một câu trả lời có tính phân biệt rõ ràng cho từng điểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"discriminat"},"discriminator":{"definition":"Bộ phân biệt; bộ tách sóng.","example":"The discriminator separated the two signals.","exampleTranslation":"Bộ phân biệt đã tách hai tín hiệu đó ra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"discriminat"},"discriminatory":{"definition":"Phân biệt, biết phân biệt, có óc phán đoán, biết suy xét, sáng suốt.","example":"The test seemed discriminatory and unfair.","exampleTranslation":"Bài kiểm tra có vẻ mang tính phân biệt đối xử và không công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"discriminat"},"gender":{"definition":"Giới tính.","example":"The company does not care about your gender.","exampleTranslation":"Công ty không quan tâm đến giới tính của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"gender"},"family":{"definition":"gia đình","example":"My parents and my two brothers are my family.","exampleTranslation":"Cha mẹ tôi và hai anh em trai của tôi là gia đình của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"family"},"child":{"definition":"Kết quả, hậu quả, sản phẩm.","example":"Success is often the child of hard work.","exampleTranslation":"Thành công thường là kết quả (đứa con tinh thần) của sự chăm chỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"child"},"childhood":{"definition":"Tuổi thơ ấu, thời thơ ấu.","example":"Childhood can shape a person's habits.","exampleTranslation":"Tuổi thơ có thể hình thành nên những thói quen của một người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"child"},"childless":{"definition":"Không có con.","example":"They lived childless but happily together.","exampleTranslation":"Họ sống không con cái nhưng vẫn hạnh phúc bên nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"child"},"generation":{"definition":"Sự sinh ra, sự phát sinh ra.","example":"The generation of new ideas took time.","exampleTranslation":"Việc tạo ra những ý tưởng mới cần có thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"generation"},"youth":{"definition":"Tuổi trẻ, tuổi xuân, tuổi thanh niên, tuổi niên thiếu.","example":"He spent many happy days of youth by the sea.","exampleTranslation":"Anh ấy đã trải qua những ngày tháng tuổi trẻ hạnh phúc bên bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"youth"},"youthful":{"definition":"Trẻ, trẻ tuổi.","example":"She looks very youthful for her seventy years.","exampleTranslation":"Cô ấy trông rất trẻ trung so với tuổi bảy mươi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"youth"},"elder":{"definition":"Nhiều tuổi hơn.","example":"He is my elder brother from the city.","exampleTranslation":"Anh ấy là anh trai của tôi từ thành phố tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"elder"},"elderly":{"definition":"Cao tuổi; thuộc về người lớn tuổi.","example":"The hospital had a number of elderly patients who had been there for many years.","exampleTranslation":"Bệnh viện có nhiều bệnh nhân cao tuổi đã ở đó nhiều năm.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"elder"},"citizen":{"definition":"Công dân; người được pháp luật công nhận là thành viên của một quốc gia.","example":"Every citizen has basic rights.","exampleTranslation":"Mọi công dân đều có các quyền cơ bản.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"citizen"},"citizenship":{"definition":"Tư cách công dân.","example":"She values citizenship and community service.","exampleTranslation":"Cô ấy coi trọng quyền công dân và các hoạt động phục vụ cộng đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"citizen"},"human":{"definition":"Con người, (thuộc) loài người.","example":"Every human deserves to live a happy life.","exampleTranslation":"Mỗi con người đều xứng đáng được sống một cuộc đời hạnh phúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"human"},"humanisation":{"definition":"Sự làm cho có tính người, sự nhân tính hoá.","example":"The teacher praised the humanisation of the lesson.","exampleTranslation":"Giáo viên đã khen ngợi việc nhân văn hóa bài học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"human","spellingNote":"Alternate spelling: humanization."},"humanise":{"definition":"Làm cho có lòng nhân đạo.","example":"Good teachers humanise the classroom with care.","exampleTranslation":"Các giáo viên giỏi luôn biết cách nhân văn hóa lớp học bằng sự quan tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"human","spellingNote":"Alternate spelling: humanize."},"humanism":{"definition":"Chủ nghĩa nhân đạo.","example":"She studied humanism in college.","exampleTranslation":"Cô ấy đã học về chủ nghĩa nhân văn ở trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"human"},"humanist":{"definition":"Nhà nghiên cứu khoa học nhân văn; người theo dõi chủ nghĩa nhân văn.","example":"The humanist cared about art, books, and people.","exampleTranslation":"Nhà nhân văn đó quan tâm đến nghệ thuật, sách vở và con người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"human"},"humanity":{"definition":"Loài người, nhân loại.","example":"We must work together for the sake of humanity.","exampleTranslation":"Chúng ta phải cùng nhau làm việc vì lợi ích của nhân loại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"human"},"humanization":{"definition":"Sự làm cho có lòng nhân đạo; sự hoá thành nhân đạo.","example":"The school program helped with humanization.","exampleTranslation":"Chương trình học đã hỗ trợ cho việc nhân văn hóa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"human","spellingNote":"British spelling: humanisation."},"humanize":{"definition":"Làm cho có tính người, nhân tính hoá.","example":"They tried to humanize the cold industrial process.","exampleTranslation":"Họ đã cố gắng nhân văn hóa quy trình công nghiệp khô khan đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"human","spellingNote":"British spelling: humanise."},"humanly":{"definition":"Với cái nhìn của con người, với cung cách con người; với tình cảm con người; bằng những phương tiện thông thường của con người; trong phạm vi hiểu biết của con người.","example":"She did everything that was humanly possible today.","exampleTranslation":"Cô ấy đã làm mọi thứ có thể trong phạm vi khả năng của con người ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"human"},"humanness":{"definition":"Tính chất người.","example":"The robot lacked the humanness of a real speaker.","exampleTranslation":"Robot đó thiếu đi sự nhân tính của một người nói thực thụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"human"},"relationship":{"definition":"Mối quan hệ, mối liên hệ.","example":"We need to improve the relationship between departments.","exampleTranslation":"Chúng ta cần cải thiện mối quan hệ giữa các phòng ban.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"relationship"},"relationships":{"definition":"Các mối quan hệ.","example":"Building strong interpersonal relationships is key to effective teamwork.","exampleTranslation":"Việc xây dựng các mối quan hệ giữa các cá nhân bền vững là chìa khóa để làm việc nhóm hiệu quả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"relationship"},"accept":{"definition":"Nhận, chấp nhận, chấp thuận.","example":"Please accept my sincere apology for the mistake.","exampleTranslation":"Vui lòng chấp nhận lời xin lỗi chân thành của tôi vì sai lầm này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"acceptable":{"definition":"Có thể nhận, có thể chấp nhận.","example":"This behavior is not acceptable in our office.","exampleTranslation":"Hành vi này không thể chấp nhận được trong văn phòng của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"acceptance":{"definition":"Sự nhận, sự chấp nhận, sự chấp thuận.","example":"The class showed acceptance of the new rule.","exampleTranslation":"Cả lớp đã thể hiện sự chấp nhận đối với quy định mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"accompany":{"definition":"Đi theo, đi cùng, đi kèm, đồng hành.","example":"Please accompany me to the station.","exampleTranslation":"Vui lòng đi cùng tôi đến nhà ga.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"acknowledge":{"definition":"Nhận, thừa nhận, công nhận.","example":"You must acknowledge your mistake before moving on.","exampleTranslation":"Bạn phải thừa nhận sai lầm của mình trước khi tiếp tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"activist":{"definition":"Nhà hoạt động xã hội, nhà hoạt động chính trị.","example":"The activist organized a local cleanup.","exampleTranslation":"Nhà hoạt động xã hội đã tổ chức một buổi dọn dẹp địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"address":{"definition":"Đề địa chỉ.","example":"Please address the letter to the correct person.","exampleTranslation":"Vui lòng đề địa chỉ lá thư cho đúng người nhận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"alien":{"definition":"Alien from, to lạ, xa lạ, khác biệt; không có quan hệ gì với; không phải của mình.","example":"His strange behavior feels very alien to me.","exampleTranslation":"Hành vi kỳ lạ của anh ấy cảm thấy rất xa lạ đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"alienate":{"definition":"Làm cho giận ghét; làm cho xa lánh.","example":"Her rude words alienate many classmates.","exampleTranslation":"Những lời lẽ thô lỗ của cô ấy làm xa lánh nhiều bạn cùng lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"alienation":{"definition":"Sự làm cho giận, sự làm cho ghét, sự làm cho xa lánh; sự xa lìa, sự ghét bỏ, sự chán ghét; mối bất hoà.","example":"He felt a sense of alienation from his friends.","exampleTranslation":"Anh ấy cảm thấy một sự xa lìa đối với bạn bè của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"archbishop":{"definition":"Tổng giám mục.","example":"The archbishop visited the school today.","exampleTranslation":"Tổng giám mục đã đến thăm trường hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"assist":{"definition":"Giúp, giúp đỡ.","example":"Can you assist me in moving these heavy boxes?","exampleTranslation":"Bạn có thể giúp tôi di chuyển những cái hộp nặng này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"assistance":{"definition":"Sự giúp đỡ.","example":"Can you give me some assistance with my homework?","exampleTranslation":"Bạn có thể cho tôi chút sự giúp đỡ với bài tập về nhà không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"assistant":{"definition":"Người giúp đỡ, người phụ tá.","example":"The assistant organized the books on the shelf.","exampleTranslation":"Người phụ tá đã sắp xếp những cuốn sách trên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"associate":{"definition":"Kết giao, kết hợp liên hợp; liên đới.","example":"They have a long associate with the local firm.","exampleTranslation":"Họ đã có một mối liên kết lâu dài với công ty địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"association":{"definition":"Hội, hội liên hiệp; đoàn thể, công ty.","example":"He joined a local sports association last year.","exampleTranslation":"Anh ấy đã tham gia một hội thể thao địa phương năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"award":{"definition":"Tặng, tặng thưởng, trao tặng.","example":"They will award the winner a gold medal today.","exampleTranslation":"Họ sẽ trao tặng người chiến thắng một huy chương vàng hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"background":{"definition":"Phía sau.","example":"The garden background was soft blue.","exampleTranslation":"Phía sau khu vườn là màu xanh dịu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"bedtime":{"definition":"Giờ đi ngủ.","example":"It is bedtime, so brush your teeth.","exampleTranslation":"Đến giờ đi ngủ rồi, nên hãy đánh răng đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"behalf":{"definition":"On (in) behalf of thay mặt cho, nhân danh.","example":"I am writing this letter on behalf of my boss.","exampleTranslation":"Tôi đang viết lá thư này thay mặt cho sếp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"beleaguered":{"definition":"Quá khứ và phân từ quá khứ của beleaguer","example":"The village was beleaguered by heavy rain.","exampleTranslation":"Ngôi làng bị cơn mưa lớn làm cho khốn đốn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"belong":{"definition":"Thuộc vào loại.","example":"Whales belong among the mammals in the ocean.","exampleTranslation":"Cá voi thuộc vào loại động vật có vú ở đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"benevolent":{"definition":"Nhân từ, nhân đức, từ thiện, thương người.","example":"He was a benevolent teacher who helped everyone.","exampleTranslation":"Ông ấy là một giáo viên nhân từ, người đã giúp đỡ mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"birthday":{"definition":"Ngày sinh; lễ sinh nhật.","example":"I received a lovely birthday present yesterday.","exampleTranslation":"Tôi đã nhận được một món quà lễ sinh nhật đáng yêu ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"blame":{"definition":"Sự khiển trách; lời trách mắng.","example":"You should take the blame for this mistake.","exampleTranslation":"Bạn nên nhận trách nhiệm cho sai lầm này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"brave":{"definition":", (văn học) đẹp lộng lẫy, sang trọng","example":"He wore a brave coat to the party.","exampleTranslation":"Anh ấy mặc một chiếc áo khoác đẹp lộng lẫy tới bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"bride":{"definition":"Cô dâu.","example":"The bride smiled as she entered the room.","exampleTranslation":"Cô dâu mỉm cười khi cô ấy bước vào phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"brutal":{"definition":"Đầy thú tính; cục xúc.","example":"The brutal wind cut through our coats.","exampleTranslation":"Cơn gió đầy thú tính cắt ngang qua những chiếc áo khoác của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"brutally":{"definition":"Hung bạo, tàn nhẫn.","example":"The team finished brutally and left.","exampleTranslation":"Cả đội đã hoàn thành việc một cách hung bạo và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"cannibalism":{"definition":"Tục ăn thịt người.","example":"The story mentioned ancient cannibalism.","exampleTranslation":"Câu chuyện đề cập đến tục ăn thịt người thời cổ đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"captive":{"definition":"Bị bắt giữ, bị giam cầm.","example":"The bird was kept in a captive state.","exampleTranslation":"Con chim được giữ trong trạng thái bị giam cầm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"cemetery":{"definition":"Nghĩa trang, nghĩa địa.","example":"They visited the cemetery at sunset.","exampleTranslation":"Họ đã đến thăm nghĩa trang vào lúc hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"clan":{"definition":"Thị tộc.","example":"Their clan met every summer in one house.","exampleTranslation":"Thị tộc của họ đã gặp nhau mỗi mùa hè trong một ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"cohort":{"definition":"một nhóm người có chung đặc điểm, thường là cùng tuổi:","example":"The study tracked a cohort born in spring.","exampleTranslation":"Nghiên cứu đã theo dõi một nhóm người cùng sinh vào mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"collective":{"definition":"Tập thể; chung.","example":"They reached a collective decision to change the plan.","exampleTranslation":"Họ đã đạt được một quyết định tập thể để thay đổi kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"commit":{"definition":"Giao, gửi, giao phó, uỷ nhiệm, uỷ thác.","example":"They decided to commit the task to her care.","exampleTranslation":"Họ đã quyết định giao phó nhiệm vụ này cho sự chăm sóc của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"commitment":{"definition":"Sự tận tụy, sự tận tâm, sự cam kết.","example":"Her commitment to study was impressive.","exampleTranslation":"Sự tận tâm của cô ấy đối với việc học thật ấn tượng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"complain":{"definition":"Kêu ca, kêu, phàn nàn, than phiền; oán trách.","example":"I complain when the room is too noisy.","exampleTranslation":"Tôi thường than phiền khi căn phòng quá ồn ào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"compromise":{"definition":"Dàn xếp, thoả hiệp.","example":"They compromise to finish the project on time.","exampleTranslation":"Họ thoả hiệp để hoàn thành dự án đúng thời hạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"concern":{"definition":"Sự liên quan đến, sự dính líu đến.","example":"That matter has no concern with our current plan.","exampleTranslation":"Vấn đề đó không dính líu gì đến kế hoạch hiện tại của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"concerted":{"definition":"Có dự tính, có bàn tính, có phối hợp.","example":"They took concerted action to save the forest.","exampleTranslation":"Họ đã có hành động phối hợp để cứu lấy khu rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"concur":{"definition":"Kết hợp lại, góp vào.","example":"These efforts concur to make the event better.","exampleTranslation":"Những nỗ lực này kết hợp lại để làm cho sự kiện tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"conduct":{"definition":"Hạnh kiểm, tư cách, đạo đức, cách cư xử.","example":"The student was praised for his good conduct.","exampleTranslation":"Sinh viên đã được khen ngợi vì tư cách tốt của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"confess":{"definition":"Thú tội, thú nhận.","example":"You must confess your mistake to the teacher.","exampleTranslation":"Bạn phải thú tội lỗi của mình với giáo viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"conflict":{"definition":"Sự xung đột, sự tranh giành, sự va chạm.","example":"Their personal goals are in constant conflict with each other.","exampleTranslation":"Mục tiêu cá nhân của họ luôn trong sự xung đột với nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"conform":{"definition":"Làm cho hợp với, làm cho phù hợp với, làm cho thích hợp với.","example":"The details must conform to the rules.","exampleTranslation":"Các chi tiết phải phù hợp với các quy tắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"confront":{"definition":"Mặt giáp mặt với, đối diện với, đứng trước; chạm trán, đương đầu với.","example":"Many difficulties confront us every single day.","exampleTranslation":"Nhiều khó khăn đương đầu với chúng ta mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"constraint":{"definition":"Sự bắt ép, sự ép buộc, sự cưỡng ép, sự thúc ép, sự ràng buộc.","example":"He was forced to sign the paper under constraint.","exampleTranslation":"Anh ấy buộc phải ký vào giấy tờ dưới sự ép buộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"contact":{"definition":"Sự chạm, sự tiếp xúc.","example":"Our troops are in contact with the enemy now.","exampleTranslation":"Quân đội của chúng ta đang trong sự tiếp xúc với kẻ thù ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"contend":{"definition":"Chiến đấu, đấu tranh.","example":"They will contend for the truth in court.","exampleTranslation":"Họ sẽ đấu tranh cho sự thật tại tòa án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"contribute":{"definition":"Đóng góp, góp phần.","example":"She will contribute an article to the local magazine.","exampleTranslation":"Cô ấy sẽ đóng góp một bài báo cho tạp chí địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"contribution":{"definition":"Sự đóng góp, sự góp phần; phần đóng góp, phần gánh vác.","example":"Her contribution to the project was very important.","exampleTranslation":"Sự đóng góp của cô ấy cho dự án rất quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"contributory":{"definition":"Phụ thêm vào.","example":"The accident was a contributory cause of the delay.","exampleTranslation":"Tai nạn là một nguyên nhân phụ thêm vào cho sự chậm trễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"controversial":{"definition":"Chỉ một vấn đề gây tranh cãi.","example":"The new rule is controversial.","exampleTranslation":"Quy tắc mới là một vấn đề gây tranh cãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"controversy":{"definition":"tranh cãi; cuộc tranh luận","example":"There's a controversy about whether cars should be allowed to drive in this part of the city.","exampleTranslation":"Có một sự tranh cãi về việc liệu xe hơi có nên được phép lái trong khu vực này của thành phố hay không.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"society"},"cooperate":{"definition":"Hợp lại, góp lại, góp phần, đưa đến kết quả (vật, sự việc).","example":"The two pipes cooperate to cool the room.","exampleTranslation":"Hai đường ống hợp tác với nhau để làm mát căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"cooperation":{"definition":"Sự hợp tác.","example":"Good cooperation made the project finish early.","exampleTranslation":"Sự hợp tác tốt đã giúp dự án hoàn thành sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"courteous":{"definition":"Lịch sự, nhã nhặn.","example":"He gave us a courteous reply.","exampleTranslation":"Anh ấy đã đưa cho chúng tôi một câu trả lời lịch sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"courtesy":{"definition":"Lịch thiệp, nhã nhặn.","example":"The courtesy appeared in the report.","exampleTranslation":"Sự lịch thiệp đã xuất hiện trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"craze":{"definition":"Tính ham mê, sự say mê.","example":"There is a new craze for vintage clothes.","exampleTranslation":"Có một sự say mê mới đối với quần áo cổ điển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"crisis":{"definition":"Sự khủng hoảng; cơn khủng hoảng.","example":"The country is facing a serious economic crisis.","exampleTranslation":"Đất nước đang đối mặt với một cuộc khủng hoảng kinh tế nghiêm trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"crowd":{"definition":"Đống, vô số.","example":"There was a crowd of papers on the desk.","exampleTranslation":"Có một đống giấy tờ trên bàn làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"cult":{"definition":"Sự tôn sùng, sự tôn kính, sự sùng bái; sự sính.","example":"He is known for his cult of personality.","exampleTranslation":"Anh ấy nổi tiếng với sự sùng bái cá nhân của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"decorum":{"definition":"Sự đúng mực, sự đoan trang, sự đứng đắn; sự lịch sự, sự lịch thiệp.","example":"His behavior was a serious breach of decorum today.","exampleTranslation":"Hành vi của anh ấy hôm nay là một sự vi phạm nghiêm trọng về sự đúng mực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"dedicate":{"definition":"Cống hiến, hiến dâng; dành cho (để tưởng nhớ).","example":"They dedicate this park to the local heroes.","exampleTranslation":"Họ cống hiến công viên này cho những anh hùng địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"dedication":{"definition":"Sự cống hiến, sự hiến dâng.","example":"Her dedication helped the project succeed.","exampleTranslation":"Sự cống hiến của cô ấy đã giúp dự án thành công.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"dehumanise":{"definition":"Làm mất tính người, làm thành hung ác dã man, làm thành vô nhân đạo.","example":"He learned to dehumanise the tool.","exampleTranslation":"Anh ấy đã học cách làm mất tính người của công cụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"depend":{"definition":"Phụ thuộc, tuỳ thuộc, tuỳ thuộc.","example":"Our success does not depend on the weather today.","exampleTranslation":"Thành công của chúng ta không tuỳ thuộc vào thời tiết hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"dependence":{"definition":"Sự dựa vào, sự ỷ vào; sự nương tựa; chỗ dựa, chỗ nương tựa (để sống).","example":"Our dependence on technology is growing every day.","exampleTranslation":"Sự dựa vào công nghệ của chúng ta đang tăng lên mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"dependency":{"definition":"Vật phụ thuộc; phần phụ thuộc.","example":"The shop has a small dependency nearby.","exampleTranslation":"Cửa hàng có một phần phụ thuộc nhỏ ở gần đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"dependent":{"definition":"Người phụ thuộc, người tuỳ thuộc (vào người khác).","example":"The child was a dependent on the policy.","exampleTranslation":"Đứa trẻ là một người phụ thuộc trong chính sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"deprivation":{"definition":"Sự mất.","example":"The deprivation of sleep made him tired.","exampleTranslation":"Sự mất ngủ làm anh ấy mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"deprive":{"definition":"Cách chức (mục sư... ).","example":"The court may deprive him of his title.","exampleTranslation":"Tòa án có thể cách chức danh hiệu của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"dignified":{"definition":"Có giá trị, có phẩm cách, đáng tôn quý.","example":"She gave the simple gift a dignified look.","exampleTranslation":"Cô ấy mang lại cho món quà đơn giản một vẻ đáng tôn quý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"disadvantage":{"definition":"Sự thiệt hại, mối tổn thất.","example":"The long trip was a disadvantage for us.","exampleTranslation":"Chuyến đi dài là một sự thiệt hại đối với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"disadvantageous":{"definition":"Bất lợi, thiệt thòi, thói quen.","example":"That route is disadvantageous in rainy weather.","exampleTranslation":"Tuyến đường đó thật bất lợi trong thời tiết mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"disapproval":{"definition":"Sự không tán thành, sự phản đối; sự chê.","example":"The teacher gave disapproval with a stern look.","exampleTranslation":"Người giáo viên thể hiện sự không tán thành bằng một ánh nhìn nghiêm khắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"discredit":{"definition":"Sự nghi ngờ, sự thiếu tin tưởng.","example":"His actions cast discredit on the entire team.","exampleTranslation":"Hành động của anh ta làm mất uy tín của cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"disorganise":{"definition":"Phá hoại tổ chức của; phá rối tổ chức của.","example":"Poor planning can disorganise a whole team.","exampleTranslation":"Lên kế hoạch kém có thể phá rối tổ chức của cả một đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"disorganization":{"definition":"Sự phá hoại tổ chức; sự phá rối tổ chức.","example":"The disorganization of the event caused delays.","exampleTranslation":"Sự phá rối tổ chức của sự kiện đã gây ra nhiều trì hoãn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"dispute":{"definition":"Cuộc bàn cãi, cuộc tranh luận.","example":"It is beyond dispute that she is very talented.","exampleTranslation":"Việc cô ấy rất tài năng là điều không cần bàn cãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"disrupt":{"definition":"Gián đoạn.","example":"The noise can disrupt the class.","exampleTranslation":"Tiếng ồn có thể làm gián đoạn lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"disruption":{"definition":"Sự đập gãy, sự đập vỗ, sự phá vỡ; sự gẫy vỡ.","example":"The storm caused major disruption on the road.","exampleTranslation":"Cơn bão đã gây ra sự gẫy vỡ lớn trên đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"disruptive":{"definition":"Đánh thủng.","example":"His disruptive behavior caused many problems in class.","exampleTranslation":"Hành vi thô bạo của cậu ấy đã gây ra nhiều vấn đề trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"diverse":{"definition":"Gồm nhiều loại khác nhau, linh tinh.","example":"The class had diverse students from many places.","exampleTranslation":"Lớp học có những học sinh gồm nhiều loại khác nhau từ nhiều nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"domestic":{"definition":"Gia đình, (thuộc) việc nhà, nội trợ.","example":"We need to complete all our domestic chores today.","exampleTranslation":"Chúng ta cần hoàn thành tất cả các công việc nội trợ hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"dominance":{"definition":"Thế thống trị, địa vị; địa vị thống trị.","example":"The team's dominance lasted for three seasons.","exampleTranslation":"Sự thống trị của đội bóng kéo dài trong ba mùa giải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"dominant":{"definition":"Át, trội, có ưu thế hơn; có ảnh hưởng lớn, chi phối.","example":"Her dominant voice led the discussion.","exampleTranslation":"Giọng nói át hẳn của cô ấy dẫn dắt cuộc thảo luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"dominate":{"definition":"Át hẳn, trội hơn, chiếm ưu thế; có ảnh hưởng lớn, chi phối.","example":"One large company will dominate the local market.","exampleTranslation":"Một công ty lớn sẽ chiếm ưu thế thị trường địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"donate":{"definition":"Tặng, cho, biếu; quyên góp, quyên cúng.","example":"We donate food to the shelter every month.","exampleTranslation":"Chúng tôi quyên góp thực phẩm cho trại cứu trợ mỗi tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"donation":{"definition":"Đồ tặng, đồ cho, đồ biếu; đồ quyên cúng (vào tổ chức từ thiện).","example":"They sent a donation of food and clothes.","exampleTranslation":"Họ đã gửi một đồ quyên cúng gồm thực phẩm và quần áo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"duke":{"definition":"Nắm tay, nắm đấm.","example":"He raised his duke in a playful gesture.","exampleTranslation":"Anh ấy giơ nắm đấm lên theo một cử chỉ đùa nghịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"earl":{"definition":"Bá tước (ở Anh) ((xem) count).","example":"The earl welcomed guests at the old manor.","exampleTranslation":"Vị bá tước chào đón khách tại trang viên cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"elite":{"definition":"Ưu tú, xuất sắc.","example":"That was an elite team with great skill.","exampleTranslation":"Đó là một đội ưu tú với kỹ năng tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"embrace":{"definition":"Bao quát (nhìn, nắm).","example":"From the hill, we could embrace the valley.","exampleTranslation":"Từ trên đồi, chúng tôi có thể bao quát thung lũng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"eminent":{"definition":"Nổi tiếng, xuất sắc.","example":"He is an eminent teacher in this school.","exampleTranslation":"Ông ấy là một giáo viên nổi tiếng trong ngôi trường này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"enemy":{"definition":"Kẻ thù, kẻ địch, địch thủ; quân địch, tàu địch.","example":"You should never be your own enemy.","exampleTranslation":"Bạn không bao giờ nên là kẻ thù của chính mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"engage":{"definition":"Hẹn, hứa hẹn, ước hẹn, cam kết; đính ước, hứa hôn.","example":"They decided to engage in a long marriage.","exampleTranslation":"Họ quyết định ước hẹn trong một cuộc hôn nhân lâu dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"entrench":{"definition":"Đào hào xung quanh (thành phố, cứ điểm... ).","example":"The soldiers tried to entrench themselves against the enemy.","exampleTranslation":"Những người lính đã cố gắng đào hào xung quanh để phòng thủ chống lại kẻ thù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"escalate":{"definition":"Leo thang chiến tranh.","example":"The argument can escalate if nobody stays calm.","exampleTranslation":"Cuộc tranh luận có thể leo thang nếu không ai giữ bình tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"establishment":{"definition":"Số người hầu; quân số, lực lượng.","example":"The war establishment grew larger during the conflict.","exampleTranslation":"Quân số chiến tranh đã tăng lên trong suốt cuộc xung đột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"ethnic":{"definition":"Thuộc dân tộc, thuộc tộc người.","example":"The festival celebrated ethnic food and music.","exampleTranslation":"Lễ hội tôn vinh thực phẩm và âm nhạc dân tộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"ethos":{"definition":"Đặc tính, nét đặc biệt, thái độ sống (của một tập thể, một chủng tộc... ).","example":"Our company has a very strong work ethos.","exampleTranslation":"Công ty chúng tôi có một đặc tính làm việc rất mạnh mẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"evacuate":{"definition":"Tháo, làm khỏi tắc.","example":"The plumber had to evacuate the blocked pipe.","exampleTranslation":"Người thợ sửa ống nước phải tháo ống bị tắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"event":{"definition":"Sự kiện quan trọng.","example":"The concert was the main event of summer.","exampleTranslation":"Buổi hòa nhạc là sự kiện quan trọng nhất của mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"everybody":{"definition":"Mọi người, tất cả mọi người, ai ai; mỗi người.","example":"Everybody should join the meeting at five o'clock.","exampleTranslation":"Mọi người nên tham gia cuộc họp lúc năm giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"excommunication":{"definition":"Sự rút phép thông công.","example":"He learned to excommunication the tool.","exampleTranslation":"Anh ấy đã học cách rút phép thông công công cụ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"faith":{"definition":"Sự tin tưởng, sự tin cậy.","example":"She has great faith in her new business.","exampleTranslation":"Cô ấy có sự tin tưởng lớn vào công việc kinh doanh mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"faithful":{"definition":"Trung thực, chính xác.","example":"The witness gave a faithful report of events.","exampleTranslation":"Người làm chứng đã đưa ra một báo cáo trung thực về các sự kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"faithfully":{"definition":"Trung thành, chung thuỷ.","example":"I read the note faithfully.","exampleTranslation":"Tôi đọc lá thư một cách trung thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"farewell":{"definition":"Lời chúc tạm biệt; lời tam biệt.","example":"She said a final farewell before leaving home.","exampleTranslation":"Cô ấy đã nói lời chúc tạm biệt cuối cùng trước khi rời nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"favor":{"definition":"Thiện ý; sự quý mến.","example":"She won the favor of her new neighbors.","exampleTranslation":"Cô ấy đã giành được thiện ý của những người hàng xóm mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"favour":{"definition":"Thiện ý; sự quý mến.","example":"She found favour with her new boss today.","exampleTranslation":"Cô ấy tìm thấy thiện ý với ông chủ mới của mình hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"fellow":{"definition":"Bạn đồng chí.","example":"He is a good fellow and a loyal friend.","exampleTranslation":"Anh ấy là một bạn đồng chí tốt và một người bạn trung thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"fight":{"definition":"Sự đấu tranh, sự chiến đấu; trận đánh, cuộc chiến đấu.","example":"They were ready to give fight against the enemy.","exampleTranslation":"Họ đã sẵn sàng để chiến đấu chống lại kẻ thù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"fighter":{"definition":"Chiến sĩ, chiến binh, người đấu tranh, người chiến đấu.","example":"She is a fighter who never gives up.","exampleTranslation":"Cô ấy là một chiến sĩ không bao giờ bỏ cuộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"flee":{"definition":"Chạy trốn, bỏ chạy; lẩn trốn.","example":"They will flee the report tomorrow.","exampleTranslation":"Họ sẽ chạy trốn khỏi báo cáo vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"formal":{"definition":"Hình thức.","example":"The party required everyone to wear formal clothes.","exampleTranslation":"Bữa tiệc yêu cầu mọi người mặc trang phục hình thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"formally":{"definition":"Chính thức.","example":"I read the note formally.","exampleTranslation":"Tôi đọc lá thư một cách chính thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"friendly":{"definition":"Thân mật, thân thiết, thân thiện.","example":"She gave me a very friendly smile today.","exampleTranslation":"Cô ấy đã dành cho tôi một nụ cười rất thân thiện hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"generosity":{"definition":"Sự rộng lượng, sự khoan hồng; hành động rộng lượng, hành động khoan hồng.","example":"His generosity helped many people in the local community.","exampleTranslation":"Sự rộng lượng của ông ấy đã giúp nhiều người trong cộng đồng địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"generous":{"definition":"Thịnh soạn.","example":"They prepared a generous meal for all the guests.","exampleTranslation":"Họ đã chuẩn bị một bữa ăn thịnh soạn cho tất cả các vị khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"gentry":{"definition":"Hạng người.","example":"The light-fingered gentry stole some silver coins.","exampleTranslation":"Hạng người nhanh tay lẻn đã lấy trộm vài đồng xu bạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"ghetto":{"definition":"Khu người Do thái (ở trong một thành phố).","example":"The family lived in a crowded ghetto.","exampleTranslation":"Gia đình sống trong một khu người Do thái đông đúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"gift":{"definition":"Sự ban cho, sự cho, sự tặng.","example":"I received a beautiful gift from my mother.","exampleTranslation":"Tôi đã nhận được một món quà tuyệt đẹp từ mẹ tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"girl":{"definition":"Con gái.","example":"The girl laughed with her friends.","exampleTranslation":"Cô gái đã cười đùa cùng bạn bè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"groom":{"definition":"Chuẩn bị (cho người nào bước vào nghề gì).","example":"They want to groom him for a leadership role.","exampleTranslation":"Họ muốn chuẩn bị cho anh ấy một vai trò lãnh đạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"headman":{"definition":"Thủ lĩnh, người cầm đầu; tù trưởng, tộc trưởng.","example":"The headman spoke for the whole village.","exampleTranslation":"Người tộc trưởng đã phát biểu cho cả ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"heir":{"definition":"Người thừa kế, người thừa tự.","example":"The heir received the house after the old man died.","exampleTranslation":"Người thừa kế đã nhận ngôi nhà sau khi ông lão qua đời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"honest":{"definition":"Lương thiện.","example":"He is known as an honest man in this town.","exampleTranslation":"Anh ấy được biết đến là một người đàn ông lương thiện trong thị trấn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"honestly":{"definition":"Lương thiện.","example":"She spoke honestly during the meeting.","exampleTranslation":"Cô ấy đã phát biểu một cách lương thiện trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"horde":{"definition":"Muồm lũ, đám.","example":"A horde of insects covered the old garden.","exampleTranslation":"Một đám côn trùng bao phủ khu vườn cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"humankind":{"definition":"Loài người, nhân loại.","example":"Humankind has always searched for shelter.","exampleTranslation":"Loài người luôn tìm kiếm nơi trú ẩn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"identification":{"definition":"Sự phát hiện ra, sự nhận diện ra.","example":"The identification of the suspect took several hours.","exampleTranslation":"Việc nhận diện nghi phạm đã mất vài giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"identify":{"definition":"Đồng nhất hoá, coi như nhau.","example":"I identify the two ideas as the same.","exampleTranslation":"Tôi coi hai ý tưởng này là đồng nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"identity":{"definition":"danh tính; bản sắc","example":"Before I can give you money from your bank account, you have to prove your identity.","exampleTranslation":"Trước khi tôi có thể đưa tiền cho bạn từ tài khoản ngân hàng của bạn, bạn phải chứng minh danh tính của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"society"},"ignore":{"definition":"Lờ đi, phớt đi, làm ra vẻ không biết đến; kệ, bỏ qua.","example":"Please do not ignore my messages today.","exampleTranslation":"Xin đừng lờ đi các tin nhắn của tôi ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"immigrant":{"definition":"Dân nhập cư.","example":"The immigrant found work in a new city.","exampleTranslation":"Người dân nhập cư đó đã tìm được việc làm ở thành phố mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"impolite":{"definition":"Vô lễ.","example":"It was impolite to interrupt her while she spoke.","exampleTranslation":"Thật là vô lễ khi ngắt lời cô ấy trong khi cô ấy đang nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"inconsiderate":{"definition":"Thiếu thận trọng, thiếu suy nghĩ, khinh suất.","example":"Please do not make such inconsiderate actions in public.","exampleTranslation":"Xin đừng thực hiện những hành động thiếu suy nghĩ như vậy ở nơi công cộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"inconvenience":{"definition":"Sự bất tiện, sự phiền phức.","example":"We apologize for any inconvenience caused today.","exampleTranslation":"Chúng tôi xin lỗi vì bất kỳ sự bất tiện nào gây ra hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"inconvenient":{"definition":"Bất tiện, thiếu tiện nghi, phiền phức.","example":"Is it inconvenient for us to meet at noon?","exampleTranslation":"Có bất tiện không nếu chúng ta gặp nhau vào buổi trưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"individual":{"definition":"Riêng, riêng lẻ, cá nhân.","example":"Each individual has the right to express opinions.","exampleTranslation":"Mỗi cá nhân có quyền bày tỏ ý kiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"individually":{"definition":"Cá nhân, cá thể, riêng biệt, riêng lẻ, từng người một, từng cái một.","example":"The team finished individually and left.","exampleTranslation":"Cả đội đã kết thúc từng người một và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"influence":{"definition":"Ảnh hưởng, tác dụng.","example":"He was under the influence of his older brother.","exampleTranslation":"Anh ấy chịu ảnh hưởng của anh trai mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"influential":{"definition":"Có ảnh hưởng, có tác dụng.","example":"She is an influential teacher in our school.","exampleTranslation":"Cô ấy là một giáo viên có ảnh hưởng ở trường chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"influx":{"definition":"Sự chảy vào, sự tràn vào.","example":"There was a strong influx of visitors today.","exampleTranslation":"Có một sự tràn vào mạnh mẽ của du khách hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"informal":{"definition":"Không theo thủ tục quy định, không chính thức, không chính quy.","example":"We had an informal meeting at the cafe.","exampleTranslation":"Chúng tôi đã có một cuộc họp không chính thức tại quán cà phê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"inhabitant":{"definition":"Người ở, người cư trú, dân cư.","example":"Each inhabitant received clean water.","exampleTranslation":"Mỗi người ở nhận được nước sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"inhabit":{"definition":"Ở, sống ở (nơi nào) ((nghĩa đen) & (nghĩa bóng)).","example":"Many birds inhabit the tall trees here.","exampleTranslation":"Nhiều loài chim ở những cái cây cao ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"inherit":{"definition":"Hưởng, thừa hưởng, thừa kế.","example":"She will inherit the house from her aunt.","exampleTranslation":"Cô ấy sẽ thừa hưởng ngôi nhà từ dì của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"integrate":{"definition":"Mở rộng cho mọi người, mở rộng cho mọi chủng tộc.","example":"The park was designed to integrate all families.","exampleTranslation":"Công viên được thiết kế để mở rộng cho mọi gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"integrative":{"definition":"Để mở rộng cho mọi người, để mở rộng cho mọi chủng tộc.","example":"The club has an integrative approach for all.","exampleTranslation":"Câu lạc bộ có một cách tiếp cận để mở rộng cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"interact":{"definition":"Ảnh hưởng lẫn nhau, tác động qua lại.","example":"People interact more when they work together.","exampleTranslation":"Mọi người ảnh hưởng lẫn nhau nhiều hơn khi họ làm việc cùng nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"interaction":{"definition":"Tương tác, sự ảnh hưởng lẫn nhau.","example":"Social interaction is important for children to develop well.","exampleTranslation":"Sự tương tác xã hội là quan trọng để trẻ phát triển tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"interfere":{"definition":"Gây trở ngại, quấy rầy.","example":"Loud noises interfere with my ability to sleep.","exampleTranslation":"Tiếng ồn lớn gây trở ngại đến khả năng ngủ của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"interference":{"definition":"Sự gây trở ngại, sự quấy rầy; điều gây trở ngại.","example":"Noise from the street caused interference during class.","exampleTranslation":"Tiếng ồn từ con phố gây ra sự gây trở ngại trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"interplay":{"definition":"Ảnh hưởng lẫn nhau; sự tác động lẫn nhau[, intə'plei].","example":"There is strong interplay between sound and light.","exampleTranslation":"Có sự ảnh hưởng lẫn nhau mạnh mẽ giữa âm thanh và ánh sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"interrelationship":{"definition":"Mối quan hệ (tình cảm, bà con... ) qua lại.","example":"Their interrelationship grew stronger over time.","exampleTranslation":"Mối quan hệ qua lại của họ trở nên bền chặt hơn theo thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"introduce":{"definition":"Giới thiệu.","example":"Let me introduce you to my new colleague.","exampleTranslation":"Hãy để tôi giới thiệu bạn với đồng nghiệp mới của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"introduction":{"definition":"Sự bước đầu làm quen cho, sự khai tâm, sự vỡ lòng.","example":"This book is a good introduction to birds.","exampleTranslation":"Cuốn sách này là một sự bước đầu làm quen tốt cho các loài chim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"invite":{"definition":"Đem lại.","example":"His rude behavior might invite some trouble.","exampleTranslation":"Hành vi thô lỗ của anh ấy có thể đem lại một số rắc rối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"involve":{"definition":"Cuộn vào, quấn lại.","example":"She will involve the scarf around her neck.","exampleTranslation":"Cô ấy sẽ cuộn vào chiếc khăn quanh cổ mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"involvement":{"definition":"Sự tham gia.","example":"Her involvement in the club was very active.","exampleTranslation":"Sự tham gia của cô ấy trong câu lạc bộ rất tích cực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"join":{"definition":"Thắt chặt, hợp nhất, kết hợp, liên hiệp; kết giao, kết thân.","example":"They decided to join forces for the project.","exampleTranslation":"Họ quyết định hợp nhất sức mạnh cho dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"jointly":{"definition":"Cùng, cùng nhau, cùng chung.","example":"They will jointly manage the new project.","exampleTranslation":"Họ sẽ cùng chung quản lý dự án mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"kiss":{"definition":"Sự chạm nhẹ (của hai hòn bi-a đang lăn).","example":"The cue ball made a kiss on the other ball.","exampleTranslation":"Bi cái đã chạm nhẹ vào hòn bi kia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"launder":{"definition":"Giặt là.","example":"Please launder these towels tonight.","exampleTranslation":"Làm ơn giặt là mấy cái khăn này tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"leader":{"definition":"Lãnh tụ, người lãnh đạo, người chỉ huy, người hướng dẫn, người chỉ đạo.","example":"She is a strong leader in our class.","exampleTranslation":"Cô ấy là một lãnh tụ mạnh mẽ trong lớp chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"leadership":{"definition":"Sự lãnh đạo.","example":"She showed great leadership during the difficult project.","exampleTranslation":"Cô ấy đã thể hiện sự lãnh đạo tuyệt vời trong dự án khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"liar":{"definition":"Kẻ nói dối, kẻ nói láo, kẻ nói điêu; kẻ hay nói dối, kẻ hay nói điêu.","example":"No one trusted the liar in the room.","exampleTranslation":"Không ai tin kẻ nói dối trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"liberal":{"definition":"Rộng rãi, hào phóng.","example":"She was generous and always liberal with help.","exampleTranslation":"Cô ấy rất rộng rãi và luôn hào phóng với sự giúp đỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"liberate":{"definition":"Tha, thả, giải phóng, phóng thích, cho tự do.","example":"They liberate the birds after healing them.","exampleTranslation":"Họ thả những con chim sau khi chữa lành chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"lied":{"definition":"Quá khứ và phân từ quá khứ của lie","example":"He lied about his age on the form.","exampleTranslation":"Anh ấy đã nói dối về tuổi của mình trên đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"lies":{"definition":"Động từ chia ở ngôi thứ ba số ít của lie","example":"She lies down after a long walk.","exampleTranslation":"Cô ấy nằm xuống sau một quãng đường đi bộ dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"lifestyle":{"definition":"lối sống","example":"His lifestyle was not a good example for young people.","exampleTranslation":"Lối sống của anh ta không phải là một ví dụ tốt cho những người trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"society"},"localisation":{"definition":"Sự hạn định vào một nơi, sự hạn định vào một địa phương.","example":"Localisation helped the ape fit each market.","exampleTranslation":"Sự hạn định vào địa phương đã giúp sản phẩm phù hợp với từng thị trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"localise":{"definition":"Hạn định vào một nơi, hạn định vào một địa phương.","example":"We localise the problem before calling repair staff.","exampleTranslation":"Chúng tôi hạn định vào một địa phương cho vấn đề trước khi gọi nhân viên sửa chữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"localized":{"definition":"Quá khứ và phân từ quá khứ của localize","example":"The team localized the message for readers.","exampleTranslation":"Nhóm đã hạn định vào một địa phương tin nhắn cho độc giả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"loser":{"definition":"Người thua (cuộc, bạc); ngựa... (thua cuộc đua... ).","example":"A good loser accepts defeat with great grace.","exampleTranslation":"Một người thua cuộc tốt chấp nhận thất bại với sự duyên dáng tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"loyal":{"definition":"Người trung nghĩa, người trung kiên.","example":"A loyal stood beside the family for years.","exampleTranslation":"Một người trung nghĩa đã đứng bên cạnh gia đình trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"loyalty":{"definition":"Lòng trung thành, lòng trung nghĩa, lòng trung kiên.","example":"The loyalty played a key role.","exampleTranslation":"Lòng trung thành đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"lying":{"definition":"hiện tại phân từ của lie","example":"She was lying on the grass and reading.","exampleTranslation":"Cô ấy đang nằm trên cỏ và đọc sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"mainstream":{"definition":"Thị hiếu đại chúng.","example":"The song was too odd for mainstream taste.","exampleTranslation":"Bài hát quá kỳ lạ đối với thị hiếu đại chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"major":{"definition":"Thiếu tá (lục quân) (tương đương).","example":"The major led the team with calm confidence.","exampleTranslation":"Vị thiếu tá đã dẫn dắt đội với sự tự tin bình tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"majority":{"definition":"đa số; phần lớn","example":"The majority vote will win.","exampleTranslation":"Phiếu bầu của đa số sẽ giành chiến thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"society"},"manner":{"definition":"Cách, lối, thói, kiểu.","example":"She spoke in a very polite manner today.","exampleTranslation":"Hôm nay cô ấy nói chuyện với một cách rất lịch sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"meddle":{"definition":"Xen vào, dính vào, can thiệp vào.","example":"Please do not meddle in my private affairs.","exampleTranslation":"Làm ơn đừng xen vào công việc riêng của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"membership":{"definition":"Tư cách hội viên, địa vị hội viên.","example":"You need a membership card to enter here.","exampleTranslation":"Bạn cần một thẻ hội viên để vào đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"merit":{"definition":"Giá trị.","example":"A man of merit will receive a promotion.","exampleTranslation":"Một người có giá trị sẽ nhận được sự thăng tiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"migrant":{"definition":"Di trú.","example":"Many migrant birds fly south for the winter.","exampleTranslation":"Nhiều loài chim di trú bay về phương nam để tránh mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"migrate":{"definition":"Di trú, di cư; ra nước ngoài.","example":"Birds migrate when the weather turns cold.","exampleTranslation":"Chim di cư khi thời tiết trở lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"minor":{"definition":"Nhỏ (hơn), không quan trọng, thứ yếu.","example":"Please do not worry about such minor mistakes.","exampleTranslation":"Xin đừng lo lắng về những lỗi nhỏ nhặt như vậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"mission":{"definition":"Sứ mệnh, nhiệm vụ.","example":"What is the main mission of this project?","exampleTranslation":"Sứ mệnh chính của dự án này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"mobilise":{"definition":"Huy động, động viên.","example":"We mobilise volunteers before the event.","exampleTranslation":"Chúng tôi huy động các tình nguyện viên trước sự kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"modest":{"definition":"Khiêm tốn, nhún nhường, nhũn nhặn.","example":"He was very modest about his great success.","exampleTranslation":"Anh ấy rất khiêm tốn về sự thành công lớn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"moralist":{"definition":"Nhà luân lý học, nhà đạo đức học.","example":"The moralist wrote books about right and wrong.","exampleTranslation":"Nhà đạo đức học đã viết những cuốn sách về đúng và sai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"mourn":{"definition":"Than khóc, thương tiếc.","example":"Many people mourn the loss of their friends.","exampleTranslation":"Nhiều người thương tiếc sự mất mát của bạn bè họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"mutual":{"definition":"Lẫn nhau, qua lại.","example":"They share a sense of mutual affection for each other.","exampleTranslation":"Họ chia sẻ cảm giác yêu mến lẫn nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"nagging":{"definition":"Sự rầy la.","example":"The teacher's nagging finally made him study.","exampleTranslation":"Sự rầy la của giáo viên cuối cùng đã làm anh ấy học bài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"native":{"definition":"Tự nhiên, bẩm sinh.","example":"The bird has a native ability to fly high.","exampleTranslation":"Con chim có khả năng bẩm sinh để bay cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"neglect":{"definition":"Sự sao lãng, sự cẩu thả, sự không chú ý.","example":"His neglect of duty caused many problems at work.","exampleTranslation":"Sự sao lãng nhiệm vụ của anh ấy đã gây ra nhiều vấn đề tại nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"neighbour":{"definition":"Người đồng loại.","example":"We should always be kind to our neighbour.","exampleTranslation":"Chúng ta nên luôn tử tế với người đồng loại của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"noble":{"definition":"Quý tộc, quý phái.","example":"She was proud of her noble birth and history.","exampleTranslation":"Cô ấy tự hào về dòng dõi và lịch sử quý tộc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"norm":{"definition":"Quy tắc tiêu chuẩn.","example":"This rule is our main norm at school.","exampleTranslation":"Quy tắc này là tiêu chuẩn chính của chúng tôi ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"nuisance":{"definition":"Mối gây thiệt hại, mối gây khó chịu, mối làm phiền toái, mối làm rầy, mối làm phiền.","example":"Please stop being such a nuisance in my workspace.","exampleTranslation":"Vui lòng ngừng làm phiền toái trong không gian làm việc của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"obey":{"definition":"Vâng lời nghe lời, tuân theo, tuân lệnh.","example":"Children should obey their parents.","exampleTranslation":"Trẻ em nên tuân theo cha mẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"objection":{"definition":"Sự phản đối, sự chống đối.","example":"He raised an objection during the important meeting.","exampleTranslation":"Anh ấy đã đưa ra một sự phản đối trong cuộc họp quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"obligation":{"definition":"Nghĩa vụ, bổn phận.","example":"It is your obligation to tell the truth.","exampleTranslation":"Nghĩa vụ của bạn là phải nói sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"obligatory":{"definition":"Bắt buộc, cưỡng bách.","example":"Wearing a helmet is obligatory here.","exampleTranslation":"Việc đội mũ bảo hiểm là bắt buộc ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"oblige":{"definition":"Làm ơn, gia ơn, giúp đỡ.","example":"Could you please oblige me with a small favor?","exampleTranslation":"Bạn có thể vui lòng giúp đỡ tôi một việc nhỏ được không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"opinion":{"definition":"Ý kiến, quan điểm.","example":"What is your opinion on this new plan?","exampleTranslation":"Quan điểm của bạn về kế hoạch mới này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"oppose":{"definition":"Đối kháng, đối lại, đối chọi, đối lập.","example":"They chose to oppose the new government policy.","exampleTranslation":"Họ chọn đối kháng lại chính sách chính phủ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"opposition":{"definition":"Sự chống lại, sự chống cự, sự phản đối.","example":"They offered a determined opposition to the law.","exampleTranslation":"Họ đã đưa ra sự phản đối kiên quyết đối với luật pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"orderly":{"definition":"Có nhiệm vụ truyền mệnh lệnh, có nhiện vụ thi hành mệnh lệnh.","example":"Please keep the queue in an orderly line.","exampleTranslation":"Vui lòng giữ hàng đợi theo hàng ngũ có nhiệm vụ truyền mệnh lệnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"organisation":{"definition":"tổ chức; cơ quan","example":"The daycare is operated by a voluntary organisation of parents and teachers.","exampleTranslation":"Nhà trẻ được vận hành bởi một tổ chức tình nguyện của các bậc phụ huynh và giáo viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"society","spellingNote":"Alternate spelling: organization."},"organization":{"definition":"Sự tổ chức, sự cấu tạo.","example":"The organization helps the poor every year.","exampleTranslation":"Tổ chức này giúp đỡ người nghèo mỗi năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society","spellingNote":"British spelling: organisation."},"organize":{"definition":"Tổ chức, cấu tạo, thiết lập.","example":"Please organize your files before you leave today.","exampleTranslation":"Vui lòng sắp xếp các tệp của bạn trước khi bạn rời đi hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"organizer":{"definition":"Người tổ chức.","example":"The organizer made a clear plan.","exampleTranslation":"Người tổ chức đã lập một kế hoạch rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"outsider":{"definition":"người ngoài cuộc; người không thể cho nhập bọn.","example":"I felt like an outsider at the party.","exampleTranslation":"Tôi cảm thấy như một người ngoài cuộc tại buổi tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"pander":{"definition":"Ma cô, kẻ dắt gái (cho khách làng chơi); kẻ làm mai mối cho những mối tình bất chính.","example":"The pander promised easy fame to the crowd.","exampleTranslation":"Kẻ môi giới đã hứa hẹn sự nổi tiếng dễ dàng cho đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"panel":{"definition":"Một vùng hình chữ nhật, làm tường hay hàng rào.","example":"A panel helped the team.","exampleTranslation":"Một hội đồng đã giúp đỡ cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"parish":{"definition":"Giáo xứ, giáo khu, xứ đạo, chín xứ.","example":"They attended a service at the local parish church.","exampleTranslation":"Họ đã tham dự một buổi lễ tại nhà thờ địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"partake":{"definition":"Cùng tham dự, cùng thực hiện, cùng có phần, cùng hưởng, cùng chia sẻ (một hoạt động, một sự kiện).","example":"Would you like to partake in our dinner tonight?","exampleTranslation":"Bạn có muốn cùng tham dự bữa tối của chúng tôi tối nay không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"participant":{"definition":"Người tham gia, người tham dự.","example":"Every participant received a small badge.","exampleTranslation":"Mỗi người tham dự đều nhận được một tấm huy hiệu nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"participate":{"definition":"Tham gia, tham dự; cùng góp phần.","example":"Would you like to participate in our local club?","exampleTranslation":"Bạn có muốn tham gia câu lạc bộ địa phương của chúng tôi không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"participation":{"definition":"Sự tham gia, sự tham dự, sự góp phần vào.","example":"Her participation made the event more lively.","exampleTranslation":"Sự tham gia của cô ấy làm cho sự kiện trở nên sôi nổi hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"partner":{"definition":"Bạn cùng phe (trong một trò chơi).","example":"He was my partner in the card game.","exampleTranslation":"Anh ấy là bạn cùng phe của tôi trong trò chơi bài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"partnership":{"definition":"Mối quan hệ đối tác.","example":"The firms formed a partnership to share costs.","exampleTranslation":"Các công ty đã thành lập một quan hệ đối tác để chia sẻ chi phí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"party":{"definition":"bữa tiệc; đảng phái; nhóm người","example":"I'm throwing a huge party for my 21st birthday. There'll be cake, games, and lots of fun!","exampleTranslation":"Tôi đang tổ chức một bữa tiệc lớn cho sinh nhật lần thứ 21 của mình. Sẽ có bánh, trò chơi, và rất nhiều niềm vui!","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"society"},"peace":{"definition":"Hoà bình, thái bình, sự hoà thuận.","example":"We all want peace in our beautiful world.","exampleTranslation":"Tất cả chúng ta đều muốn hòa bình trong thế giới xinh đẹp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"peaceful":{"definition":"Hoà bình, thái bình.","example":"They hope for a peaceful life in the countryside.","exampleTranslation":"Họ hy vọng về một cuộc sống thái bình ở vùng quê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"peacefully":{"definition":"Hoà bình, thái bình.","example":"He moved peacefully through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách hòa bình xuyên qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"peasantry":{"definition":"Giai cấp nông dân.","example":"The peasantry lived simply and worked hard.","exampleTranslation":"Giai cấp nông dân sống giản dị và làm việc chăm chỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"peer":{"definition":"Khanh tướng (Anh), người quý tộc; huân tước.","example":"A peer spoke at the ceremony.","exampleTranslation":"Một vị huân tước đã phát biểu tại buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"permanent":{"definition":"Lâu dài, lâu bền, vĩnh cửu, thường xuyên, thường trực; cố định.","example":"They moved into a permanent apartment last year.","exampleTranslation":"Họ đã chuyển vào một căn hộ lâu dài từ năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"personal":{"definition":"Cá nhân, tư, riêng.","example":"You should keep your personal information very private.","exampleTranslation":"Bạn nên giữ thông tin cá nhân của mình thật riêng tư.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"personalize":{"definition":"Cá nhân hoá (biến thành chuyện riêng tư).","example":"We personalize the card with a short note.","exampleTranslation":"Chúng tôi cá nhân hóa tấm thiệp bằng một ghi chú ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"personally":{"definition":"Đích thân, với tư cách cá nhân (không đại diện bởi người khác).","example":"He left personally after lunch.","exampleTranslation":"Anh ấy đã rời đi đích thân sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"philanthropic":{"definition":"Yêu người, thương người; nhân đức.","example":"The philanthropic club helped local families.","exampleTranslation":"Câu lạc bộ nhân đức đã giúp đỡ các gia đình địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"philanthropy":{"definition":"Lòng yêu người, lòng nhân đức.","example":"Her philanthropy helped many local families.","exampleTranslation":"Lòng yêu người của cô ấy đã giúp đỡ nhiều gia đình địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"playboy":{"definition":"Kẻ ăn chơi.","example":"He acted like a bored playboy.","exampleTranslation":"Anh ta hành động như một gã ăn chơi chán chường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"playmate":{"definition":"Bạn cùng chơi (trong trò chơi trẻ con).","example":"His playmate built a tall tower from wooden blocks.","exampleTranslation":"Bạn cùng chơi của cậu bé đã xây một tòa tháp cao từ những khối gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"plight":{"definition":"Hoàn cảnh, cảnh ngộ (khốn khổ, tuyệt vọng... ).","example":"The refugees are in a desperate plight.","exampleTranslation":"Những người tị nạn đang ở trong một cảnh ngộ tuyệt vọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"pontifical":{"definition":"Giáo hoàng.","example":"She wore a pontifical robe during the service.","exampleTranslation":"Cô ấy mặc áo choàng giáo hoàng trong suốt buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"popular":{"definition":"Có tính chất đại chúng, hợp với nhân dân, hợp với trình độ nhân dân, phổ cập.","example":"They are trying to learn a popular language now.","exampleTranslation":"Họ đang cố gắng học một ngôn ngữ phổ cập hiện nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"popularity":{"definition":"Tính phổ biến.","example":"The popularity of this new game is growing fast.","exampleTranslation":"Tính phổ biến của trò chơi mới này đang tăng nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"popularize":{"definition":"Truyền bá, phổ biến.","example":"Teachers help popularize reading among children.","exampleTranslation":"Các giáo viên giúp truyền bá việc đọc sách trong trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"populate":{"definition":"Ở, cư trú (một vùng).","example":"Many families populate this valley.","exampleTranslation":"Nhiều gia đình ở thung lũng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"post":{"definition":"Cột trụ.","example":"A wooden post holds up the garden fence.","exampleTranslation":"Một cột trụ gỗ đỡ hàng rào khu vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"predecessor":{"definition":"Người đi trước, người đảm nhiệm trước, người phụ trách trước (công tác gì... ).","example":"My predecessor left many tasks for me.","exampleTranslation":"Người tiền nhiệm của tôi đã để lại nhiều nhiệm vụ cho tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"predominance":{"definition":"Ưu thế, thế trội.","example":"She saw the predominance yesterday.","exampleTranslation":"Cô ấy đã thấy sự chiếm ưu thế vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"predominantly":{"definition":"mostly, mainly","example":"The predominantly male, white judges treat men and women differently.","exampleTranslation":"Các thẩm phán da trắng, nam giới chiếm đa số, đối xử với nam giới và nữ giới khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"society"},"preside":{"definition":"Giữ bè (pianô... ).","example":"He likes to preside at the piano tonight.","exampleTranslation":"Anh ấy thích chơi đàn piano tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"prestige":{"definition":"Uy tín; thanh thế.","example":"She saw the prestige yesterday.","exampleTranslation":"Cô ấy đã thấy uy tín vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"prestigious":{"definition":"Có uy tín, có thanh thế; đem lại uy tín, đem lại thanh thế.","example":"That prestigious award took years of effort.","exampleTranslation":"Giải thưởng danh giá đó đã mất nhiều năm nỗ lực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"prevail":{"definition":"Khiến, thuyết phục.","example":"I tried to prevail upon him to stay.","exampleTranslation":"Tôi đã cố gắng thuyết phục anh ấy ở lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"prevalence":{"definition":"Sự thường xảy ra, sự thịnh hành, sự lưu hành, sự phổ biến khắp, sự lan khắp.","example":"The prevalence of colds rises in winter.","exampleTranslation":"Tỷ lệ mắc cảm lạnh tăng lên vào mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"prevalent":{"definition":"Thường thấy, thịnh hành, đang lưu hành.","example":"This disease is very prevalent in this area.","exampleTranslation":"Căn bệnh này rất phổ biến ở khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"priest":{"definition":"Thầy tu, thầy tế, linh mục (Công giáo).","example":"She saw the priest yesterday.","exampleTranslation":"Cô ấy đã gặp vị linh mục vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"prince":{"definition":"Tay cự phách, chúa trùm.","example":"He is a prince of business in this city.","exampleTranslation":"Anh ấy là một ông hoàng kinh doanh ở thành phố này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"private":{"definition":"Riêng, mật, kín.","example":"This secret is for my private ear only.","exampleTranslation":"Bí mật này chỉ dành riêng cho tai tôi thôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"privately":{"definition":"Riêng, tư, cá nhân.","example":"He left privately after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách riêng tư sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"privilege":{"definition":"Đặc quyền, đặc ân.","example":"Quiet time after lunch is a real privilege.","exampleTranslation":"Thời gian yên tĩnh sau bữa trưa là một đặc ân thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"prize":{"definition":"Giải thưởng, phần thưởng.","example":"She won the first prize in the competition.","exampleTranslation":"Cô ấy đã giành giải nhất trong cuộc thi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"prominence":{"definition":"Tình trạng lồi lên, tình trạng nhô lên; chỗ lồi lên, chỗ nhô lên.","example":"The mountain peak has a lot of prominence.","exampleTranslation":"Đỉnh núi có rất nhiều sự nổi bật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"prominent":{"definition":"Lồi lên, nhô lên.","example":"The rock had a prominent point on top.","exampleTranslation":"Tảng đá có một điểm nhô ra trên đỉnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"prominently":{"definition":"Lồi lên, nhô lên.","example":"The team finished prominently and left.","exampleTranslation":"Đội đã hoàn thành một cách nổi bật và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"protest":{"definition":"Sự phản đối, sự phản kháng, sự kháng nghị; lời phản đối, lời phản kháng, lời kháng nghị.","example":"They marched in protest against the new tax policy.","exampleTranslation":"Họ đã biểu tình để phản đối chính sách thuế mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"pushover":{"definition":"Việc dễ làm, việc ngon xơi, cái làm được dễ dàng.","example":"Fixing the chair was a pushover.","exampleTranslation":"Việc sửa cái ghế rất dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"pyjamas":{"definition":"Pijama, quần áo ngủ.","example":"I packed my pyjamas for the trip.","exampleTranslation":"Tôi đã đóng gói đồ ngủ của mình cho chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"radical":{"definition":"Gốc, căn bản.","example":"We need to make a radical change today.","exampleTranslation":"Chúng ta cần thực hiện một thay đổi triệt để hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"rally":{"definition":"Củng cố lại, trấn tĩnh lại.","example":"The coach tried to rally the team's spirit.","exampleTranslation":"Huấn luyện viên đã cố gắng khơi dậy tinh thần của cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"reconcile":{"definition":"Giải hòa, giảng hòa, làm cho hòa thuận, làm cho hài hòa.","example":"We must reconcile one person with another today.","exampleTranslation":"Chúng ta phải hòa giải người này với người kia ngay hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"refuge":{"definition":"Nơi nương náu, nơi nương tựa.","example":"She is a refuge for many lonely people.","exampleTranslation":"Cô ấy là nơi nương tựa cho nhiều người cô đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"repercussion":{"definition":"Sự dội lại (âm thanh); âm vang, tiếng vọng.","example":"The decision had a serious repercussion on the team.","exampleTranslation":"Quyết định đó đã gây ra hậu quả nghiêm trọng cho cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"reputable":{"definition":"Có tiếng tốt, danh giá; đáng kính trọng.","example":"They chose a reputable school for their child.","exampleTranslation":"Họ đã chọn một ngôi trường danh giá cho con mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"reputation":{"definition":"Tiếng (xấu, tốt... ).","example":"He has a good reputation in this industry.","exampleTranslation":"Anh ấy có uy tín tốt trong ngành này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"rescue":{"definition":"Sự cưỡng đoạt lại (tài sản).","example":"The rescue of the lost bike was quick.","exampleTranslation":"Việc cứu chiếc xe đạp bị mất diễn ra rất nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"respect":{"definition":"Mối quan hệ, mối liên quan.","example":"We have questions with respect to the plan.","exampleTranslation":"Chúng tôi có những câu hỏi liên quan đến kế hoạch này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"responsibility":{"definition":"Trách nhiệm.","example":"It is your responsibility to finish the project.","exampleTranslation":"Bạn có trách nhiệm hoàn thành dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"responsible":{"definition":"Chịu trách nhiệm.","example":"Who is responsible for this big project today?","exampleTranslation":"Ai là người chịu trách nhiệm cho dự án lớn này hôm nay?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"retreat":{"definition":"Sự rút lui, sự rút quân; hiệu lệnh rút quân.","example":"The army ordered a sudden retreat from the city.","exampleTranslation":"Quân đội đã ra lệnh rút quân bất ngờ khỏi thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"reunion":{"definition":"Cuộc hội họp, cuộc họp mặt thân mật.","example":"Our family reunion will be held this Sunday.","exampleTranslation":"Cuộc họp mặt gia đình của chúng tôi sẽ được tổ chức vào Chủ nhật này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"reverence":{"definition":"Sự tôn kính; lòng sùng kính, lòng kính trọng.","example":"You should hold your elders in great reverence.","exampleTranslation":"Bạn nên kính trọng những người lớn tuổi hơn mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"reversal":{"definition":"Sự huỷ bỏ, sự thủ thiêu (một bản án).","example":"The court ordered a reversal of the ruling.","exampleTranslation":"Tòa án đã ra lệnh hủy bỏ phán quyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"reversion":{"definition":"Quyền đòi lại, quyền thu hồi.","example":"The owner kept a reversion for the old house.","exampleTranslation":"Người chủ đã giữ lại quyền đòi lại đối với ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"revert":{"definition":"Người trở lại với niềm tin ban đầu.","example":"He was a revert who found comfort in old beliefs.","exampleTranslation":"Anh ấy là người trở lại với những niềm tin cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"revitalise":{"definition":"đem lại sức sống mới, đưa sức sống mới vào (cái gì); tái sinh.","example":"A small garden can revitalise a tired yard.","exampleTranslation":"Một khu vườn nhỏ có thể đem lại sức sống mới cho một sân vườn buồn tẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society","spellingNote":"Alternate spelling: revitalize."},"revitalization":{"definition":"tình trạng đem lại sức sống mới, tình trạng đưa sức sống mới vào (cái gì); sự tái sinh.","example":"The new park brought revitalization to the town.","exampleTranslation":"Công viên mới đã đem lại sự tái sinh cho thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"revitalize":{"definition":"Đem lại sức sống mới, đưa sức sống mới vào (cái gì); tái sinh.","example":"A new park could revitalize the neighborhood.","exampleTranslation":"Một công viên mới có thể đem lại sức sống mới cho khu phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society","spellingNote":"British spelling: revitalise."},"revival":{"definition":"Sự làm thức tỉnh lại lòng mộ đạo; sự gây lại niềm tin.","example":"The meeting led to a revival of hope.","exampleTranslation":"Cuộc họp đã dẫn đến sự khơi dậy niềm hy vọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"revive":{"definition":"Đem diễn lại.","example":"The theater group wants to revive a classic play.","exampleTranslation":"Nhóm nhà hát muốn đem diễn lại một vở kịch kinh điển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"reward":{"definition":"Sự thưởng, sự thưởng công; sự báo ơn, sự báo oán.","example":"Hard work brought her a fair reward.","exampleTranslation":"Công việc khó khăn đã mang lại cho cô ấy một phần thưởng xứng đáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"rife":{"definition":"Lan tràn, lưu hành, thịnh hành; hoành hành.","example":"Rumors of war were rife in the village.","exampleTranslation":"Những lời đồn đại về chiến tranh hoành hành khắp ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"rightly":{"definition":"Phải, đúng, đúng đắn; có lý; công bằng.","example":"She spoke rightly during the meeting.","exampleTranslation":"Cô ấy đã phát biểu một cách đúng đắn trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"risk":{"definition":"Sự liều, sự mạo hiểm.","example":"Taking a big risk can lead to great success.","exampleTranslation":"Chấp nhận rủi ro lớn có thể dẫn đến thành công vang dội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"risky":{"definition":"Liều, mạo hiểm.","example":"Her answer seemed risky to me.","exampleTranslation":"Câu trả lời của cô ấy có vẻ mạo hiểm đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"rival":{"definition":"Đối thủ, địch thủ, người kình địch, người cạnh tranh.","example":"She has no rival in this sport.","exampleTranslation":"Cô ấy không có đối thủ trong môn thể thao này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"rivalry":{"definition":"Sự cạnh tranh, sự kình địch, sự ganh đua, sự tranh tài, sự đua tài.","example":"There is a fierce rivalry between the two teams.","exampleTranslation":"Có một sự kình địch dữ dội giữa hai đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"rude":{"definition":"Khiếm nhã, bất lịch sự, vô lễ, láo xược; thô lỗ.","example":"It is very rude to interrupt people while they speak.","exampleTranslation":"Thật là khiếm nhã khi ngắt lời người khác trong khi họ đang nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"safe":{"definition":"An toàn, chắc chắn.","example":"You feel safe when you are at home.","exampleTranslation":"Bạn cảm thấy an toàn khi ở nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"safely":{"definition":"An toàn, chắc chắn (được che chở khỏi nguy hiểm, thiệt hại).","example":"They worked safely all day.","exampleTranslation":"Họ đã làm việc một cách an toàn cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"save":{"definition":"Cứu nguy.","example":"He tried to save the child from drowning.","exampleTranslation":"Anh ấy cố gắng cứu đứa trẻ khỏi bị chết đuối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"seclusion":{"definition":"Chỗ hẻo lánh, chỗ khuất nẻo.","example":"They found a quiet seclusion near the hills.","exampleTranslation":"Họ tìm thấy một chỗ hẻo lánh gần những ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"secret":{"definition":"Kín đáo, thầm kín, bí mật; riêng tư.","example":"She kept a secret about her new job.","exampleTranslation":"Cô ấy giữ một bí mật về công việc mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"secularism":{"definition":"Chủ nghĩa thế tục.","example":"She supported secularism in public schools.","exampleTranslation":"Cô ấy ủng hộ chủ nghĩa thế tục trong các trường công lập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"senior":{"definition":"Nhiều tuổi hơn, cao cấp hơn, lâu năm hơn, ở trình độ cao hơn; ở trình độ cao nhất.","example":"The senior members of the family gathered in the hall.","exampleTranslation":"Các thành viên lâu năm hơn của gia đình đã tụ tập trong hội trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"separation":{"definition":"Sự phân ly, sự chia cắt.","example":"The separation was hard for both of them.","exampleTranslation":"Sự phân ly đã khó khăn cho cả hai người họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"servant":{"definition":"Bầy tôi trung thành.","example":"He is a loyal servant to his family.","exampleTranslation":"Anh ấy là một bầy tôi trung thành với gia đình mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"severe":{"definition":"Khắt khe, gay gắt (trong thái độ, cách cư xử).","example":"The teacher gave us a severe warning.","exampleTranslation":"Giáo viên đã đưa cho chúng tôi một lời cảnh báo khắt khe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"severely":{"definition":"Nghiêm khắc; nghiêm nghị.","example":"He moved severely through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách nghiêm khắc qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"society"},"situation":{"definition":"Vị trí, địa thế.","example":"This hotel is unrivalled for situation near the beach.","exampleTranslation":"Khách sạn này có vị trí không đâu sánh bằng gần bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"sneak":{"definition":"Trốn, lén.","example":"You should not sneak into the house at night.","exampleTranslation":"Bạn không nên lén vào nhà vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"sociology":{"definition":"Xã hội học.","example":"She is studying sociology at the university.","exampleTranslation":"Cô ấy đang học xã hội học tại trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"status":{"definition":"Địa vị, thân phận, thân thế.","example":"What is your official status in this company?","exampleTranslation":"Địa vị chính thức của bạn trong công ty này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"straggler":{"definition":"Người đi không theo hàng theo lối.","example":"One straggler arrived after the group.","exampleTranslation":"Một người đi không theo hàng theo lối đã đến sau cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"stranger":{"definition":"Người lạ mặt, người xa lạ.","example":"A stranger was waiting at the bus stop.","exampleTranslation":"Một người lạ mặt đang đợi tại trạm xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"struggle":{"definition":"Vùng vẫy, vật lộn, gặp khó khăn.","example":"They struggle for their living every single day.","exampleTranslation":"Họ vật lộn cho cuộc sống mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"superstition":{"definition":"Sự mê tín.","example":"His superstition made him avoid ladders.","exampleTranslation":"Sự mê tín khiến anh ấy tránh các bậc thang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"support":{"definition":"Sự ủng hộ.","example":"She gave her full support to the new plan.","exampleTranslation":"Cô ấy đã dành toàn bộ sự ủng hộ cho kế hoạch mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"supporter":{"definition":"Vật chống đỡ.","example":"The wooden supporter held the shelf in place.","exampleTranslation":"Vật chống đỡ bằng gỗ giữ cho giá đỡ đứng vững tại chỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"teeming":{"definition":"Đầy, đầy ứ, thừa thãi, dồi dào; đông đúc, lúc nhúc.","example":"The market was teeming with people on Sunday morning.","exampleTranslation":"Khu chợ đông đúc với mọi người vào sáng Chủ nhật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"telltale":{"definition":"Người mách lẻo, người hớt lẻo.","example":"The telltale kept sharing everyone ese's secrets.","exampleTranslation":"Người mách lẻo đó cứ tiếp tục chia sẻ bí mật của mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"tolerance":{"definition":"Lòng khoan dung; sự tha thứ; sự chấp nhận.","example":"You must show great tolerance toward your coworkers.","exampleTranslation":"Bạn phải thể hiện lòng khoan dung lớn đối với các đồng nghiệp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"tolerant":{"definition":"Khoan dung, hay tha thứ.","example":"She is tolerant of different opinions.","exampleTranslation":"Cô ấy khoan dung với những ý kiến khác biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"tolerate":{"definition":"Tha thứ, khoan thứ.","example":"I can tolerate a little noise.","exampleTranslation":"Tôi có thể tha thứ một chút tiếng ồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"trend":{"definition":"Phương hướng.","example":"The trend of the coastline changes over time.","exampleTranslation":"Phương hướng của bờ biển thay đổi theo thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"trendiness":{"definition":"Sự hợp thời trang, tính chất rất mốt, sự chạy theo mốt.","example":"The cake's trendiness attracted many young customers.","exampleTranslation":"Sự hợp thời trang của chiếc bánh đã thu hút nhiều khách hàng trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"tribal":{"definition":"Bộ lạc.","example":"Her answer seemed tribal to me.","exampleTranslation":"Câu trả lời của cô ấy có vẻ bộ lạc đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"tribe":{"definition":"Bộ lạc.","example":"The tribe lived near the forest.","exampleTranslation":"Bộ lạc sống gần khu rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"tribesman":{"definition":"Thành viên bộ lạc.","example":"Each tribesman helped build the shelter.","exampleTranslation":"Mỗi thành viên bộ lạc đã giúp xây dựng nơi trú ẩn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"unapproachable":{"definition":"Không thể đến gần được, không thể tới gần được; khó gần (người).","example":"The shy child seemed unapproachable.","exampleTranslation":"Đứa trẻ nhút nhát dường như thật khó gần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"undesirable":{"definition":"Người không ai ưa.","example":"The crowd ignored the undesirable at the door.","exampleTranslation":"Đám đông đã phớt lờ người không ai ưa ở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"unify":{"definition":"Thống nhất, hợp nhất.","example":"She tried to unify the issue.","exampleTranslation":"Cô ấy đã cố gắng thống nhất vấn đề đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"uninvited":{"definition":"Không được mời.","example":"The uninvited guest waited by the door.","exampleTranslation":"Vị khách không được mời đã chờ đợi bên cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"unobtrusive":{"definition":"Khiêm tốn, kín đáo, không phô trương.","example":"His unobtrusive style fit the room.","exampleTranslation":"Phong cách khiêm tốn của anh ấy rất hợp với căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"unrest":{"definition":"Tình trạng không yên ổn, tình trạng náo động.","example":"Public unrest broke out after the new law was passed.","exampleTranslation":"Tình trạng không yên ổn công cộng đã nổ ra sau khi luật mới được thông qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"upright":{"definition":"Ngay thẳng, chính trực, liêm khiết.","example":"We respect him because he is an upright man.","exampleTranslation":"Chúng tôi tôn trọng anh ấy vì anh ấy là một người ngay thẳng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"urchin":{"definition":"Thằng nhóc; thằng nhỏ ranh, thằng ranh con.","example":"The little urchin ran off with a grin.","exampleTranslation":"Thằng nhỏ ranh con chạy đi với một nụ cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"usher":{"definition":"Đưa, dẫn.","example":"A guide will usher you into the museum.","exampleTranslation":"Một người hướng dẫn sẽ đưa bạn vào bảo tàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"utopian":{"definition":"Không tưởng.","example":"His plan for a perfect world was quite utopian.","exampleTranslation":"Kế hoạch của anh ấy cho một thế giới hoàn hảo khá là không tưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"venue":{"definition":"Nơi lập toà xử án.","example":"They decided to change the venue of the party.","exampleTranslation":"Họ đã quyết định thay đổi nơi lập tòa xử án của bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"vice":{"definition":"Thói xấu, nết xấu, thói hư tật xấu.","example":"He overcame a bad vice with steady habits.","exampleTranslation":"Anh ấy đã vượt qua một thói xấu bằng những thói quen đều đặn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"villager":{"definition":"Dân làng, dân nông thôn.","example":"Every villager knew the answer.","exampleTranslation":"Mỗi dân làng đều biết câu trả lời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"visit":{"definition":"Sự đi thăm, sự thăm hỏi, sự thăm viếng.","example":"I will pay my grandmother a visit tomorrow.","exampleTranslation":"Tôi sẽ thăm hỏi bà tôi vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"volunteer":{"definition":"Tình nguyện.","example":"She joined the local volunteer corps last year.","exampleTranslation":"Cô ấy đã tham gia quân đoàn tình nguyện địa phương năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"warden":{"definition":"Cai (nhà lao); hiệu trưởng (trường đại học... ); người quản lý (công viên... ); tổng đốc, thống đốc.","example":"Who is the warden of this large park?","exampleTranslation":"Ai là người quản lý của công viên lớn này?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"society"},"warn":{"definition":"Báo cho biết.","example":"Please warn him of the hidden danger ahead.","exampleTranslation":"Vui lòng báo cho biết anh ấy về nguy hiểm ẩn giấu phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"society"},"welcome":{"definition":"Được tiếp đi ân cần, được hoan nghênh.","example":"You are a welcome guest in our home.","exampleTranslation":"Bạn là một vị khách được tiếp đón ân cần tại nhà chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"society"},"resignation":{"definition":"Hành động rời khỏi một vị trí hoặc công việc theo quyết định của bản thân.","example":"Her resignation prompted the board to begin a search for a successor.","exampleTranslation":"Việc cô từ chức khiến hội đồng bắt đầu tìm người kế nhiệm.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"work"},"employ":{"definition":"Dùng, thuê (ai) (làm gì).","example":"We need to employ more workers this month.","exampleTranslation":"Chúng ta cần thuê thêm nhân viên trong tháng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"employ"},"employable":{"definition":"Có thể dùng được, có thể thuê làm (gì) được.","example":"She is employable and ready for work.","exampleTranslation":"Cô ấy có đủ năng lực làm việc và sẵn sàng cho công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"employ"},"career":{"definition":"Nghề, nghề nghiệp.","example":"She wants to start a career in medicine.","exampleTranslation":"Cô ấy muốn bắt đầu sự nghiệp trong ngành y.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"career"},"occupation":{"definition":"Sự chiếm, sự giữ, sự chiếm giữ, sự chiếm đóng.","example":"The occupation of the city lasted for years.","exampleTranslation":"Cuộc chiếm đóng thành phố kéo dài nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"occupation"},"occupational":{"definition":"Nghề nghiệp.","example":"He suffered from an occupational disease at the factory.","exampleTranslation":"Anh ấy mắc phải một bệnh nghề nghiệp tại nhà máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"occupation"},"profession":{"definition":"Nghề nghiệp; công việc đòi hỏi kiến thức hoặc kỹ năng chuyên môn.","example":"Medicine became her chosen profession after graduation.","exampleTranslation":"Sau khi tốt nghiệp, cô chọn ngành y làm nghề nghiệp.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"profession"},"professional":{"definition":"(Thuộc) nghề, (thuộc) nghề nghiệp.","example":"She has the professional skills needed for this job.","exampleTranslation":"Cô ấy có những kỹ năng chuyên môn cần thiết cho công việc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"profession"},"labor":{"definition":"Lao động.","example":"Hard labor made him stronger.","exampleTranslation":"Lao động chân tay đã giúp anh ấy trở nên mạnh mẽ hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"labor","spellingNote":"British spelling: labour."},"wage":{"definition":"Tiền lương, tiền công.","example":"His wage was enough for rent and food.","exampleTranslation":"Tiền lương của anh ấy đủ cho tiền thuê nhà và thực phẩm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wage"},"salary":{"definition":"Tiền lương.","example":"She works hard to earn a good monthly salary.","exampleTranslation":"Cô ấy làm việc chăm chỉ để kiếm mức lương hàng tháng tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"salary"},"skill":{"definition":"Đáng kể, thành vấn đề.","example":"Practical skill can help workers adapt to new technology.","exampleTranslation":"Kỹ năng thực tế có thể giúp người lao động thích nghi với công nghệ mới.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"skill"},"skilled":{"definition":"Khéo léo, lành nghề.","example":"She is a very skilled woodworker.","exampleTranslation":"Cô ấy là một thợ mộc rất lành nghề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"skill"},"skillful":{"definition":"Khéo tay; tài giỏi.","example":"The skillful baker shaped the bread with care.","exampleTranslation":"Người thợ làm bánh khéo léo đã nặn ổ bánh mì một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"skill"},"recruit":{"definition":"Hội viên mới, thành viên mới (tổ chức, phong trào... ).","example":"Every recruit learned the rules on day one.","exampleTranslation":"Mỗi tân binh đều được học các quy định ngay trong ngày đầu tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"recruit"},"recruiter":{"definition":"Nhà tuyển dụng.","example":"The recruiter called me about the job.","exampleTranslation":"Người tuyển dụng đã gọi điện cho tôi về công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"recruit"},"recruitment":{"definition":"Sự tuyển mộ (lính), sự lấy thêm, sự tuyển thêm (người vào một tổ chức... ).","example":"Recruitment for the new class starts next week.","exampleTranslation":"Việc tuyển dụng cho lớp học mới sẽ bắt đầu vào tuần tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"recruit"},"retired":{"definition":"Ẩn dật, xa lánh mọi người.","example":"They chose a retired life in the countryside.","exampleTranslation":"Họ đã chọn cuộc sống nghỉ hưu ở vùng nông thôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"retir"},"retiring":{"definition":"Kín đáo; khiêm tốn.","example":"His retiring manner made him easy to trust.","exampleTranslation":"Phong thái kín đáo của anh ấy khiến người khác dễ tin tưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"retir"},"productivity":{"definition":"Sức sản xuất; năng suất, hiệu suất.","example":"Higher productivity helped the factory meet rising demand.","exampleTranslation":"Năng suất cao hơn đã giúp nhà máy đáp ứng nhu cầu ngày càng tăng.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"productiv"},"entrepreneur":{"definition":"Chủ doanh nghiệp, nhà thầu, chủ xí nghiệp","example":"The entrepreneur opened a small café that quickly became popular.","exampleTranslation":"Nhà khởi nghiệp mở một quán cà phê nhỏ nhanh chóng trở nên nổi tiếng.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"entrepreneur"},"management":{"definition":"Ban quản lý, ban quản đốc.","example":"The management met to plan next year's goals.","exampleTranslation":"Ban quản lý đã họp để lập kế hoạch cho các mục tiêu của năm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"management"},"business":{"definition":"Việc buôn bán, việc kinh doanh, việc thương mại.","example":"They want to do business with your company.","exampleTranslation":"Họ muốn hợp tác kinh doanh với công ty của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"business"},"intern":{"definition":"Thực tập sinh; người tạm thời làm việc để học và tích lũy kinh nghiệm chuyên môn.","example":"The intern helped analyse data for a public health study.","exampleTranslation":"Thực tập sinh đã hỗ trợ phân tích dữ liệu cho một nghiên cứu sức khỏe cộng đồng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"intern"},"internal":{"definition":"Bản chất; nội tại.","example":"We must look at the internal evidence first.","exampleTranslation":"Chúng ta phải xem xét các bằng chứng nội bộ trước tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"intern"},"internist":{"definition":"Bác sĩ nội khoa.","example":"The internist examined my stomach pain carefully.","exampleTranslation":"Bác sĩ nội khoa đã kiểm tra cơn đau bụng của tôi một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"intern"},"internment":{"definition":"Sự giam giữ, sự bị giam giữ (ở một nơi nhất định).","example":"The internment lasted through the cold winter.","exampleTranslation":"Việc giam giữ kéo dài suốt mùa đông lạnh giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"intern"},"internship":{"definition":"Cương vị học sinh nội trú, chức vị bác sĩ thực tập nội trú.","example":"Her internship taught her useful skills.","exampleTranslation":"Kỳ thực tập đã dạy cho cô ấy những kỹ năng hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"intern"},"workforce":{"definition":"Lực lượng lao động.","example":"The workforce is trained and experienced.","exampleTranslation":"Lực lượng lao động đã được đào tạo và có kinh nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"workforce"},"jobless":{"definition":"Không có việc làm; không có công ăn việc làm.","example":"Many jobless workers searched for work today.","exampleTranslation":"Nhiều người lao động thất nghiệp đã tìm việc làm hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"job"},"jobs":{"definition":"Thuê ngoài; giao công việc cho một cá nhân hoặc đơn vị bên ngoài.","example":"The company jobs out its customer-support work to a specialist provider.","exampleTranslation":"Công ty thuê một đơn vị chuyên môn bên ngoài thực hiện công việc hỗ trợ khách hàng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"job"},"union":{"definition":"Sự hợp nhất, sự kết hợp, sự liên kết; liên minh, liên hiệp.","example":"The union of several companies created a large firm.","exampleTranslation":"Sự hợp nhất của nhiều công ty đã tạo ra một doanh nghiệp lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"union"},"unionisation":{"definition":"Sự tổ chức thành công đoàn.","example":"The unionisation took time and careful meetings.","exampleTranslation":"Việc công đoàn hóa đã mất thời gian và các cuộc họp cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"union","spellingNote":"Alternate spelling: unionization."},"unionise":{"definition":"Tổ chức thành công đoàn (nghiệp đoàn).","example":"Workers plan to unionise for better hours.","exampleTranslation":"Người lao động có kế hoạch thành lập công đoàn để có giờ làm việc tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"union"},"unionism":{"definition":"Chủ nghĩa công đoàn, chủ nghĩa nghiệp đoàn.","example":"Unionism grew stronger in the factory.","exampleTranslation":"Chủ nghĩa công đoàn ngày càng mạnh mẽ trong nhà máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"union"},"unionist":{"definition":"Đoàn viên công đoàn, đoàn viên nghiệp đoàn.","example":"The unionist spoke for safer working hours.","exampleTranslation":"Người ủng hộ công đoàn đã lên tiếng về giờ làm việc an toàn hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"union"},"unionization":{"definition":"Sự tổ chức thành công đoàn.","example":"Unionization helped workers gain better pay.","exampleTranslation":"Việc thành lập công đoàn đã giúp người lao động nhận được mức lương tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"union","spellingNote":"British spelling: unionisation."},"office":{"definition":"Sự giúp đỡ.","example":"The office is on the fifth floor of the building.","exampleTranslation":"Văn phòng nằm ở tầng năm của tòa nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"office"},"training":{"definition":"Sự dạy dỗ, sự rèn luyện; sự đào tạo.","example":"The soldiers need more training before the mission.","exampleTranslation":"Những người lính cần được huấn luyện thêm trước khi thực hiện nhiệm vụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"training"},"employee":{"definition":"người làm, người làm công.","example":"Every employee got a short break.","exampleTranslation":"Mỗi nhân viên đều được nghỉ giải lao ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"employee"},"accountant":{"definition":"Nhân viên kế toán, người giữ sổ sách kế toán.","example":"The accountant checked the numbers carefully.","exampleTranslation":"Nhân viên kế toán đã kiểm tra các con số một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"analyst":{"definition":"Người phân tích.","example":"The analyst explained the results clearly.","exampleTranslation":"Người phân tích đã giải thích các kết quả một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"appointment":{"definition":"Được bổ nhiệm, chức vụ được bổ nhiệm.","example":"She has a new appointment at the clinic.","exampleTranslation":"Cô ấy có một lịch hẹn mới tại phòng khám.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"apprentice":{"definition":"Người học việc, người học nghề.","example":"He is a skilled apprentice at the local bakery.","exampleTranslation":"Anh ấy là một người học việc lành nghề tại tiệm bánh địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"blacksmith":{"definition":"Thợ rèn.","example":"The blacksmith shaped iron with steady blows.","exampleTranslation":"Thợ rèn đã định hình sắt với những nhát đập chắc chắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"boss":{"definition":"Ông trùm (của một tổ chức chính trị).","example":"The boss of the group made the rules.","exampleTranslation":"Ông trùm của nhóm đã đặt ra các quy tắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"builder":{"definition":"Người xây dựng.","example":"The builder fixed the wall before sunset.","exampleTranslation":"Người xây dựng đã sửa bức tường trước khi hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"busyness":{"definition":"Quyền.","example":"He has no busyness in that old land.","exampleTranslation":"Anh ta không có quyền gì ở vùng đất cũ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"carpenter":{"definition":"Thợ mộc.","example":"The carpenter fixed the broken chair.","exampleTranslation":"Thợ mộc đã sửa cái ghế bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"cater":{"definition":"Cung cấp thực phẩm, lương thực.","example":"They cater meals for school events.","exampleTranslation":"Họ cung cấp thực phẩm cho các sự kiện của trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"chairman":{"definition":"Chủ tịch; người chủ toạ (buổi họp).","example":"The chairman opened the meeting on time.","exampleTranslation":"Chủ tịch đã khai mạc cuộc họp đúng giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"chef":{"definition":"Đầu bếp.","example":"The chef prepared soup for everyone.","exampleTranslation":"Đầu bếp đã chuẩn bị súp cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"chief":{"definition":"Người đứng đầu; trưởng.","example":"She was appointed as the chief of the department.","exampleTranslation":"Cô ấy đã được bổ nhiệm làm trưởng bộ phận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"chore":{"definition":"Việc vặt, việc mọn.","example":"Washing dishes is a boring chore.","exampleTranslation":"Rửa bát đĩa là một việc vặt nhàm chán.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"clerk":{"definition":"Người thư ký.","example":"The bank clerk helped me open a new account.","exampleTranslation":"Người thư ký ngân hàng đã giúp tôi mở một tài khoản mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"collaborate":{"definition":"Cộng tác.","example":"They collaborate on every school project.","exampleTranslation":"Họ cộng tác trong mọi dự án học đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"collaboration":{"definition":"Sự cộng tác.","example":"To work in collaboration with others.","exampleTranslation":"Làm việc trong sự cộng tác với những người khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"colleague":{"definition":"Bạn đồng nghiệp, bạn đồng sự.","example":"My colleague helped me finish the report.","exampleTranslation":"Bạn đồng nghiệp đã giúp tôi hoàn thành bản báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"competence":{"definition":"Năng lực, khả năng.","example":"He has no competence for this difficult task.","exampleTranslation":"Anh ấy không có năng lực cho nhiệm vụ khó khăn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"competent":{"definition":"Có đủ khả năng, có đủ trình độ, thạo giỏi.","example":"is he competent for that sort of work?","exampleTranslation":"Anh ấy có đủ khả năng cho loại công việc đó không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"conference":{"definition":"Hội nghị.","example":"The team met at a conference downtown.","exampleTranslation":"Cả đội đã gặp nhau tại một hội nghị ở trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"consult":{"definition":"Hỏi ý kiến, thỉnh thị, thăm dò.","example":"You should consult a lawyer before signing this contract.","exampleTranslation":"Bạn nên hỏi ý kiến luật sư trước khi ký hợp đồng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"consultancy":{"definition":"Cơ quan/văn phòng tư vấn về một lĩnh vực nào đó.","example":"She started her own financial consultancy last year.","exampleTranslation":"Cô ấy đã bắt đầu công ty tư vấn tài chính của riêng mình vào năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"consultant":{"definition":"Thầy thuốc chỉ đạo chuyên môn; thầy thuốc tư vấn.","example":"The consultant checked the child's treatment plan.","exampleTranslation":"Thầy thuốc tư vấn đã kiểm tra kế hoạch điều trị của đứa trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"consultation":{"definition":"Sự bàn bạc, sự thảo luận, sự trao đổi ý kiến, sự hội đàm, sự hội ý.","example":"The doctor suggested a consultation before starting treatment.","exampleTranslation":"Bác sĩ đề nghị một buổi hội ý trước khi bắt đầu điều trị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"delegate":{"definition":"Người được uỷ nhiệm.","example":"He acted as a delegate for the team.","exampleTranslation":"Anh ấy đóng vai trò là người được uỷ nhiệm cho đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"desk":{"definition":"Nơi giao dịch, tiếp đón.","example":"The desk was useful in class.","exampleTranslation":"Bàn làm việc hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"director":{"definition":"Người đạo diễn (phim).","example":"The director cut several scenes from the film.","exampleTranslation":"Người đạo diễn đã cắt bỏ vài cảnh trong bộ phim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"division":{"definition":"Sự chia; sự phân chia.","example":"The division of labor makes the factory efficient.","exampleTranslation":"Sự phân chia lao động làm cho nhà máy hoạt động hiệu quả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"duty":{"definition":"Bổn phận, nhiệm vụ, trách nhiệm.","example":"She decided to do her duty at work.","exampleTranslation":"Cô ấy quyết định hoàn thành bổn phận của mình tại nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"effort":{"definition":"Công sức, sự cố gắng, sự ráng sức; sự cố thử làm.","example":"She finished the task with little effort.","exampleTranslation":"Cô ấy hoàn thành nhiệm vụ với rất ít công sức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"effortlessly":{"definition":"Dễ dàng.","example":"They worked effortlessly all day.","exampleTranslation":"Họ làm việc một cách dễ dàng cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"work"},"endeavor":{"definition":"(như) endeavour.","example":"Her endeavor to learn daily soon improved.","exampleTranslation":"Sự nỗ lực học tập hàng ngày của cô ấy sớm cải thiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"endeavour":{"definition":"Sự cố gắng, sự nỗ lực, sự ráng sức, sự gắng sức.","example":"His hard endeavour finally paid off.","exampleTranslation":"Sự cố gắng chăm chỉ của anh ấy cuối cùng đã được đền đáp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"enlist":{"definition":"Tranh thủ, giành được (cảm tình, sự cộng tác... ).","example":"We must enlist your support for this project.","exampleTranslation":"Chúng ta phải tranh thủ sự hỗ trợ của bạn cho dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"executive":{"definition":"Hành chính.","example":"He holds an important executive position in the company.","exampleTranslation":"Anh ấy giữ một vị trí hành chính quan trọng trong công ty.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"experience":{"definition":"Kinh nghiệm.","example":"She has a lot of experience in this field.","exampleTranslation":"Cô ấy có rất nhiều kinh nghiệm trong lĩnh vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"expert":{"definition":"Chuyên môn, thành thạo, thông thạo, lão luyện.","example":"She is an expert at repairing old watches.","exampleTranslation":"Cô ấy là chuyên môn trong việc sửa chữa những chiếc đồng hồ cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"expertise":{"definition":"Tài chuyên môn; ý kiến về mặt chuyên môn.","example":"We asked for his expertise on the plan.","exampleTranslation":"Chúng tôi đã yêu cầu ý kiến chuyên môn của anh ấy về kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"factory":{"definition":"Đại lý ở nước ngoài (của một số hãng buôn).","example":"The factory sent goods to a distant market.","exampleTranslation":"Đại lý ở nước ngoài đã gửi hàng hóa đến một thị trường xa xôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"finalize":{"definition":"Làm xong, hoàn thành.","example":"We need to finalize the plan today.","exampleTranslation":"Chúng tôi cần hoàn thành kế hoạch hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"fire":{"definition":"Lửa, ánh lửa.","example":"The bright fire burns in the dark night.","exampleTranslation":"Ánh lửa sáng bùng cháy trong đêm tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"fisherman":{"definition":"Thuyền đánh cá.","example":"The fisherman tied the boat to the pier.","exampleTranslation":"Ngư dân đã buộc thuyền vào cầu tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"flexibility":{"definition":"tính linh hoạt; sự mềm dẻo","example":"Current technology allows for greater flexibility in how we do our jobs.","exampleTranslation":"Công nghệ hiện tại cho phép tính linh hoạt lớn hơn trong cách chúng ta thực hiện công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"work"},"flexible":{"definition":"Dễ sai khiến, dễ thuyết phục, dễ uốn nắn.","example":"She is flexible and learns new methods fast.","exampleTranslation":"Cô ấy dễ sai khiến và học các phương pháp mới nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"founder":{"definition":"Người thành lập, người sáng lập.","example":"She was the founder of the small school.","exampleTranslation":"Bà ấy là người thành lập ngôi trường nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"fulfill":{"definition":"Thi hành.","example":"You must fulfill your duties as a manager.","exampleTranslation":"Bạn phải thi hành các nhiệm vụ của mình với tư cách là người quản lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"guild":{"definition":"Phường hội.","example":"The guild met to discuss new members.","exampleTranslation":"Phường hội đã gặp nhau để thảo luận về các thành viên mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"handler":{"definition":"Người điều khiển, người xử dụng (máy... ).","example":"The handler calmed the dog with a soft voice.","exampleTranslation":"Người điều khiển đã làm dịu con chó bằng giọng nói nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"hire":{"definition":"Trả công; thưởng.","example":"The boss will hire him for his skill.","exampleTranslation":"Ông chủ sẽ trả công cho anh ấy vì kỹ năng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"implement":{"definition":"Số nhiều) đồ dùng (đồ đạc quần áo... ), dụng cụ, công cụ; phương tiện.","example":"The farmer used a heavy implement for farming.","exampleTranslation":"Người nông dân đã sử dụng một công cụ nặng để làm nông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"inefficient":{"definition":"Thiếu khả năng, không có khả năng, bất tài.","example":"He was an inefficient driver.","exampleTranslation":"Anh ấy là một người lái xe thiếu khả năng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"keeper":{"definition":"Người quản lý, người chủ (quán... ).","example":"The pub keeper greeted us at the door.","exampleTranslation":"Người quản lý quán chào chúng tôi tại cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"labour":{"definition":"Lao động.","example":"He does manual labour every morning at the farm.","exampleTranslation":"Anh ấy làm lao động chân tay vào mỗi sáng tại trang trại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"labourer":{"definition":"Người lao động chân tay, lao công.","example":"The labourer carried bricks all morning.","exampleTranslation":"Người lao động đã mang gạch suốt cả buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"livelihood":{"definition":"Cách sinh nhai, sinh kế.","example":"They work hard to earn a decent livelihood.","exampleTranslation":"Họ làm việc chăm chỉ để kiếm cách sinh nhai tử tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"maker":{"definition":"Người làm, người sáng tạo, người tạo ra.","example":"The maker signed each handmade cup.","exampleTranslation":"Người làm đã ký tên vào mỗi chiếc cốc làm bằng tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"manage":{"definition":"Quản lý, trông nom.","example":"She works hard to manage the large company.","exampleTranslation":"Cô ấy làm việc chăm chỉ để quản lý công ty lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"manageable":{"definition":"Có thể quản lý, có thể trông nom.","example":"The plan is manageable with good help.","exampleTranslation":"Kế hoạch này có thể quản lý được nếu có sự giúp đỡ tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"manager":{"definition":"Người quản lý, quản đốc, giám đốc; người trông nom; người nội trợ.","example":"The manager checked every room before closing.","exampleTranslation":"Người quản lý đã kiểm tra mọi phòng trước khi đóng cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"manpower":{"definition":"Đơn vị sức người (tương tự horsepower).","example":"This engine has the manpower of a strong horse.","exampleTranslation":"Động cơ này có đơn vị sức người tương đương với một con ngựa khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"manual":{"definition":"Tay; làm bằng tay.","example":"He prefers manual labor over working in an office.","exampleTranslation":"Anh ấy thích lao động chân tay hơn là làm việc trong văn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"miller":{"definition":"Con bọ da.","example":"The miller hid under the bark during rain.","exampleTranslation":"Con bọ da ẩn náu dưới vỏ cây trong cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"mill":{"definition":"Min (bằng 1 qoành 000 đô la).","example":"A mill is worth one-tenth of a cent.","exampleTranslation":"Một đơn vị tiền min đáng giá một phần mười của một xu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"miner":{"definition":"Công nhân mỏ.","example":"The miner worked deep underground each day.","exampleTranslation":"Công nhân mỏ làm việc sâu dưới lòng đất mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"multitasking":{"definition":"Đa nhiệm.","example":"The multitasking phone handled calls and music well.","exampleTranslation":"Chiếc điện thoại đa nhiệm xử lý các cuộc gọi và âm nhạc rất tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"outsource":{"definition":"Thuê ngoài.","example":"They decided to outsource the cleaning work.","exampleTranslation":"Họ đã quyết định thuê ngoài công việc dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"oversee":{"definition":"Trông nom, giám thị.","example":"He will oversee the project from start to finish.","exampleTranslation":"Anh ấy sẽ giám sát dự án từ đầu đến cuối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"overtime":{"definition":"Giờ đấu thêm (để quyết định thắng bại)['ouvə'taim].","example":"The game went into overtime after the tie.","exampleTranslation":"Trận đấu đã bước vào hiệp phụ sau khi hòa điểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"overwork":{"definition":"Sự làm việc quá sức.","example":"Overwork left him too tired to cook.","exampleTranslation":"Làm việc quá sức khiến anh ấy mệt mỏi đến mức không thể nấu ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"personnel":{"definition":"Toàn thể cán bộ công nhân viên (cơ quan, nhà máy... ).","example":"The personnel met after lunch.","exampleTranslation":"Toàn thể cán bộ nhân viên đã gặp nhau sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"position":{"definition":"Vị trí, chỗ (của một vật gì).","example":"She found a perfect position in the office.","exampleTranslation":"Cô ấy tìm thấy một vị trí hoàn hảo trong văn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"practice":{"definition":"Thói quen, lệ thường.","example":"It is according to the usual practice here.","exampleTranslation":"Điều đó phù hợp với lệ thường ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"practise":{"definition":"Làm, hành (nghề... ).","example":"He wants to practise medicine in this city.","exampleTranslation":"Anh ấy muốn hành nghề y trong thành phố này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"professionally":{"definition":"Thành thạo, như nhà nghề, như chuyên nghiệp.","example":"They worked professionally all day.","exampleTranslation":"Một cách chuyên nghiệp","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"work"},"project":{"definition":"Kế hoạch, đề án, dự án.","example":"We need to finish this project by next Friday.","exampleTranslation":"Chúng ta cần hoàn thành dự án này trước thứ Sáu tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"promote":{"definition":"Thăng chức, thăng cấp, đề bạt; cho lên lớp.","example":"The company will promote her to manager next month.","exampleTranslation":"Công ty sẽ thăng chức cho cô ấy lên quản lý vào tháng tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"promotion":{"definition":"Sự thăng chức, sự thăng cấp, sự đề bạt; sự cho lên lớp.","example":"She worked hard to earn a quick promotion.","exampleTranslation":"Cô ấy đã làm việc chăm chỉ để giành được sự thăng tiến nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"proposal":{"definition":"Sự đề nghị, sự đề xuất.","example":"The manager accepted the new project proposal today.","exampleTranslation":"Người quản lý đã chấp nhận đề xuất dự án mới hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"propose":{"definition":"Đề nghị, đề xuất, đưa ra.","example":"I propose a new plan for our next project.","exampleTranslation":"Tôi đề xuất một kế hoạch mới cho dự án tiếp theo của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"prospect":{"definition":"Cảnh, toàn cảnh, viễn cảnh.","example":"The prospect of a new job is exciting.","exampleTranslation":"Triển vọng về một công việc mới thật thú vị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"provider":{"definition":"Người cung cấp.","example":"The provider delivered fresh fruit to us.","exampleTranslation":"Nhà cung cấp đã giao trái cây tươi cho chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"pursue":{"definition":"Theo, đuổi theo, đuổi bắt, truy nã, truy kích.","example":"Police officers will pursue the thief through town.","exampleTranslation":"Các sĩ quan cảnh sát sẽ truy đuổi kẻ trộm qua thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"pursuit":{"definition":"Sự đuổi theo, sự đuổi bắt, sự truy nã, sự truy kích.","example":"The police stayed in pursuit of the thief.","exampleTranslation":"Cảnh sát đã tiếp tục truy đuổi kẻ trộm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"qualification":{"definition":"Sự cho là; sự gọi là; sự định tính chất, sự định phẩm chất.","example":"His qualification of the plan was quite unfair.","exampleTranslation":"Việc anh ấy đánh giá kế hoạch là khá không công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"qualify":{"definition":"Hạn chế, dè dặt; làm nhẹ bớt.","example":"You should qualify your statement with some facts.","exampleTranslation":"Bạn nên bổ sung các sự kiện để làm rõ tuyên bố của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"quit":{"definition":"Vị ngữ thoát khỏi, giũ sạch được.","example":"He finally managed to get quit of his fear.","exampleTranslation":"Cuối cùng anh ấy cũng xoay xở để thoát khỏi nỗi sợ hãi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"raise":{"definition":"Nêu lên, đưa ra; đề xuất.","example":"You should raise that point during the meeting.","exampleTranslation":"Bạn nên nêu ra điểm đó trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"rank":{"definition":"Hàng ngũ, đội ngũ.","example":"The soldiers fell into rank during the parade.","exampleTranslation":"Những người lính đã vào hàng ngũ trong buổi diễu hành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"receptionist":{"definition":"Người tiếp khách (ở phòng khám bệnh, hiệu ảnh... ).","example":"The receptionist smiled and checked my name.","exampleTranslation":"Nhân viên lễ tân mỉm cười và kiểm tra tên tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"redundant":{"definition":"Thừa, dư.","example":"The extra workers are now redundant.","exampleTranslation":"Số công nhân thừa hiện đã không còn việc làm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"reeler":{"definition":"Người quay tơ.","example":"The reeler turned the yarn into neat coils.","exampleTranslation":"Người quay sợi đã biến sợi thành các cuộn gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"reorganization":{"definition":"Sự tổ chức lại, sự cải tổ lại.","example":"The shop needs a reorganization.","exampleTranslation":"Cửa hàng cần một sự tổ chức lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"reorganize":{"definition":"Tổ chức lại, cải tổ lại.","example":"They reorganize the shelves every spring.","exampleTranslation":"Họ tổ chức lại các kệ hàng mỗi mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"repair":{"definition":"Sửa chữa (máy móc), tu sửa (nhà cửa); vá (quần áo).","example":"I need to repair my bike this afternoon.","exampleTranslation":"Tôi cần sửa chiếc xe đạp của mình vào chiều nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"requirement":{"definition":"yêu cầu; điều kiện cần; nhu cầu","example":"There is a minimum age requirement of 18 years.","exampleTranslation":"Có một yêu cầu tối thiểu là 18 tuổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"work"},"restructure":{"definition":"Cơ cấu lại; tổ chức lại; sắp xếp lại.","example":"They restructure the office for better teamwork.","exampleTranslation":"Họ cơ cấu lại văn phòng để làm việc nhóm tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"retain":{"definition":"Giữ, cầm lại.","example":"These large dams retain water during the dry season.","exampleTranslation":"Những con đập lớn này giữ lại nước trong mùa khô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"retention":{"definition":"Sự giữ lại, sự cầm lại.","example":"Memory retention improves with regular practice.","exampleTranslation":"Khả năng ghi nhớ được cải thiện với việc luyện tập đều đặn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"retool":{"definition":"Trang bị lại; trang bị lại công cụ.","example":"They retool the shop for faster work.","exampleTranslation":"Họ trang bị lại công cụ cho cửa hàng để làm việc nhanh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"rigged":{"definition":"Quá khứ và phân từ quá khứ của rig","example":"The game was rigged from the start.","exampleTranslation":"Trò chơi đã được sắp đặt ngay từ đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"rigging":{"definition":"hiện tại phân từ của rig","example":"The sailors were rigging the boat for travel.","exampleTranslation":"Các thủy thủ đang trang bị dây chằng cho thuyền để đi lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"role":{"definition":"Vai, vai trò.","example":"She played the leading role in the new play.","exampleTranslation":"Cô ấy đóng vai chính trong vở kịch mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"routine":{"definition":"Lề thói hằng ngày; công việc thường làm hằng ngày.","example":"Her daily routine starts with a short walk.","exampleTranslation":"Thói quen hằng ngày của cô ấy bắt đầu bằng một chuyến đi bộ ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"routinely":{"definition":"Thông thường; thường lệ; thường làm đều đặn.","example":"He moved routinely through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách thường lệ qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"work"},"sailor":{"definition":"Lính thuỷ, thuỷ thủ.","example":"The sailor checked the ropes carefully.","exampleTranslation":"Người thủy thủ kiểm tra dây thừng một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"salesman":{"definition":"Người bán hàng (nam).","example":"The salesman answered every question.","exampleTranslation":"Người bán hàng đã trả lời mọi câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"salespeople":{"definition":"Những người bán hàng.","example":"The salespeople greeted us at the door.","exampleTranslation":"Những người bán hàng đã chào đón chúng tôi ở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"salesperson":{"definition":"Người bán hàng.","example":"The salesperson packed the order quickly.","exampleTranslation":"Người bán hàng đã đóng gói đơn hàng nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"schedule":{"definition":"Bản danh mục, bảng liệt kê; bản phụ lục.","example":"She checked the schedule before leaving for work.","exampleTranslation":"Cô ấy đã kiểm tra lịch trình trước khi rời đi làm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"seek":{"definition":"Tìm, đi tìm, tìm kiếm, cố tìm cho được.","example":"Many people seek employment in this big city.","exampleTranslation":"Nhiều người tìm kiếm việc làm ở thành phố lớn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"serve":{"definition":"Cú giao bóng; lượt giao bóng (quần vợt... ).","example":"Whose serve is it in this tennis match?","exampleTranslation":"Ai là người giao bóng trong trận quần vợt này?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"service":{"definition":"Sự phục vụ, sự hầu hạ.","example":"She is currently in service at the hospital.","exampleTranslation":"Cô ấy hiện đang phục vụ tại bệnh viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"shift":{"definition":"Sự thay đổi vị trí, sự thay đổi tính tình; sự thăng trầm; sự luân phiên.","example":"The shift of crops helps keep the soil healthy.","exampleTranslation":"Sự luân phiên cây trồng giúp giữ cho đất khỏe mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"sloppy":{"definition":"Không có hệ thống; tuỳ tiện, luộm thuộm, không đến nơi đến chốn (công việc).","example":"Their sloppy plan wasted a lot of time.","exampleTranslation":"Kế hoạch làm việc tuỳ tiện của họ đã gây lãng phí nhiều thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"staff":{"definition":"Gậy, ba toong.","example":"He walked with a staff on the hill.","exampleTranslation":"Ông ấy đi bộ với một chiếc gậy trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"strategic":{"definition":"Chiến lược.","example":"We need to find a strategic position.","exampleTranslation":"Chúng ta cần tìm một vị trí chiến lược.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"strategy":{"definition":"Chiến lược, công đoạn.","example":"Their strategy was simple but very effective.","exampleTranslation":"Chiến lược của họ đơn giản nhưng rất hiệu quả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"succeed":{"definition":"Kế nghiệp; nối ngôi, kế vị.","example":"He will succeed to the throne next month.","exampleTranslation":"Anh ấy sẽ kế vị ngai vàng vào tháng tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"success":{"definition":"Người thành công, người thành đạt (trong một việc gì); thí sinh trúng tuyển.","example":"He was a huge success in his art career.","exampleTranslation":"Anh ấy là một người thành công lớn trong sự nghiệp nghệ thuật của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"successful":{"definition":"Có kết quả, thành công, thắng lợi, thành đạt.","example":"She was very successful at starting her own company.","exampleTranslation":"Cô ấy đã rất thành công trong việc khởi nghiệp công ty riêng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"superior":{"definition":"Cao, cao cấp.","example":"The superior officer gave a very clear command.","exampleTranslation":"Vị sĩ quan cấp cao đã đưa ra một mệnh lệnh rất rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"supervision":{"definition":"Sự trông nom, sự giám sát.","example":"The construction site is under constant supervision.","exampleTranslation":"Công trường xây dựng luôn nằm dưới sự giám sát liên tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"supervisor":{"definition":"Người giám sát.","example":"The supervisor checked our work carefully.","exampleTranslation":"Người giám sát đã kiểm tra công việc của chúng tôi một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"tactic":{"definition":"Chiến thuật quân sự.","example":"The coach changed the tactic at halftime.","exampleTranslation":"Huấn luyện viên đã thay đổi chiến thuật quân sự vào giờ giải lao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"tactical":{"definition":"Chiến thuật.","example":"The team made a clever tactical move.","exampleTranslation":"Đội bóng đã thực hiện một nước đi chiến thuật thông minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"tailor":{"definition":"Thợ may.","example":"A tailor repaired my trousers yesterday.","exampleTranslation":"Một thợ may đã sửa quần của tôi hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"target":{"definition":"Bia (để bắn).","example":"He hit the target with his first shot.","exampleTranslation":"Anh ấy đã bắn trúng bia với phát đạn đầu tiên của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"task":{"definition":"Nhiệm vụ, nghĩa vụ, phận sự.","example":"Cleaning the entire house is a difficult task.","exampleTranslation":"Dọn dẹp toàn bộ ngôi nhà là một nhiệm vụ khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"timekeeper":{"definition":"Người ghi giờ làm việc.","example":"The timekeeper wrote down our hours.","exampleTranslation":"Người ghi giờ làm việc đã ghi lại số giờ của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"transfer":{"definition":"Sự thuyên chuyển (nhân viên... ).","example":"His transfer to another office started next week.","exampleTranslation":"Sự thuyên chuyển của anh ấy sang văn phòng khác bắt đầu vào tuần tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"transferable":{"definition":"Có thể dời chuyển, có thể di chuyển, có thể mang sang được.","example":"The ticket is transferable to another person.","exampleTranslation":"Vé có thể dời chuyển sang người khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"typist":{"definition":"Người đánh máy.","example":"The shorthand typist finished the report quickly.","exampleTranslation":"Người đánh máy tốc ký đã hoàn thành bản báo cáo nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"undertake":{"definition":"Đảm nhiệm, nhận làm, cam kết, kiêm nhiệm","example":"I cannot undertake to finish this project today.","exampleTranslation":"Tôi không thể cam kết hoàn thành dự án này hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"undertaken":{"definition":"Làm, định làm.","example":"We have undertaken a new project.","exampleTranslation":"Chúng tôi đã thực hiện một dự án mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"work"},"unplanned":{"definition":"Không có kế hoạch.","example":"It was an unplanned stop on the road.","exampleTranslation":"Đó là một điểm dừng không có kế hoạch trên đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"unsuccessful":{"definition":"Không thành công, không thắng lợi, thất bại, hỏng.","example":"Their search was unsuccessful despite hard work.","exampleTranslation":"Cuộc tìm kiếm của họ không thành công dù đã làm việc chăm chỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"work"},"waitress":{"definition":"Chị hầu bàn.","example":"The waitress smiled and took our order.","exampleTranslation":"Chị hầu bàn mỉm cười và nhận đơn đặt hàng của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"weaver":{"definition":"Người dệt vải, thợ dệt.","example":"The weaver made cloth by hand.","exampleTranslation":"Người dệt vải đã làm vải bằng tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"whaler":{"definition":"Người đánh cá voi.","example":"The whaler returned with a full crew.","exampleTranslation":"Người đánh cá voi đã trở về với đầy đủ thủy thủ đoàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"worker":{"definition":"người lao động, người làm việc.","example":"Each worker wore a bright safety vest.","exampleTranslation":"Mỗi người lao động đều mặc một chiếc áo phản quang an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"workload":{"definition":"khối lượng công việc","example":"Her workload increased after her coworker left.","exampleTranslation":"Khối lượng công việc của cô ấy tăng lên sau khi đồng nghiệp rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"work"},"workmanship":{"definition":"Tài nghệ, sự khéo léo.","example":"These old chairs are examples of poor workmanship.","exampleTranslation":"Những chiếc ghế cũ này là ví dụ về tài nghệ kém.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"workmen":{"definition":"Công nhân, người thợ (người đàn ông được thuê làm công việc chân tay hoặc (cơ khí)).","example":"The workmen arrived early to fix the roof.","exampleTranslation":"Các công nhân đã đến sớm để sửa mái nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"workshop":{"definition":"Xưởng.","example":"A workshop helped the team.","exampleTranslation":"Một xưởng đã giúp đỡ nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"work"},"fiscal":{"definition":"Liên quan đến thuế, chi tiêu và nguồn thu của chính phủ.","example":"The government introduced fiscal measures to support small businesses.","exampleTranslation":"Chính phủ đưa ra các biện pháp tài khóa để hỗ trợ doanh nghiệp nhỏ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"bankruptcy":{"definition":"Tình trạng một cá nhân hoặc doanh nghiệp không thể trả các khoản nợ đến hạn.","example":"The retailer avoided bankruptcy after restructuring its debt.","exampleTranslation":"Nhà bán lẻ tránh được phá sản sau khi tái cơ cấu nợ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"economy"},"exchange rate":{"definition":"Giá trị của một đồng tiền khi được đổi sang đồng tiền khác.","example":"A weaker exchange rate made imported fuel more expensive.","exampleTranslation":"Tỷ giá yếu hơn khiến nhiên liệu nhập khẩu đắt đỏ hơn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"economy"},"economic":{"definition":"Kinh tế.","example":"The economic choice saved us money.","exampleTranslation":"Lựa chọn kinh tế đó đã giúp chúng tôi tiết kiệm tiền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"econom"},"economical":{"definition":"Tiết kiệm.","example":"It is economical to buy water in bulk.","exampleTranslation":"Việc mua nước với số lượng lớn sẽ tiết kiệm hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"econom"},"economise":{"definition":"Tiết kiệm; giảm chi.","example":"They economise by cooking at home more often.","exampleTranslation":"Họ tiết kiệm bằng cách thường xuyên nấu ăn tại nhà hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"econom","spellingNote":"Alternate spelling: economize."},"economist":{"definition":"Nhà kinh tế học.","example":"An economist explained the market trend.","exampleTranslation":"Một nhà kinh tế học đã giải thích về xu hướng thị trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"econom"},"economize":{"definition":"Tiết kiệm, sử dụng tối đa, sử dụng tốt nhất (cái gì).","example":"We economize by turning off extra lights.","exampleTranslation":"Chúng tôi tiết kiệm bằng cách tắt các bóng đèn không cần thiết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"econom","spellingNote":"British spelling: economise."},"economy":{"definition":"nền kinh tế; sự tiết kiệm","example":"We wonder about the ability of our businesses to compete in the global economy.","exampleTranslation":"Chúng tôi tự hỏi về khả năng cạnh tranh của các doanh nghiệp mình trong nền kinh tế toàn cầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"econom"},"financing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của finance.","example":"They were financing a new school.","exampleTranslation":"Họ đang tài trợ cho một ngôi trường mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"financ"},"invest":{"definition":"Đầu tư.","example":"They plan to invest capital in the new tech startup.","exampleTranslation":"Họ dự định đầu tư vốn vào công ty khởi nghiệp công nghệ mới này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"invest"},"invested":{"definition":"Quá khứ và phân từ quá khứ của invest","example":"They invested their savings wisely.","exampleTranslation":"Họ đã đầu tư tiền tiết kiệm của mình một cách khôn ngoan.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"invest"},"investment":{"definition":"Sự đầu tư; vốn đầu tư; cái được đầu tư.","example":"Her small investment grew slowly over the years.","exampleTranslation":"Khoản đầu tư nhỏ của cô ấy đã tăng trưởng chậm chạp qua nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"invest"},"investor":{"definition":"Người đầu tư.","example":"The investor put money into the small shop.","exampleTranslation":"Nhà đầu tư đã bỏ tiền vào cửa hàng nhỏ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"invest"},"consumable":{"definition":"Có thể ăn được, có thể tiêu thụ được.","example":"The berries are consumable and safe to eat.","exampleTranslation":"Những loại quả mọng này dùng được và an toàn để ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"consum"},"consumer":{"definition":"Người tiêu dùng, người tiêu thụ (hàng hoá, thực phẩm... ).","example":"Every consumer wants fair prices.","exampleTranslation":"Mọi người tiêu dùng đều muốn mức giá hợp lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consum"},"consuming":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của consume.","example":"She was consuming soup after the walk.","exampleTranslation":"Cô ấy đang dùng món súp sau buổi đi dạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"consum"},"market":{"definition":"Thị trường, nơi tiêu thụ; khách hàng.","example":"The foreign market is growing very quickly now.","exampleTranslation":"Thị trường nước ngoài đang tăng trưởng rất nhanh hiện nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"market"},"marketable":{"definition":"Có thể bán được, thích hợp để bán ở chợ, có thể tiêu thụ được.","example":"The price stayed marketable after the small discount.","exampleTranslation":"Giá cả vẫn có khả năng tiêu thụ được sau khi giảm giá một chút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"market"},"marketed":{"definition":"Quá khứ và phân từ quá khứ của market","example":"They marketed the product to students.","exampleTranslation":"Họ đã tiếp thị sản phẩm cho sinh viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"market"},"marketing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của market.","example":"Marketing the product took several weeks.","exampleTranslation":"Việc tiếp thị sản phẩm mất vài tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"market"},"trade":{"definition":"Nghề, nghề nghiệp.","example":"He spent his whole life practicing his trade.","exampleTranslation":"Ông ấy đã dành cả cuộc đời mình để hành nghề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"trade"},"industry":{"definition":"Công nghiệp.","example":"The heavy industry provides many jobs for locals.","exampleTranslation":"Ngành công nghiệp nặng cung cấp nhiều việc làm cho người dân địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"industry"},"budget":{"definition":"Dự thảo ngân sách; ghi vào ngân sách.","example":"We need to budget for the coming year.","exampleTranslation":"Chúng ta cần lập ngân sách cho năm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"budget"},"budgetary":{"definition":"Ngân sách.","example":"The budgetary review cut extra spending.","exampleTranslation":"Việc xem xét ngân sách đã cắt giảm các khoản chi tiêu dư thừa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"budget"},"budgeted":{"definition":"Quá khứ và phân từ quá khứ của budget","example":"We budgeted enough money for lunch.","exampleTranslation":"Chúng tôi đã lập ngân sách đủ tiền cho bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"budget"},"taxable":{"definition":"Chịu phí tổn.","example":"All transport expenses are taxable to the sender.","exampleTranslation":"Tất cả các chi phí vận chuyển đều là khoản chịu thuế đối với người gửi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tax"},"taxation":{"definition":"Hệ thống thuế, thuế.","example":"The government decided to increase the local taxation.","exampleTranslation":"Chính phủ đã quyết định tăng mức thuế địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tax"},"taxes":{"definition":"Động từ chia ở ngôi thứ ba số ít của tax","example":"He taxes the imported goods.","exampleTranslation":"Anh ấy đánh thuế các mặt hàng nhập khẩu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"tax"},"taxing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của tax.","example":"Taxing the land took many hours.","exampleTranslation":"Việc đánh thuế mảnh đất đã tốn nhiều giờ đồng hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"tax"},"inflation":{"definition":"Lạm phát; tình trạng giá cả hàng hóa và dịch vụ tăng lên.","example":"Rising inflation has made food and housing less affordable.","exampleTranslation":"Lạm phát gia tăng khiến thực phẩm và nhà ở trở nên khó chi trả hơn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"inflation"},"inflationary":{"definition":"Lạm phát; gây lạm phát.","example":"The plan had an inflationary effect on prices.","exampleTranslation":"Kế hoạch đó có tác động gây lạm phát lên giá cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"inflation"},"recession":{"definition":"Suy thoái kinh tế; giai đoạn hoạt động kinh tế giảm sút.","example":"During the recession, many small businesses struggled to stay open.","exampleTranslation":"Trong thời kỳ suy thoái, nhiều doanh nghiệp nhỏ chật vật để tiếp tục hoạt động.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"recession"},"growth":{"definition":"Sự sinh trưởng.","example":"The baby showed rapid growth in just months.","exampleTranslation":"Đứa bé cho thấy sự tăng trưởng nhanh chóng chỉ trong vài tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"growth"},"income":{"definition":"Thu nhập, doanh thu, lợi tức.","example":"His monthly income is enough to pay all bills.","exampleTranslation":"Thu nhập hàng tháng của anh ấy đủ để chi trả mọi hóa đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"income"},"debtor":{"definition":"Người mắc nợ, con nợ; người chưa thực hiện được (nhiệm vụ, nghĩa vụ... ).","example":"The debtor promised to pay next week.","exampleTranslation":"Con nợ đã hứa sẽ thanh toán vào tuần tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"debt"},"bank":{"definition":"Ngân hàng; tổ chức cung cấp dịch vụ tài chính.","example":"The central bank raised interest rates to control inflation.","exampleTranslation":"Ngân hàng trung ương đã tăng lãi suất để kiểm soát lạm phát.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"bank"},"banked":{"definition":"Quá khứ và phân từ quá khứ của bank","example":"The boat banked beside the pier.","exampleTranslation":"Con thuyền đã ghé sát vào cầu tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"bank"},"banker":{"definition":"Nhà cái (đánh bạc).","example":"The banker collected the cards and dealt again.","exampleTranslation":"Người chia bài đã thu các lá bài và chia lại một lần nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"bank"},"banking":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của bank.","example":"He is banking his spare money each month.","exampleTranslation":"Anh ấy đang gửi tiết kiệm số tiền nhàn rỗi của mình mỗi tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"bank"},"commerce":{"definition":"Sự buôn bán; thương mại; thương nghiệp.","example":"International commerce has grown significantly this year.","exampleTranslation":"Thương mại quốc tế đã tăng trưởng đáng kể trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"commerce"},"product":{"definition":"Kết quả.","example":"The final result was a product of teamwork.","exampleTranslation":"Kết quả cuối cùng là sản phẩm của sự hợp tác nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"product"},"production":{"definition":"Sự đưa ra, sự trình bày.","example":"Her stage production drew loud applause from everyone.","exampleTranslation":"Vở diễn trên sân khấu của cô ấy đã nhận được sự tán thưởng nồng nhiệt từ mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"product"},"productive":{"definition":"Sản xuất.","example":"Working hard is a productive way to spend your day.","exampleTranslation":"Làm việc chăm chỉ là một cách hiệu quả để dành thời gian trong ngày của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"product"},"export":{"definition":"Hàng xuất khẩu; (số nhiều) khối lượng hàng xuất khẩu.","example":"Tea is an important export for the country.","exampleTranslation":"Chè là một mặt hàng xuất khẩu quan trọng của quốc gia này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"export"},"exportable":{"definition":"Có thể xuất khẩu.","example":"These apples are exportable this season.","exampleTranslation":"Những quả táo này có thể xuất khẩu được trong mùa vụ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"export"},"exportation":{"definition":"Sự xuất khẩu.","example":"Exportation helped the small company grow.","exampleTranslation":"Hoạt động xuất khẩu đã giúp công ty nhỏ phát triển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"export"},"exporter":{"definition":"Người xuất khẩu; hàng xuất khẩu.","example":"The exporter sold fruit to nearby countries.","exampleTranslation":"Nhà xuất khẩu đã bán trái cây cho các quốc gia lân cận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"export"},"exports":{"definition":"xuất khẩu; đưa ra nước ngoài","example":"The country exports agricultural products worldwide.","exampleTranslation":"Quốc gia này xuất khẩu các sản phẩm nông nghiệp ra khắp thế giới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"verb","posGroup":"verb","family":"export"},"import":{"definition":"Việc nhập khẩu hàng hóa từ nước ngoài vào một quốc gia.","example":"The import of essential medicines increased during the health crisis.","exampleTranslation":"Việc nhập khẩu các loại thuốc thiết yếu đã tăng lên trong cuộc khủng hoảng y tế.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"import"},"importable":{"definition":"Có thể nhập được, có thể nhập khẩu được (hàng hoá... ).","example":"This product is importable from nearby markets.","exampleTranslation":"Sản phẩm này có thể nhập khẩu được từ các thị trường lân cận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"import"},"importance":{"definition":"Sự quan trọng, tầm quan trọng.","example":"This issue is of great importance to our company.","exampleTranslation":"Vấn đề này có tầm quan trọng rất lớn đối với công ty của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"import"},"important":{"definition":"Quan trọng, trọng đại, trọng yếu, hệ trọng.","example":"This is an important event for our local community.","exampleTranslation":"Đây là một sự kiện quan trọng đối với cộng đồng địa phương của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"import"},"importation":{"definition":"Hàng nhập, hàng nhập khẩu.","example":"The shop sold imported rice and other importation.","exampleTranslation":"Cửa hàng đã bán gạo nhập khẩu và các loại hàng hóa nhập khẩu khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"import"},"imported":{"definition":"Quá khứ và phân từ quá khứ của import","example":"The shop imported fruit from abroad.","exampleTranslation":"Cửa hàng đã nhập khẩu trái cây từ nước ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"import"},"importer":{"definition":"Người nhập hàng, người nhập khẩu; hãng nhập hàng, hãng nhập khẩu.","example":"Our importer brings tea from overseas.","exampleTranslation":"Nhà nhập khẩu của chúng tôi mang trà từ nước ngoài về.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"import"},"capital":{"definition":"Vốn; tiền hoặc tài sản dùng để thành lập hay phát triển một hoạt động kinh doanh.","example":"Small businesses often need extra capital to expand.","exampleTranslation":"Các doanh nghiệp nhỏ thường cần thêm vốn để mở rộng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"capital"},"capitalism":{"definition":"Chủ nghĩa tư bản.","example":"Capitalism rewards work and risk.","exampleTranslation":"Chủ nghĩa tư bản đền đáp xứng đáng cho sự nỗ lực và chấp nhận rủi ro.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"capital"},"capitalist":{"definition":"Nhà tư bản.","example":"The capitalist invested in several small shops.","exampleTranslation":"Nhà tư bản đã đầu tư vào một số cửa hàng nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"capital"},"currency":{"definition":"Sự lưu hành; thời gian lưu hành ((thường) nói về tiền tệ).","example":"The old word kept currency for many years.","exampleTranslation":"Từ ngữ cũ đó vẫn giữ được sự phổ biến trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"currency"},"wealth":{"definition":"Sự giàu có, sự giàu sang.","example":"A man of wealth lives in luxury.","exampleTranslation":"Một người giàu có sống trong sự xa hoa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wealth"},"wealthy":{"definition":"Giàu, giàu có.","example":"The wealthy option was chosen.","exampleTranslation":"Lựa chọn đắt đỏ hơn đã được chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"wealth"},"profit":{"definition":"Lợi nhuận; khoản tiền còn lại sau khi trừ chi phí.","example":"The company made a modest profit by reducing energy costs.","exampleTranslation":"Công ty đã thu được một khoản lợi nhuận vừa phải nhờ giảm chi phí năng lượng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"profit"},"profitable":{"definition":"Có lợi, có ích.","example":"His advice was very profitable for my business.","exampleTranslation":"Lời khuyên của anh ấy rất có lợi cho việc kinh doanh của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"profit"},"profited":{"definition":"Quá khứ và phân từ quá khứ của profit","example":"The shop profited during the holiday season.","exampleTranslation":"Cửa hàng đã đạt lợi nhuận trong mùa lễ hội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"profit"},"profitless":{"definition":"Không có lợi, vô ích.","example":"That extra trip was profitless and tiring.","exampleTranslation":"Chuyến đi phụ đó thật vô ích và mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"profit"},"profits":{"definition":"Động từ chia ở ngôi thứ ba số ít của profit","example":"Our small shop profits well during the holidays.","exampleTranslation":"Cửa hàng nhỏ của chúng tôi thu lợi nhuận tốt trong các dịp lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"profit"},"account":{"definition":"Sự tính toán.","example":"We need to make an account for this.","exampleTranslation":"Chúng ta cần đưa ra một sự tính toán cho việc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"accumulate":{"definition":"Chất đống, chồng chất, tích luỹ, gom góp lại.","example":"They need to accumulate capital for the new project.","exampleTranslation":"Họ cần tích luỹ vốn cho dự án mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"accumulation":{"definition":"Đống (giấy má, sách vở... ).","example":"A heavy accumulation of books filled the shelf.","exampleTranslation":"Một đống sách vở lớn lấp đầy giá sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"allocation":{"definition":"Sự cấp cho.","example":"The school got a larger allocation this year.","exampleTranslation":"Nhà trường đã nhận được sự cấp cho lớn hơn trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"allowance":{"definition":"Tiền trợ cấp; tiền cấp phát; tiền bỏ túi, tiền tiêu vặt.","example":"He receives a monthly allowance from his parents.","exampleTranslation":"Anh ấy nhận được một khoản tiền tiêu vặt hàng tháng từ cha mẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"amount":{"definition":"Số lượng, số nhiều.","example":"They bought a considerable amount of fresh fruit.","exampleTranslation":"Họ đã mua một số lượng trái cây tươi đáng kể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"annual":{"definition":"Hàng năm, năm một, từng năm.","example":"They submit an annual report every December.","exampleTranslation":"Họ gửi báo cáo hàng năm vào mỗi tháng Mười hai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"annually":{"definition":"Hàng năm, năm một.","example":"I read the note annually.","exampleTranslation":"Tôi đọc ghi chú hàng năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"economy"},"asset":{"definition":"Tài sản của người không thể trả được nợ.","example":"The debt made his asset hard to recover.","exampleTranslation":"Khoản nợ khiến tài sản của anh ấy khó khôi phục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"availability":{"definition":"Tính sẵn sàng để dùng, tính có thể dùng được.","example":"She saw the availability yesterday.","exampleTranslation":"Cô ấy đã thấy sự sẵn sàng để dùng vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"available":{"definition":"Sẵn có để dùng, sẵn sàng để dùng, có thể dùng được.","example":"Is there any information available about the flight?","exampleTranslation":"Có thông tin nào sẵn có về chuyến bay không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"average":{"definition":"Số trung bình, mức trung bình; sự ước lượng trung bình.","example":"On the average, people sleep eight hours daily.","exampleTranslation":"Tính trung bình, mọi người ngủ tám tiếng mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"backer":{"definition":"Người giúp đỡ, người ủng hộ.","example":"The backer helped fund the small project.","exampleTranslation":"Người ủng hộ đã giúp tài trợ cho dự án nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"barrel":{"definition":"Thùng (lượng chứa trong thùng).","example":"A barrel of water sits near the door.","exampleTranslation":"Một thùng nước đặt gần cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"benefit":{"definition":"Lợi, lợi ích.","example":"This new policy provides a great benefit to us.","exampleTranslation":"Chính sách mới này mang lại lợi ích lớn cho chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"billion":{"definition":"Nghìn tỉ.","example":"A billion grains of sand covered the beach.","exampleTranslation":"Một nghìn tỉ hạt cát bao phủ bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"bond":{"definition":"Giao kèo, khế ước, lời cam kết.","example":"They signed a legal bond to protect the land.","exampleTranslation":"Họ đã ký một giao kèo pháp lý để bảo vệ vùng đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"bonus":{"definition":"Tiền các.","example":"The shop added a bonus to each sale.","exampleTranslation":"Cửa hàng đã thêm tiền các vào mỗi đơn hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"boom":{"definition":"Sào căng buồm.","example":"The boom was mentioned in the report.","exampleTranslation":"Cái sào căng buồm đã được đề cập trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"boost":{"definition":"Sự quảng cáo rùm beng (cho ai).","example":"The new store got a boost from ads.","exampleTranslation":"Cửa hàng mới nhận được sự quảng cáo rùm beng từ các quảng cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"borrow":{"definition":"Vay, mượn.","example":"Can I borrow your pen for a moment?","exampleTranslation":"Tôi có thể vay mượn bút của bạn một lát được không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"bought":{"definition":"Trã bằng giá; đạt được, được (cái gì bằng một sự hy sinh nào đó).","example":"I bought a new lamp yesterday.","exampleTranslation":"Tôi đã mua một chiếc đèn mới ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"bulk":{"definition":"Trọng tải hàng hoá; hàng hoá.","example":"We must move the bulk of the cargo now.","exampleTranslation":"Chúng ta phải chuyển trọng tải hàng hoá ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"burden":{"definition":"Gánh nặng ((nghĩa đen) & (nghĩa bóng)).","example":"The heavy debt is a huge burden for them.","exampleTranslation":"Khoản nợ lớn là một gánh nặng khổng lồ đối với họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"capita":{"definition":"Theo đầu người.","example":"The village income per capita is still low.","exampleTranslation":"Thu nhập của ngôi làng tính theo đầu người vẫn còn thấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"cash":{"definition":"Tiền, tiền mặt.","example":"I do not have any cash in my wallet.","exampleTranslation":"Tôi không có tiền mặt trong ví.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"cent":{"definition":"Đồng xu (bằng 1/100 đô la).","example":"I found a red cent on the sidewalk.","exampleTranslation":"Tôi đã tìm thấy một đồng xu đỏ trên vỉa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"charge":{"definition":"Vật mang, vật chở, vật gánh; gánh nặng ((nghĩa đen) & (nghĩa bóng)).","example":"The old man is a heavy charge on his children.","exampleTranslation":"Ông lão là một gánh nặng lớn đối với các con mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"cheap":{"definition":"Rẻ, rẻ tiền; đi tàu xe hạng ít tiền.","example":"I bought some cheap seats for the concert.","exampleTranslation":"Tôi đã mua vài chiếc vé giá rẻ cho buổi hòa nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"circulation":{"definition":"Sự lưu hành (tiền tệ.","example":"The bank decided to put more money into circulation.","exampleTranslation":"Ngân hàng đã quyết định đưa thêm tiền vào lưu hành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"client":{"definition":"Khách hàng (của luật sư, cửa hàng... ).","example":"The client asked for a later appointment.","exampleTranslation":"Khách hàng đã yêu cầu một cuộc hẹn trễ hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"coin":{"definition":"Đồng tiền (tiền đồng, tiền kim loại); tiền.","example":"I found a shiny coin on the ground.","exampleTranslation":"Tôi đã tìm thấy một đồng tiền kim loại sáng bóng trên mặt đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"compensate":{"definition":"Bù, đền bù, bồi thường.","example":"They will compensate you for the damaged goods.","exampleTranslation":"Họ sẽ bồi thường cho bạn vì những hàng hóa bị hư hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"compensation":{"definition":"Sự đền bù, sự bồi thường (thiệt hại); vật đền bù, vật bồi thường.","example":"They paid compensation for the broken window.","exampleTranslation":"Họ đã trả tiền bồi thường cho chiếc cửa sổ bị vỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"competitor":{"definition":"Người cạnh tranh; đấu thủ, đối thủ.","example":"Her main competitor opened a shop nearby.","exampleTranslation":"Đối thủ cạnh tranh chính của cô ấy đã mở một cửa hàng gần đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"contract":{"definition":"Hợp đồng, giao kèo, khế ước, giấy ký kết.","example":"They signed a marriage contract during the ceremony.","exampleTranslation":"Họ đã ký một hợp đồng hôn nhân trong buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"corporate":{"definition":"Đoàn thể; hợp thành đoàn thể.","example":"The corporate office is located in the city center.","exampleTranslation":"Văn phòng đoàn thể nằm ở trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"cost":{"definition":"Trị giá; phải trả.","example":"This beautiful dress will cost you a lot of money.","exampleTranslation":"Chiếc váy xinh đẹp này sẽ tiêu tốn của bạn rất nhiều tiền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"costly":{"definition":"Tốn kém, tốn tiền, hao tiền tốn của; tai hại (về số thương vong).","example":"The long war proved to be very costly.","exampleTranslation":"Cuộc chiến tranh kéo dài tỏ ra rất tốn kém.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"credit":{"definition":"Sự cho vay, cho thiếu, cho chịu.","example":"I decided to buy this new sofa on credit.","exampleTranslation":"Tôi quyết định mua chiếc ghế sofa mới này bằng hình thức cho thiếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"dealer":{"definition":"Người buôn bán.","example":"She is a dealer of rare and antique books.","exampleTranslation":"Cô ấy là người buôn bán sách hiếm và sách cổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"deal":{"definition":"Số lượng.","example":"I have a great deal of work today.","exampleTranslation":"Tôi có một số lượng lớn công việc phải làm hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"decline":{"definition":"Sự sụt, sự suy tàn, sự suy sụp, sự tàn tạ.","example":"We observed the steady decline of the old empire.","exampleTranslation":"Chúng tôi quan sát thấy sự suy tàn đều đặn của đế chế cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"deficit":{"definition":"Số tiền thiếu hụt (do chi lớn hơn thu).","example":"The company needs to meet a large budget deficit.","exampleTranslation":"Công ty cần phải đáp ứng một số tiền thiếu hụt ngân sách lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"demand":{"definition":"Sự đòi hỏi, sự yêu cầu; nhu cầu.","example":"There is a high demand for fresh fruit.","exampleTranslation":"Có một sự đòi hỏi cao về trái cây tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"deposit":{"definition":"Vật gửi, tiền gửi.","example":"There is a large deposit in my bank account.","exampleTranslation":"Có một số tiền gửi lớn trong tài khoản ngân hàng của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"distribute":{"definition":"Phân bổ, phân phối, phân phát.","example":"Please distribute letters to all the students.","exampleTranslation":"Vui lòng phân phát các bức thư cho tất cả học sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"distribution":{"definition":"Sự phân bổ hay sự phân bố, sự phân phối, sự phân phát.","example":"The distribution of books was fast and fair.","exampleTranslation":"Sự phân phối sách diễn ra nhanh chóng và công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"dole":{"definition":"Lời than van.","example":"He gave a dole after the bad news.","exampleTranslation":"Anh ấy cất lên một lời than van sau tin xấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"dollar":{"definition":"Đồng đô la (Mỹ).","example":"I saved a dollar for lunch.","exampleTranslation":"Tôi đã tiết kiệm được một đô la cho bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"earn":{"definition":"Kiếm được (tiền... ); giành được (phần thưởng, sự khen ngợi... ).","example":"She works very hard to earn a good living.","exampleTranslation":"Cô ấy làm việc rất chăm chỉ để kiếm được thu nhập tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"earning":{"definition":"Thu nhập.","example":"Her weekly earning supports the whole family.","exampleTranslation":"Thu nhập hàng tuần của cô ấy nuôi sống cả gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"economically":{"definition":"Về phương diện kinh tế, về mặt kinh tế.","example":"I read the note economically.","exampleTranslation":"Tôi đọc bản ghi chú về phương diện kinh tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"economy"},"efficiency":{"definition":"Năng lực, khả năng.","example":"He has the efficiency to solve problems fast.","exampleTranslation":"Anh ấy có năng lực để giải quyết các vấn đề nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"enterprise":{"definition":"Tổ chức kinh doanh, hãng, công ti.","example":"The enterprise hired three new workers.","exampleTranslation":"Tổ chức kinh doanh đã thuê ba công nhân mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"estimate":{"definition":"Sự đánh giá, sự ước lượng.","example":"My estimate was close to the final price.","exampleTranslation":"Ước lượng của tôi gần sát với giá cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"excess":{"definition":"Số lượng vượt quá, số lượng hơn, thừa ra, số dôi; độ dôi.","example":"There was an excess of salt in the soup.","exampleTranslation":"Có một số lượng thừa muối trong món súp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"exchange":{"definition":"Sự đổi, sự đổi chác, sự trao đổi; vật trao đổi.","example":"The exchange of gifts made the holiday very special.","exampleTranslation":"Sự trao đổi quà tặng đã làm cho kỳ nghỉ rất đặc biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"expansion":{"definition":"Sự khai triển.","example":"The company plans an expansion in series next year.","exampleTranslation":"Công ty có kế hoạch khai triển hàng loạt vào năm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"expense":{"definition":"Phụ phí, công tác phí.","example":"Lunch was an extra expense for the team.","exampleTranslation":"Bữa trưa là một phụ phí đối với cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"expensive":{"definition":"Đắt tiền.","example":"This watch is too expensive for me.","exampleTranslation":"Chiếc đồng hồ này quá đắt tiền đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"exploit":{"definition":"Khai thác, khai khẩn.","example":"Farmers exploit the dry land with new tools.","exampleTranslation":"Người nông dân khai thác vùng đất khô cằn với các công cụ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"favorable":{"definition":"Hứa hẹn tốt, có triển vọng.","example":"The report gives a favorable outlook for growth.","exampleTranslation":"Báo cáo đưa ra một triển vọng hứa hẹn tốt cho tăng trưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"finance":{"definition":"Tài chính, sở quản lý tài chính.","example":"She works in the finance department of the bank.","exampleTranslation":"Cô ấy làm việc tại bộ phận tài chính của ngân hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"financial":{"definition":"Tài chính, về tài chính.","example":"The financial report shows a significant increase in profit.","exampleTranslation":"Báo cáo tài chính cho thấy một sự tăng trưởng đáng kể về lợi nhuận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"firm":{"definition":"Chắc, rắn chắc.","example":"You need firm muscles to lift this heavy box.","exampleTranslation":"Bạn cần những cơ bắp rắn chắc để nâng cái hộp nặng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"fortune":{"definition":"Vận may; sự may mắn.","example":"She had great fortune on her side today.","exampleTranslation":"Cô ấy có vận may lớn đứng về phía mình hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"fund":{"definition":"Tiền của.","example":"We need more fund for the trip.","exampleTranslation":"Chúng ta cần nhiều tiền hơn cho chuyến đi này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"gain":{"definition":"Lợi, lời; lợi lộc; lợi ích.","example":"His love of gain led to many problems.","exampleTranslation":"Lòng ham lợi của anh ta đã dẫn đến nhiều vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"getting":{"definition":"Sự khấu; sự khai thác.","example":"The getting from the mine was very low.","exampleTranslation":"Sự khai thác từ mỏ rất thấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"goodwill":{"definition":"Đặc quyền kế nghiệp.","example":"The store's goodwill helped it grow fast.","exampleTranslation":"Đặc quyền kế nghiệp của cửa hàng đã giúp nó phát triển nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"greenback":{"definition":"Giấy bạc.","example":"He paid with a greenback from his wallet.","exampleTranslation":"Anh ta đã thanh toán bằng một tờ giấy bạc từ ví của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"guarantee":{"definition":"Sự bảo đảm, sự cam đoan; sự bảo lãnh.","example":"The store gave a guarantee on the new phone.","exampleTranslation":"Cửa hàng đã đưa ra sự bảo đảm cho chiếc điện thoại mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"incentive":{"definition":"Khuyến khích, khích lệ; thúc đẩy.","example":"A cash bonus is a great incentive for hard work.","exampleTranslation":"Một khoản thưởng tiền mặt là một sự khích lệ tuyệt vời cho công việc chăm chỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"increase":{"definition":"Sự tăng, sự tăng thêm.","example":"We saw a large increase in sales this month.","exampleTranslation":"Chúng tôi đã thấy một sự tăng lớn về doanh số bán hàng tháng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"increasingly":{"definition":"ngày càng","example":"Increasingly, people are driving electric cars.","exampleTranslation":"Ngày càng nhiều người đang lái xe điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"economy"},"incremental":{"definition":"Sự lớn lên.","example":"The project saw incremental growth each month.","exampleTranslation":"Dự án đã thấy sự lớn lên từng phần mỗi tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"incur":{"definition":"Chịu, gánh, mắc, bị.","example":"He did not want to incur any debts.","exampleTranslation":"Anh ấy không muốn phải chịu bất kỳ khoản nợ nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"inexpensive":{"definition":"Không đắt, rẻ.","example":"The inexpensive option was chosen.","exampleTranslation":"Lựa chọn không đắt đã được chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"insurance":{"definition":"Sự bảo hiểm.","example":"We bought insurance for the car.","exampleTranslation":"Chúng tôi đã mua sự bảo hiểm cho chiếc xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"insurer":{"definition":"Người nhận bảo hiểm (vật gì cho người khác).","example":"The insurer approved the claim quickly.","exampleTranslation":"Người nhận bảo hiểm đã phê duyệt yêu cầu bồi thường nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"interest":{"definition":"Sự quan tâm, sự chú ý; điều quan tâm, điều chú ý.","example":"This new scientific discovery is a matter of great interest.","exampleTranslation":"Khám phá khoa học mới này là một vấn đề của sự quan tâm lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"lend":{"definition":"Cho vay, cho mượn.","example":"Can you lend me your pen for a moment?","exampleTranslation":"Bạn có thể cho tôi mượn bút một lát không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"liable":{"definition":"Có trách nhiệm về pháp lý, có nghĩa vụ về pháp lý, có bổn phận.","example":"You are liable for any damage to the car.","exampleTranslation":"Bạn có trách nhiệm về pháp lý cho bất kỳ thiệt hại nào đối với chiếc xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"loan":{"definition":"Tiền cho mượn.","example":"I need to take out a loan for my new car.","exampleTranslation":"Tôi cần phải vay một khoản tiền cho chiếc xe mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"lucrative":{"definition":"Có lợi, sinh lợi, hái ra tiền.","example":"The small shop became a lucrative business.","exampleTranslation":"Cửa hàng nhỏ đã trở thành một công việc kinh doanh có lợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"manufacture":{"definition":"Sự chế tạo, sự sản xuất.","example":"The factory specializes in high quality manufacture.","exampleTranslation":"Nhà máy chuyên về sự chế tạo chất lượng cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"maximum":{"definition":"Điểm cao nhất, cực điểm, cực độ, tối đa.","example":"The room was full to the maximum.","exampleTranslation":"Căn phòng đã chật cứng đến điểm tối đa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"mean":{"definition":"Khoảng giữa, trung độ, trung gian, trung dung.","example":"They tried to find the happy mean between them.","exampleTranslation":"Họ đã cố gắng tìm một khoảng giữa trung dung giữa họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"merchant":{"definition":"Nhà buôn, lái buôn.","example":"The merchant sold fresh fruit at the busy market.","exampleTranslation":"Nhà buôn đã bán trái cây tươi tại khu chợ bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"merge":{"definition":"Hoà vào; hoà hợp, kết hợp, hợp nhất.","example":"Two small streams merge into one river.","exampleTranslation":"Hai con suối nhỏ hoà hợp vào một dòng sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"merger":{"definition":"Sự hợp, sự hợp nhất (nhiều công ty lại làm một... ).","example":"The merger created one larger company from two small ones.","exampleTranslation":"Sự hợp nhất đã tạo ra một công ty lớn hơn từ hai công ty nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"minimise":{"definition":"Giảm đến mức tối thiểu.","example":"We must minimise waste in the kitchen.","exampleTranslation":"Chúng ta phải giảm thiểu lãng phí trong nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy","spellingNote":"Alternate spelling: minimize."},"minimization":{"definition":"Sự cực tiểu hoá.","example":"Minimization of waste saved money and space.","exampleTranslation":"Sự tối thiểu hóa lãng phí đã giúp tiết kiệm tiền bạc và không gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"minimum":{"definition":"Tối thiểu.","example":"What is the minimum wage in this city?","exampleTranslation":"Mức lương tối thiểu trong thành phố này là bao nhiêu?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"mortgage":{"definition":"Văn tự thế chấp; sự thế chấp.","example":"They had to take out a mortgage for the home.","exampleTranslation":"Họ phải vay thế chấp để mua nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"nets":{"definition":"Động từ chia ở ngôi thứ ba số ít của net","example":"The line nets many fish each day.","exampleTranslation":"Đường dây đánh bắt được nhiều cá mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"nonprofit":{"definition":"Không vì mục đích lợi nhuận; bất vụ lợi.","example":"The clinic is a nonprofit group.","exampleTranslation":"Phòng khám là một nhóm bất vụ lợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"offer":{"definition":"Đề nghị.","example":"I offer you my help with the project.","exampleTranslation":"Tôi đề nghị giúp bạn thực hiện dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"offshore":{"definition":"Xa bờ biển, ở ngoài khơi.","example":"They enjoy offshore fishing in the deep ocean.","exampleTranslation":"Họ thích câu cá ngoài khơi trong đại dương sâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"outgoing":{"definition":"Outgo.","example":"The company's outgoing was higher this month.","exampleTranslation":"Khoản chi tiêu ra ngoài của công ty cao hơn trong tháng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"outlet":{"definition":"Chỗ thoát ra, lối ra; (nghĩa bóng) phương tiện thoả mãn... (chí hướng... ).","example":"This job gives me an outlet for my energy.","exampleTranslation":"Công việc này cho tôi một chỗ thoát ra cho năng lượng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"output":{"definition":"Sản phẩm.","example":"The machine's output is neatly stacked here.","exampleTranslation":"Sản phẩm của máy được xếp gọn gàng ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"overcharge":{"definition":"Gánh quá nặng (chở thêm).","example":"The truck had an overcharge of boxes.","exampleTranslation":"Chiếc xe tải đã có một gánh quá nặng các hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"oversell":{"definition":"Bản vượt số dự trữ.","example":"They oversell tickets every weekend.","exampleTranslation":"Họ bán vé quá số lượng dự trữ vào mỗi cuối tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"owing":{"definition":"Còn phải trả nợ.","example":"He must pay all that is owing now.","exampleTranslation":"Anh ấy phải trả tất cả những gì còn nợ bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"owned":{"definition":"Quá khứ và phân từ quá khứ của own","example":"He owned the small shop for years.","exampleTranslation":"Anh ấy đã sở hữu cửa hàng nhỏ này trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"owner":{"definition":"Người chủ, chủ nhân.","example":"The owner locked the door at night.","exampleTranslation":"Người chủ đã khóa cửa vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"ownership":{"definition":"Quyền sở hữu.","example":"They discussed the rules of collective ownership today.","exampleTranslation":"Họ đã thảo luận về các quy tắc sở hữu tập thể hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"owns":{"definition":"Động từ chia ở ngôi thứ ba số ít của own","example":"She owns a bright red bike.","exampleTranslation":"Cô ấy sở hữu một chiếc xe đạp màu đỏ tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"paid":{"definition":"Trả (tiền lương... ); nộp, thanh toán.","example":"I paid the bill before lunch.","exampleTranslation":"Tôi đã thanh toán hóa đơn trước bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"payable":{"definition":"Có thể trả, phải trả.","example":"The total amount is payable to the bearer.","exampleTranslation":"Tổng số tiền phải trả cho người mang phiếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"payment":{"definition":"Sự trả tiền, sự nộp tiền; số tiền trả.","example":"I received my payment for the work yesterday.","exampleTranslation":"Tôi đã nhận được khoản thanh toán cho công việc vào hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"pegged":{"definition":"Quá khứ và phân từ quá khứ của peg","example":"He pegged the paper to the board.","exampleTranslation":"Anh ấy đã ghim tờ giấy vào bảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"percent":{"definition":"Phần trăm.","example":"Fifty percent of the students passed the test.","exampleTranslation":"Năm mươi phần trăm học sinh đã vượt qua bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"percentage":{"definition":"Tỷ lệ; phần.","example":"Only a small percentage of students passed the exam.","exampleTranslation":"Chỉ có một tỷ lệ nhỏ học sinh đã vượt qua kỳ thi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"plentiful":{"definition":"Sung túc, phong phú, dồi dào.","example":"The garden gave a plentiful supply of beans.","exampleTranslation":"Khu vườn đã cho một nguồn cung cấp đậu sung túc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"plenty":{"definition":"Sự sung túc, sự phong phú, sự dồi dào, sự có nhiều.","example":"We have plenty of food for the party.","exampleTranslation":"Chúng tôi có đủ nhiều thức ăn cho bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"portfolio":{"definition":"Danh sách vốn đầu tư (của một công ty, một nhà ngân hàng); danh mục.","example":"The firm built a strong portfolio of stocks.","exampleTranslation":"Công ty đã xây dựng một danh mục cổ phiếu mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"possess":{"definition":"Có, chiếm hữu.","example":"The old house seems to possess a mystery.","exampleTranslation":"Ngôi nhà cũ dường như có một vẻ huyền bí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"possession":{"definition":"Quyền sở hữu; sự chiếm hữu.","example":"They are in possession of the land.","exampleTranslation":"Họ đang trong sự chiếm hữu khu đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"pound":{"definition":"Kiểm tra trọng lượng tiền đồng theo trọng lượng đồng bảng Anh.","example":"They pound the coin for its metal value.","exampleTranslation":"Họ kiểm tra trọng lượng đồng tiền theo giá trị kim loại của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"precious":{"definition":"Quý, quý giá, quý báu.","example":"Gold is a very precious metal for jewelry.","exampleTranslation":"Vàng là một kim loại rất quý giá để làm đồ trang sức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"premium":{"definition":"Phần thưởng.","example":"He won a small premium for good work.","exampleTranslation":"Anh ấy đã giành được một khoản tiền thưởng nhỏ vì làm việc tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"producer":{"definition":"Người sản xuất.","example":"The producer checked every detail before filming began.","exampleTranslation":"Nhà sản xuất đã kiểm tra từng chi tiết trước khi quá trình quay phim bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"prompt":{"definition":"Kỳ hạn trả tiền, kỳ hạn trả nợ.","example":"The loan prompt came at the end of the month.","exampleTranslation":"Thông báo cho vay đến vào cuối tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"prosperity":{"definition":"Sự thịnh vượng, sự phát đạt, sự phồn vinh, sự thành công.","example":"The prosperity played a key role.","exampleTranslation":"Sự thịnh vượng đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"prosperous":{"definition":"Thuận, thuận lợi.","example":"The company enjoyed very prosperous winds last year.","exampleTranslation":"Công ty đã tận hưởng những làn gió rất thịnh vượng vào năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"quota":{"definition":"Phần (phải đóng góp hoặc được chia).","example":"Each worker got a fair quota of tasks.","exampleTranslation":"Mỗi công nhân nhận được một hạn ngạch nhiệm vụ công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"rate":{"definition":"Tốc độ.","example":"The car moved at a steady rate today.","exampleTranslation":"Chiếc xe di chuyển ở một tốc độ ổn định hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"reduce":{"definition":"Giảm, giảm bớt, hạ.","example":"You should reduce speed when it rains outside.","exampleTranslation":"Bạn nên giảm tốc độ khi trời mưa bên ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"reduction":{"definition":"Sự biến đổi (sang một trạng thái, hình thức kém hơn, thấp hơn).","example":"We saw a reduction in the total price.","exampleTranslation":"Chúng tôi đã thấy một sự giảm giá tổng cộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"revenue":{"definition":"Thu nhập (quốc gia).","example":"Higher oil prices should raise government revenue by 13%.","exampleTranslation":"Giá dầu cao hơn sẽ làm tăng thu nhập của chính phủ thêm 13%.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"rich":{"definition":"Giàu, giàu có.","example":"He became a rich man after the war.","exampleTranslation":"Anh ấy trở thành một người giàu có sau chiến tranh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"richly":{"definition":"Hoàn toàn.","example":"He richly deserves to win the first prize today.","exampleTranslation":"Anh ấy hoàn toàn xứng đáng giành giải nhất hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"economy"},"richness":{"definition":"Sự giàu có, sự phong phú, sự đầy đủ, sự dồi dào.","example":"The richness of the soup came from fresh vegetables.","exampleTranslation":"Sự phong phú của món súp đến từ các loại rau tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"saver":{"definition":"Cái để tiết kiệm; mẹo để tiết kiệm.","example":"This new machine is a great time saver.","exampleTranslation":"Chiếc máy mới này là một mẹo tiết kiệm thời gian tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"seasonal":{"definition":"Từng thời, từng lúc, từng mùa, từng vụ.","example":"We sell seasonal fruit in the summer.","exampleTranslation":"Chúng tôi bán trái cây theo mùa vào mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"sector":{"definition":"Khu vực.","example":"The state sector of economy is growing very fast.","exampleTranslation":"Khu vực nhà nước của nền kinh tế đang phát triển rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"share":{"definition":"Phần đóng góp.","example":"Everyone has done his share of work today.","exampleTranslation":"Mọi người đã làm phần đóng góp công việc của mình hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"shareholder":{"definition":"Cổ đông, người có cổ phần.","example":"Every shareholder received a small report.","exampleTranslation":"Mỗi cổ đông đã nhận được một bản báo cáo nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"slump":{"definition":"Sụp xuống.","example":"She did slump into the chair after work.","exampleTranslation":"Cô ấy sụp xuống chiếc ghế sau giờ làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"sell":{"definition":"Sự làm thất vọng.","example":"The new product was a total sell for the team.","exampleTranslation":"Sản phẩm mới là một sự làm thất vọng hoàn toàn đối với đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"specie":{"definition":"Tiền đồng (đối lại với tiền giấy).","example":"The museum displays many coins in specie.","exampleTranslation":"Bảo tàng trưng bày nhiều tiền đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"sponsor":{"definition":"Cha đỡ đầu, mẹ đỡ đầu.","example":"The sponsor paid for the school event.","exampleTranslation":"Cha đỡ đầu đã trả tiền cho sự kiện của trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"sponsorship":{"definition":"Trách nhiệm của cha đỡ đầu, trách nhiệm của mẹ đỡ đầu.","example":"Her sponsorship of the event helped many children join.","exampleTranslation":"Sự bảo trợ của cô ấy cho sự kiện đã giúp nhiều trẻ em tham gia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"stake":{"definition":", (thông tục) tiền đóng góp, tiền dấn vốn (vào một công cuộc kinh doanh).","example":"She put her stake into the new shop.","exampleTranslation":"Cô ấy đặt tiền vốn vào cửa hàng mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"stakeholder":{"definition":"Người giữ tiền đặt cược, người có vốn.","example":"Each stakeholder wanted a say in the project.","exampleTranslation":"Mỗi người có vốn đều muốn có tiếng nói trong dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"startup":{"definition":"Khởi động, ban đầu.","example":"The startup grew quickly after its first ape launch.","exampleTranslation":"Công ty khởi động phát triển nhanh chóng sau lần phóng đầu tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"stock":{"definition":"Vốn; cổ phần.","example":"He invested all his money in bank stock.","exampleTranslation":"Anh ấy đã đầu tư tất cả tiền của mình vào vốn ngân hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"supplier":{"definition":"Người cung cấp, người tiếp tế.","example":"Our supplier brought fresh fruit every morning.","exampleTranslation":"Nhà cung cấp của chúng tôi mang trái cây tươi đến mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"taker":{"definition":"Người lấy, người nhận.","example":"Each taker received a small card.","exampleTranslation":"Mỗi người nhận đã nhận được một tấm thẻ nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"tariff":{"definition":"Bảng kẻ giá.","example":"The shop printed the tariff on every item.","exampleTranslation":"Cửa hàng đã in bảng kẻ giá trên mỗi mặt hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"teller":{"definition":"Người kể chuyện, người hay kể chuyện; người tự thuật.","example":"The teller told a funny story.","exampleTranslation":"Người kể chuyện đã kể một câu chuyện vui.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"till":{"definition":"Ngăn kéo để tiền.","example":"She opened the till and counted the money.","exampleTranslation":"Cô ấy mở ngăn kéo để tiền và đếm số tiền đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"tipping":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của tip.","example":"He is tipping the jar carefully.","exampleTranslation":"Anh ấy đang nghiêng hũ một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"tips":{"definition":"Động từ chia ở ngôi thứ ba số ít của tip","example":"She tips the waiter after every meal.","exampleTranslation":"Cô ấy bo cho người bồi bàn sau mỗi bữa ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"token":{"definition":"Dấu hiệu, biểu hiện.","example":"Please accept this gift as a token of gratitude.","exampleTranslation":"Vui lòng chấp nhận món quà này như một dấu hiệu của lòng biết ơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"trademark":{"definition":"Đăng ký thương hiệu, đăng ký nhãn hiệu.","example":"They trademark the data carefully.","exampleTranslation":"Họ đăng ký thương hiệu cho dữ liệu một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"economy"},"trader":{"definition":"Nhà buôn, thương gia.","example":"The trader sold fruit at the busy market.","exampleTranslation":"Nhà buôn đã bán trái cây tại chợ bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"transaction":{"definition":"Sự thực hiện; sự giải quyết.","example":"The transaction was completed in a few minutes.","exampleTranslation":"Sự thực hiện đã được hoàn thành trong vài phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"trillion":{"definition":"Một tỷ tỷ; (từ Mỹ, nghĩa Mỹ) một ngàn tỷ.","example":"A trillion stars seem impossible to count.","exampleTranslation":"Một tỷ tỷ ngôi sao dường như không thể đếm được.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"turnover":{"definition":"Sự đổ lật (xe).","example":"The car had a bad turnover on the wet road.","exampleTranslation":"Chiếc xe đã gặp một vụ đổ lật tồi tệ trên con đường ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"unprofitable":{"definition":"Không có lợi, vô ích.","example":"That route is unprofitable for the bus company.","exampleTranslation":"Tuyến đường đó là không có lợi cho công ty xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"valuable":{"definition":"Có giá trị lớn, quý giá.","example":"Your help provided very valuable assistance during the trip.","exampleTranslation":"Sự giúp đỡ của bạn cung cấp hỗ trợ rất có giá trị trong suốt chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"economy"},"value":{"definition":"Giá trị.","example":"This antique watch is of a great value.","exampleTranslation":"Chiếc đồng hồ cổ này có giá trị lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"venture":{"definition":"Sự đầu cơ.","example":"The new venture made careful use of money.","exampleTranslation":"Sự đầu cơ mới đã sử dụng tiền một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"wholesale":{"definition":"Sự bán buôn, sự bán sỉ.","example":"They decided to sell their goods by wholesale.","exampleTranslation":"Họ đã quyết định bán hàng hóa của mình theo hình thức bán buôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"worth":{"definition":"Số lượng (hàng... ) vừa giá (một số tiền nào đấy).","example":"Give me a dollar's worth of candy.","exampleTranslation":"Cho tôi một đô la kẹo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economy"},"transport":{"definition":"Sự chuyên chở, sự vận tải.","example":"The transport of goods takes several days by sea.","exampleTranslation":"Việc vận chuyển hàng hóa mất vài ngày nếu đi bằng đường biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"transportation":{"definition":"Sự chuyên chở, sự vận tải.","example":"Public transportation is very convenient for city residents.","exampleTranslation":"Giao thông công cộng rất thuận tiện cho cư dân thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"transporter":{"definition":"Người chuyên chở.","example":"The transporter moved boxes across town.","exampleTranslation":"Người vận chuyển đã di chuyển các thùng hàng khắp thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"transporting":{"definition":"hiện tại phân từ của transport","example":"The team was transporting supplies all morning.","exampleTranslation":"Cả đội đã vận chuyển hàng tiếp tế suốt buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"traffic":{"definition":"Sự đi lại, sự giao thông.","example":"Heavy rain caused a lot of traffic this morning.","exampleTranslation":"Mưa lớn gây ra tình trạng tắc nghẽn giao thông vào sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"traffic"},"vehicle":{"definition":"Phương tiện giao thông và vận tải (nói chung)","example":"They traveled to the city by car vehicle.","exampleTranslation":"Họ đã đi vào thành phố bằng phương tiện xe ô tô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"vehicle"},"road":{"definition":"Đường bộ; lối đi dành cho phương tiện và người đi lại.","example":"The new road connects the village to the nearest city.","exampleTranslation":"Con đường mới nối ngôi làng với thành phố gần nhất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"road"},"rail":{"definition":"Đường ray, đường xe lửa.","example":"They decided to travel by rail across Europe.","exampleTranslation":"Họ quyết định đi du lịch xuyên châu Âu bằng tàu hỏa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"rail"},"railed":{"definition":"Quá khứ và phân từ quá khứ của rail","example":"He railed against the long delay.","exampleTranslation":"Anh ấy đã kịch liệt phản đối sự chậm trễ kéo dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"rail"},"railing":{"definition":"hiện tại phân từ của rail","example":"She was railing at the slow service.","exampleTranslation":"Cô ấy đang phàn nàn gay gắt về dịch vụ chậm chạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"rail"},"airport":{"definition":"Sân bay, phi trường.","example":"We met near the airport entrance at dawn.","exampleTranslation":"Chúng tôi gặp nhau gần lối vào sân bay vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"airport"},"commutable":{"definition":"Có thể thay thế, có thể thay đổi cho nhau, có thể giao hoán.","example":"The two jobs are commutable by train.","exampleTranslation":"Hai công việc này có thể đi lại bằng tàu hỏa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"commut"},"commuter":{"definition":"Người đi làm bằng vé tháng.","example":"The commuter caught the early train.","exampleTranslation":"Người đi làm đã bắt chuyến tàu sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"commut"},"commuting":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của commute.","example":"I am commuting by bus this week.","exampleTranslation":"Tuần này tôi đang đi làm bằng xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"commut"},"bicycle":{"definition":"Xe đạp.","example":"She rode her bicycle to school.","exampleTranslation":"Cô ấy đạp xe đi học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"bicycle"},"pedestrian":{"definition":"Bằng chân, bộ.","example":"We walked along the pedestrian path by the river.","exampleTranslation":"Chúng tôi đi dạo dọc theo con đường dành cho người đi bộ bên bờ sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"pedestrian"},"pedestrianise":{"definition":"Cách viết khác : pedestrianize.","example":"They pedestrianise the street on weekends.","exampleTranslation":"Họ cấm xe cộ lưu thông trên con phố này vào cuối tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"pedestrian"},"subway":{"definition":"Đường ngầm, hầm ngầm.","example":"We waited for the subway during the rain.","exampleTranslation":"Chúng tôi đã đợi tàu điện ngầm trong lúc trời mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"subway"},"busy":{"definition":"Bận rộn, bận; có lắm việc.","example":"I am very busy with my new project.","exampleTranslation":"Tôi đang rất bận rộn với dự án mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"bus"},"train":{"definition":"Xe lửa.","example":"I will travel to London by train tomorrow.","exampleTranslation":"Ngày mai tôi sẽ đi London bằng tàu hỏa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"train"},"trainable":{"definition":"Có thể dạy được, có thể huấn luyện được.","example":"The puppy is trainable with patient lessons.","exampleTranslation":"Chú cún này có thể huấn luyện được nếu kiên trì dạy bảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"train"},"trained":{"definition":"Quá khứ và phân từ quá khứ của train","example":"She trained every day for the race.","exampleTranslation":"Cô ấy đã tập luyện mỗi ngày cho cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"train"},"trainer":{"definition":"Người dạy (súc vật).","example":"The trainer taught the dog to sit.","exampleTranslation":"Người huấn luyện đã dạy chú chó ngồi xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"train"},"ship":{"definition":"Tàu thuỷ, tàu.","example":"A large ship arrived at the harbor this morning.","exampleTranslation":"Một con tàu lớn đã cập bến vào sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ship"},"shipment":{"definition":"Sự xếp (hàng) xuống tàu.","example":"The shipment arrived early at the dock.","exampleTranslation":"Lô hàng đã đến sớm tại cảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ship"},"safety":{"definition":"sự an toàn","example":"Always wear a helmet for your personal safety on bikes.","exampleTranslation":"Luôn đội mũ bảo hiểm để đảm bảo an toàn cho bản thân khi đi xe đạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"safety"},"motor":{"definition":"Động cơ mô tô.","example":"The motor started with a soft, steady hum.","exampleTranslation":"Động cơ khởi động với tiếng kêu êm và đều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"motor"},"motored":{"definition":"Quá khứ và phân từ quá khứ của motor","example":"We motored to the coast before sunrise.","exampleTranslation":"Chúng tôi đã lái xe ra bờ biển trước khi mặt trời mọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"motor"},"motoring":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của motor.","example":"He is motoring along the coast road.","exampleTranslation":"Anh ấy đang lái xe dọc theo con đường ven biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"motor"},"motorise":{"definition":"Cơ giới hoá, lắp động cơ (mô tơ) vào (xe cộ... ).","example":"They motorise the old bike for city trips.","exampleTranslation":"Họ lắp động cơ cho chiếc xe đạp cũ để dùng cho việc đi lại trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"motor","spellingNote":"Alternate spelling: motorize."},"motorist":{"definition":"Người lái xe ô tô; người chơi xe ô tô.","example":"The motorist waited at the red light.","exampleTranslation":"Người lái xe đã đợi ở đèn đỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"motor"},"motorization":{"definition":"Sự cơ giới hoá, sự lắp động cơ (mô tơ) vào.","example":"Motorization changed how people traveled.","exampleTranslation":"Việc cơ giới hóa đã thay đổi cách mọi người đi lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"motor"},"motorize":{"definition":"Cơ giới hoá, lắp động cơ (mô tơ) vào (xe cộ... ).","example":"The team had to motorize the system.","exampleTranslation":"Nhóm nghiên cứu đã phải cơ giới hóa hệ thống này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"motor","spellingNote":"British spelling: motorise."},"motorized":{"definition":"Quá khứ và phân từ quá khứ của motorize","example":"The car was motorized for easier travel.","exampleTranslation":"Chiếc xe đã được lắp động cơ để việc di chuyển dễ dàng hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"motor"},"cycling":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của cycle.","example":"She is cycling to work today.","exampleTranslation":"Hôm nay cô ấy đi xe đạp đến nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"cycling"},"public":{"definition":"Công khai.","example":"They made a public statement about the new rules.","exampleTranslation":"Họ đã đưa ra một tuyên bố công khai về các quy định mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"public"},"publication":{"definition":"Sự công bố.","example":"The publication of the news came today.","exampleTranslation":"Việc công bố tin tức đã diễn ra vào hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"public"},"publicise":{"definition":"Đưa ra công khai; làm cho thiên hạ biết đến.","example":"They publicise the event on posters and online.","exampleTranslation":"Họ quảng bá sự kiện này trên các áp phích và trên mạng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"public","spellingNote":"Alternate spelling: publicize."},"publicist":{"definition":"Nhà nghiên cứu về luật pháp quốc tế, chuyên gia về luật pháp quốc tế.","example":"The publicist wrote about the new law.","exampleTranslation":"Nhà quan hệ công chúng đã viết bài về đạo luật mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"public"},"publicity":{"definition":"Tính công khai; sự làm cho thiên hạ biết đến.","example":"The company seeks more publicity for its new product.","exampleTranslation":"Công ty đang tìm kiếm sự chú ý của công chúng nhiều hơn cho sản phẩm mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"public"},"publicize":{"definition":"Đưa ra công khai; làm cho thiên hạ biết đến.","example":"The charity used local media to publicize its clean-water campaign.","exampleTranslation":"Tổ chức từ thiện đã sử dụng truyền thông địa phương để quảng bá chiến dịch nước sạch.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"public","spellingNote":"British spelling: publicise."},"publicly":{"definition":"Công khai.","example":"They worked publicly all day.","exampleTranslation":"Họ đã làm việc một cách công khai cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"public"},"transit":{"definition":"Sự đi qua, sự vượt qua.","example":"The transit across the bridge took ten minutes.","exampleTranslation":"Việc di chuyển qua cây cầu mất mười phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transit"},"transited":{"definition":"Dạng quá khứ đơn và phân từ quá khứ của transit","example":"The bus transited the border at noon.","exampleTranslation":"Chiếc xe buýt đã đi qua biên giới vào buổi trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transit"},"transition":{"definition":"Sự chuyển tiếp, sự quá độ.","example":"The transition from winter to spring is beautiful.","exampleTranslation":"Sự chuyển giao từ mùa đông sang mùa xuân thật đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transit"},"transitive":{"definition":"Ngoại (động từ).","example":"Is this verb transitive or intransitive?","exampleTranslation":"Động từ này là ngoại động từ hay nội động từ?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transit"},"fuel":{"definition":"Cung cấp chất đốt.","example":"They need to fuel the ship before departure.","exampleTranslation":"Họ cần tiếp nhiên liệu cho con tàu trước khi khởi hành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"fuel"},"fueled":{"definition":"Quá khứ và phân từ quá khứ của fuel","example":"They fueled the heater before winter.","exampleTranslation":"Họ đã nạp nhiên liệu cho lò sưởi trước khi mùa đông đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"fuel"},"accident":{"definition":"Sự tình cờ, sự ngẫu nhiên.","example":"I found this old coin by accident today.","exampleTranslation":"Tôi tình cờ tìm thấy đồng xu cũ này hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"accident"},"accidental":{"definition":"Tình cờ, ngẫu nhiên; bất ngờ.","example":"It was an accidental meeting at the store.","exampleTranslation":"Đó là một cuộc gặp gỡ tình cờ tại cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"accident"},"aboard":{"definition":"Trên tàu, trên boong tàu, trên thuyền, trên xe lửa; trên máy bay.","example":"All passengers are now aboard the large ship.","exampleTranslation":"Tất cả hành khách hiện đã ở trên con tàu lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"transport"},"accelerate":{"definition":"Rảo (bước).","example":"You should accelerate your pace to win the race.","exampleTranslation":"Bạn nên rảo bước nhanh hơn để thắng cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"aeroplane":{"definition":"Máy bay, tàu bay.","example":"The aeroplane arrived late because of strong wind.","exampleTranslation":"Chiếc máy bay đến muộn vì gió mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"airborne":{"definition":"Không vận.","example":"The airborne parcel reached the city by noon.","exampleTranslation":"Bưu kiện không vận đã đến thành phố vào buổi trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transport"},"aircraft":{"definition":"Máy bay, tàu bay.","example":"The aircraft landed smoothly after the long flight.","exampleTranslation":"Chiếc máy bay đã hạ cánh êm ái sau chuyến bay dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"airliner":{"definition":"Máy bay dân dụng loại lớn.","example":"The airliner landed safely after the storm.","exampleTranslation":"Chiếc máy bay dân dụng loại lớn đã hạ cánh an toàn sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"anchor":{"definition":"Cái neo, mỏ neo.","example":"The heavy ship dropped its anchor in the deep water.","exampleTranslation":"Con tàu nặng đã thả mỏ neo của nó trong nước sâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"arrival":{"definition":"Người mới đến; vật mới đến.","example":"The new arrival sat quietly by the door.","exampleTranslation":"Người mới đến ngồi lặng lẽ bên cánh cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"auto":{"definition":"Xe ô tô.","example":"We parked the auto near the shop.","exampleTranslation":"Chúng tôi đã đỗ xe ô tô gần cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"automobile":{"definition":"Xe ô tô.","example":"She bought a small automobile for city trips.","exampleTranslation":"Cô ấy đã mua một chiếc xe ô tô nhỏ cho những chuyến đi trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"baggage":{"definition":"Hành lý.","example":"Her baggage was light and easy to carry.","exampleTranslation":"Hành lý của cô ấy nhẹ và dễ mang theo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"belt":{"definition":"Dây đai (đeo gươm... ).","example":"The sword belt felt heavy.","exampleTranslation":"Dây đai đeo gươm cảm thấy nặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"boat":{"definition":"Đĩa hình thuyền (để đựng nước thịt... ).","example":"She served soup in a small boat.","exampleTranslation":"Cô ấy phục vụ súp trong một cái đĩa hình thuyền nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"bridge":{"definition":"Brit.","example":"The bridge in the sentence means British English.","exampleTranslation":"Từ bridge trong câu có nghĩa là tiếng Anh của Anh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"canal":{"definition":"Kênh, sông đào.","example":"The canal carried boats through the city.","exampleTranslation":"Kênh sông đào đưa các con thuyền xuyên qua thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"canoe":{"definition":"Xuồng.","example":"We rented a canoe for the afternoon.","exampleTranslation":"Chúng tôi đã thuê một chiếc xuồng cho buổi chiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"cargo":{"definition":"Hàng hoá (chở trên tàu thuỷ).","example":"The ship carried cargo across the sea.","exampleTranslation":"Con tàu chở hàng hoá xuyên đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"chute":{"definition":"Thác (nước).","example":"We stood near the chute and watched water fall.","exampleTranslation":"Chúng tôi đứng gần thác và nhìn nước đổ xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"conveyor":{"definition":"Băng truyền; máy chuyền; băng tải.","example":"Boxes moved along the conveyor in a steady line.","exampleTranslation":"Các hộp di chuyển dọc theo băng chuyền thành một hàng đều đặn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"crew":{"definition":"Toàn bộ thuỷ thủ trên tàu; toàn bộ người lái và nhân viên trên máy bay.","example":"The crew cleaned the deck together.","exampleTranslation":"Toàn bộ thủy thủ trên tàu đã dọn dẹp boong cùng nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"crossing":{"definition":"Sự cắt nhau, sự giao nhau; chỗ cắt nhau.","example":"The crossing of two lines formed a plus sign.","exampleTranslation":"Việc giao nhau của hai đường thẳng tạo thành một dấu cộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"cutter":{"definition":"Xuồng ca nô (của một tàu chiến.","example":"The revenue cutter patrolled the coast all night.","exampleTranslation":"Xuồng ca nô của cơ quan thuế đã tuần tra bờ biển suốt đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"deck":{"definition":"Boong tàu, sàn tàu.","example":"The sailors stood on the deck of the ship.","exampleTranslation":"Các thủy thủ đứng trên boong tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"departure":{"definition":"Sự rời khỏi, sự ra đi, sự khởi hành.","example":"The old man took his departure from this life.","exampleTranslation":"Ông già đã ra đi khỏi cuộc đời này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"dispatch":{"definition":"Sự gửi đi (thư, thông điệp... ); sự sai phái đi.","example":"The dispatch arrived early this morning.","exampleTranslation":"Sự gửi đi thông điệp đã đến từ sớm sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"ditch":{"definition":"Hào, rãnh, mương.","example":"Water collected in the ditch after the rain.","exampleTranslation":"Nước đọng lại trong hào sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"divert":{"definition":"Làm chệch đi, làm chệch hướng.","example":"We can divert the stream around the rock.","exampleTranslation":"Chúng ta có thể làm chệch hướng dòng suối xung quanh tảng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"dock":{"definition":"Giống cây chút chít.","example":"A dock grew beside the fence in the garden.","exampleTranslation":"Một cây chút chít mọc bên cạnh hàng rào trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"drive":{"definition":"Cuộc đi xe, cuộc đi chơi bằng xe.","example":"Would you like to go for a drive?","exampleTranslation":"Bạn có muốn đi chơi bằng xe không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"driver":{"definition":"Người lái xe ô tô, xe buýt hay các xe có động cơ","example":"The driver parked the car in the garage.","exampleTranslation":"Người lái xe đã đỗ xe trong gara.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"exit":{"definition":"Sự đi vào (của diễn viên).","example":"The actor made an exit after the final line.","exampleTranslation":"Diễn viên đã có sự đi vào sau dòng cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"fare":{"definition":"Tiền xe, tiền đò, tiền phà; tiền vé (tàu, máy bay... ).","example":"The fare was cheaper on the early bus.","exampleTranslation":"Tiền vé rẻ hơn trên chuyến xe buýt sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"fleet":{"definition":"Đoàn tàu, đoàn xe (của ai).","example":"The company runs a small fleet of vans.","exampleTranslation":"Công ty điều hành một đoàn xe van nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"flying":{"definition":"Chuyến bay.","example":"Our flying was delayed by the heavy rain.","exampleTranslation":"Chuyến bay của chúng tôi đã bị trì hoãn bởi cơn mưa lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"halt":{"definition":"Sự tạm nghỉ, sự tạm dừng lại (trong lúc đang đi... ).","example":"The train came to a sudden halt near the station.","exampleTranslation":"Con tàu đã dừng lại đột ngột gần nhà ga.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"hatchback":{"definition":"Xe ô tô có khoang hành lý thu gọn vào trong ca-bin, cửa lật phía sau vát thẳng từ đèn hậu lên nóc ca-bin với bản lề mở lên phía trên.","example":"We drove a small hatchback to town.","exampleTranslation":"Chúng tôi lái một chiếc xe hatchback nhỏ vào thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"headwind":{"definition":"Gió ngược.","example":"The headwind made our walk feel much longer.","exampleTranslation":"Gió ngược làm cho chuyến đi bộ của chúng tôi cảm thấy dài hơn nhiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"highway":{"definition":"Đường cái, quốc lộ.","example":"The highway was busy all morning.","exampleTranslation":"Quốc lộ rất nhộn nhịp suốt cả buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"hood":{"definition":"Capô (ô tô).","example":"He lifted the hood to check the engine.","exampleTranslation":"Anh ấy nhấc capô lên để kiểm tra động cơ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"launch":{"definition":"Xuồng lớn (lớn nhất trên một tàu chiến).","example":"The launch waited beside the ship all morning.","exampleTranslation":"Xuồng lớn chờ bên cạnh con tàu suốt buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"launcher":{"definition":"Người phóng, máy phóng (lựu đạn, tên lửa... ).","example":"The launcher sent the ball across the field.","exampleTranslation":"Máy phóng đã bắn quả bóng qua cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"lift":{"definition":"Sự nâng lên, sự nhấc lên; sự nâng cao, sự nhấc cao.","example":"The lift made the box easy to carry.","exampleTranslation":"Sự nâng lên đã làm cho chiếc hộp dễ mang vác hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"load":{"definition":"Vậy nặng, gánh nặng.","example":"The truck can carry a heavy load easily.","exampleTranslation":"Chiếc xe tải có thể chở một gánh nặng nặng dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"mariner":{"definition":"Thuỷ thủ.","example":"The mariner watched the stars.","exampleTranslation":"Người thuỷ thủ nhìn những vì sao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"mast":{"definition":"Cột buồm.","example":"The mast broke in the wind.","exampleTranslation":"Cột buồm đã gãy trong gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"naval":{"definition":"Hải quân, (thuộc) thuỷ quân.","example":"My uncle served as a brave naval officer.","exampleTranslation":"Chú tôi đã phục vụ như một sĩ quan hải quân dũng cảm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transport"},"navigate":{"definition":"Đem thông qua.","example":"They had to navigate the ship through heavy fog.","exampleTranslation":"Họ phải điều khiển con tàu vượt qua sương mù dày đặc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"navigation":{"definition":"Nghề hàng hải, sự đi biển, sự đi sông.","example":"Aerial navigation has changed how we travel today.","exampleTranslation":"Hàng hải hàng không đã thay đổi cách chúng ta đi du lịch ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"navigator":{"definition":"Thợ làm đất, thợ đấu.","example":"The navigator fixed the soil with careful hands.","exampleTranslation":"Người làm đất đã sửa sang đất với đôi bàn tay cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"paddle":{"definition":"Cái giầm; cánh (guồng nước).","example":"She used a double paddle to move the boat.","exampleTranslation":"Cô ấy dùng mái chèo đôi để di chuyển chiếc thuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"park":{"definition":"Vườn hoa, công viên.","example":"We walked through the park every Sunday morning.","exampleTranslation":"Chúng tôi đã đi dạo qua công viên vào mỗi sáng Chủ nhật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"passenger":{"definition":"(thuộc) hành khách; để chở hành khách.","example":"The passenger boat arrived at the dock on time.","exampleTranslation":"Con tàu chở hành khách đã cập bến đúng giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"passer":{"definition":"Passer-by.","example":"A passer smiled as he walked by.","exampleTranslation":"Một người đi đường mỉm cười khi anh ta bước qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"pave":{"definition":"Lát (đường, sàn... ).","example":"They pave the yard with stone.","exampleTranslation":"Họ lát cái sân bằng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"pickup":{"definition":"Sự tăng tốc độ.","example":"We noticed a pickup in speed after lunch.","exampleTranslation":"Chúng tôi nhận thấy sự tăng tốc độ sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"pilot":{"definition":"Hoa tiêu.","example":"The deep-sea pilot guided the large ship safely.","exampleTranslation":"Hoa tiêu biển sâu đã hướng dẫn con tàu lớn một cách an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"platform":{"definition":"Sân ga, ke ga.","example":"We waited on the platform for the train.","exampleTranslation":"Chúng tôi đợi trên sân ga để đón tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"port":{"definition":"Cảng.","example":"The large ship entered the busy port.","exampleTranslation":"Con tàu lớn tiến vào cảng bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"propel":{"definition":"Đẩy đi, đẩy tới ((nghĩa đen) & (nghĩa bóng)).","example":"The strong wind can propel the boat forward.","exampleTranslation":"Cơn gió mạnh có thể đẩy con thuyền tiến về phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"queue":{"definition":"Hàng (người, xe ô tô ở ngã tư khi có đèn đỏ... ) xếp nối đuôi.","example":"Please stand in a queue at the gate.","exampleTranslation":"Vui lòng đứng xếp hàng tại cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"railway":{"definition":"(thuộc) đường sắt.","example":"He works for a large railway company now.","exampleTranslation":"Anh ấy làm việc cho một công ty đường sắt lớn bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"rams":{"definition":"Động từ chia ở ngôi thứ ba số ít của ram","example":"The truck rams the gate when pushed hard.","exampleTranslation":"Chiếc xe tải húc vào cổng khi bị đẩy mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"rear":{"definition":"Bộ phận đằng sau, phía sau.","example":"The garden is located at the rear of the house.","exampleTranslation":"Khu vườn nằm ở phía sau của ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"ride":{"definition":"Sự đi chơi, cuộc đi chơi (bằng ngựa, xe đạp, xe ô tô, xe buýt, xe lửa...).","example":"We went for a long ride in the park.","exampleTranslation":"Chúng tôi đã đi một chuyến đi dài trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"roadside":{"definition":"Bờ đường, lề đường.","example":"We parked on the roadside and ate lunch.","exampleTranslation":"Chúng tôi đỗ xe bên bờ đường và ăn trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"route":{"definition":"Tuyến đường, đường đi.","example":"We are currently en route to the city.","exampleTranslation":"Chúng tôi hiện đang trên đường đi đến thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"rudder":{"definition":"Bánh lái.","example":"The boat turned when he moved the rudder.","exampleTranslation":"Con thuyền đã quay hướng khi anh ấy di chuyển bánh lái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"sail":{"definition":"Tàu, thuyền.","example":"We saw a small sail on the ocean.","exampleTranslation":"Chúng tôi nhìn thấy một cánh buồm nhỏ trên đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"seagoing":{"definition":"Vượt biển, đi biển.","example":"The seagoing vessel sailed across the deep blue ocean.","exampleTranslation":"Chiếc tàu vượt biển đã đi xuyên qua đại dương sâu thẳm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transport"},"seat":{"definition":"Ghế; vé chỗ ngồi, chỗ ngồi.","example":"I would like to book a seat on the plane.","exampleTranslation":"Tôi muốn đặt một chỗ ngồi trên máy bay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"sedan":{"definition":"Ghế kiệu","example":"The sedan chair moved slowly through the crowd.","exampleTranslation":"Chiếc ghế kiệu di chuyển chậm chạp qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"shipwreck":{"definition":"Sự sụp đổ, sự thất bại hoàn toàn.","example":"The shipwreck of his fortune was a tragedy.","exampleTranslation":"Sự sụp đổ hoàn toàn về tài sản của anh ấy là một bi kịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"station":{"definition":"Trạm, điểm, đồn, đài (phát thanh... ).","example":"They arrived at the local train station early.","exampleTranslation":"Họ đến trạm xe lửa địa phương sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"steer":{"definition":"Hướng theo một con đường, hướng bước về.","example":"You must steer the boat toward the shore.","exampleTranslation":"Bạn phải hướng con thuyền về phía bờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"submarine":{"definition":"Dưới biển, ngầm (dưới biển).","example":"The submarine plant is located deep under the sea.","exampleTranslation":"Nhà máy ngầm nằm sâu dưới biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transport"},"tank":{"definition":"Thùng, két, bể (chứa nước, dầu... ).","example":"Water filled the tank before dawn.","exampleTranslation":"Nước đầy ắp thùng trước lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"towed":{"definition":"Quá khứ và phân từ quá khứ của tow","example":"The truck towed the trailer home.","exampleTranslation":"Chiếc xe tải đã kéo rơ-moóc về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"track":{"definition":"Dấu, vết.","example":"The car left a clear track in the mud.","exampleTranslation":"Chiếc xe đã để lại một dấu rõ ràng trong bùn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"tram":{"definition":"Sợi khổ (của nhung, lụa).","example":"This tram gives the fabric a smooth tram.","exampleTranslation":"Sợi khổ này làm cho vải có một sợi khổ trơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"tramway":{"definition":"Đường xe điện.","example":"The tramway runs through the city center.","exampleTranslation":"Đường xe điện chạy qua trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"trolley":{"definition":"Xe dọn bàn (đẩy thức ăn ở các quán ăn).","example":"The waiter rolled the trolley to each table.","exampleTranslation":"Người phục vụ đẩy xe dọn bàn tới từng bàn ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"truck":{"definition":"Quan hệ.","example":"I will have no truck with his lies.","exampleTranslation":"Tôi sẽ không có bất kỳ quan hệ nào với những lời dối trá của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"tunnel":{"definition":"Đào đường hầm xuyên qua.","example":"They plan to tunnel a hill for the road.","exampleTranslation":"Họ có kế hoạch đào đường hầm xuyên qua một ngọn đồi để làm đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"transport"},"tyre":{"definition":"Bản (cao su, sắt... ) cạp vành (bánh xe); lốp xe.","example":"You need to replace the old rubber tyre.","exampleTranslation":"Bạn cần thay chiếc lốp xe cao su cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"underground":{"definition":"Dưới đất, ngầm.","example":"The underground railway is very efficient for commuters.","exampleTranslation":"Đường sắt dưới đất rất hiệu quả cho những người đi làm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transport"},"veer":{"definition":"Sự quay thuyền chạy theo chiều gió.","example":"The captain used a veer to catch wind.","exampleTranslation":"Thuyền trưởng đã sử dụng sự quay thuyền để đón gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"walkway":{"definition":"Đường dành cho người đi bộ.","example":"The walkway was wet after rain.","exampleTranslation":"Đường dành cho người đi bộ đã ướt sau trận mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"waterborne":{"definition":"Chở bằng đường thuỷ (hàng hoá).","example":"The cargo arrived as a waterborne shipment.","exampleTranslation":"Hàng hóa đã đến như một chuyến hàng chở bằng đường thủy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"transport"},"waterway":{"definition":"Đường thủy, đường sông tàu bè qua lại được.","example":"The boat moved along the narrow waterway.","exampleTranslation":"Con thuyền di chuyển dọc theo đường thủy hẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"wheel":{"definition":"Bánh (xe) ((nghĩa đen) & (nghĩa bóng)).","example":"He checked the pressure in the front wheel today.","exampleTranslation":"Anh ấy đã kiểm tra áp suất ở bánh xe phía trước ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"winch":{"definition":"Ống cuộn dây câu.","example":"He checked the winch before lifting the box.","exampleTranslation":"Anh ấy đã kiểm tra ống cuộn dây câu trước khi nâng chiếc hộp lên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"transport"},"city":{"definition":"Thành phố, thành thị, đô thị.","example":"The city invested in reliable public transport to reduce traffic congestion.","exampleTranslation":"Thành phố đã đầu tư vào hệ thống giao thông công cộng đáng tin cậy để giảm ùn tắc.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"city"},"housing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của house.","example":"I am housing two kittens in a warm box.","exampleTranslation":"Tôi đang nuôi hai chú mèo con trong một cái hộp ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"resident":{"definition":"Cư trú, tạm trú, ở chính thức (một nơi nào).","example":"The resident population is growing very quickly now.","exampleTranslation":"Dân số thường trú đang tăng lên rất nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"resident"},"residential":{"definition":"Nhà ở, (thuộc) nhà riêng.","example":"They live in a quiet residential area nearby.","exampleTranslation":"Họ sống trong một khu dân cư yên tĩnh gần đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"residential"},"architect":{"definition":"người làm ra, người xây dựng, người sáng tạo.","example":"She was the architect of this new project.","exampleTranslation":"Cô ấy là kiến trúc sư của dự án mới này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architect"},"building":{"definition":"Tòa nhà, kiến tạo.","example":"The building has five floors and a lift.","exampleTranslation":"Tòa nhà này có năm tầng và một thang máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"building"},"construction":{"definition":"Sự xây dựng.","example":"The new bridge is currently under construction nearby.","exampleTranslation":"Cây cầu mới hiện đang trong quá trình xây dựng gần đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"construction"},"suburb":{"definition":"Ngoại ô.","example":"They moved to a quiet suburb near the city.","exampleTranslation":"Họ chuyển đến một vùng ngoại ô yên tĩnh gần thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"suburb"},"apartment":{"definition":"Căn hộ: dãy buồng ở một tầng (cho một gia đình).","example":"They live in a small apartment near downtown.","exampleTranslation":"Họ sống trong một căn hộ nhỏ gần trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"apartment"},"homeless":{"definition":"Không cửa không nhà, vô gia cư.","example":"Many homeless people need safe shelter.","exampleTranslation":"Nhiều người vô gia cư cần nơi trú ẩn an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"homeless"},"homelessness":{"definition":"Tình trạng không cửa không nhà, tình trạng vô gia cư.","example":"Homelessness can make daily life very hard.","exampleTranslation":"Tình trạng vô gia cư có thể làm cho cuộc sống hàng ngày trở nên rất khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"homeless"},"rent":{"definition":"Tô, lợi, tiền thuê.","example":"We pay rent for the apartment each month.","exampleTranslation":"Chúng tôi trả tiền thuê căn hộ hàng tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"rent"},"rentable":{"definition":"Có thể cho thuê.","example":"This apartment is rentable for short stays.","exampleTranslation":"Căn hộ này có thể cho thuê để ở ngắn hạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"rent"},"rental":{"definition":"Tiền cho thuê (nhà, đất); lợi tức cho thuê (nhà đất); lợi tức thu tô (ruộng đất).","example":"Her rental was due at the start of the month.","exampleTranslation":"Tiền thuê nhà của cô ấy đến hạn vào đầu tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"rent"},"renter":{"definition":"Người thuê (nhà, đất); người cấy nộp tô.","example":"The renter paid on time every month.","exampleTranslation":"Người thuê nhà thanh toán đúng hạn mỗi tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"rent"},"property":{"definition":"Quyền sở hữu, tài sản, của cải, vật sở hữu.","example":"He is a man of property and wealth.","exampleTranslation":"Anh ấy là một người đàn ông có tài sản và sự giàu có.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"property"},"develop":{"definition":"Phát triển, mở mang, mở rộng, khuếch trương, làm cho phát đạt.","example":"The company plans to develop new software this year.","exampleTranslation":"Công ty dự định phát triển phần mềm mới trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"develop"},"developable":{"definition":"Có thể khai triển được.","example":"The idea is developable with more work.","exampleTranslation":"Ý tưởng này có thể phát triển được nếu làm việc nhiều hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"develop"},"developed":{"definition":"Quá khứ và phân từ quá khứ của develop","example":"The town developed a new bus line.","exampleTranslation":"Thị trấn đã phát triển một tuyến xe buýt mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"develop"},"developer":{"definition":"Người rửa ảnh; thuốc rửa ảnh.","example":"The developer mixed the chemicals carefully.","exampleTranslation":"Người thực hiện đã pha trộn các hóa chất một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"develop"},"developing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của develop.","example":"They are developing a better study plan.","exampleTranslation":"Họ đang phát triển một kế hoạch học tập tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"develop"},"development":{"definition":"Sự phát triển.","example":"The city saw rapid economic development this year.","exampleTranslation":"Thành phố chứng kiến sự phát triển kinh tế nhanh chóng trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"develop"},"planning":{"definition":"Việc lập kế hoạch để xác định trước cách thực hiện một việc.","example":"Careful planning helped the city reduce traffic congestion.","exampleTranslation":"Việc quy hoạch cẩn thận đã giúp thành phố giảm ùn tắc giao thông.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"planning"},"neighbor":{"definition":"Hàng xóm.","example":"The house neighbor helps us with repairs.","exampleTranslation":"Người hàng xóm cạnh nhà giúp chúng tôi sửa chữa mọi thứ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"neighbor"},"neighborhood":{"definition":"(dân) hàng xóm.","example":"Our neighborhood is quiet and friendly.","exampleTranslation":"Khu phố của chúng tôi yên tĩnh và thân thiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"neighbor","spellingNote":"British spelling: neighbourhood."},"neighborly":{"definition":"Ăn ở với xóm giềng thuận hoà.","example":"The plan looked neighborly in practice.","exampleTranslation":"Kế hoạch này trông có vẻ thân thiện với hàng xóm trên thực tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"neighbor","spellingNote":"British spelling: neighbourly."},"municipal":{"definition":"Thành phố, (thuộc) đô thị, (thuộc) thị xã.","example":"The municipal council met to discuss the park.","exampleTranslation":"Hội đồng thành phố đã họp để thảo luận về công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"municip"},"village":{"definition":"Làng, xã.","example":"The village is small and peaceful.","exampleTranslation":"Ngôi làng nhỏ bé và yên bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"village"},"settlement":{"definition":"Sự chuyển gia tài.","example":"The lawyer handled the settlement of the estate.","exampleTranslation":"Luật sư đã xử lý việc dàn xếp tài sản thừa kế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"settlement"},"accommodation":{"definition":"Sự điều tiết (sức nhìn của mắt).","example":"The eye's accommodation changed in bright light.","exampleTranslation":"Sự điều tiết của mắt thay đổi trong ánh sáng mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"accommodation"},"accessible":{"definition":"Có thể tới được, có thể gần được.","example":"The village is accessible by bicycle from here.","exampleTranslation":"Ngôi làng có thể tới được bằng xe đạp từ đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"housing"},"accommodate":{"definition":"Điều tiết, làm cho thích nghi, làm cho phù hợp.","example":"We must accommodate ourselves to the new rules.","exampleTranslation":"Chúng ta phải tự điều tiết để phù hợp với những quy định mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"aisle":{"definition":"Lối đi giữa các dãy ghế (trong nhà thờ, ở rạp hát, xe lửa, xe buýt).","example":"I walked down the aisle to my seat.","exampleTranslation":"Tôi đã đi dọc theo lối đi giữa các dãy ghế để đến chỗ ngồi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"avenue":{"definition":"Đại lộ.","example":"We walked down the main avenue after lunch.","exampleTranslation":"Chúng tôi đã đi bộ dọc đại lộ chính sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"bathroom":{"definition":"Buồng tắm, phòng tắm, nhà vệ sinh.","example":"The bathroom needs a clean towel.","exampleTranslation":"Phòng tắm cần một chiếc khăn sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"bedding":{"definition":"Bộ đồ giường (chăn, gối, nệm, khăn trải giường).","example":"We bought new bedding for the guest room.","exampleTranslation":"Chúng tôi đã mua bộ đồ giường mới cho phòng khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"bedroom":{"definition":"Buồng ngủ.","example":"My bedroom is small but bright.","exampleTranslation":"Buồng ngủ của tôi nhỏ nhưng sáng sủa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"bench":{"definition":"Băng ghế, ghế dài.","example":"We sat on a bench in the park.","exampleTranslation":"Chúng tôi ngồi trên một băng ghế trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"blanket":{"definition":"Lớp phủ.","example":"A blanket of snow covered the entire field.","exampleTranslation":"Một lớp phủ tuyết bao phủ toàn bộ cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"block":{"definition":"Khối, tảng, súc (đá, gỗ...).","example":"We moved a heavy block into the corner.","exampleTranslation":"Chúng tôi đã chuyển một khối nặng vào góc phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"bund":{"definition":"Anh, Ân đê, đập.","example":"The bund held back the river water.","exampleTranslation":"Đập nước đã ngăn lại nước sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"comfortable":{"definition":"Tiện lợi, đủ tiện nghi; ấm cúng.","example":"They stayed in a comfortable room near the beach.","exampleTranslation":"Họ đã ở trong một căn phòng tiện nghi gần bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"housing"},"comfortably":{"definition":"Sung túc, phong lưu.","example":"They lived comfortably off their large inheritance.","exampleTranslation":"Họ sống một cách sung túc nhờ vào khoản thừa kế lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"housing"},"convenience":{"definition":"Sự tiện lợi, sự thuận lợi; sự thích hợp.","example":"The new mall offers great convenience for shoppers.","exampleTranslation":"Trung tâm thương mại mới mang lại sự thuận lợi tuyệt vời cho người mua sắm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"convenient":{"definition":"Tiện lợi, thuận lợi; thích hợp.","example":"Is it convenient for us to meet at noon?","exampleTranslation":"Có thuận tiện để chúng ta gặp nhau vào buổi trưa không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"housing"},"conveniently":{"definition":"Tiện lợi, thuận tiện.","example":"The team finished conveniently and left.","exampleTranslation":"Cả đội đã hoàn thành công việc một cách thuận tiện và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"housing"},"couch":{"definition":"Giường.","example":"She sat on a couch of pain for hours.","exampleTranslation":"Cô ấy đã ngồi trên một chiếc giường chịu đau trong nhiều giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"cupboard":{"definition":"Tủ (có ngăn), tủ búp phê.","example":"Please put the plates inside the kitchen cupboard.","exampleTranslation":"Làm ơn hãy đặt đĩa vào trong tủ bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"curtain":{"definition":"Màn cửa.","example":"She pulled the curtain to block out the sun.","exampleTranslation":"Cô ấy kéo màn cửa để chặn ánh nắng mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"cushion":{"definition":"Hơi đệm (hơi còn lại trong xylanh để đệm pittông).","example":"The engine kept a cushion of air inside.","exampleTranslation":"Động cơ giữ một hơi đệm không khí bên trong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"doorbell":{"definition":"Chuồng (ở) cửa.","example":"Press the doorbell when you arrive.","exampleTranslation":"Nhấn chuồng cửa khi bạn đến nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"doorway":{"definition":"Ô cửa (khoảng trống của khung cửa).","example":"She stood in the doorway waiting for her guests.","exampleTranslation":"Cô ấy đứng trong ô cửa đợi khách của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"driveway":{"definition":"Đường lái xe vào nhà (trong khu vực một toà nhà).","example":"The driveway was full of fallen leaves.","exampleTranslation":"Đường lái xe vào nhà phủ đầy lá rụng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"dwell":{"definition":"ở, sống ở, ngụ.","example":"They chose to dwell in the country for peace.","exampleTranslation":"Họ chọn sống ở nông thôn để được bình yên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"dweller":{"definition":"Người ở.","example":"The dweller lived near the river for years.","exampleTranslation":"Người ở đó đã sống gần con sông nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"enclose":{"definition":"Vây quanh, rào quanh.","example":"They enclose the garden with a fence.","exampleTranslation":"Họ vây quanh khu vườn bằng một hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"estate":{"definition":"Tài sản, di sản.","example":"She left a large estate to her children.","exampleTranslation":"Bà ấy đã để lại một tài sản lớn cho các con của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"flat":{"definition":"Dãy phòng (ở một tầng trong một nhà khối).","example":"We walked past a flat in the city.","exampleTranslation":"Chúng tôi đã đi bộ qua một dãy phòng trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"furnishing":{"definition":"Sự cung cấp, sự trang bị đồ đạc.","example":"The furnishing of the room took all day.","exampleTranslation":"Việc trang bị đồ đạc cho căn phòng mất cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"furniture":{"definition":"Trang bị (của máy móc, tàu bè).","example":"The machine's furniture was easy to clean.","exampleTranslation":"Các trang bị của cỗ máy dễ lau chùi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"homestead":{"definition":"Đất cấp cho người di cư (với điều kiện phải ở đó và trồng trọt đất đó).","example":"They settled on a homestead in the hills.","exampleTranslation":"Họ đã ổn định cuộc sống trên một mảnh đất cấp ở trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"kitchen":{"definition":"Phòng bếp, nhà bếp.","example":"We cook dinner together in the kitchen.","exampleTranslation":"Chúng tôi nấu bữa tối cùng nhau trong nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"landlord":{"definition":"Chủ nhà (nhà cho thuê).","example":"The landlord fixed the broken heater.","exampleTranslation":"Chủ nhà đã sửa cái máy sưởi bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"landowner":{"definition":"Địa chủ.","example":"The landowner fixed the fence this morning.","exampleTranslation":"Địa chủ đã sửa cái hàng rào vào sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"lawn":{"definition":"Vải batit (một thứ vải gai mịn).","example":"The dress was made of fine lawn.","exampleTranslation":"Chiếc váy được làm từ vải batit mịn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"lease":{"definition":"Hợp đồng cho thuê.","example":"They signed a lease for the new apartment.","exampleTranslation":"Họ đã ký hợp đồng cho thuê căn hộ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"letting":{"definition":"Tài sản (nhà, căn hộ) cho thuê.","example":"The house is for letting next month.","exampleTranslation":"Ngôi nhà đang được để cho thuê tháng tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"mansion":{"definition":"Lâu đài.","example":"They live in a large mansion by the lake.","exampleTranslation":"Họ sống trong một lâu đài lớn bên hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"matting":{"definition":"Chiếu thảm.","example":"We bought matting for the hallway.","exampleTranslation":"Chúng tôi đã mua chiếu thảm cho hành lang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"occupy":{"definition":"Choán, chiếm cứ.","example":"Many deep worries occupy her mind every night.","exampleTranslation":"Nhiều nỗi lo sâu sắc chiếm cứ tâm trí cô ấy mỗi đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"pipe":{"definition":"Điếu, tẩu (hút thuốc); (một) tẩu thuốc.","example":"My grandfather likes to smoke a wooden pipe.","exampleTranslation":"Ông nội tôi thích hút tẩu thuốc gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"plot":{"definition":"Mảnh đất nhỏ, miếng đất.","example":"They bought a small plot of land nearby.","exampleTranslation":"Họ đã mua một mảnh đất nhỏ gần đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"reside":{"definition":"Thuộc về (thẩm quyền, quyền hạn... ).","example":"The power to approve the plan does not reside here.","exampleTranslation":"Quyền phê duyệt kế hoạch không nằm ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"residence":{"definition":"Sự ở, sự cư trú, sự trú ngụ.","example":"She decided to take up residence in Paris.","exampleTranslation":"Cô ấy đã quyết định cư trú tại Paris.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"shelter":{"definition":"Chỗ che, chỗ nương tựa, chỗ ẩn, chỗ núp, hầm.","example":"They gave shelter to the homeless people nearby.","exampleTranslation":"Họ đã cung cấp nơi nương tựa cho những người vô gia cư gần đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"sidewalk":{"definition":"Vỉa hè, lề đường.","example":"They walked along the crowded sidewalk.","exampleTranslation":"Họ đi bộ dọc theo vỉa hè đông đúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"sink":{"definition":"(nghĩa bóng)) vũng nước bẩn, vũng lầy; ổ.","example":"He fell into a sink of bad habits.","exampleTranslation":"Anh ấy rơi vào một vũng lầy của những thói xấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"sofa":{"definition":"Ghế xôfa, ghế trường kỷ.","example":"We relaxed on the sofa after dinner.","exampleTranslation":"Chúng tôi thư giãn trên ghế xôfa sau bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"storeroom":{"definition":"Buồng kho; kho thực phẩm (trên tàu).","example":"We kept the paint cans in the storeroom.","exampleTranslation":"Chúng tôi để các hộp sơn trong buồng kho.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"street":{"definition":"Phố, đường phố.","example":"We walked down a quiet side street together.","exampleTranslation":"Chúng tôi đi bộ xuống một phố yên tĩnh cùng nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"suburban":{"definition":"Ngoại ô.","example":"They live in a quiet suburban street.","exampleTranslation":"Họ sống ở một con phố ngoại ô yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"housing"},"suburbanite":{"definition":"Người ngoại ô.","example":"A suburbanite often commutes into the city.","exampleTranslation":"Một người ngoại ô thường đi làm vào thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"tenancy":{"definition":"Sự thuê, mướn (nhà, đất... ), sự lĩnh canh.","example":"The expiration of tenancy was scheduled for June.","exampleTranslation":"Việc hết hạn thuê nhà đã được lên lịch cho tháng Sáu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"tenant":{"definition":"Tá điền.","example":"The tenant paid rent at the start of the month.","exampleTranslation":"Tá điền đã trả tiền thuê vào đầu tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"toilet":{"definition":"Sự trang điểm.","example":"She spent an hour to make her toilet.","exampleTranslation":"Cô ấy đã dành một giờ để trang điểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"towel":{"definition":"Khăn lau; khăn tắm.","example":"He grabbed a towel after swimming.","exampleTranslation":"Anh ấy cầm lấy một chiếc khăn lau sau khi bơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"township":{"definition":"Quận, huyện (từ Mỹ, nghĩa Mỹ), Ca-na-đa.","example":"The township fixed the road near my house.","exampleTranslation":"Quận đã sửa chữa con đường gần nhà tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"uncrowded":{"definition":"Không đông; không bị tắc nghẽn (đường phố... ).","example":"The road was uncrowded at dawn.","exampleTranslation":"Con đường không bị tắc nghẽn vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"housing"},"uptown":{"definition":"(thuộc) phố trên; ở phố trên.","example":"They found an uptown apartment near the park.","exampleTranslation":"Họ đã tìm thấy một căn hộ phố trên gần công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"housing"},"villa":{"definition":"Biệt thự; biệt thự ở ngoại ô.","example":"A villa helped the team.","exampleTranslation":"Một biệt thự đã giúp ích cho đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"housing"},"zone":{"definition":"Chia thành đới, chia thành khu vực, quy vùng.","example":"They plan to zone the district for industry.","exampleTranslation":"Họ lập kế hoạch quy vùng quận này cho công nghiệp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"housing"},"souvenir":{"definition":"Vật được giữ lại để gợi nhớ về một nơi hoặc trải nghiệm.","example":"She bought a locally made souvenir to remember the trip.","exampleTranslation":"Cô mua một món quà lưu niệm làm tại địa phương để nhớ về chuyến đi.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"cruise":{"definition":"Chuyến du lịch bằng tàu, thường ghé thăm nhiều địa điểm.","example":"The cruise stopped at several coastal towns.","exampleTranslation":"Chuyến du lịch bằng tàu dừng tại một số thị trấn ven biển.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"travel":{"definition":"Đi du lịch; du hành, lữ hành .","example":"They will travel by sea to reach Japan.","exampleTranslation":"Họ sẽ di chuyển bằng đường biển để đến Nhật Bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"travel"},"traveled":{"definition":"Đã đi nhiều, đã từng đi đây đi đó; bôn ba từng trải.","example":"He looked traveled and confident.","exampleTranslation":"Anh ấy trông có vẻ dày dạn kinh nghiệm đi lại và tự tin.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"travel","spellingNote":"British spelling: travelled."},"traveler":{"definition":"Người đi, người đi du lịch, người đi du hành, lữ khách, người hay đi.","example":"The traveler asked for directions to the station.","exampleTranslation":"Người du hành đã hỏi đường đến nhà ga.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"travel","spellingNote":"British spelling: traveller."},"traveling":{"definition":"Việc đi du lịch; hoạt động di chuyển đến các địa điểm khác nhau.","example":"Traveling can expose students to different cultures.","exampleTranslation":"Việc đi du lịch có thể giúp sinh viên tiếp xúc với những nền văn hóa khác nhau.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"travel","spellingNote":"British spelling: travelling."},"tour":{"definition":"Cuộc đi, cuộc đi du lịch.","example":"They went on a tour round the world.","exampleTranslation":"Họ đã đi một chuyến tham quan vòng quanh thế giới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tour"},"toured":{"definition":"Quá khứ và phân từ quá khứ của tour","example":"We toured the old castle last weekend.","exampleTranslation":"Chúng tôi đã tham quan lâu đài cổ cuối tuần trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"tour"},"touring":{"definition":"Đi, đi du lịch.","example":"The touring cyclist traveled across the entire country.","exampleTranslation":"Tay đua xe đạp đi du lịch đã đi khắp đất nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tour"},"tourism":{"definition":"Thú du lịch.","example":"Her tourism grew after the first mountain trip.","exampleTranslation":"Ngành du lịch của cô ấy phát triển sau chuyến đi lên núi đầu tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tour"},"tourist":{"definition":"Nhà du lịch, khách du lịch.","example":"The tourist took photos of the old bridge.","exampleTranslation":"Khách du lịch đã chụp ảnh cây cầu cổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tour"},"vacating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của vacate.","example":"They were vacating the old office.","exampleTranslation":"Họ đang dọn ra khỏi văn phòng cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"vacat"},"vacation":{"definition":"Sự bỏ trống, sự bỏ không.","example":"We plan to take a vacation next summer.","exampleTranslation":"Chúng tôi dự định đi nghỉ vào mùa hè tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"vacat"},"holiday":{"definition":"(thuộc) ngày lễ, (thuộc) ngày nghỉ.","example":"She wore her favorite holiday clothes to the beach.","exampleTranslation":"Cô ấy mặc bộ quần áo đi nghỉ yêu thích của mình đến bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"holiday"},"hotel":{"definition":"Khách sạn.","example":"We stayed at a small hotel near the station.","exampleTranslation":"Chúng tôi đã ở tại một khách sạn nhỏ gần nhà ga.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"hotel"},"destination":{"definition":"Nơi gửi tới, nơi đưa tới, nơi đi tới.","example":"Our destination is a small town by the sea.","exampleTranslation":"Điểm đến của chúng tôi là một thị trấn nhỏ ven biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"destination"},"exploration":{"definition":"Sự thông dò.","example":"The doctor began an exploration of the wound.","exampleTranslation":"Bác sĩ đã bắt đầu thăm khám vết thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"explor"},"explorer":{"definition":"Cái thông dò.","example":"The explorer on the map found a hidden cave.","exampleTranslation":"Nhà thám hiểm trên bản đồ đã tìm thấy một hang động ẩn giấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"explor"},"exploring":{"definition":"Sự thăm dò; sự thám hiểm.","example":"Their exploring led them to a quiet cave.","exampleTranslation":"Cuộc khám phá của họ đã dẫn họ đến một hang động yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"explor"},"excursion":{"definition":", (quân sự) cuộc đánh thọc ra.","example":"The soldiers made a quick excursion beyond the line.","exampleTranslation":"Các binh sĩ đã thực hiện một chuyến đi ngắn ra ngoài giới tuyến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"excursion"},"leisure":{"definition":"Thì giờ rỗi rãi, lúc thư nhàn.","example":"She enjoys reading at her leisure.","exampleTranslation":"Cô ấy thích đọc sách khi rảnh rỗi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"leisure"},"heritage":{"definition":"Tài sản thừa kế, di sản.","example":"She kept her grandmother's letters as heritage.","exampleTranslation":"Cô ấy giữ lại những bức thư của bà mình như một phần di sản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"heritage"},"backpack":{"definition":"Cái ba lô đeo trên vai.","example":"She packed her books into a backpack.","exampleTranslation":"Cô ấy đã xếp sách vào ba lô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"backpack"},"backpacker":{"definition":"Khách du lịch chỉ có hành lý gọn nhẹ là một chiếc ba lô; du khách ba lô.","example":"The backpacker slept in a cheap room.","exampleTranslation":"Người du lịch bụi đã ngủ trong một căn phòng giá rẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"backpack"},"accommodating":{"definition":"Hay giúp đỡ, sẵn lòng giúp đỡ, hay làm ơn.","example":"He was accommodating and helped carry the bags.","exampleTranslation":"Anh ấy rất nhiệt tình và đã phụ xách hành lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"accommodat"},"flight":{"definition":"Sự bỏ chạy, sự rút chạy.","example":"The deer took flight when it saw us.","exampleTranslation":"Con hươu đã bỏ chạy ngay khi nhìn thấy chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"flight"},"flightless":{"definition":"Không bay được.","example":"This flightless bird runs very fast.","exampleTranslation":"Loài chim không biết bay này chạy rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"flight"},"airline":{"definition":"Công ty hàng không.","example":"The airline canceled flights because of fog.","exampleTranslation":"Hãng hàng không đã hủy các chuyến bay do sương mù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"airline"},"visitor":{"definition":"Khách, người đến thăm.","example":"A visitor came to see my family.","exampleTranslation":"Một vị khách đã đến thăm gia đình tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"visitor"},"attraction":{"definition":"Sự hú; sức hút.","example":"The local museum is a popular tourist attraction.","exampleTranslation":"Bảo tàng địa phương là một điểm thu hút khách du lịch nổi tiếng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"attraction"},"sightseeing":{"definition":"Sự đi tham quan.","example":"They spent the day sightseeing in town.","exampleTranslation":"Họ đã dành cả ngày để tham quan các thắng cảnh trong thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sightseeing"},"journey":{"definition":"Chặng đường đi, quãng đường đi (trong một thời gian nhất định).","example":"It was a long journey through the mountains.","exampleTranslation":"Đó là một hành trình dài xuyên qua những ngọn núi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"journey"},"adventure":{"definition":"Phiêu lưu, mạo hiểm, liều.","example":"They do not adventure into the deep forest.","exampleTranslation":"Họ không phiêu lưu vào khu rừng sâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"adventure"},"recreation":{"definition":"Sự giải lao, sự giải trí, sự tiêu khiển.","example":"We go to the park for recreation.","exampleTranslation":"Chúng tôi đến công viên để giải trí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"recreation"},"recreational":{"definition":"Sự giải trí, (thuộc) sự tiêu khiển; có tính chất giải trí, có tính chất tiêu khiển.","example":"We planned a recreational trip to the lake.","exampleTranslation":"Chúng tôi đã lên kế hoạch cho một chuyến đi giải trí đến hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"recreation"},"abroad":{"definition":"Ngoài trời (đối với trong nhà).","example":"The children love playing outside in the fresh air abroad.","exampleTranslation":"Những đứa trẻ thích chơi ngoài trời trong không khí trong lành ở nước ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"tourism"},"adventurer":{"definition":"Người phiêu lưu, người mạo hiểm, người thích phiêu lưu mạo hiểm.","example":"The adventurer crossed the desert alone.","exampleTranslation":"Người phiêu lưu đã băng qua sa mạc một mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"attract":{"definition":"Thu hút, hấp dẫn, lôi cuốn.","example":"The bright lights attract many tourists every night.","exampleTranslation":"Những ánh đèn sáng thu hút nhiều khách du lịch mỗi đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"tourism"},"attractive":{"definition":"Thu hút, hấp dẫn, lôi cuốn, quyến rũ; có duyên.","example":"That blue dress looks very attractive on you.","exampleTranslation":"Chiếc váy xanh đó trông rất quyến rũ trên người bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tourism"},"attractiveness":{"definition":"Sự hút.","example":"The attractiveness of the offer drew many buyers.","exampleTranslation":"Sự quyến rũ của lời đề nghị đã thu hút nhiều người mua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"breathtaking":{"definition":"Hấp dẫn, ngoạn mục.","example":"We saw a breathtaking view from the hill.","exampleTranslation":"Chúng tôi đã thấy một khung cảnh hấp dẫn từ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tourism"},"camp":{"definition":"Trại, chỗ cắm trại, hạ trại.","example":"We set up camp near the river.","exampleTranslation":"Chúng tôi dựng trại gần con sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"campsite":{"definition":"Địa điểm cắm trại.","example":"We pitched our tent at the campsite.","exampleTranslation":"Chúng tôi đã cắm trại tại địa điểm cắm trại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"casino":{"definition":"Câu lạc bộ, nhà chơi.","example":"They met at a small casino for dinner.","exampleTranslation":"Họ gặp nhau tại một câu lạc bộ nhỏ cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"dine":{"definition":"Ăn cơm (trưa, chiều).","example":"They like to dine at this fancy restaurant.","exampleTranslation":"Họ thích ăn cơm tại nhà hàng sang trọng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"tourism"},"diner":{"definition":"Người dự bữa ăn, người dự tiệc.","example":"Every diner smiled when the meal was served.","exampleTranslation":"Mỗi người dự bữa ăn đều mỉm cười khi món ăn được phục vụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"ecotourism":{"definition":"Du lịch sinh thái.","example":"Ecotourism supports nature and local communities.","exampleTranslation":"Du lịch sinh thái hỗ trợ thiên nhiên và cộng đồng địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"exotic":{"definition":"Kỳ lạ, kỳ cục; đẹp kỳ lạ.","example":"Her exotic style made the room feel special.","exampleTranslation":"Phong cách kỳ lạ của cô ấy làm cho căn phòng cảm thấy đặc biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tourism"},"guest":{"definition":"Vật ký sinh; trùng ký sinh; cây ký sinh.","example":"The plant was a guest on the tree.","exampleTranslation":"Cái cây này là vật ký sinh trên cây khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"guide":{"definition":"Người chỉ dẫn; người chỉ đường, người hướng dẫn (cho khách du lịch).","example":"Our guide led us through the old town.","exampleTranslation":"Người hướng dẫn của chúng tôi đã dẫn chúng tôi đi quanh thị trấn cổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"host":{"definition":"Số đông, loạt (người, sự việc, đồ vật), đám đông.","example":"A host of people gathered in the park.","exampleTranslation":"Một loạt người đã tụ tập trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"outing":{"definition":"Cuộc đi chơi; cuộc đi nghỉ hè (xa nhà).","example":"We took an outing to the lake yesterday.","exampleTranslation":"Chúng tôi đã có một cuộc đi chơi đến hồ ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"postcard":{"definition":"Bưu thiếp.","example":"She mailed a postcard from the beach.","exampleTranslation":"Cô ấy đã gửi một bưu thiếp từ bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"resort":{"definition":"Cái dùng đến, phương kế, phương sách.","example":"They solved the problem without resort to force.","exampleTranslation":"Họ đã giải quyết vấn đề mà không cần dùng đến vũ lực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"restaurant":{"definition":"Quán ăn, tiệm ăn.","example":"The restaurant was useful in class.","exampleTranslation":"Nhà hàng này đã được sử dụng trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"scenic":{"definition":"Sân khấu; (thuộc) kịch trường.","example":"The scenic play drew a large crowd.","exampleTranslation":"Vở kịch sân khấu này đã thu hút một đám đông lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tourism"},"suite":{"definition":"Dãy, bộ.","example":"They booked a luxury suite at the hotel.","exampleTranslation":"Họ đã đặt một dãy phòng sang trọng tại khách sạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"tent":{"definition":"Lều, rạp, tăng.","example":"We slept in a small tent by the lake.","exampleTranslation":"Chúng tôi đã ngủ trong một cái lều nhỏ bên hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"ticket":{"definition":"Giấy (giấy phép, giấy mời... ).","example":"Can you give me a free ticket for the show?","exampleTranslation":"Bạn có thể cho tôi một giấy mời miễn phí cho buổi diễn không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"traveller":{"definition":"Người đi chào hàng ((cũng) commercial traveller).","example":"The traveller sold tools from town to town.","exampleTranslation":"Người đi chào hàng đã bán các dụng cụ từ thị trấn này sang thị trấn khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"trek":{"definition":"Đoạn đường (đi bằng xe bò).","example":"The trek across the field took all afternoon.","exampleTranslation":"Đoạn đường qua cánh đồng mất cả buổi chiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"trip":{"definition":"Chuyến đi, cuộc hành trình, sự vượt biển.","example":"We are planning our first maiden trip to Europe.","exampleTranslation":"Chúng tôi đang lên kế hoạch cho chuyến đi đầu tiên tới châu Âu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"voyage":{"definition":"Cuộc du lịch xa bằng đường biển.","example":"The long voyage across the ocean took months.","exampleTranslation":"Cuộc du lịch xa bằng đường biển dài qua đại dương mất nhiều tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tourism"},"genre":{"definition":"Một thể loại nghệ thuật, văn học, âm nhạc hoặc truyền thông có đặc điểm chung.","example":"The documentary genre can present complex social issues to a wide audience.","exampleTranslation":"Thể loại phim tài liệu có thể truyền tải các vấn đề xã hội phức tạp đến đông đảo khán giả.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"culture"},"impressionism":{"definition":"Trào lưu nghệ thuật nhấn mạnh ấn tượng về ánh sáng, màu sắc và khoảnh khắc.","example":"Impressionism changed how artists represented light and movement.","exampleTranslation":"Chủ nghĩa Ấn tượng đã thay đổi cách họa sĩ thể hiện ánh sáng và chuyển động.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"culture"},"ballet":{"definition":"Nghệ thuật múa sân khấu sử dụng các động tác được luyện tập theo kỹ thuật.","example":"The ballet combined classical music with contemporary choreography.","exampleTranslation":"Buổi ba lê kết hợp âm nhạc cổ điển với vũ đạo đương đại.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"culture"},"poetry":{"definition":"Tác phẩm văn học dùng ngôn ngữ giàu nhịp điệu, hình ảnh và cảm xúc.","example":"Poetry can preserve local stories and ways of speaking.","exampleTranslation":"Thơ ca có thể lưu giữ những câu chuyện và cách nói của địa phương.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"culture"},"composer":{"definition":"Người sáng tác nhạc.","example":"The composer drew inspiration from traditional folk songs.","exampleTranslation":"Nhà soạn nhạc lấy cảm hứng từ các bài dân ca truyền thống.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"culture"},"cultural":{"definition":"Văn hoá.","example":"They are planning a cultural exchange program.","exampleTranslation":"Họ đang lên kế hoạch cho một chương trình giao lưu văn hóa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"cultural"},"culturally":{"definition":"Về phương diện văn hoá.","example":"She spoke culturally during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện theo cách thể hiện kiến thức văn hóa trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"cultural"},"artful":{"definition":"Khéo léo (người); làm có nghệ thuật (đồ vật).","example":"She made an artful vase from old clay.","exampleTranslation":"Cô ấy đã làm ra một chiếc bình đầy nghệ thuật từ đất sét cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"art"},"artist":{"definition":"Nghệ sĩ.","example":"He is a talented artist who paints beautiful landscapes.","exampleTranslation":"Anh ấy là một nghệ sĩ tài năng, người chuyên vẽ những bức tranh phong cảnh tuyệt đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"art"},"artless":{"definition":"Ngây thơ, chân thật, chất phác.","example":"The child gave an artless answer to the question.","exampleTranslation":"Đứa trẻ đã đưa ra một câu trả lời ngây thơ cho câu hỏi đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"art"},"arts":{"definition":"Nghệ thuật hoặc các hoạt động sáng tạo như âm nhạc và hội họa.","example":"Public funding helps local arts programs reach more young people.","exampleTranslation":"Nguồn tài trợ công giúp các chương trình nghệ thuật địa phương tiếp cận nhiều bạn trẻ hơn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"art"},"artistic":{"definition":"Có nghệ thuật; có mỹ thuật, khéo léo.","example":"The vase had an artistic shape and style.","exampleTranslation":"Chiếc bình có hình dáng và phong cách đầy tính nghệ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"artist"},"music":{"definition":"âm nhạc","example":"You cannot make any music with this trumpet, it is broken.","exampleTranslation":"Bạn không thể tạo ra bất kỳ âm nhạc nào bằng chiếc kèn này, nó bị hỏng rồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"music"},"musical":{"definition":"(thuộc) Nhạc, (thuộc) âm nhạc.","example":"The city is famous for its musical heritage.","exampleTranslation":"Thành phố này nổi tiếng với di sản âm nhạc của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"music"},"literature":{"definition":"Giới nhà văn.","example":"The conference brought together local literature and critics.","exampleTranslation":"Hội nghị đã quy tụ các tác phẩm văn học và các nhà phê bình địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"literature"},"literary":{"definition":"Văn chương, (thuộc) văn học, có tính chất văn chương, có tính chất văn học.","example":"He is a famous literary man today.","exampleTranslation":"Ông ấy là một nhà văn nổi tiếng ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"literary"},"museum":{"definition":"Viện bảo tàng, nhà bảo tàng.","example":"We visited the local history museum yesterday.","exampleTranslation":"Chúng tôi đã đến thăm bảo tàng lịch sử địa phương vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"museum"},"tradition":{"definition":"Truyền thống.","example":"It is a tradition to eat together today.","exampleTranslation":"Ăn uống cùng nhau ngày nay là một truyền thống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tradition"},"traditional":{"definition":"Truyền thống, theo truyền thống.","example":"They wore traditional clothes for the festival.","exampleTranslation":"Họ đã mặc trang phục truyền thống cho lễ hội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"tradition"},"custom":{"definition":"Sự đặt, sự thửa, sự đặt mua.","example":"I need to order some custom clothes soon.","exampleTranslation":"Tôi cần sớm đặt may một vài bộ quần áo theo yêu cầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"custom"},"customary":{"definition":"Thông thường, theo lệ thường, thành thói quen.","example":"It is customary to greet guests at the door.","exampleTranslation":"Chào đón khách tại cửa là một tập quán thường thấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"custom"},"customisation":{"definition":"Sự chế tạo (hoặc sửa chữa) theo yêu cầu của khách hàng.","example":"We asked for customisation of the chair size.","exampleTranslation":"Chúng tôi đã yêu cầu tùy chỉnh kích thước của chiếc ghế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"custom","spellingNote":"Alternate spelling: customization."},"customise":{"definition":"Làm theo yêu cầu của khách hàng.","example":"They customise each bag to match the buyer.","exampleTranslation":"Họ tùy chỉnh từng chiếc túi để phù hợp với người mua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"custom","spellingNote":"Alternate spelling: customize."},"customization":{"definition":"Sự tùy biến, sự tùy chỉnh, sự điều chỉnh.","example":"You can add customization to the phone case.","exampleTranslation":"Bạn có thể thêm phần tùy chỉnh cho chiếc ốp lưng điện thoại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"custom","spellingNote":"British spelling: customisation."},"customize":{"definition":"Điều chỉnh, tùy chỉnh, tùy biến; đặc chế.","example":"You can customize the screen to fit your needs.","exampleTranslation":"Bạn có thể tùy chỉnh màn hình để phù hợp với nhu cầu của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"custom","spellingNote":"British spelling: customise."},"customs":{"definition":"Thuế đánh vào hàng nhập từ nước ngoài vào; thuế nhập khẩu.","example":"You must pay customs on all imported goods.","exampleTranslation":"Bạn phải nộp thuế hải quan cho tất cả hàng hóa nhập khẩu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"custom"},"festival":{"definition":"Ngày hội; đại hội liên hoan; hội diễn.","example":"We attended a famous film festival last year.","exampleTranslation":"Chúng tôi đã tham dự một liên hoan phim nổi tiếng vào năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"festival"},"theater":{"definition":"Nơi (xảy ra cái gì), chỗ, trường.","example":"They described it as a theater of war.","exampleTranslation":"Họ mô tả đó như một chiến trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"theater","spellingNote":"British spelling: theatre."},"cinema":{"definition":"Rạp xi nê, rạp chiếu bóng.","example":"We watched a film at the cinema.","exampleTranslation":"Chúng tôi đã xem một bộ phim tại rạp chiếu phim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"cinema"},"film":{"definition":"Màng; mảng thuốc (trên phim ảnh, trên giấy ảnh...).","example":"She saw the film near the door.","exampleTranslation":"Cô ấy đã xem bộ phim đó gần cửa ra vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"film"},"entertain":{"definition":"Tiếp đãi, chiêu đãi.","example":"We entertain guests with tea and fresh fruit.","exampleTranslation":"Chúng tôi tiếp đãi khách bằng trà và trái cây tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"entertain"},"entertained":{"definition":"Quá khứ và phân từ quá khứ của entertain","example":"The host entertained the guests with stories.","exampleTranslation":"Người chủ nhà đã làm các vị khách vui lòng bằng những câu chuyện kể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"entertain"},"entertainer":{"definition":"Người tiếp đãi, người chiêu đãi.","example":"The entertainer made the guests laugh.","exampleTranslation":"Người nghệ sĩ giải trí đã làm cho các vị khách cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"entertain"},"entertaining":{"definition":"Giải trí, vui thú, thú vị.","example":"The movie was entertaining from start to finish.","exampleTranslation":"Bộ phim rất thú vị từ đầu đến cuối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"entertain"},"entertainment":{"definition":"Sự tiếp đãi; sự chiêu đãi; buổi chiêu đãi.","example":"The hotel offered warm entertainment for all visitors.","exampleTranslation":"Khách sạn cung cấp dịch vụ giải trí nồng nhiệt cho tất cả du khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"entertain"},"creative":{"definition":"Sáng tạo.","example":"We need more creative ideas for this project.","exampleTranslation":"Chúng ta cần nhiều ý tưởng sáng tạo hơn cho dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"creative"},"creatively":{"definition":"Sáng tạo.","example":"She spoke creatively during the meeting.","exampleTranslation":"Cô ấy đã phát biểu một cách đầy sáng tạo trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"creative"},"creativeness":{"definition":"Óc sáng tạo, tính sáng tạo.","example":"Her creativeness helped the project stand out.","exampleTranslation":"Sự sáng tạo của cô ấy đã giúp dự án trở nên nổi bật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"creative"},"creativity":{"definition":"sự sáng tạo; tính sáng tạo","example":"The movie was filled with creativity and imagination.","exampleTranslation":"Bộ phim tràn đầy tính sáng tạo và trí tưởng tượng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"creativity"},"perform":{"definition":"Biểu diễn, trình bày (kịch, điệu nhảy... ); đóng.","example":"She will perform a beautiful dance on stage.","exampleTranslation":"Cô ấy sẽ biểu diễn một điệu múa đẹp mắt trên sân khấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"perform"},"performance":{"definition":"Việc diễn, việc đóng (phim, kịch... ); cuộc biểu diễn.","example":"We enjoyed the evening performance at the theater.","exampleTranslation":"Chúng tôi đã tận hưởng buổi biểu diễn buổi tối tại nhà hát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"perform"},"performative":{"definition":"Biểu hiện.","example":"The speech felt performative and fake.","exampleTranslation":"Bài phát biểu mang tính trình diễn và giả tạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"perform"},"performer":{"definition":"Người biểu diễn.","example":"The performer smiled after the song ended.","exampleTranslation":"Người biểu diễn đã mỉm cười sau khi bài hát kết thúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"perform"},"performing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của perform","example":"They are performing on a small stage.","exampleTranslation":"Họ đang biểu diễn trên một sân khấu nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"perform"},"dance":{"definition":"Nhảy lên, rộn lên; nhún nhảy, rung rinh, bập bềnh, rập rình.","example":"The children dance for joy at the party.","exampleTranslation":"Những đứa trẻ nhảy múa vì vui sướng tại bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"dance"},"paint":{"definition":"Sơn, quét sơn.","example":"They will paint the front door bright red.","exampleTranslation":"Họ sẽ sơn cửa trước thành màu đỏ tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"paint"},"painter":{"definition":"Thợ sơn, hoạ sĩ.","example":"The painter fixed the wall before lunch.","exampleTranslation":"Người thợ sơn đã sửa lại bức tường trước giờ ăn trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"paint"},"painting":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của paint.","example":"He was painting the door a bright blue.","exampleTranslation":"Anh ấy đang sơn cánh cửa thành màu xanh dương tươi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"paint"},"painty":{"definition":"Sơn, (thuộc) màu, (thuộc) thuốc vẽ.","example":"The room had a very distinct and painty smell.","exampleTranslation":"Căn phòng có mùi sơn rất nồng và đặc trưng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"paint"},"sculpt":{"definition":"Tạc hoặc tạo hình một vật thể bằng cách đục, nặn hay gọt vật liệu.","example":"Local artists sculpt figures from clay for the annual festival.","exampleTranslation":"Các nghệ sĩ địa phương tạc tượng đất sét cho lễ hội hằng năm.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"sculpt"},"sculpted":{"definition":"Quá khứ và phân từ quá khứ của sculpt","example":"He sculpted the stone into a smooth shape.","exampleTranslation":"Anh ấy đã đục đẽo hòn đá thành một hình thù nhẵn nhụi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sculpt"},"sculptor":{"definition":"Nhà điêu khắc; thợ chạm.","example":"The sculptor made a face from stone.","exampleTranslation":"Nhà điêu khắc đã tạo hình khuôn mặt từ đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sculpt"},"craft":{"definition":"Nghề, nghề thủ công.","example":"Her craft is making wooden toys.","exampleTranslation":"Nghề thủ công của cô ấy là làm đồ chơi bằng gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"craft"},"religion":{"definition":"Tôn giáo, đạo; sự tín ngưỡng, sự tu hành.","example":"What religion do you practice in your country?","exampleTranslation":"Bạn theo tôn giáo nào ở đất nước của mình?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"religion"},"belief":{"definition":"lòng tin, đức tin; sự tin tưởng.","example":"Do you have belief in your own abilities?","exampleTranslation":"Bạn có niềm tin vào khả năng của chính mình không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"belief"},"religious":{"definition":"Thuộc về tôn giáo hoặc niềm tin tôn giáo.","example":"Religious traditions can shape how communities celebrate important events.","exampleTranslation":"Truyền thống tôn giáo có thể định hình cách cộng đồng kỷ niệm những sự kiện quan trọng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"acoustic":{"definition":"Thính giác.","example":"The acoustic nerves help us hear different sounds.","exampleTranslation":"Các dây thính giác giúp chúng ta nghe những âm thanh khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"acoustical":{"definition":"Âm thanh.","example":"The room had strong acoustical design.","exampleTranslation":"Căn phòng có thiết kế âm thanh mạnh mẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"acted":{"definition":"Quá khứ và phân từ quá khứ của act","example":"She acted quickly in the emergency.","exampleTranslation":"Cô ấy đã hành động nhanh chóng trong tình huống khẩn cấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"acting":{"definition":"Nghệ thuật đóng kịch (kịch, phim, chèo, tuồng); sự thủ vai, sự đóng kịch.","example":"Her acting in the play was very natural.","exampleTranslation":"Sự thủ vai của cô ấy trong vở kịch rất tự nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"actor":{"definition":"Diễn viên (kịch, tuồng, chèo, điện ảnh...); kép, kép hát.","example":"The famous actor played a very difficult role.","exampleTranslation":"Nam diễn viên nổi tiếng đã đóng một vai rất khó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"actress":{"definition":"Nữ diễn viên, đào hát.","example":"The actress smiled at the audience.","exampleTranslation":"Nữ diễn viên đã mỉm cười với khán giả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"acts":{"definition":"Động từ chia ở ngôi thứ ba số ít của act","example":"He acts with kindness every day.","exampleTranslation":"Anh ấy hành động với sự tử tế mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"adorn":{"definition":"Tô điểm, trang điểm; trang trí, trang hoàng.","example":"She chose to adorn her dress with beautiful pearls.","exampleTranslation":"Cô ấy đã chọn tô điểm chiếc váy của mình bằng những viên ngọc trai xinh đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"album":{"definition":"Tập ảnh, quyển album.","example":"She kept old photos in a family album.","exampleTranslation":"Cô ấy giữ những bức ảnh cũ trong một tập ảnh gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"animation":{"definition":"Lòng hăng hái, nhiệt tình; sự cao hứng, sự hào hứng.","example":"Her voice had animation during the happy news.","exampleTranslation":"Giọng nói của cô ấy có sự hào hứng trong tin vui.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"anniversary":{"definition":"Ngày kỷ niệm; lễ kỷ niệm.","example":"Today is our wedding anniversary celebration.","exampleTranslation":"Hôm nay là lễ kỷ niệm ngày cưới của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"anoint":{"definition":"Xức dầu, thoa dầu, bôi dầu.","example":"The nurse will anoint the sore skin.","exampleTranslation":"Y tá sẽ xức dầu lên vùng da đau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"aroma":{"definition":"Mùi thơm, hương vị.","example":"The aroma of bread drifted from the oven.","exampleTranslation":"Mùi thơm của bánh mì bay ra từ lò nướng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"aromatic":{"definition":"Thơm.","example":"This aromatic oil smells like fresh lavender flowers.","exampleTranslation":"Loại dầu thơm này có mùi như hoa oải hương tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"artfully":{"definition":"Khéo léo, sắc sảo.","example":"The team finished artfully and left.","exampleTranslation":"Đội đã hoàn thành một cách khéo léo rồi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"culture"},"author":{"definition":"Tác giả.","example":"Ho Ngoc Duc is the author of the FVDP software.","exampleTranslation":"Ho Ngoc Duc là tác giả của phần mềm FVDP.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"autobiographical":{"definition":"Tự truyện, có tính chất tự truyện.","example":"Her autobiographical account was honest and clear.","exampleTranslation":"Bản tường thuật tự truyện của cô ấy rất trung thực và rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"autobiography":{"definition":"Sự viết tự truyện.","example":"She saw the autobiography yesterday.","exampleTranslation":"Cô ấy đã xem cuốn tự truyện vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"ballad":{"definition":"Khúc balat, bài ca balat.","example":"She sang a sad ballad at the show.","exampleTranslation":"Cô ấy đã hát một khúc balat buồn tại buổi diễn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"banquet":{"definition":"Tiệc lớn.","example":"They held a banquet after the ceremony.","exampleTranslation":"Họ đã tổ chức một tiệc lớn sau buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"beautiful":{"definition":"Đẹp; hay.","example":"That is a beautiful sunset over the lake.","exampleTranslation":"Đó là một buổi hoàng hôn đẹp trên hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"beauty":{"definition":"Cái đẹp, cái hay.","example":"We were amazed by the beauty of the sunset.","exampleTranslation":"Chúng tôi đã ngạc nhiên bởi cái đẹp của buổi hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"bell":{"definition":"Cái chuông; nhạc (ở cổ ngựa... ).","example":"A bell hung over the door.","exampleTranslation":"Một cái chuông treo trên cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"bewitch":{"definition":"Bỏ bùa mê.","example":"The old tale says the forest witch can bewitch travelers.","exampleTranslation":"Câu chuyện cũ kể rằng phù thủy rừng có thể bỏ bùa mê những người lữ hành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"biography":{"definition":"Tiểu sử; lý lịch.","example":"The biography appeared in the report.","exampleTranslation":"Tiểu sử đã xuất hiện trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"braid":{"definition":"Dải viền (trang sức quần áo).","example":"The dress had gold braid on the sleeves.","exampleTranslation":"Chiếc váy có dải viền vàng trên tay áo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"capuchin":{"definition":"Thầy tu dòng Fran-xít.","example":"A capuchin walked into the garden.","exampleTranslation":"Một thầy tu dòng Fran-xít đã đi vào khu vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"carnival":{"definition":"Sự quá xá, sự lạm dụng, sự bừa bãi.","example":"The parade was a carnival of bright colors.","exampleTranslation":"Cuộc diễu hành là một sự bừa bãi của những màu sắc rực rỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"carve":{"definition":"Khắc, tạc, chạm, đục.","example":"They want to carve a statue out of wood.","exampleTranslation":"Họ muốn chạm một bức tượng từ gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"celebrate":{"definition":"Tán dương, ca tụng.","example":"The teacher celebrate his hard work in class.","exampleTranslation":"Giáo viên tán dương sự chăm chỉ của cậu ấy trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"celebration":{"definition":"Sự kỷ niệm; lễ kỷ niệm.","example":"We held a small celebration after the exam.","exampleTranslation":"Chúng tôi đã tổ chức một lễ kỷ niệm nhỏ sau kỳ thi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"ceremonious":{"definition":"Chuộng nghi thức.","example":"The host gave a ceremonious greeting.","exampleTranslation":"Người chủ nhà đã gửi một lời chào đầy nghi thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"ceremony":{"definition":"Nghi thức, nghi lễ.","example":"They held a simple ceremony after the ceremony began.","exampleTranslation":"Họ đã tổ chức một buổi lễ đơn giản sau khi nghi thức bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"champagne":{"definition":"Rượu sâm banh.","example":"They opened a bottle of champagne.","exampleTranslation":"Họ đã khui một chai rượu sâm banh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"chant":{"definition":"Thánh ca.","example":"The chant rose softly through the hall.","exampleTranslation":"Tiếng thánh ca vang lên khẽ khàng khắp hội trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"chord":{"definition":"Dây (đàn hạc).","example":"She plucked a soft chord on the harp.","exampleTranslation":"Cô ấy đã gảy một dây đàn hạc thật êm ái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"chorus":{"definition":"Hợp xướng, đồng ca.","example":"The choir can chorus beautifully.","exampleTranslation":"Dàn hợp xướng có thể đồng ca thật tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"church":{"definition":"Nhà thờ.","example":"The old church stands on the street corner.","exampleTranslation":"Nhà thờ cổ đứng trên góc phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"classic":{"definition":"Kinh điển.","example":"This movie is considered a classic of modern cinema.","exampleTranslation":"Bộ phim này được coi là một tác phẩm kinh điển của điện ảnh hiện đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"classical":{"definition":"Kinh điển.","example":"She enjoys listening to classical music every evening.","exampleTranslation":"Cô ấy thích nghe nhạc kinh điển mỗi tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"compose":{"definition":"Soạn, sáng tác, làm.","example":"The artist will compose a beautiful piece of music.","exampleTranslation":"Người nghệ sĩ sẽ sáng tác một bản nhạc đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"composition":{"definition":"Sự hợp thành, sự cấu thành.","example":"The room's composition changed after the move.","exampleTranslation":"Sự hợp thành của căn phòng đã thay đổi sau khi di chuyển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"concert":{"definition":"Sự phối hợp, sự hoà hợp.","example":"They decided to act in concert with our team.","exampleTranslation":"Họ đã quyết định hành động theo sự phối hợp với đội của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"conjure":{"definition":"Làm trò ảo thuật.","example":"He can conjure a rabbit out of a hat.","exampleTranslation":"Anh ấy có thể làm trò ảo thuật con thỏ ra khỏi chiếc mũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"convent":{"definition":"Nữ tu viện, nhà tu kín.","example":"The convent stood on a quiet hill.","exampleTranslation":"Tu viện đứng trên một ngọn đồi yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"conventional":{"definition":"Theo tập quán, theo tục lệ.","example":"It is a conventional way to greet guests.","exampleTranslation":"Đó là một cách thông thường để chào đón khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"convert":{"definition":"Người cải đạo, người thay đổi tín ngưỡng; người theo đạo (nguyện không theo đạo nào).","example":"A convert may need time to learn new customs.","exampleTranslation":"Một người mới cải đạo có thể cần thời gian để tìm hiểu các phong tục mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"cope":{"definition":"Áo lễ.","example":"The bishop wore a cope for the service.","exampleTranslation":"Vị giám mục mặc áo lễ cho buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"craftsman":{"definition":"Thợ thủ công.","example":"The craftsman made the chair in a day.","exampleTranslation":"Người thợ thủ công đã làm xong chiếc ghế trong một ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"critic":{"definition":"Nhà phê bình (văn nghệ).","example":"The literary critic wrote a very harsh review.","exampleTranslation":"Nhà phê bình văn học đã viết một bài đánh giá rất gay gắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"cuisine":{"definition":"Ẩm thực, cách nấu nướng.","example":"Her cuisine is simple but very tasty.","exampleTranslation":"Ẩm thực của cô ấy đơn giản nhưng rất ngon.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"dancing":{"definition":"Sự nhảy múa, sự khiêu vũ.","example":"The dancing went on until midnight.","exampleTranslation":"Sự khiêu vũ tiếp tục cho đến nửa đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"decorate":{"definition":"Trang hoàng, trang trí.","example":"We decorate the room with lights and flowers.","exampleTranslation":"Chúng tôi trang hoàng căn phòng bằng đèn và hoa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"decoration":{"definition":"Trang sức.","example":"She wore a small decoration on her coat.","exampleTranslation":"Cô ấy đeo một món trang sức nhỏ trên áo khoác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"decorative":{"definition":"Để trang hoàng.","example":"The room needs a decorative lamp.","exampleTranslation":"Căn phòng cần một chiếc đèn để trang hoàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"delicacy":{"definition":"Sự duyên dáng, sự thanh nhã, sự thanh tao; vẻ thanh tú.","example":"She admired the delicacy of his artistic style.","exampleTranslation":"Cô ấy ngưỡng mộ sự duyên dáng trong phong cách nghệ thuật của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"depicted":{"definition":"Quá khứ và phân từ quá khứ của depict","example":"The poster depicted a calm beach.","exampleTranslation":"Tấm áp phích đã mô tả một bãi biển yên bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"depiction":{"definition":"Thuật vẽ, hoạ.","example":"The painting gave a clear depiction of winter.","exampleTranslation":"Bức tranh đưa ra một sự diễn tả rõ ràng về mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"derivative":{"definition":", Phái sinh.","example":"This movie is just a derivative work of others.","exampleTranslation":"Bộ phim này chỉ là một tác phẩm phái sinh của những bộ phim khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"divine":{"definition":"Thần thánh, thiêng liêng.","example":"They offered a divine prayer to the ancient gods.","exampleTranslation":"Họ đã dâng một lời cầu nguyện thiêng liêng tới các vị thần cổ xưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"dominican":{"definition":"(thuộc) thánh Đô-mi-ních; (thuộc) dòng Đô-mi-ních.","example":"She wore a Dominican habit in the story.","exampleTranslation":"Cô ấy mặc tu phục dòng Đô-mi-ních trong câu chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"dragon":{"definition":"Con rồng.","example":"A dragon guarded the treasure in the story.","exampleTranslation":"Một con rồng canh giữ kho báu trong câu chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"drama":{"definition":"Kịch; tuồng (cổ).","example":"The courtroom drama stars Melissa Gilbert as a young lawyer.","exampleTranslation":"Vở kịch pháp đình có sự tham gia của Melissa Gilbert trong vai luật sư trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"dramatic":{"definition":"Kịch, như kịch, như đóng kịch, thích hợp với sân khấu.","example":"Her dramatic pause kept the audience waiting.","exampleTranslation":"Sự dừng lại như kịch của cô ấy khiến khán giả chờ đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"dress":{"definition":"Quần áo.","example":"She bought a beautiful blue dress for the party.","exampleTranslation":"Cô ấy mua một chiếc quần áo màu xanh đẹp cho bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"elegant":{"definition":"Cùi lách hạng nhất, chiến, cừ.","example":"She made an elegant move and won easily.","exampleTranslation":"Cô ấy thực hiện một nước cờ cừ và thắng dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"enchant":{"definition":"Bỏ bùa mê ((nghĩa đen) & (nghĩa bóng)).","example":"The music seemed to enchant the whole room.","exampleTranslation":"Âm nhạc dường như bỏ bùa mê cả căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"evocative":{"definition":"Để gọi lên, để gợi lên.","example":"Her voice was evocative of summer evenings.","exampleTranslation":"Giọng nói của cô ấy gợi lên những buổi tối mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"exhibit":{"definition":"Sự phô bày, sự trưng bày.","example":"The exhibit drew many visitors to the hall.","exampleTranslation":"Sự trưng bày đã thu hút nhiều khách tham quan đến hội trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"exhibition":{"definition":"Sự bày tỏ, sự biểu lộ.","example":"He showed great joy in an exhibition of relief.","exampleTranslation":"Anh ấy đã biểu lộ niềm vui lớn trong một sự bày tỏ nhẹ nhõm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"exponent":{"definition":"Người biểu diễn (nhạc... ).","example":"The pianist was a brilliant exponent of jazz.","exampleTranslation":"Nghệ sĩ dương cầm là người biểu diễn xuất sắc của nhạc jazz.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fable":{"definition":"Truyền thuyết.","example":"The village told a fable about the lake.","exampleTranslation":"Ngôi làng đã kể một truyền thuyết về cái hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fairy":{"definition":"Tiên nữ, (thuộc) cánh tiên.","example":"The fairy tale had a fairy in the forest.","exampleTranslation":"Câu chuyện tiên nữ có một nàng tiên trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"fame":{"definition":"Tiếng tăm, danh tiếng, danh thơm, tên tuổi.","example":"The young singer began to win fame quickly.","exampleTranslation":"Ca sĩ trẻ bắt đầu nhanh chóng giành được tiếng tăm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"famous":{"definition":"Nổi tiếng, nổi danh, trứ danh.","example":"That famous actor smiled at the crowd.","exampleTranslation":"Diễn viên nổi tiếng đó mỉm cười với đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"fanciful":{"definition":"Thích kỳ lạ.","example":"He had a fanciful idea about flying cars.","exampleTranslation":"Ông ấy có một ý tưởng thích kỳ lạ về ô tô bay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"fashion":{"definition":"Kiểu cách; hình dáng.","example":"She has a very unique fashion of dress.","exampleTranslation":"Cô ấy có một kiểu cách ăn mặc rất độc đáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fashionable":{"definition":"Đúng mốt, hợp thời trang; lịch sự, sang trọng.","example":"That jacket looks fashionable and neat.","exampleTranslation":"Chiếc áo khoác đó trông đúng mốt và gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"feast":{"definition":"Sự hứng thú.","example":"The party was a feast for the senses.","exampleTranslation":"Bữa tiệc là một sự hứng thú cho các giác quan.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fiction":{"definition":"Tiểu thuyết.","example":"She enjoys reading a work of fiction before bed.","exampleTranslation":"Cô ấy thích đọc một tác phẩm tiểu thuyết trước khi ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fiend":{"definition":"Ma quỷ, quỷ sứ.","example":"The fiend in the story terrified the village.","exampleTranslation":"Ma quỷ trong câu chuyện đã làm cho ngôi làng kinh hãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fireworks":{"definition":"Pháo hoa, pháo bông; cuộc đốt pháo hoa.","example":"We watched fireworks above the river at night.","exampleTranslation":"Chúng tôi đã xem pháo hoa trên sông vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"folk":{"definition":"Người.","example":"Old folk often tell stories by the fire.","exampleTranslation":"Người già thường kể những câu chuyện bên đống lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"folklore":{"definition":"Văn học dân gian; truyền thống dân gian.","example":"Folklore tells stories from many villages.","exampleTranslation":"Văn học dân gian kể những câu chuyện từ nhiều ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"frankincense":{"definition":"Hương trầm (của Châu phi, chế bằng nhựa một cây họ trám).","example":"The room smelled of frankincense and wood.","exampleTranslation":"Căn phòng có mùi hương trầm và gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"fret":{"definition":"Phím đàn.","example":"The fret sounded clear as he played guitar.","exampleTranslation":"Phím đàn phát ra âm thanh trong trẻo khi anh ấy chơi guitar.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"frilled":{"definition":"Có diềm bằng vải xếp nếp.","example":"She wore a frilled shirt to school.","exampleTranslation":"Cô ấy mặc một chiếc áo sơ mi xếp nếp tới trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"frippery":{"definition":"Đồ trang trí loè loẹt rẻ tiền (ở quần áo).","example":"The shirt looked cheap because of its frippery.","exampleTranslation":"Chiếc áo trông rẻ tiền vì những đồ trang trí loè loẹt của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"gala":{"definition":"Hội, hội hè.","example":"They attended a beautiful gala at the palace.","exampleTranslation":"Họ đã tham dự một buổi hội hè tuyệt đẹp tại cung điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"gallery":{"definition":"Phòng trưng bày tranh tượng.","example":"We spent an hour in the art gallery.","exampleTranslation":"Chúng tôi dành một giờ trong phòng trưng bày nghệ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"garment":{"definition":"Vỏ ngoài, cái bọc ngoài.","example":"Clouds made a white garment over the hills.","exampleTranslation":"Những đám mây tạo thành một vỏ ngoài màu trắng bao phủ các ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"glee":{"definition":"Bài hát ba bè; bái hát bốn bè.","example":"The glee sounded clear during the morning rehearsal.","exampleTranslation":"Bài hát ba bè nghe thật trong trẻo trong buổi tổng duyệt sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"glory":{"definition":"Danh tiếng, thanh danh; sự vinh quang, vẻ vang, vinh dự, vinh hiển, vinh thăng.","example":"He won glory for his hard work.","exampleTranslation":"Anh ấy đã giành được vinh quang nhờ sự chăm chỉ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"gourmet":{"definition":"Người sành ăn, người sành rượu.","example":"The gourmet chose the best wine.","exampleTranslation":"Người sành ăn đã chọn loại rượu vang ngon nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"graffiti":{"definition":"Grafitô (hình vẽ, chữ viết trên tường cổ... ).","example":"The graffiti covered the old bridge.","exampleTranslation":"Grafitô phủ kín cây cầu cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"grave":{"definition":"Nơi chôn vùi.","example":"They visited the old grave in the forest.","exampleTranslation":"Họ đã thăm nơi chôn vùi cũ trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"harem":{"definition":"Hậu cung.","example":"The palace had a large harem.","exampleTranslation":"Cung điện có một hậu cung lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"harmonic":{"definition":"Điều hoà.","example":"The singer performed a beautiful harmonic function today.","exampleTranslation":"Ca sĩ đã thể hiện một điều hoà chức năng tuyệt đẹp hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"harmonious":{"definition":"Hài hoà, cân đối.","example":"They live in a harmonious group of buildings.","exampleTranslation":"Họ sống trong một nhóm các tòa nhà hài hoà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"harmonization":{"definition":"Sự làm hài hoà, sự làm cân đối, sự làm hoà hợp.","example":"The color harmonization made the room feel calm.","exampleTranslation":"Sự làm hài hoà màu sắc khiến căn phòng có cảm giác yên bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"harmony":{"definition":"Sự hoà thuận, sự hoà hợp.","example":"We must work in harmony with our neighbors.","exampleTranslation":"Chúng ta phải làm việc trong sự hoà thuận với hàng xóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"heaven":{"definition":"Thiên đường, thiên đàng, thiên đình (nghĩa đen & nghĩa bóng).","example":"She felt like she was in heaven during vacation.","exampleTranslation":"Cô ấy cảm thấy như mình đang ở thiên đường trong kỳ nghỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"heavenly":{"definition":"Trời; ở trên trời, ở thiên đường.","example":"The stars are beautiful heavenly bodies in the night sky.","exampleTranslation":"Các vì sao là những cơ thể ở trên trời đẹp đẽ trong bầu trời đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"hero":{"definition":"Người anh hùng.","example":"The firefighter was a true hero.","exampleTranslation":"Người lính cứu hỏa là một người anh hùng thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"heroic":{"definition":"Anh hùng.","example":"The soldier performed a heroic act to save his friends.","exampleTranslation":"Người lính đã thực hiện một hành động anh hùng để cứu bạn bè của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"honor":{"definition":"Danh dự, danh giá, thanh danh.","example":"You must keep your word of honor at all times.","exampleTranslation":"Bạn phải giữ lời danh dự của mình mọi lúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"iconic":{"definition":"Mang tính biểu trưng.","example":"That old song is still iconic today.","exampleTranslation":"Bài hát cũ đó vẫn mang tính biểu trưng cho đến tận ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"iconographic":{"definition":"Sự mô tả bằng tranh, (thuộc) sự mô tả bằng hình tượng.","example":"The book includes an iconographic study of symbols.","exampleTranslation":"Cuốn sách bao gồm một nghiên cứu mô tả bằng hình tượng về các biểu tượng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"idealism":{"definition":"Chủ nghĩa duy tâm.","example":"Idealism inspired her to help others.","exampleTranslation":"Chủ nghĩa duy tâm đã truyền cảm hứng để cô ấy giúp đỡ người khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"imagery":{"definition":"Hình ảnh (nói chung).","example":"The poem uses vivid imagery of rain and wind.","exampleTranslation":"Bài thơ sử dụng hình ảnh sống động về mưa và gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"imitate":{"definition":"Làm giả.","example":"They tried to imitate diamonds using clear glass.","exampleTranslation":"Họ cố gắng làm giả kim cương bằng cách sử dụng thủy tinh trong suốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"imitation":{"definition":"Sự noi gương.","example":"Her success came from years of imitation and practice.","exampleTranslation":"Sự thành công của cô ấy đến từ nhiều năm noi gương và luyện tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"imitative":{"definition":"Bắt chước, mô phỏng, phỏng mẫu; hay bắt chước.","example":"The young boy was as imitative as a monkey.","exampleTranslation":"Cậu bé đó hay bắt chước như một chú khỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"improvise":{"definition":"Ứng khẩu, cương (trên sân khấu... ).","example":"He had to improvise a song at school.","exampleTranslation":"Anh ấy đã phải ứng khẩu một bài hát ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"incarnate":{"definition":"Cụ thể bằng xương, bằng thịt.","example":"Her joy was incarnate in a bright smile.","exampleTranslation":"Niềm vui của cô ấy cụ thể bằng xương, bằng thịt trong một nụ cười rạng rỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"incense":{"definition":"Nhang, hương, trầm.","example":"She lit some incense in the small temple.","exampleTranslation":"Cô ấy đã thắp vài nén hương trong ngôi đền nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"inscribe":{"definition":"Viết, khắc (chữ), ghi (chữ, tên).","example":"They inscribe his name on the stone.","exampleTranslation":"Họ viết tên anh ấy lên hòn đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"inspiration":{"definition":"Sự truyền cảm.","example":"Her music gave me inspiration for the song.","exampleTranslation":"Âm nhạc của cô ấy mang lại sự truyền cảm cho bài hát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"inspire":{"definition":"truyền (cảm hứng, ý nghĩ... ); truyền cảm hứng cho (ai), gây cảm hứng cho (ai).","example":"Teachers inspire students to ask better questions.","exampleTranslation":"Giáo viên truyền cảm hứng cho học sinh để đặt những câu hỏi hay hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"intrigue":{"definition":"Mưu đồ; sự vận động ngầm; thói hay vận động ngầm.","example":"The old house hid a quiet intrigue among the neighbors.","exampleTranslation":"Ngôi nhà cũ giấu một mưu đồ yên lặng giữa những người hàng xóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"intriguing":{"definition":"Làm say đắm.","example":"His gaze was intriguing and hard to ignore.","exampleTranslation":"Ánh nhìn của anh ấy làm say đắm và khó phớt lờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"ironic":{"definition":"Trớ trêu.","example":"Her reply was short and ironic.","exampleTranslation":"Câu trả lời của cô ấy ngắn gọn và trớ trêu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"ironically":{"definition":"Mỉa mai, trớ trêu.","example":"She answered ironically and smiled.","exampleTranslation":"Cô ấy đã trả lời một cách mỉa mai và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"culture"},"irony":{"definition":"Sự trớ trêu.","example":"It was irony that she missed the bus.","exampleTranslation":"Thật là sự trớ trêu khi cô ấy lỡ chuyến xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"joke":{"definition":"Lời nói đùa, câu nói đùa.","example":"He decided to crack a joke during dinner.","exampleTranslation":"Anh ấy quyết định kể một câu nói đùa trong bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"laud":{"definition":"lời tán dương, lời ca ngợi, lời khen ngợi.","example":"He gave her a warm laud after the song.","exampleTranslation":"Anh ấy dành cho cô ấy một lời tán dương nồng nhiệt sau bài hát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"laugh":{"definition":"Tiếng cười.","example":"He burst into a laugh at the joke.","exampleTranslation":"Anh ấy bật tiếng cười trước câu chuyện đùa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"lullaby":{"definition":"Bài hát ru con.","example":"She sang a lullaby before bedtime.","exampleTranslation":"Cô ấy hát một bài hát ru con trước giờ đi ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"madeleine":{"definition":"Bánh mađơlen.","example":"She ate a soft madeleine with tea.","exampleTranslation":"Cô ấy ăn một chiếc bánh mađơlen mềm với trà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"magical":{"definition":"Ma thuật, yêu thuật.","example":"The magician used magical tricks to amaze the crowd.","exampleTranslation":"Nhà ảo thuật đã sử dụng những thủ thuật ma thuật để làm đám đông ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"magnificent":{"definition":"Rất đẹp, cừ, chiến.","example":"You did a magnificent job on the project.","exampleTranslation":"Bạn đã làm một công việc rất đẹp cho dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"mass":{"definition":"Lễ mét.","example":"The mass began at sunrise.","exampleTranslation":"Lễ mét bắt đầu vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"masterpiece":{"definition":"Kiệt tác, tác phẩm lớn.","example":"The painting is a true masterpiece.","exampleTranslation":"Bức tranh là một kiệt tác thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"melodic":{"definition":"Giai điệu.","example":"His voice stayed melodic all night.","exampleTranslation":"Giọng nói của anh ấy vẫn giai điệu cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"melodramatic":{"definition":"Kịch mêlô; như kịch mêlô; thích hợp với kịch mêlô.","example":"Her melodramatic speech made everyone smile.","exampleTranslation":"Bài phát biểu như kịch mêlô của cô ấy làm mọi người mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"melody":{"definition":"Âm điệu, du dương.","example":"The melody gave the song a warm feeling.","exampleTranslation":"Âm điệu đã tạo cho bài hát một cảm giác ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"miniature":{"definition":"Bức tiểu hoạ.","example":"She drew a miniature of the old house.","exampleTranslation":"Cô ấy đã vẽ một bức tiểu hoạ của ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"musicologist":{"definition":"Nhà âm nhạc học.","example":"The musicologist compared old songs and styles.","exampleTranslation":"Nhà âm nhạc học đã so sánh các bài hát và phong cách cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"myth":{"definition":"Thần thoại.","example":"The myth explained the mountain's name.","exampleTranslation":"Thần thoại đã giải thích tên của ngọn núi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"mythological":{"definition":"Thần thoại học; (thuộc) thần thoại.","example":"The book described mythological creatures.","exampleTranslation":"Cuốn sách mô tả các sinh vật trong thần thoại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"neoclassical":{"definition":"Tân cổ điển.","example":"The room had a neoclassical look and feel.","exampleTranslation":"Căn phòng có vẻ ngoài và cảm giác tân cổ điển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"novel":{"definition":"Mới, mới lạ, lạ thường.","example":"That is a novel way to solve this problem.","exampleTranslation":"Đó là một cách mới lạ để giải quyết vấn đề này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"novelist":{"definition":"Người viết tiểu thuyết.","example":"The novelist wrote a book about family life.","exampleTranslation":"Người viết tiểu thuyết đã viết một cuốn sách về cuộc sống gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"octave":{"definition":"Ngày thứ tám (kể từ ngày hội).","example":"We met again in the octave after the festival.","exampleTranslation":"Chúng tôi đã gặp lại vào ngày thứ tám sau lễ hội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"orchestral":{"definition":"Dàn nhạc; dành cho dàn nhạc.","example":"The orchestral music filled the hall.","exampleTranslation":"Âm nhạc dàn nhạc đã lấp đầy khán phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"ornament":{"definition":"Đồ trang hoàng, đồ trang trí, đồ trang sức; sự trang hoàng.","example":"Gold jewelry serves as an ornament for her dress.","exampleTranslation":"Đồ trang hoàng bằng vàng phục vụ như một món đồ trang trí cho chiếc váy của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"orthodox":{"definition":"Chính thống","example":"Her orthodox view followed the old rules.","exampleTranslation":"Quan điểm chính thống của cô ấy tuân theo các quy tắc cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"overtone":{"definition":"Âm bội.","example":"The singer added a soft overtone to the note.","exampleTranslation":"Người ca sĩ đã thêm một âm bội nhẹ vào nốt nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"palette":{"definition":"Bảng màu ((cũng) pallet).","example":"The artist mixed colors on a small palette.","exampleTranslation":"Người nghệ sĩ đã pha màu trên một bảng màu nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"palm":{"definition":"Cành cọ (tượng trưng cho chiến thắng); (nghĩa bóng) chiến thắng; giải.","example":"He carried the palm as a symbol of victory.","exampleTranslation":"Anh ấy cầm cành cọ như một biểu tượng của chiến thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"parable":{"definition":"Truyện ngụ ngôn.","example":"The story is a simple parable about kindness.","exampleTranslation":"Câu chuyện là một bài ngụ ngôn đơn giản về lòng tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"parade":{"definition":"Sự phô trương.","example":"His speech was just a parade of facts.","exampleTranslation":"Bài phát biểu của ông ấy chỉ là một sự phô trương các dữ kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"paradise":{"definition":"Tầng thượng, tầng trêm cùng (nhà hát).","example":"We sat in paradise and watched the show.","exampleTranslation":"Chúng tôi đã ngồi ở tầng thượng và xem buổi biểu diễn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"patron":{"definition":"Khách hàng (của một cửa hàng, thư viện,...).","example":"Every patron found a quiet seat in the library.","exampleTranslation":"Mỗi khách hàng đều tìm thấy một chỗ ngồi yên tĩnh trong thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"phoenix":{"definition":"Chim phượng hoàng lửa.","example":"The phoenix rose from the ashes in the tale.","exampleTranslation":"Chim phượng hoàng lửa trỗi dậy từ đống tro tàn trong câu chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"pianist":{"definition":"Người chơi pianô, người biểu diễn pianô.","example":"The pianist played a soft melody.","exampleTranslation":"Người biểu diễn pianô đã chơi một giai điệu nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"piano":{"definition":"Pianô.","example":"She plays the piano beautifully every evening.","exampleTranslation":"Cô ấy chơi pianô thật đẹp vào mỗi buổi tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"plait":{"definition":"Đường xếp nếp gấp (ở quần áo) ((cũng) pleat).","example":"The dress had a neat plait near the hem.","exampleTranslation":"Chiếc váy có một đường xếp nếp gọn gàng gần gấu áo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"plush":{"definition":"Quần lễ phục của người hầu.","example":"The costume used dark plush for the trousers.","exampleTranslation":"Trang phục đã sử dụng vải nhung sang trọng cho quần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"poem":{"definition":"Vật đẹp như bài thơ, cái nên thơ.","example":"That small cottage is a poem in wood.","exampleTranslation":"Căn nhà nhỏ đó là một vật thơ mộng bằng gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"poet":{"definition":"Nhà thơ, thi sĩ.","example":"The poet wrote a beautiful verse today.","exampleTranslation":"Nhà thơ đã viết một khổ thơ đẹp hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"portrait":{"definition":"Chân dung, ảnh.","example":"He kept the portrait on the desk.","exampleTranslation":"Anh ấy giữ chân dung trên bàn làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"pose":{"definition":"Tư thế (chụp ảnh... ), kiểu.","example":"What kind of pose is best for this photograph?","exampleTranslation":"Kiểu tư thế nào là tốt nhất cho bức ảnh này?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"prose":{"definition":"Bài nói chán ngắt.","example":"The speaker's prose put everyone to sleep.","exampleTranslation":"Bài nói chán ngắt","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"purist":{"definition":"Người theo chủ nghĩa thuần tuý.","example":"The purist refused any modern changes.","exampleTranslation":"Người theo chủ nghĩa thuần túy","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"queen":{"definition":"Con ong chúa; con kiến chúa.","example":"The queen bee lives in the center of the hive.","exampleTranslation":"Ong chúa sống ở giữa tổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"rapping":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của rap.","example":"He was rapping softly on the door.","exampleTranslation":"Anh ấy đang gõ nhẹ vào cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"realism":{"definition":"Chủ nghĩa hiện thực.","example":"The novel shows realism in everyday life.","exampleTranslation":"Chủ nghĩa hiện thực","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"realistic":{"definition":"Hiện thực.","example":"Her story felt realistic and honest.","exampleTranslation":"Câu chuyện của cô ấy nghe rất thực tế và trung thực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"rehearse":{"definition":"Nhắc lại, kể lại.","example":"Please rehearse your speech before class.","exampleTranslation":"Vui lòng tập dượt bài phát biểu của bạn trước khi vào lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"renowned":{"definition":"Có tiếng, nổi tiếng, trứ danh.","example":"The city is renowned for its music.","exampleTranslation":"Thành phố này nổi tiếng về âm nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"repertoire":{"definition":"Vốn tiết mục biểu diễn (của một nghệ sĩ, một đội văn công) ((cũng) repertory).","example":"Her repertoire includes songs and dance.","exampleTranslation":"Vốn tiết mục của cô ấy bao gồm cả ca hát và nhảy múa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"retro":{"definition":"Theo lối cũ, theo phong cách cổ điển, theo phong cách xưa","example":"She loves wearing retro clothes from the sixties.","exampleTranslation":"Cô ấy thích mặc những bộ quần áo theo phong cách xưa từ những năm sáu mươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"revelation":{"definition":"Sự để lộ, sự tiết lộ, sự phát giác, sự khám phá (vật bị giấu, điều bí mật... ).","example":"The letter was a shocking revelation.","exampleTranslation":"Bức thư là một sự tiết lộ gây sốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"rhyme":{"definition":"những câu thơ có vần.","example":"The rhyme made the poem easy to remember.","exampleTranslation":"Những câu thơ có vần khiến bài thơ dễ nhớ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"rhythm":{"definition":"Sự nhịp nhàng (của động tác... ).","example":"Dance helps improve the rhythm of your steps.","exampleTranslation":"Khiêu vũ giúp cải thiện nhịp điệu các bước chân của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"ritually":{"definition":"Lễ nghi; có vẻ lễ nghi; theo lễ nghi.","example":"She answered ritually and smiled.","exampleTranslation":"Cô ấy đã trả lời theo lễ nghi và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"culture"},"romance":{"definition":"Truyện anh hùng hiệp sĩ (thời Trung cổ, thường viết theo thể thơ).","example":"He kept the romance in a drawer.","exampleTranslation":"Anh ấy giữ cuốn tiểu thuyết hiệp sĩ trong ngăn kéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"romantic":{"definition":"Tiểu thuyết, như tiểu thuyết; mơ mộng, xa thực tế, lãng mạng.","example":"She has always been a very romantic girl.","exampleTranslation":"Cô ấy luôn là một cô gái rất lãng mạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"sacred":{"definition":"Thánh; thần thánh, của thần.","example":"The sacred book is kept in a temple.","exampleTranslation":"Cuốn sách thánh được giữ trong đền thờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"sampler":{"definition":"Vải thêu mẫu.","example":"Her sampler showed neat red flowers.","exampleTranslation":"Vải thêu mẫu của cô ấy cho thấy những bông hoa đỏ gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"scene":{"definition":"Nơi xảy ra.","example":"The police arrived at the scene of strife.","exampleTranslation":"Cảnh sát đã đến nơi xảy ra tranh chấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"screenwriter":{"definition":"Người viết kịch bản phim.","example":"The screenwriter changed the ending.","exampleTranslation":"Người viết kịch bản phim đã thay đổi đoạn kết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"sculpture":{"definition":"Thuật điêu khắc, thuật chạm trổ.","example":"She studied sculpture at art school.","exampleTranslation":"Cô ấy đã học điêu khắc tại trường nghệ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"sequel":{"definition":"Sự tiếp tục; đoạn tiếp, cuốn tiếp theo (tiểu thuyết... ).","example":"This movie is the sequel to their last hit.","exampleTranslation":"Bộ phim này là phần tiếp theo của bản hit trước đó của họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"showy":{"definition":"Loè loẹt, phô trương.","example":"The showy scarf was too bright for me.","exampleTranslation":"Chiếc khăn quàng cổ loè loẹt quá sáng so với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"sing":{"definition":"Hát, ca hát.","example":"I love to sing a song in the morning.","exampleTranslation":"Tôi thích hát một bài vào buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"sketch":{"definition":"Bức vẽ phác, bức phác hoạ.","example":"I made a quick sketch of the old house.","exampleTranslation":"Tôi đã thực hiện một bức vẽ phác nhanh ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"song":{"definition":"Tiếng hát; tiếng hót.","example":"She loves to sing a beautiful song.","exampleTranslation":"Cô ấy thích hát một tiếng hát đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"sonnet":{"definition":"Làm xonê; ca ngợi bằng xonê; làm xonê tặng (ai) ((cũng) sonneteer).","example":"He will sonnet his friend on her birthday.","exampleTranslation":"Anh ấy sẽ làm thơ xonê tặng bạn mình vào ngày sinh nhật cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"spectacle":{"definition":"Cảnh tượng, quang cảnh.","example":"The fireworks were a beautiful spectacle at night.","exampleTranslation":"Pháo hoa là một cảnh tượng đẹp vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"spectacular":{"definition":"Đẹp mắt, ngoạn mục.","example":"The sunset was truly spectacular.","exampleTranslation":"Hoàng hôn thực sự đẹp mắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"spectacularly":{"definition":"Đẹp mắt; tráng lệ; ngoạn mục; hùng tráng.","example":"I read the note spectacularly.","exampleTranslation":"Tôi đọc ghi chú đó một cách ngoạn mục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"culture"},"spell":{"definition":"Lời thần chú.","example":"The old spell was meant to bring luck.","exampleTranslation":"Lời thần chú cũ có ý nghĩa mang lại may mắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"spiritual":{"definition":"Có đức tính cao cả, có trí tuệ khác thường (người).","example":"He is a spiritual leader for many people.","exampleTranslation":"Ông ấy là một người có đức tính cao cả đối với nhiều người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"spirituality":{"definition":"Tính chất tinh thần.","example":"The spirituality played a key role.","exampleTranslation":"Tính chất tinh thần đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"splendor":{"definition":"Như splendour","example":"The garden had great splendor in spring.","exampleTranslation":"Khu vườn có sự tráng lệ tuyệt vời vào mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"stage":{"definition":"Giàn (thợ xây tường... ).","example":"The workers used a hanging stage for construction.","exampleTranslation":"Công nhân sử dụng một giàn treo cho việc xây dựng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"statuary":{"definition":"Tượng.","example":"The museum features beautiful statuary from Rome.","exampleTranslation":"Bảo tàng trưng bày tượng đẹp từ La Mã.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"statue":{"definition":"Tượng.","example":"A large statue stands in the city park.","exampleTranslation":"Một bức tượng lớn đứng trong công viên thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"studio":{"definition":"Xưởng vẽ, xưởng điêu khắc...","example":"She paints alone in her studio.","exampleTranslation":"Cô ấy vẽ một mình trong xưởng vẽ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"style":{"definition":"Vòi nhuỵ.","example":"The flower's style was thin and long.","exampleTranslation":"Vòi nhuỵ của hoa mỏng và dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"stylise":{"definition":"Làm đúng kiểu.","example":"She can stylise a simple room with ease.","exampleTranslation":"Cô ấy có thể làm đúng kiểu một căn phòng đơn giản một cách dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"stylistic":{"definition":"Văn phong.","example":"The stylistic choice made the sentence sound modern.","exampleTranslation":"Sự lựa chọn văn phong làm cho câu nói nghe hiện đại hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"suit":{"definition":"Bộ com lê, bộ quần áo (đàn ông).","example":"He wore a very expensive dress suit today.","exampleTranslation":"Hôm nay anh ấy mặc một bộ com lê rất đắt tiền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"symbol":{"definition":"Vật tượng trưng.","example":"The dove is a common symbol of peace.","exampleTranslation":"Chim bồ câu là một vật tượng trưng phổ biến cho hòa bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"symbolic":{"definition":"Tượng trưng.","example":"The flag had a symbolic meaning.","exampleTranslation":"Lá cờ có một ý nghĩa tượng trưng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"symbolism":{"definition":"Chủ nghĩa tượng trưng.","example":"She studied symbolism in modern art.","exampleTranslation":"Cô ấy đã nghiên cứu chủ nghĩa tượng trưng trong nghệ thuật hiện đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"symbolize":{"definition":"Diễn đạt bằng tượng trưng.","example":"He used colors to symbolize hope and change.","exampleTranslation":"Anh ấy đã sử dụng màu sắc để diễn đạt bằng tượng trưng cho hy vọng và thay đổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"tale":{"definition":"Chuyện bịa đặt, chuyện nói xấu.","example":"That tale was made up to hurt her.","exampleTranslation":"Chuyện bịa đặt đó được dựng lên để làm tổn thương cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"tempo":{"definition":"Nhịp, nhịp độ.","example":"The music played at a very quick tempo.","exampleTranslation":"Âm nhạc phát ở một nhịp độ rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"tenor":{"definition":"Ý nghĩa, tinh thần chung, nội dung chính.","example":"What is the tenor of your latest speech?","exampleTranslation":"Ý nghĩa chính của bài phát biểu mới nhất của bạn là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"theatre":{"definition":"Rạp hát, nhà hát.","example":"We decided to go to the theatre tonight.","exampleTranslation":"Chúng tôi quyết định đi đến rạp hát tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"theme":{"definition":"Một chủ đề của buổi nói chuyện hoặc tác phẩm nghệ thuật.","example":"What is the main theme of this book?","exampleTranslation":"Chủ đề chính của cuốn sách này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"title":{"definition":"Tước, tước hiệu, danh hiệu.","example":"He was granted the title of Duke yesterday.","exampleTranslation":"Anh ấy đã được trao danh hiệu Công tước ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"tone":{"definition":"Tiếng; (nhạc) âm.","example":"I love the sweet tone of the violin.","exampleTranslation":"Tôi yêu tiếng ngọt ngào của cây đàn vĩ cầm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"trio":{"definition":"Bộ ba.","example":"The trio sang in perfect harmony.","exampleTranslation":"Bộ ba đã hát với sự hòa âm hoàn hảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"troupe":{"definition":"Đoàn (kịch), gánh (hát).","example":"The troupe performed in the school hall.","exampleTranslation":"Gánh hát đã biểu diễn tại hội trường trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"trumpet":{"definition":"Kèn trompet.","example":"He bought a new trumpet for school band.","exampleTranslation":"Anh ấy đã mua một chiếc kèn trompet mới cho ban nhạc của trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"tune":{"definition":"Sự đúng điệu; sự hoà âm.","example":"She can sing every note in perfect tune.","exampleTranslation":"Cô ấy có thể hát từng nốt nhạc đúng điệu một cách hoàn hảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"tunic":{"definition":"Áo chẽn (của binh sĩ, cảnh sát).","example":"The officer wore a neat tunic at work.","exampleTranslation":"Viên sĩ quan mặc chiếc áo chẽn gọn gàng khi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"underwear":{"definition":"Quần áo trong, quần áo lót.","example":"Pack extra underwear for the long trip.","exampleTranslation":"Hãy đóng gói thêm quần áo lót cho chuyến đi dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"vamp":{"definition":"Miếng vá (để làm cho có vẻ mới).","example":"She added a vamp to the old coat.","exampleTranslation":"Cô ấy đã thêm một miếng vá vào chiếc áo khoác cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"vintage":{"definition":"Miền sản xuất nho; rượu chế ở miền sản xuất nho.","example":"We bought a bottle of vintage champagne for dinner.","exampleTranslation":"Chúng tôi đã mua một chai sâm panh rượu chế ở miền sản xuất nho cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"violet":{"definition":"Màu tím.","example":"The violet shirt looked bright.","exampleTranslation":"Chiếc áo màu tím trông thật sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"virgin":{"definition":"(the Virgin) đức Mẹ","example":"People prayed before the statue of the Virgin.","exampleTranslation":"Mọi người đã cầu nguyện trước bức tượng của đức Mẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"virginity":{"definition":"Sự trong trắng, sự trinh bạch, sự trinh khiết; chữ trinh.","example":"He kept the virginity on the desk.","exampleTranslation":"Anh ta để chữ trinh trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"vivid":{"definition":"Chói lọi, sặc sỡ (màu sắc, ánh sáng).","example":"She wore a dress with vivid colors for the party.","exampleTranslation":"Cô ấy mặc một chiếc váy với màu sắc chói lọi cho bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"culture"},"wardrobe":{"definition":"Quần áo.","example":"She packed a small wardrobe for the trip.","exampleTranslation":"Cô ấy đã đóng gói một tủ quần áo nhỏ cho chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"wear":{"definition":"Quần áo; giầy dép.","example":"Formal evening wear is required for the party.","exampleTranslation":"Quần áo trang trọng vào buổi tối là bắt buộc cho bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"wigs":{"definition":"Động từ chia ở ngôi thứ ba số ít của wig","example":"She wigs her doll for the play.","exampleTranslation":"Cô ấy đội tóc giả cho con búp bê để chuẩn bị cho vở kịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"wine":{"definition":"Rượu vang; rượu.","example":"She poured a glass of red wine for dinner.","exampleTranslation":"Cô ấy rót một ly rượu vang đỏ cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"witchcraft":{"definition":"Ma thuật, phép phù thuỷ.","example":"The old tale blamed witchcraft for the illness.","exampleTranslation":"Câu chuyện cũ đổ lỗi cho ma thuật là nguyên nhân của bệnh tật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"wizardry":{"definition":"Ma thuật, quỷ thật.","example":"The story was full of wizardry and wonder.","exampleTranslation":"Câu chuyện đầy rẫy phép thuật và sự kỳ diệu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"worship":{"definition":"Sự thờ cúng, sự cúng bái.","example":"Freedom of worship is a human right.","exampleTranslation":"Tự do thờ cúng là một quyền con người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"writer":{"definition":"Người viết, người thảo (bức thư, văn kiện, bài thơ, vở kịch).","example":"She is a very talented writer of children's books.","exampleTranslation":"Cô ấy là một người viết sách thiếu nhi rất tài năng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"culture"},"write":{"definition":"Viết thư, giao dịch thư từ.","example":"I need to write a letter to my friend.","exampleTranslation":"Tôi cần viết một lá thư cho bạn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"culture"},"media":{"definition":"Phương tiện truyền thông.","example":"Social media has changed how we communicate today.","exampleTranslation":"Mạng xã hội đã thay đổi cách chúng ta giao tiếp ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"communicating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của communicate.","example":"We are communicating by text today.","exampleTranslation":"Chúng ta đang giao tiếp bằng tin nhắn ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"communicat"},"communication":{"definition":"Sự giao tiếp","example":"Good communication is key for a happy marriage.","exampleTranslation":"Giao tiếp tốt là chìa khóa cho một cuộc hôn nhân hạnh phúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"communicat"},"communicative":{"definition":"Dễ truyền đi; hay lan truyền.","example":"She is communicative and easy to talk to.","exampleTranslation":"Cô ấy là người cởi mở và dễ trò chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"communicat"},"communicator":{"definition":"Người truyền tin, người truyền đạt.","example":"A good communicator listens carefully and speaks clearly.","exampleTranslation":"Một người giao tiếp giỏi sẽ biết lắng nghe cẩn thận và nói năng rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"communicat"},"journal":{"definition":"Báo hằng ngày.","example":"She read the journal before breakfast.","exampleTranslation":"Cô ấy đã đọc tạp chí chuyên ngành trước khi ăn sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"journal"},"journalism":{"definition":"Nghề làm báo, nghề viết báo.","example":"She studied journalism at the local college.","exampleTranslation":"Cô ấy đã theo học ngành báo chí tại trường cao đẳng địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"journal"},"journalist":{"definition":"Nhà báo.","example":"The journalist asked many clear questions.","exampleTranslation":"Nhà báo đó đã đặt ra nhiều câu hỏi rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"journal"},"news":{"definition":"Tin, tin tức.","example":"I heard some good news about your job.","exampleTranslation":"Tôi vừa nghe được vài tin tức tốt lành về công việc của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"news"},"newspaper":{"definition":"Báo, báo chí.","example":"I read the daily newspaper every morning.","exampleTranslation":"Tôi đọc báo hằng ngày vào mỗi buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"newspaper"},"broadcast":{"definition":"Được truyền đi rộng rãi (tin tức...); qua đài phát thanh, được phát thanh.","example":"The news was broadcast on every local channel.","exampleTranslation":"Tin tức đó đã được phát trên mọi kênh địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"broadcast"},"broadcaster":{"definition":"Người nói chuyện trên đài phát thanh, người hát trên đài phát thanh.","example":"The broadcaster spoke clearly on the radio.","exampleTranslation":"Phát thanh viên đã nói rất rõ ràng trên đài phát thanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"broadcast"},"broadcasting":{"definition":"Được tung ra khắp nơi; được gieo rắc (hạt giống... ).","example":"The broadcasting seeds covered the whole field.","exampleTranslation":"Việc gieo hạt theo lối vãi đã bao phủ khắp cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"broadcast"},"television":{"definition":"Sự truyền hình.","example":"I enjoy watching television every evening after work.","exampleTranslation":"Tôi thích xem truyền hình vào mỗi buổi tối sau khi đi làm về.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"television"},"radio":{"definition":"Radio, ra-đi-ô, truyền thanh, truyền thanh vô tuyến.","example":"I used to carry a small radio, but now I have an MP3 player.","exampleTranslation":"Tôi từng mang theo một chiếc radio nhỏ, nhưng bây giờ tôi có một máy nghe nhạc MP3.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"radio"},"adverted":{"definition":"Quá khứ và phân từ quá khứ của advert","example":"She adverted to the problem briefly.","exampleTranslation":"Cô ấy đã đề cập ngắn gọn đến vấn đề đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"advert"},"adverting":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của advert.","example":"He is adverting to the safety issue now.","exampleTranslation":"Anh ấy hiện đang chú ý đến vấn đề an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"advert"},"advertise":{"definition":"Báo cho biết, báo cho ai biết trước.","example":"They will advertise the new job opening online soon.","exampleTranslation":"Họ sẽ sớm quảng cáo vị trí công việc mới trên mạng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"advert","spellingNote":"Alternate spelling: advertize."},"advertize":{"definition":"Báo cho biết, báo cho ai biết trước.","example":"Please advertize me before you change the schedule.","exampleTranslation":"Vui lòng thông báo cho tôi trước khi bạn thay đổi lịch trình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"advert","spellingNote":"British spelling: advertise."},"press":{"definition":"Sự ép, sự nén, sự bóp, sự ấn.","example":"Please press the button to start the machine.","exampleTranslation":"Vui lòng nhấn nút để khởi động máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"press"},"pressed":{"definition":"Quá khứ và phân từ quá khứ của press","example":"She pressed the button twice.","exampleTranslation":"Cô ấy đã nhấn nút hai lần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"press"},"pressing":{"definition":"Thúc bách, cấp bách, cấp thiết gấp.","example":"The family has a pressing need for food.","exampleTranslation":"Gia đình đang có nhu cầu cấp bách về thực phẩm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"press"},"message":{"definition":"tin nhắn, thư tín, điện, thông báo, thông điệp.","example":"I received a wireless message from my friend.","exampleTranslation":"Tôi đã nhận được một thông điệp không dây từ bạn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"message"},"announce":{"definition":"Báo, loan báo, thông tri.","example":"They will announce the new results tomorrow morning.","exampleTranslation":"Họ sẽ công bố kết quả mới vào sáng mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"announce"},"announcement":{"definition":"Lời rao, lời loan báo; cáo thị, thông cáo.","example":"Did you hear the announcement of the new law?","exampleTranslation":"Bạn có nghe thông báo về đạo luật mới không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"announce"},"editor":{"definition":"người thu thập và xuất bản","example":"She worked as an editor for a magazine.","exampleTranslation":"Cô ấy làm biên tập viên cho một tạp chí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"editor"},"editorship":{"definition":"Nhiệm vụ chủ bút; chức chủ bút (báo, tập san... ).","example":"He left the editorship after five busy years.","exampleTranslation":"Anh ấy đã từ bỏ cương vị biên tập sau năm năm bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"editor"},"report":{"definition":"Bản tin, bản dự báo; phiếu thành tích học tập (hằng tháng hoặc từng học kỳ của học sinh).","example":"Did you check the weather report this morning?","exampleTranslation":"Bạn đã kiểm tra dự báo thời tiết sáng nay chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"report"},"reportable":{"definition":"Có thể báo cáo/thông báo/truyền đi.","example":"This issue is reportable to the office.","exampleTranslation":"Vấn đề này cần phải báo cáo lên văn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"report"},"reported":{"definition":"Gián tiếp.","example":"The news was reported by several different sources.","exampleTranslation":"Tin tức đã được báo cáo bởi nhiều nguồn khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"report"},"reporter":{"definition":"Người báo cáo.","example":"The reporter played a key role.","exampleTranslation":"Phóng viên đã đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"report"},"campaign":{"definition":"Chiến dịch.","example":"The military started a new campaign.","exampleTranslation":"Quân đội đã bắt đầu một chiến dịch mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"campaign"},"campaigned":{"definition":"Quá khứ và phân từ quá khứ của campaign","example":"She campaigned for cleaner streets.","exampleTranslation":"Cô ấy đã vận động vì những con đường sạch đẹp hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"campaign"},"campaigner":{"definition":"Người tham gia nhiều chiến dịch.","example":"The campaigner visited many towns this year.","exampleTranslation":"Nhà vận động đã đến thăm nhiều thị trấn trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"campaign"},"advertiser":{"definition":"Người báo cho biết trước.","example":"The advertiser warned us about the sale.","exampleTranslation":"Người báo cho biết trước đã cảnh báo chúng tôi về đợt bán hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"article":{"definition":"Bài báo.","example":"I read an interesting article in today's newspaper.","exampleTranslation":"Tôi đọc một bài báo thú vị trên báo hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"audience":{"definition":"Sự nghe.","example":"The large audience cheered loudly at the concert.","exampleTranslation":"Khán giả lớn đã cổ vũ nhiệt tình tại buổi hòa nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"audio":{"definition":"Thuộc âm thanh.","example":"The audio was clear and loud.","exampleTranslation":"Âm thanh rõ ràng và lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"banner":{"definition":"Một lá cờ hay tiêu chuẩn dùng bởi chỉ huy quân sự, quốc vương hay quốc gia.","example":"The banner was useful in class.","exampleTranslation":"Lá cờ rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"blockbuster":{"definition":"Bom tấn.","example":"The film became a blockbuster overnight.","exampleTranslation":"Bộ phim đã trở thành một bom tấn chỉ sau một đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"cartoon":{"definition":"Trang tranh đả kích; trang tranh vui.","example":"I read a cartoon in the morning paper.","exampleTranslation":"Tôi đọc một trang tranh vui trên báo sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"catchy":{"definition":"Đánh lừa, cho vào bẫy, quỷ quyệt.","example":"That song has a very catchy melody now.","exampleTranslation":"Bài hát đó có một giai điệu cho vào bẫy rất dễ nhớ bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"celebrity":{"definition":"(thuộc) nhân vật có danh tiếng.","example":"The celebrity signed many autographs for her fans.","exampleTranslation":"Người nổi tiếng đó đã ký tặng nhiều chữ ký cho người hâm mộ của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"channel":{"definition":"Đường; nguồn (tin tức, ý nghĩ, tư tưởng... ).","example":"We need to find a new news channel.","exampleTranslation":"Chúng ta cần tìm một kênh tin tức mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"cinematic":{"definition":"Thuộc về điện ảnh.","example":"The movie had a cinematic feel.","exampleTranslation":"Bộ phim mang một cảm giác thuộc về điện ảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"commentator":{"definition":"Nhà bình luận.","example":"The commentator described each play clearly.","exampleTranslation":"Nhà bình luận đã mô tả rõ ràng từng pha bóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"content":{"definition":"Nội dung.","example":"Please check the content of this letter carefully.","exampleTranslation":"Vui lòng kiểm tra nội dung của lá thư này cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"copy":{"definition":"Kiểu, mẫu (một bức hoạ); kiểu (chữ).","example":"The artist liked the copy for the poster.","exampleTranslation":"Người nghệ sĩ thích mẫu này cho tấm áp phích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"coverage":{"definition":"Vùng được gộp vào; số lượng được gôm ào.","example":"The new coverage reached every town in the area.","exampleTranslation":"Vùng được gộp vào mới đã vươn tới mọi thị trấn trong khu vực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"digest":{"definition":"Sách tóm tắt (chủ yếu là luật).","example":"She kept a digest of the new rules.","exampleTranslation":"Cô ấy giữ một sách tóm tắt về các quy tắc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"document":{"definition":"Văn kiện; tài liệu, tư liệu.","example":"Please sign the document before you leave.","exampleTranslation":"Vui lòng ký vào văn kiện trước khi bạn rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"documentary":{"definition":"Tài liệu, (thuộc) tư liệu.","example":"We watched an interesting documentary about space last night.","exampleTranslation":"Chúng tôi đã xem một bộ phim tài liệu thú vị về không gian tối qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"dubbed":{"definition":"Quá khứ và phân từ quá khứ của dub","example":"They dubbed the film in another language.","exampleTranslation":"Họ đã lồng tiếng bộ phim sang một ngôn ngữ khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"media"},"edit":{"definition":"Sự đổi, sự thay đổi, sự biến đổi, sự sửa đổi, sự chỉnh lại (văn bản trong tài liệu).","example":"The edit appeared in the report.","exampleTranslation":"Sự sửa đổi xuất hiện trong bản báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"edition":{"definition":"Loại sách in ra loại sách xuất bản.","example":"I bought the latest edition of the novel.","exampleTranslation":"Tôi đã mua loại sách xuất bản mới nhất của cuốn tiểu thuyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"episode":{"definition":"Phần giữa (hai bài đồng ca trong bi kịch Hy-lạp).","example":"The play had a short episode between the songs.","exampleTranslation":"Vở kịch có một phần giữa ngắn giữa các bài hát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"episodic":{"definition":"Đoạn, (thuộc) hồi; (thuộc) tình tiết (trong truyện).","example":"The novel has episodic chapters and short scenes.","exampleTranslation":"Cuốn tiểu thuyết có các chương đoạn và các cảnh ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"graphic":{"definition":"Đồ thị; minh hoạ bằng đồ thị.","example":"Please check the graphic statics on this page.","exampleTranslation":"Vui lòng kiểm tra các chỉ số đồ thị trên trang này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"graphically":{"definition":"Bằng đồ thị.","example":"She answered graphically and smiled.","exampleTranslation":"Cô ấy đã trả lời bằng đồ thị và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"media"},"headline":{"definition":"Tiêu đề, phiêu đề: Hàng chữ bên dưới nhan đề, nêu vắn tắt mục tiêu của nhan đề đó.","example":"The headline of the news caught my attention.","exampleTranslation":"Tiêu đề của tin tức đã thu hút sự chú ý của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"highlight":{"definition":"Chỗ nổi bật nhất, chỗ đẹp nhất, chỗ sáng nhất (trong một bức tranh).","example":"The bright window is the highlight of the room.","exampleTranslation":"Cửa sổ sáng là chỗ nổi bật nhất của căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"horror":{"definition":"Điều kinh khủng; cảnh khủng khiếp.","example":"The house was full of horror after dark.","exampleTranslation":"Ngôi nhà đầy những điều kinh khủng sau khi trời tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"image":{"definition":"Hình, hình ảnh, ảnh (trong gương... ).","example":"You can see your image in the clear water.","exampleTranslation":"Bạn có thể thấy hình ảnh của mình dưới làn nước trong vắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"inform":{"definition":"Truyền cho (ai... ) (tình cảm, đức tính... ).","example":"She tried to inform him with her great sense of thriftiness.","exampleTranslation":"Cô ấy đã cố gắng truyền cho anh ta ý thức tiết kiệm tuyệt vời của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"media"},"informative":{"definition":"Cung cấp nhiều tin tức, có nhiều tài liệu.","example":"The guide was informative and easy to follow.","exampleTranslation":"Tài liệu hướng dẫn đó cung cấp nhiều tin tức và dễ theo dõi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"interview":{"definition":"Cuộc phỏng vấn; bài phỏng vấn.","example":"I read an interesting interview in the newspaper.","exampleTranslation":"Tôi đã đọc một cuộc phỏng vấn thú vị trên báo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"issue":{"definition":"Số báo (in ra); số lượng cho ra (tem... ).","example":"Did you read the latest issue of this magazine?","exampleTranslation":"Bạn đã đọc số báo mới nhất của tạp chí này chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"keynote":{"definition":"Chủ đạo, then chốt, chủ chốt, chính.","example":"She gave a powerful keynote speech at the conference.","exampleTranslation":"Cô ấy đã có một bài phát biểu chủ đạo đầy quyền lực tại hội nghị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"late":{"definition":"Muộn, chậm, trễ.","example":"I am sorry because I arrived late today.","exampleTranslation":"Tôi xin lỗi vì hôm nay tôi đã đến muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"logo":{"definition":"Biểu trưng.","example":"The company changed its logo this year.","exampleTranslation":"Công ty đã thay đổi biểu trưng của mình trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"magazine":{"definition":"Ổ đạn (trong súng).","example":"He loaded a fresh magazine into the gun.","exampleTranslation":"Anh ấy nạp một ổ đạn mới vào súng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"mail":{"definition":"Mặc áo giáp.","example":"He mail wore out after years of use.","exampleTranslation":"Bộ áo giáp anh ấy mặc đã cũ sau nhiều năm sử dụng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"media"},"medium":{"definition":"Người trung gian, vật môi giới.","example":"They communicated through the medium of radio waves.","exampleTranslation":"Họ đã liên lạc thông qua người trung gian của sóng vô tuyến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"moderator":{"definition":"Người điều tiết, máy điều tiết.","example":"The moderator will keep the online forum safe.","exampleTranslation":"Người điều tiết sẽ giữ cho diễn đàn trực tuyến an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"movie":{"definition":"Phim xi-nê.","example":"We watched a movie after dinner.","exampleTranslation":"Chúng tôi đã xem một bộ phim sau bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"multimedia":{"definition":"Đa phương tiện.","example":"The multimedia was important at work.","exampleTranslation":"Đa phương tiện rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"newsletter":{"definition":"Bản tin.","example":"I got a newsletter from the library.","exampleTranslation":"Tôi đã nhận được một bản tin từ thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"newsprint":{"definition":"Giấy in báo.","example":"We bought newsprint for the school printer.","exampleTranslation":"Chúng tôi đã mua giấy in báo cho máy in của trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"package":{"definition":"Chương trình quảng cáo hoàn chỉnh (trên đài truyền thanh, đài truyền hình).","example":"The station aired a full package of ads.","exampleTranslation":"Nhà đài đã phát sóng trọn bộ quảng cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"paperback":{"definition":"Sách đóng trên bìa giấy mềm; sách bìa mềm.","example":"I borrowed a paperback from the library.","exampleTranslation":"Tôi đã mượn một cuốn sách bìa mềm từ thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"photo":{"definition":"Của photograph.","example":"Can you take a photo of us?","exampleTranslation":"Bạn có thể chụp một tấm ảnh của chúng tôi không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"media"},"photograph":{"definition":"Ảnh, bức ảnh.","example":"He kept a photograph of his family.","exampleTranslation":"Anh ấy giữ một bức ảnh của gia đình mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"photographic":{"definition":"Như chụp ảnh.","example":"She has a very photographic memory for faces.","exampleTranslation":"Cô ấy có trí nhớ như chụp ảnh đối với các khuôn mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"photography":{"definition":"Thuật nhiếp ảnh, thuật chụp ảnh; sự chụp ảnh.","example":"The photography played a key role.","exampleTranslation":"Nhiếp ảnh đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"pictorial":{"definition":"Tranh ảnh; diễn tả bằng tranh ảnh; có nhiều tranh ảnh.","example":"She bought a beautiful pictorial magazine at the shop.","exampleTranslation":"Cô ấy đã mua một tạp chí tranh ảnh đẹp tại cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"picture":{"definition":"Bức tranh, bức ảnh, bức vẽ.","example":"I hung a beautiful picture on the living room wall.","exampleTranslation":"Tôi đã treo một bức tranh đẹp trên tường phòng khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"presentation":{"definition":"Sự giới thiệu; sự đưa vào yết kiến, sự đưa vào bệ kiến.","example":"The presentation of the award took five minutes.","exampleTranslation":"Buổi trao giải diễn ra trong năm phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"print":{"definition":"Chữ in.","example":"The newspaper print is very clear and easy to read.","exampleTranslation":"Chữ in trên báo rất rõ ràng và dễ đọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"profile":{"definition":"hồ sơ.","example":"Please update your customer profile on our website.","exampleTranslation":"Vui lòng cập nhật hồ sơ khách hàng của bạn trên trang web của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"publish":{"definition":"Công bố; ban bố (sắc lệnh... ).","example":"They plan to publish the book next month.","exampleTranslation":"Họ dự định xuất bản cuốn sách vào tháng tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"media"},"publisher":{"definition":"Người xuất bản, nhà xuất bản (sách báo... ).","example":"The publisher accepted her new book.","exampleTranslation":"Nhà xuất bản đã chấp nhận cuốn sách mới của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"quote":{"definition":"Lời trích dẫn; đoạn trích dẫn.","example":"The quote came from an old letter.","exampleTranslation":"Trích dẫn đó đến từ một lá thư cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"receiver":{"definition":"Người chứa chấp đồ trộm cắp.","example":"The police found a receiver of stolen goods.","exampleTranslation":"Người chứa chấp đồ trộm cắp","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"record":{"definition":"Hồ sơ.","example":"His name is already on the official record.","exampleTranslation":"Tên của anh ấy đã có trong hồ sơ chính thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"remake":{"definition":"Lần phát hành mới (phim), lần in mới (sách).","example":"The remake was much better than the original film.","exampleTranslation":"Lần phát hành mới","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"reportedly":{"definition":"theo báo cáo; được cho là","example":"The actor is reportedly working on a new movie.","exampleTranslation":"Diễn viên này được cho là đang thực hiện một bộ phim mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"media"},"rumor":{"definition":"(như) rumour.","example":"A rumor spread quickly through the school.","exampleTranslation":"Một lời đồn lan truyền nhanh chóng khắp ngôi trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"serial":{"definition":"Ra theo từng số (truyện in trên báo).","example":"The newspaper sold the serial rights to the story.","exampleTranslation":"Tờ báo đã bán quyền ra theo từng số cho câu chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"media"},"series":{"definition":"Loạt, dãy, chuỗi, đợt.","example":"I bought a series of old books.","exampleTranslation":"Tôi đã mua một loạt các cuốn sách cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"slogan":{"definition":"Khẩu hiệu.","example":"The slogan was easy to remember.","exampleTranslation":"Khẩu hiệu đó rất dễ nhớ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"snapshot":{"definition":"Ảnh chụp nhanh.","example":"She took a snapshot of the garden.","exampleTranslation":"Cô ấy đã chụp một bức ảnh nhanh khu vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"spokesman":{"definition":"Người phát ngôn.","example":"The spokesman answered the reporters calmly.","exampleTranslation":"Người phát ngôn đã trả lời các phóng viên một cách bình tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"spokesperson":{"definition":"Người nói hoặc được chọn để nói (thay mặt cho một nhóm); người phát ngôn (cả nam lẫn nữ).","example":"Our spokesperson explained the new rule clearly.","exampleTranslation":"Người phát ngôn của chúng tôi đã giải thích quy tắc mới một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"spokeswoman":{"definition":"Nữ phát ngôn.","example":"The spokeswoman spoke for the whole team.","exampleTranslation":"Nữ phát ngôn đã lên tiếng thay mặt cho cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"subscribe":{"definition":"Quyên tiền; góp tiền.","example":"They decided to subscribe to a local charity.","exampleTranslation":"Họ quyết định quyên tiền cho một tổ chức từ thiện địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"media"},"superstar":{"definition":"Thgt siêu sao.","example":"He became a superstar overnight.","exampleTranslation":"Anh ấy đã trở thành một siêu sao chỉ sau một đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"suspense":{"definition":"Tình trạng chờ đợi, tình trạng hồi hộp, tình trạng chưa quyết định.","example":"The movie kept us in suspense until the final scene.","exampleTranslation":"Bộ phim đã giữ chúng tôi trong tình trạng hồi hộp cho đến cảnh cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"thriller":{"definition":"Câu chuyện cảm động.","example":"The movie was a moving thriller.","exampleTranslation":"Bộ phim là một câu chuyện cảm động đầy hồi hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"version":{"definition":"Bản dịch.","example":"I read the revised version of the novel.","exampleTranslation":"Tôi đã đọc bản dịch sửa đổi của cuốn tiểu thuyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"video":{"definition":"Truyền hình.","example":"We watched the video after dinner.","exampleTranslation":"Chúng tôi đã xem truyền hình sau bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"videotape":{"definition":"Băng viđêô.","example":"She found an old videotape in the drawer.","exampleTranslation":"Cô ấy đã tìm thấy một băng viđêô cũ trong ngăn kéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"view":{"definition":"Sự nhìn, sự thấy, tầm nhìn, tầm mắt.","example":"The mountains went out of view as we drove.","exampleTranslation":"Những ngọn núi đã vượt ra khỏi tầm nhìn khi chúng tôi lái xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"viewer":{"definition":"Người xem.","example":"Every viewer enjoyed the show.","exampleTranslation":"Mỗi người xem đã thích buổi trình diễn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"media"},"coalition":{"definition":"Liên minh tạm thời giữa các nhóm hoặc đảng để cùng đạt một mục tiêu.","example":"Several parties formed a coalition to pass the environmental bill.","exampleTranslation":"Một số đảng thành lập liên minh để thông qua dự luật môi trường.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"government"},"bureaucracy":{"definition":"Hệ thống quản lý của các cơ quan công quyền hoặc doanh nghiệp, thường có nhiều quy trình và cấp bậc.","example":"The new online service reduced delays caused by bureaucracy.","exampleTranslation":"Dịch vụ trực tuyến mới giảm chậm trễ do thủ tục hành chính.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"government"},"govern":{"definition":"Cai trị, thống trị, cầm quyền (một nước).","example":"Elected leaders govern the city fairly.","exampleTranslation":"Các nhà lãnh đạo được bầu chọn điều hành thành phố một cách công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"govern"},"governable":{"definition":"Có thể kiềm chế.","example":"His anger is governable after a short break.","exampleTranslation":"Sự giận dữ của anh ấy có thể kiểm soát được sau một khoảng nghỉ ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"govern"},"governance":{"definition":"Sự cai trị, sự thống trị.","example":"Good governance keeps the town stable.","exampleTranslation":"Sự quản lý tốt giúp thị trấn ổn định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"govern"},"governed":{"definition":"Quá khứ và phân từ quá khứ của govern","example":"The game was governed by clear rules.","exampleTranslation":"Trò chơi được quy định bởi các luật lệ rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"govern"},"governing":{"definition":"Cai quản, quản trị.","example":"Who is the governing body of this school?","exampleTranslation":"Cơ quan nào quản lý ngôi trường này?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"govern"},"government":{"definition":"Chính phủ, nội các.","example":"The government manages the country's national budget.","exampleTranslation":"Chính phủ quản lý ngân sách quốc gia của đất nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"govern"},"governor":{"definition":"Uỷ viên hội đồng quản trị (một trường học, một bệnh viện... ).","example":"She became a governor of the hospital board.","exampleTranslation":"Cô ấy trở thành thành viên hội đồng quản trị của bệnh viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"govern"},"political":{"definition":"Chính trị.","example":"He studied political economy at the local university.","exampleTranslation":"Anh ấy đã học kinh tế chính trị tại trường đại học địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"politic"},"politicise":{"definition":"Làm chính trị; tham gia chính trị.","example":"She began to politicise every school issue.","exampleTranslation":"Cô ấy bắt đầu chính trị hóa mọi vấn đề ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"politic","spellingNote":"Alternate spelling: politicize."},"politicize":{"definition":"Làm chính trị; tham gia chính trị.","example":"Students politicize the issue too quickly.","exampleTranslation":"Học sinh chính trị hóa vấn đề quá nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"politic","spellingNote":"British spelling: politicise."},"politics":{"definition":"Chính trị.","example":"We should avoid talking about politics today.","exampleTranslation":"Chúng ta nên tránh nói về chính trị ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"politic"},"policy":{"definition":"Chính sách (của chính phủ, đảng... ).","example":"The government announced a new economic policy today.","exampleTranslation":"Chính phủ đã công bố một chính sách kinh tế mới vào hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"policy"},"democrat":{"definition":"Người theo chế độ dân chủ.","example":"Each democrat voted for the new plan.","exampleTranslation":"Mỗi đảng viên Dân chủ đều bỏ phiếu cho kế hoạch mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"democrat"},"democratic":{"definition":"Dân chủ.","example":"They formed a democratic club at school.","exampleTranslation":"Họ đã thành lập một câu lạc bộ dân chủ tại trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"democrat"},"democratize":{"definition":"Dân chủ hoá.","example":"The school plans to democratize student meetings.","exampleTranslation":"Nhà trường có kế hoạch dân chủ hóa các cuộc họp học sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"democrat"},"election":{"definition":"Sự chọn.","example":"The local election will take place next week.","exampleTranslation":"Cuộc bầu cử địa phương sẽ diễn ra vào tuần tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"election"},"elect":{"definition":"Quyết định.","example":"They will elect a new leader next week.","exampleTranslation":"Họ sẽ bầu ra một nhà lãnh đạo mới vào tuần tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"elect"},"elected":{"definition":"Quá khứ và phân từ quá khứ của elect","example":"The club elected her as captain.","exampleTranslation":"Câu lạc bộ đã bầu cô ấy làm đội trưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"elect"},"elective":{"definition":"Có quyền bầu cử.","example":"The students have an elective class on Tuesday.","exampleTranslation":"Các học sinh có một lớp học tự chọn vào thứ Ba.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"elect"},"elector":{"definition":"Cử tri, người bỏ phiếu.","example":"Each elector cast one clear vote.","exampleTranslation":"Mỗi cử tri đã bỏ một phiếu bầu hợp lệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"elect"},"parliament":{"definition":"Nghị viện; nghị trường.","example":"The parliament met to discuss the new law.","exampleTranslation":"Quốc hội đã họp để thảo luận về luật mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"parliament"},"parliamentary":{"definition":"Nghị trường; của nghị viện.","example":"The old parliamentary hand spoke with great authority.","exampleTranslation":"Vị nghị sĩ kỳ cựu đó phát biểu với đầy uy quyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"parliament"},"senator":{"definition":"Thượng nghị sĩ.","example":"The senator spoke to the crowd.","exampleTranslation":"Thượng nghị sĩ đã nói chuyện với đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"senat"},"politician":{"definition":"Nhà chính trị, chính khách.","example":"The politician played a key role.","exampleTranslation":"Chính trị gia đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"politician"},"lawful":{"definition":"Hợp pháp, đúng luật.","example":"You must ensure that your business is completely lawful.","exampleTranslation":"Bạn phải đảm bảo rằng công việc kinh doanh của mình hoàn toàn hợp pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"law"},"lawless":{"definition":"Lộn xộn, vô trật tự, hỗn loạn.","example":"The room grew lawless after the lights went out.","exampleTranslation":"Căn phòng trở nên hỗn loạn vô luật pháp sau khi đèn tắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"law"},"regulation":{"definition":"Sự sắp đặt, sự quy định, sự chỉnh lý, sự chỉnh đốn (công việc... ).","example":"The new regulation helps keep the park clean.","exampleTranslation":"Quy định mới giúp giữ cho công viên sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"regulat"},"regulator":{"definition":"Người điều chỉnh.","example":"The regulator kept the temperature steady.","exampleTranslation":"Bộ điều chỉnh đã giữ cho nhiệt độ ổn định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"regulat"},"legislating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của legislate.","example":"They are legislating new safety rules.","exampleTranslation":"Họ đang soạn thảo các quy tắc an toàn mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"legislat"},"legislation":{"definition":"Pháp luật, pháp chế.","example":"The teacher explained the legislation in simple words.","exampleTranslation":"Giáo viên đã giải thích văn bản luật bằng những từ ngữ đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legislat"},"legislative":{"definition":"Làm luật, lập pháp.","example":"The legislative body met to discuss the new laws.","exampleTranslation":"Cơ quan lập pháp đã họp để thảo luận về các đạo luật mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"legislat"},"legislator":{"definition":"Người làm luật, người lập pháp; thành viên có quan lập pháp.","example":"The legislator supported the new rule.","exampleTranslation":"Nhà lập pháp đã ủng hộ quy tắc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legislat"},"administration":{"definition":"Sự thi hành; việc áp dụng.","example":"The administration of justice must be fair for everyone.","exampleTranslation":"Việc thực thi công lý phải công bằng cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"administrat"},"administrative":{"definition":"Chính quyền, (thuộc) nhà nước.","example":"She works in the administrative office of the city.","exampleTranslation":"Cô ấy làm việc tại văn phòng hành chính của thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"administrat"},"administrator":{"definition":"Người quản lý.","example":"The administrator fixed the schedule.","exampleTranslation":"Người quản trị đã sửa lại lịch trình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"administrat"},"authority":{"definition":"quyền lực, cơ quan","example":"This judge has the authority to throw you in jail.","exampleTranslation":"Vị thẩm phán này có thẩm quyền tống giam bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"authority"},"vote":{"definition":"Sự bỏ phiếu.","example":"It is time for the citizens to go to the vote.","exampleTranslation":"Đã đến lúc để những công dân đi bỏ phiếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"vote"},"president":{"definition":"Chủ tịch (buổi họp, hội nước... ).","example":"The president will give a speech at noon.","exampleTranslation":"Chủ tịch sẽ có bài phát biểu vào buổi trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"president"},"minister":{"definition":"Giúp vào, giúp đỡ; chăm sóc.","example":"The nurse will minister to the sick patient.","exampleTranslation":"Y tá sẽ chăm sóc bệnh nhân đang bị ốm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"minister"},"ministered":{"definition":"Quá khứ và phân từ quá khứ của minister","example":"He ministered to the small group.","exampleTranslation":"Ông ấy đã chăm sóc nhóm nhỏ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"minister"},"state":{"definition":"Trạng thái, tình trạng.","example":"The country is in a state of emergency.","exampleTranslation":"Đất nước đang trong tình trạng khẩn cấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"state"},"statehood":{"definition":"Cương vị một nước; một bang (ở Mỹ).","example":"The territory gained statehood in 1959.","exampleTranslation":"Lãnh thổ đó đã đạt được tư cách tiểu bang vào năm 1959.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"state"},"stateless":{"definition":"Vô quốc gia; không được nước nào nhận là công dân.","example":"Many stateless people struggle to travel freely.","exampleTranslation":"Nhiều người không quốc tịch gặp khó khăn trong việc đi lại tự do.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"state"},"statement":{"definition":"Sự bày tỏ, sự trình bày, sự phát biểu.","example":"Please provide a clearer statement about your plans.","exampleTranslation":"Vui lòng đưa ra một tuyên bố rõ ràng hơn về kế hoạch của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"state"},"nation":{"definition":"Dân tộc.","example":"Every nation has its own songs.","exampleTranslation":"Mỗi quốc gia đều có những bài hát riêng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"nation"},"national":{"definition":"Dân tộc.","example":"She joined the national liberation movement.","exampleTranslation":"Cô ấy đã tham gia phong trào giải phóng dân tộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"nation"},"nationhood":{"definition":"Tính trạng là một dân tộc; tính chất là một quốc gia.","example":"Their nationhood gave them a shared pride.","exampleTranslation":"Tư cách quốc gia của họ đã mang lại cho họ niềm tự hào chung.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"nation"},"council":{"definition":"Hội đồng.","example":"The city council met to discuss the new park.","exampleTranslation":"Hội đồng thành phố đã họp để thảo luận về công viên mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"council"},"rights":{"definition":"Động từ chia ở ngôi thứ ba số ít của right","example":"The guide rights wrong facts in the book.","exampleTranslation":"Người hướng dẫn đính chính những sự thật sai lệch trong cuốn sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"rights"},"constitution":{"definition":"Thể tạng, thể chất.","example":"She has a strong constitution and rarely gets sick.","exampleTranslation":"Cô ấy có thể trạng khỏe mạnh và hiếm khi bị ốm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"constitution"},"constitutional":{"definition":"Hợp hiến, hợp với hiến pháp, theo hiến pháp, đúng với hiến pháp.","example":"The new law is fully constitutional and fair.","exampleTranslation":"Đạo luật mới hoàn toàn hợp hiến và công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"constitution"},"abolish":{"definition":"Thủ tiêu, bãi bỏ, huỷ bỏ.","example":"They want to abolish the old tax system.","exampleTranslation":"Họ muốn bãi bỏ hệ thống thuế cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"abolishment":{"definition":"Sự thủ tiêu, sự bãi bỏ, sự huỷ bỏ.","example":"The abolishment of the rule pleased many.","exampleTranslation":"Việc bãi bỏ quy định đó đã làm hài lòng nhiều người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"accordance":{"definition":"Sự đồng ý, sự thoả thuận (với ai).","example":"You must act in accordance with the rules.","exampleTranslation":"Bạn phải hành động theo sự thoả thuận với các quy định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"accountable":{"definition":"Chịu trách nhiệm, có trách nhiệm phải giải thích.","example":"Managers are accountable to the board of directors.","exampleTranslation":"Các nhà quản lý phải chịu trách nhiệm trước ban giám đốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"administer":{"definition":"Trông nom, quản lý; cai quản, cai trị.","example":"He was hired to administer the state affairs.","exampleTranslation":"Anh ấy đã được thuê để quản lý công việc nhà nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"agenda":{"definition":"Những việc phải làm.","example":"I wrote my agenda before the class began.","exampleTranslation":"Tôi đã viết những việc phải làm trước khi lớp học bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"agreement":{"definition":"Sự bằng lòng, sự tán thành, sự đồng ý, sự thoả thuận.","example":"They finally reached an agreement on the new contract.","exampleTranslation":"Họ cuối cùng đã đạt được sự thoả thuận về hợp đồng mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"allow":{"definition":"Cho phép, để cho.","example":"Please allow me to help you with your bags.","exampleTranslation":"Vui lòng cho phép tôi giúp bạn với những chiếc túi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"allowable":{"definition":"Có thể cho phép được.","example":"A small fee is allowable here.","exampleTranslation":"Một khoản phí nhỏ là có thể cho phép được ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"approval":{"definition":"Sự tán thành, sự đồng ý, sự chấp thuận.","example":"She nodded in approval of my creative idea.","exampleTranslation":"Cô ấy gật đầu trong sự tán thành ý tưởng sáng tạo của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"approve":{"definition":"Chứng tỏ, tỏ ra, chứng minh.","example":"His actions approve his great courage in battle.","exampleTranslation":"Hành động của anh ấy chứng tỏ sự dũng cảm to lớn trong trận chiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"army":{"definition":"Quân đội.","example":"The regular army marched across the valley in the morning.","exampleTranslation":"Quân đội chính quy đã hành quân ngang qua thung lũng vào buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"artillery":{"definition":"Pháo.","example":"The army used heavy artillery during the long battle.","exampleTranslation":"Quân đội đã sử dụng pháo hạng nặng trong suốt trận chiến dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"bureaucrat":{"definition":"Quan lại, công chức.","example":"The bureaucrat stamped the papers carefully.","exampleTranslation":"Quan lại đã đóng dấu các giấy tờ một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"bureaucratic":{"definition":"Quan lại, (thuộc) công chức.","example":"She works in a bureaucratic office.","exampleTranslation":"Cô ấy làm việc trong một văn phòng quan lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"cabinet":{"definition":"Vỏ (máy thu thanh, máy ghi âm).","example":"The cabinet on the radio is scratched and old.","exampleTranslation":"Vỏ máy thu thanh đã bị trầy xước và cũ kỹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"candidate":{"definition":"Người ứng cử.","example":"She is a strong candidate for the position.","exampleTranslation":"Cô ấy là một người ứng cử mạnh mẽ cho vị trí này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"colonize":{"definition":"Lập thuộc địa.","example":"The country tried to colonize the small island.","exampleTranslation":"Đất nước đã cố gắng lập thuộc địa trên hòn đảo nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"command":{"definition":"Lệnh, mệnh lệnh.","example":"The general gave a clear command to his soldiers.","exampleTranslation":"Vị tướng đã đưa ra mệnh lệnh rõ ràng cho binh lính của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"commission":{"definition":"Sự uỷ nhiệm, sự uỷ thác; công việc uỷ nhiệm, công việc uỷ thác.","example":"He is currently in commission for this project.","exampleTranslation":"Anh ấy hiện đang nhận công việc uỷ nhiệm cho dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"committee":{"definition":"Uỷ ban.","example":"The committee will meet next week to discuss the budget.","exampleTranslation":"Uỷ ban sẽ họp vào tuần tới để thảo luận về ngân sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"communist":{"definition":"Người cộng sản.","example":"The communist spoke at the town meeting.","exampleTranslation":"Người cộng sản đã phát biểu tại cuộc họp thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"compliant":{"definition":"Phù hợp (với một quy tắc, tiêu chuẩn nào đó).","example":"This file is compliant with the new rule.","exampleTranslation":"Tập tin này phù hợp với quy tắc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"comply":{"definition":"Tuân theo, chiếu theo, đồng ý làm theo.","example":"You must comply with the new safety rules.","exampleTranslation":"Bạn phải tuân theo các quy tắc an toàn mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"condemn":{"definition":"Chỉ trích, chê trách, lên án, quy tội.","example":"Do not condemn him without knowing the truth.","exampleTranslation":"Đừng lên án anh ấy mà không biết sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"consensus":{"definition":"Sự đồng thuận, sự đồng lòng, sự đồng tâm, sự nhất trí.","example":"There is a general consensus on this new policy.","exampleTranslation":"Có một sự đồng thuận chung về chính sách mới này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"control":{"definition":"Quyền hành, quyền lực, quyền chỉ huy.","example":"He has full control over the whole district now.","exampleTranslation":"Anh ấy có toàn quyền hành đối với cả quận hiện nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"decentralization":{"definition":"Sự phân quyền.","example":"The town gained more control after decentralization.","exampleTranslation":"Thị trấn giành được nhiều quyền kiểm soát hơn sau khi phân quyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"declare":{"definition":"Tuyên bố.","example":"The king decided to declare war on them.","exampleTranslation":"Nhà vua quyết định tuyên bố chiến tranh với họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"defence":{"definition":"Cái để bảo vệ, vật để chống đỡ, vật để chặn lại.","example":"A fence can serve as a defence for the yard.","exampleTranslation":"Một hàng rào có thể đóng vai trò là vật để bảo vệ cho sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"defense":{"definition":"(như) defence.","example":"Their defense was strong and organized.","exampleTranslation":"Sự phòng ngự của họ mạnh mẽ và có tổ chức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"defensive":{"definition":"Thế thủ, thế phòng ngự.","example":"The team was forced to stand on the defensive.","exampleTranslation":"Cả đội buộc phải đứng trên thế phòng ngự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"democracy":{"definition":"Nước (theo chế độ) dân chủ.","example":"The country changed to democracy many years ago.","exampleTranslation":"Đất nước đã thay đổi sang nền dân chủ từ nhiều năm trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"dictatorship":{"definition":"Chế độ độc tài; nền chuyên chính.","example":"They lived under a strict dictatorship for years.","exampleTranslation":"Họ đã sống dưới một chế độ độc tài nghiêm ngặt trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"enforce":{"definition":"Ép làm, thúc ép, ép buộc (một việc gì).","example":"The police will enforce the new traffic laws.","exampleTranslation":"Cảnh sát sẽ thúc ép các luật giao thông mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"entitle":{"definition":"Cho quyền (làm gì... ).","example":"This ticket will entitle you to enter.","exampleTranslation":"Tấm vé này sẽ cho quyền bạn đi vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"establish":{"definition":"Lập, thành lập, thiết lập, kiến lập.","example":"The leaders want to establish a new government.","exampleTranslation":"Các nhà lãnh đạo muốn thành lập một chính phủ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"execution":{"definition":"Sự thực hiện, sự thi hành, sự thừa hành, sự chấp hành.","example":"The execution of the plan took all day.","exampleTranslation":"Sự thi hành kế hoạch đã chiếm cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"fascism":{"definition":"Chủ nghĩa phát xít.","example":"The film showed the rise of fascism.","exampleTranslation":"Bộ phim cho thấy sự trỗi dậy của chủ nghĩa phát xít.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"grant":{"definition":"Tiền tài trợ, tiền trợ cấp.","example":"The government will make a grant for schools.","exampleTranslation":"Chính phủ sẽ đưa ra một khoản tiền tài trợ cho các trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"guideline":{"definition":"Nguyên tắc chỉ đạo, đường lối chỉ đạo (để vạch ra chính sách... ).","example":"Follow the safety guideline carefully.","exampleTranslation":"Hãy tuân theo nguyên tắc chỉ đạo an toàn một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"hereby":{"definition":"Bằng biện pháp này, bằng cách này.","example":"She spoke hereby during the meeting.","exampleTranslation":"Cô ấy đã phát biểu bằng biện pháp này trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"government"},"ideology":{"definition":"Ý thức hệ, tư tưởng, hệ tư tưởng (của một giai cấp... ), lý tưởng.","example":"Their ideology shaped every decision.","exampleTranslation":"Hệ tư tưởng của họ đã định hình mọi quyết định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"impose":{"definition":"Đánh (thuế... ); bắt chịu, bắt gánh vác, bắt cáng đáng.","example":"The government will impose new taxes on fuel.","exampleTranslation":"Chính phủ sẽ đánh các loại thuế mới lên nhiên liệu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"independence":{"definition":"Sự độc lập; nền độc lập ((cũng) independency).","example":"Freedom and independence matter to many people.","exampleTranslation":"Tự do và sự độc lập quan trọng đối với nhiều người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"independent":{"definition":"Độc lập.","example":"They want to establish an independent state soon.","exampleTranslation":"Họ muốn thiết lập một quốc gia độc lập sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"independently":{"definition":"Độc lập.","example":"The team finished independently and left.","exampleTranslation":"Cả đội đã kết thúc độc lập và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"government"},"inspect":{"definition":"Duyệt (quân đội).","example":"The officer will inspect the team this afternoon.","exampleTranslation":"Viên sĩ quan sẽ duyệt đội quân vào chiều nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"inspection":{"definition":"Sự xem xét kỹ, sự kiểm tra, sự thanh tra.","example":"The inspection found several small problems.","exampleTranslation":"Sự kiểm tra đã tìm thấy vài vấn đề nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"intervene":{"definition":"Xen vào, can thiệp.","example":"The police had to intervene in the fight.","exampleTranslation":"Cảnh sát đã phải can thiệp vào cuộc ẩu đả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"intervention":{"definition":"Sự xen vào, sự can thiệp.","example":"The teacher welcomed intervention when the lesson went wrong.","exampleTranslation":"Giáo viên hoan nghênh sự can thiệp khi bài học gặp trục trặc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"invoke":{"definition":"Gọi cho hiện lên (ma quỷ).","example":"The old story can invoke fear in children.","exampleTranslation":"Câu chuyện cũ có thể gọi cho hiện lên nỗi sợ trong trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"license":{"definition":"Sự cho phép; giấy phép, môn bài, đăng ký.","example":"They need a marriage license before the wedding.","exampleTranslation":"Họ cần một giấy phép kết hôn trước khi đám cưới diễn ra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"lobbyist":{"definition":"Người vận động ở hành lang (đưa ra hoặc thông qua một đạo luật ở nghị viện).","example":"The lobbyist met officials to discuss the bill.","exampleTranslation":"Người vận động ở hành lang đã gặp các quan chức để thảo luận về dự luật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"mandate":{"definition":"Lệnh, trát.","example":"The judge issued a mandate to appear in court.","exampleTranslation":"Thẩm phán đã ban lệnh xuất hiện tại tòa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"mayor":{"definition":"Thị trưởng.","example":"The mayor greeted the crowd outside.","exampleTranslation":"Thị trưởng đã chào đón đám đông bên ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"military":{"definition":"Quân đội, (thuộc) quân sự.","example":"He wore a military coat to the event.","exampleTranslation":"Anh ấy mặc một chiếc áo khoác quân đội đến sự kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"monarch":{"definition":"Vua, quốc vương ((nghĩa đen) & (nghĩa bóng)).","example":"The monarch greeted the guests from the balcony.","exampleTranslation":"Quốc vương chào đón các vị khách từ ban công.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"nationwide":{"definition":"Khắp cả nước; toàn quốc.","example":"The store is offering a nationwide sale this week.","exampleTranslation":"Cửa hàng đang giảm giá trên toàn quốc trong tuần này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"negotiate":{"definition":", (chính trị) điều đình, đàm phán, thương lượng, dàn xếp.","example":"Leaders need to negotiate a peace treaty.","exampleTranslation":"Các nhà lãnh đạo cần đàm phán một hiệp ước hòa bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"negotiation":{"definition":"Sự điều đình, sự đàm phán, sự thương lượng, sự dàn xếp.","example":"They entered into a negotiation with the city.","exampleTranslation":"Họ đã bắt đầu một cuộc đàm phán với thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"nominate":{"definition":"Chỉ định, chọn, bổ nhiệm.","example":"They will nominate her for the new job.","exampleTranslation":"Họ sẽ chỉ định cô ấy cho công việc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"officer":{"definition":"Nhân viên chính quyền, nhân viên, viên chức.","example":"The officer checked our papers at the gate.","exampleTranslation":"Viên chức đã kiểm tra giấy tờ của chúng tôi tại cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"official":{"definition":"Chính quyền; (thuộc) văn phòng.","example":"The official report arrived by email.","exampleTranslation":"Bản báo cáo chính thống đã được gửi đến bằng email.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"patent":{"definition":"Tài tình, khéo léo, tinh xảo.","example":"He designed a patent device for cleaning floors.","exampleTranslation":"Anh ấy đã thiết kế một thiết bị tài tình để lau sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"permission":{"definition":"Sự cho phép, sự chấp nhận.","example":"I need permission from my teacher to leave early.","exampleTranslation":"Tôi cần sự cho phép từ giáo viên để về sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"permit":{"definition":"Giấy phép.","example":"You need a permit to park your car here.","exampleTranslation":"Bạn cần giấy phép để đỗ xe ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"pledge":{"definition":"Của đợ, của tin, của thế nợ, vật cầm cố; sự cầm cố, tình trạng bị cầm cố.","example":"The gold ring was deposited as a pledge.","exampleTranslation":"Chiếc nhẫn vàng đã được ký gửi như một của thế nợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"poll":{"definition":"Số phiếu bầu, số người bỏ phiếu.","example":"The heavy poll showed that people were happy.","exampleTranslation":"Số phiếu bầu nặng cho thấy mọi người đều hạnh phúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"provision":{"definition":"Sự cung cấp; đồ cung cấp","example":"We must make provision for our future needs.","exampleTranslation":"Chúng ta phải chuẩn bị cho những nhu cầu trong tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"provisional":{"definition":"Tạm, tạm thời, lâm thời.","example":"The provisional results are not final yet.","exampleTranslation":"Kết quả tạm thời vẫn chưa phải là kết quả cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"reform":{"definition":"Sửa đổi.","example":"The government plans to reform the old tax laws.","exampleTranslation":"Chính phủ có kế hoạch cải cách các luật thuế cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"reformer":{"definition":"Nhà cải cách, cải tổ.","example":"The reformer spoke clearly about better schools.","exampleTranslation":"Nhà cải cách đã nói rõ ràng về các trường học tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"regime":{"definition":"Chế độ, chính thể.","example":"The country is under a new democratic regime.","exampleTranslation":"Đất nước đang dưới một chế độ dân chủ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"register":{"definition":"Sổ, sổ sách, sổ bộ, danh sách, cơ sở dữ liệu.","example":"Please sign your name in the guest register.","exampleTranslation":"Vui lòng ký tên của bạn vào sổ đăng ký khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"registry":{"definition":"Nơi đăng ký; cơ quan đăng ký.","example":"They got married at the local registry office.","exampleTranslation":"Cơ quan đăng ký","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"regulate":{"definition":"Điều chỉnh, sửa lại cho đúng.","example":"You must regulate the temperature of the room.","exampleTranslation":"Bạn phải điều chỉnh nhiệt độ của căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"represent":{"definition":"Đóng (một vai kịch); diễn (một vở kịch).","example":"He will represent the king in the play.","exampleTranslation":"Anh ấy sẽ đóng vai vị vua trong vở kịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"representation":{"definition":"Sự đại diện; sự thay mặt; những người đại diện.","example":"She spoke as a representation of her class.","exampleTranslation":"Cô ấy đã phát biểu với tư cách là đại diện cho lớp mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"republic":{"definition":"Nước cộng hoà; nền cộng hoà.","example":"They live in a democratic republic.","exampleTranslation":"Họ sống trong một nước cộng hòa dân chủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"restrict":{"definition":"Hạn chế, giới hạn, thu hẹp.","example":"Strict rules restrict the use of alcohol in this area.","exampleTranslation":"Các quy định nghiêm ngặt hạn chế việc sử dụng rượu bia trong khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"restriction":{"definition":"Sự hạn chế, sự giới hạn, sự thu hẹp.","example":"The new law puts a restriction on travel.","exampleTranslation":"Luật mới đặt ra một sự hạn chế đối với việc đi lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"restrictive":{"definition":"Hạn chế, giới hạn, thu hẹp.","example":"These restrictive rules are very hard to follow.","exampleTranslation":"Những quy định hạn chế này rất khó để tuân theo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"royalist":{"definition":"Người theo chủ nghĩa bảo hoàng.","example":"The royalist supported the old traditions.","exampleTranslation":"Người theo chủ nghĩa bảo hoàng đã ủng hộ những truyền thống cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"rule":{"definition":"Thói quen, lệ thường.","example":"As a rule, I prefer coffee over tea.","exampleTranslation":"Theo lệ thường, tôi thích cà phê hơn trà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"ruler":{"definition":"Cái thước kẻ, gậy đo.","example":"She used a ruler to draw a straight line.","exampleTranslation":"Cô ấy đã dùng thước kẻ để vẽ một đường thẳng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"safeguard":{"definition":"Bộ phận an toàn.","example":"This valve is a safeguard for the machine.","exampleTranslation":"Van này là một bộ phận an toàn cho máy móc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"seal":{"definition":"Dấu niêm phong.","example":"Please put a leaden seal on this important box.","exampleTranslation":"Vui lòng đặt một dấu niêm phong chì trên chiếc hộp quan trọng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"signature":{"definition":"Chữ ký.","example":"Please put your signature to this official letter.","exampleTranslation":"Vui lòng ghi chữ ký của bạn vào bức thư chính thức này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"soldier":{"definition":"Lính, quân lính, binh sĩ, quân nhân.","example":"A brave soldier fought for his country's freedom.","exampleTranslation":"Một người lính dũng cảm đã chiến đấu vì tự do của đất nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"strict":{"definition":"Nghiêm ngặt, nghiêm khắc; nghiêm chỉnh.","example":"You must keep strict watch over the children tonight.","exampleTranslation":"Bạn phải canh chừng nghiêm ngặt bọn trẻ tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"subcommittee":{"definition":"Phân ban, tiểu ban (trong một ủy ban).","example":"The subcommittee met to review the plan.","exampleTranslation":"Phân ban đã họp để xem xét kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"summit":{"definition":"Hội nghị thượng đỉnh, hội nghị cấp cao nhất (hội nghị các vị đứng đầu chính phủ); (định ngữ) (thuộc) cấp cao nhất.","example":"The leaders met at the annual summit conference.","exampleTranslation":"Các nhà lãnh đạo đã gặp nhau tại hội nghị thượng đỉnh hàng năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"superpower":{"definition":"Siêu cường (quốc).","example":"The country became a superpower.","exampleTranslation":"Đất nước này đã trở thành một siêu cường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"suppress":{"definition":"Chặn (bệnh); triệt (tiếng ồn).","example":"She tried to suppress her cough in class.","exampleTranslation":"Cô ấy cố gắng triệt tiếng ho của mình trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"supreme":{"definition":"Cuối cùng.","example":"They reached the supreme hour of the ceremony.","exampleTranslation":"Họ đã đến giờ phút cuối cùng của buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"surrender":{"definition":"Giao lại, dâng, nộp (thành trì... để đầu hàng).","example":"They surrender the keys at the front desk.","exampleTranslation":"Họ giao lại chìa khóa tại quầy lễ tân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"government"},"troop":{"definition":"Đoàn, lũ, đàn, đám, bọn, toán.","example":"A troop of children played in the park.","exampleTranslation":"Một toán trẻ em đang chơi trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"unauthorised":{"definition":"Không được phép.","example":"The unauthorised result helped everyone.","exampleTranslation":"Kết quả không được phép đó đã giúp ích cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"unrestricted":{"definition":"Không bị hạn chế.","example":"You have unrestricted access to the reading room.","exampleTranslation":"Bạn có quyền truy cập không bị hạn chế vào phòng đọc sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"government"},"voting":{"definition":"Sự bỏ phiếu, sự bầu cử, sự biểu quyết.","example":"Voting will start at noon today.","exampleTranslation":"Sự bầu cử sẽ bắt đầu vào buổi trưa hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"government"},"crime":{"definition":"Thói quen phạm pháp.","example":"He fell into a crime habit very young.","exampleTranslation":"Anh ấy sa vào thói quen phạm tội từ khi còn rất trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"criminal":{"definition":"Có tội, phạm tội, tội ác.","example":"The police are looking for a dangerous criminal.","exampleTranslation":"Cảnh sát đang truy tìm một tên tội phạm nguy hiểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"criminal"},"offend":{"definition":"Xúc phạm, làm bực mình, làm khó chịu, làm mất lòng, làm tổn thương.","example":"Please do not offend your host with rude comments.","exampleTranslation":"Xin đừng xúc phạm chủ nhà của bạn bằng những lời nhận xét khiếm nhã.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"offend"},"offended":{"definition":"Quá khứ và phân từ quá khứ của offend","example":"He offended her with a careless comment.","exampleTranslation":"Anh ấy đã xúc phạm cô ấy bằng một lời bình luận bất cẩn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"offend"},"offender":{"definition":"Người phạm tội, người phạm lỗi.","example":"The offender apologized for breaking the rule.","exampleTranslation":"Người phạm lỗi đã xin lỗi vì vi phạm quy định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"offend"},"offending":{"definition":"hiện tại phân từ của offend","example":"He is offending his friend with rude words.","exampleTranslation":"Anh ấy đang xúc phạm bạn mình bằng những từ ngữ thô lỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"offend"},"offense":{"definition":"(như) offence.","example":"He felt offense at the rude joke.","exampleTranslation":"Anh ấy cảm thấy bị xúc phạm bởi trò đùa khiếm nhã đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"offense","spellingNote":"British spelling: offence."},"prison":{"definition":"Nhà tù, nhà lao, nhà giam.","example":"The thief was sent to prison for three years.","exampleTranslation":"Tên trộm bị tống giam vào tù trong ba năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"prison"},"prisoner":{"definition":"Người bị giam giữ, người tù; con vật bị nhốt.","example":"The prisoner sat quietly in his cell.","exampleTranslation":"Người tù ngồi lặng lẽ trong phòng giam của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"prison"},"punish":{"definition":"Phạt, trừng phạt, trừng trị.","example":"Schools should punish serious misconduct fairly and consistently.","exampleTranslation":"Nhà trường nên xử phạt hành vi sai trái nghiêm trọng một cách công bằng và nhất quán.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"punish"},"punishable":{"definition":"Có thể bị trừng phạt, trừng phạt, đáng trừng trị.","example":"Lying in class is punishable by school rules.","exampleTranslation":"Nói dối trong lớp là hành vi có thể bị phạt theo quy định của nhà trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"punish"},"punishing":{"definition":"hiện tại phân từ của punish","example":"She was punishing the dog for chewing shoes.","exampleTranslation":"Cô ấy đang trừng phạt con chó vì tội nhai giày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"punish"},"punishment":{"definition":"Sự phạt, sự trừng phạt, sự trừng trị.","example":"The child understood the punishment for breaking rules.","exampleTranslation":"Đứa trẻ đã hiểu hình phạt cho việc vi phạm các quy tắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"punish"},"penalty":{"definition":"hình phạt; tiền phạt","example":"The penalty for his crime was to pay a fine.","exampleTranslation":"Hình phạt cho tội danh của anh ta là phải nộp một khoản tiền phạt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"penalty"},"legal":{"definition":"Pháp luật.","example":"The legal rule protects everyone in the town.","exampleTranslation":"Quy định pháp lý bảo vệ mọi người trong thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"legal"},"legalisation":{"definition":"Sự hợp pháp hoá.","example":"Legalisation of the old record took months.","exampleTranslation":"Việc hợp pháp hóa hồ sơ cũ đã mất nhiều tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legal","spellingNote":"Alternate spelling: legalization."},"legalise":{"definition":"Hợp pháp hoá.","example":"The city will legalise the small market soon.","exampleTranslation":"Thành phố sẽ sớm hợp pháp hóa khu chợ nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"legal","spellingNote":"Alternate spelling: legalize."},"legalism":{"definition":"Sự tuân theo pháp luật.","example":"Her legalism made her follow every small rule.","exampleTranslation":"Chủ nghĩa pháp trị khiến cô ấy tuân thủ từng quy tắc nhỏ nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legal"},"legalist":{"definition":"Người tôn trọng pháp luật, người tuân theo pháp luật.","example":"As a legalist, he always followed the rules.","exampleTranslation":"Là một người theo chủ nghĩa pháp trị, anh ấy luôn tuân thủ các quy tắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legal"},"legalization":{"definition":"Sự hợp pháp hoá.","example":"Legalization made the new shop open without trouble.","exampleTranslation":"Việc hợp pháp hóa đã giúp cửa hàng mới mở cửa mà không gặp trở ngại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legal","spellingNote":"British spelling: legalisation."},"legalize":{"definition":"Hợp pháp hoá.","example":"The city plans to legalize small home shops.","exampleTranslation":"Thành phố có kế hoạch hợp pháp hóa các cửa hàng nhỏ tại gia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"legal","spellingNote":"British spelling: legalise."},"illegal":{"definition":"Không hợp pháp, bất hợp pháp, trái luật.","example":"It is illegal to park your car here.","exampleTranslation":"Đỗ xe ở đây là bất hợp pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"illegal"},"illegalisation":{"definition":"Sự làm cho bất hợp pháp, sự bất hợp pháp hoá.","example":"The illegalisation of the trade surprised everyone.","exampleTranslation":"Việc biến hoạt động giao dịch đó thành bất hợp pháp đã khiến mọi người ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"illegal","spellingNote":"Alternate spelling: illegalization."},"illegalise":{"definition":"Làm thành không hợp pháp.","example":"The city may illegalise that old practice.","exampleTranslation":"Thành phố có thể sẽ ban hành lệnh cấm đối với tập tục cũ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"illegal","spellingNote":"Alternate spelling: illegalize."},"illegalization":{"definition":"Sự làm cho bất hợp pháp, sự bất hợp pháp hoá.","example":"The illegalization of the rule confused many students.","exampleTranslation":"Việc quy định này bị tuyên bố là bất hợp pháp đã làm nhiều sinh viên bối rối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"illegal","spellingNote":"British spelling: illegalisation."},"illegalize":{"definition":"Làm thành không hợp pháp.","example":"The town voted to illegalize the old rule.","exampleTranslation":"Thị trấn đã bỏ phiếu để quy định cũ trở thành bất hợp pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"illegal","spellingNote":"British spelling: illegalise."},"illegally":{"definition":"Bất hợp pháp, trái pháp luật.","example":"She spoke illegally during the meeting.","exampleTranslation":"Cô ấy đã phát biểu trái phép trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"illegal"},"justice":{"definition":"Sự công bằng.","example":"We must act in justice to every person involved.","exampleTranslation":"Chúng ta phải hành động công bằng với mọi người liên quan.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"justice"},"court":{"definition":"Sân nhà.","example":"The children played in the court behind the house.","exampleTranslation":"Những đứa trẻ đã chơi đùa trong khoảng sân sau nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"court"},"courted":{"definition":"Quá khứ và phân từ quá khứ của court","example":"He courted her with flowers and notes.","exampleTranslation":"Anh ấy đã tán tỉnh cô bằng hoa và những lá thư tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"court"},"courtship":{"definition":"Sự ve vãn, sự tán tỉnh, sự tỏ tình, sự tìm hiểu.","example":"Their courtship began with long walks.","exampleTranslation":"Mối tình của họ bắt đầu bằng những buổi đi dạo dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"court"},"judge":{"definition":"Quan toà, thẩm phán.","example":"The judge listened carefully before making a decision.","exampleTranslation":"Vị thẩm phán đã lắng nghe cẩn thận trước khi đưa ra quyết định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"judge"},"judgeship":{"definition":"Chức vị quan toà.","example":"The judgeship required careful and fair decisions.","exampleTranslation":"Chức vụ thẩm phán đòi hỏi những quyết định thận trọng và công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"judge"},"police":{"definition":"Cảnh sát, công an (lực lượng, tổ chức... ).","example":"The police arrived at the scene quickly.","exampleTranslation":"Cảnh sát đã đến hiện trường một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"police"},"theft":{"definition":"Sự ăn trộm, sự trộm cắp.","example":"The police are investigating the theft of jewelry.","exampleTranslation":"Cảnh sát đang điều tra vụ trộm đồ trang sức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"theft"},"fraud":{"definition":"Sự gian lận, sự gian trá; sự lừa lọc, sự lừa gạt.","example":"He lost his savings to a clever fraud.","exampleTranslation":"Anh ấy đã mất số tiền tiết kiệm của mình vào một vụ lừa đảo tinh vi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"fraud"},"violence":{"definition":"Bạo lực, sự cưỡng bức.","example":"We must never use violence to solve problems.","exampleTranslation":"Chúng ta không bao giờ được dùng bạo lực để giải quyết vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"violence"},"violate":{"definition":"Phá rối, làm mất (giấc ngủ, sự yên tĩnh... ).","example":"Please do not violate my peace and quiet.","exampleTranslation":"Làm ơn đừng làm phiền sự bình yên và tĩnh lặng của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"violate"},"victim":{"definition":"Vật bị hy sinh, người bị chết vì, nạn nhân.","example":"He fell victim to a very common cold.","exampleTranslation":"Anh ấy đã trở thành nạn nhân của một trận cảm lạnh thông thường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"victim"},"victimisation":{"definition":"Sự bắt nạt, sự trù dập; sự trêu chọc.","example":"The report described years of victimisation at school.","exampleTranslation":"Báo cáo đã mô tả nhiều năm bị ngược đãi ở trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"victim","spellingNote":"Alternate spelling: victimization."},"victimise":{"definition":"Đối xử bất công hoặc gây hại cho ai, biến họ thành nạn nhân.","example":"The policy could victimise low-income families who rely on public transport.","exampleTranslation":"Chính sách này có thể khiến các gia đình thu nhập thấp phụ thuộc vào phương tiện công cộng trở thành nạn nhân.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"victim","spellingNote":"Alternate spelling: victimize."},"victimization":{"definition":"Sự lừa bịp.","example":"The scam caused real victimization for many families.","exampleTranslation":"Vụ lừa đảo đã gây ra tổn hại thực sự cho nhiều gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"victim","spellingNote":"British spelling: victimisation."},"victimize":{"definition":"Đối xử bất công hoặc gây hại cho ai, biến họ thành nạn nhân.","example":"The policy could victimize low-income families who rely on public transport.","exampleTranslation":"Chính sách này có thể khiến các gia đình thu nhập thấp phụ thuộc vào phương tiện công cộng trở thành nạn nhân.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"victim","spellingNote":"British spelling: victimise."},"security":{"definition":"an ninh, an toàn","example":"Traditionally, Japanese workers have had good job security. In fact, they usually had a job for life.","exampleTranslation":"Theo truyền thống, người lao động Nhật Bản có sự bảo đảm việc làm tốt. Trên thực tế, họ thường có công việc trọn đời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"security"},"corrupt":{"definition":"Bẩn (không khí... ).","example":"The room had corrupt air after the fire.","exampleTranslation":"Căn phòng có không khí độc hại sau vụ hỏa hoạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"corrupt"},"corrupted":{"definition":"Quá khứ và phân từ quá khứ của corrupt","example":"The file corrupted after the power loss.","exampleTranslation":"Tệp tin đã bị hỏng sau sự cố mất điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"corrupt"},"corruptible":{"definition":"Dễ thối nát.","example":"The old wood became corruptible in the rain.","exampleTranslation":"Gỗ cũ trở nên dễ mục nát dưới mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"corrupt"},"corruption":{"definition":"Sự mục nát, sự thối nát.","example":"The fruit showed corruption after two hot days.","exampleTranslation":"Trái cây đã xuất hiện dấu hiệu hư thối sau hai ngày nắng nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"corrupt"},"corruptly":{"definition":"Một cách tham nhũng hoặc bất chính, thường để trục lợi.","example":"The official acted corruptly by accepting payments from a contractor.","exampleTranslation":"Viên chức đã hành động tham nhũng khi nhận tiền từ một nhà thầu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"corrupt"},"corruptness":{"definition":"Sự thối nát, sự đồi bại.","example":"The corruptness of the system shocked the public.","exampleTranslation":"Sự suy đồi của hệ thống đã gây chấn động dư luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"corrupt"},"detained":{"definition":"Quá khứ và phân từ quá khứ của detain","example":"Police detained him for a short time.","exampleTranslation":"Cảnh sát đã tạm giữ anh ta trong một thời gian ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"detain"},"detainer":{"definition":"Sự cầm giữ (tài sản, đồ vật... ).","example":"The detainer on the box was missing.","exampleTranslation":"Chốt giữ trên chiếc hộp đã bị mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"detain"},"detainment":{"definition":"Sự giam giữ, sự cầm tù.","example":"Their detainment at the border lasted two hours.","exampleTranslation":"Việc họ bị giữ lại tại biên giới kéo dài hai tiếng đồng hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"detain"},"arrest":{"definition":"Sự hoãn thi hành.","example":"There was a brief arrest of judgement today.","exampleTranslation":"Hôm nay đã có một sự tạm hoãn phán quyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"arrest"},"arrested":{"definition":"Quá khứ và phân từ quá khứ của arrest","example":"He was arrested for shoplifting.","exampleTranslation":"Anh ta đã bị bắt vì tội ăn cắp vặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"arrest"},"arrester":{"definition":"Người bắt giữ.","example":"The arrester stopped the man at the gate.","exampleTranslation":"Người bắt giữ đã chặn người đàn ông đó lại ở cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"arrest"},"arresting":{"definition":"Làm ngừng lại, làm hãm lại.","example":"They installed a new arresting device on the gate.","exampleTranslation":"Họ đã lắp đặt một thiết bị chặn mới ở cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"arrest"},"murder":{"definition":"Làm hư, làm hỏng, làm sai (vì dốt nát, kém cỏi).","example":"Please do not murder a song with bad notes.","exampleTranslation":"Xin đừng làm hỏng bài hát bằng những nốt nhạc sai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"murder"},"murdered":{"definition":"Quá khứ và phân từ quá khứ của murder","example":"They murdered the data carefully.","exampleTranslation":"Họ đã phá hỏng dữ liệu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"murder"},"murderer":{"definition":"Kẻ giết người.","example":"The murderer left the room in silence.","exampleTranslation":"Kẻ sát nhân rời khỏi phòng trong im lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"murder"},"murdering":{"definition":"Sát hại; hành động giết người một cách trái pháp luật.","example":"He was arrested for murdering a local shopkeeper.","exampleTranslation":"Anh ta bị bắt vì sát hại một chủ cửa hàng địa phương.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"murder"},"murderous":{"definition":"Giết người, sát hại, tàn sát.","example":"He had a murderous look in his eyes.","exampleTranslation":"Ánh mắt của anh ta chứa đầy sát khí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"murder"},"abuse":{"definition":"Sự lạm dụng, sự lộng hành.","example":"We must stop the abuse of power in office.","exampleTranslation":"Chúng ta phải ngăn chặn sự lạm dụng quyền lực trong công sở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"accuse":{"definition":"Cáo buộc, buộc tội, kết tội; tố cáo.","example":"Did you accuse him of stealing the money?","exampleTranslation":"Bạn đã cáo buộc anh ấy ăn cắp tiền phải không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"alarm":{"definition":"Sự báo động, sự báo nguy.","example":"We heard the loud air-raid alarm last night.","exampleTranslation":"Chúng tôi đã nghe thấy tiếng báo động cuộc không kích lớn vào đêm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"alert":{"definition":"Sự báo động, sự báo nguy.","example":"The police put the town on high alert today.","exampleTranslation":"Cảnh sát đã đặt thị trấn vào tình trạng báo động cao hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"appeal":{"definition":"Lời thỉnh cầu, sự cầu khẩn.","example":"He looked at her with a look of appeal.","exampleTranslation":"Anh ấy nhìn cô ấy với một lời thỉnh cầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"assassinate":{"definition":"Ám sát.","example":"They plan to assassinate the leader at night.","exampleTranslation":"Họ lập kế hoạch ám sát nhà lãnh đạo vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"attack":{"definition":"Sự tấn công, sự công kích.","example":"The soldiers launched an attack on the fort.","exampleTranslation":"Những người lính đã phát động một sự tấn công vào pháo đài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"capture":{"definition":"Sự bắt giữ, sự bị bắt.","example":"The capture of the thief was quick.","exampleTranslation":"Sự bắt giữ tên trộm diễn ra rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"conspiracy":{"definition":"Âm mưu.","example":"The police discovered they were in the conspiracy together.","exampleTranslation":"Cảnh sát đã phát hiện họ cùng tham gia vào âm mưu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"conspirator":{"definition":"Người âm mưu.","example":"The conspirator planned the secret meeting.","exampleTranslation":"Người âm mưu đã lên kế hoạch cho cuộc họp bí mật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"counterfeit":{"definition":"Giả, giả mạo.","example":"Be careful not to use counterfeit money here.","exampleTranslation":"Hãy cẩn thận đừng sử dụng tiền giả ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"detective":{"definition":"Để dò ra, để tìm ra, để khám phá ra, để phát hiện ra; trinh thám.","example":"I enjoyed reading a very exciting detective novel.","exampleTranslation":"Tôi rất thích đọc một tiểu thuyết trinh thám rất thú vị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"deter":{"definition":"Ngăn cản, ngăn chặn, cản trở; làm nản lòng, làm nhụt chí, làm thoái chí.","example":"High prices deter many people from buying cars.","exampleTranslation":"Giá cao ngăn cản nhiều người mua xe hơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"disorderly":{"definition":"Làm mất trật tự xã hội, gây náo loạn; bừa bãi phóng đãng.","example":"He was known as a very disorderly person.","exampleTranslation":"Anh ấy nổi tiếng là một người sống bừa bãi phóng đãng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"forbid":{"definition":"Cấm, ngăn cấm.","example":"The law will forbid people from smoking here.","exampleTranslation":"Luật sẽ cấm mọi người hút thuốc ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"guilty":{"definition":"Có tội, phạm tội, tội lỗi.","example":"The guilty option was chosen.","exampleTranslation":"Lựa chọn có tội đã được chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"hoodwink":{"definition":"Bịt mắt, băng mắt lại.","example":"The nurse will hoodwink the patient before surgery.","exampleTranslation":"Y tá sẽ bịt mắt bệnh nhân trước khi phẫu thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"immoral":{"definition":"Xấu xa, phóng đãng.","example":"It was immoral to cheat on the test.","exampleTranslation":"Thật xấu xa khi gian lận trong bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"improper":{"definition":"Sai, không đúng.","example":"Improper treatment of disease may cause serious death.","exampleTranslation":"Việc điều trị sai cách đối với căn bệnh có thể gây tử vong nghiêm trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"inmate":{"definition":"Người ở cùng (trong một nhà...).","example":"Our new inmate shares the apartment with us.","exampleTranslation":"Người ở cùng mới của chúng tôi chia sẻ căn hộ với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"innocence":{"definition":"Tính vô tội, tính không có tội.","example":"Her innocence was clear from her calm face.","exampleTranslation":"Tính vô tội của cô ấy rõ ràng từ khuôn mặt bình thản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"innocent":{"definition":"Không có hại, không hại.","example":"This medicine is innocent and easy to use.","exampleTranslation":"Loại thuốc này không có hại và dễ sử dụng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"intruder":{"definition":"Người xâm phạm, người xâm nhập (đời sống riêng tư của ai... ).","example":"She felt like an intruder in the chat.","exampleTranslation":"Cô ấy cảm thấy như một người xâm nhập trong cuộc trò chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"intrusion":{"definition":"Sự ấn bừa, sự tống ấn, sự đưa bừa; sự bị ấn bừa, sự bị đưa bừa.","example":"The loud joke felt like an intrusion.","exampleTranslation":"Câu nói đùa lớn tiếng cảm giác như một sự ấn bừa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"jail":{"definition":"Tù, ngục, nhà lao.","example":"He spent a night in jail.","exampleTranslation":"Anh ấy đã dành một đêm trong tù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"judgment":{"definition":"Sự xét xử.","example":"The judge will pass judgment on the defendant today.","exampleTranslation":"Thẩm phán sẽ đưa ra sự xét xử đối với bị cáo hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"juvenile":{"definition":"Thanh thiếu niên; có tính chất thanh thiếu niên; hợp với thanh thiếu niên.","example":"The book is suitable for juvenile readers.","exampleTranslation":"Cuốn sách phù hợp với độc giả thanh thiếu niên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"killer":{"definition":"Dụng cụ giết thịt (súc vật).","example":"The butcher used a killer for the animal.","exampleTranslation":"Người bán thịt đã sử dụng một dụng cụ giết thịt cho con vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"lawyer":{"definition":"Luật sư.","example":"The lawyer gave clear advice about the contract.","exampleTranslation":"Luật sư đã đưa ra lời khuyên rõ ràng về hợp đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"legitimate":{"definition":"Hợp pháp.","example":"Is this a legitimate child of the wealthy couple?","exampleTranslation":"Đây có phải là đứa con hợp pháp của cặp vợ chồng giàu có không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"notorious":{"definition":"Khét tiếng","example":"The old house is notorious for bad plumbing.","exampleTranslation":"Ngôi nhà cũ đó khét tiếng về hệ thống ống nước tệ hại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"notoriously":{"definition":"Lừng danh, khét tiếng.","example":"They worked notoriously all day.","exampleTranslation":"Họ làm việc lừng danh cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"crime"},"offensive":{"definition":"Sự tấn công; cuộc tấn công; thế tấn công.","example":"Our team decided to take the offensive in the game.","exampleTranslation":"Đội của chúng tôi quyết định chiếm thế tấn công trong trò chơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"outlaw":{"definition":"Người sống ngoài vòng pháp luật, người không được luật pháp che chở.","example":"The outlaw hid in the hills for years.","exampleTranslation":"Người sống ngoài vòng pháp luật đã trốn trong các ngọn đồi nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"patrol":{"definition":"Đội tuần tra; việc tuần tra.","example":"The police patrol the streets during the night.","exampleTranslation":"Cảnh sát tuần tra trên các con phố suốt đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"piracy":{"definition":"Nghề cướp biển, nghề ăn cướp.","example":"Piracy is a serious crime on the sea.","exampleTranslation":"Nghề cướp biển là một tội ác nghiêm trọng trên biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"pirate":{"definition":"Người phát thanh đi một bài (một chương trình) không được phép chính thức; ((thường) định ngữ) không được phép chính thức.","example":"The pirate broadcast was shut down by the police.","exampleTranslation":"Chương trình phát thanh không chính thức đã bị cảnh sát đóng cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"poacher":{"definition":"Xoong chần trứng.","example":"The poacher is warming water for eggs.","exampleTranslation":"Người chuyên nấu trứng đang đun nóng nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"poach":{"definition":"Săn trộm, câu trộm.","example":"They tried to poach hares in the forest.","exampleTranslation":"Họ cố gắng săn trộm thỏ trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"proceeding":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của proceed.","example":"We are proceeding with the plan tomorrow.","exampleTranslation":"Chúng tôi sẽ tiến hành kế hoạch vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"prohibit":{"definition":"Cấm, ngăn cấm, cấm chỉ.","example":"The law will prohibit smoking in all public parks.","exampleTranslation":"Luật sẽ cấm hút thuốc ở tất cả các công viên công cộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"rampage":{"definition":"Sự giận dữ; cơn giận điên lên, cơn thịnh nộ.","example":"The angry crowd went on a wild rampage.","exampleTranslation":"Đám đông giận dữ đã nổi cơn thịnh nộ dữ dội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"rape":{"definition":"Sự hâm hiếp, sự cưỡng dâm.","example":"He kept the rape on the desk.","exampleTranslation":"Anh ấy đã giữ cây cải dầu trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"seize":{"definition":"Chiếm đoạt, cướp lấy, nắm lấy.","example":"You must seize the opportunity while it lasts.","exampleTranslation":"Bạn phải nắm lấy cơ hội khi nó còn kéo dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"sharper":{"definition":"Người lừa đảo.","example":"The sharper fooled the tourist with a trick.","exampleTranslation":"Kẻ lừa đảo đã đánh lừa khách du lịch bằng một trò bịp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"shoot":{"definition":"Ném, phóng, quăng, liệng, đổ.","example":"Do not shoot the fishing net into water.","exampleTranslation":"Đừng ném lưới đánh cá xuống nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"shooter":{"definition":"Người bắn súng.","example":"The shooter hit the target from far away.","exampleTranslation":"Người bắn súng đã trúng mục tiêu từ rất xa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"stealth":{"definition":"Giấu giếm, lén lút.","example":"They entered the room with stealth.","exampleTranslation":"Họ bước vào phòng với sự giấu giếm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"sued":{"definition":"Quá khứ và phân từ quá khứ của sue","example":"She sued after the contract failed.","exampleTranslation":"Cô ấy đã kiện sau khi hợp đồng thất bại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"surveillance":{"definition":"Sự giám sát.","example":"The suspect is currently under constant surveillance.","exampleTranslation":"Nghi phạm hiện đang bị giám sát liên tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"suspect":{"definition":"Nghi, ngờ, nghi ngờ, hoài nghi.","example":"I suspect that he is hiding something from us.","exampleTranslation":"Tôi nghi ngờ rằng anh ấy đang giấu chúng tôi điều gì đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"suspicion":{"definition":"Sự ngờ, sự nghi ngờ, sự ngờ vực.","example":"His honesty is above any suspicion at all.","exampleTranslation":"Sự trung thực của anh ấy vượt trên mọi sự ngờ vực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"swear":{"definition":"Lời thề.","example":"I made a swear to finish my work.","exampleTranslation":"Tôi đã đưa ra một lời thề hoàn thành công việc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"swindle":{"definition":"Lừa, bịp.","example":"He tried to swindle money from the old man.","exampleTranslation":"Anh ta đã cố gắng lừa tiền từ ông lão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"terror":{"definition":"Sự kinh hãi, sự khiếp sợ.","example":"She lived in terror during the storm.","exampleTranslation":"Cô ấy đã sống trong sự kinh hãi trong suốt cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"testify":{"definition":"Khai, làm chứng, chứng nhân.","example":"He had to testify against his former partner.","exampleTranslation":"Anh ấy phải khai làm chứng chống lại cộng sự cũ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"thieves":{"definition":"Kẻ trộm, kẻ cắp.","example":"They shouted thieves when they saw the robbery.","exampleTranslation":"Họ hét lên kẻ trộm khi họ nhìn thấy vụ cướp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"threat":{"definition":"Sự đe doạ.","example":"There is a threat of heavy snow tonight.","exampleTranslation":"Có một sự đe doạ về tuyết dày đêm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"threaten":{"definition":"Doạ, đe doạ, hăm doạ ((nghĩa đen) & (nghĩa bóng)).","example":"Do not threaten others when you are angry.","exampleTranslation":"Đừng doạ người khác khi bạn đang tức giận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"torture":{"definition":"Làm biến chất, làm biến dạng; làm sai lạc ý nghĩa, xuyên tạc.","example":"He did not torture the meaning of the text.","exampleTranslation":"Anh ấy không xuyên tạc ý nghĩa của văn bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"crime"},"trial":{"definition":"Sự thử.","example":"She decided to give the new recipe a trial.","exampleTranslation":"Cô ấy quyết định thử công thức nấu ăn mới một sự thử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"undetected":{"definition":"Không bị phát hiện, không bị khám phá ra.","example":"The mistake went undetected for several weeks.","exampleTranslation":"Lỗi sai đó đã không bị phát hiện trong vài tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"unlawful":{"definition":"Không hợp pháp, phi pháp, bất chính.","example":"The company was fined for an unlawful union.","exampleTranslation":"Công ty đã bị phạt vì một liên minh không hợp pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"unsafe":{"definition":"Không an toàn, không chắc chắn; nguy hiểm.","example":"The floor was unsafe after the rain.","exampleTranslation":"Sàn nhà không an toàn sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"untraceable":{"definition":"Không khám phá ra được, không thể phát hiện ra được.","example":"The missing note was untraceable.","exampleTranslation":"Ghi chú bị mất không thể khám phá ra được.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"violent":{"definition":"Mạnh mẽ, dữ dội, mãnh liệt.","example":"A violent wind blew down several old trees.","exampleTranslation":"Một trận gió mạnh mẽ đã thổi đổ nhiều cây già.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"crime"},"weapon":{"definition":"Vũ khí ((nghĩa đen) & (nghĩa bóng)).","example":"Knowledge is the most powerful weapon of all.","exampleTranslation":"Kiến thức là vũ khí mạnh mẽ nhất trong tất cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"witness":{"definition":"Sự làm chứng.","example":"The judge called him to witness the truth.","exampleTranslation":"Thẩm phán đã gọi anh ấy đến làm chứng cho sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crime"},"science":{"definition":"Ngành khoa học, môn khoa học.","example":"We are studying the science of optics now.","exampleTranslation":"Chúng tôi đang học môn khoa học quang học bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"scientist":{"definition":"Người theo thuyết khoa học vạn năng.","example":"He sounded like a scientist about every topic.","exampleTranslation":"Anh ấy nói chuyện về mọi chủ đề cứ như một nhà khoa học vậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"scientist"},"research":{"definition":"Sự nghiên cứu.","example":"The university funds important research on climate change.","exampleTranslation":"Trường đại học tài trợ cho các nghiên cứu quan trọng về biến đổi khí hậu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"research"},"researcher":{"definition":"Nhà nghiên cứu.","example":"The researcher studied birds in the forest.","exampleTranslation":"Nhà nghiên cứu đã quan sát các loài chim trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"research"},"experiment":{"definition":"Thí nghiệm, thử.","example":"They experiment with new colors.","exampleTranslation":"Họ thử nghiệm với các màu sắc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"experiment"},"experimental":{"definition":"Thực nghiệm.","example":"We are conducting an experimental study on plants.","exampleTranslation":"Chúng tôi đang thực hiện một nghiên cứu thực nghiệm trên thực vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"experiment"},"experimentation":{"definition":"Sự thí nghiệm, sự thử.","example":"She saw the experimentation yesterday.","exampleTranslation":"Cô ấy đã chứng kiến quá trình thử nghiệm vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"experiment"},"experimented":{"definition":"Quá khứ và phân từ quá khứ của experiment","example":"They experimented with colors on the wall.","exampleTranslation":"Họ đã thử nghiệm với các màu sắc trên tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"experiment"},"experimenter":{"definition":"Người thí nghiệm, người thử.","example":"The experimenter tested a new light idea.","exampleTranslation":"Người thử nghiệm đã kiểm tra một ý tưởng ánh sáng mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"experiment"},"analyser":{"definition":"; (hoá học) dụng cụ phân tích, máy phân tích.","example":"The scientist used a complex analyser for the test.","exampleTranslation":"Nhà khoa học đã sử dụng một thiết bị phân tích phức tạp cho bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"analys"},"analyses":{"definition":"Động từ chia ở ngôi thứ ba số ít của analyse","example":"She analyses the data before dinner.","exampleTranslation":"Cô ấy phân tích các dữ liệu trước bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"analys"},"analysing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của analyse.","example":"She is analysing the results after class.","exampleTranslation":"Cô ấy đang phân tích các kết quả sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"analys"},"evidence":{"definition":"Tính hiển nhiên; tính rõ ràng, tính rõ rệt.","example":"His guilt was in evidence during the trial.","exampleTranslation":"Bằng chứng về tội lỗi của anh ta đã được đưa ra trong phiên tòa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"evidence"},"study":{"definition":"Đối tượng nghiên cứu.","example":"Rainfall is the main study in this report.","exampleTranslation":"Lượng mưa là nội dung nghiên cứu chính trong bản báo cáo này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"study"},"discovery":{"definition":"Sự khám phá ra, sự tìm ra, sự phát hiện ra.","example":"The discovery changed how we saw the town.","exampleTranslation":"Khám phá đó đã làm thay đổi cách chúng tôi nhìn nhận thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"discovery"},"discoverable":{"definition":"Có thể khám phá ra, có thể tìm ra, có thể phát hiện ra; có thể nhận ra.","example":"The clue is discoverable in the old file.","exampleTranslation":"Manh mối có thể được tìm thấy trong tệp hồ sơ cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"discover"},"discovered":{"definition":"Quá khứ và phân từ quá khứ của discover","example":"We discovered a quiet path by the lake.","exampleTranslation":"Chúng tôi đã tìm ra một con đường yên tĩnh cạnh hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"discover"},"discoverer":{"definition":"Người khám phá ra, người tìm ra, người phát hiện ra.","example":"The discoverer found a cave behind the trees.","exampleTranslation":"Người khám phá đã tìm thấy một cái hang phía sau những cái cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"discover"},"discovering":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của discover.","example":"Discovering new places makes her happy.","exampleTranslation":"Khám phá những địa điểm mới làm cho cô ấy cảm thấy hạnh phúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"discover"},"invent":{"definition":"Bịa đặt (chuyện... ).","example":"He tried to invent an excuse for being late.","exampleTranslation":"Anh ấy đã cố gắng bịa ra một cái cớ vì đến muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"invent"},"inventable":{"definition":"Có thể bịa đặt.","example":"That rumor was inventable and easy to reject.","exampleTranslation":"Lời đồn đó là thứ có thể bịa đặt ra và dễ dàng bác bỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"invent"},"invented":{"definition":"Quá khứ và phân từ quá khứ của invent","example":"She invented a simple game.","exampleTranslation":"Cô ấy đã tạo ra một trò chơi đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"invent"},"inventible":{"definition":"Có thể phát minh, có thể sáng chế.","example":"This idea is inventible with a little skill.","exampleTranslation":"Ý tưởng này có thể thực hiện được với một chút kỹ năng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"invent"},"invention":{"definition":"Sự phát minh, sự sáng chế; vật phát minh, vật sáng chế; sáng kiến.","example":"That simple invention saved a lot of time.","exampleTranslation":"Phát minh đơn giản đó đã tiết kiệm được rất nhiều thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"invent"},"inventive":{"definition":"Có tài phát minh, có tài sáng chế; có óc sáng tạo; đầy sáng tạo.","example":"The inventive child built a clever toy.","exampleTranslation":"Đứa trẻ sáng tạo đó đã tự làm một món đồ chơi thông minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"invent"},"inventor":{"definition":"Người phát minh, người sáng chế, người sáng tạo.","example":"The inventor built a tool for easier cooking.","exampleTranslation":"Nhà phát minh đã chế tạo một công cụ để nấu nướng dễ dàng hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"invent"},"inventory":{"definition":"Sự kiểm kê; nằng kiểm kê; (từ Mỹ, nghĩa Mỹ) hàng hoá tồn kho (của một nhà buôn).","example":"We checked the inventory before opening the shop.","exampleTranslation":"Chúng tôi đã kiểm kê hàng hóa trước khi mở cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"invent"},"innovations":{"definition":"Phát kiến; sáng kiến.","example":"The team celebrated several innovations this year.","exampleTranslation":"Nhóm đã ăn mừng một số đổi mới trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"innovation"},"laboratory":{"definition":"Phòng thí nghiệm; phòng pha chế.","example":"The laboratory smelled of clean glass and soap.","exampleTranslation":"Phòng thí nghiệm có mùi thủy tinh sạch và xà phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"laboratory"},"technology":{"definition":"Kỹ thuật; kỹ thuật học.","example":"Technology changes the way we study.","exampleTranslation":"Công nghệ làm thay đổi cách chúng ta học tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"technology"},"biology":{"definition":"Sinh vật học.","example":"We learned about cells in biology class.","exampleTranslation":"Chúng tôi đã học về tế bào trong lớp sinh học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"chemistry":{"definition":"Ngành hoá học; môn hoá học, hoá học.","example":"Chemistry is my favorite subject in high school.","exampleTranslation":"Hóa học là môn học yêu thích của tôi ở trường trung học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"chemistry"},"physics":{"definition":"Vật lý học.","example":"Physics helps us understand motion and heat.","exampleTranslation":"Vật lý giúp chúng ta hiểu về chuyển động và nhiệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"physics"},"scientific":{"definition":"Khoa học; có hệ thống; chính xác.","example":"We need to use scientific methods for this experiment.","exampleTranslation":"Chúng ta cần sử dụng các phương pháp khoa học cho thí nghiệm này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"scientific"},"observation":{"definition":"Sự quan sát, sự để ý, sự chú ý, sự theo dõi.","example":"His observation of the birds was very detailed and accurate.","exampleTranslation":"Sự quan sát của anh ấy về các loài chim rất chi tiết và chính xác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"observation"},"observational":{"definition":"Sự quan sát, (thuộc) sự theo dõi.","example":"The observational notes helped the class learn.","exampleTranslation":"Những ghi chú mang tính quan sát đã giúp cả lớp học tập tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"observation"},"theory":{"definition":"Thuyết, học thuyết.","example":"Many people study Darwin's theory of evolution.","exampleTranslation":"Nhiều người nghiên cứu thuyết tiến hóa của Darwin.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"theory"},"method":{"definition":"Thứ tự; hệ thống.","example":"She follows a very specific method for cooking.","exampleTranslation":"Cô ấy tuân theo một phương pháp rất cụ thể để nấu ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"method"},"methodic":{"definition":"Như methodical.","example":"Her methodic work finished on time.","exampleTranslation":"Công việc có phương pháp của cô ấy đã hoàn thành đúng hạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"method"},"methodical":{"definition":"Có thứ tự; ngăn nắp.","example":"He cleaned the room in a methodical way.","exampleTranslation":"Anh ấy đã dọn dẹp căn phòng một cách ngăn nắp, có phương pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"method"},"methodist":{"definition":"Người theo hội Giám lý.","example":"The methodist sang with the local choir.","exampleTranslation":"Người tín hữu Giám lý đã hát cùng với dàn hợp xướng địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"method"},"accuracy":{"definition":"Sự đúng đắn, sự chính xác; độ chính xác.","example":"We must check the accuracy of these figures.","exampleTranslation":"Chúng ta phải kiểm tra sự chính xác của những con số này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"accurate":{"definition":"Đúng đắn, chính xác, xác đáng.","example":"Please provide an accurate description of the scene.","exampleTranslation":"Vui lòng cung cấp một mô tả chính xác về hiện trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"accurately":{"definition":"Đúng đắn, chính xác, xác đáng.","example":"The team finished accurately and left.","exampleTranslation":"Đội đã hoàn thành một cách chính xác rồi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"science"},"aeronautical":{"definition":"Hàng không.","example":"He took an aeronautical class this term.","exampleTranslation":"Anh ấy đã tham gia một lớp học hàng không trong kỳ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"almanac":{"definition":"Niên lịch, niên giám.","example":"I marked the date in my almanac.","exampleTranslation":"Tôi đã đánh dấu ngày vào trong niên lịch của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"amplitude":{"definition":"Độ rộng, độ lớn.","example":"The river's amplitude was wide after the storm.","exampleTranslation":"Độ rộng của dòng sông đã trở nên lớn sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"angle":{"definition":"Quan điểm, khía cạnh.","example":"We need to look at this problem from a different angle.","exampleTranslation":"Chúng ta cần nhìn vấn đề này từ một quan điểm khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"angular":{"definition":"Có góc, có góc cạnh.","example":"The angular stones made the path hard to walk.","exampleTranslation":"Những viên đá có góc cạnh làm cho con đường khó đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"apparatus":{"definition":"Đồ dùng, dụng cụ.","example":"They bought new fishing apparatus for the trip.","exampleTranslation":"Họ đã mua dụng cụ câu cá mới cho chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"approximate":{"definition":"Xấp xỉ, gần đúng.","example":"Can you give me an approximate calculation of costs?","exampleTranslation":"Bạn có thể cho tôi một sự tính toán xấp xỉ về chi phí không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"approximately":{"definition":"xấp xỉ; khoảng chừng","example":"Approximately $150 million is to be spent on improvements.","exampleTranslation":"Xấp xỉ 150 triệu đô la sẽ được chi cho các cải tiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"science"},"approximation":{"definition":"Sự xấp xỉ, sự gần đúng.","example":"This is only an approximation of the truth.","exampleTranslation":"Đây chỉ là một sự xấp xỉ của sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"balance":{"definition":"Cái cân.","example":"She used a precision balance to weigh gold.","exampleTranslation":"Cô ấy đã dùng cái cân chính xác để cân vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"baseline":{"definition":"Đường gốc, đường không; đường quét.","example":"We set a new baseline for the test.","exampleTranslation":"Chúng tôi đặt đường gốc mới cho bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"beaker":{"definition":"Cái cốc vại, cái chén tống.","example":"He poured the soup into a beaker.","exampleTranslation":"Anh ấy rót súp vào một cái cốc vại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"breakthrough":{"definition":"Sự chọc thủng phòng tuyến.","example":"Her idea was a breakthrough for the team.","exampleTranslation":"Ý tưởng của cô ấy là một sự chọc thủng phòng tuyến cho cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"capacity":{"definition":"Năng lực khả năng; khả năng tiếp thu, khả năng thu nhận.","example":"This student has a mind of great capacity.","exampleTranslation":"Học sinh này có một trí tuệ với khả năng thu nhận lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"catalyst":{"definition":"Vật xúc tác, chất xúc tác.","example":"A catalyst can speed up many reactions.","exampleTranslation":"Chất xúc tác có thể tăng tốc nhiều phản ứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"centimetre":{"definition":"Xentimet.","example":"The gap was only one centimetre wide.","exampleTranslation":"Khe hở chỉ rộng một xentimet.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"chemist":{"definition":"Nhà hóa học.","example":"The chemist mixed two liquids in a tube.","exampleTranslation":"Nhà hóa học đã trộn hai chất lỏng vào một ống nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"condition":{"definition":"Điều kiện.","example":"You can go out on condition that you finish your homework.","exampleTranslation":"Bạn có thể đi ra ngoài với điều kiện là bạn hoàn thành bài tập về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"conductivity":{"definition":"Tính dẫn.","example":"A conductivity helped the team.","exampleTranslation":"Tính dẫn đã giúp ích cho cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"constant":{"definition":"Kiên định, trung kiên; trung thành, chung thuỷ.","example":"He remained constant to his principles throughout his life.","exampleTranslation":"Anh ấy vẫn kiên định với các nguyên tắc của mình trong suốt cuộc đời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"constantly":{"definition":"; (vật lý) hằng số.","example":"The atomic constantly determines stability.","exampleTranslation":"Hằng số nguyên tử liên tục xác định sự ổn định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"conversion":{"definition":"Đổi, chuyển hoán/đổi, biến đổi.","example":"The conversion from inches to centimeters was easy.","exampleTranslation":"Việc chuyển đổi từ inch sang centimet rất dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"coordinate":{"definition":"Tọa độ.","example":"Enter your coordinate in the box.","exampleTranslation":"Nhập tọa độ của bạn vào ô đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"coordination":{"definition":"sự phối hợp; khả năng phối hợp","example":"Young children lack the coordination to walk or even to pick up small objects.","exampleTranslation":"Trẻ nhỏ thiếu khả năng phối hợp để đi bộ hoặc thậm chí nhặt các vật nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"science"},"cubic":{"definition":"Bậc ba.","example":"The student solved a complex cubic equation quickly.","exampleTranslation":"Học sinh đã giải một phương trình bậc ba phức tạp một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"current":{"definition":"Dòng (nước); luồng (gió, không khí); (điện học) dòng điện.","example":"The river has a very strong current today.","exampleTranslation":"Dòng sông hôm nay có một dòng nước rất mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"curve":{"definition":"Đường cong, đường vòng, chỗ quanh co.","example":"The road follows a long curve toward the sea.","exampleTranslation":"Con đường theo một đường vòng dài hướng về phía biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"cycle":{"definition":"Chu kỳ, chu trình.","example":"The water follows a natural cycle every year.","exampleTranslation":"Nước theo một chu kỳ tự nhiên hàng năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"cylinder":{"definition":"Trụ, hình trụ.","example":"The candle sat inside a glass cylinder.","exampleTranslation":"Cây nến đặt bên trong một hình trụ bằng thủy tinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"cylindrical":{"definition":"Hình trụ.","example":"The vase has a cylindrical shape.","exampleTranslation":"Cái bình có hình trụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"decay":{"definition":"Suy tàn, suy sụp, sa sút (quốc gia, gia đình... ).","example":"The city began to decay after the storm.","exampleTranslation":"Thành phố bắt đầu suy tàn sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"decibel":{"definition":"Đêxiben (dB).","example":"The noise measured fifty decibel on the meter.","exampleTranslation":"Tiếng ồn đo được năm mươi đêxiben trên máy đo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"decrease":{"definition":"Sự giảm đi, sự giảm sút.","example":"There was a sharp decrease in the population.","exampleTranslation":"Có một sự giảm đi đột ngột trong dân số.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"defect":{"definition":"Thiếu sót, sai sót, nhược điểm; tật xấu, khuyết điểm.","example":"A small defect made the toy stop working.","exampleTranslation":"Một thiếu sót nhỏ làm cho món đồ chơi ngừng hoạt động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"denominator":{"definition":"Mẫu số; mẫu thức.","example":"Three is the denominator in this fraction.","exampleTranslation":"Ba là mẫu số trong phân số này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"dense":{"definition":"Đông đúc; rậm rạp.","example":"We walked through a dense forest in the morning.","exampleTranslation":"Chúng tôi đi bộ qua một khu rừng rậm rạp vào buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"densely":{"definition":"Dày đặc, rậm rạp.","example":"He moved densely through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách đông đúc qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"science"},"density":{"definition":"Độ dày, mật độ, độ chặt.","example":"The scientist measured the molecular density of the liquid.","exampleTranslation":"Nhà khoa học đã đo mật độ phân tử của chất lỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"detect":{"definition":"Dò ra, tìm ra, khám phá ra, phát hiện ra.","example":"The sensor can detect small leaks in pipes.","exampleTranslation":"Cảm biến có thể dò ra những rò rỉ nhỏ trong đường ống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"detectable":{"definition":"Có thể dò ra, có thể tìm ra, có thể khám phá ra, có thể phát hiện ra.","example":"The tiny crack is detectable with light.","exampleTranslation":"Vết nứt nhỏ có thể dò ra bằng ánh sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"deviation":{"definition":"; (vật lý) độ lệch.","example":"The scientist measured the angular deviation of the beam.","exampleTranslation":"Nhà khoa học đã đo độ lệch góc của chùm tia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"devise":{"definition":"Nghĩ ra, đặt (kế hoạch), sáng chế, phát minh.","example":"She had to devise a clever way to win.","exampleTranslation":"Cô ấy phải nghĩ ra một cách thông minh để chiến thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"diameter":{"definition":"Đường kính.","example":"The circle had a small diameter.","exampleTranslation":"Vòng tròn có một đường kính nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"dimension":{"definition":"Chiều, kích thước, khổ, cỡ, số chiều.","example":"The box has a small dimension.","exampleTranslation":"Chiếc hộp có kích thước nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"dimensional":{"definition":"Thuộc chiều; thuộc kích thước, thuộc khổ, thuộc cỡ.","example":"The box's dimensional size fit the shelf.","exampleTranslation":"Kích thước của chiếc hộp vừa với kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"drag":{"definition":"Cái bừa lớn, cái bừa nặng.","example":"The drag left deep lines in the soil.","exampleTranslation":"Cái bừa nặng để lại những đường sâu trên đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"drop":{"definition":"Giọt (nước, máu, thuốc... ).","example":"A single drop of water fell from the roof.","exampleTranslation":"Một giọt nước rơi từ mái nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"droplet":{"definition":"Giọt nhỏ.","example":"A droplet of water sat on the leaf.","exampleTranslation":"Một giọt nhỏ nước nằm trên lá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"echo":{"definition":"Tiếng dội, tiếng vang.","example":"I could hear an echo in the cave.","exampleTranslation":"Tôi có thể nghe thấy một tiếng dội trong hang động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"electromagnetism":{"definition":"Hiện tượng điện từ.","example":"She studied electromagnetism in class.","exampleTranslation":"Cô ấy nghiên cứu hiện tượng điện từ trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"emit":{"definition":"Phát ra (ánh sáng, nhiệt...), bốc ra, tỏa ra (mùi vị, hơi...).","example":"The lamp can emit a soft light.","exampleTranslation":"Chiếc đèn có thể phát ra ánh sáng dịu nhẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"essence":{"definition":"Tính chất (nghĩa đen) & (nghĩa bóng)).","example":"The essence of the soup is garlic.","exampleTranslation":"Bản chất của món súp là tỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"exist":{"definition":"Tồn tại, sống.","example":"Small shops still exist in this town.","exampleTranslation":"Những cửa hàng nhỏ vẫn tồn tại trong thị trấn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"existence":{"definition":"Sự tồn tại, sự sống, sự sống còn; cuộc sống.","example":"We must ensure our existence in this harsh world.","exampleTranslation":"Chúng ta phải đảm bảo sự tồn tại của mình trong thế giới khắc nghiệt này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"expedition":{"definition":"Cuộc thám hiểm; đoàn thám hiểm.","example":"The school expedition studied birds in the forest.","exampleTranslation":"Đoàn thám hiểm của trường đã nghiên cứu chim trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"explode":{"definition":"Nổ, nổ tung (bom, đạn... ); nổ bùng.","example":"He did explode with anger during the meeting.","exampleTranslation":"Anh ấy đã nổ bùng với sự giận dữ trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"explore":{"definition":"Thông dò.","example":"The doctor will explore the wound carefully.","exampleTranslation":"Bác sĩ sẽ thông dò vết thương một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"explosion":{"definition":"Sự nổ; sự nổ bùng (cơn giận).","example":"There was an explosion of laughter in the room.","exampleTranslation":"Có một sự nổ bùng của tiếng cười trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"explosive":{"definition":"Bốc hơi.","example":"The drink had an explosive taste of gas.","exampleTranslation":"Đồ uống có một hương vị bốc hơi của khí gas.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"fluid":{"definition":"Hay thay đổi.","example":"Our plans for the trip are still fluid.","exampleTranslation":"Các kế hoạch của chúng tôi cho chuyến đi vẫn hay thay đổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"focal":{"definition":", (toán học) tiêu.","example":"The focal axis is important in this diagram.","exampleTranslation":"Trục tiêu là quan trọng trong biểu đồ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"force":{"definition":"Sức, lực, sức mạnh.","example":"He used physical force to open the heavy door.","exampleTranslation":"Anh ấy dùng sức mạnh vật lý để mở cánh cửa nặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"formation":{"definition":"Sự hình thành, sự tạo thành, sự lập nên.","example":"The formation of clouds happened very quickly.","exampleTranslation":"Sự hình thành các đám mây xảy ra rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"formula":{"definition":"Thể thức, cách thức.","example":"The formula for soup is simple and clear.","exampleTranslation":"Thể thức cho món súp thì đơn giản và rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"fraction":{"definition":"Phần nhỏ, miếng nhỏ.","example":"A small fraction of the group stayed behind.","exampleTranslation":"Một phần nhỏ của cả nhóm đã ở lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"frequency":{"definition":"Tính thường xuyên, tính thường hay xảy ra.","example":"Scientists study the frequency of earthquakes in this region.","exampleTranslation":"Các nhà khoa học nghiên cứu tính thường xuyên của các trận động đất trong khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"fusion":{"definition":"Sự hỗn hợp lại bằng cách nấu chảy ra.","example":"The fusion of flavors made a rich dish.","exampleTranslation":"Sự hỗn hợp lại của các hương vị đã tạo nên một món ăn đậm đà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"gauge":{"definition":"Máy đo (sức gió, chiều cao của thuỷ triều, lượng nước mưa... ).","example":"The rain gauge showed a high reading today.","exampleTranslation":"Máy đo lượng nước mưa cho thấy chỉ số cao ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"geometric":{"definition":"Hình học.","example":"The geometric pattern filled the wall.","exampleTranslation":"Hoa văn hình học đã lấp đầy bức tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"geometrical":{"definition":"Hình học.","example":"The geometrical pattern looked neat and balanced.","exampleTranslation":"Kiểu hoa văn hình học trông rất gọn gàng và cân đối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"geometrically":{"definition":"Về phương diện hình học.","example":"The team finished geometrically and left.","exampleTranslation":"Cả nhóm đã hoàn thành công việc theo phương diện hình học và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"science"},"geometry":{"definition":"Hình học.","example":"Geometry helps us measure shapes.","exampleTranslation":"Hình học giúp chúng ta đo lường các hình khối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"hybrid":{"definition":"Cây lai; vật lai; người lai.","example":"This tomato is a hybrid with a sweet taste.","exampleTranslation":"Cây cà chua này là một loại cây lai có vị ngọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"hypothesis":{"definition":"Giả thuyết.","example":"His hypothesis was simple but useful.","exampleTranslation":"Giả thuyết của anh ấy đơn giản nhưng hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"impetus":{"definition":"Sự thúc đẩy.","example":"A kind teacher can give a child impetus.","exampleTranslation":"Một giáo viên tốt bụng có thể tạo cho đứa trẻ sự thúc đẩy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"incidence":{"definition":", (vật lý) sự rơi, sự tới.","example":"The point of incidence is where light meets glass.","exampleTranslation":"Điểm tới là nơi ánh sáng gặp thủy tinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"indicate":{"definition":"Cần phải, đòi hỏi phải.","example":"Some symptoms indicate a need for treatment.","exampleTranslation":"Một số triệu chứng cần phải có sự điều trị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"indication":{"definition":"Sự biểu thị, sự biểu lộ; dấu hiệu.","example":"His behavior gave a clear indication of his mood.","exampleTranslation":"Hành vi của anh ấy đưa ra một dấu hiệu rõ ràng về tâm trạng của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"indicator":{"definition":"Cái chỉ, kim chỉ, dụng cụ chỉ.","example":"Check the altitude indicator before we start flying.","exampleTranslation":"Hãy kiểm tra cái chỉ độ cao trước khi chúng ta bắt đầu bay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"induce":{"definition":"Xui, xui khiến.","example":"The medicine might induce sleep for the patient.","exampleTranslation":"Thuốc này có thể xui khiến giấc ngủ cho bệnh nhân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"infinite":{"definition":"Không bờ bến, vô tận; vô vàn (infinite danh từ số nhiều) không đếm được, hằng hà sa số.","example":"The sky seemed infinite above the quiet sea.","exampleTranslation":"Bầu trời dường như không bờ bến phía trên biển tĩnh lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"instrument":{"definition":"Công cụ, phương tiện.","example":"A pen is a simple instrument for writing notes.","exampleTranslation":"Cái bút là một công cụ đơn giản để viết ghi chú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"instrumental":{"definition":"Cần thiết, thiết yếu, cốt yếu, chủ yếu.","example":"Her help was instrumental in finishing the project.","exampleTranslation":"Sự giúp đỡ của cô ấy là cốt yếu trong việc hoàn thành dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"intensity":{"definition":"cường độ; mức độ mạnh","example":"These flowers suffer from high intensity of sunlight.","exampleTranslation":"Những bông hoa này phải chịu cường độ ánh sáng mặt trời cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"science"},"isolate":{"definition":"Tách ra.","example":"Try to isolate that sound from the others.","exampleTranslation":"Hãy thử tách ra âm thanh đó khỏi những âm thanh khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"isolation":{"definition":"Sự cách ly.","example":"The patient stayed in isolation for two days.","exampleTranslation":"Bệnh nhân ở trong sự cách ly trong hai ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"kilogram":{"definition":"Kilôgam.","example":"The sack weighed one kilogram on the scale.","exampleTranslation":"Cái bao nặng một kilôgam trên bàn cân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"kilometre":{"definition":"Kilômet.","example":"We walked one kilometre to the park.","exampleTranslation":"Chúng tôi đã đi bộ một kilômet đến công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"length":{"definition":"Bề dài, chiều dài, độ dài.","example":"The length of the table is three meters.","exampleTranslation":"Chiều dài của cái bàn là ba mét.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"lens":{"definition":"Thấu kính.","example":"The camera uses a high quality positive lens.","exampleTranslation":"Máy ảnh sử dụng một thấu kính chất lượng cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"magnetic":{"definition":"nam châm, có tính từ, (thuộc) từ.","example":"The magnetic force pulled the metal objects closer.","exampleTranslation":"Lực nam châm đã kéo các vật kim loại lại gần hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"magnify":{"definition":"Thổi phồng, tán dương quá đáng.","example":"Do not magnify the small problems of life.","exampleTranslation":"Đừng tán dương quá đáng những vấn đề nhỏ của cuộc sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"magnitude":{"definition":"Tầm quan trọng, tính chất trọng đại.","example":"This is an event of the first magnitude.","exampleTranslation":"Đây là một sự kiện có tầm quan trọng hàng đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"math":{"definition":"(thuộc) Toán học.","example":"We used math to solve the puzzle.","exampleTranslation":"Chúng tôi đã dùng toán để giải câu đố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"mathematical":{"definition":"Toán, toán học.","example":"He used mathematical logic to solve the complex puzzle.","exampleTranslation":"Anh ấy đã dùng logic toán học để giải câu đố phức tạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"mathematician":{"definition":"Nhà toán học.","example":"The mathematician solved the hard problem.","exampleTranslation":"Nhà toán học đã giải được bài toán khó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"mathematics":{"definition":"Môn toán, toán học.","example":"She is studying pure mathematics at the university.","exampleTranslation":"Cô ấy đang nghiên cứu toán học thuần túy tại trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"matter":{"definition":"Chất, vật chất.","example":"The scientist studied the properties of solid matter.","exampleTranslation":"Nhà khoa học đã nghiên cứu các đặc tính của chất rắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"measurable":{"definition":"Đo được, lường được.","example":"The change is measurable after one week.","exampleTranslation":"Sự thay đổi có thể đo được sau một tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"measure":{"definition":"Tiêu chuẩn để đánh giá; cái để đánh giá, cái để xét; thước đo.","example":"Success is the only true measure of life.","exampleTranslation":"Thành công là thước đo thật duy nhất của cuộc sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"measurement":{"definition":"Sự đo lường; phép đo.","example":"Please check the measurement of this wooden table.","exampleTranslation":"Làm ơn kiểm tra sự đo lường của chiếc bàn gỗ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"mechanism":{"definition":"Kỹ thuật, kỹ xảo.","example":"The pianist showed the mechanism of his hands.","exampleTranslation":"Nghệ sĩ piano đã thể hiện kỹ thuật của đôi bàn tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"meter":{"definition":"Cái đo; cái đòng hồ đo; người đo ((thường) trong từ ghép); mét","example":"The meter showed a higher reading today.","exampleTranslation":"Cái đồng hồ đo đã cho thấy một chỉ số cao hơn hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"metre":{"definition":"Vận luật (trong thơ).","example":"The poet kept a clear metre in every line.","exampleTranslation":"Nhà thơ giữ một vận luật rõ ràng trong mỗi dòng thơ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"metric":{"definition":"(Thuộc) mét, (thuộc) hệ mét.","example":"We use the metric system for all measurements.","exampleTranslation":"Chúng tôi sử dụng hệ mét cho tất cả các phép đo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"microscopic":{"definition":"Kính hiển vi; bằng kính hiển vi.","example":"The marks were microscopic under the lens.","exampleTranslation":"Những vết đánh dấu nhỏ đến mức chỉ nhìn thấy bằng kính hiển vi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"model":{"definition":"Kiểu, mẫu, mô hình.","example":"We built a working model of the new bridge.","exampleTranslation":"Chúng tôi đã xây dựng một mô hình hoạt động của cây cầu mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"modification":{"definition":"Sự sửa đổi, sự biến cải, sự thay đổi.","example":"The plan needed a small modification after lunch.","exampleTranslation":"Kế hoạch cần một sự sửa đổi nhỏ sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"modify":{"definition":"Giảm bớt, làm nhẹ, làm dịu.","example":"Please modify your tone during the meeting.","exampleTranslation":"Vui lòng điều chỉnh tông giọng của bạn trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"moment":{"definition":", (vật lý) Mômen.","example":"The moment of force was easy to measure.","exampleTranslation":"Mômen lực rất dễ đo lường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"motion":{"definition":"Sự vận động, sự chuyển động, sự di động.","example":"There is constant motion to and from the city.","exampleTranslation":"Có sự chuyển động liên tục đến và đi từ thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"movement":{"definition":"Sự chuyển động, sự vận động, sự cử động, sự hoạt động.","example":"The statue remained perfectly still without any movement.","exampleTranslation":"Bức tượng vẫn đứng yên hoàn toàn mà không có bất kỳ sự chuyển động nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"multiply":{"definition":"Tăng lên nhiều lần; sinh sôi nảy nở.","example":"Bacteria can multiply very quickly in warm water.","exampleTranslation":"Vi khuẩn có thể sinh sôi nảy nở rất nhanh trong nước ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"normal":{"definition":"Tiêu chuẩn; ((toán học)) chuẩn tác.","example":"The machine is performing its normal function now.","exampleTranslation":"Máy đang thực hiện chức năng tiêu chuẩn của nó ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"normally":{"definition":"thông thường","example":"Normally, we eat lunch at 12:00.","exampleTranslation":"Thông thường, chúng tôi ăn trưa lúc 12:00.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"science"},"numerical":{"definition":"(thuộc) Số.","example":"She solved the numerical puzzle quickly.","exampleTranslation":"Cô ấy đã giải câu đố về số nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"observable":{"definition":"Đáng chú ý, đáng kể.","example":"We can see observable progress in your daily work.","exampleTranslation":"Chúng ta có thể thấy sự tiến bộ đáng kể trong công việc hàng ngày của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"observatory":{"definition":"Đài quan trắc, đài quan sát; tháp canh, chòi canh.","example":"The hill had an observatory for watching storms.","exampleTranslation":"Ngọn đồi có một đài quan trắc để theo dõi các cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"observe":{"definition":"Tiến hành, cử hành, làm (lễ kỷ niệm... ).","example":"The family will observe his birthday with a party.","exampleTranslation":"Gia đình sẽ kỷ niệm sinh nhật của ông ấy bằng một bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"observer":{"definition":"Người theo dõi, người quan sát.","example":"An observer watched the game from the hill.","exampleTranslation":"Người quan sát đã theo dõi trò chơi từ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"oceanographer":{"definition":"Nhà hải dương học.","example":"The oceanographer studied waves and tides.","exampleTranslation":"Nhà hải dương học đã nghiên cứu sóng và thủy triều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"oceanographic":{"definition":"Hải dương học.","example":"She read an oceanographic map with care.","exampleTranslation":"Cô ấy đã đọc bản đồ hải dương học một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"optimal":{"definition":"Tốt nhất.","example":"This is the optimal time to start studying.","exampleTranslation":"Đây là thời điểm tốt nhất để bắt đầu học tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"optimum":{"definition":"Điều kiện tốt nhất, điều kiện thuận lợi nhất (cho sự sinh trưởng của cây... ).","example":"Plants grow best in the optimum temperature.","exampleTranslation":"Cây trồng phát triển tốt nhất trong điều kiện nhiệt độ tốt nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"origin":{"definition":"Gốc, nguồn gốc, căn nguyên, khởi nguyên.","example":"The origin of the river is very far.","exampleTranslation":"Nguồn gốc của dòng sông rất xa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"originate":{"definition":"Hình thành.","example":"A plan can originate from one simple idea.","exampleTranslation":"Một kế hoạch có thể hình thành từ một ý tưởng đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"outlier":{"definition":"Người đứng ngoài (một tổ chức... ), người tách khỏi nhóm...","example":"She felt like an outlier in the group.","exampleTranslation":"Cô ấy cảm thấy như một người đứng ngoài trong nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"overexpose":{"definition":"Để quá lâu, phơi quá lâu (ngoài trời, ngoài nắng... ).","example":"Do not overexpose the film to sunlight.","exampleTranslation":"Đừng để phim phơi quá lâu dưới ánh nắng mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"parallel":{"definition":"Tương đương, tương tự, giống với, ngang hàng.","example":"There is a clear parallel between these two stories.","exampleTranslation":"Có một sự tương đương rõ ràng giữa hai câu chuyện này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"particle":{"definition":"Chút, tí chút.","example":"He does not have a particle of common sense.","exampleTranslation":"Anh ấy không có lấy một chút thông thường nào cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"penetrate":{"definition":"Thâm nhập, lọt vào.","example":"Good questions penetrate the heart of the matter.","exampleTranslation":"Những câu hỏi hay thâm nhập vào trọng tâm của vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"penetration":{"definition":"Sự thâm nhập, sự lọt vào, sự thấm qua.","example":"The wall blocked sound penetration.","exampleTranslation":"Bức tường đã ngăn chặn sự thâm nhập của âm thanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"periodic":{"definition":"Chu kỳ.","example":"We observed the periodic motion of the pendulum.","exampleTranslation":"Chúng tôi đã quan sát chuyển động chu kỳ của con lắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"periodically":{"definition":"Một cách định kỳ.","example":"She answered periodically and smiled.","exampleTranslation":"Cô ấy trả lời một cách định kỳ và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"science"},"phase":{"definition":"Tuần (trăng... ).","example":"He kept the phase on the desk.","exampleTranslation":"Anh ấy giữ tuần trăng trên bàn làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"phenomenon":{"definition":"Sự việc phi thường, người phi thường; vật phi thường; người kỳ lạ, vật kỳ lạ.","example":"Her memory for names is a rare phenomenon.","exampleTranslation":"Trí nhớ về tên gọi của cô ấy là một sự việc hiếm có.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"phenomenal":{"definition":"Có thể nhận thức bằng giác quan.","example":"The sound was phenomenal and easy to hear.","exampleTranslation":"Âm thanh thật phi thường và dễ nghe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"physicist":{"definition":"Nhà vật lý học.","example":"The physicist explained the result clearly.","exampleTranslation":"Nhà vật lý học đã giải thích kết quả một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"potency":{"definition":"Lực lượng; quyền thế, sự hùng mạnh.","example":"Her quiet potency came from years of practice.","exampleTranslation":"Lực lượng tĩnh lặng của cô ấy đến từ nhiều năm luyện tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"potent":{"definition":"Có lực lượng, có quyền thế, hùng mạnh.","example":"The potent wind shook the old house.","exampleTranslation":"Cơn gió hùng mạnh làm rung chuyển ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"pressure":{"definition":"Sức ép, áp lực ((nghĩa đen) & (nghĩa bóng)), áp suất.","example":"High pressure can cause many health problems.","exampleTranslation":"Áp lực cao có thể gây ra nhiều vấn đề sức khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"pressurize":{"definition":"Điều áp (làm điều hoà áp suất, nhiệt độ... trong máy bay... ) (thường ở dạng bị động).","example":"The plane must pressurize the cabin.","exampleTranslation":"Máy bay phải tạo áp suất cho khoang hành khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"probability":{"definition":"Sự có thể có, sự chắc hẳn, sự có khả năng xảy ra; sự có lẽ đúng, sự có lẽ thật.","example":"There is a high probability that it will snow tonight.","exampleTranslation":"Có xác suất cao là tối nay trời sẽ có tuyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"probe":{"definition":"Cái thông, cái que thăm (để dò vết thương... ).","example":"The doctor used a probe to clean the wound.","exampleTranslation":"Bác sĩ đã sử dụng một que thăm dò để làm sạch vết thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"proportion":{"definition":"Tỷ lệ.","example":"What is the proportion of water to juice?","exampleTranslation":"Tỷ lệ nước với nước trái cây là bao nhiêu?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"prototype":{"definition":"Người đầu tiên; vật đầu tiên; mẫu đầu tiên, nguyên mẫu.","example":"This sketch was the prototype for the final design.","exampleTranslation":"Bản phác thảo này là nguyên mẫu cho thiết kế cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"quantifiable":{"definition":"Có thể xác định số lượng.","example":"His progress is quantifiable now.","exampleTranslation":"Có thể xác định số lượng","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"quantify":{"definition":"Xác định số lượng.","example":"We need to quantify the daily water use.","exampleTranslation":"Xác định số lượng","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"quantity":{"definition":"số lượng; khối lượng","example":"The quantity of the candies in the tin has dropped to 17.","exampleTranslation":"Số lượng kẹo trong hộp đã giảm xuống còn 17.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"science"},"quotient":{"definition":"Số thương.","example":"Six divided by two gives a quotient of three.","exampleTranslation":"Sáu chia cho hai được thương là ba.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"radiation":{"definition":"sự bức xạ, sự phát xạ, sự toả ra.","example":"Scientists study radiation to keep people safe.","exampleTranslation":"Các nhà khoa học nghiên cứu bức xạ để giữ an toàn cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"ratio":{"definition":"Tỷ số, tỷ lệ.","example":"The ratio of boys to girls is equal.","exampleTranslation":"Tỷ lệ nam và nữ là bằng nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"react":{"definition":"Tác động trở lại, ảnh hưởng trở lại, phản ứng lại.","example":"Hot weather can react quickly to metal tools.","exampleTranslation":"Thời tiết nóng có thể phản ứng nhanh với các dụng cụ kim loại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"reactive":{"definition":", (hoá học) phản ứng.","example":"The mixture is highly reactive in warm water.","exampleTranslation":"Hỗn hợp này có tính phản ứng cao trong nước ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"rectangular":{"definition":"Hình chữ nhật.","example":"The room had a rectangular window.","exampleTranslation":"Căn phòng có một cửa sổ hình chữ nhật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"recur":{"definition":"Trở lại (một vấn đề).","example":"We should not recur to these old arguments again.","exampleTranslation":"Chúng ta không nên quay lại những tranh luận cũ này nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"recurrent":{"definition":"Hồi quy.","example":"He suffered from a recurrent fever last winter.","exampleTranslation":"Anh ấy bị tái phát cơn sốt vào mùa đông năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"reflect":{"definition":"Phản ánh.","example":"Their actions reflect their thoughts about the new plan.","exampleTranslation":"Hành động của họ phản ánh suy nghĩ của họ về kế hoạch mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"reflection":{"definition":"Sự phản chiếu, sự phản xạ, sự dội lại.","example":"The lake gave a clear reflection of the sky.","exampleTranslation":"Hồ nước cho thấy hình ảnh phản chiếu rõ nét của bầu trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"reinforce":{"definition":"Tăng cường, củng cố; tăng viện; tăng thêm sức mạnh.","example":"They need to reinforce the walls of the castle.","exampleTranslation":"Họ cần củng cố các bức tường của lâu đài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"relative":{"definition":"Có liên quan.","example":"The police found some relative evidence at the scene.","exampleTranslation":"Cảnh sát đã tìm thấy một số bằng chứng tương đối tại hiện trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"relatively":{"definition":"tương đối","example":"The apple was relatively small.","exampleTranslation":"Quả táo tương đối nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"science"},"relativity":{"definition":"Tính tương đối.","example":"Einstein developed the famous theory of relativity.","exampleTranslation":"Einstein đã phát triển thuyết tương đối nổi tiếng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"repel":{"definition":"Đẩy lùi.","example":"The shield can repel an attack.","exampleTranslation":"Tấm khiên có thể đẩy lùi một cuộc tấn công.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"replicate":{"definition":"Tái tạo; là một bản sao của, làm một bản sao của (cái gì).","example":"The scientist tried to replicate the experiment.","exampleTranslation":"Nhà khoa học đã cố gắng tái tạo lại thí nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"repository":{"definition":"Kho, chỗ chứa ((nghĩa đen) & (nghĩa bóng)).","example":"The cellar is a repository for old wine.","exampleTranslation":"Hầm chứa là nơi lưu trữ rượu vang cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"reshape":{"definition":"Tạo lại hình dáng, làm lại hình dáng; phục hồi hình dạng.","example":"He can reshape the clay with his hands.","exampleTranslation":"Anh ấy có thể tạo lại hình dáng khối đất sét bằng tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"residue":{"definition":"Phần còn lại.","example":"Only a small residue remained in the bowl.","exampleTranslation":"Chỉ một lượng nhỏ phần cặn còn lại trong bát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"resist":{"definition":"Kháng cự, chống lại.","example":"The soldiers had to resist the enemy attack.","exampleTranslation":"Những người lính đã phải kháng cự cuộc tấn công của kẻ thù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"resistance":{"definition":"Sự chống cự, sự kháng cự, sự đề kháng.","example":"The people started a war of resistance against them.","exampleTranslation":"Mọi người đã bắt đầu một cuộc chiến kháng cự chống lại họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"resistant":{"definition":"Chống cự, kháng cự, đề kháng.","example":"The coat is resistant to water and stains.","exampleTranslation":"Chiếc áo khoác này có khả năng đề kháng với nước và vết bẩn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"resonant":{"definition":"Âm vang; dội tiếng.","example":"The large hall has a very resonant voice.","exampleTranslation":"Hội trường lớn có giọng vang rất rõ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"retard":{"definition":"Sự chậm trễ, sự đến trễ.","example":"The retard was useful in class.","exampleTranslation":"Sự chậm trễ đã được sử dụng trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"rigid":{"definition":"Cứng rắn, cứng nhắc.","example":"The company has very rigid rules about punctuality.","exampleTranslation":"Công ty có những quy tắc rất cứng nhắc về sự đúng giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"rotate":{"definition":"Quay, xoay quanh.","example":"Please rotate the knob to open the door.","exampleTranslation":"Vui lòng xoay núm vặn để mở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"rotation":{"definition":"Sự quay, sự xoay vòng.","example":"The rotation of the earth takes one full year.","exampleTranslation":"Sự quay của trái đất mất một năm đầy đủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"scale":{"definition":"Cáu cặn; bựa (răng).","example":"Tea left a hard scale on the cup.","exampleTranslation":"Trà để lại một lớp cặn cứng trên cốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"segment":{"definition":"Đoạn, khúc, đốt, miếng.","example":"I ate one orange segment for breakfast today.","exampleTranslation":"Tôi đã ăn một đoạn cam cho bữa sáng hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"shape":{"definition":"Hình, hình dạng, hình thù.","example":"This round table is perfectly spherical in shape.","exampleTranslation":"Cái bàn tròn này có hình dạng hình cầu hoàn hảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"simulate":{"definition":"Giả vờ, giả cách.","example":"He tried to simulate anger to hide his sadness.","exampleTranslation":"Anh ấy cố gắng giả vờ giận dữ để che giấu nỗi buồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"size":{"definition":"Kích thước, độ lớn.","example":"What is the size of this large box?","exampleTranslation":"Kích thước của chiếc hộp lớn này là bao nhiêu?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"specimen":{"definition":"Mẫu, vật mẫu.","example":"The scientist examined a specimen from the deep ocean.","exampleTranslation":"Nhà khoa học đã kiểm tra một vật mẫu từ đại dương sâu thẳm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"spectrum":{"definition":"Hình ảnh.","example":"The spectrum showed many bright colors.","exampleTranslation":"Hình ảnh quang phổ cho thấy nhiều màu sắc tươi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"spherical":{"definition":"Cầu, (thuộc) hình cầu; có hình cầu.","example":"The planet is a large spherical object.","exampleTranslation":"Hành tinh là một vật thể hình cầu lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"spin":{"definition":"Sự vừa đâm xuống vừa quay tròn.","example":"A sharp spin sent him to the ground.","exampleTranslation":"Một sự vừa đâm xuống vừa quay tròn mạnh đã đẩy anh ấy xuống đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"square":{"definition":"Vuông.","example":"Please put the books on the square table.","exampleTranslation":"Vui lòng đặt sách lên chiếc bàn vuông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"stability":{"definition":"Sự vững vàng, sự vững chắc; sự ổn định (giá cả... ).","example":"Political stability is important for a country's growth.","exampleTranslation":"Sự vững vàng chính trị là quan trọng cho sự tăng trưởng của một đất nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"stabilize":{"definition":"Làm cho vững vàng; bình ổn, làm ổn định.","example":"Good sleep will stabilize her mood.","exampleTranslation":"Giấc ngủ ngon sẽ bình ổn tâm trạng của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"stable":{"definition":"Kiên định, kiên quyết.","example":"We need a stable politician to lead our country.","exampleTranslation":"Chúng ta cần một nhà chính trị kiên định để lãnh đạo đất nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"static":{"definition":"Tĩnh, (thuộc) tĩnh học.","example":"The radio signal was filled with static noise.","exampleTranslation":"Tín hiệu đài bị lấp đầy bởi nhiễu tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"stimulate":{"definition":"Kích thích, khuyến khích.","example":"Warm sunlight can stimulate plant growth.","exampleTranslation":"Ánh nắng ấm áp có thể kích thích cây trồng phát triển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"stimulation":{"definition":"Sự kích thích, sự khuyến khích.","example":"Praise gave her the stimulation to keep going.","exampleTranslation":"Sự khen ngợi đã cho cô ấy sự kích thích để tiếp tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"stimuli":{"definition":"Sự kích thích; tác dụng kích khích.","example":"Young minds need new stimuli to stay curious.","exampleTranslation":"Tâm trí trẻ cần sự kích thích mới để luôn tò mò.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"stimulus":{"definition":"Lông ngứa.","example":"Bright colors can be a stimulus for children.","exampleTranslation":"Màu sắc tươi sáng có thể là một tác dụng kích thích đối với trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"strength":{"definition":"Sức mạnh, sức lực, sức khoẻ.","example":"Regular exercise improved his strength.","exampleTranslation":"Tập thể dục thường xuyên cải thiện sức mạnh của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"strengthen":{"definition":"Làm cho mạnh; làm cho vững, làm cho kiên cố, củng cố.","example":"You should strengthen your leadership skills now.","exampleTranslation":"Bạn nên củng cố các kỹ năng lãnh đạo của mình bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"surface":{"definition":"Mặt, mặt ngoài bề mặt.","example":"The smooth surface of the table is clean.","exampleTranslation":"Mặt ngoài nhẵn của chiếc bàn rất sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"symmetrical":{"definition":"Đối xứng.","example":"The design looks symmetrical from both sides.","exampleTranslation":"Thiết kế trông đối xứng từ cả hai phía.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"symmetry":{"definition":"Sự đối xứng; tính đối xứng.","example":"The flower's symmetry was beautiful.","exampleTranslation":"Tính đối xứng của bông hoa rất đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"synthesise":{"definition":"Tổng hợp.","example":"Researchers synthesise the data before publishing.","exampleTranslation":"Các nhà nghiên cứu tổng hợp dữ liệu trước khi xuất bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"tannin":{"definition":"Tanin.","example":"The tannin was useful in class.","exampleTranslation":"Tanin đã rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"tension":{"definition":"Trạng thái căng (của dây... ); (nghĩa bóng) tình hình căng thẳng, sự căng thẳng.","example":"They took a deep breath to ease tension.","exampleTranslation":"Họ hít một hơi thật sâu để làm dịu trạng thái căng thẳng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"trace":{"definition":"Dấu, vết, vết tích.","example":"I found a trace of sugar in the bowl.","exampleTranslation":"Tôi tìm thấy một vết tích của đường trong bát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"transform":{"definition":"Thay đổi, biến đổi.","example":"The lesson helped transform his habits.","exampleTranslation":"Bài học đã giúp thay đổi các thói quen của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science"},"transformation":{"definition":"sự biến chất, sự biến tính.","example":"Heat caused a chemical transformation in the mixture.","exampleTranslation":"Nhiệt đã gây ra một sự biến chất hóa học trong hỗn hợp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"transparency":{"definition":"Kính ảnh phim đèn chiếu.","example":"The teacher showed the chart on a transparency.","exampleTranslation":"Giáo viên đã cho xem biểu đồ trên một kính ảnh phim đèn chiếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"transparent":{"definition":"Trong suốt.","example":"The glass is transparent and clean.","exampleTranslation":"Thủy tinh trong suốt và sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"unexplained":{"definition":"Không được giải thích.","example":"The delay remained unexplained for hours.","exampleTranslation":"Sự chậm trễ vẫn không được giải thích trong nhiều giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"unpredictable":{"definition":"Không thể nói trước, không thể đoán trước được.","example":"Her mood was unpredictable this afternoon.","exampleTranslation":"Tâm trạng của cô ấy thật không thể đoán trước được vào chiều nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"unproved":{"definition":"Chưa được thử thách.","example":"His unproved loyalty to the team is still uncertain.","exampleTranslation":"Lòng trung thành chưa được thử thách của anh ấy với đội vẫn còn chưa chắc chắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"unscientific":{"definition":"Không khoa học; phi khoa học.","example":"That test was based on unscientific guesses.","exampleTranslation":"Bài kiểm tra đó dựa trên những phỏng đoán không khoa học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"valve":{"definition":"; (giải phẫu) van.","example":"Check the valve before you pump the bicycle tire.","exampleTranslation":"Kiểm tra van trước khi bạn bơm lốp xe đạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"variability":{"definition":"tính biến đổi; độ biến thiên","example":"The data shows a great variability in the observed sizes.","exampleTranslation":"Dữ liệu cho thấy độ biến thiên lớn ở các kích thước quan sát được.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"science"},"variant":{"definition":"Khác nhau chút ít.","example":"The scholar found a variant reading in the text.","exampleTranslation":"Học giả đã tìm thấy một điểm khác nhau chút ít trong văn bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"variation":{"definition":"Sự biến đổi, sự thay đổi.","example":"There is a slight variation in the final color.","exampleTranslation":"Có một sự biến đổi nhẹ trong màu cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"vector":{"definition":"Một phần tử trong không gian véctơ.","example":"Please draw a vector on the graph.","exampleTranslation":"Vui lòng vẽ một véc tơ trên đồ thị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"velocity":{"definition":"Vận tốc.","example":"The car reached a high velocity on the highway.","exampleTranslation":"Chiếc xe đạt vận tốc cao trên đường cao tốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"viable":{"definition":"Có thể sống được (thai nhi, cây cối... ).","example":"The seed is still viable after two years.","exampleTranslation":"Hạt giống vẫn có thể sống được sau hai năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"vibration":{"definition":"Sự lúc lắc, sự chấn động.","example":"Can you feel the vibration of the engine?","exampleTranslation":"Bạn có thể cảm nhận sự lúc lắc của động cơ không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"vibrational":{"definition":"Rung động.","example":"The floor had a strong vibrational hum.","exampleTranslation":"Sàn nhà có một tiếng ồn rung động mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"visible":{"definition":"Thấy được, có thể trông thấy được.","example":"Is the small boat visible from the shore?","exampleTranslation":"Con thuyền nhỏ có thể trông thấy được từ bờ không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"visual":{"definition":"Trực quan.","example":"We use visual aids to teach the lesson.","exampleTranslation":"Chúng tôi sử dụng hỗ trợ trực quan để dạy bài học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"science"},"visualise":{"definition":"Hình dung, mường tượng (vật không thấy trước mắt).","example":"He can visualise the finished room easily.","exampleTranslation":"Anh ấy có thể hình dung căn phòng hoàn thiện một cách dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science","spellingNote":"Alternate spelling: visualize."},"visualize":{"definition":"Làm cho mắt trông thấy được; trực quan hóa.","example":"I can visualize the house from your description.","exampleTranslation":"Tôi có thể trực quan hóa ngôi nhà từ mô tả của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"science","spellingNote":"British spelling: visualise."},"weight":{"definition":"Cái chặn (giấy...).","example":"Use a book as a weight for the map.","exampleTranslation":"Hãy dùng một cuốn sách làm cái chặn cho tấm bản đồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"science"},"energy":{"definition":"Nghị lực, sinh lực.","example":"She has the energy to finish her work early.","exampleTranslation":"Cô ấy có đủ năng lượng để hoàn thành công việc của mình sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"electric":{"definition":"Điện, có điện, phát điện.","example":"We switched from gas lamps to electric light bulbs.","exampleTranslation":"Chúng tôi đã chuyển từ đèn khí sang bóng đèn điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"electric"},"electrical":{"definition":"Điện.","example":"The electrical fan cooled the room.","exampleTranslation":"Chiếc quạt điện đã làm mát căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"electric"},"electricity":{"definition":"điện; điện năng","example":"You need electricity to turn on the light bulbs.","exampleTranslation":"Bạn cần điện để bật các bóng đèn lên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"electric"},"power":{"definition":"Khả năng, tài năng, năng lực.","example":"I will help you to the utmost of my power.","exampleTranslation":"Tôi sẽ giúp bạn hết sức trong khả năng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"power"},"powered":{"definition":"Được trang bị hoặc vận hành bằng sức của máy.","example":"This new aircraft is powered by large engines.","exampleTranslation":"Chiếc máy bay mới này được vận hành bởi những động cơ lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"power"},"powerful":{"definition":"Hùng mạnh, hùng cường, mạnh mẽ.","example":"She has a powerful voice in class.","exampleTranslation":"Cô ấy có một giọng nói đầy uy lực trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"power"},"powerless":{"definition":"Bất lực; không có sức mạnh.","example":"I felt powerless to stop the delay.","exampleTranslation":"Tôi cảm thấy bất lực không thể ngăn cản sự chậm trễ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"power"},"solar":{"definition":"Mặt Trời, (thuộc) thái dương.","example":"The solar energy is very clean and sustainable.","exampleTranslation":"Năng lượng mặt trời rất sạch và bền vững.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"solar"},"solarise":{"definition":"Làm hỏng vì phơi quá.","example":"The print was ruined by solarise.","exampleTranslation":"Bản in đã bị hủy hoại bởi quá trình solar hóa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"solar","spellingNote":"Alternate spelling: solarize."},"solarize":{"definition":"Làm hỏng vì phơi quá.","example":"Too much light can solarize a photo.","exampleTranslation":"Quá nhiều ánh sáng có thể làm solar hóa một bức ảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"solar","spellingNote":"British spelling: solarise."},"wind":{"definition":"Lời rỗng tuếch; chuyện rỗng tuếch.","example":"His speech was merely wind without any facts.","exampleTranslation":"Bài phát biểu của anh ấy chỉ là sáo rỗng, không có lấy một sự thật nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wind"},"winded":{"definition":"Quá khứ và phân từ quá khứ của wind (nghĩa là “đánh hơi”)","example":"The dog winded the trail quickly.","exampleTranslation":"Con chó đánh hơi thấy dấu vết một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"wind"},"winder":{"definition":"Người cuốn chỉ (sợi); máy cuốn chỉ (sợi).","example":"The winder spun the yarn quickly.","exampleTranslation":"Máy cuộn đã quay sợi chỉ rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wind"},"winding":{"definition":"Khúc lượn, khúc quanh.","example":"The road has one sharp winding.","exampleTranslation":"Con đường có một đoạn uốn cong gắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wind"},"windless":{"definition":"Không có gió, lặng gió.","example":"The hill was bare and windless.","exampleTranslation":"Ngọn đồi trọc và không một chút gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"wind"},"windy":{"definition":"Dài dòng, trống rỗng, huênh hoang.","example":"Please do not give me such windy talk.","exampleTranslation":"Làm ơn đừng nói với tôi những lời sáo rỗng như vậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"wind"},"hydro":{"definition":"Như hydropathic","example":"The hydro was built near the lake.","exampleTranslation":"Nhà máy thủy điện được xây dựng gần hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"hydro"},"nuclear":{"definition":"(thuộc) Hạt nhân.","example":"Scientists are studying nuclear energy for power generation.","exampleTranslation":"Các nhà khoa học đang nghiên cứu năng lượng hạt nhân để phát điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"nuclear"},"fossil":{"definition":"Hoá đá, hoá thạch.","example":"The museum displays an ancient fossil of a fish.","exampleTranslation":"Bảo tàng trưng bày một hóa thạch cổ đại của một loài cá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"fossil"},"natural":{"definition":"Tự nhiên, (thuộc) thiên nhiên.","example":"We must follow the natural law of life.","exampleTranslation":"Chúng ta phải tuân theo quy luật tự nhiên của cuộc sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"natural"},"naturalism":{"definition":"Tính tự nhiên, thiên tính.","example":"Her naturalism shows in her art.","exampleTranslation":"Chủ nghĩa tự nhiên được thể hiện rõ trong các tác phẩm nghệ thuật của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"natural"},"naturalist":{"definition":"Người theo chủ nghĩa tự nhiên.","example":"The writer was a naturalist who showed life clearly.","exampleTranslation":"Nhà tự nhiên học là người đã mô tả sự sống một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"natural"},"naturalization":{"definition":"Sự nhập quốc tịch; sự nhập tịch (ngôn ngữ); sự quy hóa.","example":"He applied for naturalization after five years here.","exampleTranslation":"Anh ấy đã nộp đơn xin nhập quốc tịch sau năm năm sống ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"natural"},"naturalize":{"definition":"Làm hợp thuỷ thổ (cây, vật).","example":"We can naturalize the tree in this garden.","exampleTranslation":"Chúng ta có thể làm cho cái cây thích nghi với tự nhiên trong khu vườn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"natural","spellingNote":"British spelling: naturalise."},"naturally":{"definition":"Vốn, tự nhiên.","example":"She can speak naturally even when she is nervous.","exampleTranslation":"Cô ấy có thể nói chuyện một cách tự nhiên ngay cả khi đang lo lắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"natural"},"naturalness":{"definition":"Tính cách tự nhiên.","example":"The meal's naturalness made it taste fresh.","exampleTranslation":"Sự tự nhiên của món ăn làm cho nó có hương vị tươi ngon.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"natural"},"mineral":{"definition":"Khoáng.","example":"This mineral is commonly used in making jewelry.","exampleTranslation":"Khoáng chất này thường được sử dụng trong chế tác đồ trang sức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"mineral"},"mineralise":{"definition":"Khoáng hoá.","example":"Time can mineralise the soft layer.","exampleTranslation":"Thời gian có thể làm khoáng hóa lớp mềm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"mineral","spellingNote":"Alternate spelling: mineralize."},"mineralize":{"definition":"Khoáng hoá.","example":"The rock can mineralize over many years.","exampleTranslation":"Tảng đá có thể bị khoáng hóa sau nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"mineral","spellingNote":"British spelling: mineralise."},"coal":{"definition":"Than đá.","example":"We burned coal to heat the old house.","exampleTranslation":"Chúng tôi đã đốt than để sưởi ấm ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"coal"},"coaled":{"definition":"Đã được tiếp hoặc nạp than làm nhiên liệu.","example":"The steam locomotive was coaled before its long journey.","exampleTranslation":"Đầu máy hơi nước được tiếp than trước chuyến đi dài.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"coal"},"coaling":{"definition":"Việc tiếp than hoặc đang nạp than làm nhiên liệu.","example":"Coaling the ship took several hours before it left port.","exampleTranslation":"Việc tiếp than cho con tàu mất vài giờ trước khi nó rời cảng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"coal"},"coals":{"definition":"Tiếp than hoặc nạp than làm nhiên liệu.","example":"The worker coals the furnace before the night shift begins.","exampleTranslation":"Người công nhân tiếp than cho lò trước khi ca đêm bắt đầu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"coal"},"oiled":{"definition":"Quá khứ và phân từ quá khứ của oil","example":"She oiled the door hinge to stop the noise.","exampleTranslation":"Cô ấy đã tra dầu vào bản lề cửa để ngăn tiếng ồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"oil"},"oiler":{"definition":", (thông tục) áo vải dầu.","example":"His old oiler kept him dry in the rain.","exampleTranslation":"Chiếc áo mưa cũ giúp anh ấy giữ khô ráo khi trời mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"oil"},"oiling":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của oil.","example":"He is oiling the door hinge.","exampleTranslation":"Anh ấy đang tra dầu vào bản lề cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"oil"},"oils":{"definition":"Động từ chia ở ngôi thứ ba số ít của oil","example":"She oils the pan before cooking.","exampleTranslation":"Cô ấy thoa dầu vào chảo trước khi nấu ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"oil"},"oily":{"definition":"Có dầu, đầy dầu, giấy dầu, lem luốc dầu.","example":"He had oily hands after fixing the car.","exampleTranslation":"Tay anh ấy dính đầy dầu sau khi sửa xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"oil"},"efficient":{"definition":"Có hiệu lực, có hiệu quả.","example":"An efficient fan cooled the small room fast.","exampleTranslation":"Chiếc quạt hiệu quả giúp làm mát căn phòng nhỏ nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"efficient"},"efficiently":{"definition":"Có hiệu quả, hiệu nghiệm.","example":"The team finished efficiently and left.","exampleTranslation":"Nhóm đã hoàn thành công việc một cách hiệu quả và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"efficient"},"consumption":{"definition":"Sự tiêu thụ, sự tiêu dùng (hàng hoá, điện, than, nước... ).","example":"We need to reduce our home consumption of electricity.","exampleTranslation":"Chúng ta cần cắt giảm lượng điện tiêu thụ trong gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumption"},"generator":{"definition":"Người sinh ra, người tạo ra, cái sinh thành.","example":"This machine is a generator for the lights.","exampleTranslation":"Cỗ máy này là máy phát điện cho hệ thống đèn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"generator"},"battery":{"definition":"Khẩu đội (pháo).","example":"The battery fired three shells.","exampleTranslation":"Khẩu đội pháo đã bắn ba quả đạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"battery"},"blast":{"definition":"Tiếng kèn.","example":"The blast of a trumpet signaled the start.","exampleTranslation":"Tiếng kèn báo hiệu sự bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"burn":{"definition":"Đốt cháy, tạo ra phản ứng hóa học giữa vật thể và ôxy trong không khí (thường kèm theo việc sinh ra lửa)","example":"The wood will burn if you light it.","exampleTranslation":"Củi sẽ cháy nếu bạn thắp lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"energy"},"crude":{"definition":"Nguyên, sống, thô, chưa luyện.","example":"They found a large deposit of crude oil.","exampleTranslation":"Họ đã tìm thấy một mỏ dầu thô lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"energy"},"diesel":{"definition":"Động cơ điêzen ((cũng) diesel engine; diesel motor).","example":"The old truck still runs on diesel.","exampleTranslation":"Xe tải cũ vẫn chạy bằng động cơ điêzen.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"energetic":{"definition":"Mạnh mẽ, mãnh liệt, đầy nghị lực, đầy sinh lực; hoạt động.","example":"The energetic child ran across the yard.","exampleTranslation":"Đứa trẻ đầy sinh lực chạy qua sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"energy"},"gasoline":{"definition":"Dầu lửa, dầu hoả.","example":"The truck stopped because the gasoline was gone.","exampleTranslation":"Chiếc xe tải đã dừng lại vì hết dầu lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"harness":{"definition":"Trang bị lao động, dụng cụ lao động.","example":"The team checked all the harness before work.","exampleTranslation":"Cả đội đã kiểm tra tất cả các trang bị lao động trước khi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"heat":{"definition":"Nhiệt.","example":"The internal heat of the engine was quite high today.","exampleTranslation":"Nhiệt độ bên trong của động cơ khá cao ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"kerosene":{"definition":"Dầu lửa.","example":"We used kerosene to start the lamp.","exampleTranslation":"Chúng tôi đã dùng dầu lửa để mồi đèn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"lighter":{"definition":"Cái bật lửa.","example":"He used a lighter to start the candle.","exampleTranslation":"Anh ấy dùng cái bật lửa để châm nến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"peat":{"definition":"(thuộc) than bùn.","example":"They used peat fuel in the cold shed.","exampleTranslation":"Họ đã sử dụng nhiên liệu than bùn trong cái kho lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"energy"},"recharge":{"definition":"Nạp lại.","example":"You should recharge your phone before the meeting.","exampleTranslation":"Bạn nên sạc lại điện thoại trước cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"energy"},"thermal":{"definition":"Nhiệt, nóng.","example":"The thermal spring is very hot.","exampleTranslation":"Suối nước nóng là suối nhiệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"energy"},"agricultural":{"definition":"Nông nghiệp.","example":"The farm produces many organic agricultural products.","exampleTranslation":"Trang trại sản xuất nhiều sản phẩm nông nghiệp hữu cơ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agricultur"},"farm":{"definition":"Nông trường.","example":"He works on a large collective farm every day.","exampleTranslation":"Anh ấy làm việc tại một trang trại tập thể lớn mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"farm"},"farmable":{"definition":"Có thể phát canh, có thể trồng trọt.","example":"This land is farmable and easy to plant.","exampleTranslation":"Mảnh đất này có thể canh tác được và dễ dàng trồng trọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"farm"},"farmed":{"definition":"Quá khứ và phân từ quá khứ của farm","example":"They farmed the land for many years.","exampleTranslation":"Họ đã canh tác trên mảnh đất này trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"farm"},"farmer":{"definition":"Người tá điền; người nông dân.","example":"The farmer rose early to feed the animals.","exampleTranslation":"Người nông dân dậy sớm để cho gia súc ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"farm"},"farming":{"definition":"Công việc đồng áng, công việc trồng trọt.","example":"Modern farming methods help produce more food for everyone.","exampleTranslation":"Các phương pháp canh tác hiện đại giúp sản xuất nhiều thực phẩm hơn cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"farm"},"crop":{"definition":"Vụ, mùa; thu hoạch của một vụ.","example":"The farmers are waiting for the potato crop to grow.","exampleTranslation":"Những người nông dân đang đợi vụ khoai tây đến kỳ thu hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"crop"},"crops":{"definition":"Gieo trồng hoặc canh tác đất để thu hoạch nông sản.","example":"The farm crops its fields twice a year.","exampleTranslation":"Trang trại gieo trồng trên các cánh đồng của mình hai lần mỗi năm.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"crop"},"harvest":{"definition":"Kết quả, thu hoạch (của một việc gì).","example":"The project brought a rich harvest of ideas.","exampleTranslation":"Dự án đã mang lại một kết quả thu hoạch dồi dào các ý tưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"harvest"},"harvester":{"definition":"Người gặt.","example":"The harvester worked from sunrise to noon.","exampleTranslation":"Người gặt lúa đã làm việc từ bình minh cho đến trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"harvest"},"food":{"definition":"Đồ ăn, thức ăn, món ăn.","example":"The food at this restaurant is very delicious.","exampleTranslation":"Đồ ăn tại nhà hàng này rất ngon.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"food"},"diet":{"definition":"Quốc hội Nhật Bản; cơ quan lập pháp của Nhật Bản.","example":"The Japanese Diet debated a bill on food safety.","exampleTranslation":"Quốc hội Nhật Bản đã thảo luận một dự luật về an toàn thực phẩm.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"diet"},"dietary":{"definition":"Chế độ ăn uống; chế độ ăn kiêng.","example":"The clinic gave patients dietary advice for managing high blood pressure.","exampleTranslation":"Phòng khám đưa ra lời khuyên về chế độ ăn uống cho bệnh nhân để kiểm soát huyết áp cao.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"diet"},"dieted":{"definition":"Quá khứ và phân từ quá khứ của diet","example":"He dieted for three months.","exampleTranslation":"Anh ấy đã ăn kiêng trong ba tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"diet"},"organic":{"definition":"Cơ quan.","example":"The plant has an organic structure with clear parts.","exampleTranslation":"Cây trồng này có cấu trúc hữu cơ với các bộ phận rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"organic"},"livestock":{"definition":"Vật nuôi, thú nuôi.","example":"The farm keeps livestock in the lower field.","exampleTranslation":"Trang trại nuôi gia súc ở cánh đồng phía dưới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"livestock"},"animal":{"definition":"Động vật, thú vật.","example":"A dog is a very popular domestic animal.","exampleTranslation":"Chó là một loài động vật nuôi trong nhà rất phổ biến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"animal"},"animalise":{"definition":"Động vật hoá.","example":"The film tried to animalise people into wild creatures.","exampleTranslation":"Bộ phim đã cố gắng biến con người thành những sinh vật hoang dã.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"animal","spellingNote":"Alternate spelling: animalize."},"animalize":{"definition":"Động vật hoá.","example":"He did not want to animalize the character.","exampleTranslation":"Anh ấy không muốn biến nhân vật đó trở nên thú tính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"animal","spellingNote":"British spelling: animalise."},"fishing":{"definition":"Sự đánh cá, sự câu cá.","example":"Fishing is a quiet way to spend Sunday.","exampleTranslation":"Câu cá là một cách yên tĩnh để dành ngày Chủ nhật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"fishing"},"fishery":{"definition":"Công nghiệp cá; nghề cá.","example":"They work in a large local fishery.","exampleTranslation":"Họ làm việc trong một cơ sở đánh bắt cá lớn tại địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"fishery"},"soil":{"definition":"Làm bẩn, làm dơ, vấy bẩn.","example":"Please do not soil your new white shoes.","exampleTranslation":"Làm ơn đừng làm bẩn đôi giày trắng mới của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"soil"},"soiled":{"definition":"Quá khứ và phân từ quá khứ của soil","example":"Rain soiled his clean shoes on the path.","exampleTranslation":"Mưa đã làm bẩn đôi giày sạch của anh ấy trên đường đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"soil"},"soiling":{"definition":"Sự vấy bẩn; làm bẩn.","example":"The soiling on his shirt was hard to remove.","exampleTranslation":"Vết bẩn trên áo sơ mi của anh ấy rất khó giặt sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"soil"},"soilless":{"definition":"Sạch, không có vết bẩn.","example":"The shirt came out soilless after washing.","exampleTranslation":"Chiếc áo sơ mi không còn chút vết bẩn nào sau khi giặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"soil"},"fertilizable":{"definition":"Có thể làm cho màu mỡ được.","example":"This soil is fertilizable after a light treatment.","exampleTranslation":"Loại đất này có thể trở nên màu mỡ sau khi được xử lý nhẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"fertiliz"},"fertilization":{"definition":"Sự thụ tinh, sự thụ thai.","example":"Fertilization happens after the pollen reaches the flower.","exampleTranslation":"Sự thụ tinh diễn ra sau khi phấn hoa đến được hoa.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"fertiliz","spellingNote":"British spelling: fertilisation."},"fertilizer":{"definition":"Phân bón.","example":"Use fertilizer to help the plants grow.","exampleTranslation":"Hãy sử dụng phân bón để giúp cây cối phát triển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"fertiliz"},"irrigation":{"definition":"Sự tưới (đất, ruộng); sự tưới cho tươi tốt; tình trạng được tưới.","example":"Irrigation kept the dry field green.","exampleTranslation":"Việc tưới tiêu đã giữ cho cánh đồng khô cằn trở nên xanh tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"irrigation"},"rural":{"definition":"Nông thôn, thôn dã.","example":"Many people enjoy living in a quiet rural area.","exampleTranslation":"Nhiều người thích sống ở một vùng nông thôn yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"rural"},"ruralism":{"definition":"Phong thái thôn giả.","example":"His ruralism showed in his clothes.","exampleTranslation":"Phong thái nông thôn của anh ấy thể hiện qua cách ăn mặc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"rural"},"ruralization":{"definition":"Sự nông thôn hoá.","example":"The town saw slow ruralization.","exampleTranslation":"Thị trấn đã chứng kiến quá trình chuyển đổi sang nông thôn hóa chậm chạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"rural"},"ruralize":{"definition":"Nông thôn hoá.","example":"The village hopes to ruralize the area.","exampleTranslation":"Ngôi làng hy vọng sẽ chuyển đổi khu vực này thành vùng nông thôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"rural"},"cultivated":{"definition":"Quá khứ và phân từ quá khứ của cultivate","example":"They cultivated vegetables in the backyard.","exampleTranslation":"Họ đã trồng rau ở sân sau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"cultivat"},"cultivating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của cultivate.","example":"She is cultivating herbs in the small garden.","exampleTranslation":"Cô ấy đang trồng thảo mộc trong khu vườn nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"cultivat"},"cultivation":{"definition":"Sự cày cấy, sự trồng trọt.","example":"Most of the land is under cultivation now.","exampleTranslation":"Hầu hết diện tích đất hiện đang được canh tác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"cultivat"},"cultivator":{"definition":"người làm ruộng, người trồng trọt ((cũng) culturist).","example":"The cultivator checked the field at dawn.","exampleTranslation":"Người nông dân đã kiểm tra cánh đồng vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"cultivat"},"grain":{"definition":"Một chút, mảy may.","example":"There is not a grain of truth in that.","exampleTranslation":"Chẳng có chút sự thật nào trong việc đó cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"grain"},"graining":{"definition":"Sự tạo vân gỗ.","example":"The wood graining gives the table a warm look.","exampleTranslation":"Vân gỗ tạo cho chiếc bàn vẻ ngoài ấm cúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"grain"},"grains":{"definition":"Xiên đâm cá.","example":"The fisher used grains to catch fish.","exampleTranslation":"Người đánh cá đã dùng các hạt ngũ cốc để bắt cá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"grain"},"grainy":{"definition":"Có hạt, nhiều hạt.","example":"The grainy photo was hard to read.","exampleTranslation":"Bức ảnh bị hạt và mờ rất khó nhìn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"grain"},"cereal":{"definition":"Ngũ cốc.","example":"He chose a cereal breakfast before class.","exampleTranslation":"Anh ấy đã chọn ăn sáng bằng ngũ cốc trước khi đến lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"cereal"},"plantation":{"definition":"Sự di dân sang thuộc địa.","example":"Many people left home during the plantation move.","exampleTranslation":"Nhiều người đã rời nhà trong quá trình di dời đồn điền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"plantation"},"agriculturalist":{"definition":"Nhà nông học ((cũng) scientific agriculturalist).","example":"The agriculturalist tested the new soil plan.","exampleTranslation":"Nhà nông học đã kiểm tra kế hoạch đất đai mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"agriculture":{"definition":"Nông nghiệp.","example":"Agriculture supports many rural families.","exampleTranslation":"Nông nghiệp hỗ trợ nhiều gia đình ở nông thôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"almond":{"definition":"Quả hạnh.","example":"I would like to eat some roasted almond.","exampleTranslation":"Tôi muốn ăn một ít quả hạnh rang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"apple":{"definition":"Thứ gì đó giống với quả táo (tây), như quả địa cầu, quả bóng hay bầu ngực.","example":"The apple looked like a bright red ball.","exampleTranslation":"Quả táo trông giống như một quả bóng đỏ rực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"bake":{"definition":"Làm rám (da mặt, quả cây) (mặt trời); bị rám.","example":"The sun can bake the road in summer.","exampleTranslation":"Mặt trời có thể làm rám con đường vào mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"bakery":{"definition":"Lò bánh mì.","example":"We stopped at the bakery for rolls.","exampleTranslation":"Chúng tôi đã dừng lại ở lò bánh mì để mua bánh cuộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"bamboo":{"definition":"Cây tre.","example":"The bamboo grew tall behind the house.","exampleTranslation":"Cây tre mọc cao phía sau ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"banana":{"definition":"Cây chuối.","example":"I ate a banana after breakfast.","exampleTranslation":"Tôi đã ăn một quả chuối sau bữa sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"barbecue":{"definition":"Cuộc liên hoan ngoài trời có quay lợn, bò, cừu cả con.","example":"The family had a barbecue in the yard.","exampleTranslation":"Gia đình đã tổ chức một cuộc liên hoan ngoài trời trong sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"bean":{"definition":"Tiền đồng.","example":"He does not have a single bean in his pocket.","exampleTranslation":"Anh ấy không có một xu tiền đồng nào trong túi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"beef":{"definition":"Thịt bò.","example":"She bought beef for dinner tonight.","exampleTranslation":"Cô ấy đã mua thịt bò cho bữa tối tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"beer":{"definition":"Rượu bia.","example":"They shared a cold beer after work.","exampleTranslation":"Họ đã chia nhau một ly bia lạnh sau giờ làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"bill":{"definition":"Cái kéo liềm (để tỉa cành cây trên cao).","example":"He used a bill to trim the high branches.","exampleTranslation":"Anh ấy đã dùng cái kéo liềm để tỉa cành cây trên cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"binder":{"definition":"Bộ phận buộc lúa (trong máy gặt).","example":"The binder in the machine tied the wheat.","exampleTranslation":"Bộ phận buộc lúa trong máy gặt đã bó chặt lúa mì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"biscuit":{"definition":"Đồ sứ mới nung lần thứ nhất (chưa tráng men).","example":"The potter checked the biscuit before glazing it.","exampleTranslation":"Người thợ gốm đã kiểm tra đồ sứ mới nung lần thứ nhất trước khi tráng men.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"boil":{"definition":"Nhọt, đinh.","example":"A boil on his arm hurt badly.","exampleTranslation":"Một cái nhọt trên cánh tay anh ấy đau dữ dội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"bowl":{"definition":"Sự ăn uống, sự chè chén.","example":"They shared a bowl of hot soup together.","exampleTranslation":"Họ đã cùng nhau chia sẻ một chén súp nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"breakfast":{"definition":"Bữa ăn sáng, bữa điểm tâm.","example":"We ate breakfast early today.","exampleTranslation":"Chúng tôi đã ăn bữa sáng sớm hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"breed":{"definition":"Nòi, giống.","example":"This breed is gentle and easy to train.","exampleTranslation":"Nòi giống này rất hiền và dễ huấn luyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"bull":{"definition":"Con đực (voi, cá voi... ).","example":"The bull elephant moved slowly through the forest.","exampleTranslation":"Con voi đực di chuyển chậm chạp qua khu rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cacao":{"definition":"Cacao-tree.","example":"The cacao tree grows well in warm, wet weather.","exampleTranslation":"Cây cacao phát triển tốt trong thời tiết ấm áp và ẩm ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cake":{"definition":"Bánh ngọt, bánh ga tô, bánh kem.","example":"She baked a cake for the class party.","exampleTranslation":"Cô ấy đã nướng một cái bánh ngọt cho bữa tiệc của lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"candy":{"definition":", (từ lóng) côcain.","example":"He bought candy for the children at the store.","exampleTranslation":"Anh ấy đã mua bánh kẹo cho bọn trẻ tại cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cane":{"definition":"Cây trúc, cây mía ((cũng) sugar cane); cây lau.","example":"He walked with a cane after the fall.","exampleTranslation":"Anh ấy đi bộ bằng cây gậy sau cú ngã.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"capon":{"definition":"Gà trống thiến.","example":"The farmer raised a capon for dinner.","exampleTranslation":"Người nông dân đã nuôi một con gà trống thiến cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cassava":{"definition":"Tinh bột sắn, bột sắn.","example":"She used cassava flour to make the bread.","exampleTranslation":"Cô ấy đã sử dụng tinh bột sắn để làm bánh mì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cattle":{"definition":"Ngựa.","example":"He bought cattle for the small family farm.","exampleTranslation":"Anh ấy đã mua gia súc cho trang trại nhỏ của gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cheesecake":{"definition":"Bánh kem phó mát.","example":"We shared a slice of cheesecake after dinner.","exampleTranslation":"Chúng tôi đã chia nhau một lát bánh kem phó mát sau bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cherry":{"definition":"Chữ trinh.","example":"The old book used cherry as a color name.","exampleTranslation":"Cuốn sách cũ đã sử dụng màu anh đào như tên gọi của một màu sắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"chicken":{"definition":"Trẻ nhỏ, bé con.","example":"Do not be a chicken when facing new challenges.","exampleTranslation":"Đừng làm một kẻ bé con khi đối mặt với những thử thách mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"chocolate":{"definition":"Sôcôla.","example":"She shared a bar of chocolate.","exampleTranslation":"Cô ấy đã chia sẻ một thanh sôcôla.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"churn":{"definition":"Thùng đựng sữa.","example":"The milk sat in the churn all morning.","exampleTranslation":"Sữa đã nằm trong thùng đựng cả buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cinnamon":{"definition":"Cây quế.","example":"The cinnamon tree grew near the warm path.","exampleTranslation":"Cây quế đã mọc gần con đường ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"citrus":{"definition":"Giống cam quít.","example":"She bought a basket of citrus fruit.","exampleTranslation":"Cô ấy đã mua một giỏ trái cây giống cam quít.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"coca":{"definition":"Cây côca.","example":"The coca grows well in warm mountain air.","exampleTranslation":"Cây côca phát triển tốt trong không khí ấm áp của vùng núi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cocktail":{"definition":"Rượu cốc tai.","example":"She sipped a sweet cocktail at the party.","exampleTranslation":"Cô ấy đã nhâm nhi một ly rượu cốc tai ngọt ngào tại bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"coconut":{"definition":"Quả dừa.","example":"I would like to drink some fresh coconut milk.","exampleTranslation":"Tôi muốn uống một chút nước dừa tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"coffee":{"definition":"Màu cà phê.","example":"She wore a coffee coat to the party.","exampleTranslation":"Cô ấy đã mặc một chiếc áo khoác màu cà phê đến bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"combine":{"definition":"Côngbin, xanhđica.","example":"The wheat combine moved across the large field.","exampleTranslation":"Máy gặt đập liên hợp đã di chuyển khắp cánh đồng lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"confectionery":{"definition":"Mứt; kẹo.","example":"The jar held colorful confectionery.","exampleTranslation":"Cái lọ chứa đầy kẹo đầy màu sắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cookbook":{"definition":"Sách hướng dẫn, sách cẩm nang; sách dạy nấu ăn.","example":"I found the soup recipe in a cookbook.","exampleTranslation":"Tôi tìm thấy công thức làm súp trong một cuốn sách dạy nấu ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cookery":{"definition":"Nghề nấu ăn.","example":"She studied cookery at the local school.","exampleTranslation":"Cô ấy đã học nghề nấu ăn tại trường địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cookie":{"definition":"Bánh bao.","example":"He ate a cookie with milk.","exampleTranslation":"Cậu bé ăn một chiếc bánh quy với sữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cook":{"definition":"Đầu bếp, cấp dưỡng, anh nuôi.","example":"The cook prepared rice for the whole team.","exampleTranslation":"Người đầu bếp chuẩn bị cơm cho cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cottony":{"definition":"Bông; như bông.","example":"The blanket felt soft and cottony against her skin.","exampleTranslation":"Chiếc chăn mềm mại và êm như bông áp vào da cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"cows":{"definition":"Động từ chia ở ngôi thứ ba số ít của cow","example":"His anger cows the younger child.","exampleTranslation":"Sự giận dữ của anh ấy làm các hạ đứa trẻ nhỏ hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"cranberry":{"definition":"Cây nam việt quất.","example":"We picked fresh cranberry from the bog.","exampleTranslation":"Chúng tôi hái nam việt quất tươi từ vùng đầm lầy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cream":{"definition":"Kem (que, cốc).","example":"The child chose a chocolate cream from the box.","exampleTranslation":"Đứa trẻ đã chọn một viên kem sô-cô-la từ hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cultivate":{"definition":"Nuôi dưỡng (tình cảm... đối với ai).","example":"He tried to cultivate trust with his team.","exampleTranslation":"Anh ấy cố gắng nuôi dưỡng sự tin tưởng với đội của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"currant":{"definition":"Quả lý chua; cây lý chua.","example":"The currant bush had many small red berries.","exampleTranslation":"Bụi cây lý chua có nhiều quả mọng nhỏ màu đỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"cutworm":{"definition":"Sâu ngài đêm.","example":"A cutworm damaged the young plants.","exampleTranslation":"Một con sâu ngài đêm đã phá hoại các cây non.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"dairy":{"definition":"Bầy bò sữa (trong trại sản xuất sữa).","example":"The dairy held a small herd of cows.","exampleTranslation":"Bầy bò sữa trong trại sản xuất sữa có một đàn nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"delicious":{"definition":"Vui thích, khoái.","example":"This soup tastes delicious on a cold day.","exampleTranslation":"Món súp này có vị vui thích vào một ngày lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"dinner":{"definition":"Bữa cơm (trưa, chiều).","example":"We are having dinner at a nice restaurant.","exampleTranslation":"Chúng tôi đang dùng bữa cơm tối tại một nhà hàng đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"dish":{"definition":"Món ăn (đựng trong đĩa).","example":"She cooked a delicious fish dish for dinner.","exampleTranslation":"Cô ấy đã nấu một món ăn cá ngon tuyệt cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"dollop":{"definition":"Khúc to, cục to, miếng to (thức ăn... ).","example":"She added a dollop of jam on toast.","exampleTranslation":"Cô ấy thêm một cục to mứt lên bánh mì nướng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"draft":{"definition":"Nước vo gạo, nước rửa bát (để nấu cho lợn... ).","example":"He poured the draft into the pot for the pigs.","exampleTranslation":"Anh ấy đổ nước vo gạo vào nồi cho lũ lợn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"drink":{"definition":"Hớp, ngụm; cốc, ly (rượu, nước giải khát).","example":"Would you like to have a drink after work?","exampleTranslation":"Bạn có muốn dùng một ly sau giờ làm không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"dried":{"definition":"Quá khứ và phân từ quá khứ của dry","example":"We dried the clothes on the line.","exampleTranslation":"Chúng tôi đã làm khô quần áo trên dây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"drill":{"definition":"Mũi khoan; máy khoan.","example":"I need to buy a new hand drill.","exampleTranslation":"Tôi cần mua một cái máy khoan cầm tay mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"drying":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của dry.","example":"She was drying the dishes after lunch.","exampleTranslation":"Cô ấy đang hong khô bát đĩa sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"dung":{"definition":"Điều ô uế, điều nhơ bẩn.","example":"He hated the dung of the dirty alley.","exampleTranslation":"Anh ấy ghét điều ô uế của con hẻm bẩn thỉu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"eaten":{"definition":"Ăn mòn, ăn thủng, làm hỏng.","example":"The moths have eaten holes in my old coat.","exampleTranslation":"Những con bướm đêm đã ăn thủng những lỗ trên chiếc áo khoác cũ của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"eater":{"definition":"Người ăn.","example":"My brother is a big eater at every dinner.","exampleTranslation":"Anh trai tôi là một người ăn nhiều trong mọi bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"eating":{"definition":"Thức ăn.","example":"Fresh fish is good eating for a healthy dinner.","exampleTranslation":"Cá tươi là món thức ăn ngon cho một bữa tối lành mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"eats":{"definition":", (từ lóng) thức ăn, đồ ăn.","example":"We bought some eats for the trip.","exampleTranslation":"Chúng tôi đã mua một ít thức ăn cho chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"edible":{"definition":"Có thể ăn được (không độc).","example":"This fruit is edible and tastes sweet.","exampleTranslation":"Loại trái cây này có thể ăn được và có vị ngọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"eggs":{"definition":"Động từ chia ở ngôi thứ ba số ít của egg","example":"She eggs her brother on during games.","exampleTranslation":"Cô ấy thúc ép anh trai mình trong các trò chơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"farmland":{"definition":"Đất chăn nuôi, trồng trọt.","example":"The farmland stretched beyond the river.","exampleTranslation":"Đất chăn nuôi trải dài qua sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"fatten":{"definition":"Làm cho (đất) màu mỡ.","example":"The farmer used compost to fatten the soil.","exampleTranslation":"Người nông dân đã dùng phân ủ để làm cho đất màu mỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"feed":{"definition":"Cho ăn (người, súc vật).","example":"I need to feed my cat every morning.","exampleTranslation":"Tôi cần cho con mèo của mình ăn mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"feedstock":{"definition":"Nguyên liệu cấp cho máy để chế biến.","example":"The factory uses corn as feedstock.","exampleTranslation":"Nhà máy sử dụng ngô làm nguyên liệu cấp cho máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"fertile":{"definition":"Tốt, màu mỡ (đất).","example":"The fertile soil grew strong tomatoes.","exampleTranslation":"Đất tốt trồng được cà chua khỏe mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"fertilize":{"definition":"Làm cho tốt, làm cho màu mỡ (đất).","example":"Good rain can fertilize the dry field.","exampleTranslation":"Cơn mưa tốt có thể làm cho tốt cánh đồng khô cằn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"flavor":{"definition":"hương vị, mùi vị, vị ngon, mùi thơm.","example":"I love the orange flavor of this soda.","exampleTranslation":"Tôi yêu vị ngon cam của loại nước ngọt này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"flavoured":{"definition":"Quá khứ và phân từ quá khứ của flavour","example":"She flavoured the rice with herbs.","exampleTranslation":"Cô ấy đã trộn hương vị vào cơm với các loại thảo mộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"flavouring":{"definition":"hiện tại phân từ của flavour","example":"He was flavouring the soup gently.","exampleTranslation":"Anh ấy đang trộn hương vị vào món súp một cách nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"florist":{"definition":"Người trồng hoa, hoa nông.","example":"My aunt is a florist who grows roses.","exampleTranslation":"Dì tôi là một hoa nông người trồng hoa hồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"flour":{"definition":"Xay thành bột.","example":"They flour the grain into a fine powder.","exampleTranslation":"Họ xay hạt thành bột mịn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"foodstuff":{"definition":"Thực phẩm.","example":"Store the foodstuff in a cool, dry place.","exampleTranslation":"Lưu trữ thực phẩm ở nơi mát mẻ, khô ráo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"forage":{"definition":"Thức ăn (cho) vật nuôi, cỏ.","example":"The farmer provides green forage for the cows.","exampleTranslation":"Người nông dân cung cấp cỏ tươi cho những con bò.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"fresh":{"definition":"Tươi tắn, mơn mởn.","example":"The walls were covered in fresh paint this morning.","exampleTranslation":"Những bức tường được quét lớp sơn mới vào sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"fries":{"definition":"Động từ chia ở ngôi thứ ba số ít của fry","example":"The cook fries onions until they turn brown.","exampleTranslation":"Người đầu bếp chiên hành tây cho đến khi chúng chuyển sang màu nâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"fruit":{"definition":"Thu hoạch, lợi tức.","example":"The farm had a rich fruit this year.","exampleTranslation":"Trang trại đã có vụ thu hoạch phong phú trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"garden":{"definition":"Vườn.","example":"They planted many vegetables in the small garden.","exampleTranslation":"Họ đã trồng nhiều loại rau trong khu vườn nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"goat":{"definition":"Người dâm dục, người dâm đãng, người có máu dê.","example":"He acted like a goat at the party.","exampleTranslation":"Anh ta hành động như một gã người dâm dục tại bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"gourd":{"definition":"Cây bầu, cây bí.","example":"We cooked soup with fresh gourd.","exampleTranslation":"Chúng tôi nấu súp với cây bí tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"gram":{"definition":"Đậu Thổ Nhĩ Kỳ.","example":"She cooked the gram until it was soft.","exampleTranslation":"Cô ấy đã nấu đậu Thổ Nhĩ Kỳ cho đến khi nó mềm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"grape":{"definition":"Quả nho.","example":"She ate a sweet grape after lunch.","exampleTranslation":"Cô ấy đã ăn một quả nho ngọt sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"grazier":{"definition":"Người chuyên nuôi trâu bò để bán.","example":"The grazier sold healthy cattle at market.","exampleTranslation":"Người chuyên nuôi trâu bò để bán đã bán gia súc khỏe mạnh tại chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"graze":{"definition":"Lướt qua, sượt qua, làm sầy da, làm xước da.","example":"The car just managed to graze the fence.","exampleTranslation":"Chiếc xe vừa kịp lướt qua hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"grill":{"definition":"Grille.","example":"Dust settled on the grill near the window.","exampleTranslation":"Bụi đã bám vào vỉ gần cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"grower":{"definition":"Người trồng.","example":"The grower sold fresh fruit at the market.","exampleTranslation":"Người trồng đã bán trái cây tươi tại chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"guava":{"definition":"Cây ổi.","example":"The guava tree grew beside the fence.","exampleTranslation":"Cây ổi đã mọc bên cạnh hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"herb":{"definition":"Cỏ, cây thảo, thảo mộc","example":"He planted a herb beside the kitchen door.","exampleTranslation":"Anh ấy đã trồng một loại cỏ cạnh cửa bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"herbal":{"definition":"Cỏ, (thuộc) cây thảo.","example":"She added herbal tea to her evening routine.","exampleTranslation":"Cô ấy đã thêm trà cỏ vào thói quen buổi tối của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"herd":{"definition":"Bọn, bè lũ (người).","example":"He does not want to join the herd.","exampleTranslation":"Anh ấy không muốn gia nhập bọn người đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"hoeing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của hoe.","example":"He learned to hoeing the tool.","exampleTranslation":"Anh ấy đã học cách cuốc đất bằng công cụ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"hogs":{"definition":"Động từ chia ở ngôi thứ ba số ít của hog","example":"They hogs the data carefully.","exampleTranslation":"Họ gom các dữ liệu cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"honeydew":{"definition":"Dịch ngọt (do sâu bọ tiết ra).","example":"The leaves were covered with sweet honeydew.","exampleTranslation":"Những chiếc lá được bao phủ bởi dịch ngọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"horse":{"definition":"Ngựa.","example":"They decided to take horse instead of walking.","exampleTranslation":"Họ quyết định đi ngựa thay vì đi bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"horticulturist":{"definition":"Người làm vườn.","example":"The horticulturist pruned the roses carefully.","exampleTranslation":"Người làm vườn đã cắt tỉa hoa hồng cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"hull":{"definition":"Vỏ, bao.","example":"The shell was hard hull around the seed.","exampleTranslation":"Vỏ hạt là một lớp bao cứng quanh hạt giống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"infertile":{"definition":"Không màu mỡ, cằn cỗi.","example":"The field was infertile and dry.","exampleTranslation":"Cánh đồng đó không màu mỡ và khô cằn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"ingredient":{"definition":"Phần hợp thành, thành phần.","example":"Flour is an ingredient in this bread.","exampleTranslation":"Bột mì là một thành phần trong bánh mì này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"insecticide":{"definition":"Thuốc trừ sâu.","example":"They used insecticide to save the crop.","exampleTranslation":"Họ đã sử dụng thuốc trừ sâu để cứu vụ mùa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"irrigate":{"definition":"Uống bứ bừ.","example":"He likes to irrigate after a long meal.","exampleTranslation":"Anh ấy thích uống bứ bừ sau một bữa ăn dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"juice":{"definition":"Phần tinh hoa, phần tinh tuý (của cái gì).","example":"The real juice of the story is here.","exampleTranslation":"Phần tinh hoa thực sự của câu chuyện là ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"leaven":{"definition":"Ảnh hưởng làm thay đổi, ảnh hưởng làm lan ra.","example":"One kind word can be a leaven for change.","exampleTranslation":"Một lời tử tế có thể là ảnh hưởng làm thay đổi cho sự thay đổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"lemon":{"definition":"Màu vàng nhạt.","example":"The room was painted a soft lemon color.","exampleTranslation":"Căn phòng được sơn màu vàng nhạt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"lime":{"definition":"Chanh lá cam.","example":"She added lime to her drink.","exampleTranslation":"Cô ấy thêm chanh lá cam vào đồ uống của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"maize":{"definition":"Vàng nhạt (màu ngô).","example":"She wore a soft maize scarf today.","exampleTranslation":"Hôm nay cô ấy quàng chiếc khăn màu vàng nhạt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"malt":{"definition":"Mạch nha.","example":"The beer was made with malt.","exampleTranslation":"Bia được làm bằng mạch nha.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"mango":{"definition":"Cây xoài.","example":"The mango grew near the house.","exampleTranslation":"Cây xoài mọc gần nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"manure":{"definition":"Phân bón.","example":"The farmer spread manure over the field.","exampleTranslation":"Người nông dân rải phân bón lên cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"meal":{"definition":"Bột ((thường) xay chưa mịn).","example":"She bought meal for the bread recipe.","exampleTranslation":"Cô ấy đã mua bột cho công thức làm bánh mì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"meat":{"definition":"Thịt.","example":"I would like to buy some fresh meat.","exampleTranslation":"Tôi muốn mua một ít thịt tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"milk":{"definition":"Nhựa mủ (cây), nước (dừa... ).","example":"We saw white milk on the tree bark.","exampleTranslation":"Chúng tôi thấy nhựa mủ trắng trên vỏ cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"millet":{"definition":"Cây kê.","example":"Millet grows well in dry soil.","exampleTranslation":"Cây kê mọc tốt trong đất khô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"monocultural":{"definition":"Độc canh.","example":"The farm used a monocultural system.","exampleTranslation":"Nông trại đã sử dụng hệ thống độc canh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"mower":{"definition":"Thợ cắt, thợ gặt.","example":"The mower cut the grass in one hour.","exampleTranslation":"Máy cắt cỏ đã cắt xong cỏ trong một giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"mulch":{"definition":"Lớp phủ, bổi (che phủ bảo vệ rễ cây mới trồng).","example":"Spread mulch around the young tree.","exampleTranslation":"Rải lớp phủ quanh gốc cây nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"mutton":{"definition":"Thịt cừu.","example":"We had roasted mutton for dinner.","exampleTranslation":"Chúng tôi đã ăn thịt cừu quay cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"myrrh":{"definition":"Chất nhựa thơm.","example":"The box smelled faintly of myrrh.","exampleTranslation":"Chiếc hộp có mùi chất nhựa thơm thoang thoảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"nuts":{"definition":"Động từ chia ở ngôi thứ ba số ít của nut","example":"She nuts when she hears that song.","exampleTranslation":"Cô ấy phát cuồng khi nghe thấy bài hát đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"olive":{"definition":"Cây ôliu.","example":"An olive grew in the garden.","exampleTranslation":"Một cây ôliu đã mọc trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"onion":{"definition":"Củ hành.","example":"I cut an onion for the soup.","exampleTranslation":"Tôi cắt một củ hành để làm súp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"orange":{"definition":"Quả cam.","example":"I would like to eat a fresh orange.","exampleTranslation":"Tôi muốn ăn một quả cam tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"orchard":{"definition":"Vườn cây ăn quả.","example":"We picked apples in the orchard.","exampleTranslation":"Chúng tôi đã hái táo trong vườn cây ăn quả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"oven":{"definition":"Lò (để hấp bánh, để dùng trong thí nghiệm hoá học).","example":"The bread baked slowly in the oven.","exampleTranslation":"Bánh mì nướng chậm trong lò.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"overgraze":{"definition":"Chăn thả quá mức.","example":"Farmers should not overgraze this hill.","exampleTranslation":"Người nông dân không nên chăn thả quá mức trên ngọn đồi này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"oxen":{"definition":"Thú nuôi có sừng.","example":"The oxen pulled the cart slowly.","exampleTranslation":"Những con bò kéo chiếc xe từ từ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"paddy":{"definition":"Thóc, lúa; (từ Mỹ, nghĩa Mỹ) gạo.","example":"The farmer stored paddy in a dry barn.","exampleTranslation":"Người nông dân cất trữ thóc trong một cái kho khô ráo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pastry":{"definition":"Bột nhồi, bột nhão.","example":"She mixed the pastry until it felt smooth.","exampleTranslation":"Cô ấy đã trộn bột cho đến khi cảm thấy nhuyễn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pasture":{"definition":"Đồng cỏ, bãi cỏ.","example":"The cows rested in the green pasture.","exampleTranslation":"Những con bò nghỉ ngơi trên đồng cỏ xanh mướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pear":{"definition":"Quả lê.","example":"She ate a sweet pear for lunch.","exampleTranslation":"Cô ấy đã ăn một quả lê ngọt cho bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pest":{"definition":"người làm hại, vật làm hại.","example":"The old sign is a pest in the yard.","exampleTranslation":"Cái biển cũ là một vật gây hại trong sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pizza":{"definition":"Bánh pizza.","example":"We shared a hot pizza for dinner.","exampleTranslation":"Chúng tôi đã chia sẻ một chiếc bánh pizza nóng cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"plate":{"definition":"Bản, tấm phiếu, lá (kim loại).","example":"Please check the battery plate for more information.","exampleTranslation":"Vui lòng kiểm tra tấm pin để biết thêm thông tin.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"plough":{"definition":"Cái cày.","example":"He lifted the plough and went to work.","exampleTranslation":"Anh ấy nhấc cái cày lên và đi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pomelo":{"definition":"Quả bưởi chùm.","example":"He shared a juicy pomelo with his friend.","exampleTranslation":"Anh ấy chia sẻ một quả bưởi chùm mọng nước với bạn mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"popcorn":{"definition":"Ngô rang nở.","example":"We made popcorn for the movie night.","exampleTranslation":"Chúng tôi làm ngô rang nở cho buổi tối xem phim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"porridge":{"definition":"Cháo yến mạch.","example":"He kept the porridge on the desk.","exampleTranslation":"Anh ấy để cháo yến mạch trên bàn làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pots":{"definition":"Động từ chia ở ngôi thứ ba số ít của pot","example":"He pots small plants in clay jars.","exampleTranslation":"Anh ấy trồng các loại cây nhỏ trong các lọ đất sét.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"poultry":{"definition":"Gà vẹt, chim nuôi.","example":"They kept poultry in a clean yard.","exampleTranslation":"Họ giữ gia cầm trong một cái sân sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"produce":{"definition":"Sản lượng.","example":"The factory's annual produce is very high.","exampleTranslation":"Sản lượng hàng năm của nhà máy rất cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pumpkin":{"definition":"Quả bí ngô, quả bí.","example":"We carved a pumpkin for the porch.","exampleTranslation":"Chúng tôi đã khắc một quả bí ngô cho hiên nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"pungency":{"definition":"Vị hăng; vị cay (ớt... ).","example":"The soup had a pleasant pungency from garlic.","exampleTranslation":"Món súp có vị hăng dễ chịu từ tỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"ranch":{"definition":"Điền trang, trại nuôi súc vật (ở Mỹ, Ca-na-đa).","example":"They bought fresh eggs from the ranch.","exampleTranslation":"Họ đã mua trứng tươi từ trang trại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"recipe":{"definition":"Đơn thuốc, thuốc pha chế theo đơn, thuốc bốc theo đơn.","example":"The doctor wrote a recipe for the medicine.","exampleTranslation":"Bác sĩ đã viết đơn thuốc cho loại thuốc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"rice":{"definition":"Lúa; gạo; cơm.","example":"We bought some white rice at the market.","exampleTranslation":"Chúng tôi đã mua một ít gạo trắng ở chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"ripe":{"definition":"Chín.","example":"I picked a ripe apple from the tree.","exampleTranslation":"Tôi đã hái một quả táo chín từ cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"ripen":{"definition":"Chín, chín muồi; (nghĩa bóng) trở nên chính chắn.","example":"Let the fruit ripen before you eat it.","exampleTranslation":"Hãy để trái cây chín muồi trước khi bạn ăn nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"salmon":{"definition":"Cá hồi.","example":"We had grilled salmon for dinner.","exampleTranslation":"Chúng tôi đã ăn cá hồi nướng cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"salt":{"definition":"Muối.","example":"Do you need to add more salt to soup?","exampleTranslation":"Bạn có cần thêm muối vào súp không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"salty":{"definition":"Muối; có muối, mặn.","example":"The plan looked salty in practice.","exampleTranslation":"Kế hoạch nghe có vẻ mặn mà trong thực tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"sausage":{"definition":"Khí cầu thám không (hình xúc xích).","example":"The old sausage floated high above the field.","exampleTranslation":"Khí cầu thám không cũ bay cao phía trên cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"seed":{"definition":"Con cháu, hậu thế.","example":"They hope to raise up seed for future generations.","exampleTranslation":"Họ hy vọng nuôi dạy con cháu cho các thế hệ tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"seedling":{"definition":"Cây trồng từ hạt (đối với cây chiết hoặc ghép).","example":"A seedling pushed up through the soil.","exampleTranslation":"Một cây trồng từ hạt nhú lên qua lớp đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"sesame":{"definition":"Cây vừng, hạt vừng.","example":"We sprinkled sesame seeds on the bread.","exampleTranslation":"Chúng tôi đã rắc hạt vừng lên bánh mì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"sheep":{"definition":"Người hay e thẹn, người nhút nhát.","example":"He felt like a sheep at the party.","exampleTranslation":"Anh ấy cảm thấy như một kẻ nhút nhát tại bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"shell":{"definition":"Vỏ: cấu trúc rỗng và cứng nói chung.","example":"The shell was important at work.","exampleTranslation":"Cấu trúc rỗng này rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"slaughter":{"definition":"Sự giết thịt, sự mổ thịt (bò, lợn... ).","example":"The slaughter of the cow took place quietly.","exampleTranslation":"Việc giết thịt con bò diễn ra một cách lặng lẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"slice":{"definition":"Miếng mỏng, lát mỏng.","example":"Would you like a slice of chocolate cake?","exampleTranslation":"Bạn có muốn một lát bánh sô cô la không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"snack":{"definition":"Bữa ăn vội vàng, bữa ăn qua loa; bữa quà; chút thức ăn, chút rượu.","example":"I ate a snack before the long walk.","exampleTranslation":"Tôi đã ăn một bữa nhẹ trước chuyến đi dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"soda":{"definition":"Natri cacbonat.","example":"Add soda to the mixture carefully.","exampleTranslation":"Thêm natri cacbonat vào hỗn hợp một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"soup":{"definition":"Xúp, canh; cháo.","example":"I would like a bowl of hot soup.","exampleTranslation":"Tôi muốn một bát canh nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"sown":{"definition":"Gieo.","example":"He sown seeds in neat rows.","exampleTranslation":"Anh ấy đã gieo những hạt giống thành hàng lối gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"spade":{"definition":"Con pích.","example":"He drew a spade from the deck.","exampleTranslation":"Anh ấy rút một quân pích từ bộ bài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"spice":{"definition":"(Nghĩa bóng) Hương vị, thi vị.","example":"Her stories bring spice to our quiet evenings.","exampleTranslation":"Những câu chuyện của cô ấy mang đến thi vị cho những buổi tối yên tĩnh của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"sprout":{"definition":"Mọc, để mọc.","example":"Small green leaves begin to sprout from the ground.","exampleTranslation":"Những lá xanh nhỏ bắt đầu để mọc từ mặt đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"straw":{"definition":"Nón rơm, mũ rơm.","example":"She wore a straw hat at the beach.","exampleTranslation":"Cô ấy đội một chiếc mũ rơm tại bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"strawberry":{"definition":"Cây dâu tây.","example":"A strawberry grew well in the small garden.","exampleTranslation":"Cây dâu tây mọc tốt trong khu vườn nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"sugar":{"definition":"Đường.","example":"I need to buy some white sugar today.","exampleTranslation":"Tôi cần mua một ít đường trắng hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"sweet":{"definition":"Ngọt (nước).","example":"We need to find some fresh sweet water.","exampleTranslation":"Chúng ta cần tìm một ít nước ngọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"sweetener":{"definition":"Chất pha cho ngọt.","example":"I used a natural sweetener in my drink.","exampleTranslation":"Tôi đã sử dụng một chất pha cho ngọt tự nhiên trong đồ uống của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"taro":{"definition":"Củ khoai sọ; củ khoai nước.","example":"The taro was soft and sweet after boiling.","exampleTranslation":"Củ khoai sọ mềm và ngọt sau khi luộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"teas":{"definition":"Động từ chia ở ngôi thứ ba số ít của tea","example":"She teas the hair with a comb.","exampleTranslation":"Cô ấy chòng ghẹo mái tóc bằng một cái lược.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"agriculture"},"topping":{"definition":"Sự tỉa ngọn cây.","example":"We did the topping to keep the tree small.","exampleTranslation":"Chúng tôi đã thực hiện việc tỉa ngọn cây để giữ cho cây nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"tractor":{"definition":"Máy kéo.","example":"The tractor pulled the heavy cart across the field.","exampleTranslation":"Máy kéo đã kéo chiếc xe nặng ngang qua cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"vanilla":{"definition":"Cây vani.","example":"The vanilla plant grew well in the warm garden.","exampleTranslation":"Cây vani đã phát triển tốt trong khu vườn ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"vegetable":{"definition":"(thuộc) thực vật.","example":"Plants are part of the diverse vegetable kingdom.","exampleTranslation":"Thực vật là một phần của vương quốc (thuộc) thực vật đa dạng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"vegetarian":{"definition":"Ăn chay; chay.","example":"I prefer to eat vegetarian food for my health.","exampleTranslation":"Tôi thích ăn thực phẩm chay cho sức khỏe của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"vine":{"definition":"Cây nho.","example":"The vine climbed slowly over the wall.","exampleTranslation":"Cây nho leo chậm chạp trên tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"waffle":{"definition":"bánh tổ ong.","example":"He ate a waffle with fruit and honey.","exampleTranslation":"Anh ấy đã ăn một cái bánh tổ ong với trái cây và mật ong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"walnut":{"definition":"Quả óc chó.","example":"I cracked a walnut and ate the nut.","exampleTranslation":"Tôi đã bẻ một quả óc chó và ăn hạt bên trong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"weed":{"definition":"Cỏ dại.","example":"The garden was full of weed.","exampleTranslation":"Khu vườn đầy cỏ dại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"weedkiller":{"definition":"Chất diệt cỏ dại.","example":"Spray the path with weedkiller today.","exampleTranslation":"Hãy phun thuốc diệt cỏ dại lên lối đi hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"weedy":{"definition":"Ốm yếu, còm, gầy gi xưng (người).","example":"He was pale and weedy after the illness.","exampleTranslation":"Anh ấy trông ốm yếu và còm cõi sau trận ốm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"agriculture"},"wool":{"definition":"Len; lông cừu, lông chiên.","example":"My grandmother knitted a soft ball of wool.","exampleTranslation":"Bà tôi đã đan một cuộn len mềm mại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"yield":{"definition":"Sản lượng, hoa lợi (thửa ruộng); hiệu suất (máy... ).","example":"The farm had a high yield of corn.","exampleTranslation":"Trang trại có sản lượng ngô cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"agriculture"},"globalization":{"definition":"Quá trình các quốc gia ngày càng kết nối về kinh tế, văn hóa và công nghệ.","example":"Globalization has connected supply chains across national borders.","exampleTranslation":"Toàn cầu hóa đã kết nối các chuỗi cung ứng xuyên biên giới quốc gia.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"globalization","spellingNote":"British spelling: globalisation."},"global":{"definition":"Toàn cầu.","example":"We need to develop a global strategy for success.","exampleTranslation":"Chúng ta cần phát triển một chiến lược toàn cầu để đạt được thành công.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"global"},"globalisation":{"definition":"Toàn cầu hóa.","example":"Globalisation has connected economies and transformed international trade worldwide.","exampleTranslation":"Toàn cầu hóa đã kết nối các nền kinh tế và chuyển đổi thương mại quốc tế trên toàn thế giới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"global","spellingNote":"Alternate spelling: globalization."},"globalize":{"definition":"Biến thành toàn cầu.","example":"Small stores often globalize to reach more buyers.","exampleTranslation":"Các cửa hàng nhỏ thường vươn ra toàn cầu để tiếp cận nhiều khách hàng hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"global"},"globally":{"definition":"Toàn bộ, tổng thể.","example":"The team finished globally and left.","exampleTranslation":"Cả đội đã kết thúc công việc trên quy mô toàn cầu rồi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"global"},"international":{"definition":"Đại biểu quốc tế cộng sản.","example":"He was called an international in the meeting.","exampleTranslation":"Anh ấy được gọi là một người quốc tế trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"internation"},"corporation":{"definition":"Công ty hoặc tập đoàn được thành lập để kinh doanh.","example":"The corporation opened a new office to serve customers in the region.","exampleTranslation":"Tập đoàn đã mở một văn phòng mới để phục vụ khách hàng trong khu vực.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"corporation"},"supply":{"definition":"Sự cung cấp, sự tiếp tế.","example":"The city has a steady supply of fresh water.","exampleTranslation":"Thành phố có nguồn cung cấp nước sạch ổn định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"supply"},"manufacturer":{"definition":"Người chế tạo, người sản xuất.","example":"The manufacturer shipped the parts today.","exampleTranslation":"Nhà sản xuất đã vận chuyển các linh kiện vào ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"manufactur"},"manufacturing":{"definition":"Sự sản xuất; sự chế tạo.","example":"Manufacturing creates many local jobs.","exampleTranslation":"Sản xuất công nghiệp tạo ra nhiều việc làm tại địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"manufactur"},"integration":{"definition":"Sự hoà hợp với môi trường.","example":"His integration into the class was smooth.","exampleTranslation":"Sự hòa nhập của anh ấy vào lớp học rất suôn sẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"integration"},"foreign":{"definition":"(thuộc) Nước ngoài, từ nước ngoài, ở nước ngoài, ngoại quốc.","example":"Learning a foreign language takes a lot of time.","exampleTranslation":"Học một ngoại ngữ cần rất nhiều thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"foreign"},"foreigner":{"definition":"Người đến từ hoặc mang quốc tịch của một quốc gia khác.","example":"A foreigner living in a new country may need time to learn local customs.","exampleTranslation":"Một người nước ngoài sống ở quốc gia mới có thể cần thời gian để tìm hiểu phong tục địa phương.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"foreign"},"multinational":{"definition":"Bao gồm nhiều nước; đa quốc gia.","example":"They work for a large multinational corporation today.","exampleTranslation":"Họ làm việc cho một tập đoàn đa quốc gia lớn ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"multinational"},"oversea":{"definition":"Ngoài nước, hải ngoại.","example":"He works for an oversea company.","exampleTranslation":"Anh ấy làm việc cho một công ty ngoài nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"globalization"},"overseas":{"definition":"Ngoài nước, hải ngoại.","example":"I send letters overseas every summer.","exampleTranslation":"Tôi gửi thư ra nước ngoài mỗi mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"globalization"},"universal":{"definition":"Thuộc vũ trụ, thuộc thế giới, thuộc vạn vật.","example":"The law of universal gravitation applies to everything.","exampleTranslation":"Định luật hấp dẫn thuộc vũ trụ áp dụng cho mọi thứ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"globalization"},"parent":{"definition":"Cha; mẹ.","example":"A loving parent always protects their young child.","exampleTranslation":"Một bậc cha mẹ yêu thương luôn bảo vệ con nhỏ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"parent"},"parental":{"definition":"Cha mẹ.","example":"Parental love can be very strong.","exampleTranslation":"Tình yêu thương của cha mẹ có thể rất mạnh mẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"parent"},"parenthood":{"definition":"Tư cách làm cha mẹ; hàng cha mẹ.","example":"Parenthood changed their daily routine.","exampleTranslation":"Việc làm cha mẹ đã thay đổi thói quen hàng ngày của họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"parent"},"parenting":{"definition":"Việc nuôi nấng con cái.","example":"Parenting takes patience, time, and steady care.","exampleTranslation":"Nuôi dạy con cái đòi hỏi sự kiên nhẫn, thời gian và sự chăm sóc bền bỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"parent"},"adult":{"definition":"Người lớn, người đã trưởng thành.","example":"The adult paid for the ticket.","exampleTranslation":"Người lớn đã trả tiền cho tấm vé.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"adult"},"adulthood":{"definition":"Tuổi khôn lớn, tuổi trưởng thành.","example":"Adulthood brought more duty and less free time.","exampleTranslation":"Tuổi trưởng thành mang đến nhiều trách nhiệm hơn và ít thời gian rảnh rỗi hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"adult"},"upbringing":{"definition":"Sự giáo dục, sự dạy dỗ (trẻ con).","example":"His strict upbringing taught him good manners.","exampleTranslation":"Cách giáo dục nghiêm khắc đã dạy anh ấy cách cư xử tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"upbring"},"educational":{"definition":"Thuộc ngành giáo dục.","example":"She works in educational planning for local schools.","exampleTranslation":"Cô ấy làm việc trong lĩnh vực kế hoạch giáo dục cho các trường học địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"education"},"nurture":{"definition":"Sự chăm sóc và nuôi dưỡng giúp một người hoặc vật phát triển.","example":"The child benefited from the love and nurture of a supportive family.","exampleTranslation":"Đứa trẻ được hưởng lợi từ tình yêu thương và sự nuôi dưỡng của một gia đình luôn hỗ trợ em.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"nurture"},"care":{"definition":"Cái cần phải quan tâm hay chú ý.","example":"She took care of her little brother today.","exampleTranslation":"Cô ấy đã chăm sóc em trai mình vào hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"care"},"careful":{"definition":"Cẩn thận, thận trọng, biết giữ gìn, biết lưu ý.","example":"Please be careful when you cross the busy street.","exampleTranslation":"Hãy cẩn thận khi bạn băng qua con đường đông đúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"care"},"careless":{"definition":"Không để ý, không lưu ý, không chú ý, sơ ý, không cẩn thận, cẩu thả; không chính xác.","example":"He made a careless mistake on the final exam.","exampleTranslation":"Anh ấy đã mắc một sai lầm bất cẩn trong kỳ thi cuối kỳ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"care"},"childcare":{"definition":"Giám sát, chăm sóc trẻ em.","example":"Childcare takes patience and attention.","exampleTranslation":"Việc chăm sóc trẻ em cần sự kiên nhẫn và chú tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"childcare"},"paternally":{"definition":"Thuộc cha, của cha.","example":"She answered paternally and smiled.","exampleTranslation":"Cô ấy trả lời một cách đầy bao dung như một người cha và mỉm cười.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"paternal"},"sibling":{"definition":"Anh (chị, em) ruột.","example":"Her sibling lives in another city.","exampleTranslation":"Anh chị em của cô ấy đang sống ở một thành phố khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sibling"},"aging":{"definition":"Sự hoá già.","example":"Aging changes the body in many ways.","exampleTranslation":"Quá trình lão hóa thay đổi cơ thể theo nhiều cách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"aging","spellingNote":"British spelling: ageing."},"marriage":{"definition":"Sự cưới xin, sự kết hôn, hôn nhân.","example":"They are planning their marriage for next summer.","exampleTranslation":"Họ đang lên kế hoạch cho đám cưới của mình vào mùa hè tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"marriage"},"marriageable":{"definition":"Có thể kết hôn.","example":"She is marriageable and ready for love.","exampleTranslation":"Cô ấy đã đến tuổi kết hôn và sẵn sàng cho tình yêu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"marriage"},"birth":{"definition":"Sự sinh đẻ.","example":"The birth of a baby is a joyful event.","exampleTranslation":"Sự ra đời của một đứa bé là một sự kiện đầy niềm vui.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"birth"},"mother":{"definition":"Nguồn gốc, nguyên nhân; mẹ ((nghĩa bóng)).","example":"Necessity is often called the mother of invention.","exampleTranslation":"Sự cần thiết thường được gọi là mẹ đẻ của phát minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"mother"},"motherhood":{"definition":"Chức năng làm mẹ, bổn phận làm mẹ.","example":"She learned much about motherhood from her aunt.","exampleTranslation":"Cô ấy đã học hỏi nhiều về thiên chức làm mẹ từ dì của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"mother"},"motherless":{"definition":"Mồ côi mẹ.","example":"The motherless child looked for a home.","exampleTranslation":"Đứa trẻ không mẹ đã tìm kiếm một mái ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"mother"},"father":{"definition":"người cha, người đẻ ra, người sản sinh ra.","example":"He is a loving father to his children.","exampleTranslation":"Anh ấy là một người cha yêu thương các con của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"father"},"fatherhood":{"definition":"Cương vị làm cha, cương vị làm bố.","example":"He felt pride in fatherhood every day.","exampleTranslation":"Anh ấy cảm thấy tự hào về thiên chức làm cha mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"father"},"fatherless":{"definition":"Không có cha, không có bố, mồ côi cha.","example":"The fatherless boy lived with his grandmother.","exampleTranslation":"Cậu bé không cha sống cùng với bà của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"father"},"household":{"definition":"Gia đình, (thuộc) hộ; nội trợ.","example":"They are doing all the household chores today.","exampleTranslation":"Họ đang làm tất cả các công việc nhà vào hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"household"},"householder":{"definition":"Người thuê nhà.","example":"The householder paid the rent on time.","exampleTranslation":"Chủ hộ đã trả tiền thuê nhà đúng hạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"household"},"adolescent":{"definition":"Đang tuổi thiếu niên, trẻ.","example":"The adolescent girl enjoys playing the piano.","exampleTranslation":"Cô gái thiếu niên thích chơi đàn piano.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"family"},"adopt":{"definition":"Theo, làm theo, thái dụng.","example":"They decided to adopt a new strategy for the project.","exampleTranslation":"Họ quyết định áp dụng một chiến lược mới cho dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"adoption":{"definition":"Sự nhận làm con nuôi; sự nhận làm bố mẹ nuôi.","example":"Their adoption gave the child a loving home.","exampleTranslation":"Việc nhận làm con nuôi của họ đã mang lại cho đứa trẻ một mái ấm đầy yêu thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"aged":{"definition":"Làm cho già đi.","example":"They aged the cheese in a cool room.","exampleTranslation":"Họ làm cho phô mai già đi trong một căn phòng mát mẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"ageing":{"definition":"Sự hoá già.","example":"Ageing can change the color of the fabric.","exampleTranslation":"Sự hoá già có thể làm thay đổi màu sắc của vải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"baby":{"definition":"em bé; trẻ sơ sinh","example":"I used to be a baby but now I am an adult.","exampleTranslation":"Tôi từng là một em bé nhưng bây giờ tôi là người lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"family"},"brother":{"definition":"Anh; em trai.","example":"My brother is taller than me by two inches.","exampleTranslation":"Anh trai của tôi cao hơn tôi hai inch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"couple":{"definition":"Đôi, cặp.","example":"A couple of girls are waiting for us.","exampleTranslation":"Một cặp cô gái đang đợi chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"cousin":{"definition":"Các hạ (tiếng vua xưng hô với nhau).","example":"The king greeted his cousin politely.","exampleTranslation":"Nhà vua chào hỏi các hạ của mình một cách lịch sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"cuddle":{"definition":"Sự ôm ấp, sự âu yếm, sự vuốt ve.","example":"The child wanted a warm cuddle before bed.","exampleTranslation":"Đứa trẻ muốn một cái ôm ấp ấm áp trước khi ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"daughter":{"definition":"Con gái.","example":"Their daughter loves to read at night.","exampleTranslation":"Con gái họ thích đọc sách vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"descend":{"definition":"Xuống, dốc xuống, rơi xuống, lăn xuống, đi xuống, tụt xuống...","example":"The hill will descend sharply after the bridge.","exampleTranslation":"Đồi sẽ dốc xuống đột ngột sau cây cầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"foster":{"definition":"Nuôi dưỡng, nuôi nấng.","example":"Parents should foster a child with love and care.","exampleTranslation":"Cha mẹ nên nuôi dưỡng một đứa trẻ với tình yêu và sự quan tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"grandmother":{"definition":"Nuông chiều, nâng niu (như bà đối với cháu).","example":"She grandmother the sleepy child to bed.","exampleTranslation":"Bà đã nuông chiều đứa trẻ đang buồn ngủ lên giường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"honeymoon":{"definition":"Tuần trăng mật.","example":"They spent their honeymoon by the sea.","exampleTranslation":"Họ đã dành tuần trăng mật của mình bên bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"housework":{"definition":"Công việc trong nhà (nấu ăn, giặt, quét dọn).","example":"Housework kept her busy all morning.","exampleTranslation":"Công việc trong nhà giữ cô ấy bận rộn suốt cả buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"husband":{"definition":"Người quản lý, người trông nom (việc chi tiêu... ).","example":"She is the husband of the small shop.","exampleTranslation":"Cô ấy là người quản lý của cửa hàng nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"infant":{"definition":"Người vị thành niên.","example":"As an infant, he needed help with everything.","exampleTranslation":"Khi còn là một người vị thành niên, cậu ấy cần giúp đỡ với mọi thứ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"kids":{"definition":"Động từ chia ở ngôi thứ ba số ít của kid","example":"She kids her friends with small jokes.","exampleTranslation":"Cô ấy trêu đùa bạn bè mình bằng những câu đùa nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"marry":{"definition":"Lấy vợ cho, lấy chồng cho, gả, làm lễ cưới cho ở nhà thờ.","example":"They plan to marry off their daughter soon.","exampleTranslation":"Họ dự định sẽ sớm gả con gái mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"newborn":{"definition":"Mới sinh.","example":"The newborn baby slept peacefully in the crib.","exampleTranslation":"Em bé mới sinh ngủ yên bình trong nôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"family"},"preschooler":{"definition":"Trẻ chưa đến tuổi đến trường; trẻ chưa đến tuổi đi học.","example":"The preschooler carried a tiny bag to class.","exampleTranslation":"Đứa trẻ mẫu giáo mang một chiếc túi nhỏ đến lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"sister":{"definition":"Chị, em gái.","example":"My sister lives in a small house near the park.","exampleTranslation":"Chị gái tôi sống trong một ngôi nhà nhỏ gần công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"spouse":{"definition":"; (từ cổ, nghĩa cổ) chồng; vợ.","example":"They discussed the spouse today.","exampleTranslation":"Họ đã thảo luận về người vợ/chồng hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"teenager":{"definition":"Cách viết khác : teener.","example":"The teenager wanted to join the club.","exampleTranslation":"Thiếu niên đó muốn tham gia câu lạc bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"unloved":{"definition":"Không được yêu, không được ưa.","example":"The lonely dog looked unloved.","exampleTranslation":"Chú chó cô đơn trông thật không được yêu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"family"},"wean":{"definition":"Làm cho bỏ, làm cho dứt bỏ.","example":"They want to wean the child from sweets.","exampleTranslation":"Họ muốn làm cho đứa trẻ dứt bỏ khỏi đồ ngọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"wedding":{"definition":"hiện tại phân từ của wed","example":"They are wedding the two families.","exampleTranslation":"Họ đang làm lễ cưới cho hai gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"family"},"wife":{"definition":"Người đàn bà; bà già.","example":"His wife smiled at the guests.","exampleTranslation":"Vợ anh ấy mỉm cười với các vị khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"youngster":{"definition":"Người thanh niên; đứa bé con; đứa con trai.","example":"The youngster asked many simple questions.","exampleTranslation":"Người thanh niên đã hỏi nhiều câu hỏi đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"family"},"acquisition":{"definition":"Quá trình tiếp thu kiến thức hoặc kỹ năng, đặc biệt là việc học và sử dụng ngôn ngữ.","example":"Early vocabulary acquisition is strongly influenced by interaction, repetition, and the richness of linguistic input.","exampleTranslation":"Việc tiếp thu từ vựng ban đầu chịu ảnh hưởng mạnh mẽ của sự tương tác, việc lặp lại và mức độ phong phú của đầu vào ngôn ngữ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"language"},"language":{"definition":"Tiếng, ngôn ngữ.","example":"She can speak three different language options.","exampleTranslation":"Cô ấy có thể nói ba ngôn ngữ khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"linguist":{"definition":"Người biết nhiều thứ tiếng.","example":"She is a linguist and speaks five languages.","exampleTranslation":"Cô ấy là một nhà ngôn ngữ học và nói được năm thứ tiếng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"linguist"},"linguistic":{"definition":"Ngôn ngữ, (thuộc) ngôn ngữ học.","example":"The course covers linguistic patterns in speech.","exampleTranslation":"Khóa học bao gồm các mô thức ngôn ngữ trong lời nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"linguist"},"bilingual":{"definition":"Sử dụng hai thứ tiếng, thông thạo hai thứ tiếng, song ngữ.","example":"She is bilingual and reads both labels.","exampleTranslation":"Cô ấy biết hai ngôn ngữ và đọc được cả hai nhãn dán.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"bilingual"},"multilingual":{"definition":"Nói được nhiều thứ tiếng.","example":"The guide was multilingual and helpful.","exampleTranslation":"Người hướng dẫn biết nhiều ngôn ngữ và rất hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"multilingual"},"illiteracy":{"definition":"Nạn mù chữ, sự vô học, sự thất học.","example":"Illiteracy still affects many adults.","exampleTranslation":"Nạn mù chữ vẫn ảnh hưởng đến nhiều người trưởng thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"illiteracy"},"vocabulary":{"definition":"Từ vựng.","example":"Her vocabulary grows with daily reading.","exampleTranslation":"Vốn từ vựng của cô ấy phát triển nhờ việc đọc sách hàng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"vocabulary"},"grammar":{"definition":"Văn phạm, ngữ pháp.","example":"You need to study basic grammar every day.","exampleTranslation":"Bạn cần học ngữ pháp cơ bản mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"grammar"},"pronunciation":{"definition":"Sự phát âm, sự đọc.","example":"Her pronunciation is clear and calm.","exampleTranslation":"Cách phát âm của cô ấy rất rõ ràng và điềm tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"pronunciation"},"translation":{"definition":"Sự dịch; bản (bài) dịch.","example":"I need a good translation of this book.","exampleTranslation":"Tôi cần một bản dịch tốt cho cuốn sách này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"translation"},"translational":{"definition":"; (kỹ thuật) tịnh tiến.","example":"The machine moves in a translational motion.","exampleTranslation":"Cỗ máy di chuyển theo chuyển động tịnh tiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"translation"},"interpret":{"definition":"Giải thích, làm sáng tỏ.","example":"Can you interpret the hidden meaning of this poem?","exampleTranslation":"Bạn có thể giải thích ý nghĩa ẩn dụ của bài thơ này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"interpret"},"interpretable":{"definition":"Có thể hiểu được (một cách nào đó).","example":"The note is interpretable even with simple English.","exampleTranslation":"Ghi chú này có thể hiểu được ngay cả với vốn tiếng Anh đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"interpret"},"interpretation":{"definition":"Sự giải thích, sự làm sáng tỏ, sự lý giải.","example":"Her interpretation made the poem easier to understand.","exampleTranslation":"Cách diễn giải của cô ấy giúp bài thơ trở nên dễ hiểu hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"interpret"},"interpretative":{"definition":"Để giải thích.","example":"The interpretative notes clarified the poem.","exampleTranslation":"Các ghi chú giải thích đã làm sáng tỏ bài thơ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"interpret"},"interpreted":{"definition":"Quá khứ và phân từ quá khứ của interpret","example":"She interpreted the sign correctly.","exampleTranslation":"Cô ấy đã giải mã ký hiệu đó một cách chính xác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"interpret"},"interpreter":{"definition":"Người giải thích, người làm sáng tỏ.","example":"She acted as an interpreter during the meeting.","exampleTranslation":"Cô ấy đã đóng vai trò là thông dịch viên trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"interpret"},"interpreting":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của interpret.","example":"She was interpreting the poem for us.","exampleTranslation":"Cô ấy đang diễn giải bài thơ cho chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"interpret"},"interpretive":{"definition":"Để giải thích.","example":"The interpretive guide explained the painting well.","exampleTranslation":"Bản hướng dẫn giải thích đã làm rõ bức tranh rất tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"interpret"},"dialect":{"definition":"Tiếng địa phương, phương ngôn, phương ngữ.","example":"My grandmother speaks a local dialect.","exampleTranslation":"Bà của tôi nói một phương ngữ địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"dialect"},"dialectal":{"definition":"(Thuộc) Tiếng địa phương, (thuộc) phương ngôn.","example":"The dialectal word sounded different to her.","exampleTranslation":"Từ ngữ địa phương đó nghe có vẻ khác lạ đối với cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"dialect"},"accent":{"definition":"Dấu trọng âm.","example":"Please put an acute accent on that letter.","exampleTranslation":"Vui lòng đặt dấu sắc trên chữ cái đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"accent"},"accented":{"definition":"Quá khứ và phân từ quá khứ của accent","example":"He accented the final syllable carefully.","exampleTranslation":"Anh ấy đã nhấn trọng âm vào âm tiết cuối cùng một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"accent"},"verbal":{"definition":"Từ, (thuộc) lời.","example":"Please provide a verbal explanation for your absence.","exampleTranslation":"Vui lòng cung cấp giải thích bằng lời cho việc bạn vắng mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"verbal"},"verbalise":{"definition":"Phát biểu bằng lời nói.","example":"She will verbalise her answer after the break.","exampleTranslation":"Cô ấy sẽ diễn đạt câu trả lời của mình thành lời sau giờ giải lao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"verbal","spellingNote":"Alternate spelling: verbalize."},"verbalism":{"definition":"Sự phát biểu bằng lời nói; lời nói; câu văn; từ ngữ.","example":"His writing relied on simple verbalism.","exampleTranslation":"Cách viết của anh ấy dựa vào những diễn đạt bằng lời đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"verbal"},"verbalist":{"definition":"Nhà phê bình về từ.","example":"The verbalist loved careful language and detail.","exampleTranslation":"Người chuộng lời văn này yêu thích ngôn ngữ và chi tiết cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"verbal"},"verbalization":{"definition":"Sự phát biểu bằng lời nói.","example":"The verbalization of his idea took some time.","exampleTranslation":"Việc diễn đạt ý tưởng của anh ấy bằng lời mất một thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"verbal"},"verbalize":{"definition":"Động từ hoá.","example":"We verbalize the noun by adding a suffix.","exampleTranslation":"Chúng tôi chuyển đổi danh từ thành động từ bằng cách thêm hậu tố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"verbal","spellingNote":"British spelling: verbalise."},"speech":{"definition":"Khả năng nói, năng lực nói.","example":"He lost the power of speech recently.","exampleTranslation":"Anh ấy mới bị mất khả năng nói gần đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"speech"},"speechless":{"definition":"Không nói được, mất tiếng; lặng thinh, lặng đi không nói được.","example":"I was speechless with rage at his actions.","exampleTranslation":"Tôi không nói nên lời vì quá giận dữ trước hành động của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"speech"},"writing":{"definition":"Sự viết, sự viết tay, sự viết lách.","example":"She spent all afternoon busy in writing her novel.","exampleTranslation":"Cô ấy dành cả buổi chiều bận rộn với việc viết tiểu thuyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"writing"},"reading":{"definition":"Sự đọc, sự xem (sách, báo... ).","example":"She spent the whole afternoon fond of reading books.","exampleTranslation":"Cô ấy dành cả buổi chiều để đọc sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"reading"},"expression":{"definition":"Sự vắt, sự ép, sự bóp.","example":"Cold expression is used to extract oil from seeds without heat.","exampleTranslation":"Phương pháp ép lạnh được dùng để chiết xuất dầu từ hạt mà không cần nhiệt.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"expression"},"expressionism":{"definition":"Chủ nghĩa biểu hiện.","example":"Expressionism often uses bold colors and shapes.","exampleTranslation":"Chủ nghĩa biểu hiện thường sử dụng các màu sắc và hình khối đậm nét.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"expression"},"expressionist":{"definition":"Người theo chủ nghĩa biểu hiện.","example":"The expressionist used bold colors and shapes.","exampleTranslation":"Họa sĩ theo trường phái biểu hiện đã sử dụng các màu sắc và hình khối đậm nét.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"expression"},"expressionless":{"definition":"Không có tinh thần, đờ ra, ngây ra (mặt... ); không diễn cảm (giọng nói... ).","example":"He gave an expressionless answer to the question.","exampleTranslation":"Anh ấy trả lời câu hỏi với vẻ mặt không cảm xúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"expression"},"fluency":{"definition":"Sự lưu loát, sự trôi chảy.","example":"Her fluency in English improved quickly.","exampleTranslation":"Sự trôi chảy trong tiếng Anh của cô ấy đã cải thiện nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"fluency"},"affirmative":{"definition":"Khẳng định; quả quyết.","example":"Please give me an affirmative answer by tomorrow morning.","exampleTranslation":"Vui lòng cho tôi một câu trả lời khẳng định vào sáng mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"allude":{"definition":"Nói bóng gió, ám chỉ.","example":"Did you allude to his secret plan?","exampleTranslation":"Bạn đã nói bóng gió đến kế hoạch bí mật của anh ấy chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"alphabet":{"definition":"Bảng chữ cái, hệ thống chữ cái.","example":"Children learn the alphabet before reading.","exampleTranslation":"Trẻ em học bảng chữ cái trước khi đọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"alphabetic":{"definition":"(thuộc) Bảng chữ cái, (thuộc) hệ thống chữ cái.","example":"The alphabetic code uses letters instead of numbers.","exampleTranslation":"Mã hệ thống chữ cái sử dụng các chữ cái thay vì số.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"anecdote":{"definition":"Chuyện vặt, giai thoại.","example":"He told an anecdote about school days.","exampleTranslation":"Anh ấy đã kể một giai thoại về những ngày đi học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"aptly":{"definition":"Thông minh, khéo léo, nhanh trí.","example":"She answered aptly and smiled.","exampleTranslation":"Cô ấy trả lời một cách thông minh rồi mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"articulation":{"definition":"Khớp.","example":"The articulation of the toy arm was loose.","exampleTranslation":"Khớp của cánh tay đồ chơi bị lỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"asked":{"definition":"Dạng quá khứ đơn và phân từ quá khứ của ask","example":"She asked a simple question in class.","exampleTranslation":"Cô ấy đã đặt một câu hỏi đơn giản trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"asking":{"definition":"hiện tại phân từ của ask.","example":"He is asking for help with homework.","exampleTranslation":"Anh ấy đang yêu cầu sự giúp đỡ với bài tập về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"asks":{"definition":"Động từ chia ở ngôi thứ ba số ít của ask","example":"He asks for directions when lost.","exampleTranslation":"Anh ấy hỏi đường khi bị lạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"babble":{"definition":"Sự nói lảm nhảm, sự.","example":"His babble made the meeting hard to follow.","exampleTranslation":"Sự nói lảm nhảm của anh ấy làm cuộc họp khó theo dõi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"buzzword":{"definition":"Từ thường dùng, thuật ngữ thông dụng.","example":"The team used the same buzzword again.","exampleTranslation":"Cả đội lại sử dụng thuật ngữ thông dụng đó lần nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"caller":{"definition":"Người đến thăm, người gọi.","example":"A caller asked for directions at the door.","exampleTranslation":"Người đến thăm đã hỏi đường ở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"chat":{"definition":"Bàn chuyện, tán gẫu, trò chuyện","example":"We chat about our day every morning.","exampleTranslation":"Chúng tôi tán gẫu về ngày của mình mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"chatter":{"definition":"Tiếng lập cập (răng).","example":"I heard chatter from my teeth in the cold.","exampleTranslation":"Tôi nghe thấy tiếng răng mình lập cập trong cái lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"comment":{"definition":"Lời chú giải, lời chú thích, lời dẫn giải.","example":"The teacher added a comment beside the answer.","exampleTranslation":"Giáo viên đã thêm lời chú thích bên cạnh câu trả lời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"commentary":{"definition":"Lời chú thích, lời dẫn giải.","example":"Read the commentary at the bottom of the page.","exampleTranslation":"Hãy đọc lời dẫn giải ở cuối trang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"communicate":{"definition":"Truyền; truyền đạt, thông tri.","example":"Please communicate the news to the whole team.","exampleTranslation":"Vui lòng truyền đạt tin tức cho cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"concise":{"definition":"Ngắn gọn, súc tích (văn).","example":"Please give a concise answer to the question.","exampleTranslation":"Vui lòng đưa ra câu trả lời ngắn gọn cho câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"conjunction":{"definition":"Cơ hội trùng hợp; sự kiện kết hợp.","example":"Their success came by a rare conjunction of luck.","exampleTranslation":"Thành công của họ đến bởi sự kết hợp hiếm có của vận may.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"consonant":{"definition":"Hoà hợp, phù hợp.","example":"The new plan is consonant with our main goals.","exampleTranslation":"Kế hoạch mới hoà hợp với các mục tiêu chính của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"context":{"definition":"Văn cảnh, ngữ cảnh, mạch văn.","example":"You must consider the context before making a judgment.","exampleTranslation":"Bạn phải cân nhắc ngữ cảnh trước khi đưa ra phán xét.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"contextual":{"definition":"Văn cảnh, (thuộc) ngữ cảnh, (thuộc) mạch văn.","example":"Please consider the contextual meaning of this phrase.","exampleTranslation":"Vui lòng cân nhắc ý nghĩa ngữ cảnh của cụm từ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"contraction":{"definition":"Sự tiêm nhiễm, sự mắc (bệnh, nợ).","example":"He suffered from a contraction of a bad habit.","exampleTranslation":"Anh ấy đã chịu đựng sự tiêm nhiễm của một thói quen xấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"conversation":{"definition":"Sự nói chuyện; cuộc nói chuyện, cuộc chuyện trò, cuộc đàm luận.","example":"I enjoyed having a long conversation with my old friend.","exampleTranslation":"Tôi rất thích trò chuyện lâu với người bạn cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"converse":{"definition":"Nói chuyện, chuyện trò.","example":"We converse after dinner about school and friends.","exampleTranslation":"Chúng tôi trò chuyện sau bữa tối về trường học và bạn bè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"conversely":{"definition":"ngược lại; trái lại","example":"The over-confident driver may drive too fast. Conversely the under-confident person may also cause problems by driving too slowly.","exampleTranslation":"Người lái xe quá tự tin có thể lái quá nhanh. Ngược lại, người thiếu tự tin cũng có thể gây ra vấn đề bằng cách lái xe quá chậm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"language"},"convey":{"definition":"Truyền (âm thanh, hương vị, lệnh, tin); truyền đạt, chuyển.","example":"Please convey my best wishes to your family.","exampleTranslation":"Làm ơn chuyển lời chúc tốt đẹp nhất của tôi tới gia đình bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"correspond":{"definition":"Xứng, tương ứng, phù hợp; đúng với.","example":"Your actions do not correspond to your words.","exampleTranslation":"Hành động của bạn không tương ứng với lời nói của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"correspondence":{"definition":"Sự xứng nhau, sự tương ứng; sự phù hợp.","example":"There is a close correspondence between the two lists.","exampleTranslation":"Có sự tương ứng chặt chẽ giữa hai danh sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"define":{"definition":"Định nghĩa (một từ... ).","example":"Can you define this new word for me?","exampleTranslation":"Bạn có thể định nghĩa từ mới này cho tôi không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"definite":{"definition":"Xác định, định rõ.","example":"Please give me a definite time for the meeting.","exampleTranslation":"Vui lòng cho tôi một thời gian xác định cho cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"definitely":{"definition":"Rạch ròi, dứt khoát.","example":"She spoke definitely during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện một cách rạch ròi trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"definition":{"definition":"Sự định nghĩa, lời định nghĩa.","example":"Please write the definition in simple words.","exampleTranslation":"Vui lòng viết lời định nghĩa bằng những từ đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"definitive":{"definition":"Cuối cùng; dứt khoát.","example":"We need a definitive answer by tomorrow morning.","exampleTranslation":"Chúng tôi cần một câu trả lời cuối cùng vào sáng mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"definitively":{"definition":"Rạch ròi, dứt khoát.","example":"She spoke definitively during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện một cách rạch ròi trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"denote":{"definition":"Có nghĩa là.","example":"The symbol can denote a warning.","exampleTranslation":"Biểu tượng có nghĩa là một cảnh báo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"describe":{"definition":"Vạch, vẽ.","example":"Can you describe a circle using these tools?","exampleTranslation":"Bạn có thể mô tả một vòng tròn bằng cách sử dụng các công cụ này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"description":{"definition":"Sự tả, sự diễn tả, sự mô tả, sự miêu tả.","example":"The beauty of the sunset was beyond description.","exampleTranslation":"Vẻ đẹp của hoàng hôn là không thể tả được.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"dialogue":{"definition":"Đoạn văn đối thoại; tác phẩm đối thoại.","example":"She enjoyed reading a dialogue between two friends.","exampleTranslation":"Cô ấy thích đọc một đoạn văn đối thoại giữa hai người bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"dictionary":{"definition":"Có tính chất từ điển, có tính chất sách vở.","example":"The report was written in a dictionary style.","exampleTranslation":"Báo cáo được viết theo phong cách từ điển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"disagree":{"definition":"Khác, không giống, không khớp.","example":"Do these two accounts disagree on the price?","exampleTranslation":"Hai bản kê khai đó có không khớp về giá cả không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"disagreement":{"definition":"Sự không hợp, sự không thích hợp.","example":"The map showed a disagreement in the labels.","exampleTranslation":"Bản đồ cho thấy sự không thích hợp trong các nhãn ghi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"discuss":{"definition":"Ăn uống ngon lành thích thú (món ăn, rượu).","example":"He can really discuss a full plate of rice.","exampleTranslation":"Anh ấy thực sự có thể ăn uống ngon lành một đĩa cơm đầy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"discussion":{"definition":"Sự thảo luận, sự bàn cãi, sự tranh luận; cuộc thảo luận, cuộc bàn cãi, cuộc tranh luận.","example":"The topic is currently under discussion by the board.","exampleTranslation":"Chủ đề hiện đang được ban quản trị thảo luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"emphasis":{"definition":"Sự nhấn mạnh; (ngôn ngữ học) sự nhấn giọng.","example":"The speaker used emphasis on the main word.","exampleTranslation":"Người nói đã sử dụng sự nhấn giọng vào từ chính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"emphasize":{"definition":"Nhấn mạnh.","example":"Please emphasize the main idea in your talk.","exampleTranslation":"Vui lòng nhấn mạnh ý chính trong bài phát biểu của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"exaggerate":{"definition":"Thổi phồng, phóng đại, cường điệu.","example":"Please do not exaggerate the problem.","exampleTranslation":"Xin đừng thổi phồng vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"exclaim":{"definition":"Kêu lên, la lên.","example":"She had to exclaim when she saw the score.","exampleTranslation":"Cô ấy đã phải la lên khi nhìn thấy điểm số.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"explain":{"definition":"Giảng, giảng giải, giải nghĩa.","example":"Can you explain this rule again?","exampleTranslation":"Bạn có thể giảng lại quy tắc này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"explanation":{"definition":"Sự giảng, sự giảng giải, sự giải nghĩa, lời giảng, lời giải nghĩa.","example":"Her explanation was clear and easy to follow.","exampleTranslation":"Lời giảng của cô ấy rất rõ ràng và dễ theo dõi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"explicitly":{"definition":"một cách rõ ràng; minh bạch","example":"Religion is explicitly mentioned four times in the text.","exampleTranslation":"Tôn giáo được nhắc đến một cách rõ ràng bốn lần trong văn bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"language"},"express":{"definition":"Nói rõ, rõ ràng.","example":"Please give me an express order for some coffee.","exampleTranslation":"Vui lòng cho tôi một đơn hàng nói rõ cho một ít cà phê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"expressive":{"definition":"Có ý nghĩa.","example":"Her expressive eyes showed real worry.","exampleTranslation":"Đôi mắt có ý nghĩa của cô ấy cho thấy sự lo lắng thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"fluent":{"definition":"Lưu loát, trôi chảy, viết lưu loát.","example":"She is fluent in three languages.","exampleTranslation":"Cô ấy nói lưu loát ba ngôn ngữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"gesture":{"definition":"Điệu bộ, cử chỉ.","example":"He made a small gesture to thank her.","exampleTranslation":"Anh ấy đã có một cử chỉ nhỏ để cảm ơn cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"grammarian":{"definition":"Nhà ngữ pháp.","example":"The grammarian explained the rule clearly.","exampleTranslation":"Nhà ngữ pháp đã giải thích quy tắc một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"grammatical":{"definition":"theo ngữ pháp.","example":"Please check your essay for any grammatical errors.","exampleTranslation":"Vui lòng kiểm tra bài luận của bạn để tìm các lỗi theo ngữ pháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"greet":{"definition":"Chào, chào hỏi, đón chào.","example":"You should greet your guests with a warm smile.","exampleTranslation":"Bạn nên chào hỏi khách của mình bằng một nụ cười ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"greeting":{"definition":"Lời chào mừng, lời chúc mừng.","example":"Their greeting marked the start of the meeting.","exampleTranslation":"Lời chào mừng của họ đã đánh dấu sự bắt đầu của cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"indicative":{"definition":"Indicative mood lối trình bày.","example":"He used the indicative form in the sentence.","exampleTranslation":"Anh ấy đã sử dụng lối trình bày trong câu đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"interrupt":{"definition":"Ngắt lời.","example":"Please do not interrupt me while I speak.","exampleTranslation":"Xin đừng ngắt lời tôi trong khi tôi đang nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"interruption":{"definition":"Sự gián đoạn; sự bị gián đoạn, sự đứt quãng.","example":"A power cut caused an interruption in the game.","exampleTranslation":"Cắt điện gây ra sự gián đoạn trong trò chơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"intonation":{"definition":"Ngữ điệu.","example":"His intonation changed when he asked the question.","exampleTranslation":"Ngữ điệu của anh ấy thay đổi khi anh ta đặt câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"jargon":{"definition":"Tiếng hót líu lo (chim).","example":"The bird's jargon sounded soft and clear.","exampleTranslation":"Tiếng hót líu lo của con chim nghe nhẹ nhàng và rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"linguistics":{"definition":"Ngôn ngữ học.","example":"Linguistics helps us study how language changes.","exampleTranslation":"Ngôn ngữ học giúp chúng ta nghiên cứu cách ngôn ngữ thay đổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"listen":{"definition":"Nghe, lắng nghe.","example":"You should listen to me carefully now.","exampleTranslation":"Bây giờ bạn nên lắng nghe tôi cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"listener":{"definition":"Người nghe, thính giả.","example":"You need to be a good listener today.","exampleTranslation":"Hôm nay bạn cần trở thành một người nghe tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"literal":{"definition":"Chữ; bằng chữ; theo nghĩa của chữ, theo nghĩa đen.","example":"Please provide a literal translation of this poem.","exampleTranslation":"Làm ơn cung cấp một bản dịch chữ của bài thơ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"literally":{"definition":"Thật vậy, đúng là.","example":"The room was literally filled with smoke.","exampleTranslation":"Căn phòng thật vậy đã đầy khói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"mandarin":{"definition":"Tiếng Trung Quốc phổ thông, tiếng Quan Thoại.","example":"She speaks mandarin at home with her family.","exampleTranslation":"Cô ấy nói tiếng Quan Thoại ở nhà với gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"meaningful":{"definition":"Đầy ý nghĩa, có ý nghĩa.","example":"Her story had a meaningful message.","exampleTranslation":"Câu chuyện của cô ấy có một thông điệp đầy ý nghĩa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"meaningless":{"definition":"Vô nghĩa.","example":"The answer was meaningless without context.","exampleTranslation":"Câu trả lời vô nghĩa nếu không có ngữ cảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"mention":{"definition":"Sự tuyên dương.","example":"He got a mention for his brave work.","exampleTranslation":"Anh ấy có một sự tuyên dương vì công việc dũng cảm của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"metaphor":{"definition":"Phép ẩn dụ.","example":"She used a metaphor to explain the feeling.","exampleTranslation":"Cô ấy đã sử dụng một phép ẩn dụ để giải thích cảm giác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"misinterpret":{"definition":"Hiểu sai, giải thích sai.","example":"Do not misinterpret my short reply.","exampleTranslation":"Đừng giải thích sai câu trả lời ngắn gọn của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"mistranslation":{"definition":"Bản dịch sai.","example":"We found a mistranslation in the old book.","exampleTranslation":"Chúng tôi tìm thấy một bản dịch sai trong cuốn sách cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"misunderstanding":{"definition":"Sự hiểu lầm.","example":"A misunderstanding caused the meeting to end.","exampleTranslation":"Một sự hiểu lầm đã khiến cuộc họp kết thúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"misunderstand":{"definition":"Hiểu lầm, hiểu sai.","example":"They misunderstand each other sometimes.","exampleTranslation":"Đôi khi họ hiểu lầm nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"namely":{"definition":"Là, ấy là.","example":"The team finished namely and left.","exampleTranslation":"Đội đã hoàn thành, cụ thể là họ đã rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"narrative":{"definition":"Dưới hình thức kể chuyện; có tính chất tường thuật.","example":"The report was written in a narrative tone.","exampleTranslation":"Bản báo cáo được viết bằng giọng điệu tường thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"narrator":{"definition":"Người chuyện kể, người tường thuật.","example":"The narrator spoke clearly through the entire story.","exampleTranslation":"Người kể chuyện đã nói rõ ràng trong suốt câu chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"nevertheless":{"definition":"Tuy nhiên, tuy thế mà.","example":"It was raining; nevertheless, we went outside.","exampleTranslation":"Trời đang mưa; tuy nhiên, chúng tôi vẫn đi ra ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"nickname":{"definition":"Tên hiệu; tên riêng; tên nhạo, tên giễu.","example":"His nickname was given by his friends.","exampleTranslation":"Tên hiệu của anh ấy được bạn bè đặt cho.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"nonetheless":{"definition":"Tuy nhiên, dù sao.","example":"It was hard, nonetheless, she finished.","exampleTranslation":"Việc đó rất khó khăn, dù sao cô ấy vẫn hoàn thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"language"},"nonsense":{"definition":"lời nói vô lý, lời nói vô nghĩa; chuyện vô lý; lời nói càn, lời nói bậy; hành động ngu dại, hành động bậy bạ.","example":"Stop talking nonsense and listen to me now.","exampleTranslation":"Đừng nói chuyện vô lý nữa và lắng nghe tôi ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"noun":{"definition":"Danh từ.","example":"A noun names a person, place, or thing.","exampleTranslation":"Danh từ chỉ người, nơi chốn, hoặc vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"obscure":{"definition":"Không rõ nghĩa, tối nghĩa.","example":"The poem was written in an obscure style.","exampleTranslation":"Bài thơ được viết theo một phong cách tối nghĩa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"overemphasize":{"definition":"Nhấn mạnh quá mức.","example":"Do not overemphasize one small mistake.","exampleTranslation":"Đừng nhấn mạnh quá mức vào một sai lầm nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"phrase":{"definition":"Câu nói.","example":"She saw the phrase near the door.","exampleTranslation":"Cô ấy nhìn thấy câu nói gần cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"pronounce":{"definition":"Tuyên bố.","example":"The doctor will pronounce a patient out of danger soon.","exampleTranslation":"Bác sĩ sẽ sớm tuyên bố bệnh nhân đã qua cơn nguy kịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"punctuate":{"definition":"Nhấn mạnh.","example":"He raised his hand to punctuate his point.","exampleTranslation":"Anh ấy giơ tay lên để nhấn mạnh ý kiến của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"relate":{"definition":"Kể lại, thuật lại.","example":"Can you relate a story about your childhood?","exampleTranslation":"Bạn có thể kể lại một câu chuyện về thời thơ ấu của mình không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"relation":{"definition":"Sự liên lạc, mối quan hệ, mối tương quan, mối liên hệ.","example":"What is the relation between these two events?","exampleTranslation":"Mối quan hệ giữa hai sự kiện này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"remark":{"definition":"Sự nhận xét; lời phê bình, lời bình luận.","example":"She made no remark about his messy room.","exampleTranslation":"Cô ấy không đưa ra nhận xét nào về căn phòng bừa bộn của anh ấy. [L11]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"repeat":{"definition":"Phần chỉ lại; dấu chỉ phần trở lại.","example":"Look for the repeat mark in the pattern.","exampleTranslation":"Hãy tìm dấu chỉ lặp lại trong mẫu này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"repetition":{"definition":"Sự nhắc lại, sự lặp lại; điều nhắc lại, điều lặp lại.","example":"The repetition helped him learn the new words.","exampleTranslation":"Việc lặp đi lặp lại đã giúp anh ấy học các từ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"repetitious":{"definition":"Có đặc trưng lặp đi lặp lại.","example":"His repetitious speech bored the class.","exampleTranslation":"Bài phát biểu lặp đi lặp lại của anh ta khiến cả lớp phát chán.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"repetitive":{"definition":"Lặp lại.","example":"The repetitive task tired her quickly.","exampleTranslation":"Công việc lặp đi lặp lại đó đã khiến cô ấy nhanh chóng mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"reply":{"definition":"Câu trả lời, lời đáp.","example":"I received your reply in the mail today.","exampleTranslation":"Tôi đã nhận được câu trả lời của bạn qua thư hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"respond":{"definition":"Phản ứng lại.","example":"How did you respond to her sudden question?","exampleTranslation":"Bạn đã phản ứng thế nào với câu hỏi bất ngờ của cô ấy?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"response":{"definition":"Sự đáp lại, sự hưởng ứng.","example":"She gave a quick response to my email.","exampleTranslation":"Cô ấy đã phản hồi nhanh chóng với email của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"retract":{"definition":"Rút lại (lời hứa); rút lui (ý kiến); huỷ bỏ (lời tuyên bố); chối, không nhận, nuốt (lời).","example":"You should retract your statement about the missing money.","exampleTranslation":"Bạn nên rút lại lời tuyên bố của mình về số tiền bị mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"rewrite":{"definition":"Viết lại, chép lại.","example":"Please rewrite the note in clear words.","exampleTranslation":"Vui lòng viết lại ghi chú bằng từ ngữ rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"saying":{"definition":"Tục ngữ, châm ngôn.","example":"As the saying goes, time is money.","exampleTranslation":"Như người ta thường nói, thời gian là tiền bạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"script":{"definition":"Một văn bản.","example":"He kept the script in a drawer.","exampleTranslation":"Anh ấy giữ văn bản trong một ngăn kéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"shorthand":{"definition":"Dùng tốc ký, ghi bằng tốc ký.","example":"She took notes in shorthand during class.","exampleTranslation":"Cô ấy ghi chép bằng tốc ký trong giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"sign":{"definition":"Dấu, dấu hiệu, ký hiệu; mật hiệu.","example":"Look for a sign of life in the desert.","exampleTranslation":"Hãy tìm một dấu hiệu của sự sống trên sa mạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"speaker":{"definition":"Người nói, người diễn thuyết.","example":"The speaker stood up and began to talk.","exampleTranslation":"Người diễn thuyết đứng lên và bắt đầu nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"speak":{"definition":"Nói với, nói chuyện, nói lên.","example":"I will speak to him about the plan.","exampleTranslation":"Tôi sẽ nói chuyện với anh ấy về kế hoạch này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"syllable":{"definition":"Từ, chữ; chi tiết nhỏ.","example":"He did not speak a single syllable today.","exampleTranslation":"Hôm nay anh ấy không nói một từ nào cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"talk":{"definition":"Lời nói.","example":"He is all talk and no action today.","exampleTranslation":"Anh ấy chỉ toàn lời nói suông và chẳng làm gì hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"talker":{"definition":"Người nói; người nói hay, người nói chuyện có duyên.","example":"He is a good talker and keeps people interested.","exampleTranslation":"Anh ấy là một người nói hay và làm cho mọi người thấy thú vị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"tense":{"definition":"Thời (của động từ).","example":"Please conjugate this verb in the present tense.","exampleTranslation":"Vui lòng chia động từ này ở thời hiện tại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"thou":{"definition":"Mày, mi, ngươi.","example":"Thou should stay and help us.","exampleTranslation":"Mày nên ở lại và giúp chúng tao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"tongue":{"definition":"Tiếng, ngôn ngữ.","example":"She speaks three different mother tongue languages fluently.","exampleTranslation":"Cô ấy nói thành thạo ba tiếng khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"translate":{"definition":"Dịch, phiên dịch.","example":"Can you translate this letter into French?","exampleTranslation":"Bạn có thể dịch lá thư này sang tiếng Pháp không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"translator":{"definition":"Người dịch, người phiên dịch, người thông dịch.","example":"The translator helped us understand the letter.","exampleTranslation":"Người dịch đã giúp chúng tôi hiểu lá thư.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"underline":{"definition":"Gạch dưới.","example":"Please underline the most important words in this text.","exampleTranslation":"Vui lòng gạch dưới những từ quan trọng nhất trong văn bản này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"language"},"unless":{"definition":"Trừ phi, trừ khi, nếu không.","example":"You cannot enter the club unless you have a ticket.","exampleTranslation":"Bạn không thể vào câu lạc bộ trừ phi bạn có vé.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"C","posGroup":"other","family":"language"},"unstressed":{"definition":"Không nhấn mạnh.","example":"The last word was unstressed in the sentence.","exampleTranslation":"Từ cuối cùng không nhấn mạnh trong câu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"usage":{"definition":"Cách đối xử, cách đối đãi.","example":"He suffered from hard usage by his cruel boss.","exampleTranslation":"Anh ấy đã chịu đựng cách đối xử cứng rắn bởi ông chủ tàn nhẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"utterance":{"definition":"Sự phát biểu, sự bày tỏ.","example":"Her utterance was calm and easy to hear.","exampleTranslation":"Sự phát biểu của cô ấy bình tĩnh và dễ nghe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"utter":{"definition":"Hoàn toàn.","example":"The room was in utter darkness for an hour.","exampleTranslation":"Căn phòng chìm trong bóng tối hoàn toàn trong một giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"verb":{"definition":"Động từ.","example":"Please provide a verb to complete this sentence.","exampleTranslation":"Vui lòng cung cấp một động từ để hoàn thành câu này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"vocal":{"definition":"Phát âm, (thuộc) thanh âm.","example":"The vocal organs are essential for human speech.","exampleTranslation":"Các cơ quan phát âm là cần thiết cho ngôn ngữ con người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"language"},"vocalization":{"definition":"Sự phát âm; cách đọc.","example":"The child improved her vocalization quickly.","exampleTranslation":"Đứa trẻ đã cải thiện sự phát âm của mình nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"voice":{"definition":"ý kiến; lời, lời nói; sự bày tỏ, sự phát biểu.","example":"Every employee should have a voice in the matter.","exampleTranslation":"Mỗi nhân viên nên có một lời bày tỏ trong vấn đề này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"language"},"sport":{"definition":"Thể thao.","example":"She loves to play every sport at school.","exampleTranslation":"Cô ấy thích chơi mọi môn thể thao ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sport"},"sporting":{"definition":"Thể thao; thích thể thao.","example":"He is a sporting man who loves playing football.","exampleTranslation":"Anh ấy là một người yêu thể thao và thích chơi bóng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"sport"},"sports":{"definition":"Thể thao.","example":"They enjoy playing various sports every weekend.","exampleTranslation":"Họ thích chơi nhiều môn thể thao khác nhau vào mỗi cuối tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sport"},"athlete":{"definition":"Vận động viên.","example":"The athlete trained early every morning.","exampleTranslation":"Vận động viên này đã tập luyện từ sớm mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"athlete"},"athletic":{"definition":"Có tính chất lực sĩ, lực lưỡng, khoẻ mạnh.","example":"He has an athletic build and strong legs.","exampleTranslation":"Anh ấy có vóc dáng khỏe khoắn và đôi chân chắc nịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"athletic"},"athletics":{"definition":"Điền kinh; thể thao.","example":"She won a gold medal in track and field athletics.","exampleTranslation":"Cô ấy đã giành huy chương vàng môn điền kinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"athletic"},"competition":{"definition":"Sự cạnh tranh.","example":"There is fierce competition between the two local shops.","exampleTranslation":"Có sự cạnh tranh khốc liệt giữa hai cửa hàng địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"competition"},"competitive":{"definition":"Cạnh tranh, đua tranh.","example":"The market is very competitive for small businesses.","exampleTranslation":"Thị trường hiện nay rất cạnh tranh đối với các doanh nghiệp nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"competitive"},"competitively":{"definition":"Đủ khả năng cạnh tranh.","example":"He moved competitively through the crowd.","exampleTranslation":"Anh ấy chen lấn đầy quyết liệt qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"competitive"},"competitiveness":{"definition":"Tính cạnh tranh, tính đua tranh.","example":"Her competitiveness helped her win the race.","exampleTranslation":"Tinh thần cạnh tranh đã giúp cô ấy giành chiến thắng trong cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"competitive"},"compete":{"definition":"đua tranh, ganh đua, cạnh tranh, tranh tài.","example":"Many companies compete with each other for customers.","exampleTranslation":"Nhiều công ty cạnh tranh với nhau để giành khách hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"compete"},"opponent":{"definition":"Phản đối, đối lập, chống lại.","example":"The opponent team scored first.","exampleTranslation":"Đội đối thủ đã ghi bàn trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"opponent"},"tournament":{"definition":"Cuộc đấu.","example":"Our team won the local tennis tournament yesterday.","exampleTranslation":"Đội của chúng tôi đã giành chiến thắng trong giải đấu quần vợt địa phương vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"tournament"},"game":{"definition":"Dụng cụ để chơi (các trò chơi).","example":"He packed the game into a small bag.","exampleTranslation":"Anh ấy cho trò chơi vào trong một chiếc túi nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"game"},"hobby":{"definition":"Sở thích hoặc hoạt động thường làm trong thời gian rảnh.","example":"Many people take up a hobby to relax after work.","exampleTranslation":"Nhiều người bắt đầu một sở thích để thư giãn sau giờ làm.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"hobby"},"play":{"definition":"Sự vui chơi, sự nô đùa, sự đùa giỡn; trò chơi, trò đùa.","example":"The children enjoy their daily play in the garden.","exampleTranslation":"Lũ trẻ thích chơi đùa hàng ngày trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"play"},"playable":{"definition":"Có thể chơi được (sân bóng... ).","example":"The field is playable after the rain.","exampleTranslation":"Sân đã có thể sử dụng được sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"play"},"played":{"definition":"Dạng quá khứ đơn và phân từ quá khứ của play","example":"We played cards after dinner.","exampleTranslation":"Chúng tôi đã chơi bài sau bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"play"},"player":{"definition":"Cầu thủ, đấu thủ.","example":"Each player warmed up before the match.","exampleTranslation":"Mỗi cầu thủ đều khởi động trước khi trận đấu bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"play"},"playful":{"definition":"Hay vui đùa, hay đùa, hay nghịch, hay khôi hài.","example":"Her playful smile made everyone relax.","exampleTranslation":"Nụ cười tinh nghịch của cô ấy khiến mọi người thư giãn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"play"},"physical":{"definition":"Vật chất.","example":"Regular physical activity is good for your health.","exampleTranslation":"Hoạt động thể chất đều đặn rất tốt cho sức khỏe của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"physical"},"physically":{"definition":"Về thân thể; theo luật tự nhiên.","example":"She answered physically and smiled.","exampleTranslation":"Cô ấy phản hồi bằng hành động thể chất rồi mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"physical"},"activity":{"definition":"hoạt động","example":"The sleeping dog did not show much activity.","exampleTranslation":"Chú chó đang ngủ không cho thấy nhiều sự hoạt động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"activity"},"coach":{"definition":"Xe ngựa bốn bánh ((thường) bốn ngựa).","example":"The coach rolled slowly along the dusty road.","exampleTranslation":"Chiếc xe khách di chuyển chậm rãi dọc theo con đường đầy bụi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"coach"},"coached":{"definition":"Quá khứ và phân từ quá khứ của coach","example":"He coached me through the interview.","exampleTranslation":"Anh ấy đã hướng dẫn tôi vượt qua buổi phỏng vấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"coach"},"stadium":{"definition":"Sân vận động.","example":"Thousands filled the stadium on Saturday.","exampleTranslation":"Hàng ngàn người đã lấp đầy sân vận động vào thứ Bảy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"stadium"},"champion":{"definition":"Người vô địch, nhà quán quân.","example":"He is the world chess champion this year.","exampleTranslation":"Anh ấy là nhà vô địch cờ vua thế giới năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"champion"},"championed":{"definition":"Quá khứ và phân từ quá khứ của champion","example":"He championed the idea from the start.","exampleTranslation":"Anh ấy đã ủng hộ ý tưởng đó ngay từ đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"champion"},"championship":{"definition":"Chức vô địch; danh hiệu quán quân.","example":"They won the national swimming championship last year.","exampleTranslation":"Họ đã giành chiến thắng trong giải vô địch bơi lội quốc gia năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"champion"},"team":{"definition":"Cỗ (ngựa, trâu, bò... ).","example":"The farmer used a strong team to pull the cart.","exampleTranslation":"Người nông dân đã sử dụng một cặp súc vật khỏe để kéo xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"team"},"teamed":{"definition":"Quá khứ và phân từ quá khứ của team","example":"We teamed up for the science project.","exampleTranslation":"Chúng tôi đã hợp tác với nhau cho dự án khoa học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"team"},"amuse":{"definition":"Làm vui, làm thích thú, làm buồn cười; giải trí, tiêu khiển.","example":"This funny movie will amuse all the children.","exampleTranslation":"Bộ phim hài hước này sẽ làm thích thú tất cả trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sports"},"amusement":{"definition":"Sự vui chơi; trò vui, trò giải trí, trò tiêu khiển.","example":"They went to the park for some simple amusement.","exampleTranslation":"Họ đã đến công viên để tìm chút sự vui chơi đơn giản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"arena":{"definition":"Trường đấu tranh, vũ đài, phạm vi hoạt động.","example":"They are leaders in the international arena today.","exampleTranslation":"Họ là những nhà lãnh đạo trong vũ đài quốc tế hiện nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"ball":{"definition":"Quả bóng, quả ban, quả banh.","example":"The child kicked the ball into the grass.","exampleTranslation":"Đứa trẻ đã đá quả bóng vào bãi cỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"basketball":{"definition":"Thể bóng rổ.","example":"They watched basketball after dinner.","exampleTranslation":"Họ đã xem bóng rổ sau bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"bunt":{"definition":"Bụng, rốn (buồm, lưới).","example":"The sail had a deep bunt near the middle.","exampleTranslation":"Cánh buồm có một chỗ trũng sâu gần phần giữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"champ":{"definition":"Champion.","example":"She became the champ after a close match.","exampleTranslation":"Cô ấy đã trở thành nhà vô địch sau một trận đấu sít sao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"chess":{"definition":"Cờ vua.","example":"We played chess after school.","exampleTranslation":"Chúng tôi đã chơi cờ vua sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"climb":{"definition":"Leo lên tới, trèo lên tới.","example":"They had to climb to the top of the hill.","exampleTranslation":"Họ phải leo lên tới đỉnh đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sports"},"club":{"definition":"Dùi cui, gậy tày.","example":"He raised the club to scare the thief.","exampleTranslation":"Anh ấy đã giơ cao chiếc dùi cui để làm sợ tên trộm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"contest":{"definition":"Cuộc tranh luận, cuộc tranh cãi.","example":"The truth of the matter is beyond contest.","exampleTranslation":"Sự thật của vấn đề là ngoài cuộc tranh luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"contestant":{"definition":"Người tranh luận, người tranh cãi.","example":"He was the strongest contestant in the debate.","exampleTranslation":"Anh ấy là người tranh luận mạnh nhất trong cuộc tranh luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"dart":{"definition":"Sự lao tới, sự phóng tới.","example":"The cat made a quick dart toward the mouse.","exampleTranslation":"Con mèo đã lao tới chuột một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"defeat":{"definition":"Sự thất bại (của một kế hoạch... ); sự tiêu tan (hy vọng... ).","example":"The plan ended in defeat after many delays.","exampleTranslation":"Kế hoạch đã kết thúc trong sự thất bại sau nhiều lần trì hoãn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"dive":{"definition":"Sự nhảy lao đầu xuống (nước... ); sự lặn.","example":"She took a dive into the cool pool.","exampleTranslation":"Cô ấy đã nhảy lao đầu xuống hồ bơi mát lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"dogs":{"definition":"Cuộc đua chó greyhound.","example":"I lost money at the dogs last night.","exampleTranslation":"Tôi đã thua tiền tại cuộc đua chó tối qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"endurance":{"definition":"Sự kéo dài.","example":"The heat caused the endurance of the work.","exampleTranslation":"Sự nhiệt độ đã làm kéo dài sự kéo dài của công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"enthusiast":{"definition":"Người hăng hái, người có nhiệt tình; người say mê.","example":"He is a true music enthusiast who plays every day.","exampleTranslation":"Anh ấy là một người say mê âm nhạc thực thụ chơi mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"fancier":{"definition":"Người sành; người thích chơi.","example":"He is a famous flower fancier in town.","exampleTranslation":"Ông ấy là một người sành hoa nổi tiếng trong thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"flipper":{"definition":"Bàn tay.","example":"He waved a flipper at the crowd.","exampleTranslation":"Anh ấy vẫy bàn tay với đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"football":{"definition":"Quả bóng đá.","example":"They discussed the football today.","exampleTranslation":"Họ đã thảo luận quả bóng đá hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"goal":{"definition":"Khung thành gồm.","example":"The team worked hard to keep the goal.","exampleTranslation":"Cả đội đã làm việc chăm chỉ để giữ khung thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"golf":{"definition":"Môn đánh gôn.","example":"He learned golf from his older brother.","exampleTranslation":"Anh ấy đã học môn đánh gôn từ anh trai mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"heavyweight":{"definition":"Võ sĩ hạng nặng, đô vật hạng nặng (nặng từ 79, 5 kg trở lên).","example":"The heavyweight moved slowly but hit with great power.","exampleTranslation":"Võ sĩ hạng nặng đã di chuyển chậm nhưng đánh với sức mạnh to lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"hike":{"definition":"Cuộc đi bộ đường dài (để luyện sức khoẻ hoặc tiêu khiển).","example":"We took a long hike in the hills.","exampleTranslation":"Chúng tôi đã có một cuộc đi bộ đường dài trong các ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"hops":{"definition":"Động từ chia ở ngôi thứ ba số ít của hop","example":"The child hops from one stone to another.","exampleTranslation":"Đứa trẻ nhảy lò cò từ hòn đá này sang hòn đá khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sports"},"horseback":{"definition":"Ngồi trên lưng ngựa, cưỡi ngựa.","example":"She learned to ride horseback last summer.","exampleTranslation":"Cô ấy học cưỡi ngựa vào mùa hè năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"hunt":{"definition":"Cuộc đi săn; sự đi săn.","example":"We went on a hunt for fresh mushrooms.","exampleTranslation":"Chúng tôi đã đi săn tìm nấm tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"hunter":{"definition":"Đồng hồ có nắp (cho mặt kính) (của những người săn cáo) ((cũng) hungting-watch).","example":"He carried his watch in a hunter case.","exampleTranslation":"Anh ấy mang đồng hồ trong một cái hộp đồng hồ có nắp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"jump":{"definition":"Sự nhảy, bước nhảy.","example":"He won a gold medal in the long jump.","exampleTranslation":"Anh ấy đã thắng một huy chương vàng trong bước nhảy xa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"kick":{"definition":"Trôn chai (chỗ lõm ở đít chai).","example":"The bottle had a small kick at the base.","exampleTranslation":"Cái chai có một trôn chai nhỏ ở phần đáy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"league":{"definition":"Dặm, lý (đơn vị chiều dài, quãng 4 km).","example":"The old map shows a distance of one league.","exampleTranslation":"Bản đồ cũ cho thấy khoảng cách là một dặm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"marathon":{"definition":"Cuộc chạy đua maratông ((cũng) marathon race).","example":"He trained hard for the marathon.","exampleTranslation":"Anh ấy đã tập luyện chăm chỉ cho cuộc chạy đua maratông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"oarsman":{"definition":"Người chèo thuyền, người bơi thuyền, tay chèo.","example":"The oarsman rowed across the quiet lake.","exampleTranslation":"Tay chèo đã chèo thuyền băng qua hồ yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"pastime":{"definition":"Trò tiêu khiển.","example":"Reading is my favorite pastime on rainy days.","exampleTranslation":"Đọc sách là trò tiêu khiển yêu thích của tôi vào những ngày mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"picnic":{"definition":"Việc thú vị, việc dễ làm, việc ngon xơi.","example":"Cleaning the whole house is no picnic at all.","exampleTranslation":"Dọn dẹp cả căn nhà chẳng phải là việc dễ làm chút nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"pool":{"definition":"Vũng.","example":"The children played in a small pool.","exampleTranslation":"Lũ trẻ chơi trong một vũng nước nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"punter":{"definition":"Nhà con (trong cuộc đánh bạc) ((cũng) punt).","example":"Every punter hoped to leave with more cash.","exampleTranslation":"Mỗi người đặt cược đều hy vọng ra về với nhiều tiền mặt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"recreate":{"definition":"Làm giải khuây.","example":"We need to recreate ourselves after a busy week.","exampleTranslation":"Chúng ta cần giải trí sau một tuần bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sports"},"referee":{"definition":", (pháp lý) trọng tài.","example":"The referee stopped the match after the injury.","exampleTranslation":"Trọng tài đã dừng trận đấu sau chấn thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"relay":{"definition":"Ca, kíp (thợ).","example":"The relay started at the beginning of the shift.","exampleTranslation":"Cuộc tiếp sức bắt đầu từ đầu ca làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"reserve":{"definition":"Đấu thủ dự bị.","example":"A reserve entered the match in the second half.","exampleTranslation":"Một cầu thủ dự bị đã vào sân trong hiệp hai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"rowing":{"definition":"Sự chèo thuyền.","example":"Rowing is harder when the water is rough.","exampleTranslation":"Việc chèo thuyền khó khăn hơn khi nước động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"running":{"definition":"Cuộc chạy đua.","example":"They decided to take up the running for health.","exampleTranslation":"Họ quyết định thực hiện cuộc chạy đua vì sức khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"score":{"definition":"Sổ điểm, sổ bán thắng.","example":"The team managed to make a good score.","exampleTranslation":"Cả đội đã xoay xở để đạt được sổ điểm tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"skateboard":{"definition":"Ván trượt (hẹp, dài khoảng 50 cm, có gắn bánh xe trượt).","example":"He learned to ride a skateboard quickly.","exampleTranslation":"Anh ấy đã học cách trượt ván nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"sled":{"definition":"Xe trượt tuyết (do ngựa, chó, hươu kéo).","example":"The puppy rode on a small sled.","exampleTranslation":"Chú cún con đã đi trên một chiếc xe trượt tuyết nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"softball":{"definition":"Trò bóng mềm, môn bóng mềm.","example":"They joined a softball game in the park.","exampleTranslation":"Họ tham gia một trò bóng mềm trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"swim":{"definition":"Tình hình chung, chiều hướng chung.","example":"He is always in the swim of current events.","exampleTranslation":"Anh ấy luôn nắm bắt được tình hình chung của các sự kiện hiện tại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"swimsuit":{"definition":"Quần áo bơi liền mảnh của phụ nữ.","example":"She packed her swimsuit for the beach trip.","exampleTranslation":"Cô ấy đã gói quần áo bơi liền mảnh cho chuyến đi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"swing":{"definition":"Sự (đi) nhún nhảy.","example":"She walked with a natural swing in her step.","exampleTranslation":"Cô ấy bước đi với sự nhún nhảy tự nhiên trong dáng đi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"tackle":{"definition":"Dây dợ (để kéo buồm... ).","example":"The sail's tackle was tangled in knots.","exampleTranslation":"Dây dợ của cánh buồm bị vướng vào các nút thắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"tennis":{"definition":"Quần vợt.","example":"We play tennis every Saturday morning.","exampleTranslation":"Chúng tôi chơi quần vợt vào mỗi sáng thứ Bảy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"toss":{"definition":"Trò chơi sấp ngửa.","example":"They won the toss before starting the match.","exampleTranslation":"Họ đã thắng trò chơi sấp ngửa trước khi bắt đầu trận đấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"volley":{"definition":"Quả vôlê (đánh hoặc đá khi bóng chưa chạm đất).","example":"He scored with a volley from close range.","exampleTranslation":"Anh ấy đã ghi bàn bằng một quả vôlê từ cự ly gần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"volleyball":{"definition":"Bóng chuyền.","example":"We played volleyball after school.","exampleTranslation":"Chúng tôi đã chơi bóng chuyền sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"winner":{"definition":"Người được cuộc, người thắng; con vật thắng trong cuộc đua (ngựa... ).","example":"She was the clear winner in the race.","exampleTranslation":"Cô ấy là người thắng cuộc rõ ràng trong cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"winning":{"definition":"Sự khai thác.","example":"The mining company is winning some valuable minerals.","exampleTranslation":"Công ty khai thác đang thực hiện việc khai thác một số khoáng sản quý giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"wins":{"definition":"Động từ chia ở ngôi thứ ba số ít của win","example":"He wins every game at the park.","exampleTranslation":"Anh ấy thắng mọi trò chơi ở công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"sports"},"workout":{"definition":", (thể dục, thể thao) buổi luyện tập.","example":"The workout appeared in the report.","exampleTranslation":"Buổi luyện tập đã xuất hiện trong bản báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"yachtsman":{"definition":"Người đi chơi thuyền buồm.","example":"The yachtsman appeared in the report.","exampleTranslation":"Người đi chơi thuyền buồm đã xuất hiện trong bản báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"yoga":{"definition":"Thuyết du già.","example":"He kept the yoga on the desk.","exampleTranslation":"Anh ấy để tài liệu về thuyết du già trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sports"},"burial":{"definition":"Việc chôn cất hoặc mai táng người chết, thường theo một nghi thức nhất định.","example":"Archaeologists found the burial site containing bronze ornaments arranged according to a carefully planned ritual.","exampleTranslation":"Các nhà khảo cổ phát hiện địa điểm mai táng chứa những đồ trang sức bằng đồng được sắp xếp theo một nghi lễ được tổ chức cẩn thận.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"history"},"dynasty":{"definition":"Triều đại hoặc dòng vua cai trị một quốc gia hay khu vực trong một thời kỳ.","example":"The dynasty controlled regional trade routes for nearly three centuries, according to archaeological evidence.","exampleTranslation":"Theo bằng chứng khảo cổ, triều đại này kiểm soát các tuyến thương mại trong khu vực trong gần ba thế kỷ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"history"},"excavation":{"definition":"Hoạt động khai quật có hệ thống để phát hiện và nghiên cứu các di tích, di vật.","example":"The excavation revealed layered settlements, allowing researchers to reconstruct changes in daily life.","exampleTranslation":"Cuộc khai quật phát hiện các khu định cư xếp thành nhiều tầng, giúp các nhà nghiên cứu tái dựng những thay đổi trong đời sống hằng ngày.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"history"},"pottery":{"definition":"Đồ vật làm từ đất sét được nung, thường gồm các bình, bát hoặc mảnh gốm.","example":"Fragments of pottery helped archaeologists identify trade connections between the settlement and distant coastal communities.","exampleTranslation":"Những mảnh gốm giúp các nhà khảo cổ xác định mối liên hệ thương mại giữa khu định cư và các cộng đồng ven biển xa xôi.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"history"},"history":{"definition":"Sử, sử học, lịch sử.","example":"She loves learning about ancient history at school.","exampleTranslation":"Cô ấy thích tìm hiểu về lịch sử cổ đại ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"historic":{"definition":"Có tính chất lịch sử; được ghi vào lịch sử.","example":"She gave a historic speech last night.","exampleTranslation":"Cô ấy đã có một bài phát biểu mang tính lịch sử vào tối qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"historic"},"historical":{"definition":"Lịch sử, (thuộc) lịch sử; có liên quan đến lịch sử.","example":"We visited many historical sites during our trip.","exampleTranslation":"Chúng tôi đã tham quan nhiều di tích lịch sử trong chuyến đi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"historic"},"historically":{"definition":"Về mặt lịch sử, về phương diện lịch sử.","example":"Historically, many families relied on farming for their income.","exampleTranslation":"Trong lịch sử, nhiều gia đình dựa vào nghề nông để kiếm sống.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"historical"},"ancient":{"definition":"Xưa, cổ.","example":"We visited an ancient temple in the city.","exampleTranslation":"Chúng tôi đã tham quan một ngôi đền cổ trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"ancient"},"civilization":{"definition":"Nền văn minh.","example":"The ancient civilization built many large stone temples.","exampleTranslation":"Nền văn minh cổ đại đã xây dựng nhiều ngôi đền đá lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"civilization","spellingNote":"British spelling: civilisation."},"archaeological":{"definition":"Khảo cổ học.","example":"The archaeological site closed for the night.","exampleTranslation":"Khu khảo cổ đã đóng cửa vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"archaeolog"},"archaeologist":{"definition":"Nhà khảo cổ.","example":"The archaeologist brushed dirt from the pot.","exampleTranslation":"Nhà khảo cổ học đã phủi bụi khỏi chiếc bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"archaeolog"},"archaeology":{"definition":"Khảo cổ học.","example":"Archaeology helps us study old cultures.","exampleTranslation":"Khảo cổ học giúp chúng ta nghiên cứu các nền văn hóa cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"archaeolog"},"artifact":{"definition":"Sự giả tạo, giả tượng.","example":"The old photo was an artifact of bad editing.","exampleTranslation":"Bức ảnh cũ đó là một sản phẩm của việc chỉnh sửa tồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"artifact"},"monument":{"definition":"Lâu đài.","example":"We toured the old monument on the hill.","exampleTranslation":"Chúng tôi đã đi tham quan tượng đài cũ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"monument"},"monumental":{"definition":"(thuộc) Công trình kỷ niệm; dùng làm công trình kỷ niệm.","example":"They built a monumental gate for the park.","exampleTranslation":"Họ đã xây một chiếc cổng đồ sộ cho công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"monument"},"preservable":{"definition":"Có thể giữ, có thể gìn giữ, có thể bảo quản, có thể bảo tồn, có thể duy trì.","example":"The old photo is preservable in a dry box.","exampleTranslation":"Bức ảnh cũ đó có thể được bảo quản trong một chiếc hộp khô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"preserv"},"preservation":{"definition":"Sự giữ, sự gìn giữ, sự bảo quản, sự bảo tồn, sự duy trì.","example":"The preservation of old books is very important.","exampleTranslation":"Việc bảo tồn những cuốn sách cũ là rất quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"preserv"},"preservative":{"definition":"Để phòng giữ, để gìn giữ, để bảo quản, để bảo tồn, để duy trì.","example":"We need a preservative measure for these fruits.","exampleTranslation":"Chúng ta cần một biện pháp bảo quản cho những loại trái cây này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"preserv"},"preserver":{"definition":"Người giữ, người bảo quản.","example":"The preserver kept the old letters safe.","exampleTranslation":"Người bảo tồn đã giữ những lá thư cũ an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"preserv"},"preserving":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của preserve.","example":"She was preserving old family photos.","exampleTranslation":"Cô ấy đang bảo quản những bức ảnh gia đình cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"preserv"},"revolution":{"definition":"Cuộc cách mạng.","example":"They fought for a peaceful revolution in the city.","exampleTranslation":"Họ đã đấu tranh cho một cuộc cách mạng hòa bình trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"revolution"},"revolutionary":{"definition":"Cách mạng.","example":"She joined a revolutionary movement to help people.","exampleTranslation":"Cô ấy đã tham gia một phong trào cách mạng để giúp đỡ mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"revolution"},"revolutionise":{"definition":"Cách mạng hoá.","example":"New tools can revolutionise daily classroom work.","exampleTranslation":"Các công cụ mới có thể cách mạng hóa công việc hàng ngày trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"revolution","spellingNote":"Alternate spelling: revolutionize."},"revolutionize":{"definition":"Làm cho (một nước) nổi lên làm cách mạng.","example":"New tools can revolutionize daily study.","exampleTranslation":"Các công cụ mới có thể cách mạng hóa việc học tập hàng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"revolution","spellingNote":"British spelling: revolutionise."},"empire":{"definition":"Đế quốc; đế chế.","example":"The empire grew across the sea.","exampleTranslation":"Đế chế đã mở rộng khắp phía bên kia đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"empire"},"colonization":{"definition":"Sự chiếm làm thuộc địa.","example":"The colonization was useful in class.","exampleTranslation":"Việc thuộc địa hóa rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"coloniz","spellingNote":"British spelling: colonisation."},"colonizer":{"definition":"Người đi khai hoang, người định cư đất mới ((cũng) colonist).","example":"The colonizer built a new home on the land.","exampleTranslation":"Người thực dân đã xây một ngôi nhà mới trên vùng đất đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"coloniz"},"colonizing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của colonize.","example":"They are colonizing a tiny island of plants.","exampleTranslation":"Họ đang xâm chiếm một hòn đảo nhỏ đầy thực vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"coloniz"},"colonial":{"definition":"Thuộc địa; thực dân.","example":"They studied colonial history in their class.","exampleTranslation":"Họ đã học về lịch sử thuộc địa trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"colonial"},"colonialism":{"definition":"Chủ nghĩa thực dân.","example":"The book explains how colonialism changed local life.","exampleTranslation":"Cuốn sách giải thích cách chủ nghĩa thực dân đã thay đổi cuộc sống địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"colonial"},"colonialist":{"definition":"Thực dân.","example":"The colonialist system controlled many local lives.","exampleTranslation":"Chế độ thực dân đã kiểm soát cuộc sống của nhiều người dân địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"colonial"},"legacy":{"definition":"Tài sản kế thừa, gia tài, di sản.","example":"She received a large legacy from her late uncle.","exampleTranslation":"Cô ấy đã nhận được một di sản lớn từ người chú quá cố của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"legacy"},"century":{"definition":", (thông tục) trăm đô la.","example":"She paid a century for the used bike.","exampleTranslation":"Cô ấy đã trả một số tiền lớn cho chiếc xe đạp cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"century"},"historian":{"definition":"Nhà viết sử, sử gia.","example":"The historian wrote a clear account.","exampleTranslation":"Nhà sử học đã viết một bản tường thuật rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"historian"},"past":{"definition":"Quá khứ, đã qua, (thuộc) dĩ vãng.","example":"We should learn from the mistakes of the past.","exampleTranslation":"Chúng ta nên học hỏi từ những sai lầm trong quá khứ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"past"},"pasted":{"definition":"Quá khứ và phân từ quá khứ của paste","example":"She pasted the note onto the wall.","exampleTranslation":"Cô ấy đã dán mẩu giấy lên tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"past"},"paster":{"definition":"Thợ dán nhãn hàng hoá.","example":"A paster checked each package on the line.","exampleTranslation":"Người dán đã kiểm tra từng gói hàng trên dây chuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"past"},"pastes":{"definition":"Động từ chia ở ngôi thứ ba số ít của paste","example":"He pastes the label on each box.","exampleTranslation":"Anh ấy dán nhãn lên từng chiếc hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"past"},"pasting":{"definition":"Một trận đòn nhừ tử; thất bại.","example":"His team took a pasting in the match.","exampleTranslation":"Đội của anh ấy đã phải nhận một thất bại nặng nề trong trận đấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"past"},"pastor":{"definition":"Mục sư; người lãnh đạo một cộng đồng Kitô giáo và hướng dẫn đời sống tinh thần của tín đồ.","example":"The pastor helped preserve the church's historical records.","exampleTranslation":"Mục sư đã góp phần bảo tồn các tư liệu lịch sử của nhà thờ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"past"},"advent":{"definition":"Sự đến, sự tới, sự xuất hiện (của một sự việc gì quan trọng).","example":"The advent of smartphones changed our daily lives.","exampleTranslation":"Sự xuất hiện của điện thoại thông minh đã thay đổi cuộc sống hàng ngày của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"aftermath":{"definition":"After-grass.","example":"The aftermath of the rain left muddy roads.","exampleTranslation":"Hậu quả của cơn mưa để lại những con đường đầy bùn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"ancestor":{"definition":"Ông bà, tổ tiên.","example":"My ancestor crossed the ocean many years ago.","exampleTranslation":"Tổ tiên của tôi đã vượt đại dương nhiều năm trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"ancestral":{"definition":"Ông bà, (thuộc) tổ tiên.","example":"The room felt ancestral after cleaning.","exampleTranslation":"Căn phòng cảm thấy thuộc tổ tiên sau khi được dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"archive":{"definition":"Tài liệu, dữ liệu lưu trữ.","example":"The archive contains records from many years ago.","exampleTranslation":"Kho lưu trữ chứa các hồ sơ từ nhiều năm trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"aristocracy":{"definition":"Chế độ chọn người ưu tú.","example":"Their team worked on the idea of aristocracy.","exampleTranslation":"Đội của họ đã làm việc dựa trên ý tưởng về chế độ chọn người ưu tú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"battle":{"definition":"Chiến đấu, vật lộn.","example":"They had to battle with the strong winds.","exampleTranslation":"Họ đã phải chiến đấu với những cơn gió mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"battlefield":{"definition":"Chiến trường.","example":"We crossed the battlefield at dawn.","exampleTranslation":"Chúng tôi băng qua chiến trường lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"battlements":{"definition":"Tường có lỗ châu mai.","example":"The castle had high battlements.","exampleTranslation":"Lâu đài có tường có lỗ châu mai cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"bequeath":{"definition":"Để lại (bằng chúc thư).","example":"She will bequeath her books to the school.","exampleTranslation":"Cô ấy sẽ để lại những cuốn sách của mình cho trường học bằng di chúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"castle":{"definition":"Thành trì, thành quách.","example":"The castle stood on the hill.","exampleTranslation":"Thành trì đứng trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"centenary":{"definition":"Trăm năm.","example":"The centenary tree stood tall in the yard.","exampleTranslation":"Cái cây trăm năm tuổi đứng sừng sững trong sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"chronicler":{"definition":"Người viết thời sự; phóng viên thời sự (báo chí).","example":"The chronicler reported the storm for the paper.","exampleTranslation":"Người phóng viên thời sự đã đưa tin về cơn bão cho tờ báo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"circa":{"definition":"Vào khoảng, khoảng chừng (thường liên quan đến thời gian).","example":"The old house was built circa 1902.","exampleTranslation":"Ngôi nhà cũ đã được xây dựng vào khoảng năm 1902.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"E","posGroup":"other","family":"history"},"civilisation":{"definition":"Sự làm cho văn minh, sự khai hoá.","example":"Education helped the village's civilisation.","exampleTranslation":"Giáo dục đã giúp ích cho sự khai hoá của ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history","spellingNote":"Alternate spelling: civilization."},"colonisation":{"definition":"Sự chiếm làm thuộc địa, sự thực dân hoá.","example":"The colonisation played a key role.","exampleTranslation":"Sự thực dân hoá đã đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history","spellingNote":"Alternate spelling: colonization."},"conquer":{"definition":"Đoạt, xâm chiếm; chiến thắng.","example":"They hope to conquer the mountain by noon.","exampleTranslation":"Họ hy vọng đoạt được ngọn núi trước buổi trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"conqueror":{"definition":"Người đi xâm chiếm, người đi chinh phục.","example":"He kept the conqueror on the desk.","exampleTranslation":"Anh ấy đã giữ cuốn sách người chinh phục trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"contemporary":{"definition":"Cùng thời; cùng tuổi (người); xuất bản cùng thời (báo chí).","example":"They were contemporary students at the same school.","exampleTranslation":"Họ là những sinh viên cùng thời tại cùng một trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"courtier":{"definition":"Người dự buổi chầu; triều thần, cận thần.","example":"The courtier stood near the throne.","exampleTranslation":"Người cận thần đứng gần ngai vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"crown":{"definition":"Đỉnh, ngọn, chóp, chỏm (núi, cây, mũ... ).","example":"The crown of the hill caught the sun.","exampleTranslation":"Đỉnh đồi đón lấy ánh nắng mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"decade":{"definition":"Thập kỷ, thập niên (thời kỳ mười năm).","example":"We lived there for a whole decade.","exampleTranslation":"Chúng tôi đã sống ở đó trong cả một thập kỷ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"decimation":{"definition":"Sự lấy ra một phần mười.","example":"The army suffered decimation in the battle.","exampleTranslation":"Đội quân đã chịu sự lấy ra một phần mười trong trận chiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"dinosaur":{"definition":"Khủng long.","example":"The museum has a huge dinosaur skeleton.","exampleTranslation":"Bảo tàng có bộ xương khủng long khổng lồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"doomsday":{"definition":"Ngày phán quyết cuối cùng, ngày tận thế.","example":"Many people fear the coming of doomsday.","exampleTranslation":"Nhiều người sợ hãi ngày tận thế sắp đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"downfall":{"definition":"Sự sa sút, sự suy vi, sự suy sụp.","example":"The company's downfall came after many mistakes.","exampleTranslation":"Sự suy sụp của công ty đến sau nhiều sai lầm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"exile":{"definition":"Sự đày ải, sự đi đày hay sự lưu đày.","example":"His exile lasted many lonely years.","exampleTranslation":"Sự lưu đày của anh ấy kéo dài nhiều năm cô đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"exodus":{"definition":"Sự rời đi, sự ra đi quy mô lớn và bất ngờ (của đám người di cư... ).","example":"The storm caused an exodus from the town.","exampleTranslation":"Cơn bão đã gây ra một sự ra đi quy mô lớn khỏi thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"fall":{"definition":"Lưới che mặt, mạng che mặt (của phụ nữ).","example":"She wore a thin fall over her face.","exampleTranslation":"Cô ấy đeo một chiếc lưới che mặt mỏng trên mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"forefather":{"definition":"Tổ tiên.","example":"Her forefather came here many years ago.","exampleTranslation":"Tổ tiên của cô ấy đã đến đây nhiều năm trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"forerunner":{"definition":"Nguyên mẫu đầu tiên.","example":"This model became the forerunner of later ones.","exampleTranslation":"Mô hình này trở thành nguyên mẫu đầu tiên của những cái sau này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"frontiersman":{"definition":"Người dân ở vùng biên giới.","example":"The frontiersman built a small cabin near the hills.","exampleTranslation":"Người dân vùng biên giới xây một túp lều nhỏ gần các ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"genesis":{"definition":"Căn nguyên, nguồn gốc.","example":"We never learned the genesis of the rumor.","exampleTranslation":"Chúng tôi không bao giờ biết được căn nguyên của lời đồn đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"golden":{"definition":"Thịnh vượng; hạnh phúc.","example":"We lived during a golden age of art.","exampleTranslation":"Chúng tôi đã sống trong một thời kỳ thịnh vượng của nghệ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"gunpowder":{"definition":"Thuốc súng.","example":"Gunpowder left a dark mark on the table.","exampleTranslation":"Thuốc súng để lại một vết đen trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"herald":{"definition":"Viên quan phụ trách huy hiệu.","example":"The herald played a key role.","exampleTranslation":"Viên quan phụ trách huy hiệu đã đóng một vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"holocaust":{"definition":"Lễ toàn thiêu các vật tế thần.","example":"The old temple held a holocaust offering.","exampleTranslation":"Ngôi đền cũ đã tổ chức một lễ toàn thiêu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"invade":{"definition":"Xâm lược, xâm chiếm, xâm lấn.","example":"The hungry army began to invade the neighboring territory.","exampleTranslation":"Đội quân đói khát bắt đầu xâm lược lãnh thổ láng giềng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"invader":{"definition":"Kẻ xâm lược, kẻ xâm chiếm, kẻ xâm lấn.","example":"The invader appeared in the report.","exampleTranslation":"Kẻ xâm lược đã xuất hiện trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"invasion":{"definition":"Sự xâm lược, sự xâm chiếm, sự xâm lấn.","example":"The country faced a sudden military invasion.","exampleTranslation":"Đất nước phải đối mặt với một sự xâm lược quân sự đột ngột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"king":{"definition":"Tôn lên làm vua.","example":"They king him after the old ruler left.","exampleTranslation":"Họ tôn ông ấy lên làm vua sau khi vị cai trị cũ rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"kingdom":{"definition":"Vương quốc.","example":"The United Kingdom is a large island nation.","exampleTranslation":"Vương quốc Anh là một quốc gia hải đảo rộng lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"knight":{"definition":"Người được phong tước hầu (ở Anh).","example":"She was made a knight for her work.","exampleTranslation":"Cô ấy được phong tước hầu vì công việc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"legendary":{"definition":"Truyện cổ tích, (thuộc) truyền thuyết.","example":"The legendary hero appeared in many old tales.","exampleTranslation":"Người anh hùng truyền thuyết xuất hiện trong nhiều câu chuyện cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"medieval":{"definition":"Thời Trung cổ; kiểu trung cổ.","example":"They stayed in a medieval castle overnight.","exampleTranslation":"Họ đã ở lại một lâu đài kiểu trung cổ qua đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"millennium":{"definition":"Thiên niên kỷ, nghìn năm, mười thế kỷ.","example":"They hoped for peace in the next millennium.","exampleTranslation":"Họ hy vọng về hòa bình trong thiên niên kỷ tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"moai":{"definition":"Những bức tượng đá lớn trên Đảo Phục Sinh.","example":"The moai stood silently on the hill.","exampleTranslation":"Các bức tượng moai đứng lặng lẽ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"palace":{"definition":"Cung điện, lâu đài.","example":"They toured the palace on a sunny morning.","exampleTranslation":"Họ đã tham quan cung điện vào một buổi sáng nắng đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"papyrus":{"definition":"Sách giấy cói.","example":"The papyrus was stored in a dry box.","exampleTranslation":"Sách giấy cói được cất giữ trong một chiếc hộp khô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"period":{"definition":"Kỷ, kỳ, thời kỳ, giai đoạn, thời gian.","example":"A period is a specific unit of time in history.","exampleTranslation":"Một thời kỳ là một đơn vị thời gian cụ thể trong lịch sử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"pioneer":{"definition":"Đội tiên phong, đội mở đường ((thường) là công binh).","example":"The pioneer led the team through the field.","exampleTranslation":"Đội tiên phong đã dẫn dắt cả nhóm xuyên qua cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"postwar":{"definition":"Hậu chiến; tồn tại sau chiến tranh, xảy ra sau chiến tranh.","example":"The postwar economy grew very quickly.","exampleTranslation":"Nền kinh tế hậu chiến đã tăng trưởng rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"predate":{"definition":"Đề lùi ngày tháng về trước (một văn kiện... ).","example":"They tried to predate the receipt.","exampleTranslation":"Họ đã cố gắng đề lùi ngày tháng trước trên biên lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"prehistoric":{"definition":"(thuộc} Tiền sử.","example":"They found prehistoric tools in the cave.","exampleTranslation":"Họ đã tìm thấy các công cụ thời tiền sử trong hang động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"prehistory":{"definition":"Tiền sử.","example":"They found tools from prehistory near the cave.","exampleTranslation":"Họ đã tìm thấy các công cụ từ thời tiền sử gần hang động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"preindustrial":{"definition":"Tiền công nghiệp.","example":"The village was still preindustrial and had no factories.","exampleTranslation":"Ngôi làng vẫn còn ở thời kỳ tiền công nghiệp và không có nhà máy nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"primitive":{"definition":"Nguyên thuỷ, ban sơ.","example":"Early humans lived in a very primitive environment.","exampleTranslation":"Người cổ đại sống trong một môi trường rất nguyên thủy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"reconstruct":{"definition":"Xây dựng lại, kiến thiết lại; đóng lại (tàu... ).","example":"Workers began to reconstruct a ship in the harbor.","exampleTranslation":"Công nhân bắt đầu xây dựng lại một con tàu trong bến cảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"reconstruction":{"definition":"Sự dựng lại (một vở kịch... ).","example":"The director planned a reconstruction of the old play.","exampleTranslation":"Đạo diễn đã lên kế hoạch tái dựng vở kịch cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"remnant":{"definition":"Dấu vết còn lại, tàn dư.","example":"A remnant of fear stayed in his voice.","exampleTranslation":"Một tàn dư của sự sợ hãi vẫn còn đọng lại trong giọng nói của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"restoration":{"definition":"Sự khôi phục, sự hồi phục; sự lập lại.","example":"We hope for the restoration of his health.","exampleTranslation":"Chúng tôi hy vọng vào sự phục hồi sức khỏe của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"restore":{"definition":"Hoàn lại, trả lại.","example":"They worked hard to restore the old building to its glory.","exampleTranslation":"Họ đã làm việc chăm chỉ để khôi phục tòa nhà cũ về thời hoàng kim của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"restorer":{"definition":"Người khôi phục lại; cái làm hồi phục lại ((thường) trong từ ghép).","example":"They used a special hair restorer on his head.","exampleTranslation":"Họ đã sử dụng một loại thuốc làm hồi phục tóc đặc biệt trên đầu anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"ruin":{"definition":"Sự đổ nát, sự suy đồi.","example":"The ancient city lies in ruin after the war.","exampleTranslation":"Thành phố cổ nằm trong sự đổ nát sau chiến tranh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"scribe":{"definition":"Người viết, người biết viết.","example":"The scribe copied the letter by hand.","exampleTranslation":"Người viết đã chép lại bức thư bằng tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"settler":{"definition":"Người thực dân, người đến lập nghiệp ở thuộc địa.","example":"The settler built a home near the river.","exampleTranslation":"Người thực dân đã xây một ngôi nhà gần con sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"slaver":{"definition":"Tàu buôn nô lệ.","example":"The old slaver carried goods across the sea.","exampleTranslation":"Con tàu buôn nô lệ cũ đã chở hàng hóa băng qua biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"slave":{"definition":"Người nô lệ (đen & bóng).","example":"He is a slave to his daily routine.","exampleTranslation":"Anh ấy là nô lệ cho công việc thường nhật của chính mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"stronghold":{"definition":"Đồn, đồn luỹ, dinh luỹ.","example":"The castle was a stronghold on the hill.","exampleTranslation":"Lâu đài là một đồn luỹ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"succession":{"definition":"Sự kế tiếp; sự liên tiếp.","example":"They won three great victories in succession.","exampleTranslation":"Họ đã giành ba chiến thắng lớn liên tiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"successive":{"definition":"Kế tiếp; liên tiếp, liên tục; lần lượt.","example":"We saw successive waves rolling onto the beach.","exampleTranslation":"Chúng tôi nhìn thấy những con sóng liên tiếp ập vào bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"temple":{"definition":"Thái dương.","example":"He rubbed his temple after the long test.","exampleTranslation":"Anh ấy xoa thái dương sau bài kiểm tra dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"throne":{"definition":"Ngai, ngai vàng; ngôi, ngôi vua.","example":"He sat on a golden throne.","exampleTranslation":"Anh ấy ngồi trên một ngai vàng bằng vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"tomb":{"definition":"Mồ, mộ, mả.","example":"They visited the tomb on a quiet hill.","exampleTranslation":"Họ đã thăm mộ trên một ngọn đồi yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"treasure":{"definition":"Bạc vàng, châu báu, của cải; kho của quý.","example":"They found a hidden treasure in the old cave.","exampleTranslation":"Họ tìm thấy một kho của quý bị giấu trong hang cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"tribute":{"definition":"Vật cống, đồ cống.","example":"They paid tribute to the fallen heroes today.","exampleTranslation":"Họ đã trả vật cống cho những anh hùng đã ngã xuống hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"triumph":{"definition":"Lễ khải hoàn, lễ mừng chiến thắng.","example":"The city held a triumph after the win.","exampleTranslation":"Thành phố đã tổ chức một lễ mừng chiến thắng sau trận thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"unearthed":{"definition":"Quá khứ và phân từ quá khứ của unearth","example":"They unearthed an old map in the attic.","exampleTranslation":"Họ đã đào tìm thấy một tấm bản đồ cũ trên gác mái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"unreconstructed":{"definition":"Không được xây dựng lại, không được tái thiết.","example":"The city remained unreconstructed after the fire.","exampleTranslation":"Thành phố vẫn không được xây dựng lại sau vụ hỏa hoạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"history"},"warfare":{"definition":"Chiến tranh.","example":"The history book describes the horrors of chemical warfare.","exampleTranslation":"Cuốn sách lịch sử mô tả những nỗi kinh hoàng của chiến tranh hóa học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"history"},"wars":{"definition":"Động từ chia ở ngôi thứ ba số ít của war","example":"She tried to wars the issue.","exampleTranslation":"Cô ấy đã cố gắng làm chiến tranh vấn đề đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"history"},"female":{"definition":"Đàn bà con gái, nữ.","example":"She is a strong female candidate for the job.","exampleTranslation":"Cô ấy là một ứng viên nữ sáng giá cho công việc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"female"},"male":{"definition":"Trai, đực, trống.","example":"He is a very kind male friend.","exampleTranslation":"Anh ấy là một người bạn nam rất tốt bụng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"male"},"woman":{"definition":"Tính chất đàn bà, tình cảm đàn bà, nữ tính.","example":"He has something of the woman in him.","exampleTranslation":"Anh ấy có chút gì đó nữ tính trong người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"woman"},"womanhood":{"definition":"Tính chất đàn bà, tính chất phụ nữ; nữ tính.","example":"She spoke about womanhood with pride.","exampleTranslation":"Cô ấy nói về thiên chức làm phụ nữ với niềm tự hào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"woman"},"womanise":{"definition":"Làm cho yếu đuối rụt rè như đàn bà.","example":"Do not womanise a shy boy.","exampleTranslation":"Đừng tán tỉnh một cậu bé nhút nhát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"woman","spellingNote":"Alternate spelling: womanize."},"womanize":{"definition":"Hay đi chơi gái.","example":"He was known to womanize at every club.","exampleTranslation":"Anh ta nổi tiếng là kẻ trăng hoa ở mọi câu lạc bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"woman","spellingNote":"British spelling: womanise."},"womanly":{"definition":"Đàn bà.","example":"He is known for his manly and womanly virtues.","exampleTranslation":"Anh ấy nổi tiếng với những đức tính nam tính và nữ tính của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"woman"},"feminise":{"definition":"Đổi ra giống cái.","example":"The company decided to feminise the plant strain.","exampleTranslation":"Công ty quyết định làm nữ tính hóa chủng cây trồng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"femin","spellingNote":"Alternate spelling: feminize."},"feminism":{"definition":"Thuyết nam nữ bình quyền.","example":"She studied feminism at school.","exampleTranslation":"Cô ấy đã nghiên cứu về nữ quyền ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"femin"},"feminist":{"definition":"Người bênh vực bình quyền cho phụ nữ.","example":"The feminist spoke up for woman's rights.","exampleTranslation":"Nhà nữ quyền đã lên tiếng đòi quyền lợi cho phụ nữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"femin"},"feminization":{"definition":"Sự làm cho uỷ mị, sự làm cho nhu nhược.","example":"The joke felt like feminization of his speech.","exampleTranslation":"Lời nói đùa đó tạo cảm giác như đang làm nữ tính hóa cách nói chuyện của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"femin"},"bias":{"definition":"Đường chéo.","example":"The tailor cut the fabric on the bias.","exampleTranslation":"Người thợ may đã cắt vải theo đường chéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"bias"},"biased":{"definition":"Dạng quá khứ đơn và phân từ quá khứ của bias","example":"The sample was biased by a poor method.","exampleTranslation":"Mẫu nghiên cứu đã bị thiên lệch do phương pháp kém.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"bias"},"biasing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của bias.","example":"She was biasing the scale by mistake.","exampleTranslation":"Cô ấy đã vô tình làm lệch cán cân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"bias"},"sexism":{"definition":"Sự thành kiến, sự phân biệt đối xử do giới tính (nhất là phụ nữ).","example":"Sexism can block fair chances at work.","exampleTranslation":"Phân biệt giới tính có thể ngăn cản những cơ hội công bằng tại nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sexism"},"empower":{"definition":"Cho quyền, trao quyền, cho phép.","example":"Good training can empower young people to lead.","exampleTranslation":"Đào tạo tốt có thể trao quyền cho người trẻ dẫn dắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"empower"},"empowered":{"definition":"Quá khứ và phân từ quá khứ của empower","example":"She empowered the team to decide.","exampleTranslation":"Cô ấy đã trao quyền cho cả nhóm tự đưa ra quyết định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"empower"},"inclusion":{"definition":"Sự gồm cả, sự kể vào, sự kể cả.","example":"The price included the delivery in the inclusion.","exampleTranslation":"Mức giá đã bao gồm cả chi phí vận chuyển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"inclusion"},"inclusive":{"definition":"Gồm cả, kể cả.","example":"The price is fifty dollars inclusive of tax.","exampleTranslation":"Mức giá là năm mươi đô la bao gồm cả thuế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"inclusive"},"inclusively":{"definition":"Theo cách bao gồm mọi người và không loại trừ nhóm nào.","example":"The school designed its lessons inclusively so every student could participate.","exampleTranslation":"Nhà trường thiết kế bài học theo hướng hòa nhập để mọi học sinh đều có thể tham gia.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"inclusive"},"inclusiveness":{"definition":"Tính chất bao gồm.","example":"The club's inclusiveness welcomed every new student.","exampleTranslation":"Tính bao hàm của câu lạc bộ đã chào đón mọi sinh viên mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"inclusive"},"sexuality":{"definition":"Bản năng giới tính; tính chất giới tính.","example":"The study examines how culture and social expectations shape sexuality.","exampleTranslation":"Nghiên cứu xem xét cách văn hóa và kỳ vọng xã hội định hình tính dục.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"sexuality"},"minority":{"definition":"thiểu số; số ít","example":"Most people agreed, but a sizable minority were upset by the decision.","exampleTranslation":"Hầu hết mọi người đều đồng ý, nhưng một bộ phận nhỏ đáng kể đã không hài lòng với quyết định này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"minority"},"racism":{"definition":"Chủ nghĩa phân biệt chủng tộc.","example":"Racism hurts communities and families.","exampleTranslation":"Phân biệt chủng tộc gây tổn hại đến cộng đồng và gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"racism"},"race":{"definition":"Chủng tộc, nòi người.","example":"People from every race live in this city.","exampleTranslation":"Người từ khắp các chủng tộc đều sống ở thành phố này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"race"},"oppression":{"definition":"Sự đàn áp, sự áp bức.","example":"The oppression appeared in the report.","exampleTranslation":"Sự áp bức đã xuất hiện trong bản báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"oppression"},"prejudice":{"definition":"Định kiến, thành kiến, thiên kiến.","example":"We must overcome our prejudice against new people.","exampleTranslation":"Chúng ta phải vượt qua định kiến đối với những người mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"prejudice"},"stereotype":{"definition":"Bản in đúc.","example":"The old book used a stereotype for printing.","exampleTranslation":"Cuốn sách cũ đã sử dụng một bản đúc khuôn mẫu để in ấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"stereotype"},"stereotypes":{"definition":"Động từ chia ở ngôi thứ ba số ít của stereotype","example":"He stereotypes people too quickly from first looks.","exampleTranslation":"Anh ấy dập khuôn mọi người quá nhanh chỉ qua cái nhìn đầu tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"stereotype"},"discriminate":{"definition":"Phân biệt.","example":"Do not discriminate against people based on age.","exampleTranslation":"Đừng phân biệt đối xử với mọi người dựa trên độ tuổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"equality"},"fair":{"definition":"Phải, đúng, hợp lý, không thiên vị, công bằng, ngay thẳng, thẳng thắn, không gian lận.","example":"A fair judge will listen to both sides.","exampleTranslation":"Một vị thẩm phán phải sẽ lắng nghe cả hai phía.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"equality"},"freedom":{"definition":"Quyền tự do (ra vào, sử dụng).","example":"I give you the freedom of my house.","exampleTranslation":"Tôi cho bạn quyền tự do sử dụng ngôi nhà của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"equality"},"homosexuality":{"definition":"Tính tình dục đồng giới.","example":"She saw the homosexuality yesterday.","exampleTranslation":"Cô ấy đã thấy sự tình dục đồng giới hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"equality"},"humane":{"definition":"Nhân đạo, nhân đức.","example":"It was a humane act to help them.","exampleTranslation":"Đó là một hành động nhân đạo để giúp đỡ họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"equality"},"inhuman":{"definition":"Không nhân đạo; tàn bạo, dã man.","example":"The inhuman treatment shocked the neighbors.","exampleTranslation":"Sự đối xử không nhân đạo đó đã làm hàng xóm bị sốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"equality"},"racial":{"definition":"Dòng giống, (thuộc) chủng tộc.","example":"They discussed issues regarding racial equality.","exampleTranslation":"Họ đã thảo luận về các vấn đề liên quan đến bình đẳng chủng tộc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"equality"},"racist":{"definition":"Người phân biệt chủng tộc.","example":"The racist made unfair comments about others.","exampleTranslation":"Người phân biệt chủng tộc","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"equality"},"poor":{"definition":"nghèo, bần cùng","example":"The poor people need more food and shelter.","exampleTranslation":"Những người nghèo cần nhiều thức ăn và nơi ở hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"poor"},"poorly":{"definition":"Không khoẻ, khó ở.","example":"I feel rather poorly today and need some rest.","exampleTranslation":"Hôm nay tôi cảm thấy hơi mệt và cần nghỉ ngơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"poor"},"charity":{"definition":"từ thiện, lòng nhân ái","example":"The group, a Catholic charity that runs schools on Indian reservations, collected nearly $17 million from the public.","exampleTranslation":"Tổ chức này, một hội từ thiện Công giáo điều hành các trường học tại khu dành cho người da đỏ, đã thu thập gần 17 triệu đô la từ công chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"charity"},"charitable":{"definition":"Nhân đức, từ thiện; có lòng thảo.","example":"The group made a charitable gift to the shelter.","exampleTranslation":"Nhóm đã đóng góp một khoản từ thiện cho mái ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"charitable"},"economics":{"definition":"Khoa kinh tế chính trị.","example":"Economics can explain why prices rise.","exampleTranslation":"Kinh tế học có thể giải thích lý do tại sao giá cả tăng lên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"economic"},"opportunity":{"definition":"cơ hội; dịp thuận lợi","example":"Sleep provides an opportunity for the body to repair itself.","exampleTranslation":"Giấc ngủ cung cấp một cơ hội để cơ thể tự phục hồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"opportunity"},"sanitation":{"definition":"Sự cải thiện điều kiện vệ sinh.","example":"Good sanitation keeps the town healthy.","exampleTranslation":"Vệ sinh tốt giúp thị trấn duy trì sức khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sanitation"},"progress":{"definition":"Sự tiến tới, sự tiến bộ; sự tiến triển, sự phát triển.","example":"She makes great progress in learning the new language.","exampleTranslation":"Cô ấy đạt được tiến bộ lớn trong việc học ngôn ngữ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"progress"},"progressed":{"definition":"Quá khứ và phân từ quá khứ của progress","example":"Her English progressed after daily practice.","exampleTranslation":"Tiếng Anh của cô ấy đã tiến bộ sau khi luyện tập hàng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"progress"},"progression":{"definition":"Sự tiến tới; sự tiến bộ; sự tiến triển, sự phát triển.","example":"Her language shows steady progression over the year.","exampleTranslation":"Ngôn ngữ của cô ấy cho thấy sự tiến triển ổn định trong suốt cả năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"progress"},"progressive":{"definition":"Cấp tiến.","example":"They support a progressive plan for school change.","exampleTranslation":"Họ ủng hộ một kế hoạch tiến bộ cho sự thay đổi ở trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"progress"},"underdeveloped":{"definition":"Rửa non.","example":"The film was underdeveloped and looked too dark.","exampleTranslation":"Cuộn phim chưa được tráng hoàn chỉnh nên hình trông quá tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"underdevelop"},"underdevelopment":{"definition":"Sự chậm phát triển.","example":"The village suffered from underdevelopment for years.","exampleTranslation":"Ngôi làng đã chịu cảnh kém phát triển trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"underdevelop"},"industrial":{"definition":"Công nghiệp.","example":"They built a large industrial park.","exampleTranslation":"Họ đã xây dựng một khu công nghiệp lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"industrial"},"industrialisation":{"definition":"Sự công nghiệp hoá.","example":"Industrialisation changed the small town fast.","exampleTranslation":"Công nghiệp hóa đã làm thay đổi thị trấn nhỏ một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"industrial","spellingNote":"US spelling: industrialization."},"industrialise":{"definition":"Công nghiệp hoá.","example":"The town plans to industrialise its river area.","exampleTranslation":"Thị trấn dự định công nghiệp hóa khu vực ven sông của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"industrial","spellingNote":"Alternate spelling: industrialize."},"industrialism":{"definition":"Hệ thống công nghiệp quy mô lớn.","example":"Industrialism changed the city's skyline.","exampleTranslation":"Chủ nghĩa công nghiệp đã làm thay đổi đường chân trời của thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"industrial"},"industrialist":{"definition":"Nhà công nghiệp.","example":"The industrialist opened a new plant.","exampleTranslation":"Nhà công nghiệp đã khai trương một nhà máy mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"industrial"},"industrialization":{"definition":"Sự công nghiệp hoá.","example":"Industrialization changed the small town quickly.","exampleTranslation":"Công nghiệp hóa đã làm thay đổi thị trấn nhỏ một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"industrial","spellingNote":"British spelling: industrialisation."},"industrialize":{"definition":"Công nghiệp hoá.","example":"The country plans to industrialize quickly.","exampleTranslation":"Đất nước có kế hoạch công nghiệp hóa nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"industrial","spellingNote":"British spelling: industrialise."},"industrially":{"definition":"Về phương diện kỹ nghệ, về mặt công nghiệp.","example":"She answered industrially and smiled.","exampleTranslation":"Cô ấy trả lời về mặt công nghiệp rồi mỉm cười.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"industrial"},"adequate":{"definition":"Đủ, đầy đủ.","example":"The food supply is not adequate for everyone.","exampleTranslation":"Nguồn cung cấp thực phẩm không đầy đủ cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"development"},"adequately":{"definition":"Tương xứng, thích đáng, thoả đáng.","example":"She answered adequately and smiled.","exampleTranslation":"Cô ấy trả lời một cách thoả đáng rồi mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"development"},"advance":{"definition":"Sự sớm pha.","example":"The doctor noted a slight advance in time.","exampleTranslation":"Bác sĩ ghi nhận một sự sớm pha nhẹ trong thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"development"},"backward":{"definition":"Chậm tiến, lạc hậu.","example":"They live in a very backward country today.","exampleTranslation":"Họ đang sống ở một đất nước rất lạc hậu ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"development"},"betterment":{"definition":"Sự làm tốt hơn, sự cải tiến, sự cải thiện.","example":"The school saw clear betterment after new teachers arrived.","exampleTranslation":"Trường học đã thấy sự cải thiện rõ rệt sau khi các giáo viên mới đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"development"},"enhance":{"definition":"Làm tăng, nâng cao, đề cao, làm nổi bật (đức tính, quyền hạn... ).","example":"A mirror can enhance the bright room.","exampleTranslation":"Một tấm gương có thể làm nổi bật căn phòng sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"development"},"enhancement":{"definition":"Sự làm tăng, sự nâng cao, sự đề cao, sự làm nổi bật.","example":"The new window brought enhancement to the house.","exampleTranslation":"Chiếc cửa sổ mới mang đến sự nâng cao cho ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"development"},"enrich":{"definition":"Làm giàu, làm giàu thêm, làm phong phú.","example":"Reading can enrich your mind and vocabulary.","exampleTranslation":"Đọc sách có thể làm phong phú tâm trí và vốn từ vựng của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"development"},"famine":{"definition":"Nạn đói kém.","example":"Many people died of famine during the war.","exampleTranslation":"Nhiều người chết vì nạn đói kém trong chiến tranh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"development"},"hardship":{"definition":"Sự gian khổ, sự thử thách gay go.","example":"The long winter brought real hardship.","exampleTranslation":"Mùa đông dài đã mang lại sự gian khổ thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"development"},"improve":{"definition":"Cải tiến, cải thiện, cải tạo, trau dồi (tư tưởng), mở mang (kiến thức... ).","example":"You should practice every day to improve your skills.","exampleTranslation":"Bạn nên luyện tập mỗi ngày để cải thiện các kỹ năng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"development"},"improvement":{"definition":"Sự sửa sang, sự đổi mới (cho đẹp, tốt hơn).","example":"The room showed a clear improvement after cleaning.","exampleTranslation":"Căn phòng cho thấy một sự sửa sang rõ rệt sau khi dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"development"},"undeveloped":{"definition":"Không khai khẩn (đất đai); không lớn (thú); còi (cây).","example":"The field looked undeveloped and covered with wild grass.","exampleTranslation":"Cánh đồng trông như chưa được khai khẩn và phủ đầy cỏ dại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"development"},"consume":{"definition":"Tiêu thụ, lãng phí, bỏ phí.","example":"Do not consume too much sugar every day.","exampleTranslation":"Đừng tiêu thụ quá nhiều đường mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"consume"},"purchase":{"definition":"Thu hoạch hằng năm, hoa lợi hằng năm, lợi tức hằng năm (của đất đai... ).","example":"The land is sold at twenty years purchase.","exampleTranslation":"Mảnh đất được bán với giá trị bằng 20 năm thu nhập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"purchase"},"shopping":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của shop.","example":"She enjoys shopping for books on weekends.","exampleTranslation":"Cô ấy thích đi mua sắm sách vào cuối tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"shopping"},"advertising":{"definition":"Sự quảng cáo, nghề quảng cáo.","example":"She chose advertising as her career.","exampleTranslation":"Cô ấy chọn quảng cáo làm sự nghiệp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"advertising"},"advertisement":{"definition":"Sự quảng cáo; bài quảng cáo (trên báo, trên đài... ).","example":"The advertisement appeared on the morning paper.","exampleTranslation":"Quảng cáo đã xuất hiện trên tờ báo buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"advertisement"},"brand":{"definition":"Bệnh gỉ (cây).","example":"Wet leaves can suffer from brand in damp weather.","exampleTranslation":"Lá ẩm có thể bị mắc bệnh đốm trong thời tiết ẩm ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"brand"},"commercial":{"definition":"Buôn bán; (thuộc) thương mại; (thuộc) thương nghiệp.","example":"They opened a new commercial center in the city.","exampleTranslation":"Họ đã mở một trung tâm thương mại mới trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"commercial"},"commercialise":{"definition":"Thương nghiệp hoá, biến thành hàng hoá, biến thành hàng mua bán.","example":"They hope to commercialise the new fruit safely.","exampleTranslation":"Họ hy vọng có thể thương mại hóa loại trái cây mới một cách an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"commercial","spellingNote":"Alternate spelling: commercialize."},"commercialization":{"definition":"thương mại hóa","example":"The commercialization of the street upset some residents.","exampleTranslation":"Sự thương mại hóa con phố đã làm một số cư dân cảm thấy khó chịu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"commercial"},"commercialize":{"definition":"Thương nghiệp hoá, biến thành hàng hoá, biến thành hàng mua bán.","example":"Companies want to commercialize every part of the game.","exampleTranslation":"Các công ty muốn thương mại hóa mọi phần của trò chơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"commercial","spellingNote":"British spelling: commercialise."},"commercially":{"definition":"Về phương diện thương mại.","example":"The product was not commercially successful despite its innovative design.","exampleTranslation":"Sản phẩm không thành công về mặt thương mại dù có thiết kế sáng tạo.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"commercial"},"retail":{"definition":"Sự bán lẻ.","example":"What is the retail price of this new phone?","exampleTranslation":"Giá bán lẻ của chiếc điện thoại mới này là bao nhiêu?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"retail"},"retailed":{"definition":"Quá khứ và phân từ quá khứ của retail","example":"They retailed the goods at low prices.","exampleTranslation":"Họ bán lẻ các mặt hàng với giá thấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"retail"},"retailer":{"definition":"Người bán lẻ.","example":"The retailer sold bread and milk downtown.","exampleTranslation":"Nhà bán lẻ đã bán bánh mì và sữa ở khu trung tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"retail"},"retailing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của retail.","example":"She is retailing fruit at the market.","exampleTranslation":"Cô ấy đang bán lẻ trái cây tại chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"retail"},"spend":{"definition":"Dùng (thì giờ... ), tốn.","example":"You should spend more time reading every day.","exampleTranslation":"Bạn nên dành nhiều thời gian hơn để đọc sách mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"spend"},"spendable":{"definition":"Có thể dùng được.","example":"The old tools are still spendable at work.","exampleTranslation":"Những công cụ cũ vẫn có thể chi dùng/sử dụng được trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"spend"},"spender":{"definition":"Người tiêu tiền, người tiêu hoang.","example":"He was a careless spender with cash.","exampleTranslation":"Anh ấy là một người tiêu xài hoang phí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"spend"},"expenditure":{"definition":"Sự tiêu dùng.","example":"Careful expenditure helped the company save money.","exampleTranslation":"Việc chi tiêu cẩn thận đã giúp công ty tiết kiệm tiền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"expenditure"},"packaging":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của package.","example":"She was packaging the gifts for the event.","exampleTranslation":"Cô ấy đang đóng gói các món quà cho sự kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"packaging"},"sale":{"definition":"Hàng hoá bán, số hàng hoá bán được.","example":"The sale brought many customers to the shop.","exampleTranslation":"Đợt giảm giá đã thu hút nhiều khách hàng đến cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"sale"},"saleable":{"definition":"Dễ bán, có thể bán được.","example":"This jacket is saleable at a fair price.","exampleTranslation":"Chiếc áo khoác này có thể bán được với một mức giá hợp lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"sale"},"price":{"definition":"Giá cả, cái phải trả để đổi lại một thứ gì đó.","example":"The price of this new car is too high.","exampleTranslation":"Giá của chiếc xe mới này quá cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"price"},"priceless":{"definition":"Quý giá vì rất giải trí, khôi hài, ngộ, lố bịch.","example":"That old comedy movie was absolutely priceless and funny.","exampleTranslation":"Bộ phim hài cũ đó thực sự rất tuyệt vời và hài hước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"price"},"pricey":{"definition":"Đắt tiền.","example":"The hotel was pricey but clean.","exampleTranslation":"Khách sạn đó đắt đỏ nhưng sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"price"},"afford":{"definition":"Có thể, có đủ sức, có đủ khả năng, có đủ điều kiện (để làm gì).","example":"I cannot afford to lose my job right now.","exampleTranslation":"Lúc này tôi không thể để mất việc.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"afford"},"affordable":{"definition":"Không đắt: nice clothes at affordable prices.","example":"This jacket is affordable for students.","exampleTranslation":"Chiếc áo khoác này vừa túi tiền với học sinh, sinh viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"afford"},"afforded":{"definition":"Quá khứ và phân từ quá khứ của afford","example":"The job afforded him extra time.","exampleTranslation":"Công việc đã mang lại cho anh ấy thêm thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"afford"},"auction":{"definition":"Sự bán đấu giá.","example":"They decided to put the old car up for auction.","exampleTranslation":"Họ quyết định mang chiếc xe cũ ra bán đấu giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"basket":{"definition":"Cái rổ, cái giỏ, cái thúng.","example":"She put the fresh fruit in a basket.","exampleTranslation":"Cô ấy đặt trái cây tươi vào cái giỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"bookshop":{"definition":"Hiệu sách.","example":"I found a new novel at the bookshop.","exampleTranslation":"Tôi đã tìm thấy một cuốn tiểu thuyết mới tại hiệu sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"booth":{"definition":"Quán, rạp, lều.","example":"We bought some snacks at the refreshment booth.","exampleTranslation":"Chúng tôi đã mua vài món ăn nhẹ tại quán phục vụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"bottle":{"definition":"Bầu sữa (cho trẻ em bú) ((cũng) feeding).","example":"The baby was brought up on the bottle.","exampleTranslation":"Đứa trẻ được nuôi lớn bằng bầu sữa bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"buyer":{"definition":"Người mua hàng vào (cho một cửa hàng lớn).","example":"The buyer ordered new shoes for the store.","exampleTranslation":"Người mua hàng vào đã đặt hàng những đôi giày mới cho cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"buying":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của buy","example":"Buying fresh fruit makes dinner easier.","exampleTranslation":"Việc mua trái cây tươi làm cho bữa tối trở nên dễ dàng hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"consumerism"},"candle":{"definition":"Cây nến.","example":"She lit a candle on the table.","exampleTranslation":"Cô ấy thắp một cây nến trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"catalogue":{"definition":"Bản liệt kê mục lục.","example":"I checked the catalogue for new books.","exampleTranslation":"Tôi đã kiểm tra bản liệt kê mục lục cho những cuốn sách mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"conditioner":{"definition":"Người thử, người kiểm tra phẩm chất (hàng hoá).","example":"The conditioner checked the quality of each item.","exampleTranslation":"Người kiểm tra phẩm chất đã kiểm tra từng mặt hàng một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"container":{"definition":"Cái đựng, cái chứa (chai, lọ, bình, thành, hộp...), vật chứa.","example":"She poured the soup into a glass container.","exampleTranslation":"Cô ấy đã đổ súp vào một vật chứa thủy tinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"cooler":{"definition":"Máy ướp lạnh, thùng lạnh.","example":"Please put the drinks in the cooler for later.","exampleTranslation":"Làm ơn cho đồ uống vào thùng lạnh để dùng sau nhé.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"cosmetic":{"definition":"Thuốc xức (làm mượt tóc), (thuộc) mỹ dung (phấn, sáp, kem... ).","example":"She bought a cosmetic for dry hair.","exampleTranslation":"Cô ấy mua một loại thuốc xức cho tóc khô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"counter":{"definition":"Quầy hàng, quầy thu tiền.","example":"She works behind the counter at the bakery.","exampleTranslation":"Cô ấy làm việc sau quầy thu tiền tại tiệm bánh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"discount":{"definition":"Sự trừ hao (về mức độ xác thực của một câu chuyện, một bản tin... ).","example":"You should take that strange story at a discount.","exampleTranslation":"Bạn nên xem xét lại câu chuyện kỳ lạ đó với sự trừ hao về độ tin cậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"fake":{"definition":"Vòng dây cáp.","example":"The old bag had a fake on it.","exampleTranslation":"Chiếc túi cũ có một vòng dây cáp trên đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"handbag":{"definition":"Túi xách, ví xách tay (đựng giấy tờ, tiền, son phấn... ).","example":"She kept her keys in her handbag.","exampleTranslation":"Cô ấy giữ chìa khóa trong túi xách của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"headgear":{"definition":"Khăn trùm đầu, mũ (của phụ nữ để tô điểm).","example":"Her headgear matched the dress perfectly.","exampleTranslation":"Khăn trùm đầu của cô ấy rất hợp với chiếc váy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"item":{"definition":"Vật phẩm.","example":"He packed one item into his small bag.","exampleTranslation":"Anh ấy đóng gói một vật phẩm vào chiếc túi nhỏ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"jeans":{"definition":"Quần bằng vải bông dày, mặc khi không cần trịnh trọng, nghi thức; quần gin.","example":"I bought a new pair of blue jeans today.","exampleTranslation":"Tôi đã mua một chiếc quần gin mới hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"jewelry":{"definition":"Đồ châu báu; đồ nữ trang, đồ kim hoàn (nói chung).","example":"She wore simple jewelry to the party.","exampleTranslation":"Cô ấy đeo đồ nữ trang đơn giản đến bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"kohl":{"definition":"Phấn côn (một thứ phấn đen đánh mi mắt của người A-rập).","example":"She lined her eyes with kohl before the party.","exampleTranslation":"Cô ấy kẻ mắt bằng phấn côn trước bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"label":{"definition":"Một miếng vật liệu nhỏ để dính vào vật và cho biết thông tin về vật đó.","example":"The label was important at work.","exampleTranslation":"Cái nhãn đó rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"luxury":{"definition":"Sự xa xỉ, sự xa hoa.","example":"She enjoys a life of luxury in Paris.","exampleTranslation":"Cô ấy tận hưởng một cuộc sống xa xỉ tại Paris.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"mall":{"definition":"Cuộc đi dạo nơi nhiều bóng mát.","example":"We enjoyed a quiet mall in the evening.","exampleTranslation":"Chúng tôi đã tận hưởng một cuộc đi dạo nơi nhiều bóng mát yên tĩnh vào buổi tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"perfume":{"definition":"Hương thơm; mùi thơm.","example":"The perfume lasted all evening.","exampleTranslation":"Hương thơm đã lưu lại suốt buổi tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"perfumer":{"definition":"Người bán nước hoa.","example":"The perfumer helped me choose a light scent.","exampleTranslation":"Người bán nước hoa đã giúp tôi chọn một mùi hương nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"perfumery":{"definition":"Xưởng chế nước hoa.","example":"She works in a perfumery near the market.","exampleTranslation":"Cô ấy làm việc trong một xưởng chế nước hoa gần chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"quality":{"definition":"Phẩm chất ưu tú, tính chất hảo hạng.","example":"This handmade vase has excellent quality and design.","exampleTranslation":"Chiếc bình làm thủ công này có chất lượng và thiết kế tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"razor":{"definition":"Dao cạo.","example":"He shaved with a sharp razor.","exampleTranslation":"Anh ấy cạo râu bằng một chiếc dao cạo sắc bén.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"refrigerator":{"definition":"Tủ ướp lạnh, phòng ướp lạnh.","example":"The refrigerator kept the milk cold.","exampleTranslation":"Tủ lạnh giữ cho sữa luôn lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"ribbon":{"definition":"Dải, băng, ruy băng.","example":"She tied a silk ribbon around her hair.","exampleTranslation":"Cô ấy buộc một dải ruy băng lụa quanh tóc mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"seller":{"definition":"Thứ bán được, đồ bán được.","example":"That old book is a best seller this month.","exampleTranslation":"Cuốn sách cũ đó là thứ bán chạy nhất trong tháng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"shampoo":{"definition":"Sự gội đầu.","example":"A quick shampoo can make hair feel fresh.","exampleTranslation":"Việc gội đầu nhanh có thể làm cho tóc cảm thấy tươi mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"shoe":{"definition":"Sắt bịt móng (ngựa... ).","example":"The horse lost a shoe on the road.","exampleTranslation":"Con ngựa bị rơi một chiếc sắt bịt móng trên đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"shop":{"definition":"Cơ sở, trường sở nghề nghiệp, công việc làm ăn.","example":"He decided to set up shop in the city.","exampleTranslation":"Anh ấy quyết định mở cơ sở kinh doanh trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"shopper":{"definition":"Người đi mua hàng.","example":"The shopper compared prices before buying rice.","exampleTranslation":"Người đi mua hàng đã so sánh giá cả trước khi mua gạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"soap":{"definition":"Xà phòng.","example":"Please pass the soap near the sink.","exampleTranslation":"Vui lòng đưa xà phòng gần bồn rửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"softener":{"definition":"Thuốc làm mềm, chất làm mềm.","example":"Add a softener to make the cloth smoother.","exampleTranslation":"Thêm chất làm mềm để vải mịn hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"spoon":{"definition":"Cái thìa.","example":"Please pass me a spoon for the soup.","exampleTranslation":"Vui lòng đưa tôi một cái thìa để ăn xúp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"store":{"definition":"Sự có nhiều, sự dồi dào.","example":"The old man has a store of wisdom.","exampleTranslation":"Ông già có sự dồi dào về trí tuệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"supermarket":{"definition":"Cửa hàng tự động lớn (bán đồ ăn và đồ dùng trong nhà).","example":"We bought milk at the supermarket.","exampleTranslation":"Chúng tôi đã mua sữa ở siêu thị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"vendor":{"definition":"Vender.","example":"The vendor sold fresh fruit near the station.","exampleTranslation":"Người bán hàng đã bán trái cây tươi gần nhà ga.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"consumerism"},"architecture":{"definition":"Thuật kiến trúc, khoa kiến trúc, khoa xây dựng.","example":"She studied architecture at college.","exampleTranslation":"Cô ấy đã học ngành kiến trúc tại trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"design":{"definition":"Đề cương, bản phác thảo, phác hoạ, đồ án.","example":"I really like the design of this new chair.","exampleTranslation":"Tôi thực sự thích kiểu dáng của chiếc ghế mới này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"design"},"designed":{"definition":"Quá khứ và phân từ quá khứ của design","example":"She designed a simple and useful chair.","exampleTranslation":"Cô ấy đã thiết kế một chiếc ghế đơn giản và hữu dụng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"design"},"designer":{"definition":"Người phác hoạ, người vẽ kiểu, người phác thảo cách trình bày (một quyển sách... ), người trang trí (sân khấu... ), người thiết kế (vườn, công viên... ).","example":"The designer sketched a bright room.","exampleTranslation":"Nhà thiết kế đã phác thảo một căn phòng sáng sủa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"design"},"designing":{"definition":"Sự phác hoạ, sự vẽ kiểu, sự thiết kế, sự trình bày.","example":"The designing took most of the morning.","exampleTranslation":"Công việc thiết kế đã chiếm phần lớn thời gian buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"design"},"structure":{"definition":"Kết cấu, cấu trúc.","example":"The structure of the poem is very complex.","exampleTranslation":"Cấu trúc của bài thơ này rất phức tạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"structure"},"plan":{"definition":"Sơ đồ, đồ án (nhà... ).","example":"We need a clear plan for the new house.","exampleTranslation":"Chúng ta cần một kế hoạch rõ ràng cho ngôi nhà mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"plan"},"planed":{"definition":"Quá khứ và phân từ quá khứ của plane","example":"He planed the wood until it was smooth.","exampleTranslation":"Anh ấy đã bào gỗ cho đến khi bề mặt nhẵn nhụi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"plan"},"planer":{"definition":"Thợ bào.","example":"The planer smoothed the wooden board.","exampleTranslation":"Máy bào đã làm phẳng tấm gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"plan"},"planes":{"definition":"Động từ chia ở ngôi thứ ba số ít của plane","example":"She planes the board carefully.","exampleTranslation":"Cô ấy bào tấm gỗ một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"plan"},"planing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của plane.","example":"She is planing the board until it is flat.","exampleTranslation":"Cô ấy đang bào tấm gỗ cho đến khi nó phẳng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"plan"},"landscape":{"definition":"Phong cảnh, thắng cảnh.","example":"We hiked through beautiful landscape yesterday.","exampleTranslation":"Chúng tôi đã đi bộ đường dài qua khung cảnh đẹp đẽ vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"landscape"},"interior":{"definition":"Ở trong, ở phía trong.","example":"Please clean the interior walls of the room.","exampleTranslation":"Làm ơn hãy lau sạch các bức tường bên trong của căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"interior"},"exterior":{"definition":"Ngoài, ở ngoài, từ ngoài vào.","example":"Please paint the exterior wall of the building.","exampleTranslation":"Làm ơn hãy sơn bức tường bên ngoài của tòa nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"exterior"},"modernisation":{"definition":"Sự hiện đại hóa.","example":"The modernisation of the railway network will significantly shorten travel times.","exampleTranslation":"Việc hiện đại hóa mạng lưới đường sắt sẽ rút ngắn đáng kể thời gian di chuyển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"modern","spellingNote":"Alternate spelling: modernization."},"modernise":{"definition":"Hiện đại hoá; đổi mới.","example":"They modernise the old school every year.","exampleTranslation":"Họ hiện đại hóa ngôi trường cũ mỗi năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"modern","spellingNote":"Alternate spelling: modernize."},"modernism":{"definition":"Từ ngữ cận đại.","example":"That word is a modernism in daily speech.","exampleTranslation":"Từ đó là một từ ngữ hiện đại trong lời nói hằng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"modern"},"modernist":{"definition":"Người ủng hộ cái mới.","example":"The modernist loved clean lines and fresh ideas.","exampleTranslation":"Người theo trường phái hiện đại yêu thích những đường nét gọn gàng và ý tưởng mới mẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"modern"},"modernization":{"definition":"Sự hiện đại hoá; sự đổi mới.","example":"The town needs modernization and better roads.","exampleTranslation":"Thị trấn cần sự hiện đại hóa và những con đường tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"modern","spellingNote":"British spelling: modernisation."},"modernize":{"definition":"Hiện đại hoá; đổi mới.","example":"The team had to modernize the system.","exampleTranslation":"Đội ngũ đã phải hiện đại hóa hệ thống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"modern","spellingNote":"British spelling: modernise."},"traditionalism":{"definition":"Sự tôn trọng truyền thống.","example":"Her traditionalism gave the home a calm feel.","exampleTranslation":"Chủ nghĩa truyền thống của cô ấy mang lại cảm giác bình yên cho ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"traditional"},"traditionalist":{"definition":"Người theo chủ nghĩa truyền thống.","example":"Her grandfather was a traditionalist.","exampleTranslation":"Ông của cô ấy là một người theo chủ nghĩa truyền thống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"traditional"},"traditionalize":{"definition":"Biến thành truyền thống.","example":"They tried to traditionalize the custom.","exampleTranslation":"Họ đã cố gắng truyền thống hóa phong tục này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"traditional"},"function":{"definition":"Chức năng.","example":"What is the main function of this machine?","exampleTranslation":"Chức năng chính của chiếc máy này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"function"},"functional":{"definition":"Có công năng thực tế; hoạt động đúng mục đích.","example":"The chair is functional, but it is not pretty.","exampleTranslation":"Chiếc ghế này có công năng tốt nhưng không đẹp.","dictionarySource":"authored","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"function"},"functioned":{"definition":"Quá khứ và phân từ quá khứ của function","example":"The machine functioned all day.","exampleTranslation":"Cỗ máy đã hoạt động suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"function"},"functionless":{"definition":"Không có chức năng.","example":"That old button is functionless now.","exampleTranslation":"Cái nút cũ đó giờ đã vô dụng rồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"function"},"engineer":{"definition":"Kỹ sư, công trình sư.","example":"The engineer designed a flood-resistant bridge for the coastal community.","exampleTranslation":"Kỹ sư đã thiết kế một cây cầu chống lũ cho cộng đồng ven biển.","dictionarySource":"offline","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"engineer"},"engineered":{"definition":"Quá khứ và phân từ quá khứ của engineer","example":"They engineered a simple solution for the problem.","exampleTranslation":"Họ đã thiết kế ra một giải pháp đơn giản cho vấn đề này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"engineer"},"engineering":{"definition":"Kỹ thuật xây dựng ((cũng) civil engineerings).","example":"Civil engineering projects require careful planning and design.","exampleTranslation":"Các dự án kỹ thuật dân dụng đòi hỏi sự lập kế hoạch và thiết kế cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"engineer"},"material":{"definition":"Vật chất.","example":"We live in a complex material world today.","exampleTranslation":"Chúng ta đang sống trong một thế giới vật chất phức tạp ngày nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"material"},"materialise":{"definition":"Cụ thể hoá; thành sự thật; thực hiện.","example":"Her idea finally materialise after years of work.","exampleTranslation":"Ý tưởng của cô ấy cuối cùng cũng hiện thực hóa sau nhiều năm làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"material","spellingNote":"Alternate spelling: materialize."},"materialism":{"definition":"Chủ nghĩa duy vật.","example":"He was criticized for his extreme materialism.","exampleTranslation":"Anh ấy bị chỉ trích vì chủ nghĩa vật chất cực đoan của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"material"},"materialist":{"definition":"Người nặng về vật chất, người quá thiên về vật chất.","example":"He seemed materialist, always chasing money and gifts.","exampleTranslation":"Anh ta có vẻ là người thực dụng, luôn chạy theo tiền bạc và vật chất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"material"},"materiality":{"definition":"Tính vật chất, tính hữu tình; thực chất.","example":"They discussed the materiality today.","exampleTranslation":"Họ đã thảo luận về tính vật chất ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"material"},"materialization":{"definition":"Sự vật chất hoá.","example":"Her idea needed materialization before Friday.","exampleTranslation":"Ý tưởng của cô ấy cần phải được cụ thể hóa trước thứ Sáu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"material"},"materialize":{"definition":"Cụ thể hoá; thành sự thật; thực hiện.","example":"Our plans to build a new house did not materialize.","exampleTranslation":"Kế hoạch xây nhà mới của chúng tôi đã không thành hiện thực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"material","spellingNote":"British spelling: materialise."},"functionality":{"definition":"Tính năng hoặc khả năng hoạt động của một thiết kế hay sản phẩm.","example":"The new building combines energy efficiency with practical functionality.","exampleTranslation":"Tòa nhà mới kết hợp hiệu quả năng lượng với tính ứng dụng thực tế.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"arch":{"definition":"Tinh nghịch, tinh quái, hóm, láu.","example":"He gave me an arch smile during the meeting.","exampleTranslation":"Anh ấy nở một nụ cười tinh quái trong buổi họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"architectural":{"definition":"Kiến trúc.","example":"They studied architectural engineering in college.","exampleTranslation":"Họ đã học kỹ thuật kiến trúc ở trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"balcony":{"definition":"Bao lơn.","example":"She watched the street from the balcony.","exampleTranslation":"Cô ấy quan sát đường phố từ bao lơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"brick":{"definition":"Bằng gạch.","example":"We built a solid brick wall around the yard.","exampleTranslation":"Chúng tôi đã xây một bức tường bằng gạch vững chắc quanh sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"buffet":{"definition":"Tủ đựng bát đĩa.","example":"The plates sat on the buffet in the hall.","exampleTranslation":"Những chiếc đĩa đặt trên tủ đựng bát đĩa ở hành lang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"cabin":{"definition":"Nhà gỗ nhỏ, túp lều.","example":"They slept in a cabin by the lake.","exampleTranslation":"Họ ngủ trong một nhà gỗ nhỏ bên hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"cathedral":{"definition":"Nhà thờ chính tòa; nhà thờ lớn.","example":"The cathedral rose above the old town.","exampleTranslation":"Nhà thờ chính tòa cao vút trên thị trấn cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"ceiling":{"definition":"Trần (nhà... ).","example":"A bird flew near the ceiling.","exampleTranslation":"Một con chim đã bay gần trần nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"chamber":{"definition":"Buồng, phòng; buồng ngủ.","example":"He left his coat in the chamber.","exampleTranslation":"Anh ấy đã để lại chiếc áo khoác của mình trong buồng ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"column":{"definition":"Cột, trụ ((nghĩa đen) & (nghĩa bóng)).","example":"A tall column of smoke rose into the sky.","exampleTranslation":"Một cột khói cao bốc lên không trung.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"concrete":{"definition":"Bằng bê tông.","example":"They built a concrete wall around the yard.","exampleTranslation":"Họ đã xây dựng một bức tường bê tông quanh sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"construct":{"definition":"Làm xây dựng (nhà cửa... ).","example":"They construct a new school here.","exampleTranslation":"Họ xây dựng một ngôi trường mới ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"architecture"},"corridor":{"definition":"Hành lang (nhà, toa xe lửa).","example":"The corridor was quiet after class.","exampleTranslation":"Hành lang yên tĩnh sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"courtyard":{"definition":"Sân nhỏ; sân trong; giếng trời","example":"We ate lunch in the courtyard.","exampleTranslation":"Chúng tôi ăn trưa ở sân trong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"elaborate":{"definition":"Phức tạp.","example":"The jewelry was a very elaborate piece of art.","exampleTranslation":"Món đồ trang sức là một tác phẩm nghệ thuật phức tạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"erect":{"definition":"Thẳng, đứng thẳng.","example":"He stood erect during the ceremony.","exampleTranslation":"Anh ấy đứng thẳng trong suốt buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"erection":{"definition":"Sự đứng thẳng; sự dựng đứng.","example":"The erection of the tent took ten minutes.","exampleTranslation":"Sự dựng đứng chiếc lều mất mười phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"eyesore":{"definition":"Điều chướng mắt; vật chướng mắt; cái gai trong mắt.","example":"That broken wall is an eyesore in the yard.","exampleTranslation":"Bức tường bị hỏng đó là vật chướng mắt trong sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"floor":{"definition":"Sàn (nhà, cầu... ).","example":"Please sweep the dirt off the kitchen floor.","exampleTranslation":"Vui lòng quét sạch bụi bẩn khỏi sàn nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"fortress":{"definition":"Pháo đài.","example":"The old fortress stood above the river.","exampleTranslation":"Pháo đài cũ đứng trên sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"foundation":{"definition":"Sự thành lập, sự sáng lập, sự thiết lập.","example":"The foundation of the club began in spring.","exampleTranslation":"Sự thành lập của câu lạc bộ bắt đầu vào mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"fountain":{"definition":"Suối nước, nguồn sông.","example":"The fountain came from a clear mountain spring.","exampleTranslation":"Suối nước bắt nguồn từ một nguồn núi trong xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"frame":{"definition":"Cấu trúc, cơ cấu; hệ thống, thứ tự.","example":"We need to study the frame of society.","exampleTranslation":"Chúng ta cần nghiên cứu cấu trúc của xã hội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"framework":{"definition":"Sườn (nhà, tàu... ); khung (máy).","example":"The builder checked the framework before adding walls.","exampleTranslation":"Người xây dựng đã kiểm tra sườn trước khi thêm các bức tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"frontage":{"definition":"Khoảng đất trước nhà (giữa mặt trước nhà và đường phố).","example":"The shop has good frontage on the main road.","exampleTranslation":"Cửa hàng có khoảng đất trước nhà đẹp hướng ra con đường chính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"gate":{"definition":"Cửa đập, cửa cống.","example":"Open the gate to let the water through.","exampleTranslation":"Hãy mở cửa đập để cho nước chảy qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"hall":{"definition":"Phòng lớn, đại sảnh (trong các lâu đài).","example":"We met in the school hall before class.","exampleTranslation":"Chúng tôi gặp nhau ở đại sảnh trường trước khi vào lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"indoor":{"definition":"Trong nhà.","example":"We enjoyed some indoor games during the rain.","exampleTranslation":"Chúng tôi đã thưởng thức một số trò chơi trong nhà trong khi mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"insulation":{"definition":"Sự cô lập, sự cách ly.","example":"Thick insulation keeps the house warm in winter.","exampleTranslation":"Sự cách ly dày giữ cho ngôi nhà ấm áp vào mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"layout":{"definition":"Bố cục, bố trí, xếp đặt, layout.","example":"The layout of the room feels open and calm.","exampleTranslation":"Bố cục của căn phòng tạo cảm giác thoáng đãng và bình yên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"mason":{"definition":"Thợ nề.","example":"The mason fixed the wall before sunset.","exampleTranslation":"Thợ nề đã sửa bức tường trước khi hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"moat":{"definition":"Hào (xung quanh thành trì... ).","example":"The moat was important at work.","exampleTranslation":"Hào nước rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"mortar":{"definition":"Vữa, hồ.","example":"The mortar was important at work.","exampleTranslation":"Vữa rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"mould":{"definition":"Đường gờ, đường chỉ.","example":"The wall has a thin mould along the top.","exampleTranslation":"Bức tường có một đường gờ mỏng dọc theo phía trên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"overhung":{"definition":"Phần nhô ra.","example":"The old roof had a deep overhung.","exampleTranslation":"Mái nhà cũ có một phần nhô ra khá sâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"pavilion":{"definition":"Che bằng lều; dựng lều, dựng rạp.","example":"They pavilion the field for the school fair.","exampleTranslation":"Họ dựng rạp cho cánh đồng phục vụ hội chợ trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"architecture"},"plank":{"definition":"Tấm ván (thường là loại dài, bề dày từ 5 cm đến 15 cm, bề ngang từ 23 cm trở lên).","example":"He carried a long plank across the yard.","exampleTranslation":"Anh ấy mang theo một tấm ván dài qua sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"plaster":{"definition":"Phết đầy, dán đầy, bôi đầy, làm dính đầy.","example":"The critics began to plaster him with many awards.","exampleTranslation":"Các nhà phê bình bắt đầu phết đầy cho ông ấy nhiều giải thưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"architecture"},"prop":{"definition":"Cái chống, nạng chống.","example":"A wooden prop held the broken shelf up.","exampleTranslation":"Một cái chống bằng gỗ đã đỡ chiếc kệ bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"rebuild":{"definition":"Xây lại, xây dựng lại.","example":"We rebuild the shed every summer.","exampleTranslation":"Chúng tôi xây dựng lại nhà kho vào mỗi mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"architecture"},"recess":{"definition":"Chỗ thụt vào (của dãy núi).","example":"A recess in the cliff held a nest.","exampleTranslation":"Một hốc trên vách đá là nơi chứa một cái tổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"refurbish":{"definition":"Tân trang lại, trang trí lại.","example":"They refurbish the old classroom today.","exampleTranslation":"Họ tân trang lại lớp học cũ ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"architecture"},"renovate":{"definition":"Làm mới lại, đổi mới; cải tiến, sửa chữa lại.","example":"We will renovate the old kitchen this summer.","exampleTranslation":"Chúng tôi sẽ sửa sang lại căn bếp cũ vào mùa hè này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"architecture"},"roof":{"definition":"Mái nhà, nóc.","example":"The workers are repairing the old tiled roof.","exampleTranslation":"Những người thợ đang sửa phần mái ngói cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"shed":{"definition":"Lán, túp lều (đề hàng hoá, dụng cụ).","example":"We kept the tools in the shed.","exampleTranslation":"Chúng tôi giữ các dụng cụ trong nhà kho.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"shelf":{"definition":"Đá ngầm; bãi cạn.","example":"The boat stopped near a shelf of rock.","exampleTranslation":"Con thuyền dừng lại gần một bãi đá ngầm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"site":{"definition":"Nơi, chỗ, vị trí.","example":"This park is a good site for a picnic.","exampleTranslation":"Công viên này là một nơi tốt cho buổi dã ngoại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"slab":{"definition":"Tấm ván bìa.","example":"He cut a slab from the wooden board.","exampleTranslation":"Anh ấy cắt một tấm ván bìa từ tấm gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"spire":{"definition":"Ngọn thân (kể từ chỗ bắt đầu có cành trở lên); cọng (cỏ).","example":"The spire of the grass bent in wind.","exampleTranslation":"Ngọn thân cỏ uốn cong trong gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"stair":{"definition":"Bậc thang.","example":"He sat on the top stair.","exampleTranslation":"Anh ấy ngồi trên bậc thang trên cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"stonemason":{"definition":"Thợ xây đá.","example":"A stonemason shaped the block carefully.","exampleTranslation":"Một thợ xây đá đã tạo hình khối đá một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"stonework":{"definition":"Nghề thợ nề, nghề xây đá.","example":"He studied stonework at the workshop.","exampleTranslation":"Anh ấy đã học nghề xây đá tại xưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"storefront":{"definition":"Mặt trước cửa hàng.","example":"The storefront was bright and clean.","exampleTranslation":"Mặt trước cửa hàng sáng sủa và sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"storey":{"definition":"Tầng, tầng gác.","example":"They live on the third storey of the house.","exampleTranslation":"Họ sống trên tầng thứ ba của ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"structural":{"definition":"Xây dựng, để xây dựng.","example":"The engineers studied the structural mechanics of the bridge.","exampleTranslation":"Các kỹ sư nghiên cứu cơ học xây dựng của cây cầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"terrace":{"definition":"Mái bằng, sân thượng; sân hiên.","example":"The hotel has a small terrace for tea.","exampleTranslation":"Khách sạn có một sân thượng nhỏ để uống trà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"tile":{"definition":"Mũ chóp cao.","example":"She wore a tall tile at the party.","exampleTranslation":"Cô ấy đội một cái mũ chóp cao tại bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"tower":{"definition":"Tháp.","example":"The old clock tower stands in the center.","exampleTranslation":"Tháp đồng hồ cũ đứng ở trung tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"unbuilt":{"definition":"Chưa xây dựng (xong).","example":"The unbuilt house will be ready next year.","exampleTranslation":"Ngôi nhà chưa xây dựng xong sẽ sẵn sàng vào năm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"vertical":{"definition":"Thẳng đứng, đứng.","example":"Please draw a vertical line on this paper.","exampleTranslation":"Vui lòng vẽ một đường thẳng đứng trên giấy này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"wall":{"definition":"Tường, vách.","example":"I stared at the blank wall for a minute.","exampleTranslation":"Tôi nhìn chằm chằm vào bức tường trống trong một phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"window":{"definition":"Cửa sổ.","example":"Please open the window to let in some fresh air.","exampleTranslation":"Vui lòng mở cửa sổ để đón chút không khí trong lành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"architecture"},"windowless":{"definition":"Không có cửa sổ.","example":"We stayed in a windowless room.","exampleTranslation":"Chúng tôi đã ở trong một căn phòng không có cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"architecture"},"wild":{"definition":"Dại, hoang (ở) rừng.","example":"We saw some wild grass in the field.","exampleTranslation":"Chúng tôi thấy vài loại cỏ dại trên cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"wild"},"wildly":{"definition":"Cực kỳ, dã man, kinh khủng (chỉ một mức độ rất lớn).","example":"Attitudes about everything from the income tax to sex on TV diverge wildly from place to place.","exampleTranslation":"Quan điểm về mọi thứ từ thuế thu nhập đến cảnh nóng trên truyền hình khác nhau rất xa giữa các nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"wild"},"wildness":{"definition":"Tính chất man rợ.","example":"The old story showed the wildness of the crowd.","exampleTranslation":"Câu chuyện cũ cho thấy sự hung dữ của đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"wild"},"ecologically":{"definition":"Về phương diện sinh thái.","example":"They worked ecologically all day.","exampleTranslation":"Họ đã làm việc theo cách thân thiện với môi trường suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"ecological"},"endangered":{"definition":"Bị đe dọa.","example":"The tiger is an endangered species today.","exampleTranslation":"Hổ hiện là một loài đang bị đe dọa tuyệt chủng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"endangered"},"organism":{"definition":"Cơ thể; sinh vật.","example":"A single organism can live in hot water.","exampleTranslation":"Một sinh vật đơn lẻ có thể sống trong nước nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"organism"},"prey":{"definition":"Mồi, nạn nhân (của ai, của bệnh hoạn, của sự sợ hãi... ).","example":"The hungry wolf hunted for its next prey in the woods.","exampleTranslation":"Con sói đói đang săn tìm con mồi tiếp theo trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"prey"},"aquatics":{"definition":"Những môn thể thao dưới nước (bơi lội, bóng nước... ).","example":"She enjoys aquatics during summer.","exampleTranslation":"Cô ấy thích các môn thể thao dưới nước vào mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"aquatic"},"migrating":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của migrate.","example":"Birds were migrating south before winter.","exampleTranslation":"Các loài chim đang di cư về phía nam trước mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"migrat"},"nature":{"definition":"Tự nhiên, thiên nhiên, tạo hóa.","example":"We must respect the power of nature around us.","exampleTranslation":"Chúng ta phải tôn trọng sức mạnh của thiên nhiên xung quanh mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"nature"},"biological":{"definition":"Sinh vật học.","example":"The biological test took one hour.","exampleTranslation":"Bài kiểm tra sinh học kéo dài một tiếng đồng hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biological"},"plantable":{"definition":"Có thể trồng được.","example":"This garden is plantable in spring.","exampleTranslation":"Khu vườn này có thể trồng trọt được vào mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"plant"},"planter":{"definition":"Chủ đồn điền.","example":"The planter owned a large farm.","exampleTranslation":"Người chủ đồn điền sở hữu một trang trại lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"plant"},"plants":{"definition":"Dạng ngôi thứ ba số ít đơn present trần thuật của plant","example":"She plants seeds every spring.","exampleTranslation":"Cô ấy gieo hạt vào mỗi mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"plant"},"acacia":{"definition":"Giống cây keo.","example":"An acacia grew beside the dusty road.","exampleTranslation":"Một cây keo mọc bên cạnh con đường đầy bụi bặm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"antler":{"definition":"Nhánh gạc.","example":"The antler was useful in class.","exampleTranslation":"Nhánh gạc rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"apes":{"definition":"Động từ chia ở ngôi thứ ba số ít của ape","example":"He apes his friend's style at school.","exampleTranslation":"Anh ấy bắt chước phong cách của bạn mình ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"archerfish":{"definition":"Cá tôxôt.","example":"The archerfish shot water at the insect.","exampleTranslation":"Cá tôxôt đã bắn nước vào côn trùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"beak":{"definition":"Vật hình mỏ.","example":"The tool has a sharp beak for cutting.","exampleTranslation":"Công cụ có vật hình mỏ sắc bén để cắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"beast":{"definition":"Thú vật, súc vật.","example":"The wild beast ran through the dark forest.","exampleTranslation":"Con thú vật hoang dã chạy qua khu rừng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"beaver":{"definition":"Con hải ly.","example":"A beaver built a dam near the creek.","exampleTranslation":"Con hải ly đã xây một cái đập gần con lạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"beetle":{"definition":"Cái chày.","example":"She used a beetle to pound the grain.","exampleTranslation":"Cô ấy đã dùng cái chày để giã ngũ cốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"birch":{"definition":"Giống cây cáng lò, giống cây bulô.","example":"A birch grew beside the path.","exampleTranslation":"Một cây bulô mọc bên cạnh lối đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"bird":{"definition":"Gã, thằng cha.","example":"That guy is a queer bird from the city.","exampleTranslation":"Gã đó là một thằng cha kỳ quặc từ thành phố đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"birdsong":{"definition":"Tiếng hót của chim.","example":"Birdsong woke me early this morning.","exampleTranslation":"Tiếng hót của chim đã đánh thức tôi dậy sớm sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"bittern":{"definition":"Con vạc.","example":"A bittern stood still near the reeds.","exampleTranslation":"Một con vạc đứng yên gần những cây lau sậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"bullrush":{"definition":"Cỏ lõi bấc.","example":"The bullrush grew along the pond.","exampleTranslation":"Cỏ lõi bấc mọc dọc theo bờ ao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"burrow":{"definition":"Hang (cầy, thỏ).","example":"The rabbit hid in a burrow.","exampleTranslation":"Con thỏ đã trốn trong một cái hang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"cage":{"definition":"Trại giam tù binh; nhà giam, nhà lao.","example":"The old cage was used to hold prisoners.","exampleTranslation":"Trại giam tù binh cũ từng được dùng để giam giữ các tù nhân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"camel":{"definition":"Lạc đà.","example":"The camel walked across the hot sand.","exampleTranslation":"Con lạc đà bước đi trên cát nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"chick":{"definition":"Gà con; chim con.","example":"The chick followed its mother closely.","exampleTranslation":"Con gà con theo sát mẹ nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"chimp":{"definition":"Tinh tinh.","example":"The chimp swung from branch to branch.","exampleTranslation":"Con tinh tinh đã đu từ cành này sang cành khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"chimpanzee":{"definition":"Con tinh tinh (vượn).","example":"The chimpanzee used a stick to reach fruit.","exampleTranslation":"Con tinh tinh đã dùng một chiếc gậy để lấy trái cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"claw":{"definition":"Vuốt (mèo, chim).","example":"The cat raised one sharp claw.","exampleTranslation":"Con mèo đã giương một cái vuốt sắc bén lên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"codling":{"definition":"Cá tuyết con, cá moruy con.","example":"The codling swam near the boat.","exampleTranslation":"Con cá tuyết con đã bơi gần con thuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"coot":{"definition":"Chim sâm cầm.","example":"A coot swam quietly across the pond.","exampleTranslation":"Một con chim sâm cầm bơi lặng lẽ qua ao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"coral":{"definition":"Đỏ như san hô.","example":"She wore a dress in a coral color.","exampleTranslation":"Cô ấy mặc một chiếc váy màu đỏ như san hô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"crab":{"definition":"Can rận ((cũng) crab louse).","example":"The doctor found a crab in the hair.","exampleTranslation":"Bác sĩ tìm thấy một con chấy cua trong tóc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"cricket":{"definition":"Động con dế.","example":"A cricket sang outside the window.","exampleTranslation":"Một con dế kêu ngoài cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"crocodile":{"definition":"Cá sấu châu Phi, cá sấu.","example":"A crocodile slept near the river bank.","exampleTranslation":"Một con cá sấu nằm ngủ gần bờ sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"cubs":{"definition":"Động từ chia ở ngôi thứ ba số ít của cub","example":"The farmer cubs the young animals at night.","exampleTranslation":"Người nông dân nuôi các động vật con vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"cuckoo":{"definition":"Chàng ngốc.","example":"Don't be a cuckoo and forget your keys.","exampleTranslation":"Đừng trở thành một chàng ngốc và quên chìa khóa của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"deer":{"definition":"Hươu, nai.","example":"A small deer ran across the green field.","exampleTranslation":"Một con hươu nhỏ chạy ngang qua cánh đồng xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"dodo":{"definition":"Chim cưu (thuộc bộ bồ câu, nay đã tuyệt chủng).","example":"The dodo is known as an extinct bird.","exampleTranslation":"Chim dodo được biết đến như một loài chim đã tuyệt chủng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"dolphin":{"definition":"Cá heo mỏ.","example":"A dolphin jumped beside the boat.","exampleTranslation":"Một con cá heo mỏ nhảy bên cạnh con thuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"duck":{"definition":"Con vịt, vịt cái.","example":"A duck crossed the path near the pond.","exampleTranslation":"Một con vịt băng qua lối đi gần cái ao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"elephant":{"definition":"Khổ giấy 70 cm x 57, 5 cm.","example":"The artist used a double elephant paper size.","exampleTranslation":"Người nghệ sĩ đã sử dụng loại khổ giấy 70 cm x 57, 5 cm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"ember":{"definition":"Chim lặn gavia.","example":"The ember rested at the edge of the lake.","exampleTranslation":"Chú chim lặn gavia nghỉ ngơi tại mép hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"eucalyptus":{"definition":"Cây khuynh diệp, cây bạch đàn.","example":"A eucalyptus grew beside the fence.","exampleTranslation":"Một cây bạch đàn mọc bên cạnh hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"evergreen":{"definition":"Cây thường xanh.","example":"An evergreen stayed green through the winter.","exampleTranslation":"Một cây thường xanh vẫn xanh tươi suốt cả mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"falcon":{"definition":"Chim ưng, chim cắt.","example":"The falcon soared above the field.","exampleTranslation":"Chim ưng bay lượn trên cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"feather":{"definition":"Bộ lông, bộ cánh.","example":"The bird lost a feather in the wind.","exampleTranslation":"Con chim đã đánh mất một bộ lông trong gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"fern":{"definition":"Cây dương xỉ.","example":"A fern grew beside the window.","exampleTranslation":"Một cây dương xỉ mọc bên cạnh cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"finch":{"definition":"Chim họ sẻ.","example":"A finch sang on the fence.","exampleTranslation":"Chim họ sẻ đã hót trên hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"fish":{"definition":"Người cắn câu, người bị mồi chài.","example":"He was an easy fish for the scam.","exampleTranslation":"Anh ấy là một người cắn câu dễ dàng cho vụ lừa đảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"fledged":{"definition":"Đã đủ lông, đã có thể bay (chim non).","example":"The fledged bird left the nest at dawn.","exampleTranslation":"Con chim đã đủ lông rời tổ vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"flies":{"definition":"Động từ chia ở ngôi thứ ba số ít của fly","example":"A kite flies high in the wind.","exampleTranslation":"Một con diều bay cao trong gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"flock":{"definition":"Cụm, túm (bông, len).","example":"A flock of wool sat on the table.","exampleTranslation":"Một cụm bông nằm trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"flower":{"definition":"Hoa, bông hoa, đoá hoa.","example":"I bought a beautiful yellow flower for my mother.","exampleTranslation":"Tôi đã mua một đóa hoa vàng tuyệt đẹp cho mẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"foxtail":{"definition":"Đuôi cáo.","example":"The foxtail waved in the summer wind.","exampleTranslation":"Đuôi cáo vẫy trong gió mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"frog":{"definition":"Đế guốc (chân ngựa).","example":"The horse's frog needed a careful trim.","exampleTranslation":"Đế guốc của con ngựa cần được tỉa cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"fungus":{"definition":"Cái mọc nhanh như nấm.","example":"A fungus spread fast across the damp wall.","exampleTranslation":"Một loại nấm lan nhanh khắp bức tường ẩm ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"furry":{"definition":"Bằng da lông thú; có lót da lông thú.","example":"She wore a furry hat in the cold wind.","exampleTranslation":"Cô ấy đội một chiếc mũ bằng da lông thú trong cơn gió lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"ginkgo":{"definition":"Cây lá quạt, cây bạch quả.","example":"A ginkgo dropped yellow leaves on the path.","exampleTranslation":"Một cây bạch quả đã rụng những chiếc lá màu vàng trên lối đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"gnat":{"definition":"Muỗi nhỏ, muỗi mắt.","example":"A gnat buzzed near my ear.","exampleTranslation":"Một con muỗi nhỏ vo ve gần tai tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"gorilla":{"definition":"Con khỉ đột, con gôrila.","example":"A gorilla sat quietly in the cage.","exampleTranslation":"Một con khỉ đột ngồi lặng lẽ trong lồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"grasshopper":{"definition":"Châu chấu.","example":"A grasshopper jumped across the warm path.","exampleTranslation":"Một con châu chấu nhảy băng qua con đường ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hare":{"definition":"Thỏ rừng.","example":"A hare ran across the field.","exampleTranslation":"Một con thỏ rừng chạy băng qua cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hatch":{"definition":"Sự chết.","example":"The old tale spoke of a quick hatch.","exampleTranslation":"Câu chuyện cũ kể về một sự chết nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hatchling":{"definition":"Con chim vừa mới nở.","example":"The tiny hatchling stayed near its mother.","exampleTranslation":"Con chim vừa mới nở bé nhỏ ở lại gần mẹ nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hawk":{"definition":"Kẻ tham tàn.","example":"That hawk tried to take every last coin.","exampleTranslation":"Kẻ tham tàn đó đã cố lấy từng đồng xu cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hive":{"definition":"Tổ ong, đõ ong.","example":"The bees live in a hive.","exampleTranslation":"Lũ ong sống trong một tổ ong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hoot":{"definition":"Tiếng cú kêu.","example":"An owl gave a soft hoot in the tree.","exampleTranslation":"Một con cú đã phát ra tiếng cú kêu nhẹ trên cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"horn":{"definition":"Mỏm (vịnh).","example":"We stood on the horn above the sea.","exampleTranslation":"Chúng tôi đứng trên mỏm vịnh bên trên biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"howl":{"definition":"Khóc gào (trẻ con).","example":"The baby began to howl in the night.","exampleTranslation":"Đứa bé bắt đầu khóc gào trong đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"howler":{"definition":"Người rú lên, người gào lê, người la hét; con thú tru lên, con thú hú lên.","example":"The howler scared the whole camp at night.","exampleTranslation":"Con thú hú lên đã làm cả trại hoảng sợ vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"hyena":{"definition":"Người tàn bạo.","example":"He acted like a hyena toward weaker children.","exampleTranslation":"Anh ta hành động như một người tàn bạo đối với những đứa trẻ yếu đuối hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"insect":{"definition":"Sâu bọ, côn trùng.","example":"A small insect flew into the room.","exampleTranslation":"Một con sâu bọ nhỏ bay vào phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"ivory":{"definition":"(từ lóng) phím đàn pianô","example":"She played a soft note on the ivory.","exampleTranslation":"Cô ấy đã chơi một nốt nhạc nhẹ trên phím đàn pianô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"kangaroo":{"definition":"Con canguru.","example":"The kangaroo hopped across the field.","exampleTranslation":"Con canguru nhảy qua cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"kelp":{"definition":"Tảo bẹ.","example":"Sea kelp washed onto the beach.","exampleTranslation":"Tảo bẹ đã dạt vào bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"koala":{"definition":"Gấu túi.","example":"A koala slept high in the tree.","exampleTranslation":"Một chú gấu túi ngủ trên cao trong cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"krill":{"definition":"Loài nhuyễn thể mà cá voi ăn được.","example":"Krill are an important food for many whales.","exampleTranslation":"Loài nhuyễn thể là thức ăn quan trọng đối với nhiều loài cá voi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"leaf":{"definition":"Lá cây; lá (vàng, bạc... ).","example":"The tree is covered in green leaf.","exampleTranslation":"Cái cây được bao phủ bởi lá cây xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"leafy":{"definition":"Rậm lá.","example":"They sat under a leafy tree.","exampleTranslation":"Họ ngồi dưới một cái cây rậm lá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"ling":{"definition":"Cây thạch nam.","example":"Ling grew near the rocky hillside.","exampleTranslation":"Cây thạch nam mọc gần sườn đồi đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"lion":{"definition":"Người nổi danh, người có tiếng; người tai mắt, người được nhiều nơi mời mọc.","example":"He became a lion in the music world.","exampleTranslation":"Anh ấy trở thành người nổi danh trong thế giới âm nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"lizard":{"definition":"Con thằn lằn.","example":"A small lizard ran across the warm stone.","exampleTranslation":"Một con thằn lằn nhỏ chạy ngang qua phiến đá ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"lobster":{"definition":"Tôm hùm.","example":"We saw a lobster crawling under the pier.","exampleTranslation":"Chúng tôi thấy một con tôm hùm bò dưới cầu tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"locust":{"definition":"Người ăn ngấu nghiến; người phá hoại.","example":"He ate like a locust at the buffet.","exampleTranslation":"Anh ấy ăn như một người ăn ngấu nghiến tại tiệc buffet.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"manatee":{"definition":"Lợn biển.","example":"We saw a manatee swimming slowly near the boat.","exampleTranslation":"Chúng tôi thấy một con lợn biển bơi chậm chạp gần con thuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"mastodon":{"definition":"Voi răng mấu.","example":"The museum displayed a mastodon model.","exampleTranslation":"Bảo tàng đã trưng bày một mô hình voi răng mấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"meow":{"definition":"Kêu meo meo (mèo).","example":"The kitten began to meow beside the door.","exampleTranslation":"Chú mèo con bắt đầu kêu meo meo bên cạnh cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"monkey":{"definition":"Cái vồ (để nện cọc).","example":"He lifted the monkey to move the post.","exampleTranslation":"Anh ta nâng cái vồ lên để di chuyển cọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"moth":{"definition":"Nhậy (cắn quần áo).","example":"A moth ate small holes in his shirt.","exampleTranslation":"Một con ngài ăn những lỗ nhỏ trên áo anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"mouse":{"definition":"Chuột.","example":"A small mouse ran across the kitchen floor.","exampleTranslation":"Một con chuột nhỏ chạy ngang qua sàn nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"mushroom":{"definition":"Phát triển nhanh (như nấm).","example":"The mushroom growth of the suburbs surprised the city planners.","exampleTranslation":"Sự phát triển nhanh như nấm của các vùng ngoại ô đã làm các nhà quy hoạch thành phố ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"nest":{"definition":"Tổ, ổ (chim, chuột... ).","example":"A small bird built a nest in the tree.","exampleTranslation":"Một con chim nhỏ đã xây một cái tổ trên cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"nestful":{"definition":"Lứa đẻ (trứng, chim non).","example":"The bird's nest held a nestful of eggs.","exampleTranslation":"Cái tổ của con chim chứa một lứa trứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"octopus":{"definition":"Con tuộc, con mực phủ.","example":"The octopus was important at work.","exampleTranslation":"Con mực phủ rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"otter":{"definition":"Con rái cá.","example":"An otter swam quickly across the stream.","exampleTranslation":"Con rái cá bơi nhanh qua dòng suối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"pack":{"definition":"Đàn, bầy (chó săn, chó sói... ).","example":"A pack of wolves moved through the forest.","exampleTranslation":"Một đàn chó sói di chuyển qua khu rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"parrot":{"definition":"Con vẹt ((nghĩa đen) & (nghĩa bóng)).","example":"The parrot copied every sound in the room.","exampleTranslation":"Con vẹt đã bắt chước mọi âm thanh trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"pawing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của paw.","example":"Please pawing the note for me.","exampleTranslation":"Vui lòng ghi chú lại cho tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"paws":{"definition":"Động từ chia ở ngôi thứ ba số ít của paw","example":"We can paws the result quickly.","exampleTranslation":"Chúng ta có thể dừng kết quả lại một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"penguin":{"definition":"Chim cánh cụt.","example":"The penguin slipped on the ice.","exampleTranslation":"Chú chim cánh cụt bị trượt trên băng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"perch":{"definition":"Sào để chim đậu, cành để chim đậu.","example":"A small bird took its perch on the branch.","exampleTranslation":"Một chú chim nhỏ đậu trên cành cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"peregrine":{"definition":"Ngoại lai, nhập cảng.","example":"The plant was peregrine to this region.","exampleTranslation":"Loài thực vật này vốn là ngoại lai đối với khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"pets":{"definition":"Động từ chia ở ngôi thứ ba số ít của pet","example":"The child pets the rabbit gently.","exampleTranslation":"Đứa trẻ vuốt ve chú thỏ một cách nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"pine":{"definition":"Pineapple.","example":"We sliced fresh pine into the fruit salad.","exampleTranslation":"Chúng tôi đã cắt lát quả thông tươi vào món salad trái cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"plane":{"definition":"Cây tiêu huyền ((cũng) plane-tree, platan).","example":"A large plane tree stands in our backyard.","exampleTranslation":"Một cây tiêu huyền lớn đứng trong sân sau nhà chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"prowl":{"definition":"Sự đi lảng vảng, sự đi rình mò (kiêm mồi, ăn trộm... ); sự đi vơ vẩn.","example":"The thief went on a prowl at night.","exampleTranslation":"Sự đi rình mò","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"rabbit":{"definition":"Con thỏ.","example":"A small rabbit hopped across the green grass.","exampleTranslation":"Một chú thỏ nhỏ đã nhảy qua bãi cỏ xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"ragwort":{"definition":"Cỏ lưỡi chó.","example":"The field was full of ragwort.","exampleTranslation":"Cánh đồng đầy cây cúc xôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"rare":{"definition":"Hiếm, hiếm có, ít có.","example":"We saw a rare bird in the forest.","exampleTranslation":"Chúng tôi đã thấy một con chim hiếm trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"rats":{"definition":"Động từ chia ở ngôi thứ ba số ít của rat","example":"The cat rats in the barn at night.","exampleTranslation":"Lũ chuột chạy trong nhà kho vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"rattle":{"definition":"Vòng sừng (ở đuôi của rắn chuông).","example":"A rattle hung at the snake's tail.","exampleTranslation":"Một cái chuông kêu treo ở đuôi con rắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"reef":{"definition":"Mép buồm.","example":"The sailors must take in the reef quickly.","exampleTranslation":"Các thủy thủ phải nhanh chóng thu buồm lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"reptile":{"definition":"Loài bò sát.","example":"He kept the reptile on the desk.","exampleTranslation":"Anh ấy đã để con bò sát trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"rhino":{"definition":"Tiền.","example":"The rhino charged at the hunters.","exampleTranslation":"Con tê giác đã lao về phía những người thợ săn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"roar":{"definition":"Tiếng gầm, tiếng rống.","example":"I could hear the roar of a lion.","exampleTranslation":"Tôi có thể nghe thấy tiếng gầm của một con sư tử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"roost":{"definition":"Đậu để ngủ (gà... ).","example":"The chickens roost in the tree at night.","exampleTranslation":"Những con gà đậu để ngủ trên cây vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"rosebud":{"definition":"Người con gái đẹp.","example":"She looked like a rosebud at the dance.","exampleTranslation":"Cô ấy trông như một đóa hoa hồng chưa nở tại buổi khiêu vũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"salamander":{"definition":"Con rồng lửa.","example":"The old tale described a salamander made of fire.","exampleTranslation":"Câu chuyện cũ mô tả một con rồng lửa được tạo ra từ lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"scorpion":{"definition":"Roi co mũi sắt.","example":"The guard carried a sharp scorpion for punishment.","exampleTranslation":"Người bảo vệ mang theo một cái roi mũi sắt để trừng phạt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"seaweed":{"definition":"Tảo biển.","example":"Seaweed covered the rocks after tide.","exampleTranslation":"Tảo biển bao phủ các tảng đá sau thủy triều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"sedge":{"definition":"Cây cói túi.","example":"Sedge grew thick along the wet path.","exampleTranslation":"Cây cói túi mọc dày dọc theo con đường ẩm ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"shearwater":{"definition":"Chim hải âu.","example":"The shearwater skimmed low over the waves.","exampleTranslation":"Chim hải âu bay là mặt sóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"shrimp":{"definition":"Con tôm.","example":"We saw a shrimp in the shallow water.","exampleTranslation":"Chúng tôi thấy một con tôm ở vùng nước nông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"shrub":{"definition":"Cây bụi.","example":"A shrub grew beside the fence.","exampleTranslation":"Một cây bụi mọc bên cạnh hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"shrubby":{"definition":"Dạng cây bụi.","example":"The old house had a shrubby border.","exampleTranslation":"Ngôi nhà cũ có một đường viền dạng cây bụi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"sloth":{"definition":"Sự chậm chạp, sự chậm trễ.","example":"The sloth of the line made us late.","exampleTranslation":"Sự chậm chạp của dòng người đã làm chúng tôi đến muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"slug":{"definition":"Con ốc sên.","example":"A slug crawled across the wet stone.","exampleTranslation":"Một con ốc sên bò ngang qua tảng đá ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"snake":{"definition":", (thông tục) kéo mạnh, giật.","example":"He snake the rope out of my hands.","exampleTranslation":"Anh ấy giật mạnh sợi dây ra khỏi tay tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biodiversity"},"sparrow":{"definition":"Chim sẻ.","example":"A sparrow landed on the fence.","exampleTranslation":"Một con chim sẻ đậu trên hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"spider":{"definition":"Con nhện.","example":"A spider waited quietly in the corner.","exampleTranslation":"Một con nhện đợi lặng lẽ trong góc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"stray":{"definition":"Rải rác, lác đác, tản mạn.","example":"I noticed a few stray hairs on my coat.","exampleTranslation":"Tôi chú ý thấy một vài sợi tóc tản mạn trên áo khoác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biodiversity"},"swift":{"definition":"Thằn lằn.","example":"We saw a swift near the stone wall.","exampleTranslation":"Chúng tôi thấy một con thằn lằn gần bức tường đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"tail":{"definition":"Đoàn tuỳ tùng.","example":"The leader moved with a large tail behind him.","exampleTranslation":"Người lãnh đạo di chuyển với một đoàn tuỳ tùng lớn phía sau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"termite":{"definition":"Con mối.","example":"A termite damaged the wooden table.","exampleTranslation":"Con mối đã làm hỏng cái bàn gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"tern":{"definition":"Nhạn biển ((như) tarn).","example":"A tern flew over the waves.","exampleTranslation":"Một con nhạn biển bay qua những con sóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"tiger":{"definition":"Người hay nạt nộ, kẻ hùng hổ.","example":"Our teacher can be a tiger at times.","exampleTranslation":"Giáo viên của chúng tôi đôi khi có thể là một người hay nạt nộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"toad":{"definition":"Con cóc.","example":"A toad sat near the pond.","exampleTranslation":"Một con cóc ngồi gần cái ao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"turtle":{"definition":"Turtle-dove.","example":"A turtle called softly near the pond.","exampleTranslation":"Một con chim cu gáy kêu khẽ gần cái ao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"tusk":{"definition":"Ngà (voi); răng ranh (lợi lòi).","example":"The elephant's tusk shone in the sun.","exampleTranslation":"Chiếc ngà của con voi tỏa sáng dưới ánh mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"vole":{"definition":"Chuột đồng, chuột microtut.","example":"The vole was useful in class.","exampleTranslation":"Chuột đồng rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"whale":{"definition":"A whale of cái to lớn mênh mông; việc lạ lùng kỳ dị.","example":"They visited a whale of a city last year.","exampleTranslation":"Họ đã ghé thăm một thành phố rộng lớn mênh mông vào năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"wolf":{"definition":", (từ lóng) người hay chim gái.","example":"He acted like a wolf in the crowd.","exampleTranslation":"Anh ta hành động như một gã săn gái giữa đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biodiversity"},"water":{"definition":"Nước.","example":"The water is cold this time of year.","exampleTranslation":"Nước rất lạnh vào thời điểm này trong năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"watered":{"definition":"Có nhiều sông hồ (miền).","example":"They crossed a watered valley with many lakes.","exampleTranslation":"Họ băng qua một thung lũng được tưới tiêu với nhiều hồ nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"water"},"watering":{"definition":"Sự tưới, sự tưới nước.","example":"The garden needs watering every evening in summer.","exampleTranslation":"Khu vườn cần được tưới nước mỗi buổi tối vào mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"waterless":{"definition":"Không có nước; khô, cạn, khô cạn, hạn.","example":"The waterless land looked dry and empty.","exampleTranslation":"Vùng đất không có nước trông khô cằn và trống trải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"water"},"watery":{"definition":"Ướt, đẫm nước, sũng nước.","example":"Her eyes became watery while watching the sad movie.","exampleTranslation":"Mắt cô ấy trở nên rưng rưng khi xem bộ phim buồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"water"},"contaminated":{"definition":"Quá khứ và phân từ quá khứ của contaminate","example":"The spill contaminated the fresh water supply.","exampleTranslation":"Sự cố tràn đã làm ô nhiễm nguồn nước sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"contaminat"},"clean":{"definition":"Sạch, sạch sẽ.","example":"He is a very clean and tidy boy.","exampleTranslation":"Cậu bé rất sạch sẽ và gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"clean"},"cleaned":{"definition":"Quá khứ và phân từ quá khứ của clean","example":"She cleaned the floor before guests arrived.","exampleTranslation":"Cô ấy đã lau sàn nhà trước khi khách đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"clean"},"cleaner":{"definition":"Máy quét, máy hút bụi; máy tẩy (quần áo).","example":"The cleaner picked up dust from the floor.","exampleTranslation":"Người dọn dẹp đã quét sạch bụi trên sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"clean"},"cleaning":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của clean.","example":"I was cleaning the table when you called.","exampleTranslation":"Tôi đang lau bàn khi bạn gọi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"clean"},"cleanness":{"definition":"Sự sạch sẽ.","example":"The cleanness of the kitchen impressed the guests.","exampleTranslation":"Sự sạch sẽ của nhà bếp đã gây ấn tượng với các vị khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"clean"},"hygiene":{"definition":"Vệ sinh.","example":"Good hygiene keeps the kitchen clean.","exampleTranslation":"Vệ sinh tốt giúp nhà bếp luôn sạch sẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"hygiene"},"shortage":{"definition":"Sự thiếu; số lượng thiếu.","example":"The farm faces a serious shortage of water.","exampleTranslation":"Trang trại đang đối mặt với tình trạng thiếu nước nghiêm trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"shortage"},"drainage":{"definition":"Sự rút nước, sự tháo nước, sự tiêu nước.","example":"Good drainage kept the yard dry after rain.","exampleTranslation":"Hệ thống thoát nước tốt giữ cho sân khô ráo sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"drainage"},"river":{"definition":"Dòng sông.","example":"We can sail up the river by boat.","exampleTranslation":"Chúng ta có thể đi ngược dòng sông bằng thuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"river"},"freshwater":{"definition":"Nước ngọt; ở nước ngọt.","example":"Many freshwater fish live in these calm lakes.","exampleTranslation":"Nhiều loài cá nước ngọt sống trong những hồ nước êm đềm này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"freshwater"},"drinking":{"definition":"Sự uống rượu.","example":"His drinking is becoming a real problem.","exampleTranslation":"Việc uống rượu của anh ấy đang trở thành một vấn đề thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"drinking"},"bleach":{"definition":"Tẩy trắng, chuội (vải).","example":"She used a bright cleaner to bleach the cloth.","exampleTranslation":"Cô ấy đã dùng một chất tẩy trắng sáng để chuội vải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"water"},"discard":{"definition":"Sự chui bài, sự dập bài.","example":"He made a quick discard and won the hand.","exampleTranslation":"Anh ấy đã thực hiện một cú dập bài nhanh và thắng ván đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"discharge":{"definition":"Sự tẩy màu; thuốc tẩy màu, dung dịch tẩy màu.","example":"The print shop used a discharge to fade color.","exampleTranslation":"Cửa hàng in đã sử dụng một dung dịch tẩy màu để làm phai màu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"disposable":{"definition":"Có thể chuyển nhượng.","example":"The disposable ticket can be given to a friend.","exampleTranslation":"Tấm vé có thể chuyển nhượng này có thể đưa cho một người bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"water"},"disposal":{"definition":"Sự sắp đặt, sự sắp xếp, sự bố trí, cách sắp xếp, cách bố trí.","example":"The chairs are in good disposal near the wall.","exampleTranslation":"Những chiếc ghế được bố trí tốt gần bức tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"dispose":{"definition":"Làm cho có ý định, làm cho có khuynh hướng, làm cho có tâm trạng, làm cho có ý muốn.","example":"A calm voice can dispose her to listen.","exampleTranslation":"Một giọng nói bình tĩnh có thể làm cho cô ấy có tâm trạng muốn lắng nghe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"water"},"drain":{"definition":"Ống dẫn (nước... ), cống, rãnh, mương, máng.","example":"Water flowed into the drain after the rain.","exampleTranslation":"Nước chảy vào cống sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"drip":{"definition":"Sự chảy nhỏ giọt, sự để nhỏ giọt.","example":"The tap had a slow drip all night.","exampleTranslation":"Vòi nước bị chảy nhỏ giọt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"flow":{"definition":"Nước triều lên.","example":"We watched the ebb and flow of the sea.","exampleTranslation":"Chúng tôi đã xem nước triều lên và xuống của biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"flush":{"definition":"Bằng phẳng, ngang bằng.","example":"The door is flush with the wall now.","exampleTranslation":"Cánh cửa đã bằng phẳng với bức tường bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"water"},"garbage":{"definition":"Lòng, ruột (thú... ).","example":"The vet checked the animal's garbage carefully.","exampleTranslation":"Bác sĩ thú y đã kiểm tra kỹ lưỡng phần lòng của con vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"leak":{"definition":"Lỗ thủng, lỗ rò, khe hở.","example":"A small leak in the pipe wasted much water.","exampleTranslation":"Một lỗ thủng nhỏ trên ống nước đã làm lãng phí nhiều nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"outflow":{"definition":"Sự chảy mạnh ra (của nước); sự đi ra, sự thoát ra, sự chảy ra.","example":"Water outflow from the pipe was strong.","exampleTranslation":"Sự chảy mạnh ra của nước từ đường ống rất mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"pump":{"definition":"Cái bơm, máy bơm.","example":"We need a new hydraulic pump for the farm.","exampleTranslation":"Chúng ta cần một máy bơm thủy lực mới cho trang trại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"purify":{"definition":"Làm sạch, lọc trong, tinh chế.","example":"We purify water before drinking it.","exampleTranslation":"Chúng tôi lọc sạch nước trước khi uống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"water"},"recycle":{"definition":"Tái sinh (vật liệu đã dùng để dùng lại).","example":"We recycle paper to save resources.","exampleTranslation":"Chúng tôi tái chế giấy để tiết kiệm tài nguyên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"water"},"refuse":{"definition":"Đá thải, bãi thải đá.","example":"The mine left a hill of refuse behind it.","exampleTranslation":"Mỏ để lại một ngọn đồi rác thải phía sau nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"reuse":{"definition":"Dùng lại.","example":"We reuse bottles to reduce waste.","exampleTranslation":"Chúng tôi dùng lại các chai lọ để giảm thiểu rác thải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"water"},"slop":{"definition":"Bùn loãng; bùn tuyết.","example":"The road turned to slop after the rain.","exampleTranslation":"Con đường biến thành bùn lầy sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"stream":{"definition":"Dòng, luồng.","example":"A steady stream of people entered the mall.","exampleTranslation":"Một luồng người ổn định tiến vào trung tâm thương mại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"surf":{"definition":"Sóng nhào.","example":"The surf crashed against the rocks.","exampleTranslation":"Sóng nhào đập mạnh vào các tảng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"surge":{"definition":"Sóng, sóng cồn.","example":"A surge of water rushed over the rocks.","exampleTranslation":"Một dòng sóng cồn đã lao qua các tảng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"wash":{"definition":"Sự tắm rửa, sự tắm gội, sự rửa ráy.","example":"I need to have a wash before we go out.","exampleTranslation":"Tôi cần phải tắm rửa trước khi chúng ta đi ra ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"waster":{"definition":"Người lãng phí, người hoang phí.","example":"Don't be a waster and throw away your chance.","exampleTranslation":"Đừng là một người lãng phí và vứt bỏ cơ hội của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"water"},"cognition":{"definition":"Quá trình nhận thức, bao gồm việc tiếp nhận, xử lý và sử dụng thông tin.","example":"Researchers examined how cognition changes when people solve problems under prolonged stress.","exampleTranslation":"Các nhà nghiên cứu khảo sát sự thay đổi của quá trình nhận thức khi con người giải quyết vấn đề trong tình trạng căng thẳng kéo dài.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"cognitive":{"definition":"Thuộc về hoặc liên quan đến quá trình nhận thức và tư duy.","example":"Cognitive flexibility helps students adapt their strategies when unfamiliar evidence challenges their initial assumptions.","exampleTranslation":"Tính linh hoạt trong nhận thức giúp học sinh điều chỉnh chiến lược khi bằng chứng xa lạ thách thức những giả định ban đầu của họ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"conscious":{"definition":"Đang tỉnh táo và nhận biết được bản thân hoặc những gì đang diễn ra xung quanh.","example":"Participants remained conscious of the observer's presence, which may have influenced their reported decisions.","exampleTranslation":"Những người tham gia vẫn nhận biết sự hiện diện của người quan sát, điều này có thể đã ảnh hưởng đến các quyết định họ báo cáo.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"consciously":{"definition":"Một cách có ý thức hoặc có chủ ý.","example":"The volunteers consciously avoided checking their phones during the attention experiment.","exampleTranslation":"Các tình nguyện viên có ý thức tránh kiểm tra điện thoại trong suốt thí nghiệm về sự chú ý.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"psychology"},"consciousness":{"definition":"Trạng thái có ý thức, nhận biết được bản thân và môi trường xung quanh.","example":"Sleep deprivation can reduce consciousness of surrounding sounds and impair rapid responses.","exampleTranslation":"Thiếu ngủ có thể làm giảm nhận thức về những âm thanh xung quanh và cản trở các phản ứng nhanh.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"emotion":{"definition":"Cảm giác hoặc trạng thái tâm lý mạnh mẽ như vui mừng, sợ hãi hay tức giận.","example":"Researchers measured each participant's emotion after viewing images associated with fear or happiness.","exampleTranslation":"Các nhà nghiên cứu đo lường cảm xúc của từng người tham gia sau khi họ xem những hình ảnh gắn với nỗi sợ hãi hoặc hạnh phúc.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"emotional":{"definition":"Liên quan đến cảm xúc hoặc bị cảm xúc chi phối.","example":"Emotional responses may shape memory, especially when events are surprising or personally significant.","exampleTranslation":"Các phản ứng cảm xúc có thể định hình trí nhớ, đặc biệt khi các sự kiện gây bất ngờ hoặc có ý nghĩa cá nhân.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"instinct":{"definition":"Bản năng hoặc xu hướng tự nhiên khiến con người hay động vật hành động theo một cách nhất định.","example":"Some animals rely on instinct to locate food when learned signals are unavailable.","exampleTranslation":"Một số loài động vật dựa vào bản năng để tìm thức ăn khi không có các tín hiệu đã học.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"instinctive":{"definition":"Thuộc về bản năng hoặc xảy ra tự nhiên mà không cần suy nghĩ hay học hỏi có ý thức.","example":"Some infant behaviors appear instinctive, emerging before children receive extensive social instruction.","exampleTranslation":"Một số hành vi của trẻ sơ sinh có vẻ mang tính bản năng, xuất hiện trước khi trẻ nhận được sự hướng dẫn xã hội đáng kể.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"motivation":{"definition":"Động lực hoặc lý do thúc đẩy một người hành động và duy trì nỗ lực.","example":"Researchers found that intrinsic motivation improved students’ persistence when difficult tasks offered no immediate reward.","exampleTranslation":"Các nhà nghiên cứu nhận thấy động lực nội tại cải thiện sự kiên trì của học sinh khi những nhiệm vụ khó không đem lại phần thưởng ngay lập tức.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"perception":{"definition":"Cách một người nhận thức, diễn giải hoặc cảm nhận một sự vật, sự việc hay thông tin.","example":"Cultural background can influence perception, causing identical facial expressions to be interpreted differently.","exampleTranslation":"Nền tảng văn hóa có thể ảnh hưởng đến nhận thức, khiến những biểu cảm khuôn mặt giống hệt nhau được diễn giải khác nhau.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"perceptible":{"definition":"Có thể được nhận thấy hoặc cảm nhận bằng giác quan hay qua quan sát.","example":"After several weeks of training, a perceptible improvement appeared in participants’ ability to identify emotional cues.","exampleTranslation":"Sau vài tuần luyện tập, sự cải thiện rõ rệt đã xuất hiện trong khả năng nhận diện các dấu hiệu cảm xúc của người tham gia.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"perceptive":{"definition":"Tinh ý và có khả năng nhận ra hoặc hiểu những điều khó nhận thấy.","example":"Perceptive observers often detect subtle changes in tone that reveal unspoken emotional responses.","exampleTranslation":"Những người quan sát tinh ý thường phát hiện những thay đổi nhỏ trong giọng điệu, qua đó bộc lộ các phản ứng cảm xúc không được nói ra.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"personality":{"definition":"Tập hợp những đặc điểm tâm lý và cách ứng xử tạo nên tính cách riêng của một người.","example":"The study linked openness, a personality trait, with greater willingness to consider unfamiliar perspectives.","exampleTranslation":"Nghiên cứu liên hệ sự cởi mở, một đặc điểm tính cách, với sự sẵn lòng cao hơn trong việc cân nhắc những quan điểm xa lạ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"stress":{"definition":"Trạng thái căng thẳng về tinh thần hoặc thể chất do áp lực hay yêu cầu quá lớn.","example":"Chronic stress can impair memory and reduce the quality of decisions made under pressure.","exampleTranslation":"Căng thẳng kéo dài có thể làm suy giảm trí nhớ và giảm chất lượng của những quyết định được đưa ra dưới áp lực.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"stressful":{"definition":"Gây ra hoặc chứa đựng nhiều căng thẳng về tinh thần hay thể chất.","example":"Researchers observed that stressful working conditions increased fatigue and reduced employees’ concentration over time.","exampleTranslation":"Các nhà nghiên cứu quan sát thấy rằng điều kiện làm việc căng thẳng làm gia tăng sự mệt mỏi và dần làm giảm khả năng tập trung của nhân viên.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"trauma":{"definition":"Chấn thương tâm lý do một trải nghiệm gây đau khổ hoặc tổn hại nghiêm trọng về cảm xúc.","example":"Early trauma can alter emotional regulation and influence behaviour throughout adulthood.","exampleTranslation":"Chấn thương tâm lý thời thơ ấu có thể làm thay đổi khả năng điều chỉnh cảm xúc và ảnh hưởng đến hành vi trong suốt tuổi trưởng thành.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"aggression":{"definition":"Hành vi hoặc xu hướng công kích, gây hấn hay sử dụng bạo lực đối với người khác.","example":"Researchers linked sleep deprivation with increased aggression in adolescents.","exampleTranslation":"Các nhà nghiên cứu liên hệ tình trạng thiếu ngủ với sự gia tăng hành vi gây hấn ở thanh thiếu niên.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"attitude":{"definition":"Cách một người suy nghĩ, cảm nhận hoặc phản ứng đối với một người, sự việc hay vấn đề.","example":"A positive attitude towards learning often improves persistence after initial failure.","exampleTranslation":"Thái độ tích cực đối với việc học thường cải thiện sự kiên trì sau thất bại ban đầu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"addict":{"definition":"Người bị lệ thuộc vào một chất hoặc hoạt động đến mức khó kiểm soát việc sử dụng hoặc thực hiện nó.","example":"The study found that each addict faced different social pressures during recovery.","exampleTranslation":"Nghiên cứu phát hiện rằng mỗi người nghiện phải đối mặt với những áp lực xã hội khác nhau trong quá trình hồi phục.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"addiction":{"definition":"Tình trạng lệ thuộc về thể chất hoặc tâm lý vào một chất hay hoạt động, khó kiểm soát dù gây hậu quả tiêu cực.","example":"Digital addiction may disrupt sleep, concentration, and face-to-face social interaction.","exampleTranslation":"Nghiện kỹ thuật số có thể làm gián đoạn giấc ngủ, sự tập trung và tương tác xã hội trực tiếp.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"subconscious":{"definition":"Thuộc về phần tâm trí hoạt động mà con người không nhận biết hoàn toàn.","example":"A subconscious fear influenced some participants' choices.","exampleTranslation":"Một nỗi sợ trong tiềm thức đã ảnh hưởng đến lựa chọn của một số người tham gia.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"attachment":{"definition":"Mối gắn bó tình cảm giữa một người với người khác hoặc với một đối tượng.","example":"Secure attachment in early childhood can support later emotional development.","exampleTranslation":"Sự gắn bó an toàn trong những năm đầu đời có thể hỗ trợ sự phát triển cảm xúc về sau.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"admiration":{"definition":"Sự khâm phục, sự thán phục, sự cảm phục, sự hâm mộ, sự ngưỡng mộ; sự ca tụng.","example":"The child looked at the pianist with admiration.","exampleTranslation":"Đứa trẻ nhìn nghệ sĩ piano với sự ngưỡng mộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"admire":{"definition":"Khâm phục, ((thông tục)) thán phục, cảm phục; hâm mộ, ngưỡng mộ; khen ngợi, ca tụng.","example":"I truly admire her dedication to the cause.","exampleTranslation":"Tôi thực sự ngưỡng mộ sự tận tâm của cô ấy đối với lý tưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"admirer":{"definition":"Người say mê (một người đàn bà).","example":"She had a secret admirer.","exampleTranslation":"Cô ấy có một người hâm mộ thầm lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"adversity":{"definition":"Sự bất hạnh; vận đen, vận rủi; cảnh nghịch, vận nghịch.","example":"He kept the adversity on the desk.","exampleTranslation":"Anh ấy giữ sự bất hạnh đó ở trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"affect":{"definition":"Làm ảnh hưởng đến, làm tác động đến; chạm đến.","example":"Frequent changes in weather affect my health quite often.","exampleTranslation":"Những thay đổi thường xuyên về thời tiết ảnh hưởng đến sức khỏe của tôi khá thường xuyên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"affection":{"definition":"Tình cảm, cảm xúc.","example":"Her affection for animals was easy to see.","exampleTranslation":"Tình cảm của cô ấy dành cho động vật rất dễ nhận thấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"afraid":{"definition":"Sợ, hãi, hoảng, hoảng sợ.","example":"We are not afraid of facing any difficult challenges.","exampleTranslation":"Chúng tôi không sợ phải đối mặt với bất kỳ thách thức khó khăn nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"aggressive":{"definition":"Xâm lược, xâm lăng.","example":"She used an aggressive tone during the debate.","exampleTranslation":"Cô ấy sử dụng giọng điệu xâm lược trong cuộc tranh luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"aggressively":{"definition":"Xông xáo, tháo vát.","example":"I read the note aggressively.","exampleTranslation":"Tôi đọc ghi chú một cách xông xáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"angry":{"definition":"Giận, tức giận, cáu.","example":"Do not get angry with your little brother.","exampleTranslation":"Đừng giận dữ với em trai của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"appreciate":{"definition":"Biết thưởng thức, biết đánh giá.","example":"She can appreciate good music and quiet time.","exampleTranslation":"Cô ấy biết thưởng thức âm nhạc hay và thời gian yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"arouse":{"definition":"Khuấy động, gợi.","example":"The news did not arouse any public interest.","exampleTranslation":"Tin tức không khuấy động bất kỳ sự quan tâm công cộng nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"aspiration":{"definition":"Nguyện vọng, khát vọng.","example":"His main aspiration is to help children learn.","exampleTranslation":"Nguyện vọng chính của anh ấy là giúp trẻ em học hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"aspire":{"definition":"Thiết tha, mong mỏi, khao khát.","example":"Many students aspire to learn English well.","exampleTranslation":"Nhiều học sinh thiết tha học tiếng Anh tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"astonish":{"definition":"Làm ngạc nhiên.","example":"The sudden rain will astonish the children.","exampleTranslation":"Cơn mưa bất ngờ sẽ làm ngạc nhiên những đứa trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"astonishingly":{"definition":"Đáng kinh ngạc.","example":"She spoke astonishingly during the meeting.","exampleTranslation":"Cô ấy nói một cách đáng kinh ngạc trong buổi họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"astounding":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của astound.","example":"The news is astounding the whole room.","exampleTranslation":"Tin tức làm ngạc nhiên cả căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"aware":{"definition":"Biết, nhận thấy, nhận thức thấy.","example":"Please be aware of the danger ahead.","exampleTranslation":"Xin hãy nhận thức thấy sự nguy hiểm phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"awareness":{"definition":"Nhận thức.","example":"Awareness of safety helps prevent many accidents.","exampleTranslation":"Nhận thức về an toàn giúp ngăn ngừa nhiều tai nạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"behave":{"definition":"Ăn ở, đối xử, cư xử.","example":"You should behave kindly towards your new neighbors.","exampleTranslation":"Bạn nên đối xử tử tế với những người hàng xóm mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"behavior":{"definition":"Cách xử lý, chế độ; hành vi, trạng thái.","example":"Good behavior matters in class.","exampleTranslation":"Hành vi tốt rất quan trọng trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"behaviour":{"definition":"Cách chạy (máy móc); tác động (chất...).","example":"The machine's behaviour changed after the repair.","exampleTranslation":"Cách chạy của cỗ máy đã thay đổi sau khi sửa chữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"behavioural":{"definition":"Thuộc về cách cư xử.","example":"She studied behavioural changes after lunch.","exampleTranslation":"Cô ấy đã nghiên cứu những thay đổi thuộc về cách cư xử sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"bored":{"definition":"Nhàm chán, chán nản, chán, buồn chán, buồn tẻ, nhạt nhẽo.","example":"The long wait made him bored.","exampleTranslation":"Sự chờ đợi lâu khiến anh ấy cảm thấy nhàm chán.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"bother":{"definition":"Làm buồn bực, làm phiền, quấy rầy.","example":"Please do not bother me while I work.","exampleTranslation":"Xin vui lòng đừng làm phiền tôi khi tôi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"brainy":{"definition":"Thông minh; có đầu óc.","example":"She is brainy and solves puzzles quickly.","exampleTranslation":"Cô ấy rất thông minh và giải đố nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"cheerful":{"definition":"Vui mắt; vui vẻ.","example":"The bright colors make for a cheerful room.","exampleTranslation":"Những màu sắc tươi sáng tạo nên một căn phòng thật vui mắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"cheerfully":{"definition":"Vui vẻ, phấn khởi.","example":"She spoke cheerfully during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện một cách vui vẻ trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"comfort":{"definition":"Sự an ủi, sự khuyên giải; người an ủi, người khuyên giải; nguồn an ủi, lời an ủi.","example":"She offered a few words of comfort to her friend.","exampleTranslation":"Cô ấy đã dành vài lời an ủi cho bạn mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"compassion":{"definition":"Tình thương, sự thương yêu, lòng trắc ẩn.","example":"We must have compassion on those who are hungry.","exampleTranslation":"Chúng ta phải có lòng trắc ẩn đối với những người đang đói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"comprehend":{"definition":"Hiểu, lĩnh hội, nhận thức thấu đáo.","example":"I can comprehend the lesson after reading twice.","exampleTranslation":"Tôi có thể hiểu bài học sau khi đọc hai lần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"conceivable":{"definition":"Có thể hiểu được, có thể nhận thức được; có thể tưởng tượng được.","example":"It is conceivable that the train will be late.","exampleTranslation":"Có thể tưởng tượng được rằng chuyến tàu sẽ trễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"conceive":{"definition":"Nghĩ, hiểu, quan điểm được, nhận thức; tưởng tượng.","example":"It is hard to conceive such a huge plan.","exampleTranslation":"Thật khó để tưởng tượng một kế hoạch khổng lồ như vậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"concentrate":{"definition":"Tập trung.","example":"You should concentrate on your homework right now.","exampleTranslation":"Bạn nên tập trung vào bài tập về nhà ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"concentration":{"definition":"Sự tập trung; nơi tập trung.","example":"He has a great power of concentration during study.","exampleTranslation":"Anh ấy có sức mạnh tập trung tuyệt vời trong khi học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"confidence":{"definition":"Sự nói riêng; sự giãi bày tâm sự.","example":"I told him my secret in confidence yesterday.","exampleTranslation":"Tôi đã kể cho anh ấy nghe bí mật của mình trong sự tin tưởng ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"confident":{"definition":"Tin chắc, chắc chắn.","example":"I am confident of success in my new job.","exampleTranslation":"Tôi tin chắc về sự thành công trong công việc mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"confidently":{"definition":"Tự tin.","example":"He moved confidently through the crowd.","exampleTranslation":"Anh ấy tự tin di chuyển qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"confuse":{"definition":"Lẫn lộn, nhầm lẫn.","example":"Please do not confuse the dates of birth.","exampleTranslation":"Vui lòng không lẫn lộn ngày tháng năm sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"confusing":{"definition":"Khó hiểu, gây bối rối.","example":"The instructions were confusing to many students.","exampleTranslation":"Những chỉ dẫn gây khó hiểu cho nhiều học sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"confusion":{"definition":"Sự lộn xộn, sự hỗn độn, sự rối loạn, sự hỗn loạn.","example":"The sudden confusion caused a lot of problems.","exampleTranslation":"Sự lộn xộn đột ngột đã gây ra nhiều vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"conscience":{"definition":"Lương tâm.","example":"He has a clear conscience about his past actions.","exampleTranslation":"Anh ấy có một lương tâm trong sáng về các hành động trong quá khứ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"considerate":{"definition":"Ân cần, chu đáo, hay quan tâm tới người khác.","example":"It is very considerate of you to help them.","exampleTranslation":"Bạn thật ân cần khi giúp đỡ họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"convince":{"definition":"Làm cho tin, làm cho nghe theo, thuyết phục.","example":"I need to convince her to join us.","exampleTranslation":"Tôi cần thuyết phục cô ấy tham gia cùng chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"courage":{"definition":"Sự can đảm, sự dũng cảm, dũng khí.","example":"You must keep up your courage now.","exampleTranslation":"Bây giờ bạn phải giữ vững lòng can đảm của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"courageous":{"definition":"Can đảm, dũng cảm.","example":"She was courageous during the storm.","exampleTranslation":"Cô ấy đã rất dũng cảm trong suốt cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"crave":{"definition":"Nài xin, khẩn cầu.","example":"They began to crave pardon for their mistakes.","exampleTranslation":"Họ bắt đầu khẩn cầu sự tha thứ cho những lỗi lầm của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"craving":{"definition":"Sự thèm muốn, lòng khao khát.","example":"He had a craving for fresh fruit.","exampleTranslation":"Anh ấy có lòng khao khát trái cây tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"crazy":{"definition":"Xộc xệch, khập khiễng, ọp ẹp (nhà cửa, đồ đạc, tàu bè... ).","example":"The old chair looks crazy but still works.","exampleTranslation":"Chiếc ghế cũ trông có vẻ ọp ẹp nhưng vẫn dùng tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"cries":{"definition":"Động từ chia ở ngôi thứ ba số ít của cry","example":"The baby cries at night.","exampleTranslation":"Đứa bé khóc vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"cruel":{"definition":"Độc ác, dữ tợn, hung ác, ác nghiệt, tàn ác, tàn bạo, tàn nhẫn.","example":"It was a cruel fate for the poor family.","exampleTranslation":"Đó là một số phận tàn nhẫn cho gia đình đáng thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"cruelty":{"definition":"Sự hung ác, sự tàn ác, sự tàn bạo, sự tàn nhẫn, tính độc ác, tính ác nghiệt.","example":"She saw the cruelty yesterday.","exampleTranslation":"Cô ấy đã chứng kiến sự tàn nhẫn ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"cunning":{"definition":"quyến rũ.","example":"She gave him a cunning smile before leaving.","exampleTranslation":"Cô ấy nở một nụ cười quyến rũ trước khi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"curious":{"definition":"Ham biết, muốn tìm biết.","example":"I am curious to know what he said.","exampleTranslation":"Tôi rất ham biết muốn biết anh ấy đã nói gì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"curiously":{"definition":"Tò mò, hiếu kỳ.","example":"She answered curiously and smiled.","exampleTranslation":"Cô ấy trả lời một cách tò mò và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"dare":{"definition":"Sự dám làm.","example":"It takes dare to start a new life.","exampleTranslation":"Cần phải có sự dám làm để bắt đầu một cuộc sống mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"deceive":{"definition":"Lừa dối, đánh lừa, lừa đảo, lừa gạt.","example":"Do not try to deceive your own feelings.","exampleTranslation":"Đừng cố gắng lừa dối chính cảm xúc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"deceiver":{"definition":"Kẻ lừa dối, kẻ lừa gạt.","example":"The deceiver promised help but lied.","exampleTranslation":"Kẻ lừa dối đã hứa giúp đỡ nhưng lại nói dối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"deception":{"definition":"Trò lừa dối, mưu mẹo gian dối, mánh khoé lừa bịp.","example":"He used deception to win the game easily.","exampleTranslation":"Anh ấy sử dụng trò lừa dối để thắng trò chơi một cách dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"decide":{"definition":"Quyết định.","example":"I need to decide to study harder tonight.","exampleTranslation":"Tôi cần quyết định học chăm chỉ hơn tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"decision":{"definition":"Sự quyết định, quyết nghị.","example":"We need to reach a final decision soon.","exampleTranslation":"Chúng ta cần sớm đạt được sự quyết định cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"decisive":{"definition":"Quyết định.","example":"She took decisive action to solve the issue.","exampleTranslation":"Cô ấy đã có hành động quyết định để giải quyết vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"delight":{"definition":"Sự vui thích, sự vui sướng.","example":"The beautiful garden gives great delight to us.","exampleTranslation":"Khu vườn xinh đẹp mang lại sự vui thích tuyệt vời cho chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"denial":{"definition":"Sự từ chối, sự khước từ; sự phủ nhận.","example":"She spoke with a clear denial of the rumors.","exampleTranslation":"Cô ấy đã nói với sự phủ nhận rõ ràng về các tin đồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"deny":{"definition":"Từ chối, phản đối, phủ nhận.","example":"You must deny him access to your private room.","exampleTranslation":"Bạn phải từ chối anh ấy quyền truy cập vào phòng riêng của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"depressingly":{"definition":"Đáng ngại, đáng buồn.","example":"She spoke depressingly during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện một cách đáng ngại trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"depression":{"definition":"Chỗ lõm, chỗ đất lún, chỗ sụt xuống.","example":"A small depression in the road caught the water.","exampleTranslation":"Một chỗ lõm nhỏ trên đường đọng nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"desire":{"definition":"Dục vọng.","example":"He struggled with a dark and hidden desire.","exampleTranslation":"Anh ấy đã đấu tranh với một dục vọng đen tối và ẩn giấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"despair":{"definition":"Sự thất vọng; nỗi thất vọng, nỗi tuyệt vọng.","example":"He felt deep despair after losing his job.","exampleTranslation":"Anh ấy cảm thấy sự tuyệt vọng sâu sắc sau khi mất việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"desperate":{"definition":"Liều mạng, liều lĩnh.","example":"The thief made a desperate act to escape prison.","exampleTranslation":"Tên trộm đã thực hiện một hành động liều lĩnh để trốn thoát khỏi nhà tù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"devote":{"definition":"Hiến dâng, dành hết cho.","example":"She decided to devote her life to helping others.","exampleTranslation":"Cô ấy quyết định dành hết cuộc đời để giúp đỡ người khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"devotion":{"definition":"Lòng mộ đạo, lòng sùng đạo; sự sùng bái.","example":"Her devotion filled the quiet room each morning.","exampleTranslation":"Lòng mộ đạo của cô ấy làm đầy căn phòng yên tĩnh mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"dilemma":{"definition":"Song đề.","example":"He faced a difficult dilemma at work.","exampleTranslation":"Anh ấy đối mặt với một tình thế tiến thoái lưỡng nan khó khăn trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"disappointing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của disappoint.","example":"He was disappointing his team with late work.","exampleTranslation":"Anh ấy đang làm thất vọng cả đội của mình vì làm việc trễ nải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"disbelief":{"definition":"Sự không tin.","example":"She stared in disbelief at the broken window.","exampleTranslation":"Cô ấy nhìn chằm chằm vào chiếc cửa sổ vỡ trong sự không tin nổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"discourage":{"definition":"Làm mất hết can đảm, làm chán nản, làm ngã lòng, làm nản lòng.","example":"Long delays discourage new students from continuing.","exampleTranslation":"Sự chậm trễ kéo dài làm nản lòng những học sinh mới muốn tiếp tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"disposition":{"definition":"Sự sắp xếp, sự sắp đặt, cách sắp xếp, cách bố trí.","example":"The books are in neat disposition on the shelf.","exampleTranslation":"Những cuốn sách được sắp đặt gọn gàng trên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"distaste":{"definition":"Sự không thích, sự không ưa; sự ghê tởm, sự chán ghét.","example":"He has a strong distaste for spicy food.","exampleTranslation":"Anh ấy có sự chán ghét mạnh mẽ đối với thức ăn cay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"distract":{"definition":"làm sao lãng, làm lãng đi, làm lãng trí.","example":"Music can distract you from your worries.","exampleTranslation":"Âm nhạc có thể làm bạn sao lãng khỏi những lo âu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"distraction":{"definition":"Sự điên cuồng, sự mất trí, sự quẫn trí.","example":"She loved him to distraction during the summer.","exampleTranslation":"Cô ấy yêu anh ấy đến mức quẫn trí trong suốt mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"distress":{"definition":"Nỗi đau buồn, nỗi đau khổ, nỗi đau đớn.","example":"She felt great distress after the bad news.","exampleTranslation":"Cô ấy cảm thấy nỗi đau khổ lớn sau tin tức xấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"doubt":{"definition":"Sự nghi ngờ, sự ngờ vực; sự không chắc, sự hồ nghi.","example":"His strange behavior caused a lot of doubt.","exampleTranslation":"Hành vi kỳ lạ của anh ấy gây ra rất nhiều sự nghi ngờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"doubtful":{"definition":"Nghi ngờ, ngờ vực, hồ nghi.","example":"It is doubtful that the plan will succeed.","exampleTranslation":"Việc kế hoạch sẽ thành công là điều đáng nghi ngờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"dream":{"definition":"Giấc mơ, giấc mộng.","example":"I saw a strange bird in my dream.","exampleTranslation":"Tôi thấy một con chim lạ trong giấc mơ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"eager":{"definition":"Nồng (rượu... ).","example":"She was eager to taste the strong soup.","exampleTranslation":"Cô ấy háo hức muốn nếm thử món súp nồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"embarrass":{"definition":"Làm lúng túng, làm ngượng nghịu.","example":"I embarrass easily when everyone looks at me.","exampleTranslation":"Tôi dễ dàng làm lúng túng khi mọi người nhìn vào mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"embarrassment":{"definition":"Điều làm lúng túng, điều làm bối rối; điều làm ngượng.","example":"The broken chair was an embarrassment to us.","exampleTranslation":"Chiếc ghế hỏng là điều làm ngượng đối với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"empathetic":{"definition":"Có sự đồng cảm, thông cảm.","example":"She was empathetic when I felt sad.","exampleTranslation":"Cô ấy đã rất thông cảm khi tôi cảm thấy buồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"emptiness":{"definition":"Tình trạng rỗng không.","example":"The emptiness of the room felt cold.","exampleTranslation":"Sự trống rỗng của căn phòng tạo cảm giác lạnh lẽo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"enthusiasm":{"definition":"Sự hăng hái, sự nhiệt tình.","example":"Her enthusiasm made the lesson more fun.","exampleTranslation":"Sự hăng hái của cô ấy làm cho bài học thú vị hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"entrance":{"definition":"Làm mê li.","example":"The music can entrance anyone in the room.","exampleTranslation":"Âm nhạc có thể làm mê li bất cứ ai trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"escapist":{"definition":"Người theo phái thoát ly thực tế.","example":"He was an escapist who avoided hard facts.","exampleTranslation":"Anh ấy là người theo phái thoát ly thực tế, người tránh những sự thật khắc nghiệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"esteem":{"definition":"Sự kính mến, sự quý trọng.","example":"I hold my old teacher in high esteem.","exampleTranslation":"Tôi dành sự kính mến cao cho giáo viên cũ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"excitability":{"definition":"Tính dễ bị kích thích, tính dễ bị kích động.","example":"The excitability played a key role.","exampleTranslation":"Tính dễ bị kích thích đóng vai trò quan trọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"excited":{"definition":"Quá khứ và phân từ quá khứ của excite","example":"The children excited the puppy with noise.","exampleTranslation":"Những đứa trẻ đã làm con chó con bị kích động với tiếng ồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"exciting":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của excite.","example":"She is exciting the crowd with her song.","exampleTranslation":"Cô ấy đang làm đám đông hào hứng với bài hát của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"expect":{"definition":"Mong chờ, chờ đợi, ngóng chờ, trông mong.","example":"I do not expect you to arrive early.","exampleTranslation":"Tôi không mong chờ bạn đến sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"expectation":{"definition":"Sự mong chờ, sự chờ đợi, sự ngóng chờ, sự trông mong.","example":"Her expectation was a quiet weekend.","exampleTranslation":"Sự mong chờ của cô ấy là một ngày cuối tuần yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"extroversion":{"definition":"Sự hướng ngoại.","example":"His extroversion helps him meet new people.","exampleTranslation":"Sự hướng ngoại của anh ấy giúp anh ấy gặp gỡ những người mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"extrovert":{"definition":"Người quan tâm đến môi trường xung quanh hơn là đến bản thân mình, người có tinh thần hướng ngoại.","example":"An extrovert enjoys talking with new classmates.","exampleTranslation":"Một người hướng ngoại thích nói chuyện với các bạn cùng lớp mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"fascinate":{"definition":"Thôi miên, làm mê.","example":"The story can fascinate young readers.","exampleTranslation":"Câu chuyện có thể thôi miên những độc giả trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"fascinating":{"definition":"Làm mê, làm say mê, quyến rũ.","example":"The view from the hill was fascinating.","exampleTranslation":"Khung cảnh từ ngọn đồi thật làm say mê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"fascination":{"definition":"Sự thôi miên, sự làm mê.","example":"The music had a strange fascination for her.","exampleTranslation":"Âm nhạc có một sự thôi miên kỳ lạ đối với cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"fear":{"definition":"Sự sợ, sự sợ hãi.","example":"She lived in constant fear during the war.","exampleTranslation":"Cô ấy sống trong sự sợ hãi liên tục trong chiến tranh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"fearsome":{"definition":"Sợ, sợ hãi, sợ sệt.","example":"The fearsome dog barked all night.","exampleTranslation":"Con chó sợ hãi đã sủa suốt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"feign":{"definition":"Giả vờ, giả đò, giả cách.","example":"She tried to feign sleep when her mother entered.","exampleTranslation":"Cô ấy đã cố gắng giả vờ ngủ khi mẹ cô ấy vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"flair":{"definition":"Sự thính, sự tinh; tài nhận thấy ngay (cái gì tốt, cái gì lợi).","example":"She has a flair for finding bargains.","exampleTranslation":"Cô ấy có tài nhận thấy ngay các món hời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"flinch":{"definition":"Flench.","example":"He did not flinch when the dog barked.","exampleTranslation":"Anh ấy không hề né khi con chó sủa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"folly":{"definition":"Sự điên rồ; hành động đại dột, ý nghĩ điên rồ, lời nói dại dột; điều nực cười, vật nực cười.","example":"It would be folly to go out alone.","exampleTranslation":"Sẽ là sự điên rồ nếu đi ra ngoài một mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"foolish":{"definition":"Dại dột, ngu xuẩn, xuẩn ngốc ((cũng) fool).","example":"It was foolish to leave the door open.","exampleTranslation":"Thật là dại dột khi để mở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"forget":{"definition":"Quên, không nhớ đến.","example":"I forget my lunch when I am busy.","exampleTranslation":"Tôi quên bữa trưa khi tôi bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"forsaken":{"definition":"Bỏ rơi.","example":"She felt forsaken after the move.","exampleTranslation":"Cô ấy cảm thấy bị bỏ rơi sau khi chuyển đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"frantic":{"definition":"Điên cuồng, điên rồ.","example":"He was frantic with pain after the accident.","exampleTranslation":"Anh ấy đã điên cuồng vì đau đớn sau vụ tai nạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"frenzied":{"definition":"Điên cuồng.","example":"The crowd became frenzied at the final whistle.","exampleTranslation":"Đám đông trở nên điên cuồng tại tiếng còi cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"fright":{"definition":"Sự hoảng sợ.","example":"A loud noise gave her a fright.","exampleTranslation":"Một tiếng động lớn khiến cô ấy hoảng sợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"frighten":{"definition":"Làm hoảng sợ, làm sợ.","example":"Do not frighten the children into crying.","exampleTranslation":"Đừng làm bọn trẻ sợ đến phát khóc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"frustrate":{"definition":"Làm thất bại, làm hỏng.","example":"A sudden storm will frustrate our travel plans.","exampleTranslation":"Một cơn bão bất ngờ sẽ làm hỏng kế hoạch du lịch của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"frustration":{"definition":"Sự làm thất bại, sự làm hỏng.","example":"Her frustration grew when the file disappeared.","exampleTranslation":"Sự thất bại của cô ấy tăng lên khi tệp tin biến mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"fussy":{"definition":"Cầu kỳ, kiểu cách.","example":"She is very fussy about how she dresses every day.","exampleTranslation":"Cô ấy rất cầu kỳ về cách ăn mặc mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"gaze":{"definition":"Cái nhìn chằm chằm.","example":"She stood at the gaze of the crowd.","exampleTranslation":"Cô ấy đứng trước cái nhìn chằm chằm của đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"genius":{"definition":"Thiên tài, thiên tư.","example":"The poet was considered a genius of his time.","exampleTranslation":"Nhà thơ được coi là thiên tài của thời đại ông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"gentleness":{"definition":"Tính hiền lành, tính dịu dàng, tính hoà nhã; tính nhẹ nhàng; tính thoai thoải (dốc).","example":"Her gentleness helped the shy child.","exampleTranslation":"Tính dịu dàng của cô ấy đã giúp đứa trẻ nhút nhát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"glad":{"definition":"Vui lòng, sung sướng, vui mừng, vui vẻ, hân hoan.","example":"I am glad to see you today.","exampleTranslation":"Tôi rất vui lòng được gặp bạn hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"greedy":{"definition":"Tham lam, hám.","example":"The greedy man wanted all the gold coins.","exampleTranslation":"Người đàn ông tham lam muốn có tất cả các đồng tiền vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"grief":{"definition":"Nỗi đau buồn, nỗi sầu khổ, nỗi thương tiếc.","example":"She died of grief after losing her pet.","exampleTranslation":"Cô ấy đã qua đời vì nỗi đau buồn sau khi mất thú cưng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"grim":{"definition":"Dữ tợn, tàn nhẫn, nhẫn tâm, ác nghiệt.","example":"A grim face showed his deep sadness.","exampleTranslation":"Một gương mặt dữ tợn cho thấy nỗi buồn sâu sắc của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"grin":{"definition":"Cái nhăn mặt nhe cả răng ra.","example":"He gave a small grin after the joke.","exampleTranslation":"Anh ấy đã nhăn mặt nhe răng ra một chút sau câu chuyện đùa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"habit":{"definition":"Cách mọc; cách phát triển.","example":"The plant's habit changed in warm weather.","exampleTranslation":"Cách mọc của cây đã thay đổi trong thời tiết ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"habitual":{"definition":"Thường, thường lệ, quen thuộc, thường dùng.","example":"He has a habitual morning walk before work.","exampleTranslation":"Anh ấy có thói quen đi bộ buổi sáng thường lệ trước khi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"hate":{"definition":"Không muốn, không thích.","example":"I really hate to wake people up early.","exampleTranslation":"Tôi thực sự không muốn đánh thức mọi người dậy sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"hesitate":{"definition":"Do dự, ngập ngừng, lưỡng lự, không nhất quyết.","example":"I hesitate when the answer is unclear.","exampleTranslation":"Tôi do dự khi câu trả lời không rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"hesitation":{"definition":"Hesitance.","example":"His hesitation was easy to notice.","exampleTranslation":"Sự do dự của anh ấy rất dễ nhận thấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"hopeful":{"definition":"Hy vọng, đầy hy vọng.","example":"I am very hopeful about our success next year.","exampleTranslation":"Tôi rất đầy hy vọng về sự thành công của chúng ta vào năm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"hostile":{"definition":"Thù địch.","example":"The cat became hostile when I touched its bowl.","exampleTranslation":"Con mèo trở nên thù địch khi tôi chạm vào bát của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"hugging":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của hug.","example":"She is hugging her brother at the door.","exampleTranslation":"Cô ấy đang ôm anh trai mình ở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"humble":{"definition":"Khiêm tốn, nhún nhường.","example":"He maintains a humble attitude toward his coworkers.","exampleTranslation":"Anh ấy duy trì một thái độ khiêm tốn đối với đồng nghiệp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"hunch":{"definition":"Cái bướu.","example":"She had a small hunch on her back.","exampleTranslation":"Cô ấy có một cái bướu nhỏ trên lưng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"ideal":{"definition":"Chỉ có trong ý nghĩ, chỉ có trong trí tưởng tượng, tưởng tượng.","example":"The plan exists only in an ideal world.","exampleTranslation":"Kế hoạch này chỉ tồn tại trong một thế giới tưởng tượng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"ideally":{"definition":"Lý tưởng, đúng như lý tưởng.","example":"She spoke ideally during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện một cách lý tưởng trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"illusion":{"definition":"Ảo tưởng.","example":"He lived under the illusion of eternal wealth.","exampleTranslation":"Anh ấy sống trong ảo tưởng về sự giàu có vĩnh cửu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"illusory":{"definition":"Không thực tế, hão huyền, viển vông.","example":"Their hope was illusory and soon faded.","exampleTranslation":"Hy vọng của họ là hão huyền và sớm tan biến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"imaginary":{"definition":"Tưởng tượng, không có thực, ảo.","example":"Do not worry about that imaginary disease anymore.","exampleTranslation":"Đừng lo lắng về căn bệnh tưởng tượng đó nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"imagination":{"definition":"Sức tưởng tượng, trí tưởng tượng; sự tưởng tượng.","example":"Her imagination turned the plain room into a castle.","exampleTranslation":"Trí tưởng tượng của cô ấy đã biến căn phòng trống trải thành một tòa lâu đài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"imaginatively":{"definition":"Theo tính cách tưởng tượng.","example":"He moved imaginatively through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách đầy tưởng tượng xuyên qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"imagine":{"definition":"Tưởng tượng, hình dung.","example":"Try to imagine a house made of glass.","exampleTranslation":"Hãy thử hình dung một ngôi nhà được làm bằng thủy tinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"impress":{"definition":"Dấu ấn.","example":"His painting bears an impress of true genius.","exampleTranslation":"Bức tranh của anh ấy mang một dấu ấn của thiên tài thực thụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"impression":{"definition":"Ấn tượng.","example":"His speech made a strong impression on the audience.","exampleTranslation":"Bài phát biểu của anh ấy đã tạo ấn tượng mạnh mẽ với khán giả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"impressive":{"definition":"Hùng vĩ, nguy nga, oai vệ, uy nghi.","example":"They stood before an impressive scene in the mountains.","exampleTranslation":"Họ đứng trước một khung cảnh hùng vĩ trên núi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"impulse":{"definition":"Sức đẩy tới.","example":"The government gave a new impulse to local trade.","exampleTranslation":"Chính phủ đã tạo một sức đẩy tới cho thương mại địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"inability":{"definition":"Sự không có khả năng, sự bất lực, sự bất tài.","example":"The inability was useful in class.","exampleTranslation":"Sự bất lực đó lại hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"incapable":{"definition":"Không đủ khả năng, bất tài, bất lực.","example":"He is an incapable man for this job.","exampleTranslation":"Anh ấy là một người không đủ khả năng cho công việc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"incomprehension":{"definition":"Sự không hiểu được.","example":"His incomprehension of the rule was obvious.","exampleTranslation":"Sự không hiểu được của anh ấy về quy tắc là điều rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"inherent":{"definition":"Vốn thuộc về, vốn gắn liền với.","example":"A need for sleep is inherent in humans.","exampleTranslation":"Nhu cầu ngủ là vốn thuộc về con người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"inherently":{"definition":"Vốn đã.","example":"They worked inherently all day.","exampleTranslation":"Họ đã làm việc một cách vốn đã suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"inhibit":{"definition":"Ngăn cấm, cấm.","example":"The school rules inhibit phone use in class.","exampleTranslation":"Các quy tắc của trường ngăn cấm việc sử dụng điện thoại trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"injured":{"definition":"Tỏ vẻ bị xúc phạm, tỏ vẻ mếch lòng.","example":"She spoke in an injured voice after the argument.","exampleTranslation":"Cô ấy đã nói bằng một giọng tỏ vẻ bị xúc phạm sau cuộc tranh luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"inoffensiveness":{"definition":"Tính không làm mếch lòng; tính không có gì đáng chê trách.","example":"Her reply had an inoffensiveness that pleased him.","exampleTranslation":"Câu trả lời của cô ấy có một tính không làm mếch lòng đã làm anh ấy hài lòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"intellect":{"definition":"Người hiểu biết; người tài trí.","example":"The old man was known as an intellect.","exampleTranslation":"Ông già được biết đến như một người tài trí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"intension":{"definition":"Sự cố gắng căng thẳng về tinh thần; quyết tâm cao.","example":"He studied with quiet intension before the test.","exampleTranslation":"Anh ấy học với một sự cố gắng căng thẳng về tinh thần trước bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"intent":{"definition":"Kiên quyết; đeo đuổi, miệt mài, mải mê, chăm chú.","example":"He had an intent gaze during the meeting.","exampleTranslation":"Anh ấy có một cái nhìn kiên quyết trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"intention":{"definition":"Ý định, mục đích.","example":"My intention is to finish early.","exampleTranslation":"Ý định của tôi là hoàn thành sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"intentional":{"definition":"Có ý định trước, được định trước, có ý, chủ tâm.","example":"Her apology was intentional, not an accident.","exampleTranslation":"Lời xin lỗi của cô ấy là chủ tâm, không phải tai nạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"interpersonal":{"definition":"Giữa cá nhân với nhau.","example":"Good interpersonal skills help at work.","exampleTranslation":"Kỹ năng giữa cá nhân với nhau tốt giúp ích trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"intimate":{"definition":"Chung chăn chung gối; gian dâm, thông dâm.","example":"He ignored the intimate meaning of the scene.","exampleTranslation":"Anh ấy phớt lờ ý nghĩa chung chăn chung gối của cảnh đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"introvert":{"definition":"Cái lồng tụt vào trong (như ruột).","example":"The introvert liked reading alone.","exampleTranslation":"Người có cái lồng tụt vào trong thích đọc sách một mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"intuition":{"definition":"Trực giác, sự hiểu biết qua trực giác; khả năng trực giác.","example":"Her intuition told her to wait.","exampleTranslation":"Trực giác của cô ấy bảo cô ấy phải đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"involuntary":{"definition":"Không cố ý, không chủ tâm, vô tình, phi tự nguyện.","example":"She gave an involuntary smile at the joke.","exampleTranslation":"Cô ấy đã đưa ra một nụ cười không cố ý trước câu nói đùa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"inward":{"definition":"Hướng vào trong, đi vào trong.","example":"The plan looked inward in practice.","exampleTranslation":"Kế hoạch hướng vào trong trong thực tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"irritate":{"definition":"Làm phát cáu, chọc tức.","example":"The noise may irritate him after a while.","exampleTranslation":"Tiếng ồn có thể làm phát cáu anh ấy sau một lúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"joyful":{"definition":"Vui mừng, hân hoan, vui sướng.","example":"They had a joyful day at school.","exampleTranslation":"Họ đã có một ngày vui mừng ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"keen":{"definition":"Hát bài hát tang.","example":"They keen for the loss of a friend.","exampleTranslation":"Họ hát bài hát tang vì sự mất mát của một người bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"knack":{"definition":"Sở trường, tài riêng; sự thông thạo; sự khéo tay.","example":"She has a knack for making beautiful pottery.","exampleTranslation":"Cô ấy có sở trường làm gốm đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"laziness":{"definition":"Sự lười biếng, sự biếng nhác.","example":"Her laziness kept the room messy.","exampleTranslation":"Sự lười biếng của cô ấy khiến căn phòng bừa bộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"lazy":{"definition":"Lười biếng, biếng nhác.","example":"My lazy brother sleeps too late.","exampleTranslation":"Người anh lười biếng của tôi ngủ quá muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"likeable":{"definition":"Dễ thương, đáng yêu.","example":"She is a likeable teacher.","exampleTranslation":"Cô ấy là một giáo viên dễ thương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"lively":{"definition":"Sống, sinh động, giống như thật.","example":"The party was filled with lively music and dancing.","exampleTranslation":"Bữa tiệc đầy những âm nhạc và điệu nhảy sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"lonely":{"definition":"cô đơn","example":"She was bored and lonely without her friends.","exampleTranslation":"Cô ấy cảm thấy buồn chán và cô đơn khi không có bạn bè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"psychology"},"love":{"definition":"Lòng yêu, tình thương.","example":"She has a deep love of her country.","exampleTranslation":"Cô ấy có lòng yêu sâu sắc đối với đất nước của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"lover":{"definition":"Người yêu, người ham thích, người ham chuộng, người hâm mộ.","example":"She is a true lover of classical music.","exampleTranslation":"Cô ấy là người hâm mộ nhạc cổ điển chân chính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"luck":{"definition":"Vận, sự may rủi.","example":"I wish you good luck with your new job.","exampleTranslation":"Tôi chúc bạn gặp nhiều sự may rủi tốt với công việc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"lucky":{"definition":"may mắn","example":"After getting married and winning $1 million on the same day, Susan felt very lucky.","exampleTranslation":"Sau khi kết hôn và thắng 1 triệu đô la cùng ngày, Susan cảm thấy rất may mắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"psychology"},"mania":{"definition":"Tính ham mê, tính nghiện.","example":"She has a mania for collecting old vinyl records.","exampleTranslation":"Cô ấy có tính ham mê sưu tầm các bản thu vinyl cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"mature":{"definition":"Chín, thành thực, trưởng thành.","example":"She became a mature woman in her early twenties.","exampleTranslation":"Cô ấy đã trở thành một người phụ nữ trưởng thành khi mới ngoài hai mươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"meditate":{"definition":"Ngẫm nghĩ, trầm ngâm.","example":"I like to meditate before bed.","exampleTranslation":"Tôi thích ngẫm nghĩ trước khi ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"meditation":{"definition":"Sự ngẫm nghĩ, sự trầm ngâm, sự trầm tư mặc tưởng.","example":"Her meditation helped her stay calm before class.","exampleTranslation":"Sự ngẫm nghĩ của cô ấy đã giúp cô giữ bình tĩnh trước giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"meditative":{"definition":"Hay ngẫm nghĩ, trầm tư.","example":"He looked meditative while watching the rain fall.","exampleTranslation":"Anh ấy trông trầm tư khi nhìn mưa rơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"memory":{"definition":"Sự nhớ, trí nhớ, ký ức.","example":"I have a very good memory for names.","exampleTranslation":"Tôi có một trí nhớ rất tốt về tên gọi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"mindset":{"definition":"tư duy; cách suy nghĩ; tâm thế","example":"You need to change your mindset and be more open to other people's ideas.","exampleTranslation":"Bạn cần thay đổi tư duy của mình và cởi mở hơn với ý tưởng của người khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"psychology"},"misconception":{"definition":"Sự quan niệm sai, sự nhận thức sai, sự hiểu sai.","example":"Many people hold a misconception about hard work.","exampleTranslation":"Nhiều người có quan niệm sai lầm về làm việc chăm chỉ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"mood":{"definition":"Lối, cách, thức.","example":"The verb can be used in the infinitive mood.","exampleTranslation":"Động từ có thể được sử dụng ở lối nguyên thể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"moody":{"definition":"Buồn rầu, ủ rũ.","example":"He felt moody after a bad night.","exampleTranslation":"Anh ấy cảm thấy buồn rầu sau một đêm tồi tệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"morale":{"definition":"Tính thần, chí khí, nhuệ khí.","example":"The team suffered from low morale after the loss.","exampleTranslation":"Tinh thần của đội bị xuống thấp sau trận thua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"motivate":{"definition":"Thúc đẩy, làm động cơ thúc đẩy.","example":"Good results can motivate students to keep learning.","exampleTranslation":"Kết quả tốt có thể thúc đẩy học sinh tiếp tục học tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"mystify":{"definition":"Làm bối rối, làm hoang mang.","example":"The trick question tried to mystify the class.","exampleTranslation":"Câu hỏi mẹo đã cố làm cho cả lớp bối rối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"naive":{"definition":"Ngây thơ, chất phác.","example":"He was naive enough to believe every promise.","exampleTranslation":"Anh ấy ngây thơ đến mức tin vào mọi lời hứa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"notion":{"definition":"Ý niệm, khái niệm.","example":"I have a vague notion of how this works.","exampleTranslation":"Tôi có một ý niệm mơ hồ về cách thức hoạt động của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"obsession":{"definition":"Sự ảm ảnh; tình trạng bị ám ảnh.","example":"Her obsession with order was tiring.","exampleTranslation":"Sự ám ảnh của cô ấy với trật tự thật mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"obsessive":{"definition":"Ám ảnh.","example":"His obsessive checking slowed the work.","exampleTranslation":"Sự kiểm tra ám ảnh của anh ấy đã làm chậm công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"optimist":{"definition":"Người lạc quan.","example":"The optimist believed the trip would go well.","exampleTranslation":"Người lạc quan tin rằng chuyến đi sẽ diễn ra tốt đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"optimistic":{"definition":"Lạc quan chủ nghĩa.","example":"The optimistic result helped everyone.","exampleTranslation":"Kết quả lạc quan đã giúp ích cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"outlook":{"definition":"Cách nhìn, quan điểm.","example":"She has a positive outlook on her future.","exampleTranslation":"Cô ấy có một cách nhìn tích cực về tương lai của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"overcome":{"definition":"Kiệt sức, mất tự chủ; mất tinh thần.","example":"He was overcome by a sudden feeling of fear.","exampleTranslation":"Anh ấy bị kiệt sức bởi một cảm giác sợ hãi đột ngột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"overwhelm":{"definition":"Chôn vùi, tràn, làm ngập.","example":"Heavy rain can overwhelm the small drain.","exampleTranslation":"Cơn mưa lớn có thể làm ngập hệ thống thoát nước nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"pamper":{"definition":"Nuông chiều, làm hư.","example":"They pamper the puppy with treats.","exampleTranslation":"Họ nuông chiều chú cún con bằng những phần thưởng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"panic":{"definition":"Cây tắc.","example":"The panic flower grows well in warm soil.","exampleTranslation":"Cây tắc phát triển tốt trong đất ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"passion":{"definition":"Cảm xúc mạnh mẽ, tình cảm nồng nàn, đam mê.","example":"She spoke with passion about her favorite book.","exampleTranslation":"Cô ấy đã nói về cuốn sách yêu thích của mình với đầy đam mê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"passionate":{"definition":"Sôi nổi, say sưa, say đắm, nồng nàn, nồng nhiệt, thiết tha.","example":"The leader gave a passionate speech to the crowd.","exampleTranslation":"Người lãnh đạo đã có một bài phát biểu đầy say sưa trước đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"passive":{"definition":"Bị động, thụ động.","example":"You should not remain passive during the meeting.","exampleTranslation":"Bạn không nên tỏ ra thụ động trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"patience":{"definition":"Tính kiên nhẫn, tính nhẫn nại; sự bền chí, sự nhẫn nại.","example":"You need a lot of patience to learn this skill.","exampleTranslation":"Bạn cần rất nhiều sự kiên nhẫn để học kỹ năng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"perceive":{"definition":"Hiểu, nhận thức, lĩnh hội.","example":"How do you perceive the current situation?","exampleTranslation":"Bạn hiểu tình hình hiện tại như thế nào?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"perceptional":{"definition":"Nhận thức.","example":"The test measured his perceptional skills.","exampleTranslation":"Bài kiểm tra đã đo lường các kỹ năng nhận thức của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"persevere":{"definition":"Kiên nhẫn, kiên trì; bền gan, bền chí.","example":"You must persevere to reach your long term goals.","exampleTranslation":"Bạn phải kiên trì để đạt được những mục tiêu dài hạn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"persist":{"definition":"Kiên gan, bền bỉ.","example":"She will persist in doing her best every day.","exampleTranslation":"Cô ấy sẽ kiên gan làm hết sức mình mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"persistence":{"definition":"Tính kiên gan, tính bền bỉ.","example":"Her persistence helped her finish the course.","exampleTranslation":"Sự kiên trì đã giúp cô ấy hoàn thành khóa học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"persistent":{"definition":"Dai dẳng.","example":"The persistent rain caused a small flood in town.","exampleTranslation":"Cơn mưa dai dẳng đã gây ra một trận lụt nhỏ trong thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"persuade":{"definition":"Làm cho tin; thuyết phục.","example":"Can you persuade him to join our team?","exampleTranslation":"Bạn có thể thuyết phục anh ấy tham gia đội của chúng ta không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"persuasion":{"definition":"Sự làm cho tin, sự thuyết phục.","example":"His gentle persuasion helped me change my mind.","exampleTranslation":"Sự thuyết phục nhẹ nhàng của ông ấy đã giúp tôi thay đổi ý định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"persuasive":{"definition":"Có tài thuyết phục, có sức thuyết phục, khiến tin theo, khiến nghe theo.","example":"Her persuasive voice won the class over.","exampleTranslation":"Giọng nói có sức thuyết phục của cô ấy đã khiến cả lớp ủng hộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"pessimist":{"definition":"Kẻ bi quan, kẻ yếm thế.","example":"The pessimist expected rain on every trip.","exampleTranslation":"Kẻ bi quan mong đợi mưa trong mọi chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"pessimistic":{"definition":"Bi quan, yếm thế.","example":"She felt pessimistic about the test.","exampleTranslation":"Cô ấy cảm thấy bi quan về bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"pitiful":{"definition":"Thương xót, thương hại, đầy lòng trắc ẩn.","example":"He gave the pitiful child a warm coat.","exampleTranslation":"Anh ấy đã cho đứa trẻ đáng thương một chiếc áo khoác ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"pleasure":{"definition":"Khoái lạc, hoan lạc; sự ăn chơi truỵ lạc.","example":"They lived a life given up to pleasure.","exampleTranslation":"Họ sống một cuộc đời phó mặc cho khoái lạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"preoccupation":{"definition":"Mối bận tâm, mối lo lắng, mối ưu tư.","example":"Work was his main preoccupation that week.","exampleTranslation":"Công việc là mối bận tâm chính của anh ấy trong tuần đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"pretend":{"definition":"Làm ra vẻ, giả vờ, giả đò, giả bộ, giả cách.","example":"Do not pretend illness just to stay at home.","exampleTranslation":"Đừng giả vờ bị ốm chỉ để ở nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"pride":{"definition":"Độ đẹp nhất, độ rực rỡ nhất, độ chín muồi, độ phát triển nhất.","example":"The flowers were in the full pride of spring.","exampleTranslation":"Thời kỳ đỉnh cao","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"procrastination":{"definition":"Sự trì hoãn; sự chần chừ.","example":"Procrastination made the task harder later.","exampleTranslation":"Sự trì hoãn làm cho nhiệm vụ trở nên khó khăn hơn sau đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"proud":{"definition":"kiêu ngạo, kiêu căng, kiêu hãnh, tự đắc.","example":"She looked at him with a very proud face.","exampleTranslation":"Cô ấy nhìn anh với vẻ mặt rất tự hào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"provoke":{"definition":"Khích, xúi giục, kích động.","example":"Do not provoke him while he is angry.","exampleTranslation":"Đừng chọc giận anh ấy khi anh ấy đang tức giận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"puzzle":{"definition":"Làm bối rối, làm khó xử.","example":"They will puzzle over the complex math problem.","exampleTranslation":"Họ sẽ phải đau đầu với bài toán phức tạp này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"rage":{"definition":"Cơn thịnh nộ, cơn giận dữ.","example":"He flew into a rage after hearing the news.","exampleTranslation":"Anh ấy đã nổi trận lôi đình sau khi nghe tin.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"rationalization":{"definition":"Sự hợp lý hoá.","example":"The report explained the rationalization of costs.","exampleTranslation":"Sự hợp lý hóa","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"reality":{"definition":"Sự thực, thực tế, thực tại; sự vật có thực.","example":"Hard work can turn your dreams into reality.","exampleTranslation":"Làm việc chăm chỉ có thể biến ước mơ của bạn thành hiện thực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"reawaken":{"definition":"Gợi lại.","example":"The old song can reawaken many sweet memories.","exampleTranslation":"Bài hát cũ có thể đánh thức nhiều ký ức ngọt ngào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"reborn":{"definition":"Đổi đời, hồi sinh, tái sinh.","example":"After the trip, he felt reborn and hopeful.","exampleTranslation":"Sau chuyến đi, anh ấy cảm thấy được tái sinh và đầy hy vọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"recall":{"definition":"Sự gọi về, sự đòi về, sự triệu về, sự triệu hồi (một đại sứ...).","example":"The government issued letters of recall for the ambassadors.","exampleTranslation":"Chính phủ đã ban hành thư triệu hồi các đại sứ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"recognisable":{"definition":"Có thể công nhận, có thể thừa nhận.","example":"The plan is now recognisable to everyone.","exampleTranslation":"Có thể công nhận","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"recognise":{"definition":"Công nhận, thừa nhận, chấp nhận.","example":"I recognise that face from school.","exampleTranslation":"Tôi nhận ra khuôn mặt đó từ thời đi học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology","spellingNote":"Alternate spelling: recognize."},"recognition":{"definition":"Sự công nhận, sự thừa nhận.","example":"The recognition of the new law was official.","exampleTranslation":"Việc công nhận luật mới là chính thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"recognizable":{"definition":"Có thể nhận ra.","example":"Her voice was recognizable even in the crowd.","exampleTranslation":"Có thể nhận ra","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"recognize":{"definition":"Công nhận, thừa nhận, chấp nhận.","example":"The people will recognize the new government soon.","exampleTranslation":"Người dân sẽ sớm công nhận chính phủ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology","spellingNote":"British spelling: recognise."},"recollection":{"definition":"Sự nhớ lại, sự hồi tưởng lại; ký ức, hồi ức.","example":"I have a dim recollection of that old house.","exampleTranslation":"Sự hồi tưởng lại","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"relax":{"definition":"Làm dịu đi, làm chùng, làm bớt căng thẳng.","example":"You should relax the tension in your shoulders.","exampleTranslation":"Bạn nên thả lỏng sự căng thẳng ở vai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"relaxation":{"definition":"Sự giảm nhẹ (hình phạt... ).","example":"The judge granted a relaxation of the sentence.","exampleTranslation":"Thẩm phán đã cho phép giảm nhẹ bản án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"reluctance":{"definition":"Sự miễn cưỡng, sự bất đắc dĩ, sự không thích, sự không sẵn lòng (làm việc gì).","example":"She showed some reluctance to join the club.","exampleTranslation":"Sự bất đắc dĩ","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"reluctant":{"definition":"Miễn cưỡng, bất đắc dĩ, không thích, không sẵn lòng.","example":"He was reluctant to share his secret plans.","exampleTranslation":"Anh ấy đã ngần ngại không muốn chia sẻ những kế hoạch bí mật của mình. [L3]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"remember":{"definition":"Nhớ; nhớ lại, ghi nhớ.","example":"Do you remember seeing her at the park?","exampleTranslation":"Bạn có nhớ là đã nhìn thấy cô ấy ở công viên không? [L27]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"remind":{"definition":"Nhắc nhở, làm nhớ lại (cái gì).","example":"Please remind me about the meeting tonight.","exampleTranslation":"Làm ơn nhắc tôi về cuộc họp tối nay nhé. [L31]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"reminder":{"definition":"Cái nhắc nhở, cái làm nhớ lại (một điều gì).","example":"I sent a reminder to my friend about the party.","exampleTranslation":"Tôi đã gửi một lời nhắc cho bạn mình về bữa tiệc. [L35]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"resemblance":{"definition":"Sự giống nhau.","example":"There is a close resemblance between the two sisters.","exampleTranslation":"Có một sự giống nhau gần gũi giữa hai chị em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"resemble":{"definition":"Giống với (người nào, vật gì).","example":"The children resemble their mother very much.","exampleTranslation":"Những đứa trẻ rất giống mẹ của chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"resentment":{"definition":"Sự phẫn uất, sự oán giận.","example":"He felt deep resentment against his old boss.","exampleTranslation":"Anh ấy cảm thấy sự phẫn uất sâu sắc đối với ông chủ cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"resolve":{"definition":"Quyết tâm, ý kiên quyết.","example":"She showed great resolve to finish the race.","exampleTranslation":"Cô ấy thể hiện sự quyết tâm lớn để hoàn thành cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"responsive":{"definition":"Đáp lại, trả lời.","example":"The audience gave a responsive gesture during the play.","exampleTranslation":"Khán giả đã có một cử chỉ đáp lại trong vở kịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"ridiculous":{"definition":"Buồn cười, tức cười, lố bịch, lố lăng.","example":"That is a ridiculous idea for a party.","exampleTranslation":"Đó là một ý tưởng buồn cười cho một bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"ridiculously":{"definition":"Buồn cười; lố bịch; lố lăng.","example":"She answered ridiculously and smiled.","exampleTranslation":"Cô ấy trả lời một cách buồn cười và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"ruthlessly":{"definition":"Tàn nhẫn, nhẫn tâm; độc ác, không thương xót.","example":"He left ruthlessly after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách nhẫn tâm sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"sadness":{"definition":"Sự buồn bã, sự buồn rầu.","example":"The sadness in her voice was easy to hear.","exampleTranslation":"Sự buồn bã trong giọng nói của cô ấy rất dễ nhận thấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"satisfaction":{"definition":"Sự làm cho thoả mãn; sự vừa lòng, sự toại ý, sự thoả mãn.","example":"His hard work gave his parents great satisfaction.","exampleTranslation":"Công việc chăm chỉ đã mang lại cho cha mẹ anh ấy sự hài lòng lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"satisfy":{"definition":"Làm thoả mãn, làm vừa lòng, đáp ứng (được yêu cầu, điều kiện... ).","example":"Please satisfy the requirements before you submit it.","exampleTranslation":"Vui lòng đáp ứng các yêu cầu trước khi bạn nộp nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"scare":{"definition":"Sự sợ hãi, sự kinh hoàng, sự hoang mang lo sợ (chiến tranh xảy ra... ).","example":"The scare spread through the crowd quickly.","exampleTranslation":"Sự sợ hãi lan nhanh qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"scary":{"definition":"Làm sợ hãi, làm kinh hãi, làm khiếp sợ, nhát như cáy.","example":"That dark hallway looks scary at night.","exampleTranslation":"Hành lang tối đó trông thật đáng sợ vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"scowl":{"definition":"Sự quắc mắt; sự cau có giận dữ.","example":"His scowl warned us to be quiet.","exampleTranslation":"Sự quắc mắt của anh ấy cảnh báo chúng tôi phải im lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"scream":{"definition":"Tiếng thét, tiếng hét, tiếng kêu thất thanh; tiếng kêu inh ỏi.","example":"A scream came from the dark hall.","exampleTranslation":"Một tiếng thét vang lên từ hội trường tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"self":{"definition":"Một màu (hoa).","example":"She chose a self flower for the vase.","exampleTranslation":"Cô ấy đã chọn một bông hoa một màu cho chiếc bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"selflessness":{"definition":"Tính không ích kỷ, sự quên mình, lòng vị tha.","example":"Her selflessness saved the team time.","exampleTranslation":"Sự quên mình của cô ấy đã tiết kiệm thời gian cho cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"sensation":{"definition":"Cảm giác.","example":"She had a strange sensation of dizziness suddenly.","exampleTranslation":"Cô ấy đột nhiên có một cảm giác chóng mặt lạ lùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"sensible":{"definition":"Dễ nhận thấy.","example":"There is a sensible difference between these two plans.","exampleTranslation":"Có một sự khác biệt dễ nhận thấy giữa hai kế hoạch này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"sensitive":{"definition":"Có cảm giác; (thuộc) cảm giác.","example":"The sensitive skin reacted to the cold wind.","exampleTranslation":"Làn da nhạy cảm đã phản ứng với gió lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"sensitivity":{"definition":"Tính nhạy; độ nhạy.","example":"This camera has great color sensitivity.","exampleTranslation":"Chiếc máy ảnh này có độ nhạy màu sắc tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"sentiment":{"definition":"Tình, tình cảm, cảm xúc.","example":"She felt a deep sentiment of pity for them.","exampleTranslation":"Cô ấy cảm thấy một tình cảm sâu sắc thương hại cho họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"serious":{"definition":"Đứng đắn, nghiêm trang, nghiêm nghị.","example":"She is a very serious young person in class.","exampleTranslation":"Cô ấy là một người trẻ rất đứng đắn trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"seriousness":{"definition":"Tính chất đứng đắn, tính chất nghiêm trang.","example":"The seriousness of the issue needed careful thought.","exampleTranslation":"Tính chất đứng đắn của vấn đề cần phải được suy nghĩ kỹ lưỡng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"shame":{"definition":"Điều xấu hổ, mối nhục.","example":"His behavior was the shame of the family.","exampleTranslation":"Hành vi của anh ta là nỗi nhục của gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"shock":{"definition":"Sự đột xuất, sự đột biến, sự đột khởi.","example":"The company used shock tactics to increase sales.","exampleTranslation":"Công ty đã sử dụng các chiến thuật gây sốc để tăng doanh số.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"shortcoming":{"definition":"Thiếu sót, khuyết điểm, nhược điểm.","example":"One shortcoming is poor time management.","exampleTranslation":"Một thiếu sót là việc quản lý thời gian kém.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"shudder":{"definition":"Sự rùng mình.","example":"She felt a shudder after the cold wind.","exampleTranslation":"Cô ấy cảm thấy một sự rùng mình sau cơn gió lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"shyness":{"definition":"Tính nhút nhát, tính bẽn lẽn, tính e thẹn.","example":"Her shyness kept her from speaking at first.","exampleTranslation":"Tính nhút nhát đã khiến cô ấy không nói được lúc đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"smart":{"definition":"Sự đau đớn, sự nhức nhối; nỗi đau khổ.","example":"The smart in his leg kept him awake.","exampleTranslation":"Sự nhức nhối ở chân đã khiến anh ấy thức suốt đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"smile":{"definition":"Nụ cười; vẻ mặt tươi cười.","example":"She had a beautiful smile on her face.","exampleTranslation":"Cô ấy có một nụ cười đẹp trên khuôn mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"sorry":{"definition":"Lấy làm buồn, lấy làm tiếc, lấy làm phiền.","example":"I am sorry to hear about your recent loss.","exampleTranslation":"Tôi rất lấy làm tiếc khi nghe về sự mất mát gần đây của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"soul":{"definition":"Tâm hồn, tâm trí.","example":"You should put your heart and soul into this project.","exampleTranslation":"Bạn nên đặt hết tâm hồn và tâm trí vào dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"spirit":{"definition":"Tinh thần.","example":"She kept a positive spirit during hard times.","exampleTranslation":"Cô ấy giữ một tinh thần tích cực trong những thời điểm khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"spite":{"definition":"Sự giận, sự không bằng lòng.","example":"She felt a lot of spite against her rival.","exampleTranslation":"Cô ấy cảm thấy rất nhiều sự giận dữ đối với đối thủ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"spontaneous":{"definition":"Tự động, tự ý.","example":"She made a spontaneous offer of her services today.","exampleTranslation":"Cô ấy đã đưa ra một lời đề nghị tự ý về các dịch vụ của mình hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"stubborn":{"definition":"Bướng bỉnh, ương bướng, ngoan cố.","example":"The stubborn child refused to eat his dinner.","exampleTranslation":"Đứa trẻ bướng bỉnh từ chối ăn bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"stun":{"definition":"Sự choáng váng; tình trạng bất tỉnh nhân sự.","example":"He woke from the stun slowly.","exampleTranslation":"Anh ấy tỉnh dậy từ sự choáng váng một cách chậm rãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"subjective":{"definition":"Chủ quan.","example":"His choice was subjective, not based on facts.","exampleTranslation":"Lựa chọn của anh ấy mang tính chủ quan, không dựa trên sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"subtle":{"definition":"Phảng phất.","example":"I noticed a subtle perfume in the hallway.","exampleTranslation":"Tôi nhận thấy một mùi hương phảng phất ở hành lang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"surprise":{"definition":"Sự bất ngờ, sự bất thình lình.","example":"The sudden attack took the soldiers by surprise.","exampleTranslation":"Cuộc tấn công bất thình lình đã khiến những người lính ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"surprisingly":{"definition":"Làm ngạc nhiên, làm kinh ngạc; đáng sửng sốt.","example":"I read the note surprisingly.","exampleTranslation":"Tôi đã đọc ghi chú một cách đáng sửng sốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"sympathetic":{"definition":"Thông cảm; đồng tình.","example":"She gave a sympathetic smile to her crying friend.","exampleTranslation":"Cô ấy đã dành một nụ cười thông cảm cho người bạn đang khóc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"sympathy":{"definition":"Sự thông cảm; sự đồng tình.","example":"We should show sympathy for those who lost jobs.","exampleTranslation":"Chúng ta nên bày tỏ sự thông cảm cho những người đã mất việc làm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"taunt":{"definition":"Cái đích để chế giễu.","example":"His failure became a taunt to his old friends.","exampleTranslation":"Thất bại của anh ấy trở thành cái đích để chế giễu cho những người bạn cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"tease":{"definition":"Chòng ghẹo, trêu tức, trêu chọc, chòng.","example":"Don't tease your brother about his shoes.","exampleTranslation":"Đừng trêu chọc anh trai của bạn về đôi giày của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"temperament":{"definition":"Khí chất, tính khí, tính.","example":"She has a very artistic temperament.","exampleTranslation":"Cô ấy có một khí chất rất nghệ thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"tempt":{"definition":"Xúi, xúi giục.","example":"Do not tempt him to do something wrong.","exampleTranslation":"Đừng xúi giục anh ta làm điều gì đó sai trái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"tendency":{"definition":"Xu hướng, khuynh hướng.","example":"There is a tendency to procrastinate on projects.","exampleTranslation":"Có một xu hướng trì hoãn các dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"terrify":{"definition":"Làm khiếp sợ, làm kinh hãi.","example":"Please do not terrify the little dog.","exampleTranslation":"Vui lòng đừng làm kinh hãi con chó nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"thoughtful":{"definition":"Có suy nghĩ, chín chắn, thận trọng.","example":"It was a thoughtful choice for the team.","exampleTranslation":"Đó là một lựa chọn chín chắn cho cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"thrill":{"definition":"Sự run; tiếng run (của tim, phổi).","example":"A thrill ran through her at the news.","exampleTranslation":"Một sự run đã chạy qua người cô ấy tại tin tức đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"titillation":{"definition":"Sự cù, sự làm cho buồn cười.","example":"The joke gave her a little titillation.","exampleTranslation":"Câu đùa đã mang lại cho cô ấy một chút sự cù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"touch":{"definition":"Xúc giác.","example":"Her touch helped her find the keys in the dark.","exampleTranslation":"Xúc giác của cô ấy đã giúp cô ấy tìm thấy chìa khóa trong bóng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"trance":{"definition":"Trạng thái hôn mê.","example":"She fell into a trance during the meditation.","exampleTranslation":"Cô ấy rơi vào trạng thái hôn mê trong lúc thiền định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"trouble":{"definition":"Điều lo lắng, điều phiền muộn.","example":"I am in big trouble because of my mistake.","exampleTranslation":"Tôi đang gặp rắc rối lớn vì lỗi lầm của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"trust":{"definition":"Sự tín nhiệm, lòng tin, sự tin cậy.","example":"You must have trust in your own abilities.","exampleTranslation":"Bạn phải có lòng tin vào khả năng của chính mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"twitch":{"definition":"Cái kẹp mũi ngựa.","example":"The horse wore a twitch on its nose.","exampleTranslation":"Con ngựa đeo một cái kẹp mũi ngựa trên mũi nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"unaffected":{"definition":"Không xúc động, không động lòng, thản nhiên.","example":"He answered with an unaffected smile.","exampleTranslation":"Anh ấy đã trả lời bằng một nụ cười không chút xúc động.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unattractive":{"definition":"Ít hấp dẫn, không lôi cuốn, không quyến rũ; không có duyên.","example":"The dark room felt unattractive.","exampleTranslation":"Căn phòng tối cảm giác thật ít hấp dẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unaware":{"definition":"Không biết, không hay.","example":"She was unaware of the noise.","exampleTranslation":"Cô ấy không hay biết gì về tiếng ồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncanny":{"definition":"Kỳ lạ, huyền bí.","example":"The house had an uncanny silence.","exampleTranslation":"Ngôi nhà có một sự im lặng kỳ lạ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncertain":{"definition":"Không chắc, còn ngờ.","example":"They are working toward an uncertain success today.","exampleTranslation":"Họ đang làm việc hướng tới một sự thành công còn ngờ hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncertainty":{"definition":"Sự bất định","example":"There is much uncertainty about the new project.","exampleTranslation":"Có rất nhiều sự bất định về dự án mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"uncomfortable":{"definition":"Không thoải mái; bực bội, khó chịu.","example":"I feel uncomfortable sitting in this small chair.","exampleTranslation":"Tôi cảm thấy không thoải mái khi ngồi trên chiếc ghế nhỏ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncomplaining":{"definition":"Không kêu ca, không phàn nàn, không than phiền; nhẫn nhục.","example":"He stayed uncomplaining through the long wait.","exampleTranslation":"Anh ấy vẫn nhẫn nhục suốt khoảng thời gian chờ đợi dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncompromising":{"definition":"Không nhượng bộ, không thoả hiệp, cương quyết.","example":"She was uncompromising about her rules.","exampleTranslation":"Cô ấy đã không nhượng bộ về các quy tắc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncontrollable":{"definition":"Không ngăn được, không nén được.","example":"The child had an uncontrollable urge to sneeze.","exampleTranslation":"Đứa trẻ có một sự thôi thúc không ngăn được là phải hắt hơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uncreative":{"definition":"Không sáng tạo.","example":"The team chose an uncreative solution.","exampleTranslation":"Cả nhóm đã chọn một giải pháp không sáng tạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"undecided":{"definition":"Lưỡng lự, do dự, không dứt khoát, không nhất quyết.","example":"He remained undecided about lunch.","exampleTranslation":"Anh ấy vẫn do dự về bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"understand":{"definition":"Hiểu, nắm được ý, biết.","example":"I do not understand what you mean.","exampleTranslation":"Tôi không hiểu ý bạn là gì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"understandable":{"definition":"Có thể hiểu được.","example":"Your mistake is understandable in this situation.","exampleTranslation":"Sai lầm của bạn là có thể hiểu được trong tình huống này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"understandably":{"definition":"Có thể hiểu được, có thể thông cảm được.","example":"He moved understandably through the crowd.","exampleTranslation":"Anh ấy đã di chuyển một cách có thể thông cảm được qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"uneasy":{"definition":"Phiền phức, rầy rà.","example":"They were in an uneasy situation during the meeting.","exampleTranslation":"Họ đã ở trong một tình huống phiền phức trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unintended":{"definition":"Không được định hướng trước, không do dự tính trước.","example":"The change was unintended and surprised everyone.","exampleTranslation":"Sự thay đổi đó không được định hướng trước và làm mọi người ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unpleasant":{"definition":"Khó ưa, xấu, khó chịu, đáng ghét.","example":"I do not like this unpleasant weather today.","exampleTranslation":"Tôi không thích thời tiết khó chịu hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unrealistic":{"definition":"Không chân thật, phi hiện thực.","example":"His plan was unrealistic for one week.","exampleTranslation":"Kế hoạch của anh ấy là không chân thật trong vòng một tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unsubtle":{"definition":"Không xảo quyệt, ngờ nghệch.","example":"His unsubtle joke made everyone stare at him.","exampleTranslation":"Câu chuyện đùa không xảo quyệt của anh ấy khiến mọi người nhìn chằm chằm vào anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"unthinkable":{"definition":"Không thể nghĩ ra được; không thể tưởng tượng được.","example":"Missing that bus was unthinkable for him.","exampleTranslation":"Việc lỡ chuyến xe buýt đó là không thể nghĩ ra được với anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"uplift":{"definition":"Yếu tố kích thích, ảnh hưởng thúc đẩy.","example":"His praise was a strong uplift for the team.","exampleTranslation":"Lời khen ngợi của anh ấy là một yếu tố kích thích mạnh mẽ cho đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"upset":{"definition":"Làm đổ, đánh đổ, lật đổ; đánh ngã.","example":"Be careful not to upset the glass of water.","exampleTranslation":"Hãy cẩn thận không làm đổ ly nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"urge":{"definition":"Sự thèm.","example":"He had an urge for sweets after lunch.","exampleTranslation":"Anh ấy có sự thèm đồ ngọt sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"urgency":{"definition":"Sự gấp rút, sự cần kíp, sự khẩn cấp, sự cấp bách.","example":"This medical matter is one of great urgency.","exampleTranslation":"Vấn đề y tế này là một sự khẩn cấp lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"vision":{"definition":"Sự nhìn; sức nhìn, tầm nhìn.","example":"She has a very clear vision of the future.","exampleTranslation":"Cô ấy có một tầm nhìn rất rõ ràng về tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"visionary":{"definition":"Tưởng tượng, hão huyền, hư ảo, mộng ảo.","example":"He was criticized for his visionary ideas about technology.","exampleTranslation":"Anh ấy đã bị chỉ trích vì những ý tưởng tưởng tượng về công nghệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"wary":{"definition":"Thận trọng, cẩn thận, cảnh giác.","example":"You should be wary of strange strangers.","exampleTranslation":"Bạn nên thận trọng với những người lạ mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"weak":{"definition":"Thiếu nghị lực, yếu đuối, mềm yếu, nhu nhược.","example":"He showed a weak moment during the race.","exampleTranslation":"Anh ấy đã thể hiện một khoảnh khắc yếu đuối trong cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"weaken":{"definition":"Yếu đi, nhụt đi.","example":"Hard work should never weaken your strong spirit.","exampleTranslation":"Công việc khó khăn không bao giờ nên làm nhụt đi tinh thần mạnh mẽ của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"weep":{"definition":"Khóc.","example":"The child began to weep for her toy.","exampleTranslation":"Đứa trẻ bắt đầu khóc vì món đồ chơi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"weird":{"definition":"Kỳ quặc, kỳ dị, khó hiểu.","example":"I saw a weird creature in the woods.","exampleTranslation":"Tôi nhìn thấy một sinh vật kỳ dị trong rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"psychology"},"willingly":{"definition":"Sẵn lòng, vui lòng.","example":"She answered willingly and smiled.","exampleTranslation":"Cô ấy trả lời một cách vui lòng và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"psychology"},"willpower":{"definition":"Ý chí.","example":"He needed willpower to finish the hike.","exampleTranslation":"Anh ấy cần ý chí để hoàn thành chuyến đi bộ đường dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"wisdom":{"definition":"Tính khôn ngoan, trí tuệ.","example":"Wisdom comes from listening and learning every day.","exampleTranslation":"Trí tuệ đến từ việc lắng nghe và học hỏi mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"worry":{"definition":"Quấy rầy, làm phiền, làm khó chịu.","example":"Please do not worry me with your silly questions.","exampleTranslation":"Xin đừng quấy rầy tôi bằng những câu hỏi ngớ ngẩn của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"psychology"},"yawn":{"definition":"Ngáp (người).","example":"I gave a big yawn during the long movie.","exampleTranslation":"Tôi đã ngáp một cái thật to trong suốt bộ phim dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"yawner":{"definition":"Người hay ngáp.","example":"The yawner kept opening his mouth in class.","exampleTranslation":"Người hay ngáp đó cứ há miệng trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"yearning":{"definition":"Sự mong mỏi, sự ao ước, sự khát khao, sự nóng lòng muốn làm (việc gì).","example":"His yearning for peace was strong.","exampleTranslation":"Sự khao khát hòa bình của anh ấy rất mạnh mẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"psychology"},"adapt":{"definition":"Thay đổi để phù hợp và tồn tại trong những điều kiện môi trường mới.","example":"Some bacteria adapt rapidly when environmental conditions change.","exampleTranslation":"Một số vi khuẩn nhanh chóng thích nghi khi điều kiện môi trường thay đổi.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"V","posGroup":"verb","family":"biology"},"adaptation":{"definition":"Sự thay đổi về đặc điểm hoặc chức năng giúp sinh vật thích nghi và tồn tại trong môi trường cụ thể.","example":"In evolutionary biology, adaptation increases a population's survival under specific environmental pressures.","exampleTranslation":"Trong sinh học tiến hóa, sự thích nghi làm tăng khả năng sống sót của một quần thể trước những áp lực môi trường cụ thể.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"adaptable":{"definition":"Có khả năng thay đổi để thích nghi hiệu quả với những điều kiện hoặc môi trường khác nhau.","example":"Adaptable organisms are more likely to survive sudden changes in habitat conditions.","exampleTranslation":"Các sinh vật có khả năng thích nghi cao có nhiều khả năng sống sót hơn trước những thay đổi đột ngột trong điều kiện môi trường sống.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"adaptive":{"definition":"Có khả năng thích nghi hoặc điều chỉnh để phù hợp với điều kiện mới.","example":"The adaptive immune response becomes more effective after repeated exposure to a pathogen.","exampleTranslation":"Đáp ứng miễn dịch thích ứng trở nên hiệu quả hơn sau khi tiếp xúc nhiều lần với mầm bệnh.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"biologist":{"definition":"Nhà khoa học nghiên cứu các sinh vật và những quá trình sống.","example":"The biologist examined how temperature affected bacterial growth in controlled laboratory conditions.","exampleTranslation":"Nhà sinh vật học đã kiểm tra nhiệt độ ảnh hưởng như thế nào đến sự phát triển của vi khuẩn trong các điều kiện phòng thí nghiệm được kiểm soát.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"cell":{"definition":"Đơn vị cấu trúc và chức năng cơ bản của cơ thể sống.","example":"A cell typically contains genetic material that helps regulate its activities and is passed to daughter cells.","exampleTranslation":"Một tế bào thường chứa vật chất di truyền giúp điều hòa hoạt động của nó và được truyền cho các tế bào con.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"evolution":{"definition":"Quá trình các sinh vật thay đổi dần dần qua nhiều thế hệ.","example":"The evolution of complex immune systems occurred over millions of years.","exampleTranslation":"Sự tiến hóa của các hệ miễn dịch phức tạp diễn ra trong hàng triệu năm.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"evolutionary":{"definition":"Thuộc về sự tiến hóa hoặc những thay đổi của sinh vật qua các thế hệ.","example":"Evolutionary changes can spread through a population when they improve survival or reproduction.","exampleTranslation":"Những thay đổi tiến hóa có thể lan rộng trong một quần thể khi chúng cải thiện khả năng sống sót hoặc sinh sản.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"genetic":{"definition":"Thuộc về gen, di truyền hoặc sự truyền đặc điểm từ thế hệ này sang thế hệ khác.","example":"Genetic variation enables populations to respond differently to changing environmental conditions.","exampleTranslation":"Biến dị di truyền giúp các quần thể phản ứng khác nhau trước những điều kiện môi trường thay đổi.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"immune":{"definition":"Có khả năng miễn dịch hoặc kháng lại một bệnh hay tác nhân gây bệnh.","example":"After vaccination, immune cells rapidly identify and destroy pathogens entering the body.","exampleTranslation":"Sau khi tiêm vắc-xin, các tế bào miễn dịch nhanh chóng nhận diện và tiêu diệt những tác nhân gây bệnh xâm nhập cơ thể.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"microscope":{"definition":"Thiết bị dùng để phóng đại những vật thể hoặc cấu trúc quá nhỏ để nhìn bằng mắt thường.","example":"Researchers used a microscope to examine structural changes in the plant cells.","exampleTranslation":"Các nhà nghiên cứu sử dụng kính hiển vi để kiểm tra những thay đổi cấu trúc trong các tế bào thực vật.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"mutation":{"definition":"Sự thay đổi trong vật chất di truyền, có thể tạo ra đặc điểm mới.","example":"A mutation in this gene can alter the protein produced by affected cells.","exampleTranslation":"Một đột biến trong gen này có thể làm thay đổi protein do các tế bào bị ảnh hưởng tạo ra.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"nutrient":{"definition":"Chất cần thiết mà cơ thể hấp thụ để sinh trưởng, duy trì hoạt động và sửa chữa mô.","example":"Each nutrient supports particular functions, including growth, repair, and energy production.","exampleTranslation":"Mỗi chất dinh dưỡng hỗ trợ những chức năng nhất định, bao gồm tăng trưởng, sửa chữa và sản xuất năng lượng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"physiologist":{"definition":"Nhà khoa học nghiên cứu các chức năng và quá trình hoạt động của cơ thể.","example":"The physiologist investigated how exercise affects blood flow through human muscles.","exampleTranslation":"Nhà sinh lý học nghiên cứu cách tập thể dục ảnh hưởng đến lưu lượng máu qua các cơ của con người.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"physiology":{"definition":"Ngành khoa học nghiên cứu các chức năng và quá trình hoạt động của cơ thể sống.","example":"Understanding plant physiology helps scientists improve crop growth under drought conditions.","exampleTranslation":"Hiểu về sinh lý học thực vật giúp các nhà khoa học cải thiện sự phát triển của cây trồng trong điều kiện hạn hán.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"reproduction":{"definition":"Quá trình sinh sản, qua đó sinh vật tạo ra thế hệ con hoặc tạo bản sao vật chất di truyền.","example":"Sexual reproduction increases genetic variation by combining genetic material from two parents.","exampleTranslation":"Sinh sản hữu tính làm tăng biến dị di truyền bằng cách kết hợp vật chất di truyền từ hai bố mẹ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"virus":{"definition":"Tác nhân siêu nhỏ chỉ có thể nhân lên bên trong tế bào sống; một số loại có thể gây bệnh.","example":"A virus can enter host cells and redirect their machinery to produce new particles.","exampleTranslation":"Một virus có thể xâm nhập vào tế bào chủ và điều khiển bộ máy của chúng để tạo ra các hạt mới.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"biotechnology":{"definition":"Việc sử dụng sinh vật hoặc quá trình sinh học để phát triển sản phẩm và công nghệ.","example":"Biotechnology has helped researchers develop more resistant crops.","exampleTranslation":"Công nghệ sinh học giúp các nhà nghiên cứu phát triển những giống cây trồng có sức chống chịu tốt hơn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"biology"},"affinity":{"definition":"Sự ham thích.","example":"I have a natural affinity for classical music.","exampleTranslation":"Tôi có một sự ham thích tự nhiên đối với nhạc cổ điển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"alive":{"definition":"Sống, còn sống, đang sống.","example":"The fish are still alive in the large water tank.","exampleTranslation":"Những con cá vẫn còn sống trong bể nước lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"animate":{"definition":"Có sinh khí, có sức sống.","example":"The room felt animate and full of life.","exampleTranslation":"Căn phòng cảm thấy có sinh khí và đầy sức sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"appendage":{"definition":"Vật thêm vào, phần thêm vào.","example":"A small room was an appendage to the house.","exampleTranslation":"Một căn phòng nhỏ là một phần thêm vào của ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"avian":{"definition":"(kỹ thuật) Loài chim.","example":"The avian nest was hidden in the tree.","exampleTranslation":"Tổ chim ẩn giấu trên cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"bacteria":{"definition":"Vi khuẩn.","example":"Bacteria can grow quickly in warm milk.","exampleTranslation":"Vi khuẩn có thể phát triển nhanh chóng trong sữa ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bacterium":{"definition":"Vi khuẩn.","example":"The bacterium spread through the water.","exampleTranslation":"Vi khuẩn đã lan rộng qua nguồn nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"baleen":{"definition":"Tấm sừng hàm (ở cá voi).","example":"The whale's baleen filtered tiny fish.","exampleTranslation":"Tấm sừng hàm của cá voi đã lọc những con cá nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"biochemistry":{"definition":"Hoá sinh.","example":"She studied biochemistry at the university.","exampleTranslation":"Cô ấy đã học hóa sinh tại trường đại học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bladder":{"definition":"Ruột (bóng đá).","example":"He kicked the bladder high into the air.","exampleTranslation":"Anh ấy đá cái ruột bóng đá bay cao vào không trung.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"blink":{"definition":"Nhấp nháy, nháy mắt, chớp mắt","example":"Some animals, such as tortoises and hamsters, blink their eyes independently of each other.","exampleTranslation":"Một số loài động vật, chẳng hạn như rùa và chuột đồng, nháy mắt độc lập với nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"blood":{"definition":"Sự tàn sát, sự chém giết, sự đổ máu.","example":"The history of the war was written in blood.","exampleTranslation":"Lịch sử của cuộc chiến tranh đã được viết bằng máu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bloodstream":{"definition":"Dòng máu trong cơ thể.","example":"The medicine spread quickly through the bloodstream.","exampleTranslation":"Thuốc lan nhanh qua dòng máu trong cơ thể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bloom":{"definition":"Sự ra hoa.","example":"The cherry trees are in full bloom right now.","exampleTranslation":"Những cây anh đào đang nở hoa rực rỡ ngay lúc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"blossom":{"definition":"Hoa (của cây ăn quả).","example":"The apple tree is in full blossom now.","exampleTranslation":"Cây táo đang ra hoa rực rỡ bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bole":{"definition":"Thân (cây).","example":"The bole of the tree was very wide.","exampleTranslation":"Thân cây rất rộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bone":{"definition":"Xương.","example":"He was cold to the bone this morning.","exampleTranslation":"Anh ấy cảm thấy lạnh thấu xương sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bony":{"definition":"Nhiều xương.","example":"The old man had very bony fingers.","exampleTranslation":"Ông già có những ngón tay gầy nhiều xương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"botanic":{"definition":"Thực vật học.","example":"We visited the beautiful botanic garden last Sunday.","exampleTranslation":"Chúng tôi đã tham quan khu vườn thực vật học xinh đẹp vào Chủ nhật trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"botanist":{"definition":"Nhà thực vật học.","example":"The botanist studied moss in the lab.","exampleTranslation":"Nhà thực vật học đã nghiên cứu rêu trong phòng thí nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"botany":{"definition":"Thực vật học.","example":"She wants to study botany at school.","exampleTranslation":"Cô ấy muốn học thực vật học tại trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bract":{"definition":"Lá bắc.","example":"A green bract protected the flower bud.","exampleTranslation":"Một lá bắc màu xanh bao bọc lấy nụ hoa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"branch":{"definition":"Nhánh (sông); ngả (đường)...","example":"A small branch of the river flows here.","exampleTranslation":"Một nhánh nhỏ của con sông chảy qua đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"breast":{"definition":"Lòng, tâm trạng, tình cảm.","example":"She had a troubled breast during the long trial.","exampleTranslation":"Cô ấy đã có một tâm trạng bất an trong suốt phiên tòa dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"budding":{"definition":"Bắt đầu nảy nở (tài năng... ).","example":"He is a budding artist with great promise.","exampleTranslation":"Anh ấy là một nghệ sĩ bắt đầu nảy nở với nhiều hứa hẹn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"buds":{"definition":"Động từ chia ở ngôi thứ ba số ít của bud","example":"The plant buds in early spring.","exampleTranslation":"Cây chồi nảy nở vào đầu mùa xuân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"bulb":{"definition":"Củ (hành, tỏi... ); (thực vật học) (thân) hành.","example":"She planted a bulb in the small pot.","exampleTranslation":"Cô ấy đã trồng một củ trong cái chậu nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"bush":{"definition":"Râu rậm, tóc râm.","example":"He grew a thick bush on his chin.","exampleTranslation":"Anh ấy để một chùm râu rậm trên cằm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"cactus":{"definition":"Cây xương rồng.","example":"A cactus needs little water.","exampleTranslation":"Một cây xương rồng cần ít nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"carcass":{"definition":"Xác súc vật; uồm thây.","example":"The carcass was covered before sunset.","exampleTranslation":"Xác súc vật đã được che phủ trước khi hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"carotene":{"definition":"Carotin.","example":"Carotene gives carrots their orange color.","exampleTranslation":"Carotin mang lại cho cà rốt màu cam.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"caterpillar":{"definition":"Sâu, sâu bướm.","example":"The bird just ate that green caterpillar.","exampleTranslation":"Con chim vừa ăn con sâu bướm xanh đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"cavity":{"definition":"Hố hốc, ổ, khoang.","example":"A small cavity formed in my back molar.","exampleTranslation":"Một hố sâu nhỏ đã hình thành trong chiếc răng hàm sau của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"cheek":{"definition":"Sự táo tợn, sự cả gan; thói trơ tráo, tính không biết xấu hổ.","example":"He had the cheek to ask for more money.","exampleTranslation":"Anh ta thật trơ tráo khi yêu cầu thêm tiền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"clone":{"definition":"Dòng vô tính, hệ vô tính.","example":"The lab created a clone of the plant.","exampleTranslation":"Phòng thí nghiệm đã tạo ra một bản sao vô tính của cái cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"clump":{"definition":"Lùm, bụi (cây).","example":"A clump of grass grew near the fence.","exampleTranslation":"Một lùm cỏ đã mọc gần hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"creature":{"definition":"Người, kẻ.","example":"That poor creature was shivering in the cold rain.","exampleTranslation":"Người đáng thương đó đang run rẩy trong cơn mưa lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"cutin":{"definition":"Cutin.","example":"The scientist studied the cutin on the plant.","exampleTranslation":"Nhà khoa học đã nghiên cứu cutin trên thực vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"droppings":{"definition":"Cái rơi nhỏ giọt (ví dụ nến chảy).","example":"Wax droppings covered the table.","exampleTranslation":"Sáp chảy làm vương vãi trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"evolve":{"definition":"(đùa cợt) tạo ra, hư cấu.","example":"He tried to evolve a funny story quickly.","exampleTranslation":"Anh ấy đã cố gắng tạo ra một câu chuyện hài hước nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"fetus":{"definition":"Thai, bào thai.","example":"The fetus was developing normally.","exampleTranslation":"Bào thai đã đang phát triển bình thường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"flesh":{"definition":"Sự mập, sự béo.","example":"She started to put on flesh after the surgery.","exampleTranslation":"Cô ấy bắt đầu mập lên sau cuộc phẫu thuật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"genus":{"definition":"Loại.","example":"This genus includes many common trees.","exampleTranslation":"Loại này bao gồm nhiều loại cây phổ biến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"geneticist":{"definition":"Nhà nghiên cứu về di truyền học, nhà di truyền học.","example":"A geneticist explained the family traits.","exampleTranslation":"Một nhà di truyền học đã giải thích về các đặc điểm gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"germ":{"definition":"Mộng, mầm, thai, phôi.","example":"The scientist studied the germ under a microscope.","exampleTranslation":"Nhà khoa học đã nghiên cứu mầm bệnh dưới kính hiển vi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"gill":{"definition":"Cô gái, bạn gái, người yêu.","example":"Jack and gill are famous nursery rhyme characters.","exampleTranslation":"Jack và Jill là những nhân vật đồng dao nổi tiếng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"gland":{"definition":"Tuyến.","example":"The lachrymal gland helps produce tears when crying.","exampleTranslation":"Tuyến lệ giúp tạo ra nước mắt khi khóc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"graft":{"definition":"Cành ghép; sự ghép cây; chỗ ghép cây.","example":"The gardener used graft to join the two branches.","exampleTranslation":"Người làm vườn đã sử dụng cành ghép để nối hai nhánh cây lại với nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"head":{"definition":"Cái đầu (người, thú vật).","example":"He examined her from head to foot carefully.","exampleTranslation":"Anh ấy kiểm tra cô ấy từ đầu đến chân một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"heart":{"definition":"Lồng ngực.","example":"She held his hand close to her heart.","exampleTranslation":"Cô ấy giữ bàn tay anh ta gần sát lồng ngực mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"heartbeat":{"definition":"Nhịp đập của tim.","example":"I could hear my heartbeat after the run.","exampleTranslation":"Tôi có thể nghe thấy nhịp đập của tim mình sau khi chạy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"heel":{"definition":"Gót móng (ngựa... ); (số nhiều) chân sau (loài thú bốn chân).","example":"The horse lifted its heel in the mud.","exampleTranslation":"Con ngựa nhấc gót móng của nó lên trong bùn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"hormonal":{"definition":"Thuộc hoặc do hooc môn gây ra.","example":"Hormonal changes can make her feel tired.","exampleTranslation":"Những thay đổi thuộc hooc môn có thể làm cô ấy cảm thấy mệt mỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"hormone":{"definition":"Hoocmon.","example":"This hormone helps the body grow.","exampleTranslation":"Loại hoocmon này giúp cơ thể phát triển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"humor":{"definition":"Dịch, thể dịch (trong cơ thể).","example":"The doctor checked the humor in the sample.","exampleTranslation":"Bác sĩ đã kiểm tra thể dịch trong mẫu thử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"imprint":{"definition":"Dấu vết, vết in, vết hằn.","example":"I saw the imprint of a foot on sand.","exampleTranslation":"Tôi đã nhìn thấy dấu vết của một bàn chân trên cát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"inborn":{"definition":"Bẩm sinh.","example":"She has an inborn talent for playing the piano beautifully.","exampleTranslation":"Cô ấy có một tài năng bẩm sinh để chơi piano một cách đẹp đẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"innards":{"definition":"Bộ lòng.","example":"He forgot the innards of the machine.","exampleTranslation":"Anh ấy quên bộ lòng của cỗ máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"innate":{"definition":"Bẩm sinh.","example":"She had an innate gift for music.","exampleTranslation":"Cô ấy có một tài năng bẩm sinh cho âm nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"jaws":{"definition":"Động từ chia ở ngôi thứ ba số ít của jaw","example":"He jaws with his neighbors every evening.","exampleTranslation":"Anh ấy tán gẫu với những người hàng xóm mỗi tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"larva":{"definition":"Ấu trùng.","example":"The larva moved slowly through the water.","exampleTranslation":"Ấu trùng di chuyển chậm chạp qua làn nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"legs":{"definition":"Động từ chia ở ngôi thứ ba số ít của leg","example":"My brother legs every afternoon.","exampleTranslation":"Anh trai tôi đi bộ mỗi buổi chiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"limb":{"definition":"Bờ, rìa.","example":"They stood at the limb of the lake.","exampleTranslation":"Họ đứng ở bờ của cái hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"lipid":{"definition":"Lipit.","example":"The food had a high level of lipid.","exampleTranslation":"Thức ăn có hàm lượng lipit cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"longevity":{"definition":"Sự sống lâu.","example":"The longevity was important at work.","exampleTranslation":"Sự sống lâu rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"mammal":{"definition":"Loài thú, loài động vật có vú.","example":"The mammal fed its baby milk.","exampleTranslation":"Loài thú cho con bú bằng sữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"maturation":{"definition":"Sự chín (trái cây).","example":"The fruit reached maturation in late summer.","exampleTranslation":"Trái cây đã đạt đến sự chín vào cuối mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"medulla":{"definition":"Ruột.","example":"The fruit's medulla was soft and sweet.","exampleTranslation":"Phần ruột của trái cây mềm và ngọt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"microbe":{"definition":"Vi trùng, vi khuẩn.","example":"A microbe can grow quickly in warm water.","exampleTranslation":"Vi trùng có thể phát triển nhanh chóng trong nước ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"microbial":{"definition":"Vi trùng, (thuộc) vi khuẩn.","example":"The microbial sample was kept under glass.","exampleTranslation":"Mẫu vật vi trùng đã được giữ dưới kính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"microorganism":{"definition":"Vi sinh vật.","example":"One microorganism can change the whole sample.","exampleTranslation":"Một vi sinh vật có thể thay đổi toàn bộ mẫu vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"midrib":{"definition":"Gân giữa (của lá).","example":"The leaf had a bright midrib.","exampleTranslation":"Chiếc lá có gân giữa sáng màu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"mold":{"definition":"(như) mould.","example":"The mold kept the bread fresh longer.","exampleTranslation":"Khuôn này giữ cho bánh mì tươi lâu hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"mole":{"definition":"Chuột chũi.","example":"A mole dug a tunnel under the garden.","exampleTranslation":"Một con chuột chũi đã đào một cái đường hầm dưới vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"molt":{"definition":"Sự rụng lông, sự thay lông.","example":"The bird's molt left feathers on the ground.","exampleTranslation":"Sự thay lông của con chim để lại những chiếc lông trên mặt đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"mortal":{"definition":"Chết, có chết.","example":"Every human being is mortal and will eventually die.","exampleTranslation":"Mọi con người đều phải chết và cuối cùng sẽ qua đời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"mouth":{"definition":"Mồm, miệng, mõm.","example":"Please keep your mouth closed during the movie.","exampleTranslation":"Vui lòng giữ miệng đóng trong suốt bộ phim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"muscle":{"definition":"To muscle in (từ Mỹ, nghĩa Mỹ), (từ lóng) đột nhập, xâm nhập.","example":"They tried to muscle in on our game.","exampleTranslation":"Họ đã cố gắng đột nhập vào trò chơi của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"muscular":{"definition":"Bắp thịt, (thuộc) cơ.","example":"He has a muscular back from training.","exampleTranslation":"Anh ấy có một tấm lưng vạm vỡ từ việc tập luyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"musk":{"definition":"Hươu xạ.","example":"We saw a musk near the forest edge.","exampleTranslation":"Chúng tôi đã nhìn thấy một con hươu xạ gần bìa rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"mutate":{"definition":"Làm cho... bị biến âm sắc/bị umlau hoá.","example":"Sound changes can mutate a word over time.","exampleTranslation":"Những thay đổi âm thanh có thể làm biến đổi một từ theo thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"nasal":{"definition":"Âm mũi.","example":"The singer had a strong nasal sound.","exampleTranslation":"Ca sĩ có một âm mũi mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"nectar":{"definition":"Rượu tiên.","example":"The flower gave off a sweet nectar.","exampleTranslation":"Bông hoa tỏa ra một thứ rượu tiên ngọt ngào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"nerve":{"definition":"Dây thần kinh.","example":"The injury damaged a nerve in his leg.","exampleTranslation":"Chấn thương đã làm hỏng một dây thần kinh ở chân anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"nervous":{"definition":"Thần kinh.","example":"The nervous system controls all our body functions.","exampleTranslation":"Hệ thống thần kinh kiểm soát tất cả các chức năng cơ thể của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"nervousness":{"definition":"Trạng thái hốt hoảng, trạng thái bối rối.","example":"The sudden noise caused nervousness in the room.","exampleTranslation":"Tiếng ồn đột ngột gây ra trạng thái hốt hoảng trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"neural":{"definition":"Thần kinh.","example":"The brain sends neural signals every second.","exampleTranslation":"Bộ não gửi các tín hiệu thần kinh mỗi giây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"nose":{"definition":"Mũi (người); mõm (súc vật).","example":"He has a very large and sharp nose.","exampleTranslation":"Anh ấy có một cái mũi rất lớn và nhọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"nostril":{"definition":"Lỗ mũi.","example":"A cold wind blew through my nostril.","exampleTranslation":"Một cơn gió lạnh thổi qua lỗ mũi tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"numb":{"definition":"Tê, tê cóng.","example":"My fingers felt numb with cold after the swim.","exampleTranslation":"Những ngón tay của tôi cảm thấy tê cóng vì lạnh sau khi bơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"offspring":{"definition":"Kết quả.","example":"Her hard work was the offspring of patience.","exampleTranslation":"Sự chăm chỉ của cô ấy là kết quả của sự kiên nhẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"orbicularis":{"definition":"Học cơ vòng.","example":"The orbicularis appeared in the report.","exampleTranslation":"Học cơ vòng đã xuất hiện trong bản báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"organ":{"definition":"Đàn ống (dùng trong nhà thờ); đàn hộp (có tay quay) ((cũng) barrel organ).","example":"The heart is a vital organ in humans.","exampleTranslation":"Trái tim là một cơ quan quan trọng ở con người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"parasitic":{"definition":"Ăn bám, ký sinh; do ký sinh.","example":"The fungus has a parasitic way of growing.","exampleTranslation":"Loại nấm này có cách sinh trưởng ký sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"parasitize":{"definition":"Ký sinh trên.","example":"Some ants parasitize plants for food.","exampleTranslation":"Một số loài kiến ký sinh trên thực vật để kiếm thức ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"petal":{"definition":"Cánh hoa.","example":"A pink petal fell onto the table.","exampleTranslation":"Một cánh hoa hồng rơi xuống bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"pineal":{"definition":"Có hình giống như quả thông.","example":"The pineal shape was small and round.","exampleTranslation":"Hình dạng của quả thông thì nhỏ và tròn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"pods":{"definition":"Động từ chia ở ngôi thứ ba số ít của pod","example":"The plants pods well in warm weather.","exampleTranslation":"Những cái cây cho quả tốt trong thời tiết ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"pollen":{"definition":"Phấn hoa.","example":"The pollen appeared in the report.","exampleTranslation":"Phấn hoa đã xuất hiện trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"predation":{"definition":"Lối sống ăn thịt (động vật).","example":"The cat's predation kept the garden clear of mice.","exampleTranslation":"Lối sống săn mồi","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"primate":{"definition":"Động vật linh trưởng, động vật có tay.","example":"A primate helped the team.","exampleTranslation":"Động vật linh trưởng","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"primatologist":{"definition":"Người nghiên cứu primatology.","example":"The primatologist observed monkeys for hours.","exampleTranslation":"Nhà nghiên cứu linh trưởng","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"reproduce":{"definition":"Sao chép, sao lại, mô phỏng.","example":"Can you reproduce this image in black and white?","exampleTranslation":"Bạn có thể sao chép hình ảnh này thành trắng đen được không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"reproductive":{"definition":"Tái sản xuất.","example":"Plants use reproductive cells to make new life.","exampleTranslation":"Các loài thực vật sử dụng các tế bào tái sản xuất để tạo ra sự sống mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"rhesus":{"definition":"Khỉ nâu, khỉ rezut.","example":"A rhesus climbed quickly across the branches.","exampleTranslation":"Một con khỉ nâu đã leo nhanh qua các cành cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"root":{"definition":"Rễ (cây).","example":"The tree has a very deep and strong root.","exampleTranslation":"Cái cây có một bộ rễ rất sâu và khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"rump":{"definition":"Mông đít (của thú).","example":"The dog's rump was covered in mud.","exampleTranslation":"Phần mông của con chó bị dính bùn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"scape":{"definition":"Ống (lông chim).","example":"A feather scape felt smooth in her hand.","exampleTranslation":"Một chiếc ống lông chim cho cảm giác nhẵn mịn trong tay cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"scapose":{"definition":"Có thân; có cọng; có cán.","example":"The plant has a long scapose stem.","exampleTranslation":"Loài cây này có một thân cây có cán dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"scent":{"definition":"Mùi, mùi thơm, hương thơm.","example":"The sweet scent of roses filled the room.","exampleTranslation":"Mùi thơm ngọt ngào của hoa hồng lấp đầy căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"sensory":{"definition":"Bộ máy cảm giác; (thuộc) cảm giác; (thuộc) giác quan.","example":"The sensory system helps us notice pain.","exampleTranslation":"Bộ máy cảm giác giúp chúng ta nhận thấy nỗi đau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"sepal":{"definition":"Lá đài.","example":"A green sepal protected the small flower.","exampleTranslation":"Một lá đài màu xanh lá cây đã bảo vệ bông hoa nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"shoulder":{"definition":"Che bằng vai, lách, len lỏi.","example":"He shoulder the crowd to reach the door.","exampleTranslation":"Anh ấy len lỏi qua đám đông để đến cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"sight":{"definition":"Sự nhìn, thị lực.","example":"The eagle has very sharp long sight for hunting.","exampleTranslation":"Con đại bàng có thị lực rất sắc bén để săn mồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"skeletal":{"definition":"Bộ xương; có tính chất bộ xương.","example":"The skeletal chair looked old and fragile.","exampleTranslation":"Chiếc ghế có bộ khung gầy gò trông cũ kỹ và mỏng manh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"skeleton":{"definition":"Bộ khung, bộ gọng.","example":"We built a steel skeleton for the shed.","exampleTranslation":"Chúng tôi dựng một bộ khung thép cho nhà kho.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"skin":{"definition":"Da, bì.","example":"The snake has smooth skin on its body.","exampleTranslation":"Con rắn có lớp da mịn trên cơ thể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"skull":{"definition":"Đầu óc, bộ óc.","example":"He has a thick skull and stubborn ideas.","exampleTranslation":"Anh ta có bộ óc cứng nhắc và những ý tưởng bướng bỉnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"smell":{"definition":"Khứu giác; năng lực, khả năng nhận ra hay nhận biết mùi, hơi, mùi vị, mùi hương","example":"The dog has a very good sense of smell.","exampleTranslation":"Con chó có khứu giác rất tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"smelt":{"definition":"Động từ thì quá khứ và quá khứ phân từ của smell.","example":"They smelt the data carefully.","exampleTranslation":"Họ đã kiểm tra dữ liệu một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"sniff":{"definition":"Sự hít; tiếng hít vào.","example":"Take a deep sniff of the fresh mountain air.","exampleTranslation":"Hãy hít một hơi sâu không khí trong lành của núi rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"spawn":{"definition":"Trứng (cá, ếch, sò, tôm... ).","example":"The fish laid spawn in the shallow water.","exampleTranslation":"Con cá đẻ trứng trong vùng nước nông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"sperm":{"definition":"Sperm-whale.","example":"The sperm traveled slowly through the cold water.","exampleTranslation":"Con cá voi nhà táng bơi chậm rãi qua làn nước lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"spike":{"definition":"Bông (kiểu cụm hoa).","example":"A spike of flowers grew near the fence.","exampleTranslation":"Một bông hoa mọc gần hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"spittle":{"definition":"Nước bọt.","example":"Spittle covered the corner of the sink.","exampleTranslation":"Nước bọt bao phủ góc của bồn rửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"spore":{"definition":"Bào tử.","example":"A tiny spore drifted through the air.","exampleTranslation":"Một bào tử nhỏ xíu trôi dạt trong không khí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"stem":{"definition":"Thân (cây); cuống, cọng (lá, hoa).","example":"A green stem held the bright flower upright.","exampleTranslation":"Một thân cây xanh giữ bông hoa tươi sáng thẳng đứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"stomata":{"definition":"Lỗ khí, khí khổng.","example":"Tiny stomata cover the underside of the leaf.","exampleTranslation":"Các lỗ khí nhỏ bao phủ mặt dưới của lá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"stunt":{"definition":"Sự làm cằn cỗi, sự làm còi cọc.","example":"Poor soil caused a stunt in the crops.","exampleTranslation":"Đất kém khiến cây trồng còi cọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"subspecies":{"definition":"Phân loài.","example":"This bird is a subspecies of owl.","exampleTranslation":"Con chim này là một phân loài của cú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"suck":{"definition":"Sự mút, sự bú, sự hút.","example":"The vacuum will suck the dirt from the floor.","exampleTranslation":"Máy hút bụi sẽ hút bụi bẩn từ sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"survival":{"definition":"Người còn lại; vật sót lại (của một thời kỳ đã qua); tàn dư, tan tích.","example":"The old clock is a survival from that time.","exampleTranslation":"Chiếc đồng hồ cũ là một tàn dư từ thời đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"survive":{"definition":"Sống qua, qua khỏi được.","example":"She will survive all perils in this journey.","exampleTranslation":"Cô ấy sẽ sống qua mọi hiểm nguy trong cuộc hành trình này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"survivor":{"definition":"Người sống sót.","example":"The survivor spoke calmly about the storm.","exampleTranslation":"Người sống sót đã nói chuyện một cách bình tĩnh về cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"tentacle":{"definition":"Lông tuyến.","example":"The leaf had a soft tentacle near the edge.","exampleTranslation":"Chiếc lá có một lông tuyến mềm gần mép.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"thrive":{"definition":"Thịnh vượng, phát đạt.","example":"The business cannot thrive without good management.","exampleTranslation":"Doanh nghiệp không thể thịnh vượng nếu không có quản lý tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"tissue":{"definition":"Mớ, tràng, dây (chuyện nói láo, chuyện vô lý... ).","example":"That story was just a tissue of lies.","exampleTranslation":"Câu chuyện đó chỉ là một mớ của những lời nói dối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"trait":{"definition":"Nét, điểm.","example":"Honesty is a very important trait for leaders.","exampleTranslation":"Trung thực là một nét rất quan trọng đối với các nhà lãnh đạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"trunk":{"definition":"Thân (cây, cột, người, thú).","example":"The tree trunk was wide and old.","exampleTranslation":"Thân cây đó rất rộng và lâu năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"tulip":{"definition":"Hoa uất kim hương.","example":"She picked a red tulip from the vase.","exampleTranslation":"Cô ấy đã hái một bông hoa uất kim hương đỏ từ chiếc bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"twig":{"definition":"Nhánh động mạch.","example":"The doctor checked the twig in his arm.","exampleTranslation":"Bác sĩ đã kiểm tra nhánh động mạch trên cánh tay anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"upstream":{"definition":"Hướng tới đầu 5’ của phân tử DNA.","example":"This gene lies upstream in the DNA chain.","exampleTranslation":"Gen này nằm hướng tới đầu 5’ trong chuỗi DNA.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"biology"},"variegate":{"definition":"Điểm những đốm màu khác nhau, làm cho lẫn màu.","example":"Farmers variegate the field with different crops.","exampleTranslation":"Nông dân điểm những đốm màu khác nhau trên cánh đồng với các loại cây trồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"vessel":{"definition":"; (thực vật học) ống, mạch.","example":"Water moves through each vessel in the plant.","exampleTranslation":"Nước di chuyển qua mỗi ống mạch trong cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"warble":{"definition":"Chai yên (chai cứng ở lưng ngựa do sự cọ xát của yên).","example":"A soft warble came from the horse's back.","exampleTranslation":"Một tiếng chai yên nhẹ đến từ lưng của con ngựa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"warbler":{"definition":"Chim chích.","example":"A warbler sang in the tall tree.","exampleTranslation":"Một con chim chích hót trong cái cây cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"willow":{"definition":"Máy tước x.","example":"The willow peeled the bark from the wood.","exampleTranslation":"Cây liễu đã lột vỏ từ gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"wing":{"definition":"Cánh (chim, sâu bọ; quả, hạt).","example":"The bird spread its wing to fly high.","exampleTranslation":"Con chim dang cánh để bay cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"wither":{"definition":"Làm khô héo, làm cho héo hắt đi.","example":"She felt her hope wither after the delay.","exampleTranslation":"Cô ấy cảm thấy hy vọng của mình héo hắt sau sự trì hoãn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"biology"},"womb":{"definition":"Ruột, trung tâm, lòng.","example":"The seeds lay in the earth's womb.","exampleTranslation":"Những hạt giống nằm trong lòng đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"worm":{"definition":"Đường ren (của vít).","example":"The worm in the screw was badly cut.","exampleTranslation":"Đường ren của con vít bị cắt hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"biology"},"wormy":{"definition":"Nhiều sâu.","example":"The old fruit looked very wormy and gross.","exampleTranslation":"Quả trái cây cũ trông rất nhiều sâu và gớm ghiếc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"biology"},"atmospheric":{"definition":"Thuộc về khí quyển hoặc các điều kiện của không khí bao quanh Trái Đất.","example":"Atmospheric pressure decreases as altitude increases, affecting boiling points and weather patterns.","exampleTranslation":"Áp suất khí quyển giảm khi độ cao tăng, ảnh hưởng đến nhiệt độ sôi và các kiểu thời tiết.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"continent":{"definition":"Lục địa hoặc châu lục, tức một vùng đất rộng lớn liên tục trên bề mặt Trái Đất.","example":"Africa is the second-largest continent and contains diverse climatic and geological regions.","exampleTranslation":"Châu Phi là châu lục lớn thứ hai và có các khu vực khí hậu, địa chất đa dạng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"continental":{"definition":"Thuộc về lục địa hoặc đặc trưng cho phần đất liền rộng lớn, trái với đại dương.","example":"Continental crust is generally thicker and less dense than oceanic crust.","exampleTranslation":"Vỏ lục địa nhìn chung dày hơn và ít đặc hơn vỏ đại dương.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"earthquake":{"definition":"Sự rung chuyển đột ngột của mặt đất do năng lượng được giải phóng trong vỏ Trái Đất.","example":"An earthquake occurs when accumulated stress is suddenly released along a geological fault.","exampleTranslation":"Một trận động đất xảy ra khi ứng suất tích tụ đột ngột được giải phóng dọc theo một đứt gãy địa chất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"geological":{"definition":"Thuộc về địa chất hoặc các đặc điểm, quá trình và cấu trúc của Trái Đất.","example":"Geological mapping can reveal buried faults that influence regional earthquake risk.","exampleTranslation":"Việc lập bản đồ địa chất có thể phát hiện các đứt gãy bị chôn vùi, vốn ảnh hưởng đến nguy cơ động đất trong khu vực.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"geologist":{"definition":"Nhà địa chất học, người nghiên cứu thành phần, cấu trúc và lịch sử của Trái Đất.","example":"The geologist analysed sediment layers to reconstruct ancient changes in the river valley.","exampleTranslation":"Nhà địa chất học đã phân tích các lớp trầm tích để tái dựng những thay đổi cổ xưa trong thung lũng sông.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"geology":{"definition":"Ngành khoa học nghiên cứu thành phần, cấu trúc, lịch sử và các quá trình biến đổi của Trái Đất.","example":"Geology helps researchers explain how volcanic activity has shaped the island.","exampleTranslation":"Địa chất học giúp các nhà nghiên cứu giải thích hoạt động núi lửa đã định hình hòn đảo như thế nào.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"glacier":{"definition":"Khối băng lớn hình thành trên đất liền và di chuyển chậm do trọng lực.","example":"The glacier is retreating rapidly as regional temperatures continue to rise.","exampleTranslation":"Sông băng đang rút lui nhanh chóng khi nhiệt độ khu vực tiếp tục tăng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"meteorological":{"definition":"Thuộc về thời tiết hoặc khoa học nghiên cứu các hiện tượng khí quyển.","example":"Meteorological records reveal significant changes in rainfall patterns over recent decades.","exampleTranslation":"Các ghi chép khí tượng cho thấy những thay đổi đáng kể trong mô hình lượng mưa trong những thập kỷ gần đây.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"meteorologist":{"definition":"Nhà khí tượng học, người nghiên cứu và dự báo thời tiết cùng các hiện tượng khí quyển.","example":"The meteorologist predicted severe storms by analysing pressure and wind patterns.","exampleTranslation":"Nhà khí tượng học đã dự báo những cơn bão nghiêm trọng bằng cách phân tích các mô hình áp suất và gió.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"meteorology":{"definition":"Ngành khoa học nghiên cứu khí quyển, thời tiết và các quá trình liên quan.","example":"Meteorology combines atmospheric observations with mathematical models to improve weather forecasts.","exampleTranslation":"Khí tượng học kết hợp các quan sát khí quyển với các mô hình toán học để cải thiện dự báo thời tiết.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"sediment":{"definition":"Vật chất như đất, cát hoặc mảnh vụn đá lắng đọng thành lớp bởi nước, gió hoặc băng.","example":"Heavy rainfall carried sediment from the hills into the coastal estuary.","exampleTranslation":"Mưa lớn đã cuốn trầm tích từ các ngọn đồi vào cửa sông ven biển.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"sedimentation":{"definition":"Quá trình các vật chất lắng đọng và tích tụ thành lớp trầm tích.","example":"Rapid sedimentation can bury organic material before oxygen fully decomposes it.","exampleTranslation":"Sự trầm tích nhanh có thể vùi lấp vật chất hữu cơ trước khi oxy phân hủy hoàn toàn vật chất đó.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"tectonic":{"definition":"Thuộc về sự chuyển động và biến dạng của các mảng kiến tạo trong vỏ Trái Đất.","example":"Tectonic movements gradually raise mountain ranges and reshape drainage patterns across continents.","exampleTranslation":"Các chuyển động kiến tạo dần nâng cao các dãy núi và định hình lại các kiểu thoát nước trên các lục địa.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"tidal":{"definition":"Liên quan đến, do hoặc chịu ảnh hưởng của thủy triều.","example":"Tidal currents transport fine sediments into coastal marshes and shallow estuaries.","exampleTranslation":"Các dòng chảy thủy triều vận chuyển trầm tích mịn vào những vùng đầm lầy ven biển và cửa sông nông.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"volcanic":{"definition":"Thuộc về núi lửa hoặc được tạo ra bởi hoạt động của núi lửa.","example":"Volcanic ash can travel thousands of kilometres and temporarily reduce air quality.","exampleTranslation":"Tro núi lửa có thể bay xa hàng nghìn kilômét và tạm thời làm giảm chất lượng không khí.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"climate":{"definition":"Khí hậu; những điều kiện thời tiết đặc trưng của một khu vực trong thời gian dài.","example":"Climate records reveal that prolonged droughts are becoming more frequent across several agricultural regions.","exampleTranslation":"Các hồ sơ khí hậu cho thấy những đợt hạn hán kéo dài đang trở nên thường xuyên hơn ở một số vùng nông nghiệp.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"dioxide":{"definition":"Hợp chất có một nguyên tố liên kết với hai nguyên tử oxy, chẳng hạn carbon dioxide (CO₂).","example":"Industrial emissions release carbon dioxide, which traps heat and contributes to global warming.","exampleTranslation":"Khí thải công nghiệp thải ra khí cacbon đioxit, chất giữ nhiệt và góp phần gây nóng lên toàn cầu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"ozone":{"definition":"Một dạng khí của oxy, có khả năng hấp thụ phần lớn bức xạ cực tím trong khí quyển.","example":"Stratospheric ozone absorbs ultraviolet radiation and protects living organisms from harmful solar exposure.","exampleTranslation":"Ôzôn trong tầng bình lưu hấp thụ bức xạ cực tím và bảo vệ các sinh vật khỏi sự phơi nhiễm có hại từ ánh nắng mặt trời.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"atmosphere":{"definition":"Quyển khí.","example":"Spacecraft can travel into the upper atmosphere of our planet.","exampleTranslation":"Tàu vũ trụ có thể du hành vào quyển khí phía trên của hành tinh chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"basin":{"definition":"Chỗ trũng lòng chảo.","example":"Farmers live in the basin below the mountains.","exampleTranslation":"Những người nông dân sống trong chỗ trũng lòng chảo dưới chân núi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"blizzard":{"definition":"Trận bão tuyết.","example":"A blizzard kept us indoors all day.","exampleTranslation":"Một trận bão tuyết giữ chúng tôi trong nhà suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"blow":{"definition":"Cú đánh đòn.","example":"He dealt a heavy blow to the wooden door.","exampleTranslation":"Anh ấy tung một cú đánh đòn mạnh vào cánh cửa gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"calm":{"definition":"Êm đềm, lặng gió (thời tiết); lặng, không nổi sóng (biển).","example":"The sea was calm and quiet at dawn.","exampleTranslation":"Biển thật êm đềm và yên tĩnh lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"cataract":{"definition":"Cơn mưa như trút nước.","example":"A cataract fell for hours on the road.","exampleTranslation":"Một cơn mưa như trút nước đã rơi hàng giờ trên con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"catastrophe":{"definition":"Tai ương, tai biến, thảm hoạ, tai hoạ lớn.","example":"The flood was a catastrophe for the village.","exampleTranslation":"Trận lụt là một tai họa lớn cho ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"catastrophic":{"definition":"Thảm hoạ, thê thảm.","example":"The storm caused catastrophic damage downtown.","exampleTranslation":"Cơn bão đã gây ra thiệt hại thê thảm ở trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"clime":{"definition":"Vùng, miền, xứ.","example":"She dreamed of living in a warm clime.","exampleTranslation":"Cô ấy đã mơ về việc sống trong một vùng khí hậu ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"cloud":{"definition":"Đám (khói, bụi).","example":"A cloud of dust rose from the road.","exampleTranslation":"Một đám bụi bốc lên từ con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"core":{"definition":"Điểm trung tâm, nòng cốt, hạt nhân.","example":"You must understand the core of this subject.","exampleTranslation":"Bạn phải hiểu nòng cốt của vấn đề này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"crater":{"definition":"Miệng núi lửa.","example":"The hikers looked into the crater from the edge.","exampleTranslation":"Những người đi bộ đường dài nhìn xuống miệng núi lửa từ mép ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"crust":{"definition":"Vỏ bánh, cùi bánh; mẩu bánh mì khô.","example":"I left a crust of bread on the plate.","exampleTranslation":"Tôi để lại một mẩu bánh mì trên đĩa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"digging":{"definition":"Sự đào, sự bới, sự xới, sự cuốc ((từ lóng) digs).","example":"Digging took most of the afternoon.","exampleTranslation":"Sự đào chiếm hầu hết buổi chiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"digs":{"definition":"Sự đào, sự bới, sự xới, sự cuốc ((cũng) digging).","example":"The digs left a small pile of soil.","exampleTranslation":"Các sự đào đã để lại một đống nhỏ đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"downwind":{"definition":"Theo hướng gió thổi.","example":"We set up camp downwind from the fire.","exampleTranslation":"Chúng tôi dựng trại theo hướng gió thổi từ đám cháy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"drift":{"definition":"Sự trôi giạt (tàu bè... ); tình trạng bị lôi cuốn đi ((nghĩa đen) & (nghĩa bóng)).","example":"The boat moved under the drift of the tide.","exampleTranslation":"Con thuyền di chuyển dưới sự trôi giạt của thủy triều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"dryness":{"definition":"Sự khô, sự khô cạn, sự khô ráo.","example":"The dryness of the soil hurt the crops.","exampleTranslation":"Sự khô cạn của đất làm hư hại mùa màng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"dust":{"definition":"Đám bụi mù.","example":"What a dust cloud appeared in the air!","exampleTranslation":"Một đám bụi mù xuất hiện trong không khí!","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"erode":{"definition":"Xói mòn, ăn mòn.","example":"Rain can erode the soft hillside.","exampleTranslation":"Mưa có thể xói mòn sườn đồi mềm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"erupt":{"definition":"Phun (núi lửa).","example":"The volcano began to erupt at dawn.","exampleTranslation":"Núi lửa bắt đầu phun vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"eruption":{"definition":"Sự nổ ra; sự phọt ra.","example":"A sudden eruption of applause filled the room.","exampleTranslation":"Một sự nổ ra bất ngờ của tiếng vỗ tay lấp đầy căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"evaporate":{"definition":"Làm khô (hoa quả, sữa).","example":"They evaporate the milk to make it thicker.","exampleTranslation":"Họ làm khô sữa để làm cho nó đặc hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"evaporation":{"definition":"Sự làm bay hơi, sự bay hơi.","example":"Warm air caused quick evaporation from the floor.","exampleTranslation":"Không khí ấm gây ra sự bay hơi nhanh từ sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"foggy":{"definition":"Có sương mù; tối tăm.","example":"It was a foggy morning by the lake.","exampleTranslation":"Đó là một buổi sáng có sương mù bên hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"forecast":{"definition":"sự dự đoán trước; sự dự báo trước.","example":"Did you see the weather forecast this morning?","exampleTranslation":"Bạn đã xem dự báo thời tiết sáng nay chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"forecaster":{"definition":"Người dự báo thời tiết.","example":"The forecaster predicted rain for tomorrow.","exampleTranslation":"Người dự báo thời tiết đã dự đoán mưa vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"freeze":{"definition":"Thấy ớn lạnh, thấy ghê ghê (vì sợ).","example":"She freeze when she saw the dark shape.","exampleTranslation":"Cô ấy thấy ớn lạnh khi nhìn thấy hình thù tối tăm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"frigid":{"definition":"Lạnh nhạt, nhạt nhẽo.","example":"She gave him a frigid welcome at the door.","exampleTranslation":"Cô ấy tiếp đón anh ta một cách lạnh nhạt ở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"geochemistry":{"definition":"Địa hoá học.","example":"Geochemistry helps explain the soil's minerals.","exampleTranslation":"Địa hoá học giúp giải thích các khoáng chất trong đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"geologic":{"definition":"(thuộc) Địa chất.","example":"The geologic layers were easy to see.","exampleTranslation":"Các lớp thuộc địa chất rất dễ nhận thấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"geologically":{"definition":"Về mặt địa chất, về phương diện địa chất.","example":"She spoke geologically during the meeting.","exampleTranslation":"Cô ấy đã phát biểu về phương diện địa chất trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"earth-science"},"geophysical":{"definition":"Địa vật lý.","example":"They used a geophysical test to study the ground.","exampleTranslation":"Họ đã sử dụng một bài kiểm tra địa vật lý để nghiên cứu mặt đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"glacial":{"definition":"Nước đá; (thuộc) thời kỳ sông băng.","example":"They lived through a very harsh glacial period.","exampleTranslation":"Họ đã sống qua một thời kỳ sông băng rất khắc nghiệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"glaciation":{"definition":"Sự đóng băng.","example":"The lake changed during the last glaciation.","exampleTranslation":"Hồ đã thay đổi trong thời gian đóng băng gần nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"hade":{"definition":"Độ nghiêng; góc dốc (của mạch mỏ).","example":"The hade of the rock vein was steep.","exampleTranslation":"Độ nghiêng của mạch đá rất dốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"iceberg":{"definition":"Núi băng trôi.","example":"An iceberg floated near the ship.","exampleTranslation":"Một núi băng trôi nổi gần con tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"leach":{"definition":"Nước tro (dùng để giặt).","example":"The old leach was used for laundry.","exampleTranslation":"Nước tro cũ đã được sử dụng cho việc giặt giũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"lightning":{"definition":"Chớp, tia chớp.","example":"The lightning struck the tall tree during the storm.","exampleTranslation":"Tia chớp đánh vào cái cây cao trong cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"limestone":{"definition":"(thuộc ngữ) Thứ làm từ đá vôi.","example":"The wall was built from limestone blocks.","exampleTranslation":"Bức tường được xây bằng những khối đá vôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"mantle":{"definition":"Áo khoác, áo choàng không tay.","example":"She wore a dark mantle over her dress.","exampleTranslation":"Cô ấy khoác một chiếc áo choàng không tay màu tối bên ngoài váy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"melt":{"definition":"Sự nấu chảy; sự tan.","example":"The melt happened quickly in the warm pan.","exampleTranslation":"Sự tan xảy ra nhanh chóng trong chảo nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"mist":{"definition":"Sương mù.","example":"A thick mist covered the road.","exampleTranslation":"Sương mù dày đặc bao phủ con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"overcast":{"definition":"Vắt sổ (khâu).","example":"She overcast the edge of the cloth neatly.","exampleTranslation":"Cô ấy vắt sổ cạnh của miếng vải một cách ngăn nắp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"precipitation":{"definition":"Sự vội vàng, sự vội vã cuống cuồng.","example":"Their precipitation made the deal fail.","exampleTranslation":"Sự vội vàng của họ làm cho thương vụ thất bại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"quarry":{"definition":"Mảnh kính hình thoi (ở cửa sổ mắt cáo... ).","example":"Each quarry in the window caught the light.","exampleTranslation":"Mảnh kính hình thoi","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"rain":{"definition":"(hàng hải) vùng mưa ở Đại tây dương (4 10 o độ vĩ bắc).","example":"They sailed through a rain zone in the ocean.","exampleTranslation":"Họ đã đi thuyền qua một vùng mưa trên đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"rainfall":{"definition":"Trận mưa rào.","example":"The rainfall was strong all afternoon.","exampleTranslation":"Lượng mưa rất lớn suốt cả buổi chiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"rainy":{"definition":"Có mưa; có nhiều mưa; hay mưa.","example":"I do not want to go out on a rainy day.","exampleTranslation":"Tôi không muốn ra ngoài vào một ngày mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"recede":{"definition":"Lùi lại, lùi xa dần.","example":"The water will recede after the heavy rain.","exampleTranslation":"Nước sẽ rút sau cơn mưa lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"rift":{"definition":"Đường nứt rạn, kẽ hở, kẽ nứt (ở đất, đá, đồ vật... ).","example":"He kept the rift on the desk.","exampleTranslation":"Anh ấy đã để đường nứt trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"rock":{"definition":"Đu đưa, lúc lắc.","example":"I like to rock my baby to sleep.","exampleTranslation":"Tôi thích ru đứa bé của mình ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"earth-science"},"rumble":{"definition":"Tiếng ầm ầm.","example":"We heard a loud rumble from the storm.","exampleTranslation":"Chúng tôi nghe thấy tiếng ầm ầm của cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"sand":{"definition":"Bãi cát, lớp cát (ở dưới đáy); (từ Mỹ, nghĩa Mỹ) bờ biển.","example":"Children played on the sand.","exampleTranslation":"Trẻ em đã chơi trên cát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"seabed":{"definition":"Đáy biển.","example":"The seabed was covered with sand.","exampleTranslation":"Đáy biển được bao phủ bằng cát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"season":{"definition":"Mùa (trong năm).","example":"Winter is my favorite season of the year.","exampleTranslation":"Mùa đông là mùa yêu thích của tôi trong năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"seismic":{"definition":"Động đất, (thuộc) địa chấn.","example":"The seismic shaking woke us before sunrise.","exampleTranslation":"Sự rung chuyển động đất đã đánh thức chúng tôi trước bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"storm":{"definition":"Dông tố, cơn bão.","example":"The storm brought heavy rain and strong winds.","exampleTranslation":"Cơn bão mang đến mưa lớn và gió mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"subsoil":{"definition":"Tầng đất cái.","example":"The roots reached deep subsoil.","exampleTranslation":"Các rễ cây đâm sâu vào tầng đất cái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"subsurface":{"definition":"Lớp dưới bề mặt.","example":"Water collected in the subsurface layer.","exampleTranslation":"Nước tích tụ trong lớp dưới bề mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"subtropical":{"definition":"Cận nhiệt đới.","example":"The town has a subtropical climate with warm winters.","exampleTranslation":"Thị trấn có khí hậu cận nhiệt đới với mùa đông ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"summer":{"definition":"Cái rầm ((cũng) summer-tree).","example":"We strengthened the roof with a heavy summer.","exampleTranslation":"Chúng tôi đã gia cố mái nhà bằng một cái rầm nặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"summery":{"definition":"Mùa hè; như mùa hè.","example":"She wore a summery dress on the warm day.","exampleTranslation":"Cô ấy mặc một chiếc váy mùa hè vào ngày ấm áp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"sunlight":{"definition":"Ánh sáng mặt trời.","example":"Sunlight filled the room after the rain.","exampleTranslation":"Ánh sáng mặt trời tràn ngập căn phòng sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"sunlit":{"definition":"Chan hoà ánh nắng, ngập nắng.","example":"The sunlit path looked warm and inviting.","exampleTranslation":"Con đường ngập nắng trông thật ấm áp và hấp dẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"sunny":{"definition":"Nắng, có nhiều ánh nắng.","example":"We enjoyed the sunny side of the hill.","exampleTranslation":"Chúng tôi đã tận hưởng phía nhiều nắng của ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"sunrise":{"definition":"Lúc mặt trời mọc, bình minh.","example":"We watched the sunrise from the hill.","exampleTranslation":"Chúng tôi đã ngắm bình minh từ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"temperate":{"definition":"Có chừng mực, vừa phải, điều độ.","example":"He kept a temperate pace on the hike.","exampleTranslation":"Anh ấy giữ một nhịp độ điều độ trong chuyến đi bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"temperature":{"definition":"Nhiệt độ.","example":"Please check your temperature before entering.","exampleTranslation":"Vui lòng kiểm tra nhiệt độ của bạn trước khi vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"thaw":{"definition":"Sự mạnh dạn lên; sự hết dè dặt lạnh lùng (trong thái độ).","example":"A thaw in his mood helped the talk.","exampleTranslation":"Một sự mạnh dạn lên trong tâm trạng của anh ấy đã giúp ích cho cuộc trò chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"tide":{"definition":"Dòng nước, dòng chảy, dòng.","example":"The tide of blood was visible on the shore.","exampleTranslation":"Dòng nước chảy xiết của máu có thể thấy trên bờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"topsoil":{"definition":"Tầng đất mặt; lớp đất cay.","example":"The rain washed away the topsoil from the slope.","exampleTranslation":"Cơn mưa đã cuốn trôi tầng đất mặt từ sườn dốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"tropic":{"definition":"Chí tuyến.","example":"The sun shines brightly at the tropic of Cancer.","exampleTranslation":"Mặt trời tỏa sáng rực rỡ tại chí tuyến Bắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"turbulent":{"definition":"Hỗn loạn, náo động.","example":"It is dangerous to sail in turbulent seas.","exampleTranslation":"Thật nguy hiểm khi đi thuyền trong những vùng biển hỗn loạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"underwater":{"definition":"Đặt dưới mặt nước, làm ở dưới mặt nước, để dùng ở dưới mặt nước.","example":"We watched the fish through an underwater camera.","exampleTranslation":"Chúng tôi đã xem những con cá qua một chiếc máy ảnh dùng dưới mặt nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"volcano":{"definition":"Núi lửa.","example":"The active volcano erupted with great force.","exampleTranslation":"Núi lửa đang hoạt động đã phun trào với sức mạnh lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"wave":{"definition":"Sóng, làn sóng ((nghĩa đen) & (nghĩa bóng)).","example":"A large wave hit the shore with great force.","exampleTranslation":"Một con sóng lớn đập vào bờ với sức mạnh lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"weather":{"definition":"Bản thông báo thời tiết (đăng trên báo).","example":"The weather report said it would rain later.","exampleTranslation":"Bản thông báo thời tiết nói rằng trời sẽ mưa sau đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"earth-science"},"winter":{"definition":"Mùa đông.","example":"It is already the winter season in many places.","exampleTranslation":"Hiện đã là mùa đông ở nhiều nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"earth-science"},"astronomer":{"definition":"Nhà khoa học nghiên cứu các thiên thể, không gian và những hiện tượng trong vũ trụ.","example":"The astronomer measured stellar movements to estimate the galaxy's rotation.","exampleTranslation":"Nhà thiên văn học đo chuyển động của các ngôi sao để ước tính sự quay của thiên hà.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"astronomical":{"definition":"Thuộc về thiên văn học hoặc các thiên thể trong vũ trụ.","example":"Astronomical observations revealed that the planet's atmosphere changes with seasonal sunlight.","exampleTranslation":"Các quan sát thiên văn cho thấy bầu khí quyển của hành tinh thay đổi theo ánh sáng mặt trời theo mùa.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"astronomy"},"astronomy":{"definition":"Ngành khoa học nghiên cứu các thiên thể, không gian và những hiện tượng trong vũ trụ.","example":"Astronomy combines precise observation with mathematical models to explain celestial motion.","exampleTranslation":"Thiên văn học kết hợp quan sát chính xác với các mô hình toán học để giải thích chuyển động của các thiên thể.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"cosmic":{"definition":"Thuộc về vũ trụ hoặc không gian ngoài Trái Đất.","example":"Scientists detected cosmic radiation while examining signals from the early universe.","exampleTranslation":"Các nhà khoa học phát hiện bức xạ vũ trụ khi nghiên cứu những tín hiệu từ vũ trụ sơ khai.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"astronomy"},"galaxy":{"definition":"Thiên hà, một hệ thống gồm các ngôi sao, khí và bụi liên kết bởi lực hấp dẫn.","example":"This galaxy contains billions of stars arranged around a dense central region.","exampleTranslation":"Thiên hà này chứa hàng tỷ ngôi sao được sắp xếp quanh một vùng trung tâm dày đặc.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"gravity":{"definition":"Lực hút khiến các vật thể bị kéo về phía nhau.","example":"Gravity keeps artificial satellites in stable orbits around Earth.","exampleTranslation":"Trọng lực giữ các vệ tinh nhân tạo trong những quỹ đạo ổn định quanh Trái Đất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"lunar":{"definition":"Thuộc về Mặt Trăng.","example":"Lunar samples revealed chemical changes caused by prolonged exposure to space.","exampleTranslation":"Các mẫu vật Mặt Trăng cho thấy những biến đổi hóa học do tiếp xúc lâu dài với không gian.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"astronomy"},"orbit":{"definition":"Quỹ đạo của một vật thể quanh một thiên thể khác.","example":"The spacecraft entered orbit around Mars after a carefully planned journey.","exampleTranslation":"Tàu vũ trụ đi vào quỹ đạo quanh Sao Hỏa sau một hành trình được lập kế hoạch cẩn thận.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"orbital":{"definition":"Thuộc về quỹ đạo hoặc chuyển động theo quỹ đạo.","example":"Orbital measurements helped scientists estimate the planet's mass accurately.","exampleTranslation":"Các phép đo quỹ đạo giúp các nhà khoa học ước tính chính xác khối lượng của hành tinh.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"astronomy"},"planet":{"definition":"Hành tinh, thiên thể quay quanh một ngôi sao và không tự phát sáng.","example":"Each planet follows a predictable path around its star.","exampleTranslation":"Mỗi hành tinh đi theo một quỹ đạo có thể dự đoán quanh ngôi sao của nó.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"planetary":{"definition":"Thuộc về hành tinh hoặc các hành tinh.","example":"Researchers use planetary data to compare the geological histories of worlds beyond Earth.","exampleTranslation":"Các nhà nghiên cứu sử dụng dữ liệu về các hành tinh để so sánh lịch sử địa chất của những thế giới ngoài Trái Đất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"astronomy"},"satellite":{"definition":"Vệ tinh tự nhiên hoặc nhân tạo quay quanh một hành tinh hay thiên thể khác.","example":"A satellite can measure atmospheric changes across remote regions more consistently than ground stations.","exampleTranslation":"Một vệ tinh có thể đo những thay đổi khí quyển ở các vùng xa xôi một cách ổn định hơn các trạm mặt đất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"spacecraft":{"definition":"Tàu hoặc thiết bị được thiết kế để di chuyển và hoạt động trong không gian.","example":"The spacecraft transmitted detailed images during its approach to Mars.","exampleTranslation":"Tàu vũ trụ đã truyền về những hình ảnh chi tiết trong quá trình tiếp cận Sao Hỏa.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"telescope":{"definition":"Thiết bị quang học dùng để quan sát các vật thể ở rất xa, đặc biệt là trong không gian.","example":"The telescope revealed faint galaxies that were invisible to earlier astronomical instruments.","exampleTranslation":"Kính thiên văn đã phát hiện những thiên hà mờ mà các thiết bị thiên văn trước đây không thể nhìn thấy.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"universe":{"definition":"Toàn bộ không gian, thời gian, vật chất và năng lượng tồn tại.","example":"Astronomers study the universe to understand how matter and energy evolved over time.","exampleTranslation":"Các nhà thiên văn học nghiên cứu vũ trụ để hiểu vật chất và năng lượng đã tiến hóa như thế nào theo thời gian.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"asteroid":{"definition":"Pháo hoa hình sao.","example":"The children watched the asteroid in the show.","exampleTranslation":"Những đứa trẻ đã xem pháo hoa hình sao trong buổi diễn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"astronaut":{"definition":"Phi hành gia, nhà du hành vũ trụ.","example":"The astronaut floated inside the quiet cabin.","exampleTranslation":"Phi hành gia đã trôi nổi bên trong cabin yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"comet":{"definition":"Sao chổi.","example":"A comet flashed across the night sky.","exampleTranslation":"Một sao chổi đã lóe sáng trên bầu trời đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"mercury":{"definition":"Sao Thuỷ.","example":"Mercury is the closest planet to the sun.","exampleTranslation":"Sao Thuỷ là hành tinh gần mặt trời nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"meteor":{"definition":"Sao sa, sao băng.","example":"A bright meteor crossed the night sky.","exampleTranslation":"Một ngôi sao băng rực rỡ đã băng qua bầu trời đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"meteorite":{"definition":"Vẫn thạch, đá trời.","example":"A meteorite landed in the field after sunset.","exampleTranslation":"Một viên vẫn thạch đã rơi xuống cánh đồng sau hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"moon":{"definition":"Mặt trăng.","example":"The moon looks very bright tonight.","exampleTranslation":"Mặt trăng trông rất sáng tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"orbiter":{"definition":"Người hay vật đi theo quỹ đạo.","example":"The orbiter kept circling the planet.","exampleTranslation":"Người hay vật đi theo quỹ đạo tiếp tục bay quanh hành tinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"rocket":{"definition":"Cải lông.","example":"She saw the rocket near the door.","exampleTranslation":"Cô ấy nhìn thấy con tên lửa gần cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"rover":{"definition":"Xe tự hành (trên Mặt Trăng, sao Hỏa...).","example":"The rover rolled slowly across the rocky field.","exampleTranslation":"Xe tự hành lăn chậm chạp qua cánh đồng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"skies":{"definition":"Động từ chia ở ngôi thứ ba số ít của sky","example":"The kite skies high in the wind.","exampleTranslation":"Con diều bay cao trên bầu trời trong gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"astronomy"},"space":{"definition":"Khoảng, chỗ: nội dung của một thể tích.","example":"That large sofa takes up too much space.","exampleTranslation":"Chiếc ghế xôfa lớn đó chiếm quá nhiều khoảng trống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"spaceport":{"definition":"Sân bay vũ trụ.","example":"The rocket was tested at the spaceport.","exampleTranslation":"Tên lửa đã được thử nghiệm tại sân bay vũ trụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"star":{"definition":"Sao, ngôi sao, tinh tú.","example":"The bright star shines in the night sky.","exampleTranslation":"Ngôi sao sáng chiếu trên bầu trời đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"astronomy"},"correlation":{"definition":"Mối tương quan hoặc mối liên hệ giữa sự thay đổi của hai biến số.","example":"The researchers observed a strong correlation between sleep duration and examination performance.","exampleTranslation":"Các nhà nghiên cứu quan sát thấy mối tương quan chặt chẽ giữa thời lượng ngủ và kết quả thi.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"methodological":{"definition":"Thuộc về phương pháp luận hoặc cách thức tiến hành nghiên cứu.","example":"The report discusses methodological limitations arising from nonrandom sampling and inconsistent measurement procedures.","exampleTranslation":"Báo cáo thảo luận những hạn chế về phương pháp luận phát sinh từ việc lấy mẫu không ngẫu nhiên và các quy trình đo lường không nhất quán.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"methodology":{"definition":"Hệ thống các nguyên tắc và phương pháp được sử dụng để tiến hành nghiên cứu.","example":"A transparent methodology enables readers to evaluate how data were collected, analysed, and interpreted.","exampleTranslation":"Một phương pháp luận minh bạch cho phép người đọc đánh giá dữ liệu đã được thu thập, phân tích và diễn giải như thế nào.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"qualitative":{"definition":"Liên quan đến đặc điểm, ý nghĩa và trải nghiệm thay vì số liệu đo lường.","example":"Qualitative interviews revealed how residents understood risks that numerical surveys had overlooked.","exampleTranslation":"Các cuộc phỏng vấn định tính cho thấy cư dân hiểu những rủi ro mà các khảo sát bằng số liệu đã bỏ sót như thế nào.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"quantitative":{"definition":"Liên quan đến việc đo lường hoặc phân tích bằng số lượng và số liệu.","example":"Quantitative analysis showed that income predicted access to reliable public transport.","exampleTranslation":"Phân tích định lượng cho thấy thu nhập dự đoán khả năng tiếp cận phương tiện giao thông công cộng đáng tin cậy.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"sample":{"definition":"Một nhóm nhỏ được chọn để đại diện cho một tổng thể trong nghiên cứu.","example":"The researchers selected a representative sample of households from five coastal communities.","exampleTranslation":"Các nhà nghiên cứu đã chọn một mẫu đại diện gồm các hộ gia đình từ năm cộng đồng ven biển.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"statistic":{"definition":"Một con số biểu thị đặc điểm của dữ liệu hoặc kết quả thống kê.","example":"One statistic, the median response time, exposed substantial differences between the two hospitals.","exampleTranslation":"Một chỉ số thống kê, thời gian phản hồi trung vị, đã cho thấy những khác biệt đáng kể giữa hai bệnh viện.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"statistical":{"definition":"Liên quan đến việc thu thập, phân tích hoặc diễn giải số liệu.","example":"Statistical models controlled for age, income, and education when estimating treatment effects.","exampleTranslation":"Các mô hình thống kê đã kiểm soát độ tuổi, thu nhập và trình độ học vấn khi ước tính tác động của phương pháp điều trị.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"statistics":{"definition":"Các số liệu được thu thập và phân tích để mô tả hoặc so sánh hiện tượng.","example":"Researchers used statistics to compare health outcomes across the two treatment groups.","exampleTranslation":"Các nhà nghiên cứu sử dụng số liệu thống kê để so sánh kết quả sức khỏe giữa hai nhóm điều trị.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"survey":{"definition":"Cuộc khảo sát có hệ thống nhằm thu thập thông tin từ một nhóm người hoặc mẫu đại diện.","example":"The survey collected responses from 1,200 households about access to clean water.","exampleTranslation":"Cuộc khảo sát thu thập câu trả lời từ 1.200 hộ gia đình về khả năng tiếp cận nước sạch.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"variable":{"definition":"Biến số; một yếu tố có thể thay đổi và được đo lường trong nghiên cứu.","example":"Researchers treated household income as a variable influencing participation in higher education.","exampleTranslation":"Các nhà nghiên cứu xem thu nhập hộ gia đình là một biến số ảnh hưởng đến việc tham gia giáo dục đại học.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"logic":{"definition":"Các nguyên tắc và cách thức suy luận hợp lệ, chặt chẽ.","example":"The argument's logic depends on distinguishing correlation from causation.","exampleTranslation":"Logic của lập luận này phụ thuộc vào việc phân biệt mối tương quan với quan hệ nhân quả.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"logical":{"definition":"Hợp lý và phù hợp với các nguyên tắc suy luận chặt chẽ.","example":"A logical interpretation of the evidence requires consideration of alternative explanations.","exampleTranslation":"Một cách diễn giải hợp lý về bằng chứng đòi hỏi phải xem xét các cách giải thích thay thế.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"moral":{"definition":"Liên quan đến việc phân biệt đúng và sai hoặc đến các nguyên tắc đạo đức.","example":"The policy raises moral questions about fairness, responsibility, and access to essential services.","exampleTranslation":"Chính sách này đặt ra những câu hỏi đạo đức về sự công bằng, trách nhiệm và khả năng tiếp cận các dịch vụ thiết yếu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"morally":{"definition":"Về phương diện đạo đức; theo cách phù hợp hoặc không phù hợp với các nguyên tắc đạo đức.","example":"The committee judged the proposed experiment morally acceptable after reviewing its potential risks.","exampleTranslation":"Ủy ban đánh giá thí nghiệm được đề xuất là chấp nhận được về mặt đạo đức sau khi xem xét những rủi ro tiềm ẩn của nó.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"philosopher":{"definition":"Nhà triết học; người nghiên cứu và suy luận về những vấn đề cơ bản của tri thức, đạo đức và tồn tại.","example":"The philosopher argued that justice requires institutions to protect the vulnerable.","exampleTranslation":"Nhà triết học lập luận rằng công lý đòi hỏi các thể chế phải bảo vệ những người dễ bị tổn thương.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"philosophical":{"definition":"Thuộc về triết học hoặc thể hiện cách suy nghĩ sâu sắc, có hệ thống về các vấn đề tư tưởng và đạo đức.","example":"Her philosophical discussion distinguishes moral responsibility from legal accountability.","exampleTranslation":"Phần thảo luận triết học của cô phân biệt trách nhiệm đạo đức với trách nhiệm pháp lý.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"philosophy":{"definition":"Triết học; hệ thống tư tưởng về bản chất của tri thức, thực tại, đạo đức và con người.","example":"His philosophy connects personal freedom with responsibility toward the wider community.","exampleTranslation":"Triết lý của ông gắn kết tự do cá nhân với trách nhiệm đối với cộng đồng rộng lớn hơn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"rational":{"definition":"Dựa trên lý trí, lập luận và bằng chứng thay vì cảm xúc hoặc niềm tin thiếu căn cứ.","example":"A rational explanation must account for evidence that challenges the initial hypothesis.","exampleTranslation":"Một lời giải thích hợp lý phải tính đến những bằng chứng thách thức giả thuyết ban đầu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"rationalist":{"definition":"Người theo chủ nghĩa duy lý, đề cao lý trí và lập luận logic trong việc hình thành tri thức.","example":"The rationalist rejected tradition when it conflicted with clear logical principles.","exampleTranslation":"Người theo chủ nghĩa duy lý bác bỏ truyền thống khi truyền thống đó mâu thuẫn với các nguyên tắc logic rõ ràng.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"virtue":{"definition":"Đức tính tốt hoặc phẩm chất đạo đức được coi là đáng quý và cần được rèn luyện.","example":"The study argues that patience is a virtue essential to effective scientific collaboration.","exampleTranslation":"Nghiên cứu cho rằng kiên nhẫn là một đức tính thiết yếu đối với sự hợp tác khoa học hiệu quả.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"abstract":{"definition":"Trừu tượng.","example":"The idea was too abstract for young learners.","exampleTranslation":"Ý tưởng đó quá trừu tượng đối với những người học trẻ tuổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"analogy":{"definition":"Sự tương tự, sự giống nhau.","example":"He used an analogy to explain the complex idea.","exampleTranslation":"Anh ấy đã sử dụng một sự tương tự để giải thích ý tưởng phức tạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"analyse":{"definition":"Giải tích.","example":"We analyse the data before making a choice.","exampleTranslation":"Chúng tôi phân tích dữ liệu trước khi đưa ra lựa chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"analysis":{"definition":"Sự phân tích.","example":"Her analysis was clear and useful.","exampleTranslation":"Sự phân tích của cô ấy rõ ràng và hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"analytical":{"definition":"Dùng phép phân tích.","example":"Her analytical mind solved the problem fast.","exampleTranslation":"Tư duy phân tích của cô ấy đã giải quyết vấn đề một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"analyze":{"definition":"Phân tích.","example":"We analyze the data every Friday.","exampleTranslation":"Chúng tôi phân tích dữ liệu vào mỗi thứ Sáu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"annotate":{"definition":"Chú giải, chú thích.","example":"Please annotate the page with useful notes.","exampleTranslation":"Vui lòng chú giải trang sách với những ghi chú hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"anticipate":{"definition":"Làm cho nhanh, làm cho chóng, thúc đẩy.","example":"The company will anticipate a large profit this year.","exampleTranslation":"Công ty sẽ thúc đẩy một khoản lợi nhuận lớn trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"anticipation":{"definition":"Sự dùng trước, sự hưởng trước.","example":"We bought gifts in anticipation of the party.","exampleTranslation":"Chúng tôi đã mua quà trong sự hưởng trước bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"approach":{"definition":"Sự đến gần, sự lại gần.","example":"This mountain is very easy of approach for hikers.","exampleTranslation":"Ngọn núi này rất dễ cho sự lại gần đối với những người đi bộ đường dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"arguably":{"definition":"Người ta có thể cho rằng.","example":"He moved arguably through the crowd.","exampleTranslation":"Người ta có thể cho rằng anh ấy di chuyển qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"argue":{"definition":"Tranh cãi, tranh luận.","example":"They began to argue about the new rules.","exampleTranslation":"Họ bắt đầu tranh luận về các quy định mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"argument":{"definition":"Lý lẽ.","example":"He presented a strong argument for the new policy.","exampleTranslation":"Anh ấy trình bày một lý lẽ mạnh mẽ cho chính sách mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"aspect":{"definition":"Vẻ, bề ngoài; diện mạo.","example":"The garden has a gentle aspect and many trees.","exampleTranslation":"Khu vườn có một vẻ ngoài dịu dàng và nhiều cây cối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"assert":{"definition":"Đòi (quyền lợi... ).","example":"You must assert your rights in this situation.","exampleTranslation":"Bạn phải đòi quyền lợi của mình trong tình huống này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"assume":{"definition":"Mang, khoác, có, lấy (cái vẻ, tính chất... ).","example":"He will assume the name of his father.","exampleTranslation":"Anh ấy sẽ lấy tên của cha mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"assumption":{"definition":"Sự nắm lấy, sự chiếm lấy.","example":"His assumption of power surprised everyone in the small town.","exampleTranslation":"Sự nắm lấy quyền lực của anh ấy làm mọi người trong thị trấn nhỏ ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"attributable":{"definition":"Có thể quy cho.","example":"The delay is attributable to heavy rain.","exampleTranslation":"Sự chậm trễ có thể quy cho cơn mưa lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"attribute":{"definition":"Thuộc tính.","example":"Honesty is a key attribute of a leader.","exampleTranslation":"Trung thực là một thuộc tính quan trọng của một người lãnh đạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"authoritative":{"definition":"Có căn cứ đích xác, có am hiểu tường tận, có thể tin được; có thẩm quyền.","example":"She gave an authoritative report on the new project.","exampleTranslation":"Cô ấy đã đưa ra một báo cáo có thẩm quyền về dự án mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"basis":{"definition":"Căn cứ (quân sự).","example":"The soldiers returned to the basis at dawn.","exampleTranslation":"Những người lính trở về căn cứ lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"benchmark":{"definition":"Tiêu chuẩn, cơ chuẩn; điểm chuẩn, điểm mốc; kiểm chuẩn.","example":"This test score is the benchmark for success.","exampleTranslation":"Điểm số bài kiểm tra này là tiêu chuẩn cho sự thành công.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"bombard":{"definition":"Bắn phá, ném bom, oanh tạc.","example":"The coach would bombard the players with questions.","exampleTranslation":"Huấn luyện viên thường xuyên bắn phá các cầu thủ bằng những câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"breadth":{"definition":"Sự rộng rãi, sự phóng khoáng (quan điểm, tư tưởng...).","example":"We need to broaden our breadth of view.","exampleTranslation":"Chúng ta cần mở rộng sự phóng khoáng trong tầm nhìn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"brief":{"definition":"Ngắn, vắn tắt, gọn.","example":"Please send me a brief note by tomorrow.","exampleTranslation":"Vui lòng gửi cho tôi một bản ghi chú ngắn vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"briefly":{"definition":"Ngắn gọn, vắn tắt, tóm tắt.","example":"She answered briefly and smiled.","exampleTranslation":"Cô ấy đã trả lời một cách vắn tắt rồi mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"calculate":{"definition":"Tính trước, suy tính, dự tính.","example":"She calculate the risk before starting the trip.","exampleTranslation":"Cô ấy suy tính rủi ro trước khi bắt đầu chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"calculation":{"definition":"Kết quả tính toán.","example":"Her calculation was correct on the first try.","exampleTranslation":"Kết quả tính toán của cô ấy đúng trong lần thử đầu tiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"capability":{"definition":"Khả năng, năng lực.","example":"The capability was important at work.","exampleTranslation":"Khả năng đã rất quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"capable":{"definition":"Có thể, có khả năng, dám, cả gan.","example":"You should show your teacher what you are capable of.","exampleTranslation":"Bạn nên cho giáo viên thấy bạn có khả năng như thế nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"categorize":{"definition":"Chia loại, phân loại.","example":"We categorize the books by topic.","exampleTranslation":"Chúng tôi phân loại các cuốn sách theo chủ đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"category":{"definition":"Hạng, thể loại, loại.","example":"Books are organized by category in this library.","exampleTranslation":"Sách được tổ chức theo hạng trong thư viện này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"causal":{"definition":"Quan hệ nhân quả.","example":"Scientists studied the causal link between the two events.","exampleTranslation":"Các nhà khoa học đã nghiên cứu mối quan hệ nhân quả giữa hai sự kiện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"chart":{"definition":"Đồ thị, biểu đồ.","example":"Please check the weather chart before we leave.","exampleTranslation":"Vui lòng kiểm tra biểu đồ thời tiết trước khi chúng ta rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"chronologically":{"definition":"Theo niên đại, theo thứ tự thời gian.","example":"The team finished chronologically and left.","exampleTranslation":"Cả đội đã hoàn thành theo thứ tự thời gian và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"cite":{"definition":"Dẫn, trích dẫn.","example":"You must cite your sources in this essay.","exampleTranslation":"Bạn phải dẫn các nguồn của mình trong bài tiểu luận này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"clarify":{"definition":"Lọc, gạn.","example":"Please clarify the rules before the game starts.","exampleTranslation":"Vui lòng làm rõ các quy tắc trước khi trò chơi bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"clarity":{"definition":"sự rõ ràng; tính minh bạch","example":"She dreamed, with great clarity, that she had seen her own death.","exampleTranslation":"Cô ấy đã mơ thấy cái chết của chính mình với sự rõ ràng tuyệt đối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"academic-methods"},"classification":{"definition":"Sự phân loại.","example":"The teacher explained the classification of animals.","exampleTranslation":"Giáo viên đã giải thích sự phân loại các loài động vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"collate":{"definition":"Đối chiếu, so sánh.","example":"Please collate the data before you write the report.","exampleTranslation":"Vui lòng đối chiếu dữ liệu trước khi bạn viết báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"comparable":{"definition":"Có thể so sánh được.","example":"Their scores are comparable across both tests.","exampleTranslation":"Điểm số của họ có thể so sánh được trên cả hai bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"comparative":{"definition":"So sánh.","example":"They used the comparative method of studying history.","exampleTranslation":"Họ đã sử dụng phương pháp so sánh để nghiên cứu lịch sử.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"comparatively":{"definition":"tương đối; so sánh với","example":"The cost of living here is comparatively low, though not the lowest.","exampleTranslation":"Chi phí sinh hoạt ở đây tương đối thấp, mặc dù không phải là thấp nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"compare":{"definition":"So, đối chiếu.","example":"Please compare the original with the new copy.","exampleTranslation":"Vui lòng so bản gốc với bản sao mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"comparison":{"definition":"Sự so sánh.","example":"This new model does not bear comparison with it.","exampleTranslation":"Mô hình mới này không thể mang ra so sánh với mô hình cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"compilation":{"definition":"Sự biên soạn, sự sưu tập tài liệu.","example":"The book is a compilation of short stories.","exampleTranslation":"Cuốn sách là một sự biên soạn các truyện ngắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"compile":{"definition":"Biên soạn, sưu tập tài liệu.","example":"They compile a list of useful words.","exampleTranslation":"Họ biên soạn một danh sách các từ hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"concept":{"definition":"Khái niệm, quan niệm.","example":"The concept was easy for the class to understand.","exampleTranslation":"Khái niệm này rất dễ hiểu đối với cả lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"conclude":{"definition":"Kết thúc, chấm dứt ((công việc... ); bế mạc (phiên họp).","example":"They will conclude the meeting at five o'clock sharp.","exampleTranslation":"Họ sẽ kết thúc cuộc họp vào đúng năm giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"conclusion":{"definition":"sự kết thúc, sự chấm dứt; phần cuối","example":"We reached the conclusion at sunset.","exampleTranslation":"Chúng tôi đã đi đến phần kết thúc vào lúc hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"conclusively":{"definition":"Chắc chắn, thuyết phục.","example":"I read the note conclusively.","exampleTranslation":"Tôi đọc tờ ghi chú một cách chắc chắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"confirm":{"definition":"Làm cho (ai) nhiễm sâu (một thói quen, một nếp nghĩ... ).","example":"Work can confirm someone in his chain-smoking.","exampleTranslation":"Công việc có thể làm cho ai đó nhiễm sâu vào thói quen hút thuốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"conjecture":{"definition":"Sự phỏng đoán, sự ước đoán.","example":"His conjecture about the missing keys was correct.","exampleTranslation":"Sự phỏng đoán của anh ấy về những chiếc chìa khóa bị mất là chính xác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"consecutive":{"definition":"Liên tục, liên tiếp, tiếp liền nhau.","example":"She won the race for three consecutive days.","exampleTranslation":"Cô ấy đã thắng cuộc đua trong ba ngày liên tiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"consequence":{"definition":"Hậu quả, kết quả.","example":"Every action has a consequence that we must face.","exampleTranslation":"Mỗi hành động đều có một hậu quả mà chúng ta phải đối mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"consequently":{"definition":"vì vậy; do đó; kết quả là","example":"He did not wake up early in the morning. Consequently, he was late to work.","exampleTranslation":"Anh ấy đã không thức dậy sớm vào buổi sáng. Kết quả là, anh ấy đã đi làm muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"consider":{"definition":"Cân nhắc, xem xét, suy xét, suy nghĩ.","example":"Please consider the price before you buy it.","exampleTranslation":"Vui lòng cân nhắc giá cả trước khi bạn mua nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"consideration":{"definition":"Sự cân nhắc, sự suy xét, sự nghiên cứu, sự suy nghĩ.","example":"Your proposal is currently under consideration by the board.","exampleTranslation":"Đề xuất của bạn hiện đang được xem xét bởi hội đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"consistent":{"definition":"Phù hợp, thích hợp; nhất quán với.","example":"Her actions are always consistent with her words.","exampleTranslation":"Hành động của cô ấy luôn phù hợp với lời nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"consistently":{"definition":"nhất quán; đều đặn","example":"Her work was consistently careful and complete.","exampleTranslation":"Công việc của cô ấy luôn nhất quán và cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"contradict":{"definition":"Cãi lại, phủ nhận.","example":"Please do not contradict your mother's advice.","exampleTranslation":"Vui lòng không cãi lại lời khuyên của mẹ bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"contradictory":{"definition":"Mâu thuẫn, trái ngược.","example":"They gave contradictory statements to the local police.","exampleTranslation":"Họ đã đưa ra các tuyên bố mâu thuẫn cho cảnh sát địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"contrast":{"definition":"sự tương phản, sự trái ngược (giữa)","example":"The contrast between day and night is clear.","exampleTranslation":"Sự tương phản giữa ngày và đêm là rất rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"correlate":{"definition":"Thể tương liên, yếu tố tương liên.","example":"Price and demand are a correlate pair.","exampleTranslation":"Giá cả và nhu cầu là một cặp tương liên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"count":{"definition":"Sự đếm; sự tính.","example":"The final count showed that we won the game.","exampleTranslation":"Lần đếm cuối cùng cho thấy chúng tôi đã thắng trận đấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"credibility":{"definition":"Sự tín nhiệm; sự đáng tin.","example":"His honesty helped build his credibility with us.","exampleTranslation":"Sự trung thực của anh ấy đã giúp xây dựng sự tín nhiệm với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"criteria":{"definition":"Tiêu chuẩn, chỉ tiêu.","example":"We used clear criteria to choose a winner.","exampleTranslation":"Chúng tôi đã sử dụng các chỉ tiêu rõ ràng để chọn người chiến thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"critical":{"definition":"Hay chỉ trích, hay chê bai; có ý kiến chống lại; khó tính, khó chiều.","example":"He is critical and never likes the food.","exampleTranslation":"Anh ấy rất khó tính và không bao giờ thích món ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"criticise":{"definition":"Phê bình, phê phán, bình phẩm, chỉ trích.","example":"Teachers should criticise the work kindly and clearly.","exampleTranslation":"Giáo viên nên phê bình công việc một cách tử tế và rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"Alternate spelling: criticize."},"criticism":{"definition":"Sự phê bình, sự phê phán, sự bình phẩm, sự chỉ trích.","example":"His criticism helped me improve.","exampleTranslation":"Sự phê bình của anh ấy đã giúp tôi tiến bộ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"criticize":{"definition":"Phê bình, phê phán, bình phẩm, chỉ trích.","example":"They criticize the plan at every meeting.","exampleTranslation":"Họ chỉ trích kế hoạch tại mỗi cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"British spelling: criticise."},"critique":{"definition":"Nghệ thuật phê bình.","example":"He studied the art of critique for years.","exampleTranslation":"Anh ấy đã nghiên cứu nghệ thuật phê bình trong nhiều năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"crucial":{"definition":"Quyết định; cốt yếu, chủ yếu.","example":"The first step is crucial for our success.","exampleTranslation":"Bước đầu tiên là quyết định cho sự thành công của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"crucially":{"definition":"Quan trọng, chủ yếu.","example":"He moved crucially through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách quan trọng qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"cumulative":{"definition":"Tích lũy, dồn lại, chồng chất mãi lên.","example":"The cumulative evidence proves his guilt beyond doubt.","exampleTranslation":"Bằng chứng tích lũy chứng minh tội lỗi của anh ấy không còn nghi ngờ gì nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"cumulatively":{"definition":"Tích tụ, lũy tích.","example":"She spoke cumulatively during the meeting.","exampleTranslation":"Cô ấy đã nói một cách tích tụ trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"debate":{"definition":"Tranh luận, tranh cãi, bàn cãi (một vấn đề... ).","example":"They debate the best way to save money.","exampleTranslation":"Họ tranh luận cách tốt nhất để tiết kiệm tiền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"deduce":{"definition":"Suy ra, luận ra, suy luận, suy diễn.","example":"From the clues, we can deduce the answer.","exampleTranslation":"Từ các manh mối, chúng ta có thể suy luận ra câu trả lời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"deduction":{"definition":"Điều suy luận.","example":"His deduction was that the key was lost.","exampleTranslation":"Điều suy luận của anh ấy là chìa khóa đã bị mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"delve":{"definition":"Chỗ trũng, chỗ lõm sâu xuống, hốc.","example":"They found a small delve in the hill.","exampleTranslation":"Họ tìm thấy một chỗ trũng nhỏ trên đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"demonstrate":{"definition":"Biểu tình, biểu tình tuần hành, biểu dương lực lượng.","example":"They will demonstrate in the city center tomorrow.","exampleTranslation":"Họ sẽ biểu tình ở trung tâm thành phố vào ngày mai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"demonstration":{"definition":"Sự thể hiện, sự biểu hiện.","example":"She gave a demonstration of her new dance moves.","exampleTranslation":"Cô ấy đã thể hiện một sự biểu hiện về các bước nhảy mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"detail":{"definition":"Chi tiết (máy).","example":"The report included every detail of the trip.","exampleTranslation":"Báo cáo bao gồm mọi chi tiết của chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"determine":{"definition":"Định, xác định, định rõ.","example":"We must determine the meaning of these words.","exampleTranslation":"Chúng ta phải xác định ý nghĩa của những từ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"diagram":{"definition":"Biểu đồ.","example":"The diagram helped explain the idea.","exampleTranslation":"Biểu đồ đã giúp giải thích ý tưởng đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"differentiate":{"definition":"Phân biệt.","example":"Can you differentiate between these two colors?","exampleTranslation":"Bạn có thể phân biệt giữa hai màu sắc này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"discrepancy":{"definition":"Sự khác nhau, sự không nhất quán, sự không thống nhất, sự trái ngược nhau (của một câu chuyện... ).","example":"The records show a discrepancy in the totals.","exampleTranslation":"Các hồ sơ cho thấy sự không thống nhất trong các tổng số.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"distinguish":{"definition":"Phân biệt.","example":"Can you distinguish between these two similar colors?","exampleTranslation":"Bạn có thể phân biệt giữa hai màu sắc tương tự này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"divider":{"definition":"Người chia.","example":"She worked as a divider in the store.","exampleTranslation":"Cô ấy làm việc như một người chia tại cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"emulation":{"definition":"Sự ganh đua, cạnh tranh.","example":"There is strong emulation between the two teams.","exampleTranslation":"Có sự cạnh tranh mạnh mẽ giữa hai đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"equate":{"definition":"Đặt thành phương trình.","example":"The teacher asked us to equate the two expressions.","exampleTranslation":"Giáo viên yêu cầu chúng tôi đặt thành phương trình hai biểu thức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"equation":{"definition":"Lượng bù sai.","example":"The teacher showed the equation of the error.","exampleTranslation":"Giáo viên cho thấy lượng bù sai của lỗi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"equivalent":{"definition":"tương đương; ngang bằng","example":"Dolphins have very large brains, roughly equivalent to the size of a human brain.","exampleTranslation":"Cá heo có bộ não rất lớn, tương đương với kích thước của bộ não người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"academic-methods"},"erroneous":{"definition":"Sai lầm, sai sót; không đúng.","example":"The report was erroneous and needed correction.","exampleTranslation":"Bản báo cáo sai lầm và cần phải chỉnh sửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"error":{"definition":"Sự sai lầm, sự sai sót, lỗi; ý kiến sai lầm; tình trạng sai lầm.","example":"Please double check your work to avoid any error.","exampleTranslation":"Vui lòng kiểm tra lại công việc của bạn để tránh bất kỳ sai sót nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"evaluate":{"definition":"Ước lượng.","example":"We evaluate the results before the meeting.","exampleTranslation":"Chúng tôi ước lượng các kết quả trước cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"evaluation":{"definition":"Sự định giá.","example":"We asked for an evaluation of the old house.","exampleTranslation":"Chúng tôi đã yêu cầu một sự định giá ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"evident":{"definition":"Hiển nhiên, rõ rệt.","example":"It is evident that she practiced a lot.","exampleTranslation":"Hiển nhiên là cô ấy đã luyện tập rất nhiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"exemplify":{"definition":"Minh hoạ bằng thí dụ; làm thí dụ cho.","example":"These results exemplify our hard work this month.","exampleTranslation":"Những kết quả này minh hoạ cho công việc chăm chỉ của chúng tôi tháng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"extract":{"definition":"Đoạn trích.","example":"I read a short extract from the book.","exampleTranslation":"Tôi đã đọc một đoạn trích ngắn từ cuốn sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"factor":{"definition":"Nhân tố.","example":"The human factor is important in every project.","exampleTranslation":"Nhân tố con người là quan trọng trong mọi dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"factual":{"definition":"Sự thực; căn cứ trên sự thực; thực sự, có thật.","example":"The report gave a factual account of the accident.","exampleTranslation":"Báo cáo đã đưa ra một tài khoản có căn cứ trên sự thực về vụ tai nạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"falsehood":{"definition":"Sự sai lầm; điều sai lầm, thuyết sai lầm, điều tin tưởng sai lầm, ý nghĩ sai lầm.","example":"The report was based on falsehood.","exampleTranslation":"Báo cáo được dựa trên sự sai lầm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"falsely":{"definition":"Sai lầm.","example":"The team finished falsely and left.","exampleTranslation":"Cả nhóm đã kết thúc một cách sai lầm và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"fault":{"definition":"Tội lỗi (trách nhiệm về một sai lầm).","example":"It was my fault that we missed the train.","exampleTranslation":"Đó là tội lỗi của tôi khi chúng tôi lỡ chuyến tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"faulty":{"definition":"Có thiếu sót, mắc khuyết điểm.","example":"The faulty option was chosen.","exampleTranslation":"Tùy chọn có thiếu sót đã được chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"feasible":{"definition":"Khả thi, có thể thực hành được, có thể thực hiện được, có thể làm được.","example":"Is it feasible to finish this project today?","exampleTranslation":"Việc hoàn thành dự án này hôm nay có khả thi không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"flaw":{"definition":"Thiếu sót, sai lầm.","example":"There is a small flaw in this new design.","exampleTranslation":"Có một thiếu sót nhỏ trong thiết kế mới này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"focus":{"definition":"Tiêu điểm.","example":"The camera lost focus in the dark room.","exampleTranslation":"Máy ảnh đã mất tiêu điểm trong phòng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"foresee":{"definition":"Nhìn thấy trước, dự kiến trước, đoán trước, biết trước.","example":"I foresee a busy day ahead.","exampleTranslation":"Tôi nhìn thấy trước một ngày bận rộn phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"foreseeable":{"definition":"Thấy trước được, dự đoán được.","example":"Rain is foreseeable during the wet season.","exampleTranslation":"Mưa có thể thấy trước được trong mùa ẩm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"foreseen":{"definition":"Nhìn thấy trước, dự kiến trước, đoán trước, biết trước.","example":"The result had been foreseen by everyone.","exampleTranslation":"Kết quả đã được nhìn thấy trước bởi mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"formulate":{"definition":"Trình bày rõ ràng chính xác, phát biểu có hệ thống (ý kiến... ).","example":"She tried to formulate her idea clearly.","exampleTranslation":"Cô ấy đã cố gắng trình bày rõ ràng ý tưởng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"fragment":{"definition":"Khúc, đoạn, mấu (của cái gì không liên tục hay chưa hoàn thành).","example":"The story was only a fragment of truth.","exampleTranslation":"Câu chuyện chỉ là một khúc của sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"fundamental":{"definition":"Cơ bản, cơ sở, chủ yếu.","example":"We must follow the fundamental rules of the school.","exampleTranslation":"Chúng ta phải tuân theo các quy tắc cơ bản của trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"fundamentally":{"definition":"về cơ bản","example":"Their ideas are fundamentally different from each other.","exampleTranslation":"Ý tưởng của họ khác nhau về cơ bản so với nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"glean":{"definition":"Lượm lặt.","example":"I managed to glean news from the locals.","exampleTranslation":"Tôi đã cố gắng lượm lặt tin tức từ những người dân địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"graph":{"definition":"Đồ thị.","example":"The graph shows sales rising each month.","exampleTranslation":"Đồ thị cho thấy doanh số bán hàng tăng lên mỗi tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"grasp":{"definition":"Sự nắm được, sự hiểu thấu.","example":"You must have a thorough grasp of math.","exampleTranslation":"Bạn phải nắm được sự hiểu thấu triệt để về toán học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"groundwork":{"definition":"Nền đường.","example":"They laid groundwork for the new path.","exampleTranslation":"Họ đã đặt nền đường cho lối đi mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"guess":{"definition":"Sự đoán, sự ước chừng.","example":"Can you make a lucky guess about the winner?","exampleTranslation":"Bạn có thể đoán một cách may mắn về người chiến thắng không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"heed":{"definition":"Sự chú ý, sự lưu ý, sự để ý.","example":"You must pay heed to the safety signs.","exampleTranslation":"Bạn phải chú ý đến các biển báo an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"illogical":{"definition":"Không lôgíc, phi lý.","example":"That is an illogical argument for a scientist.","exampleTranslation":"Đó là một lập luận phi lý đối với một nhà khoa học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"illuminate":{"definition":"Treo đèn kết hoa.","example":"They will illuminate the street with bright lights.","exampleTranslation":"Họ sẽ treo đèn kết hoa con phố bằng những ánh sáng rực rỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"illustrate":{"definition":"In tranh ảnh (trên báo chí, sách).","example":"They illustrate the book with bright drawings.","exampleTranslation":"Họ minh họa cuốn sách bằng những bức vẽ rực rỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"implication":{"definition":"Quan hệ mật thiết.","example":"There is a close implication between the two ideas.","exampleTranslation":"Có một quan hệ mật thiết giữa hai ý tưởng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"implicit":{"definition":"Ngấm, ngấm ngầm; ẩn tàng.","example":"There was an implicit threat in his cold voice.","exampleTranslation":"Có một sự đe dọa ngấm ngầm trong giọng nói lạnh lùng của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"imply":{"definition":"Ý nói; ngụ ý; bao hàm ý.","example":"do you imply that I am not telling the truth?","exampleTranslation":"Bạn có ý rằng tôi đang không nói thật phải không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"imprecise":{"definition":"Không chính xác, không đúng.","example":"The map was imprecise and hard to read.","exampleTranslation":"Tấm bản đồ không chính xác và rất khó đọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"inaccuracy":{"definition":"Sự không đúng, sự sai; tính không đúng.","example":"There was an inaccuracy in the final count.","exampleTranslation":"Có một sự không chính xác trong lần đếm cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"inaccurate":{"definition":"Không đúng, sai, trật.","example":"The map was inaccurate and confusing.","exampleTranslation":"Tấm bản đồ không đúng và gây bối rối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"inconsistency":{"definition":"Sự mâu thuẫn, sự trái nhau; sự không trước sau như một.","example":"The inconsistency in his story made us doubt him.","exampleTranslation":"Sự mâu thuẫn trong câu chuyện của anh ấy làm chúng tôi nghi ngờ anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"inconsistent":{"definition":"Mâu thuẫn nhau, trái nhau; không trước sau như một; mất cân đối.","example":"His words were inconsistent with his actual deeds.","exampleTranslation":"Lời nói của anh ấy mâu thuẫn với những việc làm thực tế của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"inconsistently":{"definition":"Đầy mâu thuẫn, không nhất quán, không trước sau như một, tiền hậu bất nhất.","example":"She spoke inconsistently during the meeting.","exampleTranslation":"Cô ấy đã phát biểu một cách đầy mâu thuẫn trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"incorrect":{"definition":"Không đúng, không chỉnh, sai.","example":"His voice stayed incorrect all night.","exampleTranslation":"Giọng của anh ấy vẫn không đúng suốt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"indisputable":{"definition":"Không thể cãi, không thể bàn cãi, không thể tranh luận.","example":"It is indisputable that water is wet.","exampleTranslation":"Không thể bàn cãi rằng nước là ướt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"indisputably":{"definition":"Hiển nhiên, không thể bàn cãi, không thể phủ nhận.","example":"They worked indisputably all day.","exampleTranslation":"Họ đã làm việc một cách hiển nhiên suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"infer":{"definition":"Suy ra, luận ra; kết luận, đưa đến kết luận.","example":"We can infer the answer from the clues.","exampleTranslation":"Chúng ta có thể suy ra câu trả lời từ các đầu mối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"inquire":{"definition":"+ into) điều tra, thẩm tra.","example":"The police will inquire into the cause of the accident.","exampleTranslation":"Cảnh sát sẽ điều tra nguyên nhân vụ tai nạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"insight":{"definition":"tuệ quán.","example":"He showed insight during the discussion.","exampleTranslation":"Anh ấy đã thể hiện tuệ quán trong suốt cuộc thảo luận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"insist":{"definition":"Cứ nhất định; khăng khăng đòi, cố nài.","example":"Please insist on clear instructions.","exampleTranslation":"Xin hãy khăng khăng đòi các hướng dẫn rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"insistence":{"definition":"Tính chất cứ nhất định; tính chất khăng khăng, tính chất nài nỉ.","example":"The teacher's insistence on homework was clear.","exampleTranslation":"Sự khăng khăng của giáo viên về bài tập về nhà là rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"instance":{"definition":"Thí dụ, ví dụ (chứng minh, minh hoạ).","example":"You can see that for instance in his work.","exampleTranslation":"Bạn có thể thấy ví dụ đó trong công việc của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"integral":{"definition":"Tích phân.","example":"We learned how to find the integral of the function.","exampleTranslation":"Chúng tôi đã học cách tìm tích phân của hàm số.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"interdisciplinary":{"definition":"Gồm nhiều ngành học thuật.","example":"They attended an interdisciplinary seminar on climate change.","exampleTranslation":"Họ đã tham dự một hội thảo gồm nhiều ngành học thuật về biến đổi khí hậu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"intrinsic":{"definition":"Bản chất, thực chất; bên trong.","example":"We must consider the intrinsic value of this gift.","exampleTranslation":"Chúng ta phải xem xét bản chất bên trong của món quà này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"intrinsically":{"definition":"Về bản chất, thực chất.","example":"She spoke intrinsically during the meeting.","exampleTranslation":"Cô ấy đã phát biểu một cách về bản chất trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"invariably":{"definition":"Luôn luôn vẫn vậy, lúc nào cũng vậy.","example":"He moved invariably through the crowd.","exampleTranslation":"Anh ấy luôn luôn di chuyển xuyên qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"invariant":{"definition":"Không thay đổi, bất biến.","example":"The rules stayed invariant all year.","exampleTranslation":"Các quy tắc vẫn không thay đổi suốt cả năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"investigate":{"definition":"Điều tra nghiên cứu.","example":"The police will investigate the missing phone.","exampleTranslation":"Cảnh sát sẽ điều tra chiếc điện thoại bị mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"investigation":{"definition":"Sự điều tra nghiên cứu.","example":"The investigation took several weeks.","exampleTranslation":"Sự điều tra đã mất vài tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"irrespective":{"definition":"Không kể, bất chấp.","example":"The rules apply irrespective of your age.","exampleTranslation":"Các quy tắc áp dụng không kể tuổi của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"iterative":{"definition":"Nhắc lại, lắp lại, nhắc đi nhắc lại, lặp đi lặp lại.","example":"The lesson used an iterative drill for practice.","exampleTranslation":"Bài học đã sử dụng một bài tập nhắc lại để luyện tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"justify":{"definition":"Bào chữa, biện hộ, chứng minh là đúng.","example":"She tried to justify her choice with clear facts.","exampleTranslation":"Cô ấy cố gắng bào chữa lựa chọn của mình với các sự thật rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"likelihood":{"definition":"Sự có thể đúng, sự có thể thật.","example":"In all likelihood, it will rain this afternoon.","exampleTranslation":"Trong tất cả sự có thể đúng, chiều nay trời sẽ mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"liken":{"definition":"Làm cho giống nhau.","example":"They liken the two tools for size.","exampleTranslation":"Họ làm cho hai dụng cụ giống nhau về kích thước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"linear":{"definition":"Dài, hẹp và đều nét (như một đường kẻ).","example":"He drew a long linear mark across the page.","exampleTranslation":"Anh ấy vẽ một đường kẻ dài, hẹp trên trang giấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"locus":{"definition":"Địa điểm, nơi, chỗ.","example":"The exact locus of the shop is here.","exampleTranslation":"Địa điểm chính xác của cửa hàng ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"logically":{"definition":"Hợp lý.","example":"They worked logically all day.","exampleTranslation":"Họ làm việc hợp lý cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"misdate":{"definition":"Ghi sai ngày tháng.","example":"I misdate the letter and wrote the wrong year.","exampleTranslation":"Tôi ghi sai ngày tháng trên lá thư và viết nhầm năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"negative":{"definition":"Không; phủ định, phủ nhận, cự tuyệt, phản đối, từ chối; cấm đoán.","example":"I received a negative response to my job application.","exampleTranslation":"Tôi đã nhận được một phản hồi tiêu cực đối với đơn xin việc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"notation":{"definition":"Ký hiệu.","example":"The map used clear notation for each road.","exampleTranslation":"Bản đồ đã sử dụng ký hiệu rõ ràng cho mỗi con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"objective":{"definition":"Khách quan.","example":"A journalist must always provide an objective opinion.","exampleTranslation":"Một nhà báo luôn phải đưa ra quan điểm khách quan.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"omission":{"definition":"Sự bỏ sót, sự bỏ quên, sự bỏ đi.","example":"The omission in the form caused trouble.","exampleTranslation":"Sự bỏ sót trong biểu mẫu đã gây ra rắc rối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"omit":{"definition":"Bỏ sót, bỏ quên, bỏ đi (một từ... ).","example":"Please omit the last line from the note.","exampleTranslation":"Vui lòng bỏ sót dòng cuối cùng khỏi ghi chú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"outline":{"definition":"Nét ngoài, đường nét.","example":"The outline showed the shape of the house.","exampleTranslation":"Nét ngoài cho thấy hình dạng của ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"overview":{"definition":"Sự khái quát; miêu tả chung, ngắn gọn.","example":"The report gives an overview of the whole plan.","exampleTranslation":"Báo cáo đưa ra một cái nhìn khái quát về toàn bộ kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"paradox":{"definition":"Ý kiến ngược đời.","example":"It was a paradox that the room felt crowded and empty.","exampleTranslation":"Việc căn phòng vừa cảm thấy chật chội vừa trống trải là một nghịch lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"parse":{"definition":"Phân tích ngữ pháp (từ, câu).","example":"Please parse the sentence before class.","exampleTranslation":"Vui lòng phân tích ngữ pháp câu này trước khi vào lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"pattern":{"definition":"Mẫu, mô hình, kiểu.","example":"He rode a bicycle of an old pattern.","exampleTranslation":"Anh ấy đã lái chiếc xe đạp theo một kiểu cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"perspective":{"definition":"Cảnh trông xa; (nghĩa bóng) viễn cảnh, triển vọng; tương lai, tiến độ.","example":"The new plan gives us a better perspective on the future.","exampleTranslation":"Kế hoạch mới mang lại cho chúng ta một viễn cảnh tốt hơn về tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"pertinent":{"definition":"Thích hợp, thích đáng, đúng chỗ; đi thẳng vào (vấn đề... ).","example":"Please do not share information that is not pertinent.","exampleTranslation":"Vui lòng đừng chia sẻ thông tin không thích hợp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"pivot":{"definition":"Trụ, ngõng, chốt.","example":"They discussed the pivot today.","exampleTranslation":"Họ đã thảo luận về cái chốt hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"plagiarise":{"definition":"Ăn cắp (ý, văn); ăn cắp ý, ăn cắp văn.","example":"Do not plagiarise another student's work.","exampleTranslation":"Đừng đạo văn tác phẩm của một sinh viên khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"plagiarism":{"definition":"Sự ăn cắp, ý, sự ăn cắp văn, sự đạo văn.","example":"Plagiarism can damage a student's trust.","exampleTranslation":"Đạo văn có thể hủy hoại lòng tin của một sinh viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"plausible":{"definition":"Có vẻ hợp lý, có vẻ đúng (lời nói, lý lẽ).","example":"That sounds like a very plausible excuse for being late.","exampleTranslation":"Điều đó nghe có vẻ là một lời biện hộ hợp lý cho việc đến muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"ploy":{"definition":"Khoé, thủ đoạn.","example":"The diplomat used a clever ploy to win.","exampleTranslation":"Nhà ngoại giao đã sử dụng một khoé thông minh để giành chiến thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"positive":{"definition":"Xác thực, rõ ràng.","example":"She provided a positive proof for her theory.","exampleTranslation":"Cô ấy đã cung cấp một bằng chứng xác thực cho lý thuyết của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"positively":{"definition":"Xác thực, rõ ràng.","example":"He left positively after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách xác thực sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"possibility":{"definition":"Sự có thể, tình trạng có thể, khả năng.","example":"We must consider every possibility before making a choice.","exampleTranslation":"Chúng ta phải xem xét mọi khả năng trước khi đưa ra lựa chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"possibly":{"definition":"Có lẽ, có thể.","example":"They will possibly arrive before the party starts.","exampleTranslation":"Họ có thể sẽ đến trước khi bữa tiệc bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"potential":{"definition":"Tiềm tàng.","example":"She has the potential to become a great leader.","exampleTranslation":"Cô ấy có tiềm tàng để trở thành một nhà lãnh đạo vĩ đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"potentially":{"definition":"Có khả năng","example":"This new plan is potentially dangerous for our team.","exampleTranslation":"Kế hoạch mới này có khả năng nguy hiểm cho nhóm của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"precise":{"definition":"Đúng, chính xác.","example":"The measurement is very precise and accurate.","exampleTranslation":"Số đo rất chính xác và đúng đắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"precision":{"definition":"Đúng, chính xác.","example":"This scale requires a high level of precision.","exampleTranslation":"Cái cân này đòi hỏi một mức độ chính xác cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"precondition":{"definition":"Điều kiện quyết định trước hết; điều kiện tiên quyết (như) prerequisite.","example":"A good laptop is a precondition for online classes.","exampleTranslation":"Một chiếc máy tính xách tay tốt là điều kiện tiên quyết cho các lớp học trực tuyến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"predetermine":{"definition":"Thúc ép (ai... làm gì) trước.","example":"The rules predetermine how students complete the task.","exampleTranslation":"Các quy tắc xác định trước cách học sinh hoàn thành nhiệm vụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"predict":{"definition":"Nói trước; đoán trước, dự đoán, tiên tri.","example":"Can you predict what will happen next year?","exampleTranslation":"Bạn có thể dự đoán điều gì sẽ xảy ra vào năm tới không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"predictable":{"definition":"Có thể nói trước; có thể đoán trước, có thể dự đoán.","example":"His answer was predictable after the hint.","exampleTranslation":"Có thể dự đoán được","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"prediction":{"definition":"Lời nói trước; lời đoán trước, lời dự đoán, lời tiên tri.","example":"Her prediction about the test score came true.","exampleTranslation":"Dự đoán của cô ấy về điểm bài kiểm tra đã trở thành sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"predictive":{"definition":"Nói trước; đoán trước, dự đoán.","example":"The predictive ape guessed the weather well.","exampleTranslation":"Mang tính dự báo","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"predictor":{"definition":"Máy đo ngầm, máy quan trắc (các định tầm cao, hướng... của máy bay địch để bắn).","example":"The predictor tracked the plane on the screen.","exampleTranslation":"Thiết bị dự báo","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"preliminary":{"definition":"Số nhiều) công việc chuẩn bị, sự sắp đặt mở đầu; biện pháp sơ bộ.","example":"The team finished the preliminary before the show.","exampleTranslation":"Đội đã hoàn thành phần sơ bộ trước buổi biểu diễn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"premise":{"definition":"Những cái kể trên; (pháp lý) tài sản kể trên.","example":"Please return all premise listed in the form.","exampleTranslation":"Vui lòng trả lại tất cả các cơ sở được liệt kê trong đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"presumably":{"definition":"có lẽ; được cho là","example":"The disease presumably originated in Canada.","exampleTranslation":"Căn bệnh này được cho là bắt nguồn từ Canada.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"presuppose":{"definition":"Bao hàm.","example":"Success in this project will presuppose a lot of hard work.","exampleTranslation":"Sự thành công trong dự án này đòi hỏi phải có rất nhiều công sức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"principle":{"definition":"Gốc, nguồn gốc, yếu tố cơ bản.","example":"Water is the basic principle of life on Earth.","exampleTranslation":"Nước là nguyên tắc cơ bản của sự sống trên Trái Đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"problematic":{"definition":"Có vấn đề gì đó còn tồn đọng.","example":"The plan is problematic because it costs too much.","exampleTranslation":"Kế hoạch này có vấn đề vì nó quá đắt đỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"procedure":{"definition":"Thủ tục.","example":"Please follow the standard procedure to complete your application.","exampleTranslation":"Vui lòng làm theo quy trình tiêu chuẩn để hoàn thành đơn đăng ký của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"process":{"definition":"Quá trình, sự tiến triển.","example":"The manufacturing process takes several weeks to complete.","exampleTranslation":"Quy trình sản xuất mất vài tuần để hoàn thành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"proof":{"definition":"Chứng, chứng cớ, bằng chứng.","example":"There is no proof for this strange story.","exampleTranslation":"Không có bằng chứng cho câu chuyện kỳ lạ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"proposition":{"definition":"Lời đề nghị, kế hoạch, đề xuất, dự kiến đề ra.","example":"She read the proposition aloud to the class.","exampleTranslation":"Cô ấy đọc đề nghị đó lên lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"prove":{"definition":"Chứng tỏ, chứng minh.","example":"Can you prove your statement with some evidence?","exampleTranslation":"Bạn có thể chứng minh tuyên bố của mình bằng bằng chứng nào không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"purpose":{"definition":"Mục đích, ý định.","example":"What is your purpose for visiting our office?","exampleTranslation":"Mục đích của bạn khi đến thăm văn phòng của chúng tôi là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"questionable":{"definition":"Đáng ngờ, đáng nghi ngờ.","example":"That story sounds questionable to me.","exampleTranslation":"Câu chuyện đó nghe có vẻ đáng ngờ đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"random":{"definition":"Ẩu, bừa, ngẫu nhiên.","example":"She chose a random book from the shelf.","exampleTranslation":"Cô ấy chọn ngẫu nhiên một cuốn sách từ kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"realise":{"definition":"Thực hiện, thực hành (kế hoạch hy vọng... ).","example":"We hope to realise the plan this year.","exampleTranslation":"Chúng tôi hy vọng sẽ thực hiện được kế hoạch trong năm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"Alternate spelling: realize."},"realize":{"definition":"Thực hiện, thực hành (kế hoạch hy vọng... ).","example":"They hope to realize their plan by summer.","exampleTranslation":"Họ hy vọng sẽ hiện thực hóa kế hoạch của mình vào mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"British spelling: realise."},"reasonable":{"definition":"Có lý, hợp lý.","example":"That is a very reasonable proposal for us.","exampleTranslation":"Đó là một đề xuất rất hợp lý đối với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"reasonably":{"definition":"Hợp lý.","example":"Please try to behave in a reasonably calm manner.","exampleTranslation":"Hãy cố gắng cư xử một cách điềm tĩnh hợp lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"reassess":{"definition":"Định giá lại để đánh thuế.","example":"The office will reassess the property value.","exampleTranslation":"Văn phòng sẽ đánh giá lại giá trị tài sản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"reckon":{"definition":"Tính, đếm.","example":"I reckon the total cost will be high.","exampleTranslation":"Tôi tính rằng tổng chi phí sẽ rất cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"refer":{"definition":"Chỉ dẫn (ai) đến hỏi (người nào, tổ chức nào).","example":"You should refer yourself to the local clinic.","exampleTranslation":"Bạn nên giới thiệu bản thân đến phòng khám địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"reference":{"definition":"Sự hỏi ý kiến.","example":"He acted without any reference to my opinion.","exampleTranslation":"Sự hỏi ý kiến","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"relevance":{"definition":"Sự thích đáng, sự thích hợp; sự xác đáng.","example":"The topic has clear relevance to our class.","exampleTranslation":"Chủ đề này có sự liên quan rõ ràng đến lớp học của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"relevant":{"definition":"Thích đáng, thích hợp; xác đáng.","example":"Please provide all relevant documents for the meeting.","exampleTranslation":"Vui lòng cung cấp tất cả các tài liệu liên quan cho cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"reliable":{"definition":"Chắc chắn, đáng tin cậy; xác thực (tin tức... ).","example":"She is a very reliable person in trouble.","exampleTranslation":"Cô ấy là một người rất đáng tin cậy khi gặp rắc rối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"reliably":{"definition":"Chắc chắn, đáng tin cậy; xác thực (tin tức... ).","example":"He moved reliably through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách đáng tin cậy qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"reliance":{"definition":"Sự tin cậy, sự tín nhiệm.","example":"We must place our reliance on a solid plan.","exampleTranslation":"Chúng ta phải đặt niềm tin vào một kế hoạch vững chắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"rely":{"definition":"dựa vào; tin cậy","example":"In this place, you can't rely on good weather even in the summer.","exampleTranslation":"Ở nơi này, bạn không thể trông cậy vào thời tiết đẹp ngay cả vào mùa hè. [L7]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"verb","posGroup":"verb","family":"academic-methods"},"rethink":{"definition":"Suy tính lại, cân nhắc lại.","example":"We need to rethink the whole plan.","exampleTranslation":"Chúng ta cần cân nhắc lại toàn bộ kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"review":{"definition":"Sự xem lại, sự xét lại (một bản án).","example":"The court of review will examine the case.","exampleTranslation":"Tòa phúc thẩm sẽ xem xét lại vụ án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"revision":{"definition":"Sự xem lại, sự xét lại, sự duyệt lại.","example":"The teacher asked for a revision.","exampleTranslation":"Giáo viên đã yêu cầu một bản xem xét lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"rhetorical":{"definition":"Hoa mỹ, cường điệu, khoa trương (văn).","example":"Her writing was rhetorical and hard to follow.","exampleTranslation":"Văn viết của cô ấy rất hoa mỹ và khó hiểu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"savvy":{"definition":"Sự hiểu biết, sự khôn khéo.","example":"You need savvy to solve that problem fast.","exampleTranslation":"Bạn cần sự khôn khéo để giải quyết vấn đề đó một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"scan":{"definition":"Đọc thử xem có đúng âm luật và nhịp điệu (thơ).","example":"The poet can scan the verse by ear.","exampleTranslation":"Nhà thơ có thể đọc thử bài thơ bằng tai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"scenario":{"definition":"Trường hợp.","example":"In one scenario, the train arrives late.","exampleTranslation":"Trong một trường hợp, chuyến tàu đến muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"sceptical":{"definition":"Hoài nghi, đa nghi, hay ngờ vực.","example":"He was sceptical about the quick result.","exampleTranslation":"Anh ấy hoài nghi về kết quả nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"scope":{"definition":"Phạm vi, tầm xa (kiến thức); dịp; nơi phát huy.","example":"That complex topic is currently beyond my scope.","exampleTranslation":"Chủ đề phức tạp đó hiện nằm ngoài phạm vi của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"scrutiny":{"definition":"Sự kiểm tra lại phiếu (khi có sự sát nút hay nghi ngờ gian lận).","example":"The plan came under close scrutiny by the board.","exampleTranslation":"Kế hoạch đã được kiểm tra lại kỹ lưỡng bởi hội đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"search":{"definition":"Sự nhìn để tìm, sự sờ để tìm; sự khám xét, sự lục soát.","example":"The police have the right of search for evidence.","exampleTranslation":"Cảnh sát có quyền khám xét để tìm bằng chứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"select":{"definition":"Dành riêng cho những người địa vị, giàu có.","example":"Only a select few can enter this club.","exampleTranslation":"Chỉ một số ít người được chọn mới có thể vào câu lạc bộ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"selection":{"definition":"Người (vật) được chọn lựa.","example":"She was a good selection for the team.","exampleTranslation":"Cô ấy là một người được chọn tốt cho đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"selective":{"definition":"Có lựa chọn, có chọn lọc, có tuyển lựa.","example":"The company is very selective about new hires.","exampleTranslation":"Công ty rất có chọn lọc về những nhân viên mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"sequence":{"definition":"Một dãy các thứ nối tiếp nhau","example":"The sequence of feelings is: anger followed by sadness and finally calm.","exampleTranslation":"Chuỗi cảm giác là: tức giận sau đó là buồn bã và cuối cùng là bình tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"sieve":{"definition":"Cái giần, cái sàng, cái rây.","example":"She used a sieve to drain the pasta.","exampleTranslation":"Cô ấy dùng cái rây để để ráo mì ống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"sift":{"definition":"Rơi lấm tấm như bột rây (mưa, tuyết).","example":"Snow began to sift through the trees.","exampleTranslation":"Tuyết bắt đầu rơi lấm tấm qua những hàng cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"significance":{"definition":"Ý nghĩa.","example":"She looked at him with a look of deep significance.","exampleTranslation":"Cô ấy nhìn anh ta với vẻ đầy ý nghĩa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"significant":{"definition":"Đầy ý nghĩa, có tính chất gợi ý.","example":"That was a significant change in her mood.","exampleTranslation":"Đó là một sự thay đổi quan trọng trong tâm trạng của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"significantly":{"definition":"đáng kể; quan trọng","example":"The price of gas dropped significantly today, causing drivers to line up at the pumps to fill up.","exampleTranslation":"Giá xăng giảm đáng kể hôm nay, khiến các tài xế xếp hàng tại trạm bơm để đổ đầy bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"signify":{"definition":"Biểu thị, biểu hiện; báo hiệu.","example":"The lights signify that the store is open.","exampleTranslation":"Những ngọn đèn báo hiệu rằng cửa hàng đang mở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"skeptical":{"definition":"Hoài nghi, đa nghi, hay ngờ vực.","example":"Many people were skeptical of his claim to have seen a UFO.","exampleTranslation":"Nhiều người cảm thấy hoài nghi về tuyên bố của anh ấy rằng đã nhìn thấy UFO.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"skepticism":{"definition":"Chủ nghĩa hoài nghi.","example":"She saw the skepticism yesterday.","exampleTranslation":"Cô ấy đã chứng kiến sự hoài nghi ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"solution":{"definition":"Sự hoà tan.","example":"Salt will make the solution clear.","exampleTranslation":"Muối sẽ làm cho sự hoà tan trở nên trong suốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"solve":{"definition":"Giải (một phương trình).","example":"Can you help me solve this math problem?","exampleTranslation":"Bạn có thể giúp tôi giải bài toán này không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"sophisticate":{"definition":"Dùng phép nguỵ biện (vào một vấn đề).","example":"He tried to sophisticate the simple issue.","exampleTranslation":"Anh ấy cố gắng dùng phép nguỵ biện để làm vấn đề đơn giản trở nên phức tạp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"sophistication":{"definition":"Sự nguỵ biện.","example":"His answer showed too much sophistication.","exampleTranslation":"Câu trả lời của anh ấy cho thấy quá nhiều sự nguỵ biện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"source":{"definition":"Nguồn sông, nguồi suối.","example":"The spring is the source of the river.","exampleTranslation":"Suối là nguồn của con sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"specific":{"definition":"(Thuộc) loài.","example":"What is the specific name of this plant?","exampleTranslation":"Tên loài cụ thể của cây này là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"specify":{"definition":"Chỉ rõ, ghi rõ, định rõ, ghi chú vào phần chi tiết kỹ thuật.","example":"Please specify your name on the form.","exampleTranslation":"Vui lòng ghi rõ tên của bạn vào mẫu đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"speculate":{"definition":"Tự biên.","example":"Do not speculate about his private life.","exampleTranslation":"Đừng suy đoán về cuộc sống riêng tư của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"speculation":{"definition":"Sự suy xét, sự nghiên cứu.","example":"Her speculation led to a useful idea.","exampleTranslation":"Sự suy xét của cô ấy dẫn đến một ý tưởng hữu ích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"standard":{"definition":"Tiêu chuẩn, chuẩn, mẫu.","example":"Please use the standard meter for all measurements.","exampleTranslation":"Vui lòng sử dụng tiêu chuẩn mét cho tất cả các phép đo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"standardisation":{"definition":"Sự tiêu chuẩn hoá; sự làm thành chính quy.","example":"Standardisation made the parts easier to fit.","exampleTranslation":"Sự tiêu chuẩn hoá làm cho các bộ phận dễ khớp với nhau hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"standardise":{"definition":"Tiêu chuẩn hoá.","example":"We standardise the forms before printing them.","exampleTranslation":"Chúng tôi tiêu chuẩn hoá các mẫu đơn trước khi in chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"Alternate spelling: standardize."},"standardize":{"definition":"Tiêu chuẩn hoá.","example":"They standardize the labels for easier sorting.","exampleTranslation":"Họ tiêu chuẩn hoá các nhãn để dễ dàng phân loại hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"British spelling: standardise."},"straightforward":{"definition":"Thành thật, thẳng thắn; cởi mở.","example":"The instructions were straightforward and easy to follow.","exampleTranslation":"Các hướng dẫn rất thẳng thắn và dễ làm theo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"subsequent":{"definition":"Đến sau, theo sau, xảy ra sau.","example":"The subsequent lesson was easier to understand.","exampleTranslation":"Bài học tiếp sau đó dễ hiểu hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"suggest":{"definition":"Gợi, làm nảy ra trong trí.","example":"Can you suggest a good book for me?","exampleTranslation":"Bạn có thể gợi ý một cuốn sách hay cho tôi được không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"suggestion":{"definition":"Sự khêu gợi, sự gợi những ý nghĩa tà dâm.","example":"The film used suggestion to create a strange mood.","exampleTranslation":"Bộ phim đã sử dụng sự khêu gợi để tạo ra một tâm trạng kỳ lạ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"suggestive":{"definition":"Gợi ý, có tính chất gợi ý, có tính chất gợi nhớ.","example":"The sentence is suggestive of an old saying.","exampleTranslation":"Câu văn này có tính chất gợi nhớ đến một câu tục ngữ cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"summarise":{"definition":"Tóm tắt, tổng kết.","example":"Please summarise the story in two sentences.","exampleTranslation":"Vui lòng tóm tắt câu chuyện trong hai câu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"Alternate spelling: summarize."},"summarize":{"definition":"Tóm tắt, tổng kết.","example":"Please summarize the chapter in three points.","exampleTranslation":"Vui lòng tóm tắt chương này trong ba điểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods","spellingNote":"British spelling: summarise."},"summed":{"definition":"Quá khứ và phân từ quá khứ của sum","example":"She summed the costs on a note.","exampleTranslation":"Cô ấy đã tổng kết các chi phí trên một tờ ghi chú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"sums":{"definition":"Động từ chia ở ngôi thứ ba số ít của sum","example":"He sums the scores after each round.","exampleTranslation":"Anh ấy tổng kết các điểm số sau mỗi vòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"suppose":{"definition":"Cho rằng, tin, nghĩ rằng.","example":"I suppose we shall be back in an hour.","exampleTranslation":"Tôi cho rằng chúng ta sẽ trở lại trong một giờ nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"system":{"definition":"Hệ thống; chế độ.","example":"Our school has a very organized system for learning.","exampleTranslation":"Trường chúng tôi có một hệ thống rất được tổ chức cho việc học tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"systematic":{"definition":"Có phương pháp.","example":"He is a very systematic worker in this office.","exampleTranslation":"Anh ấy là một nhân viên có phương pháp trong văn phòng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"technique":{"definition":"Phương pháp kỹ thuật, kỹ thuật.","example":"The weaver showed us her unique weaving technique.","exampleTranslation":"Người dệt vải đã cho chúng tôi thấy phương pháp kỹ thuật dệt độc đáo của bà ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"tentative":{"definition":"Ướm, thử.","example":"We made a tentative offer to buy the car.","exampleTranslation":"Chúng tôi đã đưa ra một lời đề nghị ướm thử để mua chiếc xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"term":{"definition":"Hạn, giới hạn, định hạn.","example":"They set a strict term for all future expenses.","exampleTranslation":"Họ đặt một hạn giới hạn nghiêm ngặt cho tất cả các chi phí trong tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"terminology":{"definition":"Thuật ngữ học.","example":"The book explains basic terminology.","exampleTranslation":"Cuốn sách giải thích thuật ngữ học cơ bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"test":{"definition":"Vỏ (tôm, cua); mai (rùa).","example":"The crab's test was hard and rough.","exampleTranslation":"Vỏ của con cua rất cứng và thô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"tester":{"definition":"Người thử; máy thử.","example":"The tester checked the new phone before release.","exampleTranslation":"Người thử đã kiểm tra chiếc điện thoại mới trước khi phát hành.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"theoretical":{"definition":"Lý thuyết; có tính chất lý thuyết.","example":"The plan is only theoretical for now.","exampleTranslation":"Kế hoạch chỉ là lý thuyết vào lúc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"theoretically":{"definition":"Về mặt lý thuyết","example":"Theoretically, this simple machine should lift the heavy box.","exampleTranslation":"Về mặt lý thuyết, cỗ máy đơn giản này đáng lẽ phải nâng được cái hộp nặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"theorize":{"definition":"Nói lý luận.","example":"He began to theorize during the long walk.","exampleTranslation":"Anh ấy bắt đầu nói lý luận trong suốt chuyến đi bộ dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"thinker":{"definition":"Người suy nghĩ.","example":"A good thinker asks careful questions before deciding.","exampleTranslation":"Một người suy nghĩ giỏi đặt những câu hỏi cẩn thận trước khi quyết định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"topic":{"definition":"Đề tài, chủ đề.","example":"What is the main topic of your speech?","exampleTranslation":"Đề tài chính trong bài phát biểu của bạn là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"triangle":{"definition":"Hình tam giác.","example":"Draw an equilateral triangle on the white board.","exampleTranslation":"Vẽ một hình tam giác đều trên bảng trắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"truth":{"definition":"Sự thật, lẽ phải, chân lý.","example":"We must always seek the truth in every situation.","exampleTranslation":"Chúng ta phải luôn tìm kiếm sự thật trong mọi tình huống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"truthful":{"definition":"Trung thành, chính xác.","example":"She gave a truthful account of what happened yesterday.","exampleTranslation":"Cô ấy đã đưa ra một bản tường trình trung thực về những gì đã xảy ra ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"uncritical":{"definition":"Không thích hợp với nguyên tắc phê bình.","example":"That method is uncritical for this simple test.","exampleTranslation":"Phương pháp đó không thích hợp với nguyên tắc phê bình cho bài kiểm tra đơn giản này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"undeniably":{"definition":"Không thể chối cãi","example":"She is undeniably the most talented singer in the group.","exampleTranslation":"Cô ấy không thể chối cãi là ca sĩ tài năng nhất trong nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"academic-methods"},"underestimate":{"definition":"Đánh giá thấp.","example":"Do not underestimate the test.","exampleTranslation":"Đừng đánh giá thấp bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"underlie":{"definition":"Nằm dưới, ở dưới.","example":"She tried to underlie the issue.","exampleTranslation":"Cô ấy đã cố gắng nằm dưới vấn đề đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"underlying":{"definition":"Cơ bản, cơ sở.","example":"We must consider the underlying principles of justice.","exampleTranslation":"Chúng ta phải xem xét các nguyên tắc cơ bản của công lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"undermine":{"definition":"Đào dưới chân; xói mòn chân.","example":"Stress may undermine your focus.","exampleTranslation":"Căng thẳng có thể làm xói mòn sự tập trung của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"undoubtedly":{"definition":"Rõ ràng, chắc chắn, không thể tranh cãi được, không bị hoài nghi, không bị thắc mắc.","example":"He left undoubtedly after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách chắc chắn sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"academic-methods"},"unravel":{"definition":"Làm cho ra manh mối; làm sáng tỏ.","example":"She tried to unravel the mystery of the old house.","exampleTranslation":"Cô ấy đã cố gắng làm sáng tỏ bí ẩn của ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"unreliable":{"definition":"Không tin cậy được (người); không đáng tin, không xác thực (tin tức).","example":"That unreliable bus is always late.","exampleTranslation":"Chiếc xe buýt không tin cậy đó luôn đến trễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"unresolved":{"definition":"Còn do dự, chưa quyết định.","example":"She felt unresolved about the new job.","exampleTranslation":"Cô ấy cảm thấy còn do dự về công việc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"unsystematic":{"definition":"Không có hệ thống.","example":"His books are unsystematic on the shelf.","exampleTranslation":"Sách của anh ấy để không có hệ thống trên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"untruth":{"definition":"Điều nói láo, điều nói dối, điều nói sai.","example":"That answer was an untruth.","exampleTranslation":"Câu trả lời đó là một điều nói dối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"upshot":{"definition":"Kết quả, kết quả cuối cùng, kết luận.","example":"The upshot was a better plan for everyone.","exampleTranslation":"Kết quả cuối cùng là một kế hoạch tốt hơn cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"vague":{"definition":"Mơ hồ, lờ mờ, mập mờ.","example":"I have only a vague idea of the plan.","exampleTranslation":"Tôi chỉ có một ý tưởng mơ hồ về kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"vagueness":{"definition":"Tính chất mập mờ; tình trạng mơ hồ.","example":"The vagueness of his answer made us unsure.","exampleTranslation":"Tính chất mập mờ trong câu trả lời của anh ấy khiến chúng tôi không chắc chắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"valid":{"definition":"Vững chắc, có căn cứ.","example":"You need to provide a valid reason today.","exampleTranslation":"Bạn cần đưa ra một lý do vững chắc hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"academic-methods"},"validate":{"definition":"Làm cho có giá trị, làm cho có hiệu lực, làm cho hợp lệ; phê chuẩn.","example":"Please validate the form before sending it.","exampleTranslation":"Vui lòng phê chuẩn biểu mẫu trước khi gửi nó đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"validity":{"definition":"tính hợp lệ; hiệu lực","example":"The validity of a passport depends on who carries it.","exampleTranslation":"Tính hợp lệ của hộ chiếu phụ thuộc vào người mang nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"academic-methods"},"verify":{"definition":"Thẩm tra, kiểm lại.","example":"You need to verify the statement with other sources.","exampleTranslation":"Bạn cần thẩm tra tuyên bố với các nguồn khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"academic-methods"},"versus":{"definition":"Chống, chống lại, đấu với.","example":"Who is winning the match of Team A versus Team B?","exampleTranslation":"Ai đang thắng trận đấu giữa Đội A chống lại Đội B?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"X","posGroup":"other","family":"academic-methods"},"viewpoint":{"definition":"Chỗ đứng nhìn tốt, chỗ dễ nhìn.","example":"From this viewpoint, the lake looks larger.","exampleTranslation":"Từ chỗ đứng nhìn tốt này, hồ trông lớn hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"academic-methods"},"altitude":{"definition":"Độ cao của một địa điểm, thường được đo so với mực nước biển.","example":"At high altitude, lower air pressure can reduce the efficiency of combustion engines.","exampleTranslation":"Ở độ cao lớn, áp suất không khí thấp hơn có thể làm giảm hiệu suất của động cơ đốt trong.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"coast":{"definition":"Vùng đất tiếp giáp với biển hoặc đại dương; bờ biển.","example":"The island's eastern coast supports diverse wetlands that provide important habitats for migratory birds.","exampleTranslation":"Bờ biển phía đông của hòn đảo có các vùng đất ngập nước đa dạng, tạo môi trường sống quan trọng cho các loài chim di cư.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"coastal":{"definition":"Thuộc về bờ biển hoặc khu vực gần biển.","example":"Many coastal communities face increasing risks from storm surges and gradual sea-level rise.","exampleTranslation":"Nhiều cộng đồng ven biển phải đối mặt với những rủi ro ngày càng tăng từ nước dâng do bão và mực nước biển dâng dần.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"geographer":{"definition":"Nhà địa lý học, người nghiên cứu các đặc điểm và mối quan hệ không gian trên Trái Đất.","example":"The geographer mapped population density to identify regions underserved by public transportation.","exampleTranslation":"Nhà địa lý học lập bản đồ mật độ dân số để xác định những khu vực chưa được giao thông công cộng phục vụ đầy đủ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"geographical":{"definition":"Thuộc địa lý; liên quan đến các vùng đất, địa hình hoặc vị trí trên bản đồ.","example":"Geographical maps reveal how rivers influence the distribution of agricultural communities.","exampleTranslation":"Các bản đồ địa lý cho thấy sông ngòi ảnh hưởng như thế nào đến sự phân bố của các cộng đồng nông nghiệp.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"geography":{"definition":"Ngành khoa học nghiên cứu các địa hình, vùng miền, khí hậu và sự phân bố của con người trên Trái Đất.","example":"Physical geography examines how rivers, mountains, and climate shape human settlement patterns.","exampleTranslation":"Địa lý tự nhiên nghiên cứu cách sông ngòi, núi non và khí hậu định hình các mô hình định cư của con người.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"island":{"definition":"Một vùng đất được bao quanh hoàn toàn bởi nước.","example":"The island supports several endemic species adapted to salty coastal winds.","exampleTranslation":"Hòn đảo này là nơi sinh sống của một số loài đặc hữu thích nghi với những cơn gió biển mặn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"mountain":{"definition":"Một vùng đất tự nhiên cao và dốc, thường cao hơn khu vực xung quanh.","example":"The mountain blocks moist air, creating heavy rainfall on its western slopes.","exampleTranslation":"Ngọn núi chắn không khí ẩm, tạo ra lượng mưa lớn ở các sườn phía tây.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"mountainous":{"definition":"Có nhiều núi hoặc bị núi non bao phủ.","example":"The mountainous interior has few roads and remains sparsely populated.","exampleTranslation":"Vùng nội địa nhiều núi có ít đường sá và vẫn thưa dân.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"region":{"definition":"Một khu vực hoặc vùng có đặc điểm địa lý, khí hậu hay văn hóa tương đối riêng biệt.","example":"This region contains fertile valleys formed by ancient volcanic activity.","exampleTranslation":"Vùng này có những thung lũng màu mỡ được hình thành do hoạt động núi lửa cổ đại.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"regional":{"definition":"Thuộc về một vùng hoặc liên quan đến một khu vực cụ thể.","example":"Regional maps help researchers compare rainfall patterns across neighboring provinces.","exampleTranslation":"Các bản đồ khu vực giúp các nhà nghiên cứu so sánh kiểu mưa giữa những tỉnh lân cận.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"terrain":{"definition":"Địa hình hoặc đặc điểm bề mặt của một khu vực, xét về độ cao, độ dốc và dạng đất.","example":"The island's rugged terrain made road construction expensive and vulnerable to seasonal landslides.","exampleTranslation":"Địa hình gồ ghề của hòn đảo khiến việc xây dựng đường sá tốn kém và dễ bị sạt lở theo mùa.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"valley":{"definition":"Vùng đất thấp nằm giữa các đồi hoặc núi, thường có sông hoặc dòng suối chảy qua.","example":"The river valley supports intensive agriculture because its soils are deep and fertile.","exampleTranslation":"Thung lũng sông hỗ trợ nền nông nghiệp thâm canh vì đất ở đó dày và màu mỡ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"nomad":{"definition":"Người hoặc thành viên cộng đồng thường di chuyển từ nơi này sang nơi khác.","example":"A nomad may move seasonally to find water and grazing land.","exampleTranslation":"Người du mục có thể di chuyển theo mùa để tìm nước và đồng cỏ.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"geography"},"acre":{"definition":"Cánh đồng, đồng cỏ.","example":"The farmer owns a large acre of land.","exampleTranslation":"Người nông dân sở hữu một mẫu Anh đất lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"adjacent":{"definition":"Gần kề, kế liền, sát ngay.","example":"My house is adjacent to a large park.","exampleTranslation":"Nhà của tôi nằm gần kề một công viên lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"adjoin":{"definition":"Nối liền, tiếp vào.","example":"The small garden will adjoin our new house.","exampleTranslation":"Khu vườn nhỏ sẽ nối liền ngôi nhà mới của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"geography"},"aerial":{"definition":"Ở trên trời, trên không.","example":"The plane performed an aerial view of the city.","exampleTranslation":"Chiếc máy bay đã thực hiện một cái nhìn ở trên trời về thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"alpine":{"definition":"Dãy An-pơ, ở dãy An-pơ.","example":"We spent the summer in an alpine village.","exampleTranslation":"Chúng tôi đã dành mùa hè ở một ngôi làng thuộc dãy An-pơ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"backwater":{"definition":"(Nghĩa bóng) Sự tù túng (về tinh thần... ); ao làng (nơi không phát triển)","example":"The village felt like a backwater to many young people.","exampleTranslation":"Ngôi làng mang lại cảm giác như một nơi tù túng đối với nhiều người trẻ tuổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"beach":{"definition":"Sỏi cát (ở bãi biển).","example":"The beach was covered with soft sand.","exampleTranslation":"Bãi biển được bao phủ bởi cát mịn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"bend":{"definition":"Chỗ uốn, chỗ cong; chỗ rẽ.","example":"There is a sharp bend in the road ahead.","exampleTranslation":"Có một chỗ uốn cong sắc trên con đường phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"border":{"definition":"Bờ, mép, vỉa, lề.","example":"There is a white border around the page.","exampleTranslation":"Có một bờ trắng xung quanh trang giấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"bottom":{"definition":"Phần dưới cùng; đáy.","example":"There is a cat at the bottom of the street.","exampleTranslation":"Có một con mèo ở phần dưới cùng của con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"boundary":{"definition":"Đường biên giới, ranh giới.","example":"We must respect the boundary between countries.","exampleTranslation":"Chúng ta phải tôn trọng đường biên giới giữa các quốc gia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"cave":{"definition":"Hang lớn, động.","example":"We hid in a cave during rain.","exampleTranslation":"Chúng tôi đã trốn trong một cái hang khi trời mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"coastline":{"definition":"Bờ biển; hình dáng bờ biển.","example":"The coastline was rocky and beautiful at sunset.","exampleTranslation":"Bờ biển đầy đá và rất đẹp vào lúc hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"compass":{"definition":"Com-pa.","example":"We used a compass to draw a circle.","exampleTranslation":"Chúng tôi đã dùng compa để vẽ một vòng tròn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"countryside":{"definition":"Nông thôn, miền quê, vùng quê, địa phương (ở nông thôn).","example":"We spent the weekend in the countryside.","exampleTranslation":"Chúng tôi đã dành cuối tuần ở vùng quê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"delta":{"definition":"Đenta (chữ cái Hy-lạp).","example":"Write the Greek delta on the board.","exampleTranslation":"Hãy viết chữ đenta Hy Lạp lên bảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"desolate":{"definition":"Ruồng bỏ, bỏ bơ vơ, bỏ rơi.","example":"Do not desolate the child with harsh words.","exampleTranslation":"Đừng ruồng bỏ đứa trẻ bằng những lời nói gay gắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"geography"},"distance":{"definition":"Khoảng cách, tầm xa.","example":"The school is beyond striking distance from here.","exampleTranslation":"Ngôi trường nằm ngoài khoảng cách có thể bắn tới từ đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"distant":{"definition":"Xa, cách, xa cách.","example":"The mountains are five miles distant from here.","exampleTranslation":"Những ngọn núi cách năm dặm từ đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"divide":{"definition":"Đường chia nước.","example":"The river divide marked the start of two streams.","exampleTranslation":"Đường chia nước của dòng sông đánh dấu sự bắt đầu của hai con suối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"downhill":{"definition":"Dốc xuống.","example":"The downhill path was slippery.","exampleTranslation":"Con đường dốc xuống rất trơn trượt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"downstream":{"definition":"Xuôi dòng.","example":"The boat drifted downstream slowly.","exampleTranslation":"Con thuyền xuôi dòng từ từ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"geography"},"eastern":{"definition":"Người miền đông ((cũng) easterner).","example":"An eastern moved to the city for work.","exampleTranslation":"Một người miền đông đã chuyển đến thành phố để làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"eastward":{"definition":"Hướng đông.","example":"We traveled eastward along the river.","exampleTranslation":"Chúng tôi đi dọc theo hướng đông dọc theo con sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"edge":{"definition":"Cạnh, đường biên, bờ. Dùng Trong hình học, lý thuyết đồ thị (cạnh đồ thị), ...","example":"The edge was important at work.","exampleTranslation":"Đường biên quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"elevate":{"definition":"Nâng lên, đưa lên, giương (súng... ); ngẩng lên; ngước (mắt); cất cao (giọng nói).","example":"Please elevate the box onto the shelf.","exampleTranslation":"Vui lòng nâng chiếc hộp lên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"geography"},"elevation":{"definition":"Sự nâng lên, sự đưa lên, sự giương lên; sự ngẩng lên; sự ngước lên.","example":"The map shows the elevation of the hill.","exampleTranslation":"Bản đồ cho thấy sự nâng lên của ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"equator":{"definition":"Xích đạo.","example":"The equator divides the earth into two halves.","exampleTranslation":"Xích đạo chia Trái đất thành hai nửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"equatorial":{"definition":"Kính xích đạo.","example":"He used an equatorial to watch the stars.","exampleTranslation":"Anh ấy đã sử dụng một kính xích đạo để ngắm các ngôi sao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"expanse":{"definition":"Dải, dải rộng (đất... ).","example":"A wide expanse of grass stretched before us.","exampleTranslation":"Một dải rộng cỏ trải dài trước mắt chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"farther":{"definition":"Xa hơn; thêm hơn, hơn nữa.","example":"have you anything farther to say?","exampleTranslation":"Bạn có điều gì xa hơn để nói không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"farthest":{"definition":"Xa nhất.","example":"The lighthouse is at the farthest point.","exampleTranslation":"Ngọn hải đăng nằm ở điểm xa nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"fringe":{"definition":"Ven rìa (rừng... ); mép.","example":"The camp sat on the fringe of the forest.","exampleTranslation":"Trại nằm ở ven rìa khu rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"geographic":{"definition":"Địa lý.","example":"Please look at this geographic map of Asia.","exampleTranslation":"Vui lòng xem bản đồ địa lý này của châu Á.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"geographically":{"definition":"Về mặt địa lý, về phương diện địa lý.","example":"They worked geographically all day.","exampleTranslation":"Họ đã làm việc theo phương diện địa lý cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"geography"},"globe":{"definition":"Cầu mắt.","example":"A doctor checked the globe of the eye.","exampleTranslation":"Bác sĩ đã kiểm tra cầu mắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"hectare":{"definition":"Hecta.","example":"This field covers one hectare.","exampleTranslation":"Cánh đồng này rộng một hecta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"height":{"definition":"Chiều cao, bề cao; độ cao.","example":"He is about one hundred eighty centimeters in height.","exampleTranslation":"Anh ấy cao khoảng một trăm tám mươi cm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"hemisphere":{"definition":"Bán cầu.","example":"The Northern hemisphere experiences different seasons.","exampleTranslation":"Bán cầu Bắc trải qua các mùa khác nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"horizon":{"definition":"Chân trời.","example":"A thin line marked the horizon.","exampleTranslation":"Một đường mỏng đánh dấu chân trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"horizontal":{"definition":"Chân trời; ở chân trời.","example":"The sun was low on the horizontal line.","exampleTranslation":"Mặt trời ở thấp trên đường chân trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"inch":{"definition":"Đảo nhỏ (Ê-cốt).","example":"The island sits on a tiny inch offshore.","exampleTranslation":"Hòn đảo nằm trên một đảo nhỏ cách bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"inland":{"definition":"Vùng nội địa, vùng ở sâu trong nước.","example":"We spent the summer inland, far from the coast.","exampleTranslation":"Chúng tôi đã dành mùa hè ở vùng nội địa, xa bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"intersect":{"definition":"cắt ngang nhau, chéo nhau.","example":"They intersect the data carefully.","exampleTranslation":"Họ cắt ngang nhau các dữ liệu một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"geography"},"islander":{"definition":"Người ở đảo.","example":"The islander knew every path on the shore.","exampleTranslation":"Người ở đảo biết mọi con đường trên bờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"lagoon":{"definition":"Phá, đầm phá.","example":"We kayaked across the quiet lagoon.","exampleTranslation":"Chúng tôi chèo thuyền kayak băng qua đầm phá yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"lake":{"definition":"Chất màu đỏ tía (chế từ sơn).","example":"The artist used lake to make the fabric red.","exampleTranslation":"Người nghệ sĩ đã dùng chất màu đỏ tía để nhuộm vải đỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"landfall":{"definition":"Sự cập bến.","example":"The ship finally made landfall on the rocky coast.","exampleTranslation":"Con tàu cuối cùng đã cập bến trên bờ biển đầy đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"landmark":{"definition":"Mốc bờ (để dẫn đường cho các thuỷ thủ từ ngoài khơi hướng về đất liền).","example":"The tower was a clear landmark on the coast.","exampleTranslation":"Tòa tháp là một mốc bờ rõ ràng trên bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"landmass":{"definition":"Vùng đất rộng.","example":"The continent is a huge landmass.","exampleTranslation":"Lục địa là một vùng đất rộng khổng lồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"latitude":{"definition":"Miền, vùng (thường dùng ở dạng số nhiều).","example":"They live in high latitude regions of the north.","exampleTranslation":"Họ sống ở các miền vĩ độ cao phía bắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"locate":{"definition":"Xác định đúng vị trí, xác định đúng chỗ; phát hiện vị trí.","example":"The team had to locate the system.","exampleTranslation":"Nhóm phải xác định đúng vị trí của hệ thống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"geography"},"location":{"definition":"Khu đất được cắm để chuẩn bị xây dựng.","example":"They cleared the location for a new house.","exampleTranslation":"Họ đã dọn sạch khu đất để chuẩn bị cho một ngôi nhà mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"longitude":{"definition":"Kinh độ, độ kinh.","example":"He kept the longitude on the desk.","exampleTranslation":"Anh ấy giữ tờ giấy kinh độ trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"mainland":{"definition":"Lục địa, đất liền.","example":"We took a ferry to the mainland.","exampleTranslation":"Chúng tôi đi phà tới đất liền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"mapping":{"definition":"Sự sắp xếp, sự sắp đặt, sự vạch ra (chiến lược... ).","example":"We are mapping a clear plan for summer.","exampleTranslation":"Chúng tôi đang vạch ra một kế hoạch rõ ràng cho mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"mere":{"definition":"Ao; hồ.","example":"A quiet mere reflected the trees beside it.","exampleTranslation":"Một cái ao tĩnh lặng phản chiếu những cái cây bên cạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"mound":{"definition":"Ụ (đất, đá), mô (đất, đá).","example":"A mound of sand sat near the door.","exampleTranslation":"Một ụ cát nằm gần cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"narrow":{"definition":"Hẹp, chật hẹp, eo hẹp.","example":"The car could not pass through the narrow street.","exampleTranslation":"Chiếc xe không thể đi qua con phố hẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"northeast":{"definition":"Phía đông bắc.","example":"The village lies in the northeast.","exampleTranslation":"Ngôi làng nằm ở phía đông bắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"northward":{"definition":"Hướng bắc.","example":"We traveled toward the northward first.","exampleTranslation":"Chúng tôi đã đi về hướng bắc trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"northwest":{"definition":"Miền tây bắc.","example":"They traveled to the northwest by bus.","exampleTranslation":"Họ đã đi đến miền tây bắc bằng xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"oasis":{"definition":"Ốc đảo.","example":"We found an oasis after hours in the heat.","exampleTranslation":"Chúng tôi đã tìm thấy một ốc đảo sau nhiều giờ trong cái nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"outpost":{"definition":"Tiền đồn.","example":"The soldiers guarded the outpost all night.","exampleTranslation":"Những người lính canh giữ tiền đồn cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"path":{"definition":"Đường mòn, đường nhỏ.","example":"Please follow the path through the dark forest.","exampleTranslation":"Vui lòng đi theo con đường nhỏ xuyên qua khu rừng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"pathway":{"definition":"Đường mòn, đường nhỏ.","example":"We walked along a narrow pathway.","exampleTranslation":"Chúng tôi đã đi dọc theo một con đường mòn nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"peak":{"definition":"Lưỡi trai (của mũ).","example":"The hat's peak shaded her eyes from the sun.","exampleTranslation":"Lưỡi trai của chiếc mũ che đôi mắt cô ấy khỏi ánh mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"perimeter":{"definition":"Chu vi.","example":"We walked around the perimeter of the park.","exampleTranslation":"Chúng tôi đã đi dạo quanh chu vi của công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"picturesque":{"definition":"Đẹp, đẹp như tranh; đáng vẽ nên tranh (phong cảnh... ).","example":"The lake village was very picturesque.","exampleTranslation":"Ngôi làng bên hồ rất đẹp như tranh vẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"pole":{"definition":"Cột (để chăng lều...).","example":"They raised the tent with a tall pole.","exampleTranslation":"Họ dựng lều bằng một cái cột cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"pond":{"definition":"Biển.","example":"The pond was calm under the trees.","exampleTranslation":"Cái biển tĩnh lặng dưới những tán cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"province":{"definition":"Tỉnh.","example":"She moved to a small province in the north.","exampleTranslation":"Cô ấy đã chuyển đến một tỉnh nhỏ ở phía bắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"proximity":{"definition":"Trạng thái gần (về không gian, thời gian... )).","example":"The proximity of the school makes life easy.","exampleTranslation":"Sự gần gũi của ngôi trường giúp cuộc sống trở nên dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"range":{"definition":"Dãy, hàng.","example":"We can see a beautiful range of mountains.","exampleTranslation":"Chúng ta có thể nhìn thấy một dãy núi tuyệt đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"realm":{"definition":"Vương quốc.","example":"They lived in a quiet realm beyond the hills.","exampleTranslation":"Họ sống trong một vương quốc yên tĩnh phía sau những ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"ridge":{"definition":"Dãy (đồi, gò).","example":"A ridge of hills rose behind the town.","exampleTranslation":"Một dãy đồi mọc lên phía sau thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"rugged":{"definition":"Gồ ghề, lởm chởm, xù xì.","example":"We had to walk over very rugged ground today.","exampleTranslation":"Chúng tôi đã phải đi bộ trên mặt đất rất gồ ghề hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"sandy":{"definition":"Người Ê-cốt.","example":"The parade welcomed a sandy from the north.","exampleTranslation":"Cuộc diễu hành đã chào đón một người Ê-cốt từ phía bắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"savanna":{"definition":"Xavan.","example":"Wild grass spread across the savanna.","exampleTranslation":"Cỏ dại lan rộng khắp xavan.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"seashore":{"definition":"Khoảng đất giữa hai con nước.","example":"We walked across the seashore at low tide.","exampleTranslation":"Chúng tôi đi bộ dọc theo khoảng đất giữa hai con nước lúc thủy triều xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"seaside":{"definition":"Bờ biển.","example":"They spent a lovely weekend at a seaside resort.","exampleTranslation":"Họ đã dành một ngày cuối tuần đáng yêu tại một khu nghỉ mát bờ biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"shallow":{"definition":"Nông, cạn.","example":"We can swim safely in the shallow water.","exampleTranslation":"Chúng ta có thể bơi an toàn trong vùng nước nông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"shoal":{"definition":"Chỗ nông, chỗ cạn (nước).","example":"We walked through a shoal at low tide.","exampleTranslation":"Chúng tôi đi bộ qua một bãi cạn lúc thủy triều xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"situate":{"definition":"Đặt ở vị trí, đặt chỗ cho.","example":"They situate the desk near the window.","exampleTranslation":"Họ đặt chiếc bàn ở vị trí gần cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"geography"},"southern":{"definition":"Người ở miền Nam.","example":"A southern came to visit from the coast.","exampleTranslation":"Một người ở miền Nam đã đến thăm từ vùng ven biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"southing":{"definition":"Sự đi qua đường kinh (kinh tuyến).","example":"The ship made a slow southing across the sea.","exampleTranslation":"Con tàu đã có sự đi qua đường kinh chậm rãi băng qua biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"southward":{"definition":"Hướng nam.","example":"We traveled southward to find warmer weather.","exampleTranslation":"Chúng tôi đã đi về hướng nam để tìm thời tiết ấm áp hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"steep":{"definition":"Quá quắt, không biết đều.","example":"The company faces a steep demand for products.","exampleTranslation":"Công ty đối mặt với nhu cầu quá quắt cho sản phẩm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"subcontinent":{"definition":"Một vùng đất lớn, nằm tách ra và nhỏ hơn lục địa (ví dụ Greenland), hay nằm trong lục địa (như tiểu lục địa Ấn Độ).","example":"They discussed the subcontinent today.","exampleTranslation":"Họ đã thảo luận về tiểu lục địa hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"territory":{"definition":"Đất đai, địa hạt, lãnh thổ.","example":"This territory belongs to the village.","exampleTranslation":"Lãnh thổ này thuộc về ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"tract":{"definition":"Vùng, miền, dải.","example":"They bought a large tract of land for farming.","exampleTranslation":"Họ đã mua một vùng đất lớn để làm nông nghiệp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"trail":{"definition":"Vạch, vệt dài.","example":"A long trail of blood was on the floor.","exampleTranslation":"Một vệt dài của máu ở trên sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"upland":{"definition":"Vùng cao.","example":"They built a cabin in the upland.","exampleTranslation":"Họ xây một cabin ở vùng cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"waterside":{"definition":"Bờ biển, bờ sông, bờ hồ.","example":"We ate lunch near the waterside.","exampleTranslation":"Chúng tôi đã ăn trưa gần bờ sông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"geography"},"western":{"definition":"Phía tây; của phương tây.","example":"We are planning a trip to a western city.","exampleTranslation":"Chúng tôi đang lên kế hoạch cho một chuyến đi đến một thành phố phía tây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"geography"},"atom":{"definition":"Đơn vị nhỏ nhất của một nguyên tố hóa học vẫn giữ các tính chất của nguyên tố đó.","example":"Each atom consists of a nucleus surrounded by electrons occupying distinct energy levels.","exampleTranslation":"Mỗi nguyên tử gồm một hạt nhân được bao quanh bởi các electron chiếm những mức năng lượng riêng biệt.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"atomic":{"definition":"Thuộc về nguyên tử hoặc các quá trình, cấu trúc và năng lượng liên quan đến nguyên tử.","example":"Atomic structure determines how elements interact and form chemical bonds.","exampleTranslation":"Cấu trúc nguyên tử quyết định cách các nguyên tố tương tác và hình thành liên kết hóa học.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"chemical":{"definition":"Thuộc về hóa học hoặc liên quan đến các chất và sự biến đổi giữa chúng.","example":"The researchers monitored chemical changes in the soil after prolonged flooding.","exampleTranslation":"Các nhà nghiên cứu theo dõi những biến đổi hóa học trong đất sau một thời gian ngập lụt kéo dài.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"chemically":{"definition":"Về phương diện hóa học; xét theo tính chất hoặc thành phần hóa học.","example":"The sample was chemically stable under prolonged heating.","exampleTranslation":"Mẫu vật vẫn ổn định về mặt hóa học khi bị đun nóng trong thời gian dài.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"D","posGroup":"other","family":"materials-science"},"compound":{"definition":"Hợp chất được tạo thành từ hai hoặc nhiều nguyên tố liên kết hóa học với nhau.","example":"Scientists identified the compound as a product of bacterial metabolism.","exampleTranslation":"Các nhà khoa học xác định hợp chất này là sản phẩm của quá trình trao đổi chất ở vi khuẩn.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"element":{"definition":"Nguyên tố hóa học, gồm các nguyên tử có cùng số hiệu nguyên tử.","example":"Iron is an element commonly used in construction and manufacturing.","exampleTranslation":"Sắt là một nguyên tố thường được sử dụng trong xây dựng và sản xuất.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"elemental":{"definition":"Thuộc về một nguyên tố hóa học hoặc tồn tại ở dạng nguyên tố tự do.","example":"The analysis detected elemental sulfur in the mineral sample.","exampleTranslation":"Phân tích cho thấy lưu huỳnh nguyên tố trong mẫu khoáng vật.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"elementary":{"definition":"Cơ bản và ở mức nhập môn, thường làm nền tảng cho kiến thức phức tạp hơn.","example":"The textbook introduces elementary concepts before discussing complex molecular interactions.","exampleTranslation":"Cuốn giáo trình giới thiệu các khái niệm cơ bản trước khi thảo luận về những tương tác phân tử phức tạp.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"metal":{"definition":"Kim loại, một vật liệu thường có độ dẫn điện và dẫn nhiệt cao, đồng thời có tính dẻo.","example":"Copper is a versatile metal widely used in electrical wiring and industrial equipment.","exampleTranslation":"Đồng là một kim loại đa dụng được sử dụng rộng rãi trong dây dẫn điện và thiết bị công nghiệp.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"molecule":{"definition":"Phân tử, một nhóm gồm hai hoặc nhiều nguyên tử liên kết với nhau.","example":"A water molecule contains two hydrogen atoms and one oxygen atom.","exampleTranslation":"Một phân tử nước gồm hai nguyên tử hydro và một nguyên tử oxy.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"polymer":{"definition":"Chất có cấu trúc gồm các phân tử lớn hình thành từ nhiều đơn vị phân tử nhỏ liên kết với nhau.","example":"The polymer becomes flexible when heated, allowing manufacturers to shape it into medical tubing.","exampleTranslation":"Polymer trở nên dẻo khi được đun nóng, cho phép các nhà sản xuất tạo hình nó thành ống y tế.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"polymeric":{"definition":"Thuộc về polymer hoặc được cấu tạo từ polymer.","example":"Polymeric materials can reduce weight while maintaining the strength required for structural components.","exampleTranslation":"Các vật liệu polymer có thể giảm trọng lượng trong khi vẫn duy trì độ bền cần thiết cho các bộ phận kết cấu.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"reaction":{"definition":"Quá trình hóa học trong đó một hoặc nhiều chất biến đổi để tạo thành chất mới.","example":"The reaction between hydrogen and oxygen releases energy and produces water.","exampleTranslation":"Phản ứng giữa hydro và oxy giải phóng năng lượng và tạo ra nước.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"synthetic":{"definition":"Được tạo ra nhân tạo bằng các quá trình hóa học, thay vì có nguồn gốc tự nhiên.","example":"Synthetic fibers are often engineered to resist moisture, abrasion, and repeated washing.","exampleTranslation":"Các sợi tổng hợp thường được chế tạo để chống ẩm, mài mòn và việc giặt nhiều lần.","dictionarySource":"authored","exampleSource":"authored","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"abrade":{"definition":"Mài mòn.","example":"Sand can abrade the paint quickly.","exampleTranslation":"Cát có thể làm mài mòn sơn một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"absorb":{"definition":"Hút, hút thu (nước).","example":"Dry sand can absorb water very quickly.","exampleTranslation":"Cát khô có thể hút nước rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"absorbent":{"definition":"Hút nước, thấm hút.","example":"Use an absorbent towel to dry your hair.","exampleTranslation":"Hãy sử dụng một chiếc khăn thấm hút để làm khô tóc bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"acid":{"definition":"Axit.","example":"The scientist studied the acid radical in the lab.","exampleTranslation":"Nhà khoa học đã nghiên cứu gốc axit trong phòng thí nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"acidic":{"definition":"Có tính chất axit.","example":"This drink is too acidic for me.","exampleTranslation":"Đồ uống này quá chua đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"acidify":{"definition":"Axit hoá.","example":"Rain can acidify the soil.","exampleTranslation":"Mưa có thể làm axit hoá đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"airtight":{"definition":"Kín hơi, kín gió.","example":"The box is airtight, so the food stays fresh.","exampleTranslation":"Chiếc hộp kín hơi nên thực phẩm vẫn giữ được độ tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"amber":{"definition":"Hổ phách.","example":"The necklace was made of amber.","exampleTranslation":"Chiếc vòng cổ được làm bằng hổ phách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"ambergris":{"definition":"Long diên hương.","example":"The sailor found ambergris on the beach.","exampleTranslation":"Người thủy thủ đã tìm thấy long diên hương trên bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"aqueous":{"definition":"Nước; có nước.","example":"The scientist prepared an aqueous solution in the lab.","exampleTranslation":"Nhà khoa học đã chuẩn bị một dung dịch nước trong phòng thí nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"cement":{"definition":"Bột hàn răng.","example":"The dentist used cement to fill the tooth.","exampleTranslation":"Nha sĩ đã dùng bột hàn răng để trám chiếc răng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"ceramic":{"definition":"Nghề làm đồ gốm.","example":"She studied ceramic art in school.","exampleTranslation":"Cô ấy đã học nghệ thuật làm đồ gốm ở trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"charcoal":{"definition":"Than (củi).","example":"We used charcoal to start the campfire tonight.","exampleTranslation":"Chúng tôi đã dùng than để đốt lửa trại tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"chisel":{"definition":"Cái đục, cái chàng.","example":"He used a chisel to shape the wood.","exampleTranslation":"Anh ấy đã dùng cái đục để định hình miếng gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"clay":{"definition":"Đất sét, sét.","example":"Wet clay stuck to his shoes.","exampleTranslation":"Đất sét ướt đã dính vào giày của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"combustible":{"definition":"Dễ cháy, dễ bắt lửa.","example":"Keep combustible materials away from heat.","exampleTranslation":"Hãy giữ các vật liệu dễ bắt lửa tránh xa nguồn nhiệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"composite":{"definition":"Hợp lại; ghép, ghép lại; tổng hợp.","example":"The artist created a composite photograph of the city.","exampleTranslation":"Người nghệ sĩ đã tạo ra một bức ảnh tổng hợp về thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"copper":{"definition":"Cảnh sát, mật thám, cớm.","example":"The copper checked the empty street.","exampleTranslation":"Viên cảnh sát kiểm tra con phố vắng vẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"cord":{"definition":"Dây thừng nhỏ.","example":"Tie the package with a cord.","exampleTranslation":"Buộc gói hàng bằng một sợi dây thừng nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"crash":{"definition":"Vải thô (làm khăn lau...).","example":"He wiped the table with crash cloth.","exampleTranslation":"Anh ấy lau bàn bằng vải thô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"crystal":{"definition":"Pha lê; đồ pha lê.","example":"She bought a crystal vase for the table.","exampleTranslation":"Cô ấy đã mua một bình pha lê cho bàn ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"crystalline":{"definition":"Kết tinh.","example":"The lake had a crystalline surface at dawn.","exampleTranslation":"Mặt hồ có bề mặt kết tinh vào lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"crystallize":{"definition":"Kết tinh.","example":"The liquid will crystallize overnight.","exampleTranslation":"Chất lỏng sẽ kết tinh qua đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"cyanide":{"definition":"Xyanua.","example":"Never touch cyanide without proper training.","exampleTranslation":"Đừng bao giờ chạm vào xyanua mà không được đào tạo bài bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"detent":{"definition":"Cái hãm, cái khoá dừng; cái móc, cái chốt.","example":"The detent kept the drawer from sliding open.","exampleTranslation":"Cái móc giữ cho ngăn kéo không bị trượt ra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"dissolve":{"definition":"Hoà tan; làm tan ra.","example":"Sugar will dissolve quickly in a cup of warm water.","exampleTranslation":"Đường sẽ hòa tan nhanh chóng trong một cốc nước ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"dyes":{"definition":"Động từ chia ở ngôi thứ ba số ít của dye","example":"This soap dyes cloth very quickly.","exampleTranslation":"Loại xà phòng này nhuộm vải rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"enamel":{"definition":"Bức vẽ trên men.","example":"She admired the old enamel in the museum.","exampleTranslation":"Cô ấy ngưỡng mộ bức vẽ trên men cũ trong bảo tàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"etch":{"definition":"Khắc axit.","example":"They etch a design into the glass.","exampleTranslation":"Họ khắc một thiết kế lên mặt kính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"extraction":{"definition":"Sự rút ra (nguyên tắc, sự thích thú.","example":"He enjoyed the extraction of meaning from text.","exampleTranslation":"Anh ấy thích sự rút ra ý nghĩa từ văn bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"fabric":{"definition":"Giàn khung, kết cấu, cơ cấu ((nghĩa đen) & (nghĩa bóng)).","example":"Poverty tears at the fabric of our society.","exampleTranslation":"Sự nghèo đói làm rách nát kết cấu của xã hội chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"fibre":{"definition":"Sợi phíp.","example":"The fabric is made of pure cotton fibre.","exampleTranslation":"Vải được làm từ sợi bông nguyên chất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"fibrous":{"definition":"Có sợi, có thớ, có xơ.","example":"The plant has fibrous roots.","exampleTranslation":"Cây có rễ có sợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"filler":{"definition":"Người làm đẫy; cái để làm đẫy, cái để nhồi đầy.","example":"The cake filler made it larger and softer.","exampleTranslation":"Cái để làm đẫy bánh đã làm cho nó to hơn và mềm hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"fixative":{"definition":"Thuốc hãm (màu).","example":"The artist used a fixative to protect the color.","exampleTranslation":"Người nghệ sĩ đã sử dụng một loại thuốc hãm để bảo vệ màu sắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"flask":{"definition":"Hũ rượu có vỏ mây đan.","example":"He poured tea from the flask at lunch.","exampleTranslation":"Anh ấy đã rót trà từ hũ rượu có vỏ mây đan vào bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"foam":{"definition":"Bọt (nước biển, bia... ).","example":"Sea foam covered the shore after the storm.","exampleTranslation":"Bọt biển đã bao phủ bờ sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"fragile":{"definition":"Dễ vỡ, dễ gãy, dễ gẫy, dễ hỏng; mỏng mảnh, mỏng manh (nghĩa đen và nghĩa bóng).","example":"Please handle that fragile glass vase with great care.","exampleTranslation":"Vui lòng xử lý chiếc bình thủy tinh dễ vỡ đó với sự cẩn thận tuyệt đối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"fuller":{"definition":"Thợ chuội và hồ vải.","example":"The fuller cleaned and softened the cloth.","exampleTranslation":"Người thợ chuội và hồ vải đã làm sạch và làm mềm tấm vải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"glass":{"definition":"Đồ dùng bằng thuỷ tinh (nói chung).","example":"She packed the glass carefully in a box.","exampleTranslation":"Cô ấy đã đóng gói đồ dùng bằng thuỷ tinh cẩn thận vào trong một cái hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"globule":{"definition":"Viên nhỏ, giọt.","example":"A globule of water slid down the glass.","exampleTranslation":"Một giọt nước trượt xuống mặt kính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"glue":{"definition":"Keo hồ.","example":"She used glue to fix the broken cup.","exampleTranslation":"Cô ấy đã sử dụng keo hồ để sửa chiếc cốc bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"gold":{"definition":"Vàng.","example":"She wore a gold ring on her finger.","exampleTranslation":"Cô ấy đeo một chiếc nhẫn vàng trên ngón tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"hammer":{"definition":"Búa gỗ (cho người bán đấu giá).","example":"The auctioneer will bring the item to the hammer.","exampleTranslation":"Người bán đấu giá sẽ đưa món hàng đến với búa gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"harden":{"definition":"Làm chai điếng, làm cứng rắn, làm trở thành nhẫn tâm.","example":"Hard work can help to harden your resolve.","exampleTranslation":"Công việc khó khăn có thể giúp làm chai điếng quyết tâm của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"headspace":{"definition":"Khoảng cách (trong chai lọ, hộp thiết) để chứa thêm.","example":"Leave some headspace in the jar for air.","exampleTranslation":"Hãy chừa lại một chút khoảng cách trong lọ cho không khí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"hematite":{"definition":"Hematit.","example":"The rock contained bright red hematite.","exampleTranslation":"Tảng đá có chứa hematit màu đỏ sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"inert":{"definition":", (hoá học) trơ.","example":"The gas was inert in the tank.","exampleTranslation":"Khí đó trơ trong bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"insulate":{"definition":"Cô lập, cách ly.","example":"Good windows insulate the room from cold air.","exampleTranslation":"Cửa sổ tốt giúp cô lập căn phòng khỏi không khí lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"iodide":{"definition":"Ioddua.","example":"The medicine contains iodide for the test.","exampleTranslation":"Thuốc này chứa Ioddua cho bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"iridium":{"definition":"Iriddi.","example":"Iridium is rare and very hard.","exampleTranslation":"Iriddi rất hiếm và rất cứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"iron":{"definition":"Cứng cỏi, sắt đá.","example":"She had an iron will during hard times.","exampleTranslation":"Cô ấy có một ý chí sắt đá trong suốt thời gian khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"kiln":{"definition":"Lò (nung vôi, gạch... ).","example":"The bricks dried slowly in the kiln.","exampleTranslation":"Những viên gạch khô dần trong lò.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"lacquer":{"definition":"Đồ gỗ sơn.","example":"The table had a dark lacquer finish.","exampleTranslation":"Cái bàn có lớp hoàn thiện bằng đồ gỗ sơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"leather":{"definition":"Quả bóng đá; quả bóng crickê.","example":"He kicked the leather hard across the field.","exampleTranslation":"Anh ấy đá mạnh quả bóng da qua sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"liquid":{"definition":"Lỏng.","example":"The liquid result helped everyone.","exampleTranslation":"Kết quả lỏng đã giúp mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"lithium":{"definition":"Lithi.","example":"Lithium is used in some batteries.","exampleTranslation":"Lithi được sử dụng trong một số loại pin.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"lubrication":{"definition":"Sự tra dầu mỡ, sự bôi trơn.","example":"Regular lubrication keeps the machine quiet.","exampleTranslation":"Sự bôi trơn thường xuyên giữ cho máy móc yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"magnesium":{"definition":"Magiê.","example":"This pill contains magnesium for your body.","exampleTranslation":"Viên thuốc này chứa magiê cho cơ thể bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"mixing":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của mix.","example":"She is mixing sugar into the tea.","exampleTranslation":"Cô ấy đang pha đường vào trà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"mixture":{"definition":"Sự pha trộn, sự hỗn hợp.","example":"This paint is a mixture of blue and white.","exampleTranslation":"Loại sơn này là hỗn hợp của màu xanh và trắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"molecular":{"definition":"(Thuộc) phân tử.","example":"We studied molecular changes in the lab.","exampleTranslation":"Chúng tôi đã nghiên cứu những thay đổi phân tử trong phòng thí nghiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"needle":{"definition":"Cái kim; kim (la bàn... ).","example":"She tried to thread the needle very carefully.","exampleTranslation":"Cô ấy cố gắng xỏ kim rất cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"nozzle":{"definition":"Miệng, vòi (ấm).","example":"Water sprayed from the nozzle onto the floor.","exampleTranslation":"Nước phun từ miệng vòi xuống sàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"oxide":{"definition":"Oxyt.","example":"Rust is a common oxide on old metal.","exampleTranslation":"Rỉ sét là một loại oxyt phổ biến trên kim loại cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"paste":{"definition":"Cú đấm.","example":"He took a hard paste to the shoulder.","exampleTranslation":"Anh ấy đã phải chịu một cú đấm mạnh vào vai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"pellet":{"definition":"Cục tròn nổi (ở đồng tiền... ).","example":"A small pellet rested on the metal coin.","exampleTranslation":"Một cục tròn nhỏ nằm trên đồng tiền kim loại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"phosphate":{"definition":"Photphat.","example":"Plants need phosphate to grow well.","exampleTranslation":"Thực vật cần photphat để phát triển tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"pigment":{"definition":"Chất màu, chất nhuộm.","example":"The artist mixed a blue pigment.","exampleTranslation":"Người nghệ sĩ đã pha một chất màu xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"plastic":{"definition":"Dẻo, nặn được.","example":"This clay is very plastic and easy to shape.","exampleTranslation":"Loại đất sét này rất dẻo và dễ nặn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"platinum":{"definition":"Platin, bạch kim.","example":"The ring was made of platinum and gold.","exampleTranslation":"Chiếc nhẫn được làm bằng bạch kim và vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"pneumatic":{"definition":"Khí, (thuộc) hơi.","example":"The bike had pneumatic tires for a smoother ride.","exampleTranslation":"Chiếc xe đạp có lốp khí để đi êm ái hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"potassium":{"definition":"Kali.","example":"Bananas are rich in potassium.","exampleTranslation":"Chuối rất giàu kali.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"powder":{"definition":"Bột; bụi.","example":"Dust turned the old box to powder.","exampleTranslation":"Bụi biến chiếc hộp cũ thành bột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"refine":{"definition":"Lọc, lọc trong, luyện tinh, tinh chế.","example":"Factories refine gold into pure bars for sale.","exampleTranslation":"Các nhà máy tinh chế vàng thành các thỏi nguyên chất để bán.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"resin":{"definition":"Nhựa (cây).","example":"The tree secreted resin along the broken branch.","exampleTranslation":"Cây đã tiết ra nhựa dọc theo cành cây bị gãy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"resinous":{"definition":"Nhựa; giống nhựa.","example":"The resinous wood left a sticky smell.","exampleTranslation":"Loại gỗ có nhựa để lại một mùi dính dính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"rubber":{"definition":"Cái tẩy.","example":"I used a rubber to fix the mistake.","exampleTranslation":"Tôi đã dùng cái tẩy để sửa lỗi sai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"silicate":{"definition":"Silicat.","example":"The rock contained much silicate.","exampleTranslation":"Tảng đá chứa nhiều silicat.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"silicone":{"definition":"Silicon.","example":"Silicone seals the edge of the window.","exampleTranslation":"Silicon trám kín cạnh cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"silk":{"definition":"Luật sư hoàng gia (Anh).","example":"The lawyer worked hard to take silk in court.","exampleTranslation":"Luật sư đã làm việc chăm chỉ để đạt địa vị luật sư hoàng gia tại tòa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"silver":{"definition":"Đồng tiền.","example":"He found a silver in his coat pocket.","exampleTranslation":"Anh ấy tìm thấy một đồng tiền trong túi áo khoác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"solder":{"definition":"Hợp kim (để) hàn, chất hàn.","example":"The worker used hard solder to fix the pipe.","exampleTranslation":"Người công nhân dùng chất hàn cứng để sửa đường ống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"solid":{"definition":"Vững chắc, rắn chắc, chắc nịch.","example":"They built a solid house on this hill.","exampleTranslation":"Họ xây một ngôi nhà vững chắc trên ngọn đồi này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"steel":{"definition":"Gươm, kiếm.","example":"The knight drew his steel from the scabbard.","exampleTranslation":"Hiệp sĩ rút gươm khỏi vỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"strand":{"definition":"Tao (của dây).","example":"A strand of hair fell over her eye.","exampleTranslation":"Một tao tóc rơi xuống mắt cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"strontium":{"definition":"Stronti.","example":"Strontium is used in some fireworks.","exampleTranslation":"Stronti được sử dụng trong một số pháo hoa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"substance":{"definition":"Của cải; tài sản.","example":"He is a man of substance and wealth.","exampleTranslation":"Ông ấy là một người có của cải và sự giàu có.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"sulphur":{"definition":"Lưu huỳnh.","example":"Sulphur has a strong smell when burned.","exampleTranslation":"Lưu huỳnh có mùi nồng khi bị đốt cháy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"talc":{"definition":"Xoa bột tan.","example":"She talc the baby's skin after the bath.","exampleTranslation":"Cô ấy xoa bột tan cho da em bé sau khi tắm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"talcum":{"definition":"Đá tan.","example":"She dusted her skin with talcum before bed.","exampleTranslation":"Cô ấy phủ đá tan lên da trước khi đi ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"thread":{"definition":"Chỉ, sợi chỉ, sợi dây.","example":"She used a thin silk thread to sew the dress.","exampleTranslation":"Cô ấy đã sử dụng một sợi chỉ lụa mỏng để may chiếc váy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"timber":{"definition":"Gỗ làm nhà, gỗ kiến trúc, gỗ.","example":"They used rough timber to build the fence.","exampleTranslation":"Họ sử dụng gỗ kiến trúc thô để xây hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"uncoated":{"definition":"Không mặc áo khoác, không mặc áo choàng.","example":"He wore an uncoated jacket in the rain.","exampleTranslation":"Anh ấy mặc một chiếc áo khoác không được tráng lớp phủ trong mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"veneer":{"definition":"Mã, bề ngoài, vỏ ngoài.","example":"He put a thin veneer of gold on the table.","exampleTranslation":"Anh ấy đã phủ một lớp mỏng bề ngoài bằng vàng lên mặt bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"waterproof":{"definition":"Không thấm nước.","example":"This waterproof bag kept my phone dry.","exampleTranslation":"Chiếc túi không thấm nước này đã giữ điện thoại của tôi khô ráo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"waxy":{"definition":"Giống sáp; có màu sáp, vàng nhợt nhạt.","example":"His face looked waxy under the bright lights.","exampleTranslation":"Khuôn mặt anh ta trông giống sáp dưới ánh sáng rực rỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"webbing":{"definition":"Vi làm đai.","example":"The bag has strong webbing for the shoulder strap.","exampleTranslation":"Chiếc túi có vi làm đai chắc chắn cho dây đeo vai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"wire":{"definition":"Dây (kim loại).","example":"They used silver wire to fix the fence.","exampleTranslation":"Họ dùng dây kim loại để sửa hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"wood":{"definition":"rừng.","example":"We took a long walk through the dark wood.","exampleTranslation":"Chúng tôi đã đi bộ một quãng đường dài xuyên qua khu rừng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"materials-science"},"wooden":{"definition":"Cứng đờ; đờ đẫn; vụng, lúng túng.","example":"He gave me a wooden stare during the meeting.","exampleTranslation":"Anh ấy nhìn tôi với vẻ mặt đờ đẫn trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"materials-science"},"zinc":{"definition":"Tráng kẽm, mạ kẽm.","example":"They need to zinc the iron gates now.","exampleTranslation":"Họ cần mạ kẽm các cổng sắt ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"materials-science"},"afternoon":{"definition":"Buổi chiều.","example":"They decided to go for a walk this afternoon.","exampleTranslation":"Họ quyết định đi dạo vào buổi chiều này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"afterward":{"definition":"Sau này, về sau, sau đấy, sau đó, rồi thì.","example":"He arrived home and ate dinner soon afterward.","exampleTranslation":"Anh ấy về nhà và ăn tối ngay sau đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"time-sequence"},"beforehand":{"definition":"Sẵn sàng trước.","example":"You should always make your plans beforehand.","exampleTranslation":"Bạn nên luôn luôn lập kế hoạch sẵn sàng trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"time-sequence"},"daily":{"definition":"Hằng ngày.","example":"I go for a walk on a daily basis.","exampleTranslation":"Tôi đi dạo trên cơ sở hằng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"date":{"definition":"Ngày tháng; niên hiệu, niên kỷ.","example":"What is the date today in this month?","exampleTranslation":"Hôm nay là ngày tháng mấy trong tháng này?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"dawn":{"definition":"Bình minh, rạng đông, lúc sáng tinh mơ.","example":"They worked hard from dawn until late evening.","exampleTranslation":"Họ làm việc chăm chỉ từ bình minh cho đến tối muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"daylight":{"definition":"Khoảng trống, khoảng cách giữa hai vật gì, như giữa hai con thuyền trong cuộc đua, giữa ngấn rượu với mép cốc... ).","example":"There is no daylight between the two ships.","exampleTranslation":"Không có khoảng cách giữa hai con tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"duration":{"definition":"Thời gian, khoảng thời gian (tồn tại của một sự việc).","example":"Please stay here for the duration of the trip.","exampleTranslation":"Vui lòng ở lại đây trong suốt khoảng thời gian chuyến đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"eventual":{"definition":"Ngộ xảy ra, có thể xảy ra.","example":"The eventual outcome was better than expected.","exampleTranslation":"Kết quả ngộ xảy ra tốt hơn mong đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"eventually":{"definition":"cuối cùng; rốt cuộc","example":"I'll clean out my closet eventually.","exampleTranslation":"Tôi sẽ dọn dẹp tủ quần áo của mình cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"time-sequence"},"hourly":{"definition":"Hằng giờ, từng giờ, mỗi giờ một lần.","example":"The train provides an hourly service for commuters.","exampleTranslation":"Chuyến tàu cung cấp dịch vụ hằng giờ cho những người đi làm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"immediate":{"definition":"Trực tiếp.","example":"There was an immediate cause for the fire.","exampleTranslation":"Có một nguyên nhân trực tiếp dẫn đến vụ hỏa hoạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"immediately":{"definition":"ngay lập tức","example":"One car went by, immediately followed by a second at high speed.","exampleTranslation":"Một chiếc xe chạy ngang qua, ngay lập tức nối tiếp bởi chiếc thứ hai ở tốc độ cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"time-sequence"},"interval":{"definition":"Khoảng cách, cự ly.","example":"The fence marks the interval between the trees.","exampleTranslation":"Hàng rào đánh dấu khoảng cách giữa các cái cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"midday":{"definition":"Trưa, buổi trưa.","example":"We usually eat our midday meal at noon.","exampleTranslation":"Chúng tôi thường ăn bữa trưa vào buổi trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"midnight":{"definition":"Nửa đêm, mười hai giờ đêm.","example":"Midnight arrived before the train did.","exampleTranslation":"Nửa đêm đã đến trước khi chuyến tàu tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"nowadays":{"definition":"Ngày nay, đời nay, thời buổi này, thời buổi tân tiến này.","example":"Nowadays is the best time to learn online.","exampleTranslation":"Ngày nay là thời điểm tốt nhất để học trực tuyến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"overnight":{"definition":"Một đêm, có giá trị trong một đêm.","example":"She was an invited overnight guest last night.","exampleTranslation":"Cô ấy là một vị khách được mời ở lại qua đêm tối qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"recent":{"definition":"Gần đây, xảy ra gần đây, mới đây, mới xảy ra.","example":"I read a recent news report about the storm.","exampleTranslation":"Tôi đã đọc một bản tin gần đây về cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"recently":{"definition":"Gần đây, mới đây.","example":"I have seen him at the park recently.","exampleTranslation":"Tôi đã thấy anh ấy ở công viên gần đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"time-sequence"},"temporary":{"definition":"Tạm thời, nhất thời, lâm thời.","example":"They achieved only temporary success with their new plan.","exampleTranslation":"Họ chỉ đạt được thành công tạm thời với kế hoạch mới của họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"tomorrow":{"definition":"Mai, ngày mai.","example":"It may rain tomorrow so bring your umbrella.","exampleTranslation":"Ngày mai có thể mưa nên hãy mang theo ô của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"time-sequence"},"weekend":{"definition":"Cuối tuần (thứ bảy và chủ nhật).","example":"We spent the weekend at home.","exampleTranslation":"Chúng tôi dành cuối tuần ở nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"time-sequence"},"weekly":{"definition":"Hằng tuần.","example":"I receive my weekly wage every Friday morning.","exampleTranslation":"Tôi nhận lương hằng tuần vào mỗi sáng thứ Sáu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"yearly":{"definition":"Kéo dài một năm, suốt một năm.","example":"The house is on a yearly letting agreement.","exampleTranslation":"Ngôi nhà có thỏa thuận cho thuê hằng năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"time-sequence"},"yesterday":{"definition":"Hôm qua.","example":"I saw him at the park yesterday morning.","exampleTranslation":"Tôi đã thấy anh ấy ở công viên vào sáng hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"time-sequence"},"abreast":{"definition":"Cùng hàng, sóng hàng, ngang nhau; sát nhau, sát vai, bên cạnh.","example":"The two soldiers walked abreast down the street.","exampleTranslation":"Hai người lính bước đi sóng hàng dọc theo con phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"abrupt":{"definition":"Bất ngờ, đột ngột; vội vã.","example":"The car made an abrupt turn on the road.","exampleTranslation":"Chiếc xe đã thực hiện một cú rẽ đột ngột trên đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"abruptly":{"definition":"Bất ngờ, đột ngột.","example":"She answered abruptly and smiled.","exampleTranslation":"Cô ấy trả lời một cách đột ngột rồi mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"absolute":{"definition":"Tuyệt đối, hoàn toàn; thuần tuý, nguyên chất.","example":"She has absolute confidence in her own ability.","exampleTranslation":"Cô ấy có niềm tin tuyệt đối vào khả năng của chính mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"absurd":{"definition":"Vô lý.","example":"That excuse sounds absurd to me.","exampleTranslation":"Lời bào chữa đó nghe thật vô lý đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"absurdity":{"definition":"Sự vô lý; sự ngu xuẩn, sự ngớ ngẩn.","example":"He kept the absurdity on the desk.","exampleTranslation":"Anh ấy để sự vô lý đó ở trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"accidentally":{"definition":"Tình cờ, ngẫu nhiên.","example":"He moved accidentally through the crowd.","exampleTranslation":"Anh ấy tình cờ di chuyển qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"accordingly":{"definition":"Do đó, vì vậy, cho nên.","example":"They worked accordingly all day.","exampleTranslation":"Họ đã làm việc một cách phù hợp suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"actual":{"definition":"Thật sự, thật, thực tế, có thật.","example":"The actual cost was higher than we expected.","exampleTranslation":"Chi phí thực tế cao hơn chúng tôi mong đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"actually":{"definition":"thực sự, thực tế","example":"Actually, I had nothing to do with that incident.","exampleTranslation":"Thực sự thì tôi không có gì liên quan đến vụ việc đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"added":{"definition":"Quá khứ và phân từ quá khứ của add","example":"She added a note to the bottom of the page.","exampleTranslation":"Cô ấy đã thêm một ghi chú vào cuối trang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"adding":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của add.","example":"Adding sugar makes the tea taste sweeter.","exampleTranslation":"Việc thêm đường làm cho trà có vị ngọt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"addition":{"definition":"Sự thêm, phần thêm.","example":"A new addition to the family arrived last week.","exampleTranslation":"Một thành viên mới thêm vào gia đình đã đến tuần trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"additional":{"definition":"Thêm vào, phụ vào, tăng thêm.","example":"Is there an additional charge for the luggage?","exampleTranslation":"Có tính thêm phí cho hành lý không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"adds":{"definition":"Động từ chia ở ngôi thứ ba số ít của add","example":"He adds milk before pouring the coffee.","exampleTranslation":"Anh ấy thêm sữa trước khi rót cà phê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"advantage":{"definition":"Sự thuận lợi, hoàn cảnh thuận lợi; mối lợi.","example":"Having a large garden is a great advantage.","exampleTranslation":"Có một khu vườn lớn là một sự thuận lợi tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"adverse":{"definition":"Bên kia, đối diện.","example":"Please turn to the adverse page of the book.","exampleTranslation":"Vui lòng lật sang trang bên kia của cuốn sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"ahead":{"definition":"Hơn, vượt.","example":"She wants to get ahead in her career.","exampleTranslation":"Cô ấy muốn vượt lên phía trước trong sự nghiệp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"alike":{"definition":"Giống, tương tự.","example":"The two answers were alike in meaning.","exampleTranslation":"Hai câu trả lời đó tương tự nhau về nghĩa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"alongside":{"definition":"Song song với, cùng, đồng thời.","example":"She stood alongside her friend at the gate.","exampleTranslation":"Cô ấy đứng song song với bạn mình tại cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"alter":{"definition":"Thay đổi, biến đổi, đổi.","example":"We need to alter the plan for better results.","exampleTranslation":"Chúng ta cần thay đổi kế hoạch để có kết quả tốt hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"alteration":{"definition":"Sự sửa quần áo; sự may quần áo.","example":"The tailor made an alteration to the coat.","exampleTranslation":"Người thợ may đã thực hiện một sự sửa quần áo cho chiếc áo khoác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"alternate":{"definition":"So le.","example":"Please choose an alternate angle for the photo.","exampleTranslation":"Vui lòng chọn một góc so le cho bức ảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"alternative":{"definition":"Vật thay thế.","example":"Is there an alternative way to reach the city?","exampleTranslation":"Có một cách thay thế nào để đến thành phố không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"altogether":{"definition":"Người mẫu khoả thân (để vẽ...).","example":"The artist painted an altogether for the class.","exampleTranslation":"Người nghệ sĩ đã vẽ một người mẫu khoả thân cho cả lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"amaze":{"definition":"Làm kinh ngạc, làm sửng sốt, làm hết sức ngạc nhiên.","example":"Her quick idea can amaze the whole class.","exampleTranslation":"Ý tưởng nhanh nhẹn của cô ấy có thể làm kinh ngạc cả lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"amidst":{"definition":"Giữa, ở giữa ((nghĩa đen) & (nghĩa bóng)).","example":"She stayed calm amidst the loud noise.","exampleTranslation":"Cô ấy giữ bình tĩnh giữa tiếng ồn lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"E","posGroup":"other","family":"general-reading"},"amongst":{"definition":"Giữa, ở giữa.","example":"He was sitting amongst friends at lunch.","exampleTranslation":"Anh ấy đang ngồi giữa bạn bè vào bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"E","posGroup":"other","family":"general-reading"},"ample":{"definition":"Rộng, lụng thụng.","example":"There was ample space for everyone to sit.","exampleTranslation":"Có độ rộng đủ cho mọi người ngồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"anti":{"definition":"Chống lại.","example":"The room felt anti after cleaning.","exampleTranslation":"Căn phòng cảm thấy chống lại sau khi dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"anyplace":{"definition":"Giống anywhere.","example":"You can sit anyplace you like.","exampleTranslation":"Bạn có thể ngồi bất kỳ chỗ nào bạn thích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"anywhere":{"definition":"Bất kỳ chỗ nào, bất cứ nơi đâu.","example":"You can put your bag anywhere in this room.","exampleTranslation":"Bạn có thể đặt túi của mình bất cứ nơi đâu trong căn phòng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"apart":{"definition":"Về một bên, qua một bên; riêng ra, xa ra.","example":"She tried to hold herself apart from them.","exampleTranslation":"Cô ấy cố gắng giữ bản thân riêng ra khỏi họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"apparent":{"definition":"rõ ràng, bày tỏ ra ngoài, thấy rõ ra ngoài.","example":"The damage was apparent to the naked eyes.","exampleTranslation":"Sự thiệt hại thấy rõ ra ngoài bằng mắt thường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"apparently":{"definition":"hình như; có vẻ như; rõ ràng là","example":"Oil prices fell this week to their lowest level in fourteen months, apparently because of over-production.","exampleTranslation":"Giá dầu giảm trong tuần này xuống mức thấp nhất trong mười bốn tháng, hình như do sản xuất quá mức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"appear":{"definition":"Trình diện; ra mắt.","example":"The suspect will appear before a judge soon.","exampleTranslation":"Nghi phạm sẽ trình diện trước thẩm phán sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"appearance":{"definition":"Sự xuất hiện, sự hiện ra sự ló ra.","example":"She made her first appearance on the stage.","exampleTranslation":"Cô ấy đã có sự xuất hiện đầu tiên trên sân khấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"applicable":{"definition":"Có thể dùng được, có thể áp dụng được, có thể ứng dụng được.","example":"This rule is applicable to most school projects.","exampleTranslation":"Quy định này có thể áp dụng được cho hầu hết các dự án trường học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"apply":{"definition":"Gắn vào, áp vào, ghép vào, đính vào, đắp vào, tra vào.","example":"Please apply the cream to your skin every morning.","exampleTranslation":"Vui lòng áp vào kem lên da bạn mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"appropriate":{"definition":"Chiếm hữu, chiếm đoạt (làm của riêng).","example":"The company might appropriate the land for building.","exampleTranslation":"Công ty có thể chiếm hữu khu đất để xây dựng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"appropriately":{"definition":"Thích hợp, thích đáng.","example":"I read the note appropriately.","exampleTranslation":"Tôi đọc ghi chú một cách thích hợp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"appropriateness":{"definition":"Sự thích hợp, sự thích đáng.","example":"The choice's appropriateness was clear.","exampleTranslation":"Sự thích hợp của lựa chọn rất rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"arise":{"definition":"Xuất hiện, nảy sinh ra, xảy ra.","example":"Problems arise when people stop listening.","exampleTranslation":"Vấn đề nảy sinh khi mọi người ngừng lắng nghe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"arrange":{"definition":"Thu xếp; chuẩn bị.","example":"I will arrange a meeting for next Tuesday.","exampleTranslation":"Tôi sẽ thu xếp một cuộc họp vào thứ Ba tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"arrangement":{"definition":"Sự sắp xếp, sự sắp đặt, cái được sắp xếp, cái được sắp đặt.","example":"We made an arrangement for dinner at seven.","exampleTranslation":"Chúng tôi đã có một sự sắp xếp cho bữa tối lúc bảy giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"arrow":{"definition":"Tên, mũi tên.","example":"An arrow pointed to the door.","exampleTranslation":"Một mũi tên chỉ vào cánh cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ascent":{"definition":"Sự trèo lên, sự đi lên, sự lên.","example":"The balloon began its slow ascent into the clouds.","exampleTranslation":"Khinh khí cầu bắt đầu sự trèo lên chậm chạp vào những đám mây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"aside":{"definition":"lời nói một mình; lời nói riêng (không để cho diễn viên khác nghe thấy).","example":"He whispered an aside to the actor beside him.","exampleTranslation":"Anh ấy thì thầm một lời nói riêng với diễn viên bên cạnh mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"assortment":{"definition":"Sự phân hạng, sự phân loại, sự sắp xếp thành loại.","example":"The shop offers a wide assortment of teas.","exampleTranslation":"Cửa hàng cung cấp một sự phân loại rộng các loại trà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"assurance":{"definition":"Sự chắc chắn; sự tin chắc; điều chắc chắn, điều tin chắc.","example":"I have assurance that the bus will come.","exampleTranslation":"Tôi có sự tin chắc rằng xe buýt sẽ đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"assure":{"definition":"Làm cho vững tâm, làm cho tin chắc.","example":"I assure you, the door is locked.","exampleTranslation":"Tôi làm cho bạn vững tâm, cánh cửa đã khoá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"autumn":{"definition":"Thời xế chiều (thời kỳ bắt đầu suy tàn).","example":"In autumn, his career entered its quiet end.","exampleTranslation":"Vào thời xế chiều, sự nghiệp của anh ấy đã đi đến hồi kết lặng lẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"avert":{"definition":"Quay đi, ngoảnh đi.","example":"You should avert your eyes from that scary movie.","exampleTranslation":"Bạn nên quay ánh mắt đi khỏi bộ phim đáng sợ đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"avoid":{"definition":"Tránh, tránh xa.","example":"Try to avoid smoking for a healthier life.","exampleTranslation":"Hãy cố gắng tránh hút thuốc để có một cuộc sống khỏe mạnh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"avoidance":{"definition":"Chỗ khuyết (chức vụ).","example":"The office had a vacancy after his avoidance.","exampleTranslation":"Văn phòng đã có một chỗ khuyết sau sự né tránh của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"awash":{"definition":"Vị ngữ trôi nổi trên mặt nước.","example":"The deck was awash after the storm.","exampleTranslation":"Boong tàu bị ngập nước sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"awesome":{"definition":"Đáng kinh sợ; làm khiếp sợ; làm kinh hoàng.","example":"The view from the mountain top was awesome.","exampleTranslation":"Khung cảnh từ trên đỉnh núi thật đáng kinh sợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"awry":{"definition":"Xiên, méo, lệch.","example":"The picture on the wall is slightly awry.","exampleTranslation":"Bức tranh trên tường hơi bị xiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"backtrack":{"definition":"Quay về theo lối cũ.","example":"We had to backtrack after missing the turn.","exampleTranslation":"Chúng tôi phải quay về theo lối cũ sau khi bỏ lỡ ngã rẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bagged":{"definition":"Quá khứ và phân từ quá khứ của bag","example":"She bagged the apples for market.","exampleTranslation":"Cô ấy đã đóng túi những quả táo để đưa ra chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bags":{"definition":"Động từ chia ở ngôi thứ ba số ít của bag","example":"He bags the groceries after work.","exampleTranslation":"Anh ấy đóng túi các món hàng tạp hóa sau giờ làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bait":{"definition":"Bate.","example":"The bait looked fresh and easy to smell.","exampleTranslation":"Bate trông tươi và dễ ngửi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"balloon":{"definition":"Khí cầu, quả bóng.","example":"A colorful balloon floated high in the sky.","exampleTranslation":"Một quả bóng khí cầu đầy màu sắc bay lơ lửng trên bầu trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bang":{"definition":"Tiếng sập mạnh; tiếng nổ lớn.","example":"He closed the door with a loud bang.","exampleTranslation":"Anh ấy đóng cửa với một tiếng sập mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bare":{"definition":"Trần, trần truồng, trọc.","example":"The man walked outside with his head bare.","exampleTranslation":"Người đàn ông đi ra ngoài với cái đầu trần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"bark":{"definition":"Tiếng súng nổ.","example":"We heard the bark of a gun nearby.","exampleTranslation":"Chúng tôi nghe thấy tiếng súng nổ gần đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"barred":{"definition":"Có vạch kẻ dọc.","example":"He held a barred cardboard sign in the street.","exampleTranslation":"Anh ấy cầm một tấm biển các tông có vạch kẻ dọc trên phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"barrier":{"definition":"Đặt vật chướng ngại (để chặn, phòng thủ).","example":"They barrier the gate at night.","exampleTranslation":"Họ đặt vật chướng ngại ở cổng vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bars":{"definition":"Động từ chia ở ngôi thứ ba số ít của bar","example":"The gate bars animals from entering.","exampleTranslation":"Cánh cổng chặn không cho động vật tiến vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"base":{"definition":"Căn cứ.","example":"The soldiers were stationed at the secret air base.","exampleTranslation":"Những người lính đã đóng quân tại căn cứ không quân bí mật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bash":{"definition":"Đánh mạnh, va mạnh, đập mạnh.","example":"He had to bash the lid of the box.","exampleTranslation":"Anh ấy phải đập mạnh nắp hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bate":{"definition":"Bớt, giảm bớt, trừ bớt.","example":"You should try to bate your curiosity for now.","exampleTranslation":"Bạn nên cố gắng bớt sự tò mò của mình ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bear":{"definition":"Chịu, chịu đựng.","example":"I can bear the heavy weight of this box.","exampleTranslation":"Tôi có thể chịu đựng được trọng lượng nặng của chiếc hộp này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"beat":{"definition":"Sự đập; tiếng đập.","example":"I can hear the steady beat of a drum.","exampleTranslation":"Tôi có thể nghe thấy tiếng đập đều đặn của cái trống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"become":{"definition":"Trở nên, trở thành.","example":"It has become much warmer since last week.","exampleTranslation":"Trời đã trở nên ấm hơn nhiều kể từ tuần trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bedecking":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của bedeck.","example":"She is bedecking the table with flowers.","exampleTranslation":"Cô ấy đang tô điểm chiếc bàn bằng những bông hoa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"begin":{"definition":"bắt đầu, khởi đầu, mở đầu","example":"We will begin the lesson after lunch.","exampleTranslation":"Chúng tôi sẽ bắt đầu bài học sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"beneath":{"definition":"Ở dưới; kém, thấp kém.","example":"The treasure was hidden beneath the old floor.","exampleTranslation":"Kho báu đã bị giấu ở dưới sàn nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"E","posGroup":"other","family":"general-reading"},"besides":{"definition":"Ngoài ra, hơn nữa, vả lại, vả chăng.","example":"She plays the piano and several other instruments besides.","exampleTranslation":"Cô ấy chơi piano và ngoài ra còn nhiều nhạc cụ khác nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"betoken":{"definition":"Báo hiệu, chỉ rõ.","example":"The dark clouds betoken rain.","exampleTranslation":"Những đám mây đen báo hiệu trời sắp mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"beyond":{"definition":"The beyond kiếp sau, thế giới bên kia.","example":"She wondered about life beyond.","exampleTranslation":"Cô ấy tự hỏi về cuộc sống ở thế giới bên kia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bigger":{"definition":"so sánh hơn của big","example":"This box is bigger than that one.","exampleTranslation":"Chiếc hộp này to hơn cái kia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"bind":{"definition":"Trói, buộc, bó lại.","example":"They had to bind his hands and feet tightly.","exampleTranslation":"Họ đã phải trói tay và chân anh ấy lại thật chặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bizarre":{"definition":"Kỳ quái, kỳ lạ, kỳ dị.","example":"The room had a bizarre smell and look.","exampleTranslation":"Căn phòng có một mùi và vẻ ngoài kỳ quái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"bland":{"definition":"Có cử chỉ dịu dàng, lễ phép.","example":"She gave a bland smile and left quietly.","exampleTranslation":"Cô ấy nở một nụ cười dịu dàng rồi lặng lẽ rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"blank":{"definition":"Trống rỗng; ngây ra, không có thần (cái nhìn...).","example":"He stared at me with a blank expression.","exampleTranslation":"Anh ấy nhìn chằm chằm vào tôi với một vẻ mặt trống rỗng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"blemish":{"definition":"Tật; nhược điểm, thiếu sót.","example":"There was a small blemish on the apple.","exampleTranslation":"Có một tật nhỏ trên quả táo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"blend":{"definition":"Hợp nhau (màu sắc).","example":"These two colors blend well together in this painting.","exampleTranslation":"Hai màu này hợp nhau trong bức tranh này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"blur":{"definition":"Cảnh mờ, dáng mập mờ; trạng thái mập mờ.","example":"The hill was only a blur in the fog.","exampleTranslation":"Ngọn đồi chỉ là một cảnh mờ trong sương mù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"boggle":{"definition":"Chùn lại; do dự, lưỡng lự, ngần ngại.","example":"He did boggle at the huge price.","exampleTranslation":"Anh ấy đã do dự trước mức giá quá lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bold":{"definition":"Dũng cảm, táo bạo, cả gan.","example":"It was bold to speak in class.","exampleTranslation":"Thật táo bạo khi phát biểu trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"bolster":{"definition":"Gối ống (ở đầu giường).","example":"She leaned on a soft bolster.","exampleTranslation":"Cô ấy dựa vào một cái gối ống mềm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"boob":{"definition":"Người ngốc nghếch, người khờ dại.","example":"Don't be a boob and forget your keys.","exampleTranslation":"Đừng là một người ngốc nghếch mà quên chìa khóa của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"boring":{"definition":"Sự khoan, sự đào.","example":"The boring made a clean hole through the wood.","exampleTranslation":"Sự khoan đã tạo ra một lỗ thủng sạch qua gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bounce":{"definition":", (từ lóng) sự đuổi ra, sự tống cổ ra, sự thải hồi.","example":"He got the bounce after staying too late.","exampleTranslation":"Anh ấy bị tống cổ ra ngoài sau khi ở lại quá muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"boundless":{"definition":"Bao la, bát ngát, vô hạn, không bờ bến.","example":"The children played in the boundless ocean.","exampleTranslation":"Những đứa trẻ chơi đùa trong đại dương bao la.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"break":{"definition":"Xe ngựa không mui.","example":"He rode in a break behind the team.","exampleTranslation":"Anh ấy đã đi trong một chiếc xe ngựa không mui phía sau đoàn xe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"breezily":{"definition":"Hiu hiu.","example":"The team finished breezily and left.","exampleTranslation":"Cả đội đã hoàn thành công việc một cách hiu hiu rồi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"bright":{"definition":"Sáng, sáng chói.","example":"The bright sunshine warmed my face this morning.","exampleTranslation":"Ánh nắng sáng sưởi ấm khuôn mặt tôi sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"brilliant":{"definition":"Sáng rực đến lóa mắt, sáng chói, rực rỡ.","example":"The brilliant sunshine woke me up early this morning.","exampleTranslation":"Ánh nắng sáng rực đến lóa mắt đã đánh thức tôi dậy sớm sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"brisk":{"definition":"Nhanh, nhanh nhẩu, nhanh nhẹn; lanh lợi.","example":"We walked at a brisk pace toward the station.","exampleTranslation":"Chúng tôi đi bộ với tốc độ nhanh nhẹn về phía nhà ga.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"broad":{"definition":"Rộng.","example":"They walked down a broad street in the city.","exampleTranslation":"Họ đã đi bộ xuống một con đường rộng trong thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"broaden":{"definition":"Mở rộng, nới rộng, làm rộng ra.","example":"Travel can broaden your view of life.","exampleTranslation":"Du lịch có thể mở rộng tầm nhìn về cuộc sống của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"broadly":{"definition":"Rộng, rộng rãi.","example":"She answered broadly and smiled.","exampleTranslation":"Cô ấy đã trả lời một cách rộng rãi và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"broke":{"definition":"động từ quá khứ của break","example":"He broke the glass by accident.","exampleTranslation":"Anh ấy đã làm gãy chiếc ly do tình cờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"broken":{"definition":"Gãy, bể.","example":"Be careful because that glass vase is broken.","exampleTranslation":"Hãy cẩn thận vì chiếc bình thủy tinh đó đã bị bể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"brown":{"definition":"Đồng xu đồng.","example":"He found a small brown coin on the floor.","exampleTranslation":"Anh ấy tìm thấy một đồng xu đồng màu nâu trên sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"brush":{"definition":"Sự chải.","example":"Give your clothes a good brush before leaving.","exampleTranslation":"Hãy chải quần áo thật kỹ trước khi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bubble":{"definition":"Điều hão huyền, ảo tưởng.","example":"The plan turned out to be a bubble.","exampleTranslation":"Kế hoạch đã hóa ra chỉ là một điều hão huyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"budge":{"definition":"Chuyển, nhúc nhích, động đậy.","example":"The heavy door will not budge at all.","exampleTranslation":"Cánh cửa nặng nề sẽ không nhúc nhích chút nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"buildup":{"definition":"Tích tụ, dồn đống","example":"Snow buildup on roads makes for hazardous driving.","exampleTranslation":"Sự tích tụ tuyết trên đường làm cho việc lái xe trở nên nguy hiểm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bump":{"definition":"Cái bướu (biểu thị tài năng); tài năng, năng lực, khiếu.","example":"She has a natural bump for learning languages.","exampleTranslation":"Cô ấy có một khiếu tự nhiên cho việc học ngôn ngữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bums":{"definition":"Động từ chia ở ngôi thứ ba số ít của bum","example":"That old lamp bums too much electricity.","exampleTranslation":"Cái đèn cũ đó đốt quá nhiều điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"bunch":{"definition":"Búi, chùm, bó, cụm, buồng.","example":"I bought a large bunch of grapes.","exampleTranslation":"Tôi đã mua một chùm nho lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bundle":{"definition":"Đi vội.","example":"We need to bundle off before the storm.","exampleTranslation":"Chúng tôi cần phải đi vội trước khi cơn bão đến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"burgeon":{"definition":"Chồi (cây).","example":"A new burgeon appeared on the stem.","exampleTranslation":"Một chồi mới xuất hiện trên thân cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"bury":{"definition":"Chôn, chôn cất; mai táng.","example":"They bury the old box in the garden.","exampleTranslation":"Họ chôn cái hộp cũ trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"burst":{"definition":"Sự nổ tung, sự vỡ tung; tiếng nổ (bom).","example":"We heard a loud burst from the kitchen.","exampleTranslation":"Chúng tôi nghe thấy một tiếng nổ lớn từ phía nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"buzz":{"definition":"Tin đồn.","example":"There is a buzz about the new shop.","exampleTranslation":"Có một tin đồn về cửa hàng mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"calendar":{"definition":"Lịch (ghi năm tháng).","example":"We need to check the calendar for dates.","exampleTranslation":"Chúng ta cần kiểm tra lịch để xem các ngày tháng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"cancel":{"definition":"Lệnh ngược lại, phản lệnh.","example":"That cancel was used to stop the order.","exampleTranslation":"Lệnh ngược lại đó đã được sử dụng để hủy bỏ đơn hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"caps":{"definition":"Động từ chia ở ngôi thứ ba số ít của cap","example":"She caps her notes with a neat label.","exampleTranslation":"Cô ấy đóng các ghi chú của mình với một nhãn gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"carefully":{"definition":"cẩn thận; kỹ lưỡng","example":"Timmy, take that vase out in our room carefully.","exampleTranslation":"Timmy, hãy mang cái bình đó ra ngoài phòng của chúng ta thật cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"general-reading"},"cast":{"definition":"Loại, vẻ, nét, tính tình, tính chất; thiên hướng.","example":"He is a man of a different cast.","exampleTranslation":"Anh ấy là người đàn ông có tính tình khác biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"casually":{"definition":"Tình cờ, ngẫu nhiên.","example":"He moved casually through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách tình cờ qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"catch":{"definition":"Sự bắt, sự nắm lấy; cái bắt, cái vồ, cái chộp.","example":"He is considered a very good catch for her.","exampleTranslation":"Anh ấy được coi là một sự bắt lấy rất tốt cho cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"cautionary":{"definition":"Để báo trước, để cảnh cáo.","example":"The teacher gave a cautionary warning.","exampleTranslation":"Giáo viên đã đưa ra một lời cảnh báo để nhắc nhở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"cautious":{"definition":"Thận trọng, cẩn thận.","example":"Be cautious when crossing the busy street.","exampleTranslation":"Hãy thận trọng khi băng qua con đường đông đúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"cease":{"definition":"Dừng, ngừng, ngớt, thôi, hết, tạnh.","example":"The heavy rain will cease by this evening.","exampleTranslation":"Cơn mưa lớn sẽ tạnh vào tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"center":{"definition":"(như) centre.","example":"Please meet me at the center of town.","exampleTranslation":"Vui lòng gặp tôi ở trung tâm thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"central":{"definition":"Chính, chủ yếu, trung tâm.","example":"She is the central figure in the new movie.","exampleTranslation":"Cô ấy là nhân vật chính trong bộ phim mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"centre":{"definition":"Điểm giữa, tâm; trung tâm; trung khu; trung ương.","example":"The shop is located in the city centre.","exampleTranslation":"Cửa hàng nằm ở trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"certainly":{"definition":"Chắc, nhất định.","example":"You will certainly enjoy this delicious meal.","exampleTranslation":"Bạn chắc chắn sẽ thích bữa ăn ngon này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"certainty":{"definition":"Điều chắc chắn.","example":"It is a certainty that the sun will rise.","exampleTranslation":"Việc mặt trời sẽ mọc là một điều chắc chắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"chain":{"definition":"Dãy, chuỗi, loạt.","example":"A long chain of mountains sits in the distance.","exampleTranslation":"Một dãy núi dài nằm ở phía xa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"challenge":{"definition":"Tiếng hô \"đứng lại\" (của lính đứng gác).","example":"The guard gave the challenge at the gate.","exampleTranslation":"Người lính gác đã hô vang lệnh đứng lại ở cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"chance":{"definition":"Sự có thể, sự có khả năng, khả năng có thể.","example":"There is a small chance of rain today.","exampleTranslation":"Hôm nay có một khả năng nhỏ là trời sẽ mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"chaos":{"definition":"Thời đại hỗn nguyên, thời đại hỗn mang.","example":"The room fell into chaos after the alarm.","exampleTranslation":"Căn phòng rơi vào hỗn loạn sau khi chuông báo động reo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"chaotic":{"definition":"Hỗn độn, hỗn loạn, lộn xộn.","example":"The office felt chaotic after the power went out.","exampleTranslation":"Văn phòng trở nên hỗn loạn sau khi mất điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"character":{"definition":"Chí khí, nghị lực.","example":"He is a man of great character and strength.","exampleTranslation":"Anh ấy là một người đàn ông có chí khí và nghị lực tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"characteristic":{"definition":"Riêng, riêng biệt, đặc thù, đặc trưng.","example":"That smile is characteristic of her bright mood.","exampleTranslation":"Nụ cười đó là đặc trưng cho tâm trạng tươi sáng của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"characterize":{"definition":"Biểu thị đặc điểm, mô tả đặc điểm; định rõ đặc điểm.","example":"The report can characterize the problem clearly.","exampleTranslation":"Bản báo cáo có thể mô tả đặc điểm của vấn đề một cách rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"chase":{"definition":"Sự theo đuổi, sự đuổi theo, sự săn đuổi.","example":"The police were in chase of the thief.","exampleTranslation":"Cảnh sát đang trong cuộc truy đuổi tên trộm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"check":{"definition":"Sự mất vết, sự mất hơi.","example":"The runner came to a check during the race.","exampleTranslation":"Người chạy bộ đã dừng lại trong suốt cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"cherish":{"definition":"Giữ trong lòng, nuôi ấp ủ.","example":"You should cherish your hopes for the future.","exampleTranslation":"Bạn nên giữ trong lòng những hy vọng về tương lai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"chide":{"definition":"La rầy, mắng mỏ; quở trách, khiển trách.","example":"Please do not chide him for one mistake.","exampleTranslation":"Xin đừng quở trách anh ấy vì một sai lầm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"chiefly":{"definition":"chủ yếu; phần lớn","example":"This area is chiefly used for farming.","exampleTranslation":"Khu vực này chủ yếu được sử dụng cho việc canh tác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"choose":{"definition":"Chọn, lựa chọn, kén chọn.","example":"You should choose for yourself what to wear.","exampleTranslation":"Bạn nên tự chọn cho mình thứ để mặc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"chunking":{"definition":"Lớn; vụng về.","example":"The butcher cut a chunking piece of beef.","exampleTranslation":"Người bán thịt đã cắt một miếng bò lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"circle":{"definition":"Đường tròn, vòng tròn.","example":"Please draw a perfect circle on this paper.","exampleTranslation":"Vui lòng vẽ một đường tròn hoàn hảo trên tờ giấy này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"circulate":{"definition":"Lưu hành, truyền, truyền bá.","example":"The news will circulate quickly through the office.","exampleTranslation":"Tin tức sẽ sớm lưu hành nhanh chóng trong văn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"circumstance":{"definition":"Sự kiện, sự việc, chi tiết.","example":"No circumstance could change my final decision today.","exampleTranslation":"Không sự kiện nào có thể thay đổi quyết định cuối cùng của tôi hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"clothe":{"definition":"Mặc quần áo cho.","example":"They need to clothe the children for winter.","exampleTranslation":"Họ cần phải mặc quần áo cho những đứa trẻ vào mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"claim":{"definition":"Sự cho là.","example":"She made a claim about the old house.","exampleTranslation":"Cô ấy đã đưa ra một sự cho là về ngôi nhà cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"clang":{"definition":"Làm kêu vang, làm kêu lanh lảnh.","example":"The heavy bells clang loudly in the tower.","exampleTranslation":"Những cái chuông nặng làm kêu vang lanh lảnh trong tháp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"clearly":{"definition":"rõ ràng","example":"The building is clearly visible from the air.","exampleTranslation":"Tòa nhà có thể nhìn thấy rõ ràng từ trên không.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"clever":{"definition":"Giỏi, tài giỏi, khéo léo, lành nghề.","example":"That was a very clever workman at the site.","exampleTranslation":"Đó là một người thợ tài giỏi tại công trường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"climactic":{"definition":"Theo phép tiến dần.","example":"The climactic scene made everyone quiet.","exampleTranslation":"Cảnh quay theo phép tiến dần đó làm mọi người yên lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"climax":{"definition":"Đưa lên đến điểm cao nhất; lên đến điểm cao nhất.","example":"The song will climax with a loud chorus.","exampleTranslation":"Bài hát sẽ lên đến điểm cao nhất với một đoạn điệp khúc lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"cling":{"definition":"Bám vào, dính sát vào, níu lấy.","example":"Wet clothes cling to your body after swimming.","exampleTranslation":"Quần áo ướt bám vào cơ thể bạn sau khi bơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"closely":{"definition":"Gần, gần gũi, thân mật.","example":"They are closely related by blood.","exampleTranslation":"Họ có mối quan hệ máu mủ gần gũi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"closure":{"definition":"Sự bế mạc (phiên họp).","example":"The closure of the session came late.","exampleTranslation":"Sự bế mạc của phiên họp đã diễn ra muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"clothing":{"definition":"Quần áo, y phục.","example":"I need to buy some new summer clothing.","exampleTranslation":"Tôi cần mua một vài y phục mùa hè mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"clue":{"definition":"Đầu mối; manh mối.","example":"The note gave a clue to the answer.","exampleTranslation":"Lời ghi chú đã đưa ra một manh mối cho câu trả lời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"cluster":{"definition":"Đám, bó, cụm; đàn, bầy.","example":"A cluster of grapes grew on the vine.","exampleTranslation":"Một đám nho đã mọc trên cây dây leo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"clutter":{"definition":"Tiếng ồn ào huyên náo.","example":"The clutter from the market filled the room.","exampleTranslation":"Tiếng ồn ào huyên náo từ chợ đã tràn ngập căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"coat":{"definition":"Bộ lông (thú).","example":"The dog's coat was soft and clean.","exampleTranslation":"Bộ lông của con chó rất mềm và sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"coexist":{"definition":"Chung sống, cùng tồn tại.","example":"Fish and birds can coexist near the lake.","exampleTranslation":"Cá và chim có thể chung sống gần hồ nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"coincide":{"definition":"Đồng ý với nhau.","example":"We coincide on the best time to leave.","exampleTranslation":"Chúng tôi đồng ý với nhau về thời gian tốt nhất để rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"coincidence":{"definition":"Sự trùng khớp, sự trùng nhau.","example":"It was a strange coincidence to meet there.","exampleTranslation":"Gặp nhau ở đó quả là một sự trùng hợp kỳ lạ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"collapse":{"definition":"Xẹp, xì hơi (lốp xe... ).","example":"The tire started to collapse on the road.","exampleTranslation":"Lốp xe bắt đầu xẹp trên đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"collect":{"definition":"Đến lấy, đi lấy, thu lượm, thu thập, góp nhặt, sưu tầm, sưu tập.","example":"I need to collect some old stamps this weekend.","exampleTranslation":"Tôi cần đi sưu tầm một số tem cũ vào cuối tuần này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"collection":{"definition":"Sự thu, sự lượm, sự góp nhặt, sự sưu tầm; tập sưu tầm.","example":"She has a large collection of old books.","exampleTranslation":"Cô ấy có một bộ sưu tập lớn các cuốn sách cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"collector":{"definition":"Người thu thập, người sưu tầm; người thu (thuế, tiền... ).","example":"The collector sorted stamps by country.","exampleTranslation":"Người sưu tầm đã phân loại tem theo quốc gia.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"collide":{"definition":"Va nhau, đụng nhau.","example":"Two bikes collide at the corner.","exampleTranslation":"Hai chiếc xe đạp va nhau tại góc phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"collision":{"definition":"Sự đụng, sự va.","example":"The two cars had a slight collision yesterday.","exampleTranslation":"Hai chiếc xe hơi đã có một vụ va chạm nhẹ vào hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"colossal":{"definition":"Khổng lồ, to lớn.","example":"The house had a colossal front door.","exampleTranslation":"Ngôi nhà có một cánh cửa chính khổng lồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"combination":{"definition":"Sự kết hợp, sự phối hợp.","example":"I love this combination of colors for my room.","exampleTranslation":"Tôi yêu sự kết hợp màu sắc này cho căn phòng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"comer":{"definition":"Người đến.","example":"The first comer will receive a special prize.","exampleTranslation":"Người đến đầu tiên sẽ nhận được một phần thưởng đặc biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"commonly":{"definition":"Thường thường, thông thường, bình thường.","example":"She spoke commonly during the meeting.","exampleTranslation":"Cô ấy thường xuyên nói chuyện trong buổi họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"commonplace":{"definition":"Điều đáng ghi vào sổ tay.","example":"She wrote the idea in her commonplace.","exampleTranslation":"Cô ấy đã viết ý tưởng đó vào sổ tay của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"compact":{"definition":"Sự thoả thuận.","example":"The two nations signed a formal compact today.","exampleTranslation":"Hai quốc gia đã ký một thỏa thuận chính thức hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"complement":{"definition":"Phần bù, phần bổ sung.","example":"A scarf is a nice complement to the coat.","exampleTranslation":"Một chiếc khăn quàng cổ là phần bổ sung tuyệt vời cho chiếc áo khoác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"completely":{"definition":"hoàn toàn; đầy đủ","example":"The man was completely honest in his business.","exampleTranslation":"Người đàn ông đó hoàn toàn trung thực trong công việc kinh doanh của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"completion":{"definition":"Sự làm cho hoàn toàn, sự làm cho đầy đủ.","example":"The completion of the bridge took two years.","exampleTranslation":"Sự hoàn thành của cây cầu đã mất hai năm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"complex":{"definition":"Phức tạp, rắc rối.","example":"Solving this complex question requires a lot of time.","exampleTranslation":"Giải quyết câu hỏi phức tạp này đòi hỏi rất nhiều thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"complexity":{"definition":"Sự phức tạp, sự rắc rối.","example":"They discussed the complexity today.","exampleTranslation":"Họ đã thảo luận về sự phức tạp ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"complicated":{"definition":"Phức tạp, rắc rối.","example":"Repairing this complicated piece of machinery requires a lot of skill.","exampleTranslation":"Việc sửa chữa cỗ máy phức tạp này đòi hỏi nhiều kỹ năng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"comprising":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của comprise.","example":"The box, comprising two books, sat on the table.","exampleTranslation":"Cái hộp, bao gồm hai cuốn sách, đặt trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"conceal":{"definition":"Giấu giếm, giấu, che đậy.","example":"She tried to conceal the gift from him.","exampleTranslation":"Cô ấy đã cố gắng giấu giếm món quà khỏi anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"cone":{"definition":"Hình nón; vật hình nón.","example":"She wore a bright cone on her head.","exampleTranslation":"Cô ấy đã đội một cái hình nón sáng màu trên đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"confine":{"definition":"Hạn chế.","example":"Please confine your comments to the main topic.","exampleTranslation":"Vui lòng hạn chế ý kiến của bạn vào chủ đề chính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"considerable":{"definition":"Đáng kể, to tát, lớn.","example":"We traveled a considerable distance by train today.","exampleTranslation":"Chúng tôi đã đi được một quãng đường đáng kể bằng tàu hỏa hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"considerably":{"definition":"đáng kể; khá nhiều","example":"Sharks are considerably faster swimmers than humans.","exampleTranslation":"Cá mập là những tay bơi nhanh đáng kể hơn con người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"consist":{"definition":"cốt ở, cốt tại, ở chỗ.","example":"Her success does not consist in luck alone.","exampleTranslation":"Thành công của cô ấy không chỉ cốt ở may mắn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"consistency":{"definition":"Như consistence","example":"Good consistency makes the dough easy to shape.","exampleTranslation":"Sự nhất quán tốt làm cho bột dễ tạo hình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"constitute":{"definition":"Cấu tạo, tạo thành, cấu thành.","example":"Hard work and dedication constitute his main source of happiness.","exampleTranslation":"Sự chăm chỉ và tận tụy cấu thành nguồn hạnh phúc chính của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"contain":{"definition":"Chận lại, ngăn lại, cản lại, kìm lại.","example":"The army tried to contain the enemy forces.","exampleTranslation":"Quân đội đã cố gắng ngăn lại các lực lượng kẻ thù.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"continually":{"definition":"Liên tục, không ngớt.","example":"He left continually after lunch.","exampleTranslation":"Anh ấy rời đi liên tục sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"continuation":{"definition":"Sự tiếp tục, sự làm tiếp.","example":"Please turn to page ten for the continuation.","exampleTranslation":"Vui lòng chuyển sang trang mười cho sự tiếp tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"continue":{"definition":"Giữ, duy trì.","example":"They decided to continue him in his current post.","exampleTranslation":"Họ đã quyết định duy trì anh ấy ở vị trí hiện tại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"continuous":{"definition":"Liên tục, liên tiếp, không dứt, không ngừng.","example":"We experienced continuous rain throughout the entire night.","exampleTranslation":"Chúng tôi đã trải qua mưa liên tục trong suốt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"continuously":{"definition":"Liên tục, liên tiếp.","example":"I read the note continuously.","exampleTranslation":"Tôi đọc tờ ghi chú liên tục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"contrary":{"definition":"Trái ngược, nghịch.","example":"The bird flew in a contrary direction suddenly.","exampleTranslation":"Con chim đột ngột bay theo hướng trái ngược.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"correctly":{"definition":"Đúng cách thức, phù hợp.","example":"The team finished correctly and left.","exampleTranslation":"Cả đội đã hoàn thành công việc đúng cách và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"counterpart":{"definition":"Bản sao, bản đối chiếu.","example":"Each file has a counterpart on the shelf.","exampleTranslation":"Mỗi tệp tin đều có một bản đối chiếu trên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"countless":{"definition":"Vô số, vô kể, không đếm xuể.","example":"There are countless stars on the clear night.","exampleTranslation":"Có vô số ngôi sao trên bầu trời đêm quang đãng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"crack":{"definition":"Nứt nẻ, rạn nứt, vỡ, gãy ((nghĩa đen) & (nghĩa bóng)).","example":"His voice began to crack during the speech.","exampleTranslation":"Giọng của anh ấy bắt đầu vỡ trong suốt bài phát biểu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"create":{"definition":"Gây ra, làm.","example":"The noise can create stress in the house.","exampleTranslation":"Tiếng ồn có thể gây ra sự căng thẳng trong nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"creation":{"definition":"Sự tạo thành, sự sáng tạo (thế giới); sự sáng tác.","example":"The creation of art requires great skill.","exampleTranslation":"Sự sáng tạo nghệ thuật đòi hỏi kỹ năng tuyệt vời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"crescent":{"definition":"Hồi giáo, đạo Hồi.","example":"The crescent symbol was painted on the wall.","exampleTranslation":"Biểu tượng hình trăng lưỡi liềm đã được vẽ trên tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"crimson":{"definition":"Đỏ thẫm, đỏ thắm.","example":"The sky turned crimson at sunset.","exampleTranslation":"Bầu trời chuyển sang màu đỏ thẫm lúc hoàng hôn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"crinkle":{"definition":"khúc cong, khúc quanh co, khúc uốn quanh.","example":"The path had a crinkle by the trees.","exampleTranslation":"Con đường có một khúc quanh co gần những cái cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"cross":{"definition":"Đạo Cơ-đốc.","example":"Many people follow the cross in their daily lives.","exampleTranslation":"Nhiều người theo đạo Cơ-đốc trong cuộc sống hàng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"crow":{"definition":"Cái xà beng, cái nạy nắp thùng, cái đòn bẫy ((cũng) crow bar).","example":"He used a crow to open the box.","exampleTranslation":"Anh ấy dùng một cái xà beng để mở hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"crowbar":{"definition":"Cái xà beng, cái nạy nắp thùng, cái đòn bẫy.","example":"He pried the lid open with a crowbar.","exampleTranslation":"Anh ấy dùng cái xà beng để cạy nắp ra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"crush":{"definition":"Đòn trí mạng; (quân sự) sự tiêu diệt.","example":"The defeat was a crush for the team.","exampleTranslation":"Thất bại đó là một đòn trí mạng cho cả đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"cryptic":{"definition":"Bí mật, mật.","example":"Her note was cryptic, so I asked again.","exampleTranslation":"Ghi chú của cô ấy rất bí mật, vì vậy tôi đã hỏi lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"curly":{"definition":"Quăn, xoắn.","example":"The little girl has beautiful curly hair.","exampleTranslation":"Cô bé có mái tóc quăn xinh đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"currently":{"definition":"hiện nay; hiện tại","example":"They are currently trying call home.","exampleTranslation":"Hiện nay họ đang cố gắng gọi về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"cutting":{"definition":"Đường hào, đường nhỏ xuyên qua rừng; đường xẻ xuyên qua núi đồi.","example":"The railway cutting goes through the deep forest.","exampleTranslation":"Đường xẻ xuyên qua núi đồi đi qua khu rừng sâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"damage":{"definition":"Giá tiền.","example":"Can you tell me what the damage will be?","exampleTranslation":"Bạn có thể cho tôi biết giá tiền thiệt hại sẽ là bao nhiêu không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"damp":{"definition":"Sự nản chí, sự ngã lòng, sự nản lòng, sự chán nản.","example":"His failure cast a damp over her plans.","exampleTranslation":"Thất bại của anh ấy phủ một nỗi nản chí lên kế hoạch của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"damper":{"definition":"Cái giảm âm; cái chặn tiếng (đàn pianô).","example":"He closed the damper to soften the piano sound.","exampleTranslation":"Anh ấy đóng cái chặn tiếng để làm dịu âm thanh đàn piano.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"dead":{"definition":"Chết (người, vật, cây cối).","example":"The old tree was struck dead by lightning.","exampleTranslation":"Cây cổ thụ bị sét đánh chết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"dear":{"definition":"Thân, thân yêu, thân mến, yêu quý.","example":"My dear friend sent me a lovely gift.","exampleTranslation":"Người bạn thân yêu của tôi đã gửi cho tôi một món quà đáng yêu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"deed":{"definition":"Việc làm, hành động, hành vi.","example":"Helping the poor is a very good deed.","exampleTranslation":"Giúp đỡ người nghèo là một việc làm rất tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"deem":{"definition":"Tưởng rằng, nghĩ rằng, cho rằng, thấy rằng.","example":"I deem it necessary to finish our work now.","exampleTranslation":"Tôi tưởng rằng điều cần thiết là phải hoàn thành công việc của chúng ta ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"deep":{"definition":"Khó lường, khó hiểu, bí ẩn, thâm hiểm.","example":"The mystery of his life remains very deep.","exampleTranslation":"Bí ẩn về cuộc đời anh ấy vẫn còn rất khó lường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"deepen":{"definition":"Làm sâu hơn; đào sâu thêm.","example":"We need to deepen the pool for the kids.","exampleTranslation":"Chúng ta cần làm sâu hơn hồ bơi cho bọn trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"deeply":{"definition":"Sâu xa, sâu sắc.","example":"She answered deeply and smiled.","exampleTranslation":"Cô ấy trả lời một cách sâu xa và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"delay":{"definition":"Làm trở ngại, cản trở.","example":"Heavy snow can delay the traffic for hours.","exampleTranslation":"Tuyết dày có thể làm trở ngại giao thông trong nhiều giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"delicate":{"definition":"Thanh nhã, thanh tú, thánh thú.","example":"She has very delicate features and beautiful eyes.","exampleTranslation":"Cô ấy có những nét thanh tú và đôi mắt tuyệt đẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"dens":{"definition":"Răng.","example":"The dentist checked all of his dens.","exampleTranslation":"Nha sĩ kiểm tra tất cả các răng của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"depth":{"definition":"Chiều sâu, bề sâu, độ sâu; độ dày.","example":"The river has a great depth near the waterfall.","exampleTranslation":"Dòng sông có độ sâu tuyệt vời gần thác nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"derive":{"definition":"Nhận được từ, lấy được từ, tìm thấy nguồn gốc từ.","example":"They derive profit from selling these goods.","exampleTranslation":"Họ nhận được lợi nhuận từ việc bán những hàng hóa này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"deserve":{"definition":"Đáng, xứng đáng.","example":"You deserve a reward for your hard work.","exampleTranslation":"Bạn xứng đáng được khen thưởng vì sự chăm chỉ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"desirable":{"definition":"Đáng thèm muốn; đáng ao ước, đáng khát khao.","example":"A quiet home is desirable for study.","exampleTranslation":"Một ngôi nhà yên tĩnh là đáng ao ước cho việc học tập.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"despite":{"definition":"Sự ghen ghét; sự hiềm khích; sự thù oán; ác cảm.","example":"Their despite grew after the unfair comment.","exampleTranslation":"Sự hiềm khích của họ tăng lên sau lời nhận xét không công bằng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"devour":{"definition":"Ăn sống nuốt tươi; cắn xé, ăn ngấu nghiến.","example":"The hungry lion will devour its prey quickly.","exampleTranslation":"Sư tử đói sẽ ăn ngấu nghiến con mồi một cách nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"devouring":{"definition":"Hau háu, ngấu nghiến, phàm, như muốn nuốt lấy.","example":"She gave him a devouring look across the room.","exampleTranslation":"Cô ấy trao cho anh ta một cái nhìn hau háu khắp phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"diary":{"definition":"Lịch ghi nhớ.","example":"The office diary helped him remember each meeting.","exampleTranslation":"Lịch ghi nhớ văn phòng đã giúp anh ấy nhớ mỗi cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"died":{"definition":"Dạng quá khứ đơn và phân từ quá khứ của die","example":"My old phone died after years of use.","exampleTranslation":"Điện thoại cũ của tôi đã chết sau nhiều năm sử dụng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"differ":{"definition":"+ from) khác, không giống.","example":"My opinions differ from yours on this topic.","exampleTranslation":"Ý kiến của tôi khác với bạn về chủ đề này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"difference":{"definition":"Sự khác nhau, tình trạng khác nhau; tính khác nhau; sự chênh lệch.","example":"There is a big difference between these two.","exampleTranslation":"Có một sự khác nhau lớn giữa hai điều này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"differently":{"definition":"In a different way.","example":"The new manager wants to run things differently from before.","exampleTranslation":"Người quản lý mới muốn điều hành mọi thứ khác biệt so với trước đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"difficult":{"definition":"Khó, khó khăn, gay go.","example":"This is a very difficult question for students.","exampleTranslation":"Đây là một câu hỏi rất khó khăn cho học sinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"difficulty":{"definition":"Sự khó khăn, nỗi khó khăn, nỗi gay go; điều cản trở, điều trở ngại.","example":"She managed to overcome a difficulty during the race.","exampleTranslation":"Cô ấy đã cố gắng vượt qua một sự khó khăn trong suốt cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"diminish":{"definition":"Bớt, giảm, hạ bớt, giảm bớt; thu nhỏ.","example":"We need to diminish the risks before starting.","exampleTranslation":"Chúng ta cần giảm thiểu rủi ro trước khi bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"dimly":{"definition":"Lờ mờ, mập mờ.","example":"She spoke dimly during the meeting.","exampleTranslation":"Cô ấy nói chuyện một cách lờ mờ trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"dimming":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của dim.","example":"The room is dimming as evening comes.","exampleTranslation":"Căn phòng đang tối dần khi màn đêm buông xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"dire":{"definition":"Thảm khốc, khốc liệt, tàn khốc; kinh khủng.","example":"The storm caused dire consequences for the village.","exampleTranslation":"Cơn bão đã gây ra những hậu quả thảm khốc cho ngôi làng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"direct":{"definition":"Chỉ đường; hướng dẫn, chỉ đạo, chi phối.","example":"Can you direct me to the nearest station?","exampleTranslation":"Bạn có thể chỉ đường cho tôi đến nhà ga gần nhất được không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"direction":{"definition":"Sự điều khiển, sự chỉ huy, sự cai quản.","example":"He took over the direction of the company.","exampleTranslation":"Anh ấy đã tiếp quản sự điều khiển công ty.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"disappear":{"definition":"Biến đi, biến mất.","example":"The clouds disappear after sunrise.","exampleTranslation":"Những đám mây tan biến sau khi mặt trời mọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"disappearance":{"definition":"Sự biến đi, sự biến mất.","example":"His sudden disappearance worried the family.","exampleTranslation":"Sự biến mất đột ngột của anh ấy khiến gia đình lo lắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"disguise":{"definition":"Trá hình, cải trang.","example":"The spy tried to disguise himself as a tourist.","exampleTranslation":"Điệp viên đã cố gắng trá hình thành một du khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"disrobe":{"definition":"Cởi áo dài cho, cởi quần dài cho.","example":"The nurse helped him disrobe before the exam.","exampleTranslation":"Cô y tá giúp anh ấy cởi áo dài trước cuộc kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"distinct":{"definition":"Rõ rệt, dứt khoát, nhất định.","example":"She gave a distinct refusal to my request.","exampleTranslation":"Cô ấy đã đưa ra một sự từ chối dứt khoát đối với yêu cầu của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"distinction":{"definition":"Sự phân biệt; điều phân biệt, điều khác nhau.","example":"There is no distinction between these two items.","exampleTranslation":"Không có sự phân biệt nào giữa hai mặt hàng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"distinctive":{"definition":"Đặc biệt; để phân biệt.","example":"The bird has a very distinctive blue feather.","exampleTranslation":"Chú chim đó có một chiếc lông màu xanh rất đặc biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"divulge":{"definition":"Để lộ ra, tiết lộ.","example":"Do not divulge the secret to anyone.","exampleTranslation":"Đừng tiết lộ bí mật đó cho bất cứ ai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"doom":{"definition":"Số mệnh, số phận (thường không may, bất hạnh).","example":"She feared the doom of her broken plans.","exampleTranslation":"Cô ấy sợ hãi số mệnh của những kế hoạch đổ vỡ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"double":{"definition":"Đôi, hai, kép.","example":"I noticed a small double chin on him.","exampleTranslation":"Tôi nhận thấy một cái cằm đôi nhỏ trên anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"downright":{"definition":"Đích thực, rành rành, hoàn toàn hết sức, đại.","example":"That is a downright lie about his secret life.","exampleTranslation":"Đó là một lời nói dối rành rành về cuộc sống bí mật của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"dozen":{"definition":"Nhiều.","example":"We saw a dozen ducks near the lake.","exampleTranslation":"Chúng tôi thấy nhiều con vịt gần cái hồ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"drastic":{"definition":"Xổ mạnh, tẩy mạnh.","example":"We need a drastic change in our habits.","exampleTranslation":"Chúng ta cần một sự thay đổi mạnh mẽ trong các thói quen của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"drawback":{"definition":"Sự khấu trừ, sự giảm.","example":"The store gave a small drawback on the bill.","exampleTranslation":"Cửa hàng đã giảm một mức khấu trừ trên hóa đơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"draw":{"definition":"Sự kéo; sự cố gắng, sự nỗ lực.","example":"It took a strong draw to move the box.","exampleTranslation":"Phải cần một nỗ lực mạnh mẽ để di chuyển chiếc hộp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"dull":{"definition":"Đục, mờ đục, xỉn, xám xịt.","example":"The old wall has a very dull color.","exampleTranslation":"Bức tường cũ có một màu rất đục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"dunk":{"definition":"Nhúng (bánh... vào xúp, sữa... ).","example":"Please dunk the cookie in warm milk.","exampleTranslation":"Vui lòng nhúng bánh quy vào sữa ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"duplicate":{"definition":"Từ đồng nghĩa.","example":"That word has a useful duplicate in speech.","exampleTranslation":"Từ đó có một từ đồng nghĩa hữu ích trong văn nói.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"duplication":{"definition":"Sự sao lại, sự sao lục, sự làm thành hai bản.","example":"The duplication of files took a minute.","exampleTranslation":"Việc sao lại các tệp tin mất một phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"dying":{"definition":"Sự chết.","example":"Dying can make people think about their lives.","exampleTranslation":"Sự chết có thể khiến con người nghĩ về cuộc đời họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"dynamic":{"definition":"Năng động, năng nổ, sôi nổi.","example":"He is a dynamic leader with clear ideas.","exampleTranslation":"Ông ấy là một nhà lãnh đạo năng động với những ý tưởng rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"ease":{"definition":"Sự thanh thản, sự thoải mái; sự không bị ràng buộc.","example":"She felt at ease in her new home.","exampleTranslation":"Cô ấy cảm thấy sự thanh thản trong ngôi nhà mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"easily":{"definition":"Thoải mái, thanh thản, không lo lắng; thanh thoát, ung dung.","example":"She spoke easily during the meeting.","exampleTranslation":"Cô ấy phát biểu một cách thanh thản trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"effect":{"definition":"Hiệu lực, hiệu quả, tác dụng.","example":"This new law is of no effect now.","exampleTranslation":"Luật mới này hiện không có hiệu lực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"effective":{"definition":"Có thật, thật sự.","example":"The medicine had an effective result on him.","exampleTranslation":"Loại thuốc đó có kết quả thật sự đối với anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"effectively":{"definition":"Có kết quả.","example":"They worked effectively all day.","exampleTranslation":"Họ làm việc một cách có kết quả cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"effectiveness":{"definition":"Ấn tượng sâu sắc.","example":"The effectiveness of her speech moved the crowd.","exampleTranslation":"Ấn tượng sâu sắc từ bài phát biểu của cô ấy làm cảm động đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"eighteen":{"definition":"Mười tám.","example":"My sister is eighteen years old now.","exampleTranslation":"Em gái tôi bây giờ đã mười tám tuổi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"eighteenth":{"definition":"Thứ mười tám.","example":"She finished in eighteenth place.","exampleTranslation":"Cô ấy về đích ở vị trí thứ mười tám.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"eleven":{"definition":"Đội mười một người.","example":"The team won as an eleven against three.","exampleTranslation":"Đội mười một người giành chiến thắng với tỉ số mười một so với ba.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"eliminate":{"definition":"Lờ đi (một phần của vấn đề).","example":"He chose to eliminate that detail from the plan.","exampleTranslation":"Anh ấy chọn cách lờ đi chi tiết đó khỏi kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"elsewhere":{"definition":"Ở một nơi nào khác.","example":"If the store is full, try elsewhere.","exampleTranslation":"Nếu cửa hàng đã đầy, hãy thử ở một nơi nào khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"embark":{"definition":"Lao vào, dấn mình vào, bắt tay vào (công việc gì... ) ((từ Mỹ, nghĩa Mỹ) (cũng) imbark).","example":"She decided to embark on a new project.","exampleTranslation":"Cô ấy quyết định dấn mình vào một dự án mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"embody":{"definition":"Là hiện thân của.","example":"These statues embody the spirit of our nation.","exampleTranslation":"Những bức tượng này là hiện thân của tinh thần dân tộc chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"emerge":{"definition":"Nổi lên, hiện ra, lòi ra.","example":"A warm smell began to emerge from the kitchen.","exampleTranslation":"Một mùi ấm bắt đầu tỏa ra từ nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"emergence":{"definition":"Sự nổi bật lên, sự rõ nét lên; sự nổi lên, sự nảy ra (vấn đề... ).","example":"The emergence of a new idea changed everything.","exampleTranslation":"Sự nổi lên của một ý tưởng mới đã thay đổi tất cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"empty":{"definition":"trống rỗng; rỗng; không có gì","example":"Hey! You finished my beer. It's empty.","exampleTranslation":"Này! Bạn uống hết bia của tôi rồi. Nó trống rỗng rồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"general-reading"},"encompass":{"definition":"Hoàn thiện, hoàn thành.","example":"The final review will encompass the whole project.","exampleTranslation":"Bài đánh giá cuối cùng sẽ hoàn thiện toàn bộ dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"encounter":{"definition":"Sự gặp gỡ, sự bắt gặp; sự gặp phải; cuộc gặp gỡ.","example":"Our first encounter was in a busy came.","exampleTranslation":"Cuộc gặp gỡ đầu tiên của chúng tôi là ở một quán ăn bận rộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ending":{"definition":"Sự kết thúc, sự chấm dứt.","example":"The ending of the story felt rushed.","exampleTranslation":"Sự kết thúc của câu chuyện có vẻ vội vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"endless":{"definition":"Vô tận, vĩnh viễn, không bao giờ hết.","example":"We walked along the endless beach.","exampleTranslation":"Chúng tôi đi dọc theo bãi biển vô tận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"endlessly":{"definition":"Không ngừng, liên tu bất tận.","example":"She spoke endlessly during the meeting.","exampleTranslation":"Cô ấy nói chuyện không ngừng trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"endure":{"definition":"Chịu đựng, cam chịu, chịu được.","example":"She can endure the long winter easily.","exampleTranslation":"Cô ấy có thể chịu đựng mùa đông kéo dài một cách dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"enigma":{"definition":"Điều bí ẩn.","example":"Her calm smile was an enigma to me.","exampleTranslation":"Nụ cười bình tĩnh của cô ấy là một điều bí ẩn đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"enjoy":{"definition":"Thích thú, khoái (cái gì).","example":"I really enjoy reading an interesting book.","exampleTranslation":"Tôi thực sự thích thú đọc một cuốn sách thú vị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"enormous":{"definition":"To lớn, khổng lồ.","example":"They bought an enormous table for the kitchen.","exampleTranslation":"Họ mua một cái bàn to lớn cho nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"enormously":{"definition":"To lớn, khổng lồ.","example":"She answered enormously and smiled.","exampleTranslation":"Cô ấy trả lời một cách to lớn và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"ensure":{"definition":"Bảo đảm.","example":"Please lock the door to ensure safety.","exampleTranslation":"Vui lòng khóa cửa để bảo đảm an toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"entail":{"definition":"Chế độ kế thừa theo thứ tự; tài sản kế thừa theo thứ tự.","example":"The old house came with a long entail.","exampleTranslation":"Ngôi nhà cũ đi kèm với một chế độ kế thừa theo thứ tự lâu đời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"enter":{"definition":"Đi vào.","example":"Please enter through the front door.","exampleTranslation":"Vui lòng đi vào qua cửa trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"entire":{"definition":"Toàn bộ, toàn thể, toàn vẹn, hoàn toàn.","example":"We spent the entire day cleaning the house.","exampleTranslation":"Chúng tôi dành toàn bộ ngày để dọn dẹp ngôi nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"entirely":{"definition":"hoàn toàn","example":"It is entirely up to you on how you intend to get help for your project. I am only here to give advice.","exampleTranslation":"Việc bạn có ý định nhận trợ giúp cho dự án của mình như thế nào là hoàn toàn tùy thuộc vào bạn. Tôi chỉ ở đây để đưa ra lời khuyên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"entity":{"definition":"Thực thể.","example":"The entity was important at work.","exampleTranslation":"Thực thể này quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"entry":{"definition":"Sự đi vào.","example":"The spacecraft prepares for entry into the atmosphere.","exampleTranslation":"Tàu vũ trụ chuẩn bị cho sự đi vào bầu khí quyển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"envelop":{"definition":"Bao, bọc, phủ.","example":"Fog seemed to envelop the hill.","exampleTranslation":"Sương mù dường như bao phủ ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"envision":{"definition":"Nhìn thấy như trong ảo ảnh.","example":"She can envision her new home.","exampleTranslation":"Cô ấy có thể nhìn thấy như trong ảo ảnh ngôi nhà mới của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"epitome":{"definition":"Bản tóm tắt, bản cô lại, bản toát yếu.","example":"The report was an epitome of the study.","exampleTranslation":"Bản báo cáo là một bản toát yếu của nghiên cứu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"epitomize":{"definition":"Là hình ảnh thu nhỏ của.","example":"He epitomize the patience of a good teacher.","exampleTranslation":"Anh ấy là hình ảnh thu nhỏ của sự kiên nhẫn của một giáo viên giỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"especially":{"definition":"đặc biệt là; nhất là","example":"Nobody was old, but Paulo was especially young.","exampleTranslation":"Không ai già cả, nhưng Paulo là đặc biệt là trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"essential":{"definition":"Cần thiết, thiết yếu, cốt yếu, chủ yếu.","example":"Water is essential for every plant.","exampleTranslation":"Nước là thiết yếu đối với mọi loài cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"essentially":{"definition":"Về bản chất, về cơ bản.","example":"He moved essentially through the crowd.","exampleTranslation":"Anh ấy di chuyển về cơ bản qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"eternity":{"definition":"Tính vĩnh viễn, tính bất diệt.","example":"She saw the eternity yesterday.","exampleTranslation":"Cô ấy đã nhìn thấy tính vĩnh viễn vào ngày hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"evenly":{"definition":"Bằng phẳng.","example":"They worked evenly all day.","exampleTranslation":"Họ đã làm việc bằng phẳng suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"everlasting":{"definition":"Vĩnh viễn, mãi mãi, đời đời, bất diệt.","example":"The room felt everlasting after cleaning.","exampleTranslation":"Căn phòng mang lại cảm giác vĩnh viễn sau khi được dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"everyday":{"definition":"Hằng ngày, dùng hàng ngày.","example":"I enjoy my everyday routine at the office.","exampleTranslation":"Tôi tận hưởng thói quen hằng ngày của mình tại văn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"everywhere":{"definition":"Ở mọi nơi, khắp nơi, khắp chốn.","example":"Rain fell everywhere that day.","exampleTranslation":"Mưa rơi ở khắp nơi vào ngày hôm đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"exact":{"definition":"Đòi hỏi, đòi khăng khăng, đòi hỏi cấp bách.","example":"The job will exact a lot of patience.","exampleTranslation":"Công việc này sẽ đòi hỏi rất nhiều sự kiên nhẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"exactly":{"definition":"Chính xác, đúng đắn.","example":"He moved exactly through the crowd.","exampleTranslation":"Anh ấy di chuyển chính xác qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"exceed":{"definition":"Trội hơn.","example":"Her skills exceed mine in every way.","exampleTranslation":"Kỹ năng của cô ấy trội hơn của tôi về mọi mặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"exceedingly":{"definition":"Vô cùng, cực kỳ","example":"The task was exceedingly difficult.","exampleTranslation":"Nhiệm vụ này vô cùng khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"excellent":{"definition":"Hơn hẳn, trội hơn; rất tốt, thượng hạng, xuất sắc, ưu tú.","example":"She gave an excellent answer to the question.","exampleTranslation":"Cô ấy đã đưa ra một câu trả lời rất tốt cho câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"exception":{"definition":"Sự trừ ra, sự loại ra.","example":"Everyone joined with the exception of him.","exampleTranslation":"Mọi người đều tham gia với sự trừ ra của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"exceptional":{"definition":"Khác thường, đặc biệt, hiếm có.","example":"She has an exceptional talent for playing the piano.","exampleTranslation":"Cô ấy có một tài năng khác thường cho việc chơi đàn piano.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"excessive":{"definition":"Quá mức, thừa.","example":"Excessive noise made it hard to sleep.","exampleTranslation":"Tiếng ồn quá mức làm cho khó ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"exclude":{"definition":"Loại trừ.","example":"We should exclude that option from the list.","exampleTranslation":"Chúng ta nên loại trừ tùy chọn đó khỏi danh sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"exclusive":{"definition":"Trừ, không kể, không gồm.","example":"The price is fifty dollars exclusive of tax.","exampleTranslation":"Giá đó là năm mươi đô la không gồm thuế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"exclusiveness":{"definition":"Tính độc nhất.","example":"The exclusiveness of the shop attracted curious buyers.","exampleTranslation":"Tính độc nhất của cửa hàng đã thu hút những người mua tò mò.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"excuse":{"definition":"Lời xin lỗi; lý do để xin lỗi.","example":"She gave a polite excuse for leaving early.","exampleTranslation":"Cô ấy đưa ra một lời xin lỗi lịch sự vì đã rời đi sớm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"exert":{"definition":"Dùng, sử dụng (sức mạnh, ảnh hưởng... ).","example":"Athletes exert themselves during the final race.","exampleTranslation":"Các vận động viên dùng hết sức trong cuộc đua cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"expand":{"definition":"Mở rộng, trải ra.","example":"Please expand the table to fit the new data.","exampleTranslation":"Vui lòng mở rộng bảng để phù hợp với dữ liệu mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"expose":{"definition":"Phơi ra.","example":"The window will expose the room to sunlight.","exampleTranslation":"Cửa sổ sẽ phơi căn phòng ra ánh nắng mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"extend":{"definition":"Duỗi thẳng (tay, chân... ); đưa ra, giơ ra.","example":"Please extend the arm to reach that book.","exampleTranslation":"Vui lòng duỗi thẳng cánh tay để với lấy cuốn sách đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"extension":{"definition":"Phần kéo dài, phần mở rộng, phần nối thêm (vào nhà, vào dây nói... ).","example":"They built an extension to their small house.","exampleTranslation":"Họ đã xây một phần mở rộng cho ngôi nhà nhỏ của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"extensive":{"definition":"Rộng, rộng rãi, bao quát.","example":"The school has extensive fields behind it.","exampleTranslation":"Ngôi trường có những cánh đồng rộng đằng sau nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"extensively":{"definition":"Rộng rãi, bao quát, cùng khắp.","example":"The team finished extensively and left.","exampleTranslation":"Cả nhóm đã làm việc rộng rãi và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"extent":{"definition":"Khoảng rộng.","example":"The forest covers a vast extent of land.","exampleTranslation":"Khu rừng bao phủ một khoảng rộng lớn của đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"external":{"definition":"Ở ngoài, bên ngoài (hiện tượng... ).","example":"We must focus on the external world today.","exampleTranslation":"Chúng ta phải tập trung vào thế giới ở ngoài hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"extra":{"definition":"Cái phụ, cái thêm; món phải trả thêm.","example":"The movie had an extra for the long version.","exampleTranslation":"Bộ phim đã có một cái phụ cho phiên bản dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"extraordinary":{"definition":"Lạ thường, khác thường; to lớn lạ thường.","example":"It was an extraordinary day for the whole team.","exampleTranslation":"Đó là một ngày lạ thường cho cả nhóm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"extreme":{"definition":"Vô cùng, tột bực, cùng cực, cực độ.","example":"They lived in a state of extreme poverty.","exampleTranslation":"Họ sống trong tình trạng nghèo đói cùng cực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"face":{"definition":"Vẻ mặt.","example":"He sat alone with a long face on the bench.","exampleTranslation":"Anh ấy ngồi một mình với một vẻ mặt dài trên ghế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fade":{"definition":"Mất dần, mờ dần, biến dần.","example":"His voice started to fade in the wind.","exampleTranslation":"Giọng nói của anh ấy bắt đầu mờ dần trong gió.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"fail":{"definition":"Không nhớ, quên.","example":"Please do not fail to let me know.","exampleTranslation":"Vui lòng đừng quên thông báo cho tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"failure":{"definition":"Sự không xảy ra, sự không làm được (việc gì).","example":"The failure to finish on time was disappointing.","exampleTranslation":"Sự không làm được để hoàn thành đúng hạn thật là đáng thất vọng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fairly":{"definition":"Khá, kha khá.","example":"The movie was fairly good for its low budget.","exampleTranslation":"Bộ phim khá hay so với ngân sách thấp của nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"familiar":{"definition":"Thuộc gia đình.","example":"The cat is familiar with our home now.","exampleTranslation":"Con mèo đã thuộc gia đình ngôi nhà của chúng tôi bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fancy":{"definition":"Tính đồng bóng.","example":"His fancy style made the room look bright.","exampleTranslation":"Phong cách tính đồng bóng của anh ấy làm cho căn phòng trông sáng sủa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fantastic":{"definition":"Vô cùng to lớn.","example":"They paid a fantastic sum of money for it.","exampleTranslation":"Họ đã trả một số tiền vô cùng to lớn cho nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fate":{"definition":"Thiên mệnh, định mệnh, số mệnh, số phận.","example":"She believed fate would guide her to the right job.","exampleTranslation":"Cô ấy tin rằng thiên mệnh sẽ dẫn cô ấy đến công việc phù hợp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"favorite":{"definition":"Được mến chuộng, được ưa thích.","example":"This is my favorite book.","exampleTranslation":"Đây là cuốn sách được mến chuộng của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"favourite":{"definition":"Được mến chuộng, được ưa thích.","example":"She is my favourite author for mystery novels.","exampleTranslation":"Cô ấy là tác giả được mến chuộng của tôi cho các tiểu thuyết bí ẩn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"feat":{"definition":"Ngón điêu luyện, ngón tài ba.","example":"His acrobatics were a remarkable feat of skill.","exampleTranslation":"Các màn nhào lộn của anh ấy là một ngón điêu luyện đáng chú ý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"feature":{"definition":"đặc trưng.","example":"The house has a feature of wide windows.","exampleTranslation":"Ngôi nhà có đặc trưng là các cửa sổ rộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fend":{"definition":"Chống đỡ được, né, tránh, gạt được.","example":"She had to fend off several aggressive protesters today.","exampleTranslation":"Cô ấy đã phải chống đỡ được vài người biểu tình hung hãn hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"fetch":{"definition":"Hồn ma, vong hồn (hiện hình).","example":"They said a fetch walked near the road.","exampleTranslation":"Họ nói rằng một hồn ma đã đi gần con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fifteen":{"definition":"Mười lăm.","example":"She was fifteen when she moved away.","exampleTranslation":"Cô ấy mười lăm tuổi khi cô ấy chuyển đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fifteenth":{"definition":"Số mười lăm.","example":"He finished fifteenth in the race.","exampleTranslation":"Anh ấy đứng thứ mười lăm trong cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fifty":{"definition":"Năm mươi.","example":"There are fifty people in the room.","exampleTranslation":"Có năm mươi người trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"figure":{"definition":"Hình dáng.","example":"She exercises every day to keep her figure.","exampleTranslation":"Cô ấy tập thể dục mỗi ngày để giữ hình dáng của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"finally":{"definition":"cuối cùng; sau cùng","example":"I finally finished university. Now, I can start my real life.","exampleTranslation":"Tôi đã cuối cùng hoàn thành đại học. Bây giờ, tôi có thể bắt đầu cuộc sống thực của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"fine":{"definition":"Nhỏ, mịn, thanh mảnh; sắc.","example":"She wrote her name with a fine pen.","exampleTranslation":"Cô ấy viết tên mình bằng một chiếc bút thanh mảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"firstly":{"definition":"Thứ nhất, đầu tiên là.","example":"The team finished firstly and left.","exampleTranslation":"Cả nhóm đã kết thúc thứ nhất và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"fits":{"definition":"Động từ chia ở ngôi thứ ba số ít của fit","example":"This key fits the lock well.","exampleTranslation":"Chiếc chìa khóa này khớp với ổ khóa tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"fitted":{"definition":"Quá khứ và phân từ quá khứ của fit","example":"The jacket fitted him perfectly.","exampleTranslation":"Chiếc áo khoác đã khớp hoàn hảo với anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"fixed":{"definition":"Đứng yên, bất động, cố định.","example":"She looked at the fixed star in the night sky.","exampleTranslation":"Cô ấy nhìn vào ngôi sao cố định trên bầu trời đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fizzle":{"definition":"Xèo xèo; xì xì.","example":"The drink began to fizzle in the glass.","exampleTranslation":"Đồ uống bắt đầu xèo xèo trong ly.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"flag":{"definition":"Cờ lệnh (trên tàu có hàng đô đốc).","example":"The ship raised a flag for the admiral.","exampleTranslation":"Con tàu treo một cờ lệnh cho đô đốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flake":{"definition":"Giàn, giá phơi (để phơi cá... ).","example":"The fish dried on a flake near the shore.","exampleTranslation":"Cá đã khô trên một giàn phơi gần bờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flap":{"definition":"Sự xôn xao.","example":"There was a flap over the lost keys.","exampleTranslation":"Có một sự xôn xao về những chiếc chìa khóa bị mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flare":{"definition":"Chỗ loe ra; chỗ khum lên (ở mạn tàu).","example":"The flare of the boat made it easier to board.","exampleTranslation":"Chỗ loe ra của con thuyền làm cho nó dễ lên tàu hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flatten":{"definition":"Dát mỏng, dát phẳng, làm bẹt ra, san phẳng.","example":"Please flatten the box before recycling it.","exampleTranslation":"Vui lòng dát phẳng chiếc hộp trước khi tái chế nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"flew":{"definition":"Ruồi (làm mồi câu); ruồi giả (làm mồi câu cá).","example":"He tied a small flew to his fishing line.","exampleTranslation":"Anh ấy buộc một ruồi giả nhỏ vào dây câu của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flip":{"definition":"Cái búng.","example":"Give the coin a flip and catch it.","exampleTranslation":"Hãy cho đồng xu một cái búng và bắt lấy nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"float":{"definition":"Cái phao; phao cứu đắm.","example":"The float kept the child safe in the pool.","exampleTranslation":"Cái phao giữ cho đứa trẻ an toàn trong hồ bơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flourish":{"definition":"Sự vung (gươm, vũ khí, tay).","example":"He finished with a flourish of his hand.","exampleTranslation":"Anh ấy đã kết thúc với một sự vung tay của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fling":{"definition":"Sự lu bù (ăn chơi... ).","example":"He decided to have one last fling in Paris.","exampleTranslation":"Anh ấy quyết định có một sự lu bù cuối cùng ở Paris.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"flurry":{"definition":"Sự nhộn nhịp, sự náo động; sự xôn xao, sự bối rối.","example":"There was a flurry of activity in the kitchen.","exampleTranslation":"Có một sự nhộn nhịp của hoạt động trong bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"foiler":{"definition":"Người thất bại.","example":"He was a foiler in the final game.","exampleTranslation":"Anh ấy là một người thất bại trong trò chơi cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fond":{"definition":"Nền (bằng ren).","example":"The lace had a dark fond behind the pattern.","exampleTranslation":"Ren có một nền tối sau hoa văn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fool":{"definition":"Món hoa quả nấu (trộn với sữa kem... ).","example":"She made a sweet fool with fruit and cream.","exampleTranslation":"Cô ấy đã làm một món hoa quả nấu ngọt với trái cây và kem.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"footfall":{"definition":"Bước chân.","example":"We heard the footfall on the wooden stairs.","exampleTranslation":"Chúng tôi đã nghe bước chân trên cầu thang gỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"footstep":{"definition":"Bước chân đi.","example":"The footstep was useful in class.","exampleTranslation":"Bước chân đi rất hữu ích trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"forceful":{"definition":"Mạnh mẽ.","example":"Her voice was calm but forceful.","exampleTranslation":"Giọng nói của cô ấy bình tĩnh nhưng mạnh mẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fore":{"definition":"Phần trước.","example":"Sit in the fore of the boat.","exampleTranslation":"Ngồi ở phần trước của con thuyền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"foremost":{"definition":"Đầu tiên, trước nhất.","example":"She was the foremost student in the class.","exampleTranslation":"Cô ấy là học sinh đầu tiên trong lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"forever":{"definition":"Mãi mãi, vĩnh viễn.","example":"I will remember this forever.","exampleTranslation":"Tôi sẽ ghi nhớ điều này mãi mãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"former":{"definition":"Cái trước, người trước, vấn đề trước.","example":"I prefer the former option over the latter.","exampleTranslation":"Tôi thích cái trước hơn là cái sau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"formerly":{"definition":"Trước đây, thuở xưa.","example":"He moved formerly through the crowd.","exampleTranslation":"Anh ấy di chuyển trước đây qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"forth":{"definition":"Về phía trước, ra phía trước, lộ ra.","example":"The children ran back and forth in the yard.","exampleTranslation":"Những đứa trẻ chạy về phía trước và ra sau trong sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"forthcoming":{"definition":"Sắp đến, sắp rời.","example":"We are waiting for the forthcoming session to begin.","exampleTranslation":"Chúng tôi đang chờ đợi phiên họp sắp đến bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fortunate":{"definition":"Tốt, thuận lợi.","example":"They were lucky to see such a fortunate omen.","exampleTranslation":"Họ thật tốt khi nhìn thấy một điềm báo thuận lợi như vậy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fortunately":{"definition":"may mắn thay; thật may","example":"Fortunately, I found my lost keys in the living room.","exampleTranslation":"May mắn thay, tôi tìm thấy những chiếc chìa khóa bị mất của mình trong phòng khách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"forward":{"definition":"Ở trước, phía trước, tiến lên, tiến về phía trước.","example":"The soldiers began a forward march toward the city.","exampleTranslation":"Những người lính bắt đầu một cuộc diễu hành về phía trước hướng về thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fount":{"definition":"Bộ chữ cùng cỡ.","example":"Choose a new fount for the poster title.","exampleTranslation":"Chọn một bộ chữ cùng cỡ mới cho tiêu đề áp phích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fragrance":{"definition":"Mùi thơm phưng phức, hương thơm ngát.","example":"The room had a soft fragrance.","exampleTranslation":"Căn phòng có một mùi thơm phưng phức nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"fragrant":{"definition":"Thơm phưng phức, thơm ngát.","example":"The fragrant flowers filled the room.","exampleTranslation":"Những đóa hoa thơm phưng phức làm đầy căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fraught":{"definition":"(+ with) xếp đầy, trang bị đầy.","example":"The box was fraught with fresh tools.","exampleTranslation":"Chiếc hộp đã xếp đầy các công cụ mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"freak":{"definition":"Tính đồng bóng, tính hay thay đổi.","example":"His behavior was a total freak of habit.","exampleTranslation":"Hành vi của anh ấy là một tính đồng bóng của thói quen.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"freely":{"definition":"Tự do, tuỳ thích, không gò bó, thoải mái.","example":"She spoke freely during the meeting.","exampleTranslation":"Cô ấy đã phát biểu một cách thoải mái trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"frequent":{"definition":"Thường xuyên, hay xảy ra, có luôn.","example":"She is a frequent visitor to this small cafe.","exampleTranslation":"Cô ấy là khách quen của quán cà phê nhỏ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"frequently":{"definition":"Thường xuyên.","example":"She spoke frequently during the meeting.","exampleTranslation":"Cô ấy đã phát biểu thường xuyên trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"fully":{"definition":"Đầy đủ, hoàn toàn.","example":"The team finished fully and left.","exampleTranslation":"Cả đội đã hoàn thành công việc đầy đủ rồi rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"fumble":{"definition":"Sự dò dẫm, sự sờ soạng; sự lần mò.","example":"Her fumble with the key delayed the door opening.","exampleTranslation":"Sự dò dẫm với chiếc chìa khóa của cô ấy đã trì hoãn việc mở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"funny":{"definition":"Là lạ, khang khác.","example":"There is something funny about this strange situation.","exampleTranslation":"Có điều gì đó là lạ về tình huống kỳ quặc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"further":{"definition":"Xa hơn nữa, bên kia.","example":"The house is on the further side of the hill.","exampleTranslation":"Ngôi nhà nằm ở phía xa hơn bên kia ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"furthest":{"definition":"Xa hơn hết, xa nhất.","example":"The furthest house sits by the hill.","exampleTranslation":"Ngôi nhà xa nhất nằm cạnh ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"futile":{"definition":"Vô ích, không có hiệu quả.","example":"It was a futile attempt to fix the broken car.","exampleTranslation":"Đó là một nỗ lực vô ích để sửa chiếc xe bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"future":{"definition":"Tương lai.","example":"We must plan for our future together now.","exampleTranslation":"Chúng ta phải lập kế hoạch cho tương lai của mình ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"fuzzy":{"definition":"Sờn, xơ.","example":"The old sweater felt fuzzy after many washes.","exampleTranslation":"Chiếc áo len cũ trở nên sờn sau nhiều lần giặt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"gappy":{"definition":"Có nhiều lỗ hổng, có nhiều kẽ hở.","example":"The fence was gappy and easy to see through.","exampleTranslation":"Hàng rào có nhiều kẽ hở và rất dễ nhìn xuyên qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"gather":{"definition":"Tập hợp, tụ họp lại.","example":"They gather in the park every Sunday morning.","exampleTranslation":"Họ tụ họp trong công viên vào mỗi sáng Chủ nhật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"generally":{"definition":"Nói chung, đại thể.","example":"I generally prefer tea over coffee in the morning.","exampleTranslation":"Tôi nói chung thích uống trà hơn cà phê vào buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"generic":{"definition":"Chung.","example":"We used a generic name for the medicine.","exampleTranslation":"Chúng tôi đã sử dụng một cái tên chung cho loại thuốc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"gentle":{"definition":"Mồi giòi (để câu cá).","example":"The hook used a small gentle as bait.","exampleTranslation":"Cái lưỡi câu đã sử dụng một con mồi giòi nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"genuine":{"definition":"Thật, chính cống, xác thực.","example":"She found a genuine pearl in the ocean.","exampleTranslation":"Cô ấy tìm thấy một viên ngọc trai thật ở dưới đại dương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"giant":{"definition":"Khổng lồ.","example":"A giant cabbage grew in our backyard garden.","exampleTranslation":"Một cây bắp cải khổng lồ đã mọc trong khu vườn phía sau nhà chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"gigantic":{"definition":"Khổng lồ, kếch xù.","example":"The gigantic tree shaded the whole yard.","exampleTranslation":"Cái cây khổng lồ đã che bóng cho cả sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"glance":{"definition":"Quặng bóng.","example":"The copper glance shone in the dark cave.","exampleTranslation":"Quặng bóng bằng đồng đã tỏa sáng trong hang tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"glimpse":{"definition":"Cái nhìn lướt qua, cái nhìn thoáng qua.","example":"I caught a quick glimpse of the bird.","exampleTranslation":"Tôi đã thoáng thấy con chim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"glorious":{"definition":"Vinh quang, vẻ vang, vinh dự.","example":"The team celebrated a glorious victory last night.","exampleTranslation":"Cả đội đã ăn mừng chiến thắng vinh quang tối qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"glow":{"definition":"Tỏa ra ánh sáng khi bị nóng.","example":"He will glow the files later.","exampleTranslation":"Anh ấy sẽ nung tỏa ánh sáng các tập hồ sơ sau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"gnarled":{"definition":"Lắm mấu, xương xẩu (thân cây, cành cây; ngón tay... ).","example":"The gnarled tree grew beside the path.","exampleTranslation":"Cái cây lắm mấu mọc bên cạnh lối đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"goad":{"definition":"Gậy nhọn (để thúc trâu bò... ).","example":"The farmer carried a goad beside the cart.","exampleTranslation":"Người nông dân mang theo một cái gậy nhọn bên cạnh xe kéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"gobs":{"definition":"Động từ chia ở ngôi thứ ba số ít của gob","example":"The child gobs into the bucket.","exampleTranslation":"Đứa trẻ nhổ nước bọt vào cái xô.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"gotten":{"definition":"(chủ yếu là Canada, Mỹ, Ireland, Scotland, Bắc Anh, hoặc cổ xưa) Dạng quá khứ phân từ của get","example":"The team had to gotten the system.","exampleTranslation":"Cả đội đã phải có được hệ thống đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"grab":{"definition":"Cái chộp; sự túm lấy, sự vồ lấy, sự tóm, sự cố tóm lấy.","example":"He made a quick grab for the last cookie.","exampleTranslation":"Anh ấy đã cố vồ lấy chiếc bánh quy cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"gradually":{"definition":"dần dần; từ từ","example":"The everyday life of the citizens gradually went back to normal after the earthquake.","exampleTranslation":"Cuộc sống hàng ngày của người dân dần dần trở lại bình thường sau trận động đất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"grand":{"definition":"Rất quan trọng, rất lớn.","example":"This is a very grand question for us.","exampleTranslation":"Đây là một câu hỏi rất quan trọng đối với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"great":{"definition":"Lớn, to lớn, vĩ đại.","example":"A great wind blew the leaves away today.","exampleTranslation":"Một cơn gió lớn đã thổi bay những chiếc lá ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"greatly":{"definition":"Rất lắm.","example":"She answered greatly and smiled.","exampleTranslation":"Cô ấy đã trả lời rất lắm và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"greatness":{"definition":"Sự cao quý, sự cao cả, sự cao thượng.","example":"Her greatness came from her calm, generous heart.","exampleTranslation":"Sự cao thượng của cô ấy đến từ trái tim điềm tĩnh, rộng lượng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"greenish":{"definition":"Hơi lục.","example":"The leaves turned greenish after the rain.","exampleTranslation":"Những chiếc lá chuyển sang màu hơi lục sau cơn mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"grey":{"definition":"Hoa râm (tóc).","example":"My father has many strands of grey hair.","exampleTranslation":"Cha tôi có nhiều sợi tóc hoa râm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"grip":{"definition":"Rãnh nhỏ, mương nhỏ.","example":"Water ran in a narrow grip beside the road.","exampleTranslation":"Nước chảy trong một cái rãnh nhỏ bên cạnh con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"grit":{"definition":"Hạt sạn (làm cho máy trục trặc).","example":"There is some grit in the machine gears.","exampleTranslation":"Có một chút hạt sạn trong bánh răng máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"groove":{"definition":"Nếp sông đều đều, thói quen, thói cũ, đường mòn.","example":"She finally got into a productive groove today.","exampleTranslation":"Cuối cùng cô ấy đã bắt nhịp được vào một lối sống năng suất ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"hail":{"definition":"Loạt, tràng dồn dập (như mưa); trận tới tấp.","example":"A hail of questions came from the audience.","exampleTranslation":"Một loạt các câu hỏi tới tấp đến từ khán giả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"halfway":{"definition":"Nằm ở giữa với hai khoảng cách bằng nhau; nửa đường; nửa chừng.","example":"They reached the halfway point of the race.","exampleTranslation":"Họ đã đạt đến điểm nửa đường của cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"halve":{"definition":"Giảm một nửa, giảm chỉ còn một nửa (tiền chi phí... ).","example":"The new plan will halve our weekly costs.","exampleTranslation":"Kế hoạch mới sẽ giảm một nửa chi phí hàng tuần của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"handful":{"definition":"Nhúm, (một) nắm; (một) ít (người... ).","example":"I only have a handful of coins in my pocket.","exampleTranslation":"Tôi chỉ có một nhúm đồng xu trong túi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"handle":{"definition":"Điểm người ta có thể lợi dụng được.","example":"The spy gave a handle to his enemy.","exampleTranslation":"Tên gián điệp đã tạo ra một điểm người ta có thể lợi dụng được cho kẻ thù của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"handwritten":{"definition":"Viết bằng tay (thay vì đánh máy).","example":"She found a handwritten note on the table.","exampleTranslation":"Cô ấy tìm thấy một ghi chú viết bằng tay trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"hang":{"definition":"Sự cúi xuống, sự gục xuống.","example":"He gave a small hang of his head.","exampleTranslation":"Anh ấy đã cúi xuống một chút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"haphazardly":{"definition":"Bừa bãi, lung tung.","example":"They worked haphazardly all day.","exampleTranslation":"Họ đã làm việc một cách bừa bãi cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"hapless":{"definition":"Rủi ro, không may.","example":"The hapless boy missed the bus again.","exampleTranslation":"Cậu bé rủi ro lại lỡ chuyến xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"hardly":{"definition":"Not much, very little.","example":"I hardly noticed the pain.","exampleTranslation":"Tôi hầu như không nhận ra nỗi đau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"harsh":{"definition":"Thô, ráp, xù xì.","example":"The rocks felt harsh under his shoes.","exampleTranslation":"Những tảng đá cảm thấy thô ráp dưới giày của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"hasten":{"definition":"Vội, vội vàng, vội vã; hấp tấp.","example":"He made a hasten decision and missed the bus.","exampleTranslation":"Anh ấy đã đưa ra một quyết định vội vàng và lỡ chuyến xe buýt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"hastily":{"definition":"Vội vàng, hấp tấp.","example":"The team finished hastily and left.","exampleTranslation":"Cả nhóm đã hoàn thành vội vàng và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"hasty":{"definition":"Vội, vội vàng, vội vã; nhanh chóng, gấp rút, mau.","example":"Do not make a hasty decision about the job.","exampleTranslation":"Đừng đưa ra một quyết định vội vàng về công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"heap":{"definition":"Đống.","example":"A huge heap of sand lay on the beach.","exampleTranslation":"Một đống cát khổng lồ nằm trên bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"hear":{"definition":"Nghe theo, chấp nhận, đồng ý.","example":"He will not hear of such a plan.","exampleTranslation":"Anh ấy sẽ không nghe theo kế hoạch như vậy đâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"heavily":{"definition":"Nặng, nặng nề ((nghĩa đen) & (nghĩa bóng)).","example":"A heavily loaded truck moved slowly down the road.","exampleTranslation":"Một chiếc xe tải chở nặng nề di chuyển chậm chạp dọc theo con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"heavy":{"definition":"Nặng, nặng nề ((nghĩa đen) & (nghĩa bóng)).","example":"He carried a heavy box up the stairs.","exampleTranslation":"Anh ấy đã mang một cái hộp nặng nề lên cầu thang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"heck":{"definition":"Cái đăng (đặt ở ngang sông để bắt cá).","example":"Fish were trapped in the heck.","exampleTranslation":"Cá đã bị mắc kẹt trong cái đăng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"heighten":{"definition":"Tăng thêm, tăng cường.","example":"The bright lights heighten the mood of the party.","exampleTranslation":"Những ánh đèn sáng tăng cường tâm trạng của bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"helpful":{"definition":"Giúp đỡ; giúp ích; có ích.","example":"Her helpful advice saved us time.","exampleTranslation":"Lời khuyên giúp đỡ của cô ấy đã tiết kiệm thời gian cho chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"herself":{"definition":"chính cô ấy; bản thân cô ấy","example":"She went by herself to the store.","exampleTranslation":"Cô ấy đã tự mình đi đến cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"pron","posGroup":"other","family":"general-reading"},"hide":{"definition":"Đánh đòn.","example":"Do not hide the child for being late.","exampleTranslation":"Đừng đánh đòn đứa trẻ vì đã đến muộn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"high":{"definition":"Đúng giữa; đến lúc.","example":"They met at high noon in the park.","exampleTranslation":"Họ gặp nhau vào đúng giữa trưa trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"highly":{"definition":"Rất, lắm, hết sức, ở mức độ cao.","example":"I highly recommend this new restaurant.","exampleTranslation":"Tôi rất khuyến khích nhà hàng mới này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"himself":{"definition":"chính anh ấy; bản thân anh ấy","example":"He went by himself to the store.","exampleTranslation":"Anh ấy đã tự mình đi đến cửa hàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"pron","posGroup":"other","family":"general-reading"},"hind":{"definition":"Người quê mùa cục mịch.","example":"The old hind refused to learn new ways.","exampleTranslation":"Người quê mùa cục mịch từ chối học những cách mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"hinder":{"definition":"Cản trở, gây trở ngại.","example":"Heavy rain can hinder our travel plans today.","exampleTranslation":"Mưa lớn có thể gây trở ngại cho kế hoạch du lịch của chúng ta hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"hint":{"definition":"Lời gợi ý; lời nói bóng gió, lời nói ám chỉ.","example":"Can you give me a hint about the answer?","exampleTranslation":"Bạn có thể cho tôi một lời gợi ý về câu trả lời không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"holder":{"definition":"Người giữ, người nắm giữ; người giữ một chức vụ; (thể dục, thể thao) người giữ kỷ lục.","example":"She is the holder of the record.","exampleTranslation":"Cô ấy là người giữ kỷ lục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"hole":{"definition":"Lỗ trống (trong không khí).","example":"The window left a hole in the cold air.","exampleTranslation":"Cửa sổ để lại một lỗ trống trong không khí lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"hollow":{"definition":"Trống rỗng, đói meo (bụng).","example":"After the long walk, his stomach felt hollow.","exampleTranslation":"Sau chuyến đi dài, bụng anh ấy cảm thấy trống rỗng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"hook":{"definition":"Cú hất móc về đằng sau (bóng bầu dục).","example":"The player used a hook to stop him.","exampleTranslation":"Cầu thủ đã sử dụng một cú hất móc để ngăn anh ta lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"horrendously":{"definition":"Kinh khủng, khủng khiếp.","example":"She spoke horrendously during the meeting.","exampleTranslation":"Cô ấy đã nói kinh khủng trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"horrific":{"definition":"Kinh khủng, khủng khiếp, ghê khiếp.","example":"The movie showed a horrific accident.","exampleTranslation":"Bộ phim cho thấy một tai nạn khủng khiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"hose":{"definition":"Bít tất dài.","example":"She wore long hose with her dress.","exampleTranslation":"Cô ấy mặc bít tất dài với chiếc váy của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"hotly":{"definition":"Sôi động, kịch liệt.","example":"They worked hotly all day.","exampleTranslation":"Họ đã làm việc một cách sôi động cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"hover":{"definition":"Do dự, băn khoăn, phân vân; ở trong một tình trạng lơ lửng.","example":"She seemed to hover between two difficult choices.","exampleTranslation":"Cô ấy dường như do dự giữa hai lựa chọn khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"hundredth":{"definition":"Thứ một trăm.","example":"She finished in hundredth place in the race.","exampleTranslation":"Cô ấy về đích thứ một trăm trong cuộc đua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"identical":{"definition":"Đồng nhất.","example":"They presented two identical plans for the project.","exampleTranslation":"Họ đã trình bày hai kế hoạch đồng nhất cho dự án.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"idle":{"definition":"Ngồi rồi, không làm việc gì.","example":"I spent an idle hour reading my favorite book.","exampleTranslation":"Tôi đã dành một giờ nhàn rỗi để đọc cuốn sách yêu thích của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"immanent":{"definition":"Nội tại.","example":"Some people believe kindness is immanent in us.","exampleTranslation":"Một số người tin rằng lòng tốt là nội tại trong chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"immense":{"definition":"Mênh mông, bao la, rộng lớn.","example":"The room felt immense with its high ceiling.","exampleTranslation":"Căn phòng tạo cảm giác mênh mông với trần nhà cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"immerse":{"definition":"Nhúng, nhận chìm, ngâm.","example":"Immerse the cloth in warm water.","exampleTranslation":"Hãy nhúng miếng vải vào nước ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"imminent":{"definition":"Sắp xảy ra, (xảy ra) đến nơi.","example":"A heavy storm is imminent in this area.","exampleTranslation":"Một cơn bão lớn sắp xảy ra trong khu vực này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"impact":{"definition":"Sự va chạm, sự chạm mạnh; sức va chạm.","example":"The car suffered a head-on impact with the wall.","exampleTranslation":"Chiếc xe đã chịu một cú va chạm trực diện với bức tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"impenetrable":{"definition":"Không thể qua được, không thể xuyên thủng.","example":"The thick jungle was almost impenetrable to us.","exampleTranslation":"Khu rừng rậm rạp gần như không thể xuyên thủng đối với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"imperfect":{"definition":"Không hoàn hảo, không hoàn chỉnh, không hoàn toàn.","example":"The page was imperfect, with a small tear.","exampleTranslation":"Trang giấy đó không hoàn hảo, với một vết rách nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"impinge":{"definition":"Đụng chạm, va chạm.","example":"His actions might impinge on our personal privacy.","exampleTranslation":"Hành động của anh ấy có thể đụng chạm đến quyền riêng tư cá nhân của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"importantly":{"definition":"Quan trọng, trội yếu.","example":"The team finished importantly and left.","exampleTranslation":"Cả đội đã kết thúc một cách quan trọng và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"impossible":{"definition":"Không thể làm được.","example":"Completing this project in one day is impossible.","exampleTranslation":"Việc hoàn thành dự án này trong một ngày là không thể làm được.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"impractical":{"definition":"Không thực tế.","example":"Traveling daily by boat was impractical for her.","exampleTranslation":"Việc đi lại hàng ngày bằng thuyền là không thực tế đối với cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inaccessible":{"definition":"Không tới được, không tới gần được; không vào được.","example":"The mountain path was inaccessible after heavy rain.","exampleTranslation":"Con đường núi không thể tới được sau cơn mưa lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inactive":{"definition":"Không hoạt động, thiếu hoạt động, ì.","example":"The machine stayed inactive all morning.","exampleTranslation":"Cỗ máy vẫn không hoạt động suốt cả buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inadvertently":{"definition":"Vô tình","example":"I inadvertently deleted the file.","exampleTranslation":"Tôi đã vô tình xóa tệp đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"incalculable":{"definition":"Không đếm xuể, không kể xiết, hằng hà sa số, vô số.","example":"She felt incalculable joy after the news.","exampleTranslation":"Cô ấy cảm thấy niềm vui không đếm xuể sau tin tức đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"incident":{"definition":"Phụ thuộc vào, gắn liền với.","example":"The incident costs were paid by the company.","exampleTranslation":"Các chi phí phụ thuộc vào được chi trả bởi công ty.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"incidental":{"definition":"Ngẫu nhiên, tình cờ, bất ngờ.","example":"We had an incidental encounter with our old friends today.","exampleTranslation":"Chúng tôi đã có một cuộc gặp gỡ ngẫu nhiên với những người bạn cũ của mình hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"incompatible":{"definition":"Không hợp với, không thích hợp với, không tương hợp với, kỵ nhau.","example":"Smoking is incompatible with good health.","exampleTranslation":"Hút thuốc không hợp với sức khỏe tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"incomplete":{"definition":"Chưa hoàn thành, chưa xong.","example":"The task is incomplete and needs more work.","exampleTranslation":"Công việc đó chưa hoàn thành và cần thêm thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"incorporate":{"definition":"Kết hợp chặt chẽ.","example":"The two ideas are incorporate in one plan.","exampleTranslation":"Hai ý tưởng được kết hợp chặt chẽ trong một kế hoạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"incredible":{"definition":"Không thể tin được.","example":"The view from the hill was incredible.","exampleTranslation":"Khung cảnh từ ngọn đồi thật không thể tin được.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"indeed":{"definition":"Thực vậy, thực sự, thực mà, thật mà, quả thực, thực lại là.","example":"I was indeed very glad to hear the news.","exampleTranslation":"Tôi thực vậy rất vui khi nghe tin này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"indefinite":{"definition":"Mập mờ, không rõ ràng, không dứt khoát.","example":"She gave an indefinite answer to my question.","exampleTranslation":"Cô ấy đã đưa ra một câu trả lời mập mờ cho câu hỏi của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"indirect":{"definition":"Gián tiếp.","example":"He gave me an indirect reply.","exampleTranslation":"Anh ấy đã đưa cho tôi một câu trả lời gián tiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"indirectly":{"definition":"Gián tiếp.","example":"She referred to her brother indirectly.","exampleTranslation":"Cô ấy đã đề cập đến anh trai mình một cách gián tiếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"ineffective":{"definition":"Không có hiệu quả.","example":"The old plan was ineffective.","exampleTranslation":"Kế hoạch cũ không có hiệu quả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inevitable":{"definition":"Vẫn thường thấy; vẫn thường nghe; quen thuộc.","example":"Change is often an inevitable part of life.","exampleTranslation":"Thay đổi thường là một phần vẫn thường thấy của cuộc sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inevitably":{"definition":"không thể tránh khỏi; tất yếu","example":"A drop in the number of worker in a country inevitably leads to higher wages.","exampleTranslation":"Sự sụt giảm số lượng công nhân trong một quốc gia không thể tránh khỏi dẫn đến mức lương cao hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"inferior":{"definition":"Thấp hơn, kém; thấp kém, tồi (vật... ).","example":"This phone feels inferior to the last model.","exampleTranslation":"Điện thoại này cảm giác thấp hơn so với mẫu trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inflate":{"definition":"Thổi phồng, bơm phồng.","example":"The balloon will inflate in a few seconds.","exampleTranslation":"Quả bóng sẽ thổi phồng trong vài giây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"infuse":{"definition":"Rót, đổ.","example":"She will infuse the juice into the bowl.","exampleTranslation":"Cô ấy sẽ rót nước trái cây vào bát.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"ingenious":{"definition":"Khéo léo.","example":"She found a clever and ingenious way to fix it.","exampleTranslation":"Cô ấy đã tìm thấy một cách khéo léo để sửa nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"initial":{"definition":"Ban đầu, đầu.","example":"The initial cost was lower than expected.","exampleTranslation":"Chi phí ban đầu thấp hơn dự kiến.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"initially":{"definition":"Vào lúc đầu, ban đầu.","example":"She answered initially and smiled.","exampleTranslation":"Cô ấy đã trả lời vào lúc đầu và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"inkling":{"definition":"Lời gợi ý xa xôi.","example":"I had an inkling that she knew the truth.","exampleTranslation":"Tôi đã có một lời gợi ý xa xôi rằng cô ấy biết sự thật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"inks":{"definition":"Động từ chia ở ngôi thứ ba số ít của ink","example":"The pen inks the card neatly.","exampleTranslation":"Chiếc bút in vết mực lên tấm thiệp một cách gọn gàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"inner":{"definition":"Thân nhất, thân cận.","example":"He shared the news with his inner friends.","exampleTranslation":"Anh ấy đã chia sẻ tin tức với những người bạn thân nhất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"inroad":{"definition":"Sự xâm nhập.","example":"The new road brought an inroad into the forest.","exampleTranslation":"Con đường mới mang lại một sự xâm nhập vào khu rừng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"inside":{"definition":"Ở trong, từ trong, nội bộ.","example":"She shared some secret inside information with me.","exampleTranslation":"Cô ấy đã chia sẻ một số thông tin nội bộ bí mật với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"insignificant":{"definition":"Không quan trọng, tầm thường.","example":"The difference is insignificant to me.","exampleTranslation":"Sự khác biệt là không quan trọng đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"instant":{"definition":"Lúc, chốc lát.","example":"Please come here this instant to see me.","exampleTranslation":"Xin hãy đến đây lúc chốc lát này để gặp tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"instantly":{"definition":"Ngay khi.","example":"I came instantly and saw the need for help.","exampleTranslation":"Tôi đã đến ngay khi và thấy sự cần thiết của sự giúp đỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"C","posGroup":"other","family":"general-reading"},"instead":{"definition":"Để thay vào, để thế cho; đáng lẽ là; thay vì","example":"Please sit here instead of on the floor.","exampleTranslation":"Xin hãy ngồi đây thay vì trên sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"intact":{"definition":"Không bị đụng chạm đến, không bị sứt mẻ, còn nguyên vẹn.","example":"The vase remained intact after the drop.","exampleTranslation":"Chiếc bình vẫn còn nguyên vẹn sau khi bị rơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"intake":{"definition":"Sự lấy vào; vật lấy vào; lượng lấy vào.","example":"The machine has a small intake for the water.","exampleTranslation":"Cỗ máy có một lượng lấy vào nhỏ cho nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"intend":{"definition":"Định, có ý định, có ý muốn.","example":"I intend to finish the report tonight.","exampleTranslation":"Tôi định hoàn thành báo cáo tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"intense":{"definition":"Mạnh, có cường độ lớn.","example":"She felt an intense heat in the room.","exampleTranslation":"Cô ấy cảm thấy một luồng hơi nóng mạnh trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"intensification":{"definition":"Sự làm sâu sắc thêm, sự làm mạnh thêm.","example":"Her study led to a deep intensification of skill.","exampleTranslation":"Sự học của cô ấy dẫn đến một sự làm sâu sắc thêm kỹ năng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"intensify":{"definition":"Làm mãnh liệt, làm dữ dội.","example":"Her fear started to intensify in the dark.","exampleTranslation":"Nỗi sợ của cô ấy bắt đầu làm mãnh liệt trong bóng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"intermediate":{"definition":"Người làm trung gian, người hoà giải.","example":"The mediator acted as an intermediate in the dispute.","exampleTranslation":"Người hòa giải đã đóng vai trò như một người làm trung gian trong cuộc tranh chấp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"intertwine":{"definition":"Quấn vào nhau, bện vào nhau.","example":"The ribbons intertwine around the gift.","exampleTranslation":"Những dải ruy băng quấn vào nhau xung quanh món quà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"intricately":{"definition":"Rắc rối, phức tạp.","example":"He moved intricately through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách đầy rắc rối xuyên qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"invaluable":{"definition":"Vô giá.","example":"His voice stayed invaluable all night.","exampleTranslation":"Giọng của anh ấy vẫn vô giá suốt cả đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"invisible":{"definition":"Không thể trông thấy được, tính vô hình.","example":"The bird was almost invisible in the dark trees.","exampleTranslation":"Chú chim gần như không thể trông thấy được trong những cái cây tối tăm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"irreversible":{"definition":"Không thể đảo ngược lại; không thể thay đổi được.","example":"The decision felt irreversible after signing.","exampleTranslation":"Quyết định cảm giác không thể đảo ngược lại sau khi ký.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"jack":{"definition":"Gỗ mít.","example":"The shelf was made of hard jack wood.","exampleTranslation":"Cái kệ được làm bằng gỗ mít cứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"jars":{"definition":"Động từ chia ở ngôi thứ ba số ít của jar","example":"The team had to jars the system.","exampleTranslation":"Cả đội đã phải làm rung chuyển hệ thống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"jumbo":{"definition":"Người hoặc vật to lớn, khỏe mạnh một cách đặc biệt.","example":"That dog is a jumbo beside the others.","exampleTranslation":"Chú chó đó là một con vật to lớn một cách đặc biệt bên cạnh những con khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"juncture":{"definition":"Tình hình, sự việc; thời cơ.","example":"We must make a decision at this critical juncture.","exampleTranslation":"Chúng ta phải đưa ra quyết định tại tình hình quan trọng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"keyhole":{"definition":"Lỗ khoá.","example":"Dust gathered around the old keyhole.","exampleTranslation":"Bụi bặm tập trung quanh lỗ khoá cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"kill":{"definition":"Giết, giết chết, làm chết, diệt ((nghĩa đen) & (nghĩa bóng)).","example":"I need to find something to kill my time.","exampleTranslation":"Tôi cần tìm thứ gì đó để giết thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"knife":{"definition":"Dao mổ.","example":"Be careful when you use that sharp knife.","exampleTranslation":"Hãy cẩn thận khi sử dụng con dao sắc đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"knob":{"definition":"Quả đám (ở cửa, tủ... ).","example":"She turned the knob to open the door.","exampleTranslation":"Cô ấy vặn quả đám để mở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"knock":{"definition":"Cú đánh, cú va chạm.","example":"He received a hard knock on the head today.","exampleTranslation":"Hôm nay anh ấy đã nhận một cú đánh mạnh vào đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"knot":{"definition":"Vấn đề khó khăn.","example":"This complex knot is very hard to untie.","exampleTranslation":"Cái vấn đề khó khăn này rất khó để tháo gỡ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lace":{"definition":"Ren, đăng ten.","example":"The dress had blue lace on the sleeves.","exampleTranslation":"Chiếc váy có ren màu xanh trên tay áo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lack":{"definition":"Sự thiếu.","example":"The plant died for lack of water.","exampleTranslation":"Cây đã chết vì sự thiếu nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ladder":{"definition":"Thang ((nghĩa đen) & (nghĩa bóng)).","example":"We need a folding ladder to reach the roof.","exampleTranslation":"Chúng tôi cần một cái thang gấp để chạm tới mái nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lamp":{"definition":"Mặt trời, mặt trăng, sao.","example":"The sun is the bright lamp of Phoebus.","exampleTranslation":"Mặt trời là ngọn đèn rực rỡ của Phoebus.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lapse":{"definition":"Sự sa ngã, sự suy đồi, sự truỵ lạc.","example":"He suffered a moral lapse during his travels.","exampleTranslation":"Anh ấy đã gặp một sự sa ngã về đạo đức trong những chuyến đi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"largely":{"definition":"phần lớn; chủ yếu","example":"The changes were largely based on her ideas.","exampleTranslation":"Những thay đổi phần lớn dựa trên ý tưởng của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"large":{"definition":"Rộng, lớn, to.","example":"They live in a large house near the park.","exampleTranslation":"Họ sống trong một ngôi nhà rộng gần công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lateral":{"definition":"Phần bên, bộ phận bên, vật bên.","example":"The lateral door opened into a small hall.","exampleTranslation":"Cánh cửa bên mở ra một sảnh nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"latter":{"definition":"Sau cùng, gần đây, mới đây.","example":"Many people face problems in these latter days.","exampleTranslation":"Nhiều người phải đối mặt với vấn đề trong những ngày sau cùng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"layer":{"definition":"Người đặt, người gài (bẫy).","example":"The layer set the trap near the path.","exampleTranslation":"Người đặt bẫy đã đặt bẫy gần con đường mòn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"leap":{"definition":"Quãng cách nhảy qua.","example":"This discovery represents making a huge leap forward.","exampleTranslation":"Khám phá này đại diện cho việc thực hiện một quãng cách nhảy qua khổng lồ về phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lengthy":{"definition":"Dài, dài dòng; làm buồn, làm chán.","example":"She gave a lengthy speech at the graduation ceremony.","exampleTranslation":"Cô ấy đã có một bài phát biểu dài dòng tại lễ tốt nghiệp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lessen":{"definition":"Làm nhỏ đi, làm bé đi, làm giảm đi.","example":"We need to find a way to lessen the strain.","exampleTranslation":"Chúng ta cần tìm cách để làm giảm đi sự căng thẳng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"lesser":{"definition":"Nhỏ hơn, bé hơn, ít hơn.","example":"We need a lesser amount of sugar.","exampleTranslation":"Chúng ta cần một lượng nhỏ hơn đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lest":{"definition":"Rằng, (sợ) rằng.","example":"He spoke softly lest he should wake the baby.","exampleTranslation":"Anh ấy nói khẽ rằng anh ấy sợ rằng anh ấy sẽ làm đánh thức em bé.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"level":{"definition":"Mức, mực; mặt.","example":"The level of the sea is rising quickly.","exampleTranslation":"Mức của mực nước biển đang dâng lên nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lifelike":{"definition":"Giống như thật.","example":"The lifelike model looked almost alive.","exampleTranslation":"Mô hình giống như thật trông gần như còn sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lifelong":{"definition":"Suốt đời.","example":"She kept a lifelong love of music.","exampleTranslation":"Cô ấy giữ một tình yêu âm nhạc suốt đời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lifetime":{"definition":"Suốt đời.","example":"She spent her lifetime working as a nurse.","exampleTranslation":"Cô ấy đã dành suốt đời làm y tá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lightweight":{"definition":"Thể (thuộc) hạng cân nhẹ.","example":"He competed in the lightweight division.","exampleTranslation":"Anh ấy thi đấu ở hạng cân nhẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"like":{"definition":"Người thuộc loại như; vật thuộc loại như.","example":"did not ever see the like of it?","exampleTranslation":"Đã bao giờ thấy người thuộc loại như vậy chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"limit":{"definition":"Giới hạn, hạn độ.","example":"There is no limit to her creative imagination.","exampleTranslation":"Không có giới hạn cho trí tưởng tượng sáng tạo của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"limitation":{"definition":"Sự hạn chế, sự hạn định, sự giới hạn.","example":"The new rule put a limitation on noise.","exampleTranslation":"Quy tắc mới đặt ra một sự hạn chế về tiếng ồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"line":{"definition":"Dây, dây thép.","example":"Please hang your wet clothes on the line outside.","exampleTranslation":"Làm ơn phơi quần áo ướt của bạn trên dây bên ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lipped":{"definition":"Có vòi (ấm).","example":"The lipped pot poured water slowly.","exampleTranslation":"Cái ấm có vòi rót nước chậm rãi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"live":{"definition":"Sống.","example":"We must fight for justice as we live.","exampleTranslation":"Chúng ta phải chiến đấu vì công lý khi chúng ta còn sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"lock":{"definition":"Khóa, ổ khóa.","example":"Please put the jewelry under lock and key.","exampleTranslation":"Làm ơn cất đồ trang sức dưới ổ khóa và chìa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"long":{"definition":"Chậm, chậm trễ, lâu.","example":"Please do not be long at the store.","exampleTranslation":"Làm ơn đừng ở lại cửa hàng quá lâu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"loom":{"definition":"Khung cửi (dệt vải)","example":"The loom filled the small room with noise.","exampleTranslation":"Khung cửi lấp đầy căn phòng nhỏ với tiếng ồn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"loose":{"definition":"Lỏng, không chặt, chùng, không căng, không khít, rời ra, lung lay, long ra, lòng thòng.","example":"He has some loose hair on his head.","exampleTranslation":"Anh ấy có vài sợi tóc lỏng trên đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lose":{"definition":"Mất không còn nữa.","example":"I do not want to lose my keys.","exampleTranslation":"Tôi không muốn mất chìa khóa của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"loss":{"definition":"Sự thiệt hại, tổn hại, tổn thất, thua lỗ.","example":"The shop sold many items at a loss.","exampleTranslation":"Cửa hàng đã bán nhiều món đồ với sự thua lỗ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"loud":{"definition":"To, ầm ĩ, inh ỏi (tiếng).","example":"I heard a loud cry in the street.","exampleTranslation":"Tôi nghe thấy một tiếng khóc ầm ĩ trên đường phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lower":{"definition":"Làm xấu đi, làm thành hèn hạ, làm giảm giá trị.","example":"He did not want to lower himself by lying.","exampleTranslation":"Anh ấy không muốn làm mình thấp đi bằng cách nói dối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"lowest":{"definition":"Thấp nhất; nhỏ nhất.","example":"The lowest shelf is hard to reach.","exampleTranslation":"Cái kệ thấp nhất rất khó để chạm tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"lump":{"definition":"Cục, tảng, miếng.","example":"She put a lump of sugar in her tea.","exampleTranslation":"Cô ấy bỏ một cục đường vào tách trà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lunch":{"definition":"Bữa ăn trưa.","example":"We ate lunch by the window.","exampleTranslation":"Chúng tôi ăn bữa ăn trưa bên cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"lure":{"definition":"Gọi chim ưng về bằng cách tung chim giả tung lên.","example":"The trainer used a lure to call the hawk.","exampleTranslation":"Người huấn luyện đã dùng mồi để gọi chim ưng về.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"lurk":{"definition":"Ẩn náu, núp, lẩn trốn, trốn tránh, lẩn mặt; lủi.","example":"A cat can lurk quietly behind the curtains.","exampleTranslation":"Một con mèo có thể lẩn trốn lặng lẽ sau những tấm màn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"maintain":{"definition":"Giữ, duy trì, bảo vệ, bảo quản.","example":"You must maintain friendly relations with your coworkers.","exampleTranslation":"Bạn phải duy trì quan hệ thân thiện với đồng nghiệp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"maintenance":{"definition":"Sự giữ, sự duy trì; sự bảo vệ, sự bảo quản.","example":"High maintenance costs can be difficult for new owners.","exampleTranslation":"Chi phí bảo trì cao có thể là khó khăn đối với những chủ sở hữu mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mallet":{"definition":"Cái vồ.","example":"He used a mallet to tap the nail.","exampleTranslation":"Anh ấy dùng một cái vồ để gõ vào cái đinh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"margin":{"definition":"Mép, bờ, lề.","example":"They sat on the margin of the quiet lake.","exampleTranslation":"Họ ngồi trên mép của cái hồ yên tĩnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mark":{"definition":"Dấu, nhãn, nhãn hiệu.","example":"Please put a mark on the right box.","exampleTranslation":"Làm ơn đặt một dấu vào hộp bên phải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"marker":{"definition":"Người ghi.","example":"The marker wrote the answers on the board.","exampleTranslation":"Người ghi đã viết câu trả lời trên bảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"marvel":{"definition":"Người kỳ dị, người kỳ lạ, người khác thường.","example":"He is a marvel of patience during the crisis.","exampleTranslation":"Anh ấy là một người kỳ dị về sự kiên nhẫn trong suốt cuộc khủng hoảng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mask":{"definition":"Mạng che mặt của phụ nữ ngày xưa; mặt nạ ((nghĩa đen) & (nghĩa bóng)).","example":"She wore a mask to hide her identity.","exampleTranslation":"Cô ấy đeo một mặt nạ để che giấu danh tính của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"massive":{"definition":"To lớn, đồ sộ; chắc nặng","example":"They built a massive pillar in the center.","exampleTranslation":"Họ đã xây một cột trụ to lớn ở trung tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mate":{"definition":"Nước chiếu tướng.","example":"The king was in mate on the board.","exampleTranslation":"Nhà vua đã ở thế chiếu tướng trên bàn cờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"maze":{"definition":"Trạng thái hỗn độn, trạng thái rối rắm.","example":"He felt lost in a maze of thoughts.","exampleTranslation":"Anh ấy cảm thấy lạc trong một trạng thái hỗn độn của những suy nghĩ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"memorable":{"definition":"Đáng ghi nhớ, không quên được.","example":"That sunrise made for a memorable morning.","exampleTranslation":"Bình minh đó tạo nên một buổi sáng đáng ghi nhớ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"merely":{"definition":"Chỉ, đơn thuần.","example":"She spoke merely during the meeting.","exampleTranslation":"Cô ấy chỉ phát biểu đơn thuần trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"mess":{"definition":"Tình trạng hỗn độn, tình trạng lộn xộn, tình trạng bừa bộn; tình trạng bẩn thỉu.","example":"The whole room was in a mess after the party.","exampleTranslation":"Cả căn phòng trong tình trạng hỗn độn sau bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"middle":{"definition":"Giữa.","example":"Please sit in the middle of the room.","exampleTranslation":"Làm ơn ngồi ở giữa căn phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"midway":{"definition":"Nửa đường, giữa đường.","example":"The shop is halfway there, at the midway point.","exampleTranslation":"Cửa hàng nằm ở nửa đường, tại điểm giữa đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mighty":{"definition":"To lớn, vĩ đại, hùng vĩ, đồ sộ.","example":"They sailed across the mighty ocean together.","exampleTranslation":"Họ đã cùng nhau băng qua đại dương vĩ đại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mild":{"definition":"Êm dịu, không gắt, không xóc (thức ăn, thuốc lá, thuốc men... ).","example":"I prefer to drink a mild beer tonight.","exampleTranslation":"Tôi thích uống một loại bia êm dịu tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mimic":{"definition":"Nhại (ai).","example":"Don't mimic my voice in front of the class.","exampleTranslation":"Đừng nhại giọng tôi trước cả lớp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"mini":{"definition":"Xe mini (một loại xe nhỏ).","example":"She drove a mini to work.","exampleTranslation":"Cô ấy lái một chiếc xe mini đi làm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mint":{"definition":"Sự cố gắng.","example":"It took every mint of energy I had.","exampleTranslation":"Nó lấy đi từng chút năng lượng tôi có.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"minuscule":{"definition":"Nhỏ xíu, rất nhỏ.","example":"The text was minuscule on the old page.","exampleTranslation":"Văn bản nhỏ xíu trên trang cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"miracle":{"definition":"Phép lạ, phép mầu, phép thần diệu.","example":"Finding the lost dog felt like a miracle.","exampleTranslation":"Việc tìm thấy con chó bị lạc giống như một phép màu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"miraculous":{"definition":"Thần diệu, huyền diệu.","example":"The rescue felt miraculous to us.","exampleTranslation":"Cuộc giải cứu mang lại cảm giác thật kỳ diệu đối với chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mirror":{"definition":"Hình ảnh trung thực (của cái gì).","example":"The report was a mirror of daily life.","exampleTranslation":"Bản báo cáo là tấm gương phản chiếu cuộc sống hàng ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mislead":{"definition":"Làm cho lạc đường, làm cho lạc lối.","example":"Maps can mislead people in the dark.","exampleTranslation":"Bản đồ có thể làm lạc lối mọi người trong bóng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"mismatch":{"definition":"Ghép đôi không xứng.","example":"The shirt and jacket mismatch badly.","exampleTranslation":"Chiếc áo và chiếc áo khoác không ăn nhập với nhau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"mistake":{"definition":"Lỗi, sai lầm, lỗi lầm.","example":"It is easy to make a mistake sometimes.","exampleTranslation":"Đôi khi mắc lỗi là điều dễ hiểu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mixed":{"definition":"Lẫn lộn, pha trộn, ô hợp.","example":"She has mixed feelings about her new job.","exampleTranslation":"Cô ấy có những cảm xúc lẫn lộn về công việc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mode":{"definition":"Cách, cách thức, lối, phương thức.","example":"What is your favorite mode of transport for travel?","exampleTranslation":"Phương thức vận tải ưa thích của bạn để đi du lịch là gì?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"moderate":{"definition":"Vừa phải; phải chăng, có mức độ; điều độ.","example":"They sell fresh fruit at moderate prices here.","exampleTranslation":"Họ bán trái cây tươi với giá cả phải chăng ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"moderately":{"definition":"Ở một mức độ vừa phải; không nhiều lắm; trầm lặng.","example":"He gave a moderately good speech today.","exampleTranslation":"Hôm nay anh ấy đã có một bài phát biểu khá tốt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"monotonous":{"definition":"Đều đều, đơn điệu; buồn tẻ ((cũng) monotone).","example":"She spoke in a very monotonous voice.","exampleTranslation":"Cô ấy nói bằng một giọng rất đơn điệu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"monster":{"definition":"Người tàn bạo, người quái ác; người gớm guốc.","example":"That man is a monster of pure cruelty.","exampleTranslation":"Gã đó là một con quái vật của sự tàn ác thuần túy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mostly":{"definition":"chủ yếu; phần lớn","example":"The cup was mostly empty.","exampleTranslation":"Chiếc cốc gần như trống rỗng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"mote":{"definition":"Bụi, hạt bụi.","example":"A mote of dust floated in the light.","exampleTranslation":"Một hạt bụi trôi nổi trong ánh sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"motto":{"definition":"Khẩu hiệu; phương châm.","example":"Her motto is simple: work first, rest later.","exampleTranslation":"Phương châm của cô ấy rất đơn giản: làm trước, nghỉ sau.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"mount":{"definition":"Leo, trèo lên.","example":"The hikers began to mount the steep hill.","exampleTranslation":"Những người đi bộ đường dài bắt đầu leo lên ngọn đồi dốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"move":{"definition":"Nước.","example":"That was a very smart move in chess.","exampleTranslation":"Đó là một nước đi rất thông minh trong cờ vua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"muddle":{"definition":"Tình trạng lộn xộn, tình trạng lung tung, tình trạng rối ren ((nghĩa đen) & (nghĩa bóng)).","example":"Everything was in a complete muddle this morning.","exampleTranslation":"Mọi thứ hoàn toàn lộn xộn sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"multiple":{"definition":"Nhiều, nhiều mối, phức tạp.","example":"She had to manage multiple shop locations at once.","exampleTranslation":"Cô ấy phải quản lý nhiều địa điểm cửa hàng cùng một lúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mundane":{"definition":"Buồn chán, tẻ nhạt.","example":"The meeting felt mundane after a long day.","exampleTranslation":"Cuộc họp cảm thấy tẻ nhạt sau một ngày dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mustiness":{"definition":"Mùi mốc.","example":"The old box had a mustiness inside.","exampleTranslation":"Chiếc hộp cũ có mùi mốc bên trong.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"myself":{"definition":"Tự tôi.","example":"I need to wash myself before the party.","exampleTranslation":"Tôi cần phải tắm rửa sạch sẽ trước buổi tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"P","posGroup":"other","family":"general-reading"},"mysterious":{"definition":"Thần bí, huyền bí.","example":"The old house had a mysterious charm.","exampleTranslation":"Ngôi nhà cũ có một nét quyến rũ huyền bí.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"mystery":{"definition":"Điều huyền bí, điều thần bí.","example":"The mystery of the lost city remains unsolved.","exampleTranslation":"Điều huyền bí về thành phố bị mất vẫn chưa được giải đáp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"naked":{"definition":"Trần, trần truồng, khoả thân, loã lồ.","example":"He stood on the stage in naked fear.","exampleTranslation":"Anh ấy đứng trên sân khấu trong sự sợ hãi trần trụi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"name":{"definition":"Tiếng, tiếng tăm, danh tiếng.","example":"She wants to make a name for herself.","exampleTranslation":"Cô ấy muốn tạo dựng danh tiếng cho bản thân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"nasty":{"definition":"Bẩn thỉu; dơ dáy; kinh tởm, làm buồn nôn.","example":"There is a nasty smell in the kitchen.","exampleTranslation":"Có một mùi khó chịu trong nhà bếp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"nearly":{"definition":"Gần, sắp, suýt.","example":"It is nearly time to start our meeting.","exampleTranslation":"Đã gần đến giờ bắt đầu cuộc họp của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"neat":{"definition":"Sạch gọn, ngăn nắp.","example":"She kept her bedroom very neat and organized.","exampleTranslation":"Cô ấy giữ phòng ngủ của mình rất ngăn nắp và sạch gọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"necessarily":{"definition":"nhất thiết; tất yếu","example":"I know we don't have a car, but that's not necessarily a problem.","exampleTranslation":"Tôi biết chúng ta không có xe hơi, nhưng đó không nhất thiết là vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"necessary":{"definition":"Cần, cần thiết, thiết yếu.","example":"Good sleep is necessary for your overall health.","exampleTranslation":"Giấc ngủ ngon là cần thiết cho sức khỏe tổng thể của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"necessitate":{"definition":"Bắt phải, đòi hỏi phải, cần phải có.","example":"The cold weather will necessitate warm clothes.","exampleTranslation":"Thời tiết lạnh sẽ đòi hỏi phải có quần áo ấm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"necessity":{"definition":"Sự cần thiết, điều tất yếu, điều bắt buộc.","example":"We must act quickly in case of necessity.","exampleTranslation":"Chúng ta phải hành động nhanh chóng trong trường hợp cần thiết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"negligible":{"definition":"Không đáng kể.","example":"The difference in price is a negligible amount.","exampleTranslation":"Sự khác biệt về giá là một số tiền không đáng kể.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"neither":{"definition":"Không... mà cũng không.","example":"The food was neither good nor bad today.","exampleTranslation":"Đồ ăn hôm nay không ngon mà cũng không tệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"neutral":{"definition":"Không có tính chất rõ rệt.","example":"She wore a dress of a neutral color.","exampleTranslation":"Cô ấy mặc một chiếc váy màu trung tính.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"nimble":{"definition":"Lanh lẹ, nhanh nhẹn.","example":"The nimble cat jumped over the wall.","exampleTranslation":"Con mèo nhanh nhẹn nhảy qua tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"nineteenth":{"definition":"Thứ mười chín.","example":"She lived in the nineteenth floor apartment.","exampleTranslation":"Cô ấy sống trong căn hộ tầng mười chín.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"nineties":{"definition":"Độ tuổi từ 9 o đến 99.","example":"She spent her nineties walking every morning.","exampleTranslation":"Cô ấy dành những năm ở độ tuổi từ 90 đến 99 để đi bộ mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"nobody":{"definition":"Không ai, không người nào.","example":"I saw nobody at the park this morning.","exampleTranslation":"Tôi không thấy bất cứ ai tại công viên sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"noise":{"definition":"Tiếng; tiếng ồn, tiếng om sòm, tiếng huyên náo.","example":"Do not make a noise in the library.","exampleTranslation":"Đừng làm ra tiếng ồn trong thư viện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"noisy":{"definition":"Ồn ào, om sòm, huyên náo.","example":"The noisy classroom made it hard to study.","exampleTranslation":"Lớp học ồn ào khiến việc học tập trở nên khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"notable":{"definition":"Đáng kể, đáng chú ý.","example":"There was a notable change in his voice.","exampleTranslation":"Có một sự thay đổi đáng kể trong giọng nói của anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"notably":{"definition":"đáng chú ý; đặc biệt","example":"The artist's work was notably praised for its originality.","exampleTranslation":"Tác phẩm của nghệ sĩ này đã được đặc biệt khen ngợi vì sự độc đáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"notch":{"definition":"Hẽm núi, khe núi.","example":"We walked through a narrow notch in the hills.","exampleTranslation":"Chúng tôi đi qua một hẽm núi hẹp trên những ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"noted":{"definition":"Nổi tiếng, có danh tiếng.","example":"The noted musician performed a beautiful solo for the audience.","exampleTranslation":"Nhạc sĩ nổi tiếng đã biểu diễn một tiết mục độc tấu tuyệt đẹp cho khán giả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"notice":{"definition":"Thông tri, yết thị, thông cáo.","example":"A public notice was posted on the city wall.","exampleTranslation":"Một thông tri công cộng đã được dán trên bức tường thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"noticeable":{"definition":"Đáng chú ý, đáng để ý.","example":"A noticeable crack ran across the plate.","exampleTranslation":"Một vết nứt đáng chú ý chạy ngang qua chiếc đĩa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"notification":{"definition":"Sự báo, sự khai báo; sự thông báo.","example":"You will get a notification when it arrives.","exampleTranslation":"Bạn sẽ nhận được một thông báo khi nó đến nơi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"novelty":{"definition":"Tính mới, tính mới lạ, tính lạ thường.","example":"The novelty was useful in class.","exampleTranslation":"Tính mới lạ rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"nowhere":{"definition":"Không nơi nào, không ở đâu.","example":"The missing keys were nowhere to be found.","exampleTranslation":"Những chiếc chìa khóa bị mất không thể tìm thấy ở đâu cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"numerous":{"definition":"Đông, đông đảo, nhiều.","example":"Numerous people gathered in the park for the concert.","exampleTranslation":"Đông đảo mọi người đã tụ tập trong công viên để xem buổi hòa nhạc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"object":{"definition":"Người đáng thương, người lố lăng, vật đáng khinh, vật lố lăng.","example":"He acted like an object in the play.","exampleTranslation":"Anh ấy đóng vai một người đáng thương trong vở kịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"oblique":{"definition":"Xiên, chéo, chếch.","example":"He made an oblique move toward the door.","exampleTranslation":"Anh ấy đã có một nước đi chéo về phía cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"obstacle":{"definition":"Vật chướng ngại, trở lực.","example":"That large rock is an obstacle in our path.","exampleTranslation":"Tảng đá lớn đó là một vật chướng ngại trên con đường của chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"obtain":{"definition":"Đạt được, thu được, giành được, kiếm được, lấy về.","example":"You can obtain more information from our website.","exampleTranslation":"Bạn có thể thu được nhiều thông tin hơn từ trang web của chúng tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"obvious":{"definition":"Rõ ràng, rành mạch, hiển nhiên.","example":"It was an obvious mistake for him to make.","exampleTranslation":"Đó là một lỗi rõ ràng mà anh ấy đã mắc phải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"obviously":{"definition":"rõ ràng; hiển nhiên","example":"China is obviously much bigger than Japan.","exampleTranslation":"Trung Quốc rõ ràng lớn hơn nhiều so với Nhật Bản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"occasion":{"definition":"Dịp, cơ hội.","example":"We should take this occasion to celebrate our success.","exampleTranslation":"Chúng ta nên tận dụng dịp này để ăn mừng thành công của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"occasional":{"definition":"Thỉnh thoảng, từng thời kỳ; phụ động.","example":"She is just an occasional worker here.","exampleTranslation":"Cô ấy chỉ là một nhân viên thỉnh thoảng ở đây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"occasionally":{"definition":"Thỉnh thoảng, thảng hoặc; từng thời kỳ.","example":"I read the note occasionally.","exampleTranslation":"Tôi thỉnh thoảng đọc ghi chú.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"occur":{"definition":"Xuất hiện, tìm thấy.","example":"Several errors occur on every page of this book.","exampleTranslation":"Một vài lỗi xuất hiện trên mỗi trang của cuốn sách này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"occurrence":{"definition":"Sự kiện, sự cố, chuyện xảy ra.","example":"The occurrence was useful in class.","exampleTranslation":"Sự kiện đó rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"oddity":{"definition":"Sự kỳ cục, sự kỳ quặc, sự kỳ dị.","example":"They discussed the oddity today.","exampleTranslation":"Họ đã thảo luận về sự kỳ cục ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"odour":{"definition":"Mùi (nghĩa đen) & (nghĩa bóng).","example":"I noticed a strange odour in the room.","exampleTranslation":"Tôi nhận thấy một mùi lạ trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"offs":{"definition":"Động từ chia ở ngôi thứ ba số ít của off","example":"She offs the heater at night.","exampleTranslation":"Cô ấy tắt máy sưởi vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"offset":{"definition":"Chồi cây, mầm cây.","example":"A new offset grew from the old plant.","exampleTranslation":"Một chồi cây mới mọc ra từ cái cây cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ongoing":{"definition":"Đang diễn ra, đang tiếp diễn, liên tục.","example":"There is an ongoing investigation into the causes of the power outage.","exampleTranslation":"Có một cuộc điều tra đang diễn ra về nguyên nhân của việc mất điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"onset":{"definition":"Lúc bắt đầu.","example":"We must be ready at the first onset.","exampleTranslation":"Chúng ta phải sẵn sàng ngay từ lúc bắt đầu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"onslaught":{"definition":"Sự công kích dữ dội, sự tấn công dữ dội.","example":"The team faced an onslaught of new emails.","exampleTranslation":"Đội đã phải đối mặt với một sự tấn công dữ dội của email mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"onto":{"definition":"Toàn ánh; mọi phần tử trong miền giá trị đều được tương đến từ một phần tử trong miền xác định.","example":"The map is onto the screen now.","exampleTranslation":"Bản đồ đang hiển thị trên màn hình ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"onward":{"definition":"Về phía trước, tiến lên.","example":"We must move onward toward our goal.","exampleTranslation":"Chúng ta phải tiến lên phía trước để hướng tới mục tiêu của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ooze":{"definition":"Nước vỏ sồi (để thuộc da).","example":"The leather soaked in a bowl of ooze.","exampleTranslation":"Miếng da ngâm trong một bát nước vỏ sồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"opposite":{"definition":"Đối nhau, ngược nhau.","example":"They live on the opposite side of the street.","exampleTranslation":"Họ sống ở phía đối diện của con phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"option":{"definition":"Sự chọn lựa, quyền lựa chọn.","example":"You have only one option left to choose.","exampleTranslation":"Bạn chỉ còn lại một lựa chọn để chọn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ordinarily":{"definition":"Theo cách bình thường.","example":"They worked ordinarily all day.","exampleTranslation":"Họ làm việc theo cách bình thường cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"ordinary":{"definition":"Thường, thông thường, bình thường, tầm thường.","example":"It was just an ordinary day at work.","exampleTranslation":"Đó chỉ là một ngày bình thường tại nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"orient":{"definition":"Ngọc trai (loại quý nhất).","example":"She wore a rare orient on her ring.","exampleTranslation":"Cô ấy đeo một viên ngọc trai quý trên chiếc nhẫn của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"original":{"definition":"Gốc, (thuộc) nguồn gốc, (thuộc) căn nguyên, đầu tiên.","example":"The original painting hangs in the main hall.","exampleTranslation":"Bức tranh gốc treo trong đại sảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"originality":{"definition":"Tính chất độc đáo; tính chất sáng tạo.","example":"They discussed the originality today.","exampleTranslation":"Họ đã thảo luận về tính chất độc đáo ngày hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"originally":{"definition":"Với tính chất gốc; về nguồn gốc.","example":"They worked originally all day.","exampleTranslation":"Họ đã làm việc với tính chất gốc cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"otherwise":{"definition":"Khác, cách khác.","example":"He could not have acted otherwise in that situation.","exampleTranslation":"Anh ấy đã không thể hành động theo cách khác trong tình huống đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"ought":{"definition":"Phải.","example":"We ought to respect our elders every day.","exampleTranslation":"Chúng ta phải tôn trọng những người lớn tuổi của mình mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"outcome":{"definition":"Hậu quả, kết quả.","example":"The outcome was better than expected.","exampleTranslation":"Hậu quả tốt hơn mong đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"outdoor":{"definition":"Ngoài trời, ở ngoài.","example":"We enjoyed an outdoor class in the park.","exampleTranslation":"Chúng tôi đã tận hưởng một lớp học ngoài trời trong công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"outer":{"definition":"Ở phía ngoài, ở xa hơn.","example":"They live in the outer part of town.","exampleTranslation":"Họ sống ở phía ngoài của thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"outfit":{"definition":"Đồ trang bị, quần áo giày mũ...; bộ đồ nghề.","example":"He bought a new outfit for the mountain trip.","exampleTranslation":"Anh ấy mua một bộ đồ trang bị mới cho chuyến đi leo núi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"outlandish":{"definition":"Của người nước ngoài.","example":"He wore an outlandish hat to the party.","exampleTranslation":"Anh ấy đeo một chiếc mũ lạ thường đến buổi tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"outright":{"definition":"Hoàn toàn, toàn bộ.","example":"She gave an outright yes to the offer.","exampleTranslation":"Cô ấy đã hoàn toàn đồng ý với lời đề nghị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"outs":{"definition":"Động từ chia ở ngôi thứ ba số ít của out","example":"The manager outs the facts at once.","exampleTranslation":"Người quản lý làm sáng tỏ các sự thật ngay lập tức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"outset":{"definition":"Sự bắt đầu.","example":"At the outset, we had no clear plan.","exampleTranslation":"Ngay từ khi bắt đầu, chúng tôi không có kế hoạch rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"outside":{"definition":"Bề ngoài, bên ngoài.","example":"The kids are playing outside in the sun.","exampleTranslation":"Những đứa trẻ đang chơi bề ngoài dưới ánh mặt trời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"outstanding":{"definition":"Còn tồn tại, chưa giải quyết xong (vấn đề... ); chưa trả (nợ... ).","example":"You must pay your outstanding debts this month.","exampleTranslation":"Bạn phải trả các khoản nợ chưa giải quyết trong tháng này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"outward":{"definition":"Đi xa hơn; đi nhanh hơn (ai).","example":"He ran outward from the group and waved.","exampleTranslation":"Anh ấy chạy đi xa hơn từ nhóm và vẫy tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"overall":{"definition":"Toàn bộ, toàn thể, từ đầu này sang đầu kia.","example":"The overall view of the project is very positive.","exampleTranslation":"Toàn bộ cái nhìn của dự án rất tích cực.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"overdue":{"definition":"Quá chậm.","example":"The train is overdue by twenty minutes now.","exampleTranslation":"Chuyến tàu hiện đã trễ hai mươi phút.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"overlap":{"definition":"Sự gối lên nhau.","example":"There is some overlap between the two lessons.","exampleTranslation":"Có một số phần gối lên nhau giữa hai bài học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"overlook":{"definition":"Không nhận thấy, không chú ý tới.","example":"Please do not overlook any small details in the report.","exampleTranslation":"Xin đừng bỏ sót bất kỳ chi tiết nhỏ nào trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"overly":{"definition":"Quá, thái quá, quá mức.","example":"They worked overly all day.","exampleTranslation":"Họ đã làm việc quá sức cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"overplay":{"definition":"Nhấn mạnh quá mức vào giá trị của, nhấn mạnh quá mức vào tầm quan trọng của.","example":"Do not overplay the danger of this task.","exampleTranslation":"Đừng quá thổi phồng mức độ nguy hiểm của nhiệm vụ này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"overrun":{"definition":"Sự lan tràn, sự tràn ra.","example":"The overrun of weeds was a problem.","exampleTranslation":"Sự lan tràn của cỏ dại là một vấn đề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"overshoot":{"definition":"Bắn quá đích.","example":"The arrow can overshoot the target in strong wind.","exampleTranslation":"Mũi tên có thể bay quá đích trong gió mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"overstate":{"definition":"Nói quá, cường điệu, phóng đại.","example":"You overstate the cost of this project.","exampleTranslation":"Bạn đã nói quá mức về chi phí của dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"overturn":{"definition":"Sự lật đổ, sự đảo lộn[, ouvə'tə:n].","example":"The sudden overturn shocked everyone in the room.","exampleTranslation":"Sự đảo lộn đột ngột đã làm mọi người trong phòng bị sốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"overwhelmingly":{"definition":"Tràn ngập; làm chôn vùi (cái gì).","example":"She spoke overwhelmingly during the meeting.","exampleTranslation":"Cô ấy đã nói một cách choáng ngợp trong suốt cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"pace":{"definition":"Bước chân, bước.","example":"He took one more pace toward the gate.","exampleTranslation":"Anh ấy bước thêm một bước về phía cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pair":{"definition":"Đôi, cặp.","example":"She bought a new pair of leather gloves.","exampleTranslation":"Cô ấy đã mua một đôi găng tay da mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pale":{"definition":"Làm rào bao quanh, quây rào.","example":"They pale the garden to keep animals out.","exampleTranslation":"Họ dựng rào xung quanh khu vườn để ngăn chặn động vật vào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"pans":{"definition":"Động từ chia ở ngôi thứ ba số ít của pan","example":"She pans the room for hidden details.","exampleTranslation":"Cô ấy quét căn phòng để tìm những chi tiết ẩn giấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"pare":{"definition":"Cắt, gọt, đẽo, xén; xén bớt chỗ nham nhở.","example":"You should pare the apple before you eat it.","exampleTranslation":"Bạn nên gọt vỏ quả táo trước khi ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"partial":{"definition":"Bộ phận; cục bộ, một phần, bán phần.","example":"The team achieved a partial success in the test.","exampleTranslation":"Cả đội đã đạt được một thành công một phần trong bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"partially":{"definition":"Không hoàn chỉnh; cục bộ, một phần.","example":"He left partially after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách không hoàn toàn sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"particular":{"definition":"Đặc biệt, đặc thù; cá biệt, riêng biệt.","example":"This particular dress fits you very well today.","exampleTranslation":"Chiếc váy đặc biệt này rất vừa vặn với bạn hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"particularly":{"definition":"Đặc biệt, cá biệt, riêng biệt.","example":"I am particularly fond of spicy Italian food.","exampleTranslation":"Tôi đặc biệt thích các món ăn Ý cay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"partly":{"definition":"Một phần, phần nào.","example":"He moved partly through the crowd.","exampleTranslation":"Anh ấy đã di chuyển một phần qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"patch":{"definition":"Miếng bông che mắt đau.","example":"The nurse used a patch over his eye.","exampleTranslation":"Cô y tá đã dùng một miếng bông che mắt cho anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"patchy":{"definition":"Vá víu; chắp vá ((nghĩa đen) & (nghĩa bóng)).","example":"His knowledge of history is quite patchy and incomplete.","exampleTranslation":"Kiến thức lịch sử của anh ta khá chắp vá và không đầy đủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"peculiar":{"definition":"Riêng, riêng biệt; đặc biệt.","example":"This flower has a peculiar smell.","exampleTranslation":"Loài hoa này có một mùi hương riêng biệt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"pent":{"definition":"Bị nén xuống (tình cảm... ).","example":"His anger felt pent after the long wait.","exampleTranslation":"Sự giận dữ của anh ta bị nén xuống sau thời gian dài chờ đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"perfect":{"definition":"Hoàn hảo, hoàn toàn.","example":"The weather today is absolutely perfect for a picnic.","exampleTranslation":"Thời tiết hôm nay hoàn toàn tuyệt vời cho một buổi dã ngoại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"perfectly":{"definition":"Hoàn toàn, hoàn hảo.","example":"The team finished perfectly and left.","exampleTranslation":"Cả đội đã kết thúc một cách hoàn hảo và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"perhaps":{"definition":"Có lẽ, có thể.","example":"Perhaps we can meet tomorrow at the park.","exampleTranslation":"Có lẽ chúng ta có thể gặp nhau ngày mai tại công viên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"perilously":{"definition":"Hiểm nghèo, hiểm hoạ; nguy hiểm.","example":"They worked perilously all day.","exampleTranslation":"Họ đã làm việc một cách hiểm nghèo suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"perniciously":{"definition":"Độc, nguy hại.","example":"The team finished perniciously and left.","exampleTranslation":"Cả đội đã kết thúc một cách độc hại và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"petite":{"definition":"Xinh xinh, nhỏ nhắn, mảnh dẻ (nói về cô gái, người phụ nữ).","example":"The petite girl stood quietly by the window.","exampleTranslation":"Cô gái nhỏ nhắn đứng lặng lẽ bên cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"petty":{"definition":"Nhỏ mọn, lặt vặt, tầm thường.","example":"Do not worry about such petty troubles today.","exampleTranslation":"Đừng lo lắng về những rắc rối nhỏ mọn đó hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"pick":{"definition":"Phần chọn lọc, phần tinh hoa, phần tốt nhất.","example":"He was the pick of the entire army.","exampleTranslation":"Anh ấy là phần tinh hoa của toàn bộ quân đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"piece":{"definition":"Đơn vị, cái, chiếc, tấm cuộn (vải); thùng (rượu... ).","example":"He bought a large piece of wine today.","exampleTranslation":"Anh ấy đã mua một thùng rượu lớn hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pile":{"definition":"Chồng, đống.","example":"She put a large pile of books on the table.","exampleTranslation":"Cô ấy đặt một chồng sách lớn lên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pincushion":{"definition":"Cái gối nhỏ để giắt ghim.","example":"She stuck the needle into the pincushion.","exampleTranslation":"Cô ấy cắm cây kim vào cái gối nhỏ giắt ghim.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pinpoint":{"definition":"(nghĩa bóng) Vật nhỏ và nhọn.","example":"He noticed a pinpoint of light in the dark.","exampleTranslation":"Anh ấy nhận thấy một vật nhỏ và nhọn của ánh sáng trong bóng tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pitch":{"definition":"Sự ném, sự liệng, sự tung, sự hất; sự lao xuống.","example":"The ball fell in a headlong pitch from the rock.","exampleTranslation":"Quả bóng rơi theo một cú lao đầu xuống từ tảng đá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pits":{"definition":"Động từ chia ở ngôi thứ ba số ít của pit","example":"The knife pits the metal surface.","exampleTranslation":"Con dao làm trầy xước bề mặt kim loại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"plain":{"definition":"Giản dị, thường; đơn sơ.","example":"He prefers to eat plain food every day.","exampleTranslation":"Anh ấy thích ăn những thức ăn đơn sơ mỗi ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"plainly":{"definition":"Rõ ràng.","example":"She spoke plainly during the meeting.","exampleTranslation":"Cô ấy đã nói chuyện một cách rõ ràng trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"plaintively":{"definition":"Than vãn, ai oán; nghe buồn rầu, xót thương.","example":"The team finished plaintively and left.","exampleTranslation":"Cả đội đã kết thúc một cách buồn rầu và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"pleasant":{"definition":"Vui vẻ, dễ thương (người... ).","example":"We had a pleasant day at the beach today.","exampleTranslation":"Chúng tôi đã có một ngày vui vẻ tại bãi biển hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"pleasantly":{"definition":"Vui vẻ, dễ thương.","example":"I read the note pleasantly.","exampleTranslation":"Tôi đã đọc tờ ghi chú một cách vui vẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"please":{"definition":"Thích, muốn.","example":"You can please yourself with any dessert you like.","exampleTranslation":"Bạn có thể tự làm hài lòng mình với bất kỳ món tráng miệng nào bạn thích.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"plied":{"definition":"Quá khứ và phân từ quá khứ của ply","example":"She plied the customer with questions.","exampleTranslation":"Cô ấy đã chất vấn khách hàng bằng nhiều câu hỏi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"pluck":{"definition":"Sự giật, sự kéo, cái giật, cái kéo.","example":"The child gave a quick pluck at his sleeve.","exampleTranslation":"Đứa trẻ đã đưa tay giật nhanh vào tay áo của anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"plummet":{"definition":"Quả dọi.","example":"He used a plummet to check the wall.","exampleTranslation":"Anh ấy dùng quả dọi để kiểm tra bức tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"plus":{"definition":"cộng: (về toán học) sự đọc của dấu +","example":"Plus means addition in math.","exampleTranslation":"Cộng có nghĩa là phép cộng trong toán học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"E","posGroup":"other","family":"general-reading"},"pocket":{"definition":"Bao (75 kg).","example":"They sold a large pocket of hops today.","exampleTranslation":"Họ đã bán một bao hoa bia lớn hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"poke":{"definition":"Vành mũ (đàn bà).","example":"Her hat had a wide poke above the brim.","exampleTranslation":"Mũ của cô ấy có một vành mũ rộng bên trên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"portion":{"definition":"Phần, phần chia.","example":"He kept the portion in a drawer.","exampleTranslation":"Anh ấy giữ phần chia trong một ngăn kéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"posterior":{"definition":"Sau (về thời gian và thứ tự), ở sau, đến sau.","example":"The events posterior to the war were very peaceful.","exampleTranslation":"Các sự kiện xảy ra sau cuộc chiến rất hòa bình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"postpone":{"definition":"Hoãn lại.","example":"We had to postpone the meeting until Monday.","exampleTranslation":"Chúng tôi đã phải hoãn lại cuộc họp đến thứ Hai.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"potter":{"definition":"Lãng phí.","example":"He likes to potter away his time.","exampleTranslation":"Anh ấy thích lãng phí thời gian của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"pour":{"definition":"Thổ lộ, bộc lộ, trút ra.","example":"She began to pour her heart out to him.","exampleTranslation":"Cô ấy bắt đầu thổ lộ lòng mình với anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"powerfully":{"definition":"Hùng mạnh, hùng cường, có sức mạnh lớn (động cơ ).","example":"He left powerfully after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách hùng mạnh sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"practically":{"definition":"Trên thực tế, thực tế ra.","example":"Practically speaking, we have very little time left.","exampleTranslation":"Nói trên thực tế, chúng ta còn rất ít thời gian.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"praise":{"definition":"Khen ngợi, ca ngợi, ca tụng, tán tụng, tán dương.","example":"They will praise her work in public.","exampleTranslation":"Họ sẽ tán dương công việc của cô ấy trước công chúng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"precariously":{"definition":"tạm, tạm thời, nhất thời, không ổn định.","example":"He left precariously after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách tạm thời sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"prefer":{"definition":"thích hơn, ưa hơn","example":"I prefer coffee over tea in the morning.","exampleTranslation":"Tôi thích cà phê hơn trà vào buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"preferable":{"definition":"Đáng thích hơn, đáng ưa hơn.","example":"A short walk is preferable to a long drive.","exampleTranslation":"Đáng ưa thích hơn","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"preference":{"definition":"Sự thích hơn, sự ưa hơn.","example":"She has a preference for tea over coffee.","exampleTranslation":"Cô ấy có xu hướng thích trà hơn cà phê.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"premature":{"definition":"Hấp tấp, vội vã.","example":"We should avoid making a premature decision now.","exampleTranslation":"Chúng ta nên tránh đưa ra quyết định vội vàng lúc này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"prematurely":{"definition":"Sớm (xảy ra trước thời gian mong đợi); đẻ non (trẻ con).","example":"The team finished prematurely and left.","exampleTranslation":"Đội đã hoàn thành quá sớm và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"preparation":{"definition":"Số nhiều) các thứ sửa soạn, các thứ sắm sửa, các thứ chuẩn bị, các thứ dự bị.","example":"The kitchen held all the preparation for dinner.","exampleTranslation":"Nhà bếp chứa tất cả sự chuẩn bị cho bữa tối.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"prepare":{"definition":"Sửa soạn, sắm sửa, chuẩn bị, dự bị.","example":"They need to prepare for an upcoming trip.","exampleTranslation":"Họ cần chuẩn bị cho một chuyến đi sắp tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"presence":{"definition":"Sự có mặt.","example":"She felt nervous in the presence of the king.","exampleTranslation":"Cô ấy cảm thấy lo lắng khi có sự hiện diện của nhà vua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pretty":{"definition":"Xinh, xinh xinh, xinh xắn, xinh đẹp.","example":"She wore a pretty dress to the party.","exampleTranslation":"Cô ấy đã mặc một chiếc váy xinh đẹp đến bữa tiệc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"previous":{"definition":"Trước.","example":"I saw him on the previous day.","exampleTranslation":"Tôi đã gặp anh ấy vào ngày hôm trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"previously":{"definition":"Trước, trước đây.","example":"She answered previously and smiled.","exampleTranslation":"Cô ấy đã trả lời trước đó và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"prime":{"definition":"Đầu tiên.","example":"The prime cause of the fire was a short circuit.","exampleTranslation":"Nguyên nhân chính của vụ hỏa hoạn là do chập điện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"prior":{"definition":"Trưởng tu viện.","example":"The prior lived in a small stone monastery.","exampleTranslation":"Vị tu viện trưởng sống trong một tu viện bằng đá nhỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"priority":{"definition":"sự ưu tiên; điều ưu tiên hàng đầu","example":"Learning the language is a high priority for all people who move to the country.","exampleTranslation":"Học ngôn ngữ là ưu tiên hàng đầu đối với tất cả những người chuyển đến đất nước này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"general-reading"},"proceed":{"definition":"Xuất phát, phát ra từ.","example":"Loud noises were heard to proceed from outside.","exampleTranslation":"Những tiếng ồn lớn được nghe thấy phát ra từ bên ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"prod":{"definition":"Vật nhọn, gậy nhọn đầu, cái thúc.","example":"He used a prod to move the cart.","exampleTranslation":"Anh ấy đã sử dụng một cái dùi để di chuyển chiếc xe đẩy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"profoundly":{"definition":"Sâu sắc","example":"The experience profoundly changed him.","exampleTranslation":"Trải nghiệm đó đã thay đổi anh ấy một cách sâu sắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"prolong":{"definition":"Kéo dài; nối dài; gia hạn.","example":"A long vacation can prolong your relaxation time.","exampleTranslation":"Một kỳ nghỉ dài có thể kéo dài thời gian thư giãn của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"proper":{"definition":"Đúng, thích đáng, thích hợp.","example":"Is this the proper way to hold the glass?","exampleTranslation":"Đây có phải là cách đúng đắn để cầm chiếc ly không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"properly":{"definition":"Đúng, chính xác.","example":"You must speak properly when you meet your boss.","exampleTranslation":"Bạn phải nói chuyện một cách đúng mực khi gặp sếp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"pull":{"definition":"Sự lôi, sự kéo, sự giật; cái kéo, cái giật.","example":"Please pull the rope to open the heavy door.","exampleTranslation":"Vui lòng kéo sợi dây để mở cánh cửa nặng nề.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"pure":{"definition":"Thanh khiết, thuần khiết; trong trắng, trinh bạch.","example":"She kept a pure conscience throughout her life.","exampleTranslation":"Cô ấy đã giữ một lương tâm trong sạch suốt cuộc đời mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"purely":{"definition":"Hoàn toàn, chỉ là.","example":"She answered purely and smiled.","exampleTranslation":"Cô ấy trả lời một cách thuần khiết và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"push":{"definition":"Sự xô, sự đẩy; cú đẩy.","example":"The push of the crowd moved me forward.","exampleTranslation":"Cú đẩy của đám đông đã đẩy tôi về phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"puts":{"definition":"Động từ chia ở ngôi thứ ba số ít của put","example":"She puts the keys on the table.","exampleTranslation":"Cô ấy đặt chìa khóa trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"quarter":{"definition":"Một phần tư.","example":"A quarter of a century passed very quickly.","exampleTranslation":"Một phần tư thế kỷ đã trôi qua rất nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"quest":{"definition":"Sự truy tìm, sự truy lùng.","example":"They went on a quest for the lost treasure.","exampleTranslation":"Họ đã lên đường tìm kiếm kho báu bị mất.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"quick":{"definition":"Tâm can, ruột gan; chỗ nhạy cảm nhất.","example":"The insult stung him to the quick today.","exampleTranslation":"Lời lăng mạ hôm nay đã làm anh ấy đau nhói tận tâm can.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"quickly":{"definition":"nhanh chóng","example":"Please close the door quickly. You'll let the cat out.","exampleTranslation":"Vui lòng đóng cửa nhanh chóng. Bạn sẽ làm con mèo chạy ra ngoài đấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"quiet":{"definition":"yên tĩnh; im lặng","example":"This young person is very quiet now because she is reading a book.","exampleTranslation":"Người trẻ tuổi này hiện đang rất yên lặng vì cô ấy đang đọc sách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"general-reading"},"quietly":{"definition":"Yên lặng, yên tĩnh, êm ả.","example":"I read the note quietly.","exampleTranslation":"Tôi đã đọc tờ giấy một cách lặng lẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"rapid":{"definition":"Nhanh, nhanh chóng, mau lẹ.","example":"There was a rapid decline in his health.","exampleTranslation":"Sức khỏe của anh ấy suy giảm nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"rapidly":{"definition":"Nhanh, nhanh chóng, mau lẹ.","example":"She answered rapidly and smiled.","exampleTranslation":"Cô ấy trả lời một cách nhanh chóng và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"readily":{"definition":"sẵn sàng; dễ dàng","example":"When I needed help carrying my bag of groceries, a young man came over readily to help.","exampleTranslation":"Khi tôi cần giúp đỡ mang túi hàng tạp hóa, một thanh niên đã đến giúp đỡ ngay lập tức.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"ready":{"definition":"Sẵn sàng.","example":"Is dinner ready for us to eat now?","exampleTranslation":"Bữa tối đã sẵn sàng cho chúng ta ăn chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"reassemble":{"definition":"Lắp lại, ráp lại.","example":"He had to reassemble the broken watch carefully.","exampleTranslation":"Anh ấy phải cẩn thận lắp ráp lại chiếc đồng hồ bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"receive":{"definition":"Nhận, lĩnh, thu.","example":"Did you receive the news about the party?","exampleTranslation":"Bạn đã nhận được tin tức về bữa tiệc chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"recency":{"definition":"Tính chất mới xảy ra, tính chất mới gần đây.","example":"The recency of the event surprised everyone.","exampleTranslation":"Tính chất mới xảy ra","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"recommend":{"definition":"Giới thiệu, tiến cử (người, vật... ).","example":"can you recommend me a good English dictionary?","exampleTranslation":"Bạn có thể giới thiệu cho tôi một cuốn từ điển tiếng Anh tốt không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"recommendation":{"definition":"Sự giới thiệu, sự tiến cử.","example":"I wrote a letter of recommendation for him.","exampleTranslation":"Tôi đã viết một lá thư giới thiệu cho anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"reddish":{"definition":"Hơi đỏ, đo đỏ.","example":"The fruit had a reddish skin.","exampleTranslation":"Quả có lớp vỏ màu đỏ nhạt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"regain":{"definition":"Lấy lại, thu đi, gỡ lại, chiếm lại, chuộc lại.","example":"He tried to regain consciousness after the fall.","exampleTranslation":"Anh ấy đã cố gắng lấy lại ý thức sau cú ngã.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"regard":{"definition":"Cái nhìn.","example":"He has a high regard for his teacher.","exampleTranslation":"Anh ấy rất tôn trọng giáo viên của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"regular":{"definition":"Đều đều, không thay đổi; thường lệ.","example":"She takes a regular bus to work every morning.","exampleTranslation":"Cô ấy đi làm bằng xe buýt thường xuyên vào mỗi buổi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"reintroduce":{"definition":"Lại giới thiệu, lại đưa vào.","example":"We reintroduce the topic in next class.","exampleTranslation":"Chúng tôi sẽ giới thiệu lại chủ đề này trong lớp tiếp theo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"reject":{"definition":"Vật bị loại, vật bỏ đi, vật không được chọn.","example":"The shop sold the reject at a discount.","exampleTranslation":"Cửa hàng đã bán hàng bị loại với giá chiết khấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"rejection":{"definition":"Sự loại bỏ, sự loại ra.","example":"The machine caused rejection of the faulty parts.","exampleTranslation":"Máy móc gây ra sự từ chối đối với các bộ phận bị lỗi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"release":{"definition":"Sự thả, sự phóng thích.","example":"The sudden release of prisoners surprised the town.","exampleTranslation":"Việc thả tù nhân bất ngờ đã khiến thị trấn ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"relentless":{"definition":"Không hề yếu đi, không nao núng.","example":"The team showed relentless effort to win the game.","exampleTranslation":"Cả đội đã thể hiện sự nỗ lực không ngừng để giành chiến thắng trong trận đấu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"remarkable":{"definition":"Xuất sắc, phi thường, đặc biệt.","example":"He made a remarkable recovery after the illness.","exampleTranslation":"Anh ấy đã có sự hồi phục đáng kể sau cơn bệnh. [L15]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"remarkably":{"definition":"Đáng chú ý, đáng để ý.","example":"I read the note remarkably.","exampleTranslation":"Tôi đã đọc tờ ghi chú một cách đáng chú ý. [L19]","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"removal":{"definition":"Sự dọn nhà, sự đổi chỗ ở.","example":"Their removal to a new house was easy.","exampleTranslation":"Việc dọn đến nhà mới của họ rất dễ dàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"remove":{"definition":"Món ăn tiếp theo (sau một món khác).","example":"For the second remove, we served fresh fruit.","exampleTranslation":"Với món ăn tiếp theo, chúng tôi đã phục vụ trái cây tươi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"rename":{"definition":"Đổi tên, thay tên (người, đường phố... ).","example":"They rename the street every decade.","exampleTranslation":"Họ đổi tên con phố mỗi thập kỷ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"render":{"definition":"Trả, trả lại, hoàn lại.","example":"We should render thanks to our helpful neighbors.","exampleTranslation":"Chúng ta nên gửi lời cảm ơn đến những người hàng xóm hay giúp đỡ mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"replace":{"definition":"Thay thế.","example":"We can replace the broken chair with a new one.","exampleTranslation":"Chúng ta có thể thay thế chiếc ghế bị gãy bằng một chiếc mới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"replacement":{"definition":"Sự thay thế; vật thay thế, người thay thế.","example":"We need a replacement for the broken chair.","exampleTranslation":"Chúng ta cần một vật thay thế cho chiếc ghế bị hỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"replenish":{"definition":"Lại làm đầy, cung cấp thêm, bổ sung.","example":"Please replenish the water bottles in the fridge.","exampleTranslation":"Vui lòng bổ sung thêm các chai nước trong tủ lạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"replete":{"definition":"Đầy, đầy đủ, tràn đầy; đầy ứ, đẫy.","example":"The table was replete with delicious fruits.","exampleTranslation":"Chiếc bàn đầy ắp những loại trái cây ngon.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"request":{"definition":"Lời thỉnh cầu, lời yêu cầu, lời đề nghị.","example":"I am doing this at your request.","exampleTranslation":"Tôi đang làm việc này theo yêu cầu của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"respective":{"definition":"Riêng từng người, riêng từng cái; tương ứng (với vị trí, thứ tự, địa vị... ).","example":"They returned to their respective houses after work.","exampleTranslation":"Họ quay trở về các ngôi nhà riêng của mình sau giờ làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"respectively":{"definition":"Riêng từng người, riêng từng cái; tương ứng (với vị trí, thứ tự, địa vị).","example":"They won first and second prizes respectively.","exampleTranslation":"Họ lần lượt giành giải nhất và nhì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"retrace":{"definition":"Trở lại (con đường cũ); thoái lui.","example":"I had to retrace my steps in the snow.","exampleTranslation":"Tôi phải đi trở lại những bước chân của mình trong tuyết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"reverse":{"definition":"Đảo, nghịch, ngược lại, trái lại.","example":"The car moved in the reverse direction slowly.","exampleTranslation":"Chiếc xe di chuyển chậm chạp theo hướng ngược lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"rims":{"definition":"Động từ chia ở ngôi thứ ba số ít của rim","example":"The worker rims the glass carefully.","exampleTranslation":"Người công nhân viền quanh chiếc kính một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"ring":{"definition":"Vòng tròn.","example":"They decided to dance in a large ring.","exampleTranslation":"Họ quyết định nhảy múa trong một vòng tròn lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"ripping":{"definition":"Tuyệt đẹp, rực rỡ; xuất sắc, ưu tú.","example":"The new fashion show was a ripping success last night.","exampleTranslation":"Buổi trình diễn thời trang mới là một thành công tuyệt đẹp tối qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"rise":{"definition":"Sự lên, sự đưa lên, sự kéo lên, sự dâng; lên, sự tăng lên.","example":"The birds fly away at the rise of sun.","exampleTranslation":"Những chú chim bay đi khi mặt trời mọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"roam":{"definition":"Đi rong.","example":"The sheep are allowed to roam freely on this land.","exampleTranslation":"Những con cừu được phép đi rong tự do trên mảnh đất này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"roll":{"definition":", (từ lóng) tiền, tập tiền.","example":"He carried a roll of cash in his bag.","exampleTranslation":"Anh ấy mang theo một tập tiền trong túi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"roller":{"definition":"Cuộn băng ((cũng) roller bandage).","example":"He wrapped the cut with a roller bandage.","exampleTranslation":"Anh ấy quấn vết cắt bằng một cuộn băng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"rough":{"definition":"Thô lỗ, sống sượng, lỗ mãng, thô bạo, cộc cằn.","example":"He was very rough with his words today.","exampleTranslation":"Hôm nay anh ấy đã rất thô lỗ với lời nói của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"roughened":{"definition":"Quá khứ và phân từ quá khứ của roughen","example":"The tool roughened the smooth stone.","exampleTranslation":"Công cụ này đã làm cho hòn đá nhẵn trở nên sần sùi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"roughly":{"definition":"Thô lỗ, thô bạo, sống sượng, lỗ mãng, cộc cằn.","example":"Do not answer his rude questions in a roughly manner.","exampleTranslation":"Đừng trả lời những câu hỏi thô lỗ của anh ta một cách thô bạo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"rows":{"definition":"Động từ chia ở ngôi thứ ba số ít của row","example":"She rows every morning for exercise.","exampleTranslation":"Cô ấy chèo thuyền mỗi sáng để tập thể dục.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"rush":{"definition":"Vật vô giá trị.","example":"This old toy is not worth a rush.","exampleTranslation":"Đồ chơi cũ này không đáng một vật vô giá trị.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sackful":{"definition":"Bao tải (đầy).","example":"They carried a sackful of apples to the market.","exampleTranslation":"Họ đã mang một bao tải đầy táo đến chợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sake":{"definition":"Mục đích, lợi ích.","example":"She did it for the sake of her family.","exampleTranslation":"Cô ấy đã làm điều đó vì lợi ích của gia đình mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"scamper":{"definition":"Sự chạy vụt; sự phi ngựa đi chơi.","example":"The children made a quick scamper to the gate.","exampleTranslation":"Những đứa trẻ đã chạy vụt nhanh đến cổng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"scant":{"definition":"Ít, hiếm, không đủ.","example":"The food supply was scant during the winter.","exampleTranslation":"Nguồn cung cấp thực phẩm khan hiếm trong mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"scarcely":{"definition":"Vừa vặn, vừa mới.","example":"I had scarcely finished my dinner when the phone rang.","exampleTranslation":"Tôi vừa mới ăn xong bữa tối thì điện thoại reo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"scatter":{"definition":"Những cái được tung rắc, những cái được rải ra.","example":"We picked up the scatter after the picnic.","exampleTranslation":"Chúng tôi đã nhặt những thứ được rải ra sau buổi dã ngoại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"scoop":{"definition":"Cái xẻng (xúc lúa, than, tiên... ).","example":"The scoop was mentioned in the report.","exampleTranslation":"Cái xẻng đã được đề cập trong báo cáo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"scrape":{"definition":"Nạo, cạo, gọt, gạt, vét; làm cho nhăn, đánh bóng.","example":"He had to scrape the mud off his shoes.","exampleTranslation":"Anh ấy phải nạo lớp bùn khỏi giày của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"scratch":{"definition":"Hỗn tạp, linh tinh, không chọn lựa.","example":"We need to find a scratch group now.","exampleTranslation":"Chúng tôi cần tìm một nhóm hỗn tạp ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"scribble":{"definition":"Tác phẩm văm học viết xoàng; bài báo xoàng.","example":"The magazine piece was just a quick scribble.","exampleTranslation":"Bài báo trên tạp chí chỉ là một bản viết xoàng nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"scruffy":{"definition":"Có vảy mốc (trên da).","example":"The dog had a scruffy spot on its leg.","exampleTranslation":"Con chó có một vết mốc trên chân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"section":{"definition":"Sự cắt; chỗ cắt.","example":"The cut left a clean section in the cloth.","exampleTranslation":"Vết cắt đã để lại một đoạn sạch trên vải.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"seeing":{"definition":"hiện tại phân từ của see","example":"She is seeing the doctor this afternoon.","exampleTranslation":"Cô ấy đang gặp bác sĩ vào chiều nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"seemingly":{"definition":"Có vẻ, ra vẻ, tưởng chừng như.","example":"She answered seemingly and smiled.","exampleTranslation":"Cô ấy trả lời một cách có vẻ và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"sees":{"definition":"Động từ chia ở ngôi thứ ba số ít của see","example":"She sees the stars clearly tonight.","exampleTranslation":"Cô ấy thấy những vì sao rõ ràng vào tối nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"seldom":{"definition":"Ít khi, hiếm khi.","example":"I seldom see my cousins during the winter.","exampleTranslation":"Tôi hiếm khi thấy anh chị em họ của mình vào mùa đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"selfsame":{"definition":"Cũng giống hệt như vật, y như vậy.","example":"That selfsame book was on the table yesterday.","exampleTranslation":"Chính cuốn sách y như vậy đã ở trên bàn hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"separate":{"definition":"Quần lẻ, áo lẻ (của đàn bà).","example":"She wore a simple separate with the jacket.","exampleTranslation":"Cô ấy đã mặc một chiếc quần lẻ đơn giản với chiếc áo khoác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"separately":{"definition":"Không cùng nhau; thành người riêng, vật tách riêng ra.","example":"She spoke separately during the meeting.","exampleTranslation":"Cô ấy đã phát biểu tách riêng trong cuộc họp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"setting":{"definition":"Phương cách hoặc các nơi mà các vật được đặt; thiết định.","example":"The setting was important at work.","exampleTranslation":"Phương cách được đặt đã quan trọng trong công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"settle":{"definition":"Ghế tủ (ghế dài có lưng dựa và phần dưới đóng thành tủ).","example":"She sat on the settle by the fire.","exampleTranslation":"Cô ấy ngồi trên chiếc ghế tủ cạnh đống lửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"seventeenth":{"definition":"Thứ mười bảy.","example":"Her seventeenth birthday was quiet and happy.","exampleTranslation":"Sinh nhật thứ mười bảy của cô ấy thật yên tĩnh và hạnh phúc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"seventy":{"definition":"Bảy mươi.","example":"My grandfather is almost seventy years old today.","exampleTranslation":"Ông của tôi gần bảy mươi tuổi rồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"shade":{"definition":"Bóng ma, bóng đen.","example":"Too long have I been haunted by that shade.","exampleTranslation":"Quá lâu rồi tôi bị ám ảnh bởi cái bóng ma đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"shadow":{"definition":"Bóng, bóng tối, bóng râm, bóng mát.","example":"We sat in the shadow of a large tree.","exampleTranslation":"Chúng tôi ngồi dưới bóng râm của một cái cây lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"shadowy":{"definition":"Tối, có bóng tối; có bóng râm.","example":"The forest looked shadowy at dusk.","exampleTranslation":"Khu rừng trông thật tối tăm vào lúc chạng vạng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"shaggy":{"definition":"Có nhiều bụi rậm mọc ngổn ngang.","example":"We walked through a shaggy field of grass.","exampleTranslation":"Chúng tôi đi bộ qua một cánh đồng cỏ mọc ngổn ngang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"shake":{"definition":"Sự rung, sự lắc, sự giũ.","example":"He gave a quick shake of his head.","exampleTranslation":"Anh ấy lắc đầu nhanh một cái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sharp":{"definition":"Sắc, nhọn, bén.","example":"Be careful because that knife is very sharp.","exampleTranslation":"Hãy cẩn thận vì con dao đó rất sắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"sharpen":{"definition":"Mài, vót cho nhọn.","example":"Please sharpen your pencil before starting the test.","exampleTranslation":"Vui lòng gọt nhọn bút chì của bạn trước khi bắt đầu bài kiểm tra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"shelve":{"definition":"Xếp (sách) vào ngăn.","example":"Please shelve the books after class.","exampleTranslation":"Vui lòng xếp sách vào ngăn sau giờ học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"shield":{"definition":"Người che chở, vật che chở.","example":"Her brother was a shield in hard times.","exampleTranslation":"Chị gái cô ấy là vật che chở trong những lúc khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"shorten":{"definition":"Thu ngắn lại, thu hẹp vào.","example":"We shorten the rope before storing it.","exampleTranslation":"Chúng tôi thu ngắn sợi dây trước khi cất nó đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"shortly":{"definition":"Không lâu nữa, chẳng mấy chốc.","example":"They worked shortly all day.","exampleTranslation":"Họ làm việc không lâu suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"shrink":{"definition":"Co lại, rút lại, ngắn lại; co vào, rút vào.","example":"She did shrink into herself when she felt very embarrassed.","exampleTranslation":"Cô ấy thực sự co mình lại khi cảm thấy rất xấu hổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"shut":{"definition":"Đóng, khép, đậy, nút, nhắm, gập, ngậm.","example":"Please shut the door before you leave the room.","exampleTranslation":"Vui lòng đóng cửa trước khi bạn rời khỏi phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"side":{"definition":"Mặt, bên.","example":"The right side of the cloth is very soft.","exampleTranslation":"Mặt phải của tấm vải rất mềm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"silence":{"definition":"Sự im hơi lặng tiếng.","example":"They spoke again after five years of silence.","exampleTranslation":"Họ nói chuyện trở lại sau năm năm im hơi lặng tiếng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"silent":{"definition":"Không nói, ít nói, làm thinh.","example":"The official report is silent on that specific point.","exampleTranslation":"Báo cáo chính thức không nói gì về điểm cụ thể đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"silently":{"definition":"Yên lặng, âm thầm.","example":"He moved silently through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách yên lặng qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"similar":{"definition":"Vật giống, vật tương tự.","example":"This sample is a similar to the one before it.","exampleTranslation":"Mẫu này là một vật tương tự với cái trước nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"similarity":{"definition":"Sự giống nhau, sự tương tự.","example":"The similarity was useful in class.","exampleTranslation":"Sự giống nhau đó rất hữu ích trong lớp học.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"simplicity":{"definition":"Tính đơn giản.","example":"He kept the simplicity in a drawer.","exampleTranslation":"Anh ấy giữ vật thể đơn giản đó trong một ngăn kéo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"simplify":{"definition":"Làm đơn giản, đơn giản hoá.","example":"We can simplify the result quickly.","exampleTranslation":"Chúng ta có thể làm đơn giản hóa kết quả nhanh chóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"simply":{"definition":"Chỉ là; thường là.","example":"They worked simply all day.","exampleTranslation":"Họ thường là làm việc suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"simultaneously":{"definition":"Đồng thời, xảy ra cùng một lúc, làm cùng một lúc.","example":"I read the note simultaneously.","exampleTranslation":"Tôi đọc ghi chú đó một cách đồng thời.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"sits":{"definition":"Động từ chia ở ngôi thứ ba số ít của sit","example":"He sits near the front door.","exampleTranslation":"Anh ấy ngồi gần cửa trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"sitting":{"definition":"Sự ngồi; sự đặt ngồi.","example":"A long sitting can make your legs stiff.","exampleTranslation":"Việc ngồi lâu có thể khiến chân bạn bị cứng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sixteen":{"definition":"Số mười sáu.","example":"There are sixteen students in my class.","exampleTranslation":"Có mười sáu học sinh trong lớp tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"M","posGroup":"other","family":"general-reading"},"sixteenth":{"definition":"Người thứ mười sáu; vật thứ mười sáu; người mười sáu.","example":"Today is January the sixteenth on the calendar.","exampleTranslation":"Hôm nay là ngày mười sáu trên lịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sizzle":{"definition":"Xèo xèo.","example":"The meat began to sizzle in the pan.","exampleTranslation":"Miếng thịt bắt đầu kêu xèo xèo trong chảo.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"skirt":{"definition":"Khụng (từ lóng) đàn bà, con gái, thị mẹt, cái hĩm.","example":"He is such a total skirt in life.","exampleTranslation":"Anh ta đúng là một kẻ lăng nhăng trong cuộc sống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"slide":{"definition":"Khe trượt; bộ phận trượt (trong máy).","example":"The machine has a slide that moves smoothly.","exampleTranslation":"Cỗ máy có một bộ phận trượt di chuyển nhẹ nhàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"slight":{"definition":"Mỏng mảnh, thon, gầy, mảnh khảnh, yếu ớt.","example":"The building has a slight framework of steel.","exampleTranslation":"Tòa nhà có bộ khung thép mỏng mảnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"slightly":{"definition":"Mỏng mảnh, yếu ớt.","example":"The boy has a slightly built and athletic body.","exampleTranslation":"Cậu bé có một thân hình gầy và khỏe mạnh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"slow":{"definition":"Chậm, chậm chạp.","example":"Please drive at a slow pace on this road.","exampleTranslation":"Vui lòng lái xe với tốc độ chậm trên con đường này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"slowly":{"definition":"chậm chạp; từ từ","example":"She was very tired, and walked slowly up the stairs to bed.","exampleTranslation":"Cô ấy đã rất mệt mỏi và từ từ bước lên cầu thang để đi ngủ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"smooth":{"definition":"Nhẫn, trơn, mượt; bằng phẳng, lặng.","example":"The surface of the lake was very smooth.","exampleTranslation":"Mặt hồ rất phẳng lặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"smoothly":{"definition":"Một cách êm ả; một cách trôi chảy.","example":"The team finished smoothly and left.","exampleTranslation":"Đội đã hoàn thành một cách êm ả và rời đi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"snap":{"definition":"Sự cắn (chó), sự táp, sự đớp.","example":"The dog gave a quick snap at the food.","exampleTranslation":"Con chó táp nhanh vào đồ ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"snuff":{"definition":"Hoa đèn.","example":"The lamp snuff burned low.","exampleTranslation":"Hoa đèn cháy thấp xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"soak":{"definition":", (từ lóng) tình trạng bị đem cầm cố.","example":"He is currently in soak for a debt.","exampleTranslation":"Anh ấy hiện đang trong tình trạng bị đem cầm cố vì một khoản nợ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"soar":{"definition":"Tầm bay vút lên.","example":"The eagle's soar was graceful and high.","exampleTranslation":"Tầm bay vút lên của con đại bàng thật duyên dáng và cao.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"soft":{"definition":"Nhẵn, mịn, mượt.","example":"She has very soft skin after the bath.","exampleTranslation":"Cô ấy có làn da rất mịn sau khi tắm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"soften":{"definition":"Làm cho dịu đi.","example":"These curtains soften the light in the room.","exampleTranslation":"Những tấm rèm này làm dịu ánh sáng trong phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"solely":{"definition":"Duy nhất, độc nhất.","example":"He moved solely through the crowd.","exampleTranslation":"Anh ấy đi lại một mình xuyên qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"somebody":{"definition":"Một người nào đó, có người ((cũng) someone).","example":"Somebody left their umbrella in the hallway.","exampleTranslation":"Có người nào đó đã để quên chiếc ô của họ ở hành lang.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"P","posGroup":"other","family":"general-reading"},"somehow":{"definition":"Bằng cách này cách khác.","example":"We must find a way to finish it somehow.","exampleTranslation":"Chúng ta phải tìm cách hoàn thành nó bằng cách này cách khác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"sometime":{"definition":"Trước kia, đã có một thời kỳ.","example":"He was sometime a famous local leader.","exampleTranslation":"Ông ấy trước kia là một nhà lãnh đạo địa phương nổi tiếng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"somewhat":{"definition":"Hơi, gọi là, một chút.","example":"The final exam was somewhat difficult for everyone.","exampleTranslation":"Bài thi cuối kỳ hơi khó đối với mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"somewhere":{"definition":"Ở một nơi nào đó.","example":"They live somewhere near the big blue lake.","exampleTranslation":"Họ sống ở một nơi nào đó gần hồ nước lớn màu xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"soon":{"definition":"Chẳng bao lâu nữa, chẳng mấy chốc, một ngày gần đây; ngay.","example":"We will find out the truth very soon.","exampleTranslation":"Chúng tôi sẽ tìm ra sự thật chẳng bao lâu nữa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"span":{"definition":"Gang tay.","example":"The tool fits in the span of my hand.","exampleTranslation":"Công cụ này vừa vặn trong gang tay của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spare":{"definition":"Để thay thế (đồ phụ tùng).","example":"I kept a spare battery in my bag.","exampleTranslation":"Tôi giữ một pin để thay thế trong túi của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"spark":{"definition":"Tia loé, ánh loé, chấm sáng loé (ở đá quý).","example":"The ring caught the light with a bright spark.","exampleTranslation":"Chiếc nhẫn bắt lấy ánh sáng với một tia loé sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sparse":{"definition":"Thưa thớt, rải rác, lơ thơ.","example":"The grass was thin and sparse across the field.","exampleTranslation":"Cỏ thưa thớt và lơ thơ trên cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"special":{"definition":"Chuyến xe lửa đặc biệt.","example":"We took a special to the city center.","exampleTranslation":"Chúng tôi đã đi chuyến xe lửa đặc biệt đến trung tâm thành phố.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"specially":{"definition":"Đặc biệt, riêng biệt.","example":"He moved specially through the crowd.","exampleTranslation":"Anh ấy di chuyển một cách đặc biệt qua đám đông.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"speck":{"definition":", (Nam phi) thịt mỡ.","example":"A speck of dust landed on my desk.","exampleTranslation":"Một đốm bụi rơi trên bàn làm việc của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spectre":{"definition":"Điều sợ hãi ám ảnh, điều lo ngại ám ảnh.","example":"Fear of failure became a spectre for him.","exampleTranslation":"Nỗi sợ thất bại trở thành một điều ám ảnh đối với anh ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sped":{"definition":"Sự mau lẹ; tốc độ, tốc lực.","example":"The train moved with great sped through the town.","exampleTranslation":"Con tàu di chuyển với sự mau lẹ lớn xuyên qua thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"speed":{"definition":"Sự mau lẹ; tốc độ, tốc lực.","example":"The car traveled at full speed down the highway.","exampleTranslation":"Chiếc xe đi với tốc độ tối đa xuống đường cao tốc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spill":{"definition":"Làm tràn, làm đổ, đánh đổ (nước... ).","example":"Don't spill the milk on the table.","exampleTranslation":"Đừng làm đổ sữa trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"splash":{"definition":"Tiếng (nước) bắn, tiếng (sóng) vỗ.","example":"We heard the splash of waves at night.","exampleTranslation":"Chúng tôi nghe tiếng sóng vỗ vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"splendidly":{"definition":"Hay; cừ; tuyệt diệu hiếm có.","example":"She performed the task splendidly this morning.","exampleTranslation":"Cô ấy thực hiện nhiệm vụ một cách tuyệt diệu sáng nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"split":{"definition":"Chia ra từng phần.","example":"We should split the work between the two teams.","exampleTranslation":"Chúng ta nên chia ra công việc giữa hai đội.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"splutter":{"definition":"Sự thổi phì phì, sự thổi phù phù.","example":"The kettle gave a loud splutter.","exampleTranslation":"Cái ấm đun nước phát ra tiếng thổi phì phì lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spoil":{"definition":"Lợi lộc, quyền lợi (sau khi chiến thắng).","example":"The new manager wanted the spoil of success.","exampleTranslation":"Người quản lý mới muốn có lợi lộc của sự thành công.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spook":{"definition":"Ma quỷ.","example":"The child thought a spook lived upstairs.","exampleTranslation":"Đứa trẻ nghĩ rằng có một con ma quỷ sống ở tầng trên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spot":{"definition":"Dấu, đốm, vết.","example":"There was a dark spot on the wall.","exampleTranslation":"Có một vết tối trên tường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sprang":{"definition":"Sự nhảy; cái nhảy.","example":"Her sprang over the puddle made us laugh.","exampleTranslation":"Cái nhảy của cô ấy qua vũng nước làm chúng tôi cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spray":{"definition":"Cành nhỏ (có hoa).","example":"A spray of peach-tree flowers bloomed in the garden.","exampleTranslation":"Một cành hoa đào nở rộ trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spread":{"definition":"Sự trải ra, sự căng ra, sự giăng ra.","example":"The cloth had a wide spread across the table.","exampleTranslation":"Tấm vải trải rộng trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spring":{"definition":"Sự nhảy; cái nhảy.","example":"The athlete took a long spring over the hurdle.","exampleTranslation":"Vận động viên thực hiện một cái nhảy dài qua rào cản.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spurn":{"definition":"Sự đá đi, sự hất đi.","example":"His spurn showed how angry he felt.","exampleTranslation":"Sự hất đi của anh ấy cho thấy anh ấy cảm thấy giận dữ thế nào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spur":{"definition":"Đinh thúc ngựa.","example":"The rider adjusted his spur before the ride.","exampleTranslation":"Người lái đã điều chỉnh chiếc đinh thúc ngựa của mình trước khi lên ngựa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"spurt":{"definition":"Sự cố gắng nước rút, gắng sức, gắng công.","example":"The runner finished with a strong spurt.","exampleTranslation":"Người chạy bộ kết thúc với một sự gắng sức nước rút mạnh mẽ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"squeeze":{"definition":"Sự ép, sự vắt, sự siết, sự véo.","example":"She gave her friend a firm squeeze of the hand.","exampleTranslation":"Cô ấy trao cho bạn mình một cái siết tay chắc nịch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stack":{"definition":"Cây rơm, đụn rơm.","example":"A stack of hay waited in the field.","exampleTranslation":"Một cây rơm đợi sẵn trên cánh đồng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stagger":{"definition":"Sự lảo đảo; bước đi loạng choạng.","example":"He had a stagger after standing up too fast.","exampleTranslation":"Ông ấy có một bước đi loạng choạng sau khi đứng dậy quá nhanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stag":{"definition":"Hươu đực, nai đực.","example":"A stag crossed the open field at dawn.","exampleTranslation":"Một con hươu đực băng qua cánh đồng trống lúc bình minh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stale":{"definition":"Cũ, để đã lâu; ôi, chớm thối, chớm hỏng (thịt, trứng... ).","example":"Do not eat that stale bread from yesterday.","exampleTranslation":"Đừng ăn chiếc bánh mì cũ từ hôm qua.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"stall":{"definition":"ghế ngồi ở chỗ hát kinh (trong nhà thờ)","example":"He sat in the wooden stall during the service.","exampleTranslation":"Anh ấy ngồi ở ghế trong nhà thờ trong buổi lễ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stamp":{"definition":"Nhãn hiệu, dấu bảo đảm.","example":"The brand used a stamp as its mark of quality.","exampleTranslation":"Thương hiệu sử dụng một nhãn hiệu như dấu bảo đảm chất lượng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"staple":{"definition":"Đinh kẹp, má kẹp (hình chữ U); dây thép rập sách.","example":"He used a staple to fix the papers.","exampleTranslation":"Anh ấy dùng đinh kẹp để cố định các tờ giấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stark":{"definition":"Cứng đờ.","example":"The body lay stark in death on the grass.","exampleTranslation":"Cơ thể nằm cứng đờ sau khi chết trên cỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"startling":{"definition":"Làm giật mình, làm hoảng hốt, làm sửng sốt.","example":"She gave a startling look when she saw him.","exampleTranslation":"Cô ấy có một cái nhìn làm sửng sốt khi nhìn thấy anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"stash":{"definition":", (từ lóng) cất giấu, giấu giếm (tiền nong... ).","example":"I stash my spare cash in a jar.","exampleTranslation":"Tôi cất giấu tiền mặt dự phòng của mình trong một cái lọ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"steadily":{"definition":"Vững, vững chắc, vững vàng.","example":"They worked steadily all day.","exampleTranslation":"Họ làm việc vững vàng suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"steady":{"definition":"Vững, vững chắc, vững vàng.","example":"The mountain was steady as a rock in the storm.","exampleTranslation":"Ngọn núi vững vàng như một tảng đá trong cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"stench":{"definition":"Mùi hôi thối.","example":"A terrible stench came from the bin.","exampleTranslation":"Một mùi hôi thối kinh khủng bốc ra từ thùng rác.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"step":{"definition":"Bước, bước đi; bước khiêu vũ.","example":"Please take one step forward into the room.","exampleTranslation":"Vui lòng thực hiện một bước đi về phía trước vào phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stick":{"definition":"Cái gậy.","example":"He walked with a stick after the long hike.","exampleTranslation":"Ông ấy đi lại với một cái gậy sau chuyến đi bộ dài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stickiness":{"definition":"Tính chất dính; sự dính; tính bầy nhầy, tính nhớp nháp.","example":"The syrup's stickiness made the spoon hard to clean.","exampleTranslation":"Tính bầy nhầy của xi-rô làm cái thìa khó làm sạch.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stiff":{"definition":"Cứng, cứng đơ, ngay đơ.","example":"He wore a shirt with a stiff collar.","exampleTranslation":"Anh ấy mặc một chiếc áo sơ mi với cổ áo cứng đơ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"stiffness":{"definition":"Sự cứng đờ, sự cứng nhắc.","example":"His back stiffness made walking hard.","exampleTranslation":"Sự cứng nhắc ở lưng làm việc đi lại khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stir":{"definition":"Nhà tù, trại giam.","example":"He spent a week in stir after the arrest.","exampleTranslation":"Anh ấy đã dành một tuần trong nhà tù sau khi bị bắt.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stand":{"definition":"Sự dừng lại, sự đứng lại.","example":"The construction work came to a sudden stand.","exampleTranslation":"Công việc xây dựng đi đến một sự dừng lại đột ngột.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stout":{"definition":"Chắc, bền.","example":"This box is stout enough for heavy books.","exampleTranslation":"Chiếc hộp này đủ bền cho những quyển sách nặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"straight":{"definition":"Thẳng.","example":"Please draw a perfectly straight line on paper.","exampleTranslation":"Vui lòng vẽ một đường thẳng tắp trên giấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"strange":{"definition":"Lạ, xa lạ, không quen biết.","example":"I saw a strange bird in the garden.","exampleTranslation":"Tôi thấy một con chim lạ trong vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"strangely":{"definition":"Kỳ lạ, kỳ quặc.","example":"She answered strangely and smiled.","exampleTranslation":"Cô ấy trả lời một cách kỳ lạ và mỉm cười.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"strap":{"definition":"Trận đòn bằng dây da.","example":"He got a strap for breaking the rule.","exampleTranslation":"Anh ấy bị trận đòn bằng dây da vì vi phạm quy tắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stretch":{"definition":"Nghĩa rộng, nghĩa suy ra.","example":"That is true by a stretch of language.","exampleTranslation":"Đó là sự thật theo nghĩa rộng của ngôn ngữ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stride":{"definition":"Bước dài.","example":"He took a long stride across the room.","exampleTranslation":"Anh ấy thực hiện một bước dài khắp phòng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"string":{"definition":"Chuỗi, xâu, đoàn.","example":"She wore a beautiful string of pearls today.","exampleTranslation":"Cô ấy đeo một chuỗi ngọc trai đẹp hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"strip":{"definition":"Cởi quần áo.","example":"You must strip off your wet clothes now.","exampleTranslation":"Bạn phải cởi bỏ quần áo ướt của mình ngay bây giờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"stuff":{"definition":"Chất, chất liệu; thứ, món.","example":"She is the right stuff for this difficult job.","exampleTranslation":"Cô ấy là món chất liệu phù hợp cho công việc khó khăn này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"stump":{"definition":"Mẩu (bút chì, thuốc lá).","example":"Only a stump of the pencil was left.","exampleTranslation":"Chỉ còn lại một mẩu của bút chì.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"substantial":{"definition":"Có thực chất, thực tế.","example":"We reached a substantial agreement on the price.","exampleTranslation":"Chúng tôi đã đạt được một thỏa thuận thực tế về giá cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"substitute":{"definition":"Người thay thế, vật thay thế.","example":"She found a substitute for the missing part.","exampleTranslation":"Cô ấy tìm thấy một vật thay thế cho phần bị thiếu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"substitution":{"definition":"Sự thế, sự thay thế.","example":"We made a substitution in the final minute.","exampleTranslation":"Chúng tôi đã thực hiện một sự thay thế vào phút cuối cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sudden":{"definition":"Thình lình, đột ngột.","example":"A sudden change in weather surprised all the hikers.","exampleTranslation":"Một sự thay đổi thình lình về thời tiết đã khiến tất cả những người đi bộ đường dài ngạc nhiên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"sufficient":{"definition":"Số lượng đủ.","example":"Have you had sufficient time to finish the task?","exampleTranslation":"Bạn đã có đủ thời gian để hoàn thành nhiệm vụ chưa?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sufficiently":{"definition":"Đủ, thích đáng.","example":"I read the note sufficiently.","exampleTranslation":"Tôi đã đọc ghi chú một cách đủ đầy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"suitable":{"definition":"Hợp, phù hợp, thích hợp.","example":"This seat is suitable for a child.","exampleTranslation":"Ghế này phù hợp cho một đứa trẻ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"super":{"definition":"Thượng hảo hạng.","example":"This is super bread from a local bakery.","exampleTranslation":"Đây là loại bánh mì thượng hảo hạng từ một tiệm bánh địa phương.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"surely":{"definition":"Chắc chắn.","example":"He knows full surely that he will win.","exampleTranslation":"Anh ấy biết chắc chắn rằng anh ấy sẽ thắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"surpass":{"definition":"Hơn, vượt, trội hơn.","example":"Her new work can surpass the old one.","exampleTranslation":"Công việc mới của cô ấy có thể vượt hơn công việc cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"surround":{"definition":"Tấm quanh thảm (phủ khoảng sàn nhà giữa thảm và tường).","example":"The rug surround was worn and faded.","exampleTranslation":"Tấm quanh thảm bị mòn và phai màu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"suspension":{"definition":"Sự treo.","example":"The bridge hung in suspension after the storm.","exampleTranslation":"Chiếc cầu treo lơ lửng trong tình trạng bị treo sau cơn bão.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sway":{"definition":"Sự đu đưa, sự lắc lư.","example":"The sway of the tree was calming to watch.","exampleTranslation":"Sự lắc lư của cái cây rất êm dịu khi ngắm nhìn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"sweep":{"definition":"Sự quét.","example":"She gave the room a thorough sweep today.","exampleTranslation":"Hôm nay cô ấy đã quét căn phòng kỹ lưỡng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"swell":{"definition":"Đặc sắc, cử, trội.","example":"He is a swell pianist who plays every night.","exampleTranslation":"Anh ấy là một nghệ sĩ piano đặc sắc chơi nhạc mỗi đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"table":{"definition":"cái bàn; bảng biểu","example":"He sat at the table to eat.","exampleTranslation":"Anh ấy ngồi tại cái bàn để ăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"noun","posGroup":"noun","family":"general-reading"},"tall":{"definition":"Phóng đại, không thật, khó tin, khoác lác, ngoa.","example":"Nobody believes his tall story about the gold.","exampleTranslation":"Không ai tin câu chuyện phóng đại của anh ta về vàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"tangible":{"definition":"Có thể sờ mó được, hữu hình.","example":"We need tangible evidence before we can make a decision.","exampleTranslation":"Chúng ta cần bằng chứng có thể sờ mó được trước khi có thể đưa ra quyết định.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"tangle":{"definition":"Mớ rối, mớ lộn xộn.","example":"The ball of wool became a messy tangle.","exampleTranslation":"Cuộn len trở thành một mớ rối hỗn độn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"taper":{"definition":"Cây nến nhỏ.","example":"A taper burned beside the window.","exampleTranslation":"Một cây nến nhỏ đã cháy cạnh cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"tapped":{"definition":"Quá khứ và phân từ quá khứ của tap","example":"She tapped the table twice.","exampleTranslation":"Cô ấy đã gõ cái bàn hai lần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"tapping":{"definition":"Dạng phân từ hiện tại và danh động từ (gerund) của tap.","example":"He is tapping the window gently.","exampleTranslation":"Anh ấy đang gõ nhẹ vào cửa sổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"taps":{"definition":"Động từ chia ở ngôi thứ ba số ít của tap","example":"He taps his foot when nervous.","exampleTranslation":"Anh ấy gõ chân khi đang lo lắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"tear":{"definition":"Giọt (nhựa... ).","example":"A tear of sap fell from the tree.","exampleTranslation":"Một giọt nhựa rơi từ cây xuống.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"tend":{"definition":"Trông nom, săn sóc, chăm sóc, chăm nom, giữ gìn.","example":"She will tend to the garden this weekend.","exampleTranslation":"Cô ấy sẽ trông nom khu vườn cuối tuần này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"terrible":{"definition":"Dễ sợ, ghê gớm, khủng khiếp.","example":"It was a terrible death for the poor man.","exampleTranslation":"Đó là một cái chết dễ sợ đối với người đàn ông tội nghiệp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"thank":{"definition":"Cám ơn, biết ơn.","example":"Please thank him for his help today.","exampleTranslation":"Vui lòng cám ơn anh ấy vì sự giúp đỡ hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"thereby":{"definition":"Có dính dáng tới cái đó, có liên quan tới cái đó.","example":"He won the prize, thereby hangs a tale.","exampleTranslation":"Anh ấy đã giành giải thưởng, có dính dáng tới chuyện đó trong một câu chuyện.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"therefore":{"definition":"Bởi vậy, cho nên, vì thế, vậy thì, thành thử, thành ra.","example":"It was late, therefore we went home.","exampleTranslation":"Trời đã tối, vì thế chúng tôi đã về nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"therein":{"definition":"Tại đó, ở đấy, trong đó.","example":"The key is locked therein.","exampleTranslation":"Chìa khóa được khóa tại đó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"thereof":{"definition":"Của cải đó, của nó, của việc ấy.","example":"I paid the debt and all thereof.","exampleTranslation":"Tôi đã trả khoản nợ đó và tất cả của việc ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"thick":{"definition":"To, mập.","example":"He has a very thick neck from wrestling.","exampleTranslation":"Anh ấy có một cái cổ rất to từ việc đấu vật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"thickness":{"definition":"Tính dày đặc, tính rậm rạp.","example":"The thickness of the forest blocked the path.","exampleTranslation":"Tính dày đặc của khu rừng đã chặn con đường.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"thin":{"definition":"Mỏng, mảnh.","example":"She wrote on a thin sheet of paper.","exampleTranslation":"Cô ấy viết trên một tờ giấy mỏng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"thirteen":{"definition":"Mười ba.","example":"Many people believe in the thirteen superstition.","exampleTranslation":"Nhiều người tin vào sự mê tín mười ba.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"thirty":{"definition":"Số ba mươi.","example":"A thirty helped the team.","exampleTranslation":"Số ba mươi đã giúp đội bóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"thorough":{"definition":"Hoàn toàn, hoàn bị, hoàn hảo.","example":"You need to take a thorough rest after work.","exampleTranslation":"Bạn cần nghỉ ngơi hoàn toàn sau công việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"threshold":{"definition":"Ngưỡng cửa.","example":"They stood at the threshold of the ancient temple.","exampleTranslation":"Họ đứng tại ngưỡng cửa của ngôi đền cổ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"throw":{"definition":"Sự ném, sự vứt, sự quăng, sự liệng.","example":"One throw sent the ball over the fence.","exampleTranslation":"Một sự ném đã đưa quả bóng qua hàng rào.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"throes":{"definition":"Quằn quại.","example":"The cat seemed to throes in the grass.","exampleTranslation":"Con mèo dường như quằn quại trong đám cỏ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"throughout":{"definition":"Từ đầu đến cuối, khắp, suốt.","example":"He traveled throughout the country last summer.","exampleTranslation":"Anh ấy đã đi du lịch khắp đất nước mùa hè năm ngoái.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"E","posGroup":"other","family":"general-reading"},"thrust":{"definition":"Sự công kích (trong cuộc tranh luận).","example":"Her comment was a direct thrust at him.","exampleTranslation":"Lời bình luận của cô ấy là một sự công kích trực tiếp vào anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"thwack":{"definition":"Chia phần, chia nhau ((cũng) to whack up).","example":"They thwack the cost and share the rest.","exampleTranslation":"Họ chia phần chi phí và chia nhau phần còn lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"tidy":{"definition":"Sạch sẽ, ngăn nắp, gọn gàng.","example":"She kept her bedroom very tidy and clean.","exampleTranslation":"Cô ấy giữ phòng ngủ của mình rất sạch sẽ và ngăn nắp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"tied":{"definition":"Cho ai thuê với điều kiện người đó làm việc cho chủ nhà (về một ngôi nhà).","example":"They lived in a tied house near the factory.","exampleTranslation":"Họ sống trong một ngôi nhà cho thuê với điều kiện người đó làm việc cho chủ nhà gần nhà máy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"tight":{"definition":"Kín, không thấm, không rỉ.","example":"We must run a tight ship at work.","exampleTranslation":"Chúng ta phải giữ một kỷ luật kín tại nơi làm việc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"tighten":{"definition":"Thắt chặt, siết chặt.","example":"You need to tighten the knot on your shoes.","exampleTranslation":"Bạn cần thắt chặt nút thắt trên giày của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"time":{"definition":"Thời, thời buổi, mùa.","example":"This is a hard time for many families.","exampleTranslation":"Đây là một thời buổi khó khăn cho nhiều gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"tiny":{"definition":"Nhỏ xíu, tí hon, bé tí.","example":"She found a tiny gold ring on the floor.","exampleTranslation":"Cô ấy tìm thấy một chiếc nhẫn vàng nhỏ xíu trên sàn nhà.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"topped":{"definition":"Cụt; cụt ngọn.","example":"The topped tree grew no higher after pruning.","exampleTranslation":"Cái cây cụt không cao thêm sau khi cắt tỉa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"topple":{"definition":"Làm ngã, vật xuống, xô ngã, lật đổ.","example":"The heavy vase will topple if you push it.","exampleTranslation":"Cái bình nặng sẽ vật xuống nếu bạn đẩy nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"tortuous":{"definition":"Quanh co, khúc khuỷu, uốn khúc.","example":"We walked along a very tortuous path today.","exampleTranslation":"Chúng tôi đã đi dọc theo một con đường quanh co hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"total":{"definition":"Tổng cộng, toàn bộ.","example":"The country faced a state of total war.","exampleTranslation":"Đất nước phải đối mặt với một tình trạng chiến tranh tổng cộng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"totally":{"definition":"Hoàn toàn.","example":"They worked totally all day.","exampleTranslation":"Họ đã làm việc hoàn toàn cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"tots":{"definition":"Động từ chia ở ngôi thứ ba số ít của tot","example":"The cashier tots the numbers carefully.","exampleTranslation":"Người thu ngân tổng cộng các con số một cách cẩn thận.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"tough":{"definition":"Dai, bền.","example":"This leather jacket is very tough and durable.","exampleTranslation":"Chiếc áo khoác da này rất dai và bền.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"toying":{"definition":"Trò chơi, trò đùa bỡn, trò giỡn, trò giễu cợt.","example":"Their toying delayed the real work.","exampleTranslation":"Trò giỡn của họ đã làm chậm trễ công việc thực sự.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"trap":{"definition":"Đá trap ((cũng) traprock).","example":"We walked over rough trap near the hill.","exampleTranslation":"Chúng tôi đã đi bộ qua đá trap thô gần ngọn đồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"tremendous":{"definition":"Ghê gớm, kinh khủng, khủng khiếp, dữ dội.","example":"The news caused a tremendous shock to everyone.","exampleTranslation":"Tin tức đã gây ra một cú sốc ghê gớm cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"trick":{"definition":"Trò chơi khăm, trò chơi xỏ; trò ranh ma, trò tinh nghịch.","example":"Do you want to play a trick on me?","exampleTranslation":"Bạn có muốn chơi một trò chơi khăm tôi không?","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"tricky":{"definition":"Xảo quyệt, lắm thủ đoạn, mưu mẹo, xỏ lá, láu cá, mánh lới.","example":"He is a tricky man who loves to cheat.","exampleTranslation":"Anh ấy là một người xảo quyệt thích lừa lọc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"tries":{"definition":"Động từ chia ở ngôi thứ ba số ít của try","example":"He tries every day to learn faster.","exampleTranslation":"Anh ấy cố gắng mỗi ngày để học nhanh hơn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"trim":{"definition":"Sự ngăn nắp, sự gọn gàng.","example":"Everything is in perfect trim for the big party.","exampleTranslation":"Mọi thứ đã được sắp xếp gọn gàng hoàn hảo cho buổi tiệc lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"triplet":{"definition":"Đoạn thơ ba câu.","example":"She wrote a triplet about morning, noon, and night.","exampleTranslation":"Cô ấy đã viết một đoạn thơ ba câu về buổi sáng, buổi trưa và đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"truly":{"definition":"Thành thật, thành khẩn, chân thành.","example":"I am truly grateful for your kind help.","exampleTranslation":"Tôi thực sự biết ơn sự giúp đỡ tử tế của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"trying":{"definition":"Nguy ngập, gay go, khó khăn.","example":"It was a trying situation for the family.","exampleTranslation":"Đó là một tình huống gay go đối với gia đình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"twentieth":{"definition":"Một phần hai mươi.","example":"A twentieth of the pie was enough for me.","exampleTranslation":"Một phần hai mươi của cái bánh là đủ với tôi rồi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"twice":{"definition":"Gấp hai.","example":"She wants twice as much money as him.","exampleTranslation":"Cô ấy muốn số tiền gấp hai lần anh ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"twist":{"definition":"Sự nhăn nhó, sự méo mó, sự quằn quại.","example":"A small twist of the lips showed her smile.","exampleTranslation":"Một cử chỉ nhăn nhó nhẹ của đôi môi đã cho thấy nụ cười của cô ấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"type":{"definition":"Kiểu mẫu.","example":"This is a fine type of patriotism for us.","exampleTranslation":"Đây là một kiểu mẫu lòng yêu nước tốt cho chúng ta.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"typical":{"definition":"Tiêu biểu, điển hình ((cũng) typic).","example":"He is a typical patriot who loves his country.","exampleTranslation":"Anh ta là một người yêu nước tiêu biểu, người yêu đất nước mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"typically":{"definition":"Điển hình, tiêu biểu.","example":"They worked typically all day.","exampleTranslation":"Họ thường làm việc suốt cả ngày.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"ultimate":{"definition":"Cuối cùng, sau cùng, chót.","example":"Our ultimate aim is to finish this project.","exampleTranslation":"Mục tiêu cuối cùng của chúng tôi là hoàn thành dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"ultimately":{"definition":"cuối cùng; rốt cuộc","example":"We will all help, but it is you who are ultimately responsible.","exampleTranslation":"Tất cả chúng ta sẽ cùng giúp đỡ, nhưng cuối cùng chính bạn là người chịu trách nhiệm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adv","posGroup":"adverb","family":"general-reading"},"ultra":{"definition":"rất; khác thường; cực","example":"The room felt ultra after cleaning.","exampleTranslation":"Căn phòng cảm giác rất sạch sẽ khác thường sau khi dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unable":{"definition":"Không có năng lực, không có khả năng, bất tài.","example":"He was unable to finish the difficult task on time.","exampleTranslation":"Anh ấy đã không có khả năng hoàn thành nhiệm vụ khó khăn đúng thời hạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unavoidable":{"definition":"Không thể tránh được.","example":"His voice stayed unavoidable all night.","exampleTranslation":"Giọng nói của anh ta vẫn không thể tránh được suốt đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unblemished":{"definition":"Không có vết nhơ (thanh danh... ).","example":"Her record is unblemished and clear.","exampleTranslation":"Hồ sơ của cô ấy không có một vết nhơ và rất rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unbroken":{"definition":"Không bị bẻ gãy, không sứt mẻ; nguyên vẹn.","example":"The vase stayed unbroken on the shelf.","exampleTranslation":"Chiếc bình vẫn nguyên vẹn trên kệ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unchanged":{"definition":"Không thay đổi, như cũ, y nguyên.","example":"The schedule stayed unchanged all week.","exampleTranslation":"Lịch trình vẫn không thay đổi suốt cả tuần.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unclear":{"definition":"Không trong, đục.","example":"The water looked unclear after the rain.","exampleTranslation":"Nước trông không trong sau trận mưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"uncover":{"definition":"Để hở, mở (vung, nắp); cởi (áo); bỏ (mũ).","example":"Please uncover the pot before it boils over.","exampleTranslation":"Vui lòng mở vung nồi trước khi nó sôi trào ra ngoài.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"undamaged":{"definition":"Không bị tổn hại, không bị hư hại; còn nguyên; còn tốt.","example":"The box arrived undamaged at the store.","exampleTranslation":"Chiếc hộp đã đến cửa hàng mà không bị tổn hại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"undergo":{"definition":"Chịu, bị, trải qua.","example":"The old city will undergo a great change soon.","exampleTranslation":"Thành phố cũ sẽ sớm trải qua một sự thay đổi lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"underneath":{"definition":"Phần dưới, bên dưới, mặt dưới.","example":"Clean the underneath of the table.","exampleTranslation":"Hãy làm sạch mặt dưới của cái bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"unexpected":{"definition":"Không mong đợi, bất ngờ, không ngờ, thình lình.","example":"Winning the lottery was an unexpected piece of luck.","exampleTranslation":"Trúng xổ số là một sự may mắn không mong đợi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unfamiliar":{"definition":"Không quen, không biết, lạ.","example":"The new town felt unfamiliar to me.","exampleTranslation":"Thị trấn mới cảm giác không quen với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unfilled":{"definition":"Trống.","example":"There is still an unfilled seat in the front.","exampleTranslation":"Vẫn còn một ghế trống ở phía trước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unforeseen":{"definition":"Không biết trước, không dự kiến; bất ngờ.","example":"The delay was unforeseen and costly.","exampleTranslation":"Sự chậm trễ là không biết trước và gây tốn kém.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unfortunately":{"definition":"Một cách đáng tiếc, không may.","example":"He left unfortunately after lunch.","exampleTranslation":"Anh ấy đã rời đi một cách đáng tiếc sau bữa trưa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"unimpeded":{"definition":"Không bị ngăn trở, không bị cản trở, không bị trở ngại.","example":"Traffic moved unimpeded through the open road.","exampleTranslation":"Giao thông di chuyển không bị ngăn trở trên con đường rộng mở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unique":{"definition":"Chỉ có một, duy nhất, đơn nhất, vô song.","example":"This painting has a very unique meaning for me.","exampleTranslation":"Bức tranh này có một ý nghĩa rất duy nhất đối với tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"uniquely":{"definition":"Đơn nhất; độc nhất vô nhị, chỉ có một.","example":"The plan looked uniquely in practice.","exampleTranslation":"Kế hoạch trông có vẻ đơn nhất trong thực tế.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unit":{"definition":"Đơn vị.","example":"One unit of measurement is needed for this project.","exampleTranslation":"Một đơn vị đo lường là cần thiết cho dự án này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"unknown":{"definition":"Không biết, chưa từng ai biết, lạ.","example":"They traveled to a remote and unknown country.","exampleTranslation":"Họ đã đi du lịch đến một đất nước xa xôi và không ai biết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unleash":{"definition":"Mở (xích chó).","example":"They unleash the dog only in the yard.","exampleTranslation":"Họ chỉ mở xích con chó trong sân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"unlike":{"definition":"Khác, không giống.","example":"He is very unlike his parents in personality.","exampleTranslation":"Anh ấy rất không giống cha mẹ mình về tính cách.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unlikely":{"definition":"khó có khả năng","example":"It's unlikely that it will rain today.","exampleTranslation":"Khó có khả năng là trời sẽ mưa hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"adj","posGroup":"adjective","family":"general-reading"},"unlimited":{"definition":"Không giới hạn, vô vùng, vô tận, vô kể.","example":"You have unlimited time to finish the task.","exampleTranslation":"Bạn có thời gian không giới hạn để hoàn thành nhiệm vụ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unmodified":{"definition":"Không giảm, không bớt.","example":"The report stayed unmodified after the review.","exampleTranslation":"Báo cáo vẫn không giảm sau khi xem xét lại.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unnecessary":{"definition":"Không cần thiết, thừa, vô ích.","example":"That extra step is unnecessary.","exampleTranslation":"Bước phụ đó là không cần thiết.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unprecedented":{"definition":"Không hề có; chưa hề thấy, chưa từng nghe thấy; vô tiền khoáng hậu.","example":"The city faced an unprecedented level of heavy snow.","exampleTranslation":"Thành phố đã đối mặt với một mức tuyết rơi dày chưa từng thấy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unrelated":{"definition":"Không có quan hệ họ hàng.","example":"They are unrelated, though they share a surname.","exampleTranslation":"Họ không có quan hệ họ hàng, mặc dù họ cùng họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unsatisfactory":{"definition":"Không làm tho m n, không làm vừa ý, không làm vừa lòng.","example":"The result was unsatisfactory for everyone.","exampleTranslation":"Kết quả là không làm vừa ý cho mọi người.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unspectacular":{"definition":"Không hấp dẫn, không lôi cuốn.","example":"The movie was quiet but unspectacular.","exampleTranslation":"Bộ phim yên tĩnh nhưng không hấp dẫn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unstuck":{"definition":"Chưa bóc, chưa gỡ.","example":"The sticker came unstuck from the notebook.","exampleTranslation":"Miếng dán đã bong chưa bóc ra khỏi sổ tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unsuitable":{"definition":"Không phù hợp, không thích hợp.","example":"That seat is unsuitable for a child.","exampleTranslation":"Chỗ ngồi đó không phù hợp cho trẻ em.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"untouched":{"definition":"Không sờ đến, không mó đến, không động đến, không suy suyển, còn nguyên.","example":"Please do not leave your dinner untouched on the table.","exampleTranslation":"Vui lòng đừng để bữa tối của bạn còn nguyên trên bàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unusual":{"definition":"Không thường, không thông thường, không thường dùng, không quen.","example":"That is an unusual bird in this park.","exampleTranslation":"Đó là một con chim không thông thường trong công viên này.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"unveil":{"definition":"Để lộ, tiết lộ.","example":"They will unveil the new product next Monday morning.","exampleTranslation":"Họ sẽ để lộ sản phẩm mới vào sáng thứ Hai tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"upcoming":{"definition":"Chỉ những gì sắp diễn ra.","example":"The room felt upcoming after cleaning.","exampleTranslation":"Căn phòng cảm giác rất sắp diễn ra sau khi dọn dẹp.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"uphill":{"definition":"Khó khăn, vất vả (công việc), gian truân, gay go.","example":"Cleaning the entire house was an uphill task.","exampleTranslation":"Dọn dẹp toàn bộ ngôi nhà là một công việc khó khăn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"upper":{"definition":"Trên, cao, thượng.","example":"She hurt her arm in the upper jaw area.","exampleTranslation":"Cô ấy bị thương cánh tay ở vùng xương hàm trên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"upside":{"definition":"Mặt trên; phần trên.","example":"Flip the box to check the upside.","exampleTranslation":"Lật ngược cái hộp để kiểm tra mặt trên.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"upwards":{"definition":"Đi lên, hướng lên, lên.","example":"The balloon drifted upwards into the clear sky.","exampleTranslation":"Khinh khí cầu trôi đi lên vào bầu trời trong xanh.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"urgent":{"definition":"Gấp, cần kíp, khẩn cấp, cấp bách.","example":"I have an urgent message for the manager.","exampleTranslation":"Tôi có một tin nhắn khẩn cấp cho quản lý.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"useful":{"definition":"Làm ăn được, cừ.","example":"That old tool is still quite useful for gardening.","exampleTranslation":"Công cụ cũ đó vẫn khá làm ăn được cho việc làm vườn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"usefulness":{"definition":"Sự ích lợi; tính chất có ích.","example":"The usefulness of this map is clear.","exampleTranslation":"Sự ích lợi của bản đồ này rất rõ ràng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"utterly":{"definition":"Hoàn toàn.","example":"I read the note utterly.","exampleTranslation":"Tôi đọc ghi chú hoàn toàn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"vanish":{"definition":"Biến mất, lẩn mất, biến dần, tiêu tan ((nghĩa đen) & (nghĩa bóng)).","example":"The magician made the rabbit vanish into thin air.","exampleTranslation":"Nhà ảo thuật đã làm con thỏ biến mất vào không trung.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"variety":{"definition":"trạng thái khác nhau, trạng thái muôn màu muôn vẻ; tính chất bất đồng","example":"She enjoys a life full of variety and color.","exampleTranslation":"Cô ấy tận hưởng một cuộc sống đầy sự muôn màu muôn vẻ và màu sắc.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"various":{"definition":"Khác nhau; nhiều thứ khác nhau.","example":"Many people travel to various places every summer.","exampleTranslation":"Nhiều người đi du lịch đến nhiều thứ khác nhau mỗi mùa hè.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"vary":{"definition":"Làm cho khác nhau, thay đổi, biến đổi.","example":"You should vary your diet to stay healthy.","exampleTranslation":"Bạn nên thay đổi chế độ ăn uống của mình để giữ sức khỏe.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"vast":{"definition":"Rộng lớn, mênh mông, bao la; to lớn ((nghĩa đen) & (nghĩa bóng)).","example":"They looked out over a vast expanse of water.","exampleTranslation":"Họ nhìn ra một vùng rộng lớn bao la của nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"vastly":{"definition":"Vô cùng, to.","example":"The new technology improved our lives vastly.","exampleTranslation":"Công nghệ mới đã cải thiện cuộc sống của chúng ta vô cùng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"vaunt":{"definition":"Lời khoe khoang khoác lác.","example":"He made a loud vaunt about his bike.","exampleTranslation":"Anh ấy đã khoe khoang khoác lác về chiếc xe đạp của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"void":{"definition":"Trống, bỏ không, trống rỗng, khuyết.","example":"There is a large void in the center.","exampleTranslation":"Có một sự trống rỗng lớn ở trung tâm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"volume":{"definition":"Quyển, tập.","example":"Teens listening to their MP3 players at high volume can damage their hearing.","exampleTranslation":"Thanh thiếu niên nghe máy nghe nhạc MP3 với tập âm thanh cao có thể làm tổn thương thính giác của họ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"waft":{"definition":"Làn (gió... ).","example":"A warm waft came through the open door.","exampleTranslation":"Một làn gió ấm thổi qua cánh cửa mở.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"wait":{"definition":"Sự chờ đợi; thời gian chờ đợi.","example":"There was a long wait at the airport.","exampleTranslation":"Có một thời gian chờ đợi dài tại sân bay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"wake":{"definition":"Thức giấc, thức dậy, tỉnh dậy.","example":"I wake up with a start every morning.","exampleTranslation":"Tôi thức giấc với sự giật mình mỗi sáng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"wander":{"definition":"Đi thơ thẩn, đi lang thang.","example":"We like to wander about the old streets.","exampleTranslation":"Chúng tôi thích đi lang thang quanh những con phố cũ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"warmer":{"definition":"Lồng ấp.","example":"The warmer kept the soup hot.","exampleTranslation":"Cái lồng ấp giữ cho món súp nóng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"wedge":{"definition":"Cái nêm.","example":"He used a wedge to open the door.","exampleTranslation":"Anh ấy đã sử dụng một cái nêm để mở cửa.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"weigh":{"definition":"Đang đi, dọc đường.","example":"They were on the weigh home from school.","exampleTranslation":"Họ đang trên đường đi học về.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"whack":{"definition":"Cú đánh mạnh; đòn đau.","example":"One whack of the hammer fixed it.","exampleTranslation":"Một cú đánh mạnh bằng búa đã sửa được nó.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"whatsoever":{"definition":"Dạng nhấn mạnh của whatever.","example":"I have no complaints whatsoever.","exampleTranslation":"Tôi không có bất kỳ lời phàn nàn nào cả.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"whilst":{"definition":"While.","example":"Whilst he waited, she finished her work.","exampleTranslation":"Trong khi anh ấy đợi, cô ấy đã hoàn thành công việc của mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"C","posGroup":"other","family":"general-reading"},"whip":{"definition":"Roi, roi da.","example":"He cracked the whip to start the horses.","exampleTranslation":"Anh ấy quất roi da để thúc lũ ngựa bắt đầu chạy.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"whirr":{"definition":"Tiếng kêu vù vù; tiếng kêu vo vo.","example":"The fan made a soft whirr.","exampleTranslation":"Cái quạt tạo ra tiếng kêu vù vù nhẹ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"whitish":{"definition":"Hơi trắng.","example":"Her whitish scarf looked pale in sunlight.","exampleTranslation":"Chiếc khăn quàng hơi trắng của cô ấy trông nhợt nhạt dưới ánh nắng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"whittle":{"definition":"Dao bầu.","example":"He carried a whittle in his pocket.","exampleTranslation":"Anh ấy mang theo một con dao bầu trong túi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"whizz":{"definition":"Tiếng rít, tiếng vèo (của đạn... ).","example":"A whizz passed overhead in the night.","exampleTranslation":"Một tiếng rít vèo qua trên đầu vào ban đêm.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"wholly":{"definition":"Toàn bộ, hoàn toàn.","example":"I do not wholly agree with your opinion.","exampleTranslation":"Tôi không hoàn toàn đồng ý với ý kiến của bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"widely":{"definition":"Nhiều, xa.","example":"This book is widely read by students all over.","exampleTranslation":"Cuốn sách này được sinh viên khắp mọi nơi đọc nhiều.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"D","posGroup":"other","family":"general-reading"},"widen":{"definition":"Làm cho rộng ra, nới rộng ra, mở rộng.","example":"They widen the road next month.","exampleTranslation":"Họ sẽ mở rộng con đường vào tháng tới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"widespread":{"definition":"Lan rộng, phổ biến.","example":"The rumor became widespread in the town.","exampleTranslation":"Lời đồn đó trở nên lan rộng khắp thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"width":{"definition":"Tính chất rộng.","example":"The road has a great width for large trucks.","exampleTranslation":"Con đường có chiều rộng lớn dành cho xe tải hạng nặng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"wipe":{"definition":"Cái tát, cái quật.","example":"The child got a playful wipe on the arm.","exampleTranslation":"Đứa trẻ đã có một cái tát nghịch ngợm vào cánh tay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"withdraw":{"definition":"Rút, rút lui.","example":"The army will withdraw troops from the border.","exampleTranslation":"Quân đội sẽ rút quân khỏi biên giới.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"withdrawal":{"definition":"Sự rút lui (ý kiến).","example":"His withdrawal from the debate ended the argument.","exampleTranslation":"Sự rút lui của ông ấy khỏi cuộc tranh luận đã chấm dứt cuộc cãi vã.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"withstand":{"definition":"Chống lại, chống cự; chịu đựng.","example":"The old bridge can withstand the heavy storm.","exampleTranslation":"Cây cầu cũ có thể chống cự lại cơn bão lớn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"wobble":{"definition":"Lắc lư, nghiêng bên nọ ngả bên kia.","example":"The boat began to wobble in the water.","exampleTranslation":"Con thuyền bắt đầu lắc lư trên mặt nước.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"wonderful":{"definition":"Kỳ lạ, phi thường; kỳ diệu, thần kỳ.","example":"It was a wonderful day at the beach.","exampleTranslation":"Đó là một ngày kỳ diệu ở bãi biển.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"woolly":{"definition":"Mờ, không rõ ràng, mập mờ, thiếu chính xác.","example":"His description of the plan was a bit woolly.","exampleTranslation":"Mô tả của anh ấy về kế hoạch còn hơi mập mờ.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"worse":{"definition":"Cái xấu hơn, cái tệ hơn, cái tồi hơn.","example":"I fear that there was something worse to come.","exampleTranslation":"Tôi sợ rằng có điều gì đó tồi tệ hơn sắp xảy ra.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"worst":{"definition":"Xấu nhất, tồi nhất, tệ nhất.","example":"That was the worst day of my week.","exampleTranslation":"Đó là ngày tồi tệ nhất trong tuần của tôi.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"worthwhile":{"definition":"Quan trọng, thú vị hoặc đáng bỏ thời gian, tiền của hoặc nỗ lực; đáng giá; bõ công.","example":"It is worthwhile to visit the museum.","exampleTranslation":"Rất đáng giá để ghé thăm bảo tàng.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"worthy":{"definition":"Xứng đáng, có phẩm giá đáng kính, đáng trọng (người).","example":"We must respect all worthy people in our town.","exampleTranslation":"Chúng ta phải tôn trọng tất cả những người đáng kính trong thị trấn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"wreak":{"definition":"Làm cho hả, trút (giận... ).","example":"Do not wreak vengeance upon those who helped you.","exampleTranslation":"Đừng trút giận lên những người đã giúp đỡ bạn.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"V","posGroup":"verb","family":"general-reading"},"wrench":{"definition":"Sự trật, sự sái (chân, mắt cá).","example":"He felt a sharp wrench in his ankle.","exampleTranslation":"Anh ấy cảm thấy một sự trật khớp nhói lên ở mắt cá chân.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"wrinkle":{"definition":"Ngón; lời mách nước.","example":"He gave me a wrinkle about the secret plan.","exampleTranslation":"Anh ấy đã cho tôi một lời mách nước về kế hoạch bí mật.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"yard":{"definition":"Trục căng buồm.","example":"The sailors adjusted the yard on the ship.","exampleTranslation":"Các thủy thủ đã điều chỉnh trục căng buồm trên con tàu.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"yellow":{"definition":"Vàng.","example":"The autumn leaves turned yellow on the trees.","exampleTranslation":"Những chiếc lá mùa thu chuyển sang màu vàng trên cây.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"A","posGroup":"adjective","family":"general-reading"},"yowl":{"definition":"Tiếng ngao (mèo); tiếng tru (chó).","example":"The yowl from the cat startled me.","exampleTranslation":"Tiếng ngao của con mèo làm tôi giật mình.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"zero":{"definition":"; (vật lý) zêrô, số không.","example":"The temperature reached zero during the cold night.","exampleTranslation":"Nhiệt độ đã xuống mức số không trong suốt đêm lạnh giá.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"},"zoom":{"definition":"Tiếng kêu vù vu (của máy bay... ).","example":"They discussed the zoom today.","exampleTranslation":"Họ đã thảo luận về tiếng kêu vù vù đó hôm nay.","dictionarySource":"offline","exampleSource":"offline","partOfSpeech":"N","posGroup":"noun","family":"general-reading"}},"wordCount":6432,"topicCount":38},{"id":"ielts-advanced-vocabulary-v1","title":"IELTS Nâng cao","description":"Luyện 1.176 từ học thuật khó và thuật ngữ chuyên sâu qua 37 chủ đề.","lessons":[{"id":"ielts-advanced-vocabulary-v1-society-lesson-8","title":"Bài 8","focus":"Cộng đồng, dân số, phúc lợi, quan hệ xã hội và thay đổi xã hội.","topicId":"society","topicTitle":"Xã hội và cộng đồng","questions":[{"term":"demographer","prompt":"The _____ studied local birth rates.","choices":["demographer","politic","appease","codify"]},{"term":"demographic","prompt":"The report gives a _____ view of the town.","choices":["demographic","compel","countenance","covet"]},{"term":"ethicize","prompt":"Parents should _____ rules with fair examples.","choices":["ethicize","terrestrial","undulation","celestial"]},{"term":"deference","prompt":"He treated the old king with great _____.","choices":["deference","paternal","espouse","phonetic"]},{"term":"denigration","prompt":"Her _____ of the team was unfair.","choices":["denigration","get off","get over","get through"]},{"term":"denizen","prompt":"A _____ of the town waved from his porch.","choices":["denizen","antediluvian","hieroglyph","hieroglyphics"]},{"term":"dignitary","prompt":"A _____ visited the school today.","choices":["dignitary","commodity","gross domestic product","liquidity"]},{"term":"cosmopolitan","prompt":"She has a very _____ outlook on life.","choices":["cosmopolitan","canopy","degradation","deplete"]},{"term":"interloper","prompt":"The _____ entered the garden without asking.","choices":["interloper","ration","uneven","better"]},{"term":"loggerhead","prompt":"He felt like a _____ in the meeting.","choices":["loggerhead","austere","curate","esoteric"]},{"term":"proletariat","prompt":"The workers represent the industrial _____ of the city.","choices":["proletariat","liquidation","mismanagement","niche"]},{"term":"rustication","prompt":"They enjoyed _____ in a quiet village.","choices":["rustication","explicit","logographic","plosive"]},{"term":"salacious","prompt":"He avoided the _____ magazine cover.","choices":["salacious","rebus","reiteration","vernacular"]},{"term":"advocacy","prompt":"Community _____ helped secure safer roads near the school.","choices":["advocacy","prerecorded","worthless","absorbing"]},{"term":"autonomy","prompt":"Local _____ allowed the region to manage its schools.","choices":["autonomy","edifice","facade","forecourt"]},{"term":"cohesion","prompt":"Shared public spaces can strengthen social _____.","choices":["cohesion","get in","get off","get over"]},{"term":"advocate","prompt":"Community organisations _____ greater civic participation in decisions affecting local residents.","choices":["advocate","capitalize","accrue","allocate"]},{"term":"class","prompt":"Researchers found that social _____ strongly influenced access to higher education and civic participation.","choices":["class","spelunking","treadmill","anthropologist"]},{"term":"convict","prompt":"The programme helped each _____ develop skills needed for employment after release.","choices":["convict","decanted","disintegrate","hygroscopic"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-society-lesson-9","title":"Bài 9","focus":"Cộng đồng, dân số, phúc lợi, quan hệ xã hội và thay đổi xã hội.","topicId":"society","topicTitle":"Xã hội và cộng đồng","questions":[{"term":"prison reform","prompt":"Effective _____ can reduce reoffending by improving education, healthcare, and family contact.","choices":["prison reform","biodegradable","deplete","eradicate"]},{"term":"privileged","prompt":"_____ students often receive social advantages that remain unavailable to their less wealthy peers.","choices":["privileged","physiological","anthropomorphic","carnivorous"]},{"term":"prosecute","prompt":"Authorities may _____ employers who systematically exclude disabled people from meaningful work.","choices":["prosecute","perpetuate","feminize","dwindle"]},{"term":"coherent","prompt":"A _____ policy should connect rehabilitation, community support, and long-term employment opportunities.","choices":["coherent","osteoporosis","pathogen","prognosis"]},{"term":"comprise","prompt":"The research sample may _____ volunteers from several regions with different educational backgrounds.","choices":["comprise","criminalization","culprit","delinquency"]},{"term":"contrasting","prompt":"_____ experiences of inclusion reveal how institutions can either empower or marginalise citizens.","choices":["contrasting","censorship","circular","preface"]},{"term":"divorce","prompt":"High _____ rates can reshape household structures and influence children's access to social support.","choices":["divorce","comprise","contrasting","identify with"]},{"term":"identify with","prompt":"Young migrants may _____ local cultural groups while maintaining ties to their communities of origin.","choices":["identify with","reiteration","tacit","vernacular"]},{"term":"joint","prompt":"Regular _____ activities can strengthen trust among residents from different backgrounds.","choices":["joint","galvanism","isotope","luminance"]},{"term":"related","prompt":"The survey examined health outcomes _____ to social isolation among older adults.","choices":["related","galvanism","isotope","luminance"]},{"term":"acquaintance","prompt":"Limited _____ with digital services can exclude older adults from online civic participation.","choices":["acquaintance","die out","do up","get into"]},{"term":"companion","prompt":"A trained _____ can reduce loneliness among older adults living independently.","choices":["companion","pragmatic","semantic","anecdotal"]},{"term":"dependant","prompt":"A household _____ may require financial support when the primary earner loses employment.","choices":["dependant","aestheticism","aesthetics","functionary"]},{"term":"empathise","prompt":"Teachers who _____ with displaced students can create more inclusive learning environments.","choices":["empathise","epistemology","anachronism","antique"]},{"term":"guardian","prompt":"A legal _____ helped the young participant access education and manage inherited property.","choices":["guardian","cuticle","degeneration","dendrite"]},{"term":"stepmother","prompt":"The survey examined how a supportive _____ influenced adolescents' social participation.","choices":["stepmother","companion","dependant","empathise"]},{"term":"son","prompt":"In many societies, a _____ is still expected to support elderly parents.","choices":["son","ergonomics","versatility","civil service"]},{"term":"successor","prompt":"The appointed _____ introduced policies that expanded employee participation in organisational decisions.","choices":["successor","pass on","pick on","read up"]},{"term":"sympathise","prompt":"Many citizens _____ with migrants facing barriers to education and civic participation.","choices":["sympathise","mitigation","sanctuary","stewardship"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-society-work-lesson-7","title":"Bài 7","focus":"Từ vựng về cơ hội việc làm, bất bình đẳng, đô thị hóa và hạ tầng.","topicId":"society-work","topicTitle":"Xã hội và việc làm","questions":[{"term":"hierarchical","prompt":"The school uses a _____ system.","choices":["hierarchical","reiteration","vernacular","allege"]},{"term":"inductee","prompt":"Each _____ stood proudly at attention.","choices":["inductee","dash","hop","jog"]},{"term":"subordination","prompt":"She disliked the _____ of art to money.","choices":["subordination","hinterland","estuary","clutch"]},{"term":"freelancer","prompt":"A _____ can choose projects that match their specialist skills.","choices":["freelancer","synaptic","unviable","vasomotor"]},{"term":"networking","prompt":"Professional _____ helped her find a mentor in the industry.","choices":["networking","apathy","chuckle","contentment"]},{"term":"layoff","prompt":"The factory announced a _____ after demand fell.","choices":["layoff","dissection","entomologist","entomology"]},{"term":"subordinate","prompt":"The report treated community feedback as _____ to cost estimates.","choices":["subordinate","work-life balance","proficiency","maternity leave"]},{"term":"competency","prompt":"The role requires _____ in data analysis and clear communication.","choices":["competency","allergen","pharmacology","calorie"]},{"term":"remuneration","prompt":"The contract specifies the _____ for each completed assignment.","choices":["remuneration","dialectical","eloquently","explicit"]},{"term":"delegation","prompt":"Effective _____ allowed the manager to focus on long-term planning.","choices":["delegation","deteriorate","dilapidated","uninhabitable"]},{"term":"work-life balance","prompt":"Flexible hours helped employees maintain a healthier _____.","choices":["work-life balance","psychometric","baffle","contemplate"]},{"term":"proficiency","prompt":"The position requires _____ in written and spoken English.","choices":["proficiency","tout","democratization","absolutist"]},{"term":"maternity leave","prompt":"The policy provides paid _____ for six months.","choices":["maternity leave","carry over","catch on","dive in"]},{"term":"severance","prompt":"The company offered _____ to employees whose positions were eliminated.","choices":["severance","think over","think through","think up"]},{"term":"redundancy","prompt":"The company reduced staff _____ after reorganizing its regional offices.","choices":["redundancy","touch up","use up","walk out"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-family-lesson-27","title":"Bài 27","focus":"Nuôi dạy trẻ, quan hệ gia đình, tuổi tác và thay đổi thế hệ.","topicId":"family","topicTitle":"Gia đình và các thế hệ","questions":[{"term":"maternal","prompt":"She has a very strong _____ instinct.","choices":["maternal","meet up","mull over","open up"]},{"term":"paternal","prompt":"She felt a deep sense of _____ love for her son.","choices":["paternal","ferocious","indigenous","reptilian"]},{"term":"paternalism","prompt":"The manager's _____ annoyed some of the staff.","choices":["paternalism","fossilise","fossilize","naturalise"]},{"term":"adolescence","prompt":"_____ can feel confusing and exciting.","choices":["adolescence","anomaly","chromatograph","chronometer"]},{"term":"descendant","prompt":"She is a _____ of a famous farmer.","choices":["descendant","sainfoin","transnational","outsourcing"]},{"term":"espouse","prompt":"They _____ their daughter to a kind man.","choices":["espouse","gloat","grimace","moan"]},{"term":"matriarch","prompt":"The _____ planned every family dinner.","choices":["matriarch","crawl","emigrate","glide"]},{"term":"parentage","prompt":"Her _____ was known to the whole town.","choices":["parentage","vista","islet","hinterland"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-equality-lesson-33","title":"Bài 33","focus":"Bình đẳng giới, phân biệt đối xử, quyền và sự hòa nhập.","topicId":"equality","topicTitle":"Bình đẳng và quyền con người","questions":[{"term":"feminize","prompt":"The artist tried to _____ the character.","choices":["feminize","regenerate","secrete","corroborate"]},{"term":"disparity","prompt":"There is a large _____ between the two salaries.","choices":["disparity","successor","careerist","entrepreneurship"]},{"term":"egalitarian","prompt":"She is an _____ who values fair treatment.","choices":["egalitarian","reclamation","allure","animosity"]},{"term":"egalitarianism","prompt":"Their class promoted _____ in daily life.","choices":["egalitarianism","delinquency","implicate","pillage"]},{"term":"harassment","prompt":"The constant _____ made her feel tired and sad.","choices":["harassment","holistic","conscientious","inattentive"]},{"term":"inhumane","prompt":"It was _____ to leave them outside.","choices":["inhumane","petition","placard","quibble"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-development-lesson-34","title":"Bài 34","focus":"Phát triển con người, nghèo đói, viện trợ và cơ hội tiếp cận dịch vụ.","topicId":"development","topicTitle":"Phát triển và giảm nghèo","questions":[{"term":"humanitarian","prompt":"The _____ visited the shelter daily.","choices":["humanitarian","blurt out","bump into","come out"]},{"term":"humanitarianism","prompt":"_____ pushed them to help poor families.","choices":["humanitarianism","competency","remuneration","delegation"]},{"term":"dwindle","prompt":"My savings _____ when bills arrive.","choices":["dwindle","flagrant","implicate","inadmissible"]},{"term":"meager","prompt":"They had a _____ meal after the hike.","choices":["meager","come up","go back","fall behind"]},{"term":"meliorate","prompt":"We can _____ the plan with better notes.","choices":["meliorate","pharmacology","calorie","probiotic"]},{"term":"subsistence","prompt":"They struggled to earn a basic _____ wage.","choices":["subsistence","cortex","cuticle","degeneration"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-psychology-lesson-39","title":"Bài 39","focus":"Nhận thức, cảm xúc, động lực và hành vi con người.","topicId":"psychology","topicTitle":"Tâm lý học","questions":[{"term":"abhor","prompt":"Please _____ the note for me.","choices":["abhor","public sector","economisation","economization"]},{"term":"allure","prompt":"He kept the _____ on the desk.","choices":["allure","seafarer","seafaring","tavern"]},{"term":"animosity","prompt":"He felt deep _____ towards his former boss.","choices":["animosity","adore","arbitrary","dedicated"]},{"term":"astute","prompt":"He made an _____ move during the game.","choices":["astute","rationalism","corroborate","decry"]},{"term":"avid","prompt":"He is _____ for new books.","choices":["avid","insincere","intimidating","languish"]},{"term":"blandishment","prompt":"She ignored his _____ and kept working.","choices":["blandishment","answer back","ask out","blurt out"]},{"term":"choleric","prompt":"His _____ voice filled the room.","choices":["choleric","demolish","district","evict"]},{"term":"compel","prompt":"We cannot _____ people to change their minds.","choices":["compel","transcendental","vaudeville","canvas"]},{"term":"compulsive","prompt":"He had a _____ need to check the door.","choices":["compulsive","utilisation","utilise","utilization"]},{"term":"countenance","prompt":"A look of joy changed her facial _____.","choices":["countenance","make up","meet up","mull over"]},{"term":"covet","prompt":"She began to _____ her neighbor's garden.","choices":["covet","mumble","quibble","rave"]},{"term":"cynical","prompt":"The _____ man trusted no one.","choices":["cynical","waver","empathy","psychoanalysis"]},{"term":"daunt","prompt":"The huge mountain did not _____ the brave hikers.","choices":["daunt","conservationist","geothermal","bituminous"]},{"term":"deceit","prompt":"His smile hid the _____ behind his words.","choices":["deceit","barter","consolidate","diversify"]},{"term":"delude","prompt":"Do not _____ yourself into thinking it is easy.","choices":["delude","designate","aesthetic","aestheticism"]},{"term":"demeanour","prompt":"Her calm _____ helped the class relax.","choices":["demeanour","liven up","lock up","make up"]},{"term":"demonstrative","prompt":"He became more _____ after the good news.","choices":["demonstrative","egalitarianism","harassment","humanitarian"]},{"term":"demoralize","prompt":"Stress can _____ the whole team.","choices":["demoralize","aesthetics","functionary","ashlar"]},{"term":"depersonalization","prompt":"He felt _____ after the long illness.","choices":["depersonalization","barrage","catchment","cistern"]},{"term":"desensitize","prompt":"The training can _____ the patient to noise.","choices":["desensitize","postulate","rhetoric","seminal"]},{"term":"devious","prompt":"They stayed in a _____ village far away.","choices":["devious","implicate","instigate","pillage"]},{"term":"disillusion","prompt":"His _____ grew after many broken promises.","choices":["disillusion","come out","hit back","kick off"]},{"term":"dismay","prompt":"His silence showed _____ after the news.","choices":["dismay","myriad","paraphernalia","profusion"]},{"term":"dismissive","prompt":"His _____ reply hurt her feelings.","choices":["dismissive","equidistant","finite","meagre"]},{"term":"dissembler","prompt":"The _____ smiled while hiding his true plan.","choices":["dissembler","huffy","hypnotize","hysteria"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-psychology-lesson-40","title":"Bài 40","focus":"Nhận thức, cảm xúc, động lực và hành vi con người.","topicId":"psychology","topicTitle":"Tâm lý học","questions":[{"term":"dissociation","prompt":"Her _____ from the group was easy to see.","choices":["dissociation","skip","slip","bypass"]},{"term":"dogged","prompt":"Her _____ determination helped her win the race.","choices":["dogged","fossil fuels","global warming","greenery"]},{"term":"eccentric","prompt":"His _____ style surprised the class.","choices":["eccentric","chromatograph","chronometer","coalesce"]},{"term":"egocentric","prompt":"She seemed _____ during the meeting.","choices":["egocentric","conducive","paramount","pervasive"]},{"term":"embolden","prompt":"Kind words can _____ a young learner.","choices":["embolden","think up","throw out","throw up"]},{"term":"enliven","prompt":"A quick joke can _____ a boring meeting.","choices":["enliven","larder","occupancy","redevelopment"]},{"term":"erratic","prompt":"Her _____ mood changed from happy to angry.","choices":["erratic","elicit","emulate","monograph"]},{"term":"frenetically","prompt":"They worked _____ all day.","choices":["frenetically","propaganda","censorship","circular"]},{"term":"gaga","prompt":"My grandfather started to go _____ in his old age.","choices":["gaga","sound out","speak out","talk down"]},{"term":"gush","prompt":"He spoke with a _____ of sudden emotion.","choices":["gush","anthropology","antediluvian","hieroglyph"]},{"term":"harry","prompt":"Please _____ me less when I am working.","choices":["harry","allege","confide","denounce"]},{"term":"huffy","prompt":"She gave me a _____ look.","choices":["huffy","spatial","geothermal","bituminous"]},{"term":"hypnotize","prompt":"The doctor can _____ the patient.","choices":["hypnotize","jog","march","point"]},{"term":"hysteria","prompt":"The sudden _____ spread through the crowded room.","choices":["hysteria","mismanagement","niche","privatization"]},{"term":"idealize","prompt":"People often _____ childhood after they grow up.","choices":["idealize","scrape through","set up","stand out"]},{"term":"insidious","prompt":"Her _____ plan fooled everyone at first.","choices":["insidious","accumulative","affluent","entrepreneurial"]},{"term":"insincere","prompt":"Her _____ smile fooled nobody.","choices":["insincere","seafarer","seafaring","tavern"]},{"term":"intimidating","prompt":"The tall tower looked _____ in the fog.","choices":["intimidating","blight","cucurbit","domesticate"]},{"term":"languish","prompt":"The plant began to _____ without water.","choices":["languish","companion","dependant","guardian"]},{"term":"lascivious","prompt":"The film had a _____ tone.","choices":["lascivious","revise","status quo","archipelago"]},{"term":"manifest","prompt":"It was a _____ error in the report.","choices":["manifest","subordination","freelancer","networking"]},{"term":"melancholic","prompt":"The song had a _____ sound.","choices":["melancholic","cause","curse","fluctuate"]},{"term":"misapprehension","prompt":"There was a _____ about the meeting time.","choices":["misapprehension","commodity","gross domestic product","liquidity"]},{"term":"misgiving","prompt":"She felt a deep _____ about the plan.","choices":["misgiving","refraction","resonance","sextant"]},{"term":"nous","prompt":"She showed enough _____ to fix the issue.","choices":["nous","do away","end up","face up"]},{"term":"oblivious","prompt":"They were completely _____ of the danger nearby.","choices":["oblivious","lash out","cut back","make over"]},{"term":"obstinate","prompt":"The patient suffered from an _____ skin infection.","choices":["obstinate","detriment","dysentery","dysfunction"]},{"term":"phlegmatic","prompt":"After the rain, the grass was _____ and wet.","choices":["phlegmatic","antioxidant","hydration","rehabilitation"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-psychology-lesson-41","title":"Bài 41","focus":"Nhận thức, cảm xúc, động lực và hành vi con người.","topicId":"psychology","topicTitle":"Tâm lý học","questions":[{"term":"predispose","prompt":"They _____ the data carefully.","choices":["predispose","wreck","last","status quo"]},{"term":"prescience","prompt":"A _____ helped the team.","choices":["prescience","get over","get through","go down"]},{"term":"prodigy","prompt":"The infant _____ played the piano beautifully.","choices":["prodigy","erudite","inculcate","prerequisite"]},{"term":"provocative","prompt":"Her _____ question changed the talk.","choices":["provocative","wildfowl","sewage","scarcity"]},{"term":"psycho","prompt":"The film showed a _____ in the hallway.","choices":["psycho","speculator","subsidy","surplus"]},{"term":"psychometrics","prompt":"_____ helps measure mental skills fairly.","choices":["psychometrics","sainfoin","transnational","outsourcing"]},{"term":"rapport","prompt":"We need to build a good _____ with them.","choices":["rapport","private sector","prospects","public sector"]},{"term":"rapture","prompt":"He gazed at the beautiful sunset with _____.","choices":["rapture","skyline","skyscraper","surroundings"]},{"term":"reminiscence","prompt":"His style has a _____ of his father.","choices":["reminiscence","cartographic","contiguous","estuarine"]},{"term":"resilience","prompt":"Her _____ helped her recover after the setback.","choices":["resilience","prolific","prosaic","sublime"]},{"term":"resilient","prompt":"This _____ fabric bends but does not tear.","choices":["resilient","dialectical","explicit","logographic"]},{"term":"sanguine","prompt":"He remained _____ about his chances of winning.","choices":["sanguine","shoddy","sound","last"]},{"term":"seductive","prompt":"She gave him a _____ smile across the room.","choices":["seductive","extant","inhumane","meager"]},{"term":"solace","prompt":"She found _____ in listening to classical music.","choices":["solace","pay out","tide over","write off"]},{"term":"staid","prompt":"He gave a _____ answer and stayed calm.","choices":["staid","move out","move over","set out"]},{"term":"stoic","prompt":"He maintained a _____ silence even when receiving painful criticism.","choices":["stoic","stint","area","batch"]},{"term":"subliminal","prompt":"The ad used a _____ message.","choices":["subliminal","fall behind","get across","head off"]},{"term":"surly","prompt":"The _____ option was chosen.","choices":["surly","impatient","inertia","manners"]},{"term":"unhinge","prompt":"He managed to _____ the heavy door with effort.","choices":["unhinge","anecdotal","aphorism","articulate"]},{"term":"unprepossessing","prompt":"The house had an _____ front door.","choices":["unprepossessing","oscillation","paleontologist","polarization"]},{"term":"vagary","prompt":"His sudden _____ surprised everyone at dinner.","choices":["vagary","solarisation","solarization","fossilization"]},{"term":"voyeurism","prompt":"The film explores _____ in modern life.","choices":["voyeurism","regenerate","secrete","synaptic"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-psychology-lesson-42","title":"Bài 42","focus":"Nhận thức, cảm xúc, động lực và hành vi con người.","topicId":"psychology","topicTitle":"Tâm lý học","questions":[{"term":"waver","prompt":"The candle flame began to _____ in the wind.","choices":["waver","faunal","ferocious","flora"]},{"term":"empathy","prompt":"_____ helps health workers understand how patients experience pain.","choices":["empathy","enliven","erratic","frenetically"]},{"term":"psychoanalysis","prompt":"_____ explores how unconscious conflicts may shape behavior.","choices":["psychoanalysis","allergen","pharmacology","calorie"]},{"term":"conditioning","prompt":"Classical _____ can link a neutral sound with a learned response.","choices":["conditioning","nursing home","sick leave","side effect"]},{"term":"introspection","prompt":"_____ helped the participants explain their reactions to the task.","choices":["introspection","eternal","expire","instantaneous"]},{"term":"arousal","prompt":"The experiment measured _____ by tracking changes in heart rate.","choices":["arousal","fine art","lines","lyrics"]},{"term":"defense mechanism","prompt":"Denial can act as a _____ when people face distressing news.","choices":["defense mechanism","hitchhiker","jet lag","legroom"]},{"term":"psychometric","prompt":"A _____ test measured the applicants' reasoning skills.","choices":["psychometric","precursor","refraction","resonance"]},{"term":"hallucination","prompt":"The patient reported a _____ after several nights without sleep.","choices":["hallucination","slang","stumble","tip"]},{"term":"self-efficacy","prompt":"High _____ can help students persist after setbacks.","choices":["self-efficacy","cochlea","cortex","cuticle"]},{"term":"baffle","prompt":"Unclear feedback can _____ participants and distort their judgments about personal performance.","choices":["baffle","devolve","subvert","intimidate"]},{"term":"contemplate","prompt":"Participants were asked to _____ how social pressure influences their everyday decisions.","choices":["contemplate","prosaic","sublime","transcendental"]},{"term":"deliberate","prompt":"The researchers made a _____ effort to separate genuine preferences from social expectations.","choices":["deliberate","extracurricular","co-curricular","holistic"]},{"term":"dubious","prompt":"Because the sample was small, the apparent relationship between stress and memory remained _____.","choices":["dubious","deliberate","guesswork","ponder"]},{"term":"guesswork","prompt":"Without reliable evidence, identifying the cause of anxiety becomes largely _____.","choices":["guesswork","idealize","insidious","insincere"]},{"term":"ponder","prompt":"Participants were given time to _____ the emotional consequences of the proposed decision.","choices":["ponder","undervalue","utilise","utilize"]},{"term":"prejudiced","prompt":"_____ observers may interpret identical behaviours differently because of unconscious assumptions.","choices":["prejudiced","synapse","taxonomist","taxonomy"]},{"term":"presume","prompt":"Researchers should not _____ that silence indicates agreement in culturally diverse groups.","choices":["presume","abyssal","archipelago","cartographer"]},{"term":"query","prompt":"The study used a brief _____ to assess participants’ beliefs about personal control.","choices":["query","metabolism","musculature","osmosis"]},{"term":"ascribe","prompt":"Participants often _____ failure to external circumstances rather than to limited effort.","choices":["ascribe","worthless","absorbing","casual"]},{"term":"cause","prompt":"Identifying the _____ of anxiety can help researchers distinguish triggers from underlying vulnerabilities.","choices":["cause","demeanour","demonstrative","demoralize"]},{"term":"curse","prompt":"For some patients, chronic self-doubt becomes a _____ that reinforces avoidance.","choices":["curse","cellulose","chlorophyll","cochlea"]},{"term":"fluctuate","prompt":"Mood levels may _____ in response to sleep quality, social interaction, and perceived stress.","choices":["fluctuate","punctual","simultaneous","stint"]},{"term":"gamble","prompt":"Some individuals _____ with their wellbeing when immediate rewards outweigh perceived long-term risks.","choices":["gamble","spine","subtitles","tabloid"]},{"term":"haphazard","prompt":"_____ decision-making often reflects cognitive overload rather than stable personal preferences.","choices":["haphazard","son","successor","sympathise"]},{"term":"inadvertent","prompt":"An _____ comment may influence participants’ responses during a sensitive psychological interview.","choices":["inadvertent","utilitarian","designate","aesthetic"]},{"term":"jinxed","prompt":"Participants avoided the supposedly _____ button, even when researchers explained it was harmless.","choices":["jinxed","equidistant","finite","meagre"]},{"term":"lucky charm","prompt":"For some participants, a _____ reduced anxiety before challenging memory tests.","choices":["lucky charm","enzyme","alkaloid","assimilation"]},{"term":"mishap","prompt":"The minor _____ disrupted the experiment but did not affect participants’ final responses.","choices":["mishap","automatize","innovatory","electromechanical"]},{"term":"odds","prompt":"People often overestimate their _____ of success after recalling a few lucky outcomes.","choices":["odds","die out","do up","get into"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-psychology-lesson-43","title":"Bài 43","focus":"Nhận thức, cảm xúc, động lực và hành vi con người.","topicId":"psychology","topicTitle":"Tâm lý học","questions":[{"term":"pot luck","prompt":"Without a schedule, assigning tasks by _____ can create perceptions of unfairness.","choices":["pot luck","black out","break down","brighten up"]},{"term":"startle","prompt":"Sudden movements can _____ observers and temporarily disrupt their attention.","choices":["startle","cambium","carapace","carnivorous"]},{"term":"superstitious","prompt":"_____ beliefs may influence decisions even when people recognize their irrationality.","choices":["superstitious","adore","arbitrary","dedicated"]},{"term":"transpire","prompt":"What may _____ after the law takes effect remains uncertain to local researchers.","choices":["transpire","prop up","push around","put down"]},{"term":"agonise","prompt":"Researchers _____ over how social pressure shapes adolescents’ decisions and emotional responses.","choices":["agonise","mismanagement","niche","privatization"]},{"term":"apathy","prompt":"Persistent _____ can prevent patients from participating actively in their own recovery.","choices":["apathy","advocacy","autonomy","cohesion"]},{"term":"chuckle","prompt":"The participant gave a quiet _____ when recalling the experiment’s unexpected outcome.","choices":["chuckle","ashlar","atrium","buttress"]},{"term":"contentment","prompt":"_____ often increases when people develop realistic expectations about their daily lives.","choices":["contentment","dignitary","interloper","loggerhead"]},{"term":"dignity","prompt":"Maintaining _____ is essential when psychological treatment involves highly personal information.","choices":["dignity","flatter","illegible","mumble"]},{"term":"disgust","prompt":"Cruel treatment can _____ observers when suffering is publicly ignored.","choices":["disgust","corbel","edifice","facade"]},{"term":"disillusioned","prompt":"Many volunteers felt _____ after promised reforms failed to improve services.","choices":["disillusioned","mismanagement","niche","outperform"]},{"term":"fed up","prompt":"Residents became _____ with repeated delays in essential public transport services.","choices":["fed up","remunerative","repossession","scarce"]},{"term":"giggle","prompt":"Children may _____ when unfamiliar adults ask them direct questions.","choices":["giggle","dilute","grind","pat"]},{"term":"gloat","prompt":"Some individuals _____ over rivals’ failures because comparison strengthens their self-esteem.","choices":["gloat","kick off","let on","make out"]},{"term":"glum","prompt":"Participants appeared _____ after learning that the experiment had produced inconclusive results.","choices":["glum","alloy","corrosion","decanted"]},{"term":"grimace","prompt":"Patients often _____ when researchers ask them to recall distressing experiences.","choices":["grimace","vasomotor","vertebrate","lithosphere"]},{"term":"impatient","prompt":"_____ participants were more likely to abandon the task before completing it.","choices":["impatient","investible","recessional","recessionary"]},{"term":"inertia","prompt":"Psychological _____ can prevent people from adopting healthier daily routines.","choices":["inertia","subordination","freelancer","networking"]},{"term":"manners","prompt":"Children usually learn _____ by observing and imitating adults in their community.","choices":["manners","handbook","manifesto","pamphlet"]},{"term":"manoeuvre","prompt":"The negotiation _____ allowed the manager to reduce conflict without appearing weak.","choices":["manoeuvre","allergen","pharmacology","calorie"]},{"term":"moan","prompt":"Participants may _____ about difficult tasks when stress reduces their willingness to persist.","choices":["moan","wear out","wind down","ethicize"]},{"term":"mock","prompt":"Children may _____ unfamiliar accents when they have not learned cultural empathy.","choices":["mock","come across","come round","come up"]},{"term":"peep","prompt":"A brief _____ through the doorway revealed the child's anxious facial expression.","choices":["peep","mitigation","sanctuary","stewardship"]},{"term":"rejoice","prompt":"Families often _____ when long-term treatment produces measurable improvements in wellbeing.","choices":["rejoice","dictator","entitled","exempt"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-psychology-lesson-44","title":"Bài 44","focus":"Nhận thức, cảm xúc, động lực và hành vi con người.","topicId":"psychology","topicTitle":"Tâm lý học","questions":[{"term":"resent","prompt":"Employees may _____ constant monitoring because it suggests that managers distrust them.","choices":["resent","obfuscation","pictogram","pidgin"]},{"term":"resolute","prompt":"_____ patients are more likely to continue rehabilitation despite slow initial progress.","choices":["resolute","natural disaster","computation","automatize"]},{"term":"smirk","prompt":"Some participants _____ when recalling situations in which they outperformed their rivals.","choices":["smirk","frenetically","gaga","gush"]},{"term":"adore","prompt":"Young children may _____ familiar stories because repetition provides emotional security.","choices":["adore","katabatic","magnetite","stratification"]},{"term":"arbitrary","prompt":"Researchers found that _____ rewards reduced participants' trust in the decision-making process.","choices":["arbitrary","paramount","pervasive","profound"]},{"term":"dedicated","prompt":"_____ caregivers often recognize subtle emotional changes before formal assessments detect them.","choices":["dedicated","point","punch","refugee"]},{"term":"envy","prompt":"Social _____ can motivate people to compare their achievements with those of peers.","choices":["envy","size up","smarten up","snow under"]},{"term":"inclined","prompt":"Adolescents _____ toward risk-taking may underestimate long-term consequences during emotional decision-making.","choices":["inclined","foliage","herbivore","marsupial"]},{"term":"liking","prompt":"A child's _____ for predictable routines can reduce anxiety in unfamiliar environments.","choices":["liking","minimize","outperform","remunerative"]},{"term":"mediocre","prompt":"_____ academic performance does not necessarily indicate low ability or weak motivation.","choices":["mediocre","semantics","syntax","aphorism"]},{"term":"motive","prompt":"Identifying the _____ behind cooperation helps psychologists distinguish empathy from strategic behaviour.","choices":["motive","special needs","tutorial","contaminant"]},{"term":"obsessed","prompt":"People _____ with online approval may interpret neutral feedback as personal rejection.","choices":["obsessed","postulate","rebut","rhetoric"]},{"term":"optional","prompt":"Participation in the survey was _____, allowing participants to withdraw without explaining their decision.","choices":["optional","huffy","hypnotize","hysteria"]},{"term":"sacrifice","prompt":"Participants may _____ immediate comfort to pursue goals that offer greater long-term psychological benefits.","choices":["sacrifice","haphazard","inadvertent","jinxed"]},{"term":"strive","prompt":"Many learners _____ to regulate their emotions more effectively during stressful situations.","choices":["strive","adolescence","descendant","matriarch"]},{"term":"tempting","prompt":"The _____ promise of immediate rewards can weaken people’s motivation to pursue distant goals.","choices":["tempting","paraphernalia","profusion","pedagogic"]},{"term":"yearn","prompt":"Individuals who feel isolated may _____ for meaningful social connections and emotional support.","choices":["yearn","prop up","push around","put down"]},{"term":"close up","prompt":"They _____ the building after everyone has left.","choices":["close up","regeneration","salivation","symbiosis"]},{"term":"cut out","prompt":"Students can _____ relevant charts from the report for presentations.","choices":["cut out","cancel out","centre around","change around"]},{"term":"die out","prompt":"Local dialects may _____ when children stop learning them at home.","choices":["die out","put in","alleviate","invigorate"]},{"term":"do up","prompt":"You must _____ your safety belt in the back of cars and taxis now.","choices":["do up","crease up","creep up","crop up"]},{"term":"get into","prompt":"It took me ages to _____ driving on the left.","choices":["get into","forecourt","lintel","pediment"]},{"term":"hang out","prompt":"Many students _____ in the library after class to work together.","choices":["hang out","run down","seek out","set down"]},{"term":"heat up","prompt":"Researchers should _____ the sample gradually to avoid sudden structural changes.","choices":["heat up","take away","detain","defuse"]},{"term":"pile up","prompt":"Unanswered questionnaires can _____ when the research team lacks staff.","choices":["pile up","diversification","earmark","entrepreneurial"]},{"term":"take after","prompt":"The young researcher seems to _____ her mother, a marine biologist.","choices":["take after","provocative","psycho","psychometrics"]},{"term":"take in","prompt":"A tailor can _____ the jacket at the waist without changing its length.","choices":["take in","build up","carry over","catch on"]},{"term":"touch up","prompt":"Technicians may _____ scanned images to improve legibility before publication.","choices":["touch up","tip","prowess","spelunking"]},{"term":"use up","prompt":"Long experiments can _____ the laboratory's entire supply of distilled water.","choices":["use up","solace","staid","stoic"]},{"term":"walk out","prompt":"Several delegates threatened to _____ if the discussion excluded residents.","choices":["walk out","vulnerable","mental health","placebo"]},{"term":"while away","prompt":"Some participants _____ the waiting period by discussing their research.","choices":["while away","humanitarian","humanitarianism","meager"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-advanced-vocabulary-v1-education-lesson-1","title":"Bài 1","focus":"Trường học, chương trình, đánh giá, kỹ năng và cơ hội học tập.","topicId":"education","topicTitle":"Giáo dục","questions":[{"term":"pedagogic","prompt":"The _____ method used games and stories.","choices":["pedagogic","cucurbit","domesticate","horticulture"]},{"term":"pedagogical","prompt":"The teacher used a _____ approach.","choices":["pedagogical","creep","dash","emigrate"]},{"term":"pedagogy","prompt":"Good _____ helps students learn faster.","choices":["pedagogy","resilience","solace","vagary"]},{"term":"accredit","prompt":"They _____ this famous saying to an old poet.","choices":["accredit","polarize","resonate","reverberate"]},{"term":"erudite","prompt":"The _____ teacher answered every question clearly.","choices":["erudite","glum","impatient","resolute"]},{"term":"inculcate","prompt":"Teachers try to _____ good values in children.","choices":["inculcate","voyager","itinerary","carriage"]},{"term":"mnemonic","prompt":"This _____ helps me remember the planets.","choices":["mnemonic","pot luck","apathy","chuckle"]},{"term":"prerequisite","prompt":"The _____ option was chosen.","choices":["prerequisite","disgust","fed up","giggle"]},{"term":"prospectus","prompt":"A _____ helped the team.","choices":["prospectus","punctual","simultaneous","timely"]},{"term":"rubric","prompt":"Look under the _____ for homework rules.","choices":["rubric","semantic","anecdotal","articulate"]},{"term":"tutelage","prompt":"The child lived under his aunt's _____.","choices":["tutelage","come across","come round","come up"]},{"term":"academia","prompt":"_____ debated whether the findings could be replicated.","choices":["academia","hysteria","misapprehension","misgiving"]},{"term":"accreditation","prompt":"The college renewed its _____ after an external review.","choices":["accreditation","related","empathise","sympathise"]},{"term":"didactic","prompt":"The museum used _____ displays to explain the history of vaccination.","choices":["didactic","reservoir","scour","seep"]},{"term":"extracurricular","prompt":"_____ activities gave students more chances to practise teamwork.","choices":["extracurricular","rebut","rhetoric","dissertation"]},{"term":"co-curricular","prompt":"The school offers _____ activities that connect lessons with community projects.","choices":["co-curricular","snow under","spread out","stand up"]},{"term":"holistic","prompt":"A _____ approach considers patients' physical and emotional needs.","choices":["holistic","physiological","anthropomorphic","carnivorous"]},{"term":"conscientious","prompt":"_____ students document their sources carefully when preparing reports on environmental change.","choices":["conscientious","utilise","utilization","utilize"]},{"term":"distance learning","prompt":"_____ allows students in remote areas to access specialized academic courses.","choices":["distance learning","apotheosis","artisan","burlesque"]},{"term":"inattentive","prompt":"_____ readers may overlook qualifications that limit the study's conclusions.","choices":["inattentive","mumble","murmur","petition"]},{"term":"mock exam","prompt":"A _____ helps students identify weaknesses before formal assessment.","choices":["mock exam","meager","meliorate","entice"]},{"term":"self-study","prompt":"Regular _____ helps learners consolidate difficult concepts independently between scheduled classes.","choices":["self-study","prosaic","sublime","transcendental"]},{"term":"special needs","prompt":"Universities should provide accessible materials for students with _____.","choices":["special needs","tinnitus","trimester","mental health"]},{"term":"tutorial","prompt":"The laboratory _____ helped students interpret complex data from the experiment.","choices":["tutorial","elicit","emulate","ethnographic"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-language-lesson-28","title":"Bài 28","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"discourse","prompt":"Academic _____ relies on organized argumentation, precise terminology, and evidence-based interpretation.","choices":["discourse","seismology","albedo","caldera"]},{"term":"morphology","prompt":"In linguistics, _____ examines how words are formed from smaller units that carry grammatical or lexical meaning.","choices":["morphology","susceptible","virulent","vulnerable"]},{"term":"phonetic","prompt":"The _____ analysis revealed subtle differences in vowel production across the two regional dialects.","choices":["phonetic","outclass","redeeming feature","shambles"]},{"term":"phonetics","prompt":"Students used _____ to compare how airflow shapes consonant sounds in different languages.","choices":["phonetics","summon","board up","give in"]},{"term":"pragmatic","prompt":"_____ analysis explains how speakers use context to communicate meanings beyond the literal content of their words.","choices":["pragmatic","proficiency","maternity leave","severance"]},{"term":"semantic","prompt":"The _____ distinction between these terms becomes clearer when examined in context.","choices":["semantic","pathogen","prognosis","schizophrenia"]},{"term":"semantics","prompt":"_____ helps researchers explain how identical words acquire different meanings across social groups.","choices":["semantics","katabatic","terrestrial","celestial"]},{"term":"syntax","prompt":"The study found that unusual _____ made complex instructions harder for children to interpret.","choices":["syntax","ethicize","cosmopolitan","salacious"]},{"term":"anecdotal","prompt":"Her _____ note made the lesson lively.","choices":["anecdotal","polish","scrub","smash"]},{"term":"aphorism","prompt":"Her _____ was short but very wise.","choices":["aphorism","computation","filtration","stylus"]},{"term":"articulate","prompt":"She spoke in an _____ and clear voice.","choices":["articulate","mediocre","obsessed","optional"]},{"term":"colloquial","prompt":"Please use a _____ word in your speech.","choices":["colloquial","entrepreneurship","ergonomics","versatility"]},{"term":"dialectic","prompt":"The professor explained the _____ of history clearly.","choices":["dialectic","quibble","rant","rave"]},{"term":"dialectical","prompt":"Her _____ method was very clear.","choices":["dialectical","detrimental","exquisite","first-rate"]},{"term":"eloquently","prompt":"The team finished _____ and left.","choices":["eloquently","extraterrestrial","zenith","empirical"]},{"term":"explicit","prompt":"She was _____ about her plans for tomorrow.","choices":["explicit","black out","break down","brighten up"]},{"term":"haplology","prompt":"The teacher explained _____ with simple examples.","choices":["haplology","utilization","valuation","monopoly"]},{"term":"logogram","prompt":"The _____ played a key role.","choices":["logogram","holistic","conscientious","inattentive"]},{"term":"logographic","prompt":"His voice stayed _____ all night.","choices":["logographic","test out","think over","think through"]},{"term":"obfuscation","prompt":"The long report caused _____ and confusion.","choices":["obfuscation","arbitrary","dedicated","inclined"]},{"term":"pictogram","prompt":"The wall sign used a simple _____.","choices":["pictogram","mount up","pay out","tide over"]},{"term":"pidgin","prompt":"That is not my _____ to handle right now.","choices":["pidgin","oscillation","paleontologist","polarization"]},{"term":"plosive","prompt":"The _____ sound burst out clearly.","choices":["plosive","sewerage","sluice","submerge"]},{"term":"rebus","prompt":"We solved the _____ by matching each picture.","choices":["rebus","facade","forecourt","lintel"]},{"term":"reiteration","prompt":"The teacher's _____ made the lesson clear.","choices":["reiteration","nautical","transitory","derelict"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-language-lesson-29","title":"Bài 29","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"tacit","prompt":"They gave their _____ consent to the plan.","choices":["tacit","denigration","denizen","dignitary"]},{"term":"vernacular","prompt":"The guide explained the monument in the local _____.","choices":["vernacular","capitalise","capitalize","accrue"]},{"term":"allege","prompt":"Several participants _____ that social pressure influenced their responses during the experiment.","choices":["allege","gaga","gush","huffy"]},{"term":"ambiguous","prompt":"_____ instructions can cause participants to interpret the same task in different ways.","choices":["ambiguous","defuse","delinquency","implicate"]},{"term":"blunt","prompt":"Although _____, the researcher’s wording clearly identified weaknesses in the proposed explanation.","choices":["blunt","electorate","bully","consent"]},{"term":"boast","prompt":"The speaker's _____ about universal comprehension was challenged by evidence from multilingual classrooms.","choices":["boast","lucky charm","mishap","odds"]},{"term":"clarification","prompt":"The article includes a _____ of the term “register” used.","choices":["clarification","denounce","disclose","flatter"]},{"term":"confide","prompt":"Some learners _____ in teachers when unfamiliar grammatical patterns cause persistent anxiety.","choices":["confide","hypothermia","immunologist","incontinence"]},{"term":"denounce","prompt":"Several linguists _____ prescriptive rules that exclude speakers of regional varieties.","choices":["denounce","terrestrial","undulation","celestial"]},{"term":"disclose","prompt":"Researchers must _____ how interview data were collected before interpreting participants’ responses.","choices":["disclose","paper over","piece together","prop up"]},{"term":"flatter","prompt":"Such compliments may _____ respondents and encourage them to overestimate their language abilities.","choices":["flatter","psychometrics","rapport","rapture"]},{"term":"gist","prompt":"Although technical terms were unfamiliar, students understood the _____ of the lecture.","choices":["gist","diagnosable","pharmaceutical","epidemic"]},{"term":"illegible","prompt":"Several handwritten annotations were _____, preventing researchers from verifying the original interpretation.","choices":["illegible","surly","unprepossessing","psychometric"]},{"term":"mumble","prompt":"Participants began to _____ when the interviewer asked them to explain unfamiliar grammatical forms.","choices":["mumble","companion","dependant","guardian"]},{"term":"murmur","prompt":"A low _____ from the audience signalled uncertainty about the lecturer's interpretation.","choices":["murmur","area","batch","imbalance"]},{"term":"petition","prompt":"The _____ used carefully framed language to demand greater access to public education.","choices":["petition","resolute","smirk","adore"]},{"term":"placard","prompt":"Each _____ displayed a concise slogan, allowing researchers to analyse public political discourse.","choices":["placard","reptilian","fathom","seep"]},{"term":"quibble","prompt":"Researchers should not _____ over terminology when the underlying evidence is clear.","choices":["quibble","defective","detrimental","exquisite"]},{"term":"rant","prompt":"The editorial was a _____ rather than a reasoned analysis of language policy.","choices":["rant","stumble","stutter","tip"]},{"term":"rave","prompt":"Critics continued to _____ about the novel's innovative use of regional dialect.","choices":["rave","extraterrestrial","zenith","empirical"]},{"term":"slang","prompt":"The study examines how workplace _____ strengthens solidarity among members of specialised teams.","choices":["slang","meager","meliorate","entice"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-language-lesson-30","title":"Bài 30","focus":"Ngôn ngữ, khả năng đọc viết, phát âm, dịch thuật và giao tiếp.","topicId":"language","topicTitle":"Ngôn ngữ và giao tiếp","questions":[{"term":"stumble","prompt":"A brief _____ in speech can reveal difficulty retrieving a recently learned word.","choices":["stumble","geochemical","katabatic","terrestrial"]},{"term":"stutter","prompt":"A _____ may become more noticeable when speakers experience anxiety during formal interviews.","choices":["stutter","seismology","albedo","barometric"]},{"term":"tip","prompt":"The _____ of the tongue helps speakers produce certain consonants accurately.","choices":["tip","indigenous","reptilian","fathom"]},{"term":"answer back","prompt":"It is rude to _____ to parents.","choices":["answer back","lintel","pediment","prefabricated"]},{"term":"ask out","prompt":"In some cultures, people rarely _____ strangers directly.","choices":["ask out","egalitarianism","harassment","inhumane"]},{"term":"blurt out","prompt":"One participant may _____ an answer before considering the evidence.","choices":["blurt out","cuneiform","extant","hieroglyph"]},{"term":"bump into","prompt":"Researchers sometimes _____ unexpected obstacles during fieldwork.","choices":["bump into","rotten","rusty","satisfactory"]},{"term":"come out","prompt":"He decided to _____ to his parents.","choices":["come out","prescience","prodigy","provocative"]},{"term":"hit back","prompt":"The president _____ at her critics in a speech last night.","choices":["hit back","animosity","astute","avid"]},{"term":"kick off","prompt":"Residents may _____ if the council ignores their safety concerns.","choices":["kick off","ascend","clamber","clench"]},{"term":"let on","prompt":"I didn't mean to _____ about the party; I just said it without thinking.","choices":["let on","desensitize","embolden","enliven"]},{"term":"make out","prompt":"After several interviews, the analyst could not _____ the manager's intentions.","choices":["make out","polarize","resonate","reverberate"]},{"term":"pass on","prompt":"Please _____ the revised instructions to every field researcher.","choices":["pass on","languish","predispose","unhinge"]},{"term":"pick on","prompt":"My friends always _____ me because I don't sing well.","choices":["pick on","mineralisation","mineralization","conservationist"]},{"term":"read up","prompt":"Before collecting data, researchers should _____ on established interview methods.","choices":["read up","haplology","logogram","logographic"]},{"term":"shout down","prompt":"The moderator asked attendees not to _____ junior colleagues during the meeting.","choices":["shout down","facade","forecourt","lintel"]},{"term":"sound out","prompt":"Managers should _____ staff about the policy's likely effects before adopting it.","choices":["sound out","criminality","criminalization","culprit"]},{"term":"speak out","prompt":"People are afraid to _____ in oppressive political regimes.","choices":["speak out","cucurbit","horticulture","husbandry"]},{"term":"talk down","prompt":"The police tried to _____ the man.","choices":["talk down","oblivious","obstinate","phlegmatic"]},{"term":"talk over","prompt":"Researchers must _____ conflicting interpretations before finalising their qualitative analysis.","choices":["talk over","imbalance","meagre","minute"]},{"term":"talk round","prompt":"Some respondents _____ sensitive questions rather than answering them directly.","choices":["talk round","deterioration","dilapidated","larder"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-academic-methods-lesson-49","title":"Bài 49","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"empirical","prompt":"The authors supported their conclusions with _____ evidence from three controlled experiments.","choices":["empirical","lithosphere","oceanography","seismology"]},{"term":"empirically","prompt":"Researchers _____ tested whether soil moisture altered seed germination across three controlled field sites.","choices":["empirically","referendum","electorate","bully"]},{"term":"metaphysical","prompt":"The study avoids _____ claims that cannot be tested through observation or experiment.","choices":["metaphysical","geophysics","magnetite","stratification"]},{"term":"rationalism","prompt":"_____ treats reason as a primary source of knowledge, independent of sensory experience.","choices":["rationalism","utilise","utilize","damages"]},{"term":"analogous","prompt":"The two shapes are _____ in design.","choices":["analogous","egalitarianism","harassment","humanitarian"]},{"term":"corroborate","prompt":"Her notes _____ the report.","choices":["corroborate","manifest","melancholic","misapprehension"]},{"term":"decry","prompt":"Critics began to _____ the value of these goods.","choices":["decry","earmark","entrepreneurial","exploitation"]},{"term":"elicit","prompt":"How can we _____ an honest answer?","choices":["elicit","make over","mount up","pay out"]},{"term":"emulate","prompt":"Young players try to _____ a careful coach.","choices":["emulate","sustainability","taint","fossil fuel"]},{"term":"ethnographic","prompt":"The book offered an _____ view of the town.","choices":["ethnographic","empathise","guardian","stepmother"]},{"term":"exhaustive","prompt":"They conducted an _____ study on the topic.","choices":["exhaustive","metacognition","paradigm","epistemology"]},{"term":"monograph","prompt":"He wrote a _____ about old trees.","choices":["monograph","remunerative","scarce","solicit"]},{"term":"peruse","prompt":"She took some time to _____ the old book.","choices":["peruse","friction","opaque","smash"]},{"term":"postulate","prompt":"A good _____ is needed for the lesson.","choices":["postulate","periphery","plateau","cartography"]},{"term":"rebut","prompt":"The team had to _____ the system.","choices":["rebut","mortality","mycosis","neurophysiology"]},{"term":"rhetoric","prompt":"His _____ failed to convince the large crowd.","choices":["rhetoric","polarize","porous","rectilinear"]},{"term":"seminal","prompt":"That book had a _____ effect on me.","choices":["seminal","aesthetics","functionary","ashlar"]},{"term":"dissertation","prompt":"Her _____ examined how urban parks affect public health.","choices":["dissertation","jet lag","legroom","passerby"]},{"term":"peer review","prompt":"_____ helped the researchers identify weaknesses in the study.","choices":["peer review","eschew","inextricably","paramount"]},{"term":"metacognition","prompt":"_____ encourages learners to reflect on how they solve problems.","choices":["metacognition","metabolism","musculature","osmosis"]},{"term":"paradigm","prompt":"The discovery shifted the scientific _____ for disease prevention.","choices":["paradigm","elicit","emulate","ethnographic"]},{"term":"epistemology","prompt":"_____ asks what counts as reliable knowledge.","choices":["epistemology","emollient","invigorate","malnourished"]},{"term":"anachronism","prompt":"Applying modern clinical categories to ancient texts can create _____ in historical research.","choices":["anachronism","empirically","metaphysical","rationalism"]},{"term":"antique","prompt":"The archive contains _____ instruments that researchers now examine as historical evidence.","choices":["antique","giggle","gloat","grimace"]},{"term":"chronological","prompt":"The researchers arranged the interview transcripts in _____ order before analysing recurring themes.","choices":["chronological","pantomime","vaudeville","canvas"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-academic-methods-lesson-50","title":"Bài 50","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"elapse","prompt":"At least fifteen minutes must _____ before researchers record the participants' final responses.","choices":["elapse","espouse","allege","confide"]},{"term":"era","prompt":"The dataset illustrates how employment patterns changed during the digital _____.","choices":["era","talk down","talk over","talk round"]},{"term":"eternal","prompt":"The study rejects the assumption that social patterns remain _____ across different historical contexts.","choices":["eternal","conservationist","agriculturist","aquaculture"]},{"term":"expire","prompt":"Researchers verified whether permits would _____ before the longitudinal study concluded.","choices":["expire","tycoon","utilisation","utilization"]},{"term":"instantaneous","prompt":"The sensor recorded _____ changes in temperature during the controlled experiment.","choices":["instantaneous","underpin","vault","predator"]},{"term":"interim","prompt":"The committee published an _____ report while further survey data were being analysed.","choices":["interim","lyrics","recital","retrospective"]},{"term":"long-standing","prompt":"_____ community partnerships improved recruitment and strengthened confidence in the survey findings.","choices":["long-standing","diversification","diversify","earmark"]},{"term":"obsolete","prompt":"Researchers replaced _____ paper questionnaires with secure digital forms.","choices":["obsolete","phonetic","pragmatic","semantic"]},{"term":"punctual","prompt":"The team valued _____ submission of data from every participating laboratory.","choices":["punctual","mineralisation","mineralization","conservationist"]},{"term":"simultaneous","prompt":"_____ interviews across regions reduced the influence of seasonal differences.","choices":["simultaneous","logographic","plosive","tacit"]},{"term":"stint","prompt":"The researcher completed a two-year _____ collecting qualitative data in rural schools.","choices":["stint","earmark","exploitation","fluctuation"]},{"term":"timely","prompt":"_____ feedback enabled participants to correct inaccurate information before analysis.","choices":["timely","photosynthesis","photosynthesize","procreation"]},{"term":"area","prompt":"This _____ of research examines how sampling methods affect public opinion estimates.","choices":["area","reservoir","scour","sewerage"]},{"term":"batch","prompt":"Each _____ of samples was labelled before technicians began the laboratory analysis.","choices":["batch","grow on","mess up","patch up"]},{"term":"equidistant","prompt":"The sampling sites were _____, reducing the influence of travel time on participation rates.","choices":["equidistant","terracotta","turret","undergird"]},{"term":"finite","prompt":"Because the sample was _____, researchers surveyed every household rather than estimating from a subset.","choices":["finite","catch on","dive in","follow up"]},{"term":"imbalance","prompt":"A marked gender _____ in the sample could distort estimates of attitudes toward workplace policies.","choices":["imbalance","erudite","inculcate","prerequisite"]},{"term":"meagre","prompt":"The study drew cautious conclusions because its _____ dataset contained observations from only twelve participants.","choices":["meagre","cochlea","cortex","cuticle"]},{"term":"minute","prompt":"The researchers detected only _____ changes in the participants' responses across four sessions.","choices":["minute","entomology","fibril","hippocampus"]},{"term":"ration","prompt":"Researchers had to _____ field supplies when the survey extended beyond its planned schedule.","choices":["ration","versatile","versatility","civil service"]},{"term":"sum","prompt":"The _____ of the recorded responses matched the total calculated by the statistical software.","choices":["sum","solarization","fossilization","mineralisation"]},{"term":"uneven","prompt":"_____ participation across regions reduced the comparability of the survey's results.","choices":["uneven","entomologist","entomology","fibril"]},{"term":"better","prompt":"Using a larger sample produced _____ estimates of the population's average response.","choices":["better","cybersecurity","broadband","consumer electronics"]},{"term":"cheapen","prompt":"Reducing the sample size may _____ the study by weakening its statistical reliability.","choices":["cheapen","get in","get off","get over"]},{"term":"defective","prompt":"The researchers excluded _____ questionnaires because several items contained contradictory responses.","choices":["defective","yearn","close up","cut out"]},{"term":"detrimental","prompt":"Nonresponse bias can be _____ to the validity of survey conclusions.","choices":["detrimental","shrivel up","single out","size up"]},{"term":"exacerbate","prompt":"Poorly worded questions may _____ measurement error in a quantitative survey.","choices":["exacerbate","tedious","trivial","mediation"]},{"term":"exquisite","prompt":"The interview protocol required _____ sensitivity to participants' cultural and emotional cues.","choices":["exquisite","vagary","voyeurism","waver"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-academic-methods-lesson-51","title":"Bài 51","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"first-rate","prompt":"A _____ research design controls confounding variables without unnecessarily restricting participant diversity.","choices":["first-rate","subordination","freelancer","networking"]},{"term":"inadequate","prompt":"An _____ sample size can produce unstable estimates and misleading statistical conclusions.","choices":["inadequate","agony","antidote","inoculate"]},{"term":"outclass","prompt":"Randomized trials _____ observational studies when estimating the causal effects of an intervention.","choices":["outclass","carriage","charter","hiker"]},{"term":"redeeming feature","prompt":"The study's only _____ is its transparent description of participant recruitment.","choices":["redeeming feature","mycosis","neurophysiology","osteoporosis"]},{"term":"rotten","prompt":"The researchers excluded _____ data produced by a malfunctioning measurement device.","choices":["rotten","curse","fluctuate","gamble"]},{"term":"rusty","prompt":"Researchers with _____ statistical skills may misinterpret confidence intervals and report misleading conclusions.","choices":["rusty","analogous","corroborate","decry"]},{"term":"satisfactory","prompt":"The sample size was _____ for detecting the predicted difference between treatment groups.","choices":["satisfactory","cuneiform","extant","inhumane"]},{"term":"shambles","prompt":"After the laboratory move, the archived survey records were in _____.","choices":["shambles","privatization","procurement","repossession"]},{"term":"shoddy","prompt":"_____ sampling procedures can introduce systematic bias into otherwise careful quantitative research.","choices":["shoddy","brighten up","cool down","get down"]},{"term":"sound","prompt":"The authors used a _____ method to compare outcomes across demographic groups.","choices":["sound","deliberate","dubious","prejudiced"]},{"term":"worsen","prompt":"Poorly designed questions can _____ response bias in online surveys.","choices":["worsen","utilization","valuation","monopoly"]},{"term":"wreck","prompt":"The database was a _____ after repeated formatting errors corrupted its records.","choices":["wreck","compel","compulsive","covet"]},{"term":"add up","prompt":"She explained why the work wasn't ready, but her story doesn't _____.","choices":["add up","write off","deteriorate","commute"]},{"term":"blend in","prompt":"To avoid observer effects, researchers should _____ during fieldwork.","choices":["blend in","trailer","audition","bestseller"]},{"term":"break up","prompt":"Researchers may _____ the sample into age groups for comparison.","choices":["break up","edifice","facade","forecourt"]},{"term":"cancel out","prompt":"Opposing measurement errors may _____ when averaged across repeated trials.","choices":["cancel out","allure","animosity","astute"]},{"term":"centre around","prompt":"The interview schedule will _____ participants’ daily experiences.","choices":["centre around","tempting","anatomical","enzyme"]},{"term":"change around","prompt":"Researchers can _____ question order to test whether sequencing affects responses.","choices":["change around","quantum","brittle","crumb"]},{"term":"change into","prompt":"With preprocessing, qualitative responses can _____ comparable numerical categories.","choices":["change into","dogged","eccentric","egocentric"]},{"term":"check out","prompt":"Researchers should _____ unusual responses before excluding them.","choices":["check out","populated","skyline","skyscraper"]},{"term":"clock up","prompt":"The survey can _____ 3,000 valid responses within six weeks.","choices":["clock up","commodity","gross domestic product","liquidity"]},{"term":"club together","prompt":"Researchers _____ resources to analyse samples from remote communities.","choices":["club together","ghostwriter","handbook","manifesto"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-academic-methods-lesson-52","title":"Bài 52","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"cordon off","prompt":"Field teams _____ contaminated plots before collecting soil samples.","choices":["cordon off","stratification","stratosphere","terrestrial"]},{"term":"cotton on","prompt":"It took me ages to _____ to what they were planning.","choices":["cotton on","open up","paper over","piece together"]},{"term":"crack down","prompt":"Regulators _____ on laboratories that falsify experimental results.","choices":["crack down","inner city","populated","skyline"]},{"term":"crease up","prompt":"Several interview participants _____ when recalling the experiment's unexpected outcome.","choices":["crease up","special needs","tutorial","contaminant"]},{"term":"creep up","prompt":"Measurement errors can _____ when instruments are poorly calibrated.","choices":["creep up","kick off","let on","make out"]},{"term":"crop up","prompt":"Unexpected sampling problems may _____ during longitudinal fieldwork.","choices":["crop up","antidote","irritation","nursing home"]},{"term":"dig up","prompt":"Archaeologists may _____ preserved tools beneath the ancient settlement.","choices":["dig up","surly","unprepossessing","vagary"]},{"term":"do away","prompt":"Researchers should _____ with redundant survey items before analysing the final dataset.","choices":["do away","seep","sluice","submerge"]},{"term":"end up","prompt":"Without careful sampling, a quantitative study may _____ producing misleading estimates.","choices":["end up","cambium","carapace","carnivorous"]},{"term":"face up","prompt":"Researchers must _____ to missing data before interpreting relationships among variables.","choices":["face up","adolescence","descendant","matriarch"]},{"term":"fade away","prompt":"If follow-up measurements are delayed, treatment effects may _____ in the observed sample.","choices":["fade away","derelict","deterioration","dilapidated"]},{"term":"figure out","prompt":"The analysts used qualitative interviews to _____ why respondents abandoned the questionnaire.","choices":["figure out","pillage","prosecution","tribunal"]},{"term":"fix up","prompt":"The coordinator will _____ interviews with selected participants after screening the survey responses.","choices":["fix up","ascend","clamber","clench"]},{"term":"get in","prompt":"The team used reminders to _____ completed questionnaires from participants.","choices":["get in","lithosphere","oceanography","sedimentary"]},{"term":"get off","prompt":"Field researchers _____ at designated stations before walking to remote survey sites.","choices":["get off","let on","make out","pass on"]},{"term":"get over","prompt":"Researchers must _____ sampling bias before interpreting differences between the two survey groups.","choices":["get over","throw out","throw up","tip up"]},{"term":"get through","prompt":"The research team used weekly milestones to _____ the lengthy data-cleaning stage.","choices":["get through","antioxidant","hydration","rehabilitation"]},{"term":"go down","prompt":"The agreement could _____ in history as a turning point in regional policy.","choices":["go down","cochlea","cortex","costal"]},{"term":"go together","prompt":"Drinking and driving don't _____.","choices":["go together","infrasonic","isotope","luminance"]},{"term":"laze around","prompt":"Some participants may _____ instead of completing the observation protocol.","choices":["laze around","prosecute","comprise","identify with"]},{"term":"lie ahead","prompt":"The pilot study identified several challenges that _____ for the full investigation.","choices":["lie ahead","rehabilitation","allergen","pharmacology"]},{"term":"liven up","prompt":"Interactive tasks can _____ qualitative interviews and encourage participants to provide richer responses.","choices":["liven up","symbiosis","synapse","synaptic"]},{"term":"lock up","prompt":"Laboratory staff _____ biological samples in a temperature-controlled facility after each experiment.","choices":["lock up","wind down","ethicize","advocate"]},{"term":"make up","prompt":"The three subgroups _____ the study sample, although their sizes differ considerably.","choices":["make up","misapprehension","misgiving","nous"]},{"term":"meet up","prompt":"Field researchers _____ weekly to compare observations and resolve discrepancies in their notes.","choices":["meet up","intimidate","submit","summon"]},{"term":"mull over","prompt":"I need some time to _____ your interesting offer.","choices":["mull over","dementia","detriment","dysentery"]},{"term":"open up","prompt":"Researchers _____ interview transcripts to independent reviewers for thematic analysis.","choices":["open up","domesticate","propagate","espouse"]},{"term":"paper over","prompt":"The government tried to _____ the problems in the proposal, but the press were very critical.","choices":["paper over","rationalism","analogous","corroborate"]},{"term":"piece together","prompt":"Researchers _____ migration patterns from surveys, interviews, and archival records.","choices":["piece together","fossilise","fossilize","naturalise"]},{"term":"prop up","prompt":"Researchers should not _____ weak conclusions with selective evidence.","choices":["prop up","class","convict","prison reform"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-academic-methods-lesson-53","title":"Bài 53","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"push around","prompt":"Do not _____ participants during interviews or pressure them to answer.","choices":["push around","instigate","vindicate","hypothesise"]},{"term":"put down","prompt":"Fieldworkers _____ observations immediately to reduce inaccuracies in later analysis.","choices":["put down","corbel","edifice","facade"]},{"term":"put together","prompt":"The research team _____ a questionnaire covering demographic and behavioural variables.","choices":["put together","steward","apotheosis","artisan"]},{"term":"puzzle out","prompt":"Analysts _____ the causes of inconsistent results by comparing sampling procedures.","choices":["puzzle out","liquidity","leverage","debt"]},{"term":"run down","prompt":"Investigators will _____ every lead before concluding that records are missing.","choices":["run down","pictogram","pidgin","plosive"]},{"term":"seek out","prompt":"Researchers _____ diverse participants to improve the study's representativeness.","choices":["seek out","cambium","carapace","carnivorous"]},{"term":"set down","prompt":"Researchers _____ each observation immediately to reduce recall bias.","choices":["set down","simulation","cybersecurity","broadband"]},{"term":"shrivel up","prompt":"Under prolonged drought, plant samples can _____ before measurements are completed.","choices":["shrivel up","set out","slip away","slip up"]},{"term":"single out","prompt":"Many people applied for the job but we will _____ the best one.","choices":["single out","knock off","knuckle down","lay off"]},{"term":"size up","prompt":"Before partnering, the team should _____ each organisation's research capacity.","choices":["size up","ambiguous","blunt","boast"]},{"term":"smarten up","prompt":"Researchers should _____ their coding procedures before comparing qualitative results.","choices":["smarten up","didactic","extracurricular","co-curricular"]},{"term":"snow under","prompt":"Large surveys can _____ analysts when poorly designed databases generate thousands of incomplete responses.","choices":["snow under","transcendental","vaudeville","canvas"]},{"term":"spread out","prompt":"Researchers _____ sampling points across the region to reduce geographic bias.","choices":["spread out","move in","move on","move out"]},{"term":"stand up","prompt":"The proposed explanation must _____ to scrutiny from independent reviewers.","choices":["stand up","criminalization","culprit","delinquency"]},{"term":"stop off","prompt":"Field researchers _____ at rural clinics to collect additional survey responses.","choices":["stop off","defective","detrimental","exacerbate"]},{"term":"store up","prompt":"Researchers _____ raw measurements before conducting the final analysis.","choices":["store up","sack","brush up","build up"]},{"term":"swot up","prompt":"Before analysing the survey, researchers _____ on established qualitative methods.","choices":["swot up","fine art","lines","lyrics"]},{"term":"take apart","prompt":"The researchers _____ each variable to identify its influence on the outcome.","choices":["take apart","unwind","appease","codify"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-academic-methods-lesson-54","title":"Bài 54","focus":"Phương pháp nghiên cứu, bằng chứng, lập luận, đạo đức và tư duy triết học.","topicId":"academic-methods","topicTitle":"Nghiên cứu và tư duy phản biện","questions":[{"term":"take off","prompt":"The research project began to _____ after additional funding supported a larger sample.","choices":["take off","contiguous","demarcation","estuarine"]},{"term":"take out","prompt":"Analysts _____ incomplete responses before calculating the survey results.","choices":["take out","versatility","civil service","leave"]},{"term":"take over","prompt":"A senior statistician will _____ the analysis when the lead researcher leaves.","choices":["take over","didactic","extracurricular","co-curricular"]},{"term":"test out","prompt":"The team will _____ the questionnaire with a small pilot sample.","choices":["test out","astute","avid","blandishment"]},{"term":"think over","prompt":"Researchers should _____ the ethical implications before recruiting vulnerable participants.","choices":["think over","absorbing","casual","exhilarating"]},{"term":"think through","prompt":"The committee must _____ each consequence before approving the new protocol.","choices":["think through","phase out","put up","scrape through"]},{"term":"think up","prompt":"I'd better _____ a good reason for handing the work in late.","choices":["think up","remain","revise","status quo"]},{"term":"throw out","prompt":"Older generators _____ harmful fumes that can affect nearby residents.","choices":["throw out","pot luck","superstitious","apathy"]},{"term":"throw up","prompt":"The dry wind started to _____ a lot of dust.","choices":["throw up","efficacy","emollient","hypothermia"]},{"term":"tip up","prompt":"Technicians _____ the sample container to transfer its contents safely.","choices":["tip up","dyke","effluent","reservoir"]},{"term":"turn into","prompt":"The small caterpillar will _____ a butterfly.","choices":["turn into","slip","built-up","bypass"]},{"term":"water down","prompt":"Do not _____ the original plan now.","choices":["water down","dash","hop","jog"]},{"term":"weigh down","prompt":"Missing responses can _____ the reliability of quantitative conclusions.","choices":["weigh down","procurement","remunerative","repossession"]},{"term":"amend","prompt":"Philosophers may _____ an ethical theory when new evidence exposes weaknesses in its original principles.","choices":["amend","metabolic","metabolism","musculature"]},{"term":"last","prompt":"The _____ stage of the argument examines whether reason alone can justify moral obligations.","choices":["last","embolden","enliven","frenetically"]},{"term":"remain","prompt":"Despite criticism, the central principle may _____ defensible if its assumptions are made explicit.","choices":["remain","pay out","tide over","write off"]},{"term":"revise","prompt":"Researchers must _____ the argument when its conclusions depend on an unsupported assumption.","choices":["revise","maximize","minimize","outperform"]},{"term":"status quo","prompt":"Some philosophers challenge the _____ by questioning assumptions accepted as socially natural.","choices":["status quo","subordinate","competency","remuneration"]}],"chapterId":"education-language","chapterTitle":"Giáo dục & ngôn ngữ","chapterNumber":2},{"id":"ielts-advanced-vocabulary-v1-work-lesson-10","title":"Bài 10","focus":"Nghề nghiệp, kỹ năng, tuyển dụng, lương và môi trường làm việc.","topicId":"work","topicTitle":"Việc làm và nghề nghiệp","questions":[{"term":"careerist","prompt":"The _____ cared only about promotion.","choices":["careerist","obstinate","phlegmatic","predispose"]},{"term":"laborious","prompt":"She was _____ and finished the task early.","choices":["laborious","pervasive","profound","pedagogy"]},{"term":"entrepreneurship","prompt":"She studied _____ at the local college.","choices":["entrepreneurship","amend","last","remain"]},{"term":"ergonomics","prompt":"_____ helps workers stay comfortable at their desks.","choices":["ergonomics","investible","recessional","recessionary"]},{"term":"industrious","prompt":"She is an _____ student.","choices":["industrious","polarization","polarize","polygraph"]},{"term":"versatile","prompt":"He is a _____ actor in many roles.","choices":["versatile","zoology","conifer","fauna"]},{"term":"versatility","prompt":"The _____ played a key role.","choices":["versatility","aviation","congestion","propulsion"]},{"term":"civil service","prompt":"A career in the _____ often offers stable employment but limited salary flexibility.","choices":["civil service","staid","stoic","subliminal"]},{"term":"headhunt","prompt":"International firms often _____ engineers with rare expertise in renewable-energy systems.","choices":["headhunt","pillage","prosecution","tribunal"]},{"term":"leave","prompt":"Employees must request _____ several weeks before undertaking extended overseas travel.","choices":["leave","appease","codify","devolve"]},{"term":"private sector","prompt":"The _____ provides many technology jobs, although employment conditions vary considerably.","choices":["private sector","anatomical","physiological","anthropomorphic"]},{"term":"prospects","prompt":"Further training can improve graduates' _____ in an increasingly competitive labour market.","choices":["prospects","rebut","seminal","antique"]},{"term":"public sector","prompt":"Many graduates seek _____ employment because it offers stable careers and structured promotion.","choices":["public sector","fauna","flora","foliage"]},{"term":"sack","prompt":"The company may _____ employees who repeatedly ignore essential safety procedures.","choices":["sack","deceit","demeanour","demonstrative"]},{"term":"brush up","prompt":"She took a two-week course to _____ her Spanish before she went travelling around South and Central America.","choices":["brush up","vertebrate","lithosphere","oceanography"]},{"term":"build up","prompt":"Regular exercise can _____ muscle strength in older adults.","choices":["build up","murmur","petition","placard"]},{"term":"carry over","prompt":"Unresolved disagreements can _____ into later meetings and slow cooperation.","choices":["carry over","footnote","ghostwriter","handbook"]},{"term":"catch on","prompt":"Everyone else realised what was happening, but it took Henry ages to _____.","choices":["catch on","taxonomist","taxonomy","unviable"]},{"term":"dive in","prompt":"The researchers chose to _____ and test the method immediately.","choices":["dive in","opt out","take away","detain"]},{"term":"follow up","prompt":"The clinic will _____ each participant to monitor their recovery.","choices":["follow up","bivalve","conifer","endemic"]},{"term":"hold back","prompt":"Limited transport can _____ students from remote communities.","choices":["hold back","blurt out","bump into","come out"]},{"term":"keep up","prompt":"Workers must _____ with technological changes to remain competitive in modern industries.","choices":["keep up","recessional","recessionary","bankable"]},{"term":"knock off","prompt":"The editor can _____ a short summary before the review meeting.","choices":["knock off","gamble","startle","transpire"]},{"term":"knuckle down","prompt":"I've got my exams next week and I haven't done much work, so I'd better _____.","choices":["knuckle down","anthropomorphic","assimilation","cambium"]},{"term":"lay off","prompt":"The company may _____ temporary staff if demand continues to fall.","choices":["lay off","resent","smirk","adore"]},{"term":"phase out","prompt":"The university plans to _____ outdated equipment over the next three years.","choices":["phase out","productible","capitalization","accumulative"]},{"term":"put up","prompt":"They _____ a great fight but lost.","choices":["put up","cellulose","cerebral","chlorophyll"]},{"term":"scrape through","prompt":"Despite limited preparation, she managed to _____ the final examination.","choices":["scrape through","do up","get into","hang out"]},{"term":"set up","prompt":"Several engineers _____ a renewable-energy company after identifying a gap in the market.","choices":["set up","cartographer","cartographic","contiguous"]},{"term":"stand out","prompt":"Among dozens of applications, his research proposal managed to _____.","choices":["stand out","scarcity","purification","barrage"]},{"term":"step aside","prompt":"Everyone thinks that the prime minister should _____ so that someone new can lead the party into the election.","choices":["step aside","face up","fade away","figure out"]},{"term":"take down","prompt":"The interviewer asked an assistant to _____ every response accurately.","choices":["take down","kill off","opt out","take away"]},{"term":"take on","prompt":"The expanding laboratory plans to _____ five research assistants next year.","choices":["take on","ration","cheapen","exacerbate"]}],"chapterId":"work-economy","chapterTitle":"Công việc & kinh tế","chapterNumber":3},{"id":"ielts-advanced-vocabulary-v1-economy-lesson-11","title":"Bài 11","focus":"Thị trường, tài chính, thu nhập, thuế, đầu tư và tăng trưởng.","topicId":"economy","topicTitle":"Kinh tế và tài chính","questions":[{"term":"economisation","prompt":"The new plan led to better _____ at home.","choices":["economisation","ashlar","atrium","buttress"]},{"term":"economization","prompt":"The report praised the _____ of office supplies.","choices":["economization","single out","size up","smarten up"]},{"term":"investable","prompt":"This plan is _____ for long-term growth.","choices":["investable","transcendental","prerecorded","worthless"]},{"term":"investible","prompt":"This small amount is _____ for a new project.","choices":["investible","break up","cancel out","centre around"]},{"term":"recessional","prompt":"The _____ hymn ended the ceremony.","choices":["recessional","meander","oxbow","periphery"]},{"term":"recessionary","prompt":"The country faces many _____ pressures this year.","choices":["recessionary","tutorial","contaminant","erosion"]},{"term":"bankable","prompt":"Her clear record made her _____.","choices":["bankable","degenerative","dimorphic","hereditary"]},{"term":"productible","prompt":"The new toy is _____ in one day.","choices":["productible","die out","do up","get into"]},{"term":"capitalise","prompt":"They _____ the savings to start the shop.","choices":["capitalise","let on","make out","pass on"]},{"term":"capitalization","prompt":"Check the _____ of each heading.","choices":["capitalization","scrub","squash","albeit"]},{"term":"capitalize","prompt":"They will _____ the new company.","choices":["capitalize","ecocide","exuberance","infiltration"]},{"term":"accrue","prompt":"Late charges _____ if you miss the deadline.","choices":["accrue","self-efficacy","deliberate","dubious"]},{"term":"accumulative","prompt":"The report provides _____ evidence of the crime.","choices":["accumulative","barter","consolidate","consortium"]},{"term":"affluent","prompt":"The region has _____ rivers and rich soil.","choices":["affluent","devious","dismissive","dogged"]},{"term":"allocate","prompt":"The school will _____ a room for art.","choices":["allocate","diagnosable","treatise","pharmaceutical"]},{"term":"appraisal","prompt":"The _____ gave the house a higher value.","choices":["appraisal","emollient","invigorate","malnourished"]},{"term":"appraise","prompt":"They _____ old books at the shop.","choices":["appraise","moan","mock","rejoice"]},{"term":"barter","prompt":"We can _____ our old goods for food.","choices":["barter","transnational","manufacturable","outsourcing"]},{"term":"consolidate","prompt":"The government wants to _____ the new roads.","choices":["consolidate","long-standing","obsolete","punctual"]},{"term":"consortium","prompt":"The scientist studied a _____ of helpful bacteria.","choices":["consortium","sympathise","laborious","industrious"]},{"term":"diversification","prompt":"The company grew through _____ of its products.","choices":["diversification","islet","hinterland","estuary"]},{"term":"diversify","prompt":"We should _____ the class reading list.","choices":["diversify","area","batch","equidistant"]},{"term":"earmark","prompt":"The sheep had a red _____.","choices":["earmark","mediocre","obsessed","optional"]},{"term":"entrepreneurial","prompt":"Her _____ thinking built a small shop.","choices":["entrepreneurial","mineralization","conservationist","agriculturist"]},{"term":"exploitation","prompt":"The land showed signs of careful _____.","choices":["exploitation","fluctuate","gamble","haphazard"]}],"chapterId":"work-economy","chapterTitle":"Công việc & kinh tế","chapterNumber":3},{"id":"ielts-advanced-vocabulary-v1-economy-lesson-12","title":"Bài 12","focus":"Thị trường, tài chính, thu nhập, thuế, đầu tư và tăng trưởng.","topicId":"economy","topicTitle":"Kinh tế và tài chính","questions":[{"term":"fluctuation","prompt":"Prices showed a small _____ this week.","choices":["fluctuation","infiltration","mitigation","sanctuary"]},{"term":"intangible","prompt":"Her fear felt _____ and hard to name.","choices":["intangible","emulate","monograph","peruse"]},{"term":"liability","prompt":"The company faces a huge _____ for the accident.","choices":["liability","profound","pedagogy","mnemonic"]},{"term":"liquidation","prompt":"The company is facing a total _____.","choices":["liquidation","inextricably","paramount","pervasive"]},{"term":"maximize","prompt":"We should _____ our time before the test.","choices":["maximize","tout","politic","democratization"]},{"term":"minimize","prompt":"We should _____ waste at home.","choices":["minimize","seep","sluice","submerge"]},{"term":"mismanagement","prompt":"Poor planning led to _____.","choices":["mismanagement","empathise","sympathise","laborious"]},{"term":"niche","pr