asal-verbs-v1":["phrasal-verbs-v1-lesson-058"]}},{"term":"sneak up on","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-058"]}},{"term":"sniff","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-biology-reading-lesson-7"]}},{"term":"sniff around","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-031"]}},{"term":"sniff at","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-081"]}},{"term":"sniff out","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-097"]}},{"term":"snitch on","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-046"]}},{"term":"snore","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-health-reading-lesson-8"]}},{"term":"snow","courseIds":["basic-vocabulary-a1-a2-v1"],"lessonIdsByCourse":{"basic-vocabulary-a1-a2-v1":["basic-vocabulary-a1-a2-v1-time-seasons-lesson-3"]}},{"term":"snow under","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-academic-methods-lesson-53"]},"senses":[{"definition":"làm cho ai đó quá tải vì có quá nhiều công việc hoặc dữ liệu cần xử lý","example":"Large surveys can snow under analysts when poorly designed databases generate thousands of incomplete responses.","pos":"V","subPos":null}]},{"term":"Snowed under","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-063"]}},{"term":"snuff","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-37"]}},{"term":"snuff out","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-087"]}},{"term":"so ... that","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["sentence-structure-patterns-v1-condition-result"]},"senses":[{"definition":"Cấu trúc chỉ mức độ dẫn đến kết quả: so + tính từ/trạng từ + that + mệnh đề. Khác such … that, vốn thường đi với cụm danh từ.","example":"The archive was so vast that the researchers needed several weeks to catalogue its contents.","pos":null,"subPos":null}]},{"term":"so do I","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["sentence-structure-patterns-v1-reduction-substitution"]},"senses":[{"definition":"Dùng So + trợ động từ + chủ ngữ để đồng tình với câu khẳng định. Lấy trợ động từ phù hợp với động từ và thì của câu trước; ở đây do thay cho enjoy reading. Trật tự là trợ động từ rồi đến chủ ngữ.","example":"“I enjoy reading historical biographies.” “So do I,” Minh replied.","pos":null,"subPos":null}]},{"term":"So far so good","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-063"]}},{"term":"so that","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-meaning"]},"senses":[{"definition":"Để, để cho; thường nêu mục đích và thông dụng hơn in order that. Tùy ngữ cảnh, cụm này cũng có thể nêu kết quả. Ghi chú: Gần nghĩa với in order that khi nêu mục đích nhưng thông dụng hơn. So that cũng có thể nêu kết quả tùy ngữ cảnh; in order that thường trang trọng và thiên về mục đích hơn.","example":"Nora labeled every jar so that nobody would confuse the spices.","pos":"conj","subPos":"subordinating"}]},{"term":"soak","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-37"]}},{"term":"soap","courseIds":["basic-vocabulary-a1-a2-v1","ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"basic-vocabulary-a1-a2-v1":["basic-voc