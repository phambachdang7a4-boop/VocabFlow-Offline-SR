","choices":["title slide","after previous","with previous","slideshow"]},{"term":"slide section","prompt":"Add a title slide, create a _____, and fill a content placeholder.","choices":["slide section","slide","slide deck","slide layout"]},{"term":"content placeholder","prompt":"Add a title slide, create a slide section, and fill a _____.","choices":["content placeholder","slide transition","animation","entrance effect"]},{"term":"text box","prompt":"Insert a _____ and shape, then arrange each slide object.","choices":["text box","compress pictures","slide transition","animation"]},{"term":"shape","prompt":"Insert a text box and _____, then arrange each slide object.","choices":["shape","rehearse timings","record narration","closed captions"]},{"term":"slide object","prompt":"Insert a text box and shape, then arrange each _____.","choices":["slide object","group objects","ungroup objects","align objects"]}]},{"id":"office-apps-vocabulary-v1-powerpoint-lesson-2","title":"Microsoft PowerPoint · Bài 2","focus":"Từ vựng tạo trang chiếu, trình bày, hoạt ảnh và xuất bài thuyết trình.","topicId":"powerpoint","topicTitle":"Microsoft PowerPoint","questions":[{"term":"picture","prompt":"Insert a _____, presentation chart, and slide table.","choices":["picture","hide slide","kiosk mode","loop continuously"]},{"term":"presentation chart","prompt":"Insert a picture, _____, and slide table.","choices":["presentation chart","embed audio","slide hyperlink","export as video"]},{"term":"slide table","prompt":"Insert a picture, presentation chart, and _____.","choices":["slide table","presentation template","title slide","slide section"]},{"term":"SmartArt graphic","prompt":"Add a _____, write speaker notes, and print the notes page.","choices":["SmartArt graphic","slide theme","presentation template","title slide"]},{"term":"speaker notes","prompt":"Add a SmartArt graphic, write _____, and print the notes page.","choices":["speaker notes","motion path","animation timing","duration"]},{"term":"notes page","prompt":"Add a SmartArt graphic, write speaker notes, and print the _____.","choices":["notes page","slide size","widescreen format","duplicate slide"]},{"term":"slide master","prompt":"Use the _____ to edit a master layout and set theme colors.","choices":["slide master","entrance effect","exit effect","emphasis effect"]},{"term":"master layout","prompt":"Use the slide master to edit a _____ and set theme colors.","choices":["master layout","widescreen format","duplicate slide","slide order"]},{"term":"theme colors","prompt":"Use the slide master to edit a master layout and set _____.","choices":["theme colors","exit effect","emphasis effect","motion path"]},{"term":"slide size","prompt":"Choose widescreen format for the _____, then choose Duplicate Slide.","choices":["slide size","handout","outline view","reading view"]},{"term":"widescreen format","prompt":"Choose _____ for the slide size, then choose Duplicate Slide.","choices":["widescreen format","notes page","slide master","master layout"]},{"term":"duplicate slide","prompt":"Choose widescreen format for the slide size, then choose _____.","choices":["duplicate slide","group objects","ungroup objects","align objects"]}]},{"id":"office-apps-vocabulary-v1-powerpoint-lesson-3","title":"Microsoft PowerPoint · Bài 3","focus":"Từ vựng tạo trang chiếu, trình bày, hoạt ảnh và xuất bài thuyết trình.","topicId":"powerpoint","topicTitle":"Microsoft PowerPoint","questions":[{"term":"slide order","prompt":"Change the _____, group objects, and ungroup objects to edit them.","choices":["slide order","exit effect","emphasis effect","motion path"]},{"term":"group objects","prompt":"Change the slide order, _____, and ungroup objects to edit them.","choices":["group objects","record narration","closed captions","handout"]},{"term":"ungroup objects","prompt":"Change the slide order, group objects, and _____ to edit them.","choices":["ungroup objects","slide deck","slide layout","slide theme"]},{"term":"align objects","prompt":"_____, distribute objects evenly, and crop the picture.","choices":["align objects","notes page","slide master","master layout"]},{"term":"distribute objects","prompt":"Align objects, _____ evenly, and crop the picture.","choices":["distribute objects","handout","outline view","reading view"]},{"term":"crop","prompt":"Align objects, distribute objects evenly, and _____ the picture.","choices":["crop","slide size","widescreen format","duplicate slide"]},{"term":"compress pictures","prompt":"_____, add a slide transition, and apply an animation.","choices":["compress pictures","delay","trigger","start on click"]},{"term":"slide transition","prompt":"Compress pictures, add a _____, and apply an animation.","choices":["slide transition","after previous","with previous","slideshow"]},{"term":"animation","prompt":"Compress pictures, add a slide transition, and apply an _____.","choices":["animation","hide slide","kiosk mode","loop continuously"]},{"term":"entrance effect","prompt":"Use an _____, an emphasis effect, and an exit effect.","choices":["entrance effect","kiosk mode","loop continuously","embed video"]},{"term":"exit effect","prompt":"Use an entrance effect, an emphasis effect, and an _____.","choices":["exit effect","outline view","reading view","hide slide"]},{"term":"emphasis effect","prompt":"Use an entrance effect, an _____, and an exit effect.","choices":["emphasis effect","trigger","start on click","after previous"]}]},{"id":"office-apps-vocabulary-v1-powerpoint-lesson-4","title":"Microsoft PowerPoint · Bài 4","focus":"Từ vựng tạo trang chiếu, trình bày, hoạt ảnh và xuất bài thuyết trình.","topicId":"powerpoint","topicTitle":"Microsoft PowerPoint","questions":[{"term":"motion path","prompt":"Set animation timing and duration for a shape's _____.","choices":["motion path","theme colors","slide size","widescreen format"]},{"term":"animation timing","prompt":"Set _____ and duration for a shape's motion path.","choices":["animation timing","slide order","group objects","ungroup objects"]},{"term":"duration","prompt":"Set animation timing and _____ for a shape's motion path.","choices":["duration","loop continuously","embed video","embed audio"]},{"term":"delay","prompt":"Set a _____, choose a trigger, and start on click.","choices":["delay","slide section","content placeholder","text box"]},{"term":"trigger","prompt":"Set a delay, choose a _____, and start on click.","choices":["trigger","theme colors","slide size","widescreen format"]},{"term":"start on click","prompt":"Set a delay, choose a trigger, and _____.","choices":["start on click","export as PDF","presentation","slide"]},{"term":"after previous","prompt":"Play the next effect _____ or with previous during the slideshow.","choices":["after previous","embed video","embed audio","slide hyperlink"]},{"term":"with previous","prompt":"Play the next effect after previous or _____ during the slideshow.","choices":["with previous","slide master","master layout","theme colors"]},{"term":"slideshow","prompt":"Play the next effect after previous or with previous during the _____.","choices":["slideshow","record narration","closed captions","handout"]},{"term":"presenter view","prompt":"Open _____, rehearse timings, and record narration.","choices":["presenter view","trigger","start on click","after previous"]},{"term":"rehearse timings","prompt":"Open presenter view, _____, and record narration.","choices":["rehearse timings","loop continuously","embed video","embed audio"]},{"term":"record narration","prompt":"Open presenter view, rehearse timings, and _____.","choices":["record narration","handout","outline view","reading view"]}]},{"id":"office-apps-vocabulary-v1-powerpoint-lesson-5","title":"Microsoft PowerPoint · Bài 5","focus":"Từ vựng tạo trang chiếu, trình bày, hoạt ảnh và xuất bài thuyết trình.","topicId":"powerpoint","topicTitle":"Microsoft PowerPoint","questions":[{"term":"closed captions","prompt":"Add _____, print a handout, and review outline view.","choices":["closed captions","entrance effect","exit effect","emphasis effect"]},{"term":"handout","prompt":"Add closed captions, print a _____, and review outline view.","choices":["handout","reading view","hide slide","kiosk mode"]},{"term":"outline view","prompt":"Add closed captions, print a handout, and review _____.","choices":["outline view","presentation template","title slide","slide section"]},{"term":"reading view","prompt":"Use _____, choose Hide Slide, or switch to kiosk mode.","choices":["reading view","closed captions","handout","outline view"]},{"term":"hide slide","prompt":"Use reading view, choose _____, or switch to kiosk mode.","choices":["hide slide","shape","slide object","picture"]},{"term":"kiosk mode","prompt":"Use reading view, choose Hide Slide, or switch to _____.","choices":["kiosk mode","slide","slide deck","slide layout"]},{"term":"loop continuously","prompt":"Embed video and embed audio, then set the slideshow to _____.","choices":["loop continuously","handout","outline view","reading view"]},{"term":"embed video","prompt":"_____ and embed audio, then set the slideshow to loop continuously.","choices":["embed video","rehearse timings","record narration","closed captions"]},{"term":"embed audio","prompt":"Embed video and _____, then set the slideshow to loop continuously.","choices":["embed audio","picture","presentation chart","slide table"]},{"term":"slide hyperlink","prompt":"Add a _____, export as video, or export as PDF.","choices":["slide hyperlink","with previous","slideshow","presenter view"]},{"term":"export as video","prompt":"Add a slide hyperlink, _____, or export as PDF.","choices":["export as video","slide size","widescreen format","duplicate slide"]},{"term":"export as PDF","prompt":"Add a slide hyperlink, export as video, or _____.","choices":["export as PDF","shape","slide object","picture"]}]}],"entriesByTerm":{"spreadsheet":{"definition":"bảng tính điện tử để sắp xếp và tính toán dữ liệu","example":"Create a workbook, add a worksheet, and organize figures in a spreadsheet.","exampleTranslation":"Tạo một sổ làm việc, thêm một trang tính và sắp xếp số liệu trong bảng tính.","partOfSpeech":"Danh từ"},"workbook":{"definition":"tệp Excel có thể chứa nhiều trang tính","example":"Create a workbook, add a worksheet, and organize figures in a spreadsheet.","exampleTranslation":"Tạo một sổ làm việc, thêm một trang tính và sắp xếp số liệu trong bảng tính.","partOfSpeech":"Danh từ"},"worksheet":{"definition":"trang tính gồm các hàng và cột trong một workbook","example":"Create a workbook, add a worksheet, and organize figures in a spreadsheet.","exampleTranslation":"Tạo một sổ làm việc, thêm một trang tính và sắp xếp số liệu trong bảng tính.","partOfSpeech":"Danh từ"},"active cell":{"definition":"ô đang được chọn để nhập hoặc sửa dữ liệu","example":"Select the active cell, check its cell reference, and highlight the cell range.","exampleTranslation":"Chọn ô hiện hoạt, kiểm tra địa chỉ ô và bôi chọn vùng ô.","partOfSpeech":"Cụm danh từ"},"cell reference":{"definition":"địa chỉ xác định vị trí của một ô, như B2","example":"Select the active cell, check its cell reference, and highlight the cell range.","exampleTranslation":"Chọn ô hiện hoạt, kiểm tra địa chỉ ô và bôi chọn vùng ô.","partOfSpeech":"Cụm danh từ"},"cell range":{"definition":"vùng gồm một hoặc nhiều ô được chọn","example":"Select the active cell, check its cell reference, and highlight the cell range.","exampleTranslation":"Chọn ô hiện hoạt, kiểm tra địa chỉ ô và bôi chọn vùng ô.","partOfSpeech":"Cụm danh từ"},"row":{"definition":"hàng ô chạy ngang trong trang tính","example":"Insert a row, adjust a column, and rename the sheet tab.","exampleTranslation":"Chèn một hàng, chỉnh độ rộng cột và đổi tên thẻ trang tính.","partOfSpeech":"Danh từ"},"column":{"definition":"cột ô chạy dọc trong trang tính","example":"Insert a row, adjust a column, and rename the sheet tab.","exampleTranslation":"Chèn một hàng, chỉnh độ rộng cột và đổi tên thẻ trang tính.","partOfSpeech":"Danh từ"},"sheet tab":{"definition":"thẻ ở cuối cửa sổ dùng để chuyển trang tính","example":"Insert a row, adjust a column, and rename the sheet tab.","exampleTranslation":"Chèn một hàng, chỉnh độ rộng cột và đổi tên thẻ trang tính.","partOfSpeech":"Cụm danh từ"},"ribbon":{"definition":"dải lệnh chứa các thẻ và công cụ của Excel","example":"Use the ribbon to open the formula bar, then type B2 in the name box.","exampleTranslation":"Dùng dải lệnh để mở thanh công thức, rồi nhập B2 vào hộp tên.","partOfSpeech":"Danh từ"},"formula bar":{"definition":"thanh hiển thị hoặc chỉnh nội dung của ô đang chọn","example":"Use the ribbon to open the formula bar, then type B2 in the name box.","exampleTranslation":"Dùng dải lệnh để mở thanh công thức, rồi nhập B2 vào hộp tên.","partOfSpeech":"Cụm danh từ"},"name box":{"definition":"hộp hiển thị địa chỉ ô hoặc tên vùng đang chọn","example":"Use the ribbon to open the formula bar, then type B2 in the name box.","exampleTranslation":"Dùng dải lệnh để mở thanh công thức, rồi nhập B2 vào hộp tên.","partOfSpeech":"Cụm danh từ"},"gridlines":{"definition":"đường lưới giúp nhìn rõ ranh giới các ô","example":"Show gridlines, freeze panes, and enter a formula.","exampleTranslation":"Hiện đường lưới, cố định khung và nhập một công thức.","partOfSpeech":"Danh từ"},"freeze panes":{"definition":"cố định hàng hoặc cột để vẫn thấy khi cuộn","example":"Show gridlines, freeze panes, and enter a formula.","exampleTranslation":"Hiện đường lưới, cố định khung và nhập một công thức.","partOfSpeech":"Cụm động từ"},"formula":{"definition":"biểu thức tính toán bắt đầu bằng dấu bằng","example":"Show gridlines, freeze panes, and enter a formula.","exampleTranslation":"Hiện đường lưới, cố định khung và nhập một công thức.","partOfSpeech":"Danh từ"},"function":{"definition":"hàm có sẵn để thực hiện phép tính hoặc xử lý dữ liệu","example":"In a function, enter each argument and use the plus operator where needed.","exampleTranslation":"Trong một hàm, nhập từng đối số và dùng toán tử cộng khi cần.","partOfSpeech":"Danh từ"},"argument":{"definition":"giá trị hoặc vùng dữ liệu được đưa vào hàm","example":"In a function, enter each argument and use the plus operator where needed.","exampleTranslation":"Trong một hàm, nhập từng đối số và dùng toán tử cộng khi cần.","partOfSpeech":"Danh từ"},"operator":{"definition":"ký hiệu thực hiện phép tính hoặc phép so sánh","example":"In a function, enter each argument and use the plus operator where needed.","exampleTranslation":"Trong một hàm, nhập từng đối số và dùng toán tử cộng khi cần.","partOfSpeech":"Danh từ"},"SUM":{"definition":"hàm tính tổng các số","example":"Use SUM, AVERAGE, or COUNT to summarize the selected values.","exampleTranslation":"Dùng SUM, AVERAGE hoặc COUNT để tổng hợp các giá trị đã chọn.","partOfSpeech":"Danh từ"},"AVERAGE":{"definition":"hàm tính giá trị trung bình","example":"Use SUM, AVERAGE, or COUNT to summarize the selected values.","exampleTranslation":"Dùng SUM, AVERAGE hoặc COUNT để tổng hợp các giá trị đã chọn.","partOfSpeech":"Danh từ"},"COUNT":{"definition":"hàm đếm số ô chứa dữ liệu dạng số","example":"Use SUM, AVERAGE, or COUNT to summarize the selected values.","exampleTranslation":"Dùng SUM, AVERAGE hoặc COUNT để tổng hợp các giá trị đã chọn.","partOfSpeech":"Danh từ"},"IF function":{"definition":"hàm trả về kết quả tùy theo điều kiện đúng hay sai","example":"An IF function can compare a relative reference with an absolute reference.","exampleTranslation":"Hàm IF có thể so sánh tham chiếu tương đối với tham chiếu tuyệt đối.","partOfSpeech":"Cụm danh từ"},"relative reference":{"definition":"tham chiếu ô tự thay đổi khi sao chép công thức","example":"An IF function can compare a relative reference with an absolute reference.","exampleTranslation":"Hàm IF có thể so sánh tham chiếu tương đối với tham chiếu tuyệt đối.","partOfSpeech":"Cụm danh từ"},"absolute reference":{"definition":"tham chiếu ô được khóa, thường có dấu $","example":"An IF function can compare a relative reference with an absolute reference.","exampleTranslation":"Hàm IF có thể so sánh tham chiếu tương đối với tham chiếu tuyệt đối.","partOfSpeech":"Cụm danh từ"},"mixed reference":{"definition":"tham chiếu khóa hàng hoặc cột nhưng không khóa cả hai","example":"Use the fill handle to AutoFill a formula containing a mixed reference.","exampleTranslation":"Dùng nút kéo điền để tự điền công thức có tham chiếu hỗn hợp.","partOfSpeech":"Cụm danh từ"},"fill handle":{"definition":"nút kéo ở góc ô để sao chép hoặc điền dữ liệu","example":"Use the fill handle to AutoFill a formula containing a mixed reference.","exampleTranslation":"Dùng nút kéo điền để tự điền công thức có tham chiếu hỗn hợp.","partOfSpeech":"Cụm danh từ"},"AutoFill":{"definition":"tính năng tự điền chuỗi hoặc công thức vào các ô","example":"Use the fill handle to AutoFill a formula containing a mixed reference.","exampleTranslation":"Dùng nút kéo điền để tự điền công thức có tham chiếu hỗn hợp.","partOfSpeech":"Động từ"},"named range":{"definition":"vùng ô được gán tên để dễ dùng trong công thức","example":"Create a named range, then choose a number format or currency format.","exampleTranslation":"Tạo một vùng có tên, rồi chọn định dạng số hoặc định dạng tiền tệ.","partOfSpeech":"Cụm danh từ"},"number format":{"definition":"cách hiển thị số, ngày tháng hoặc giá trị trong ô","example":"Create a named range, then choose a number format or currency format.","exampleTranslation":"Tạo một vùng có tên, rồi chọn định dạng số hoặc định dạng tiền tệ.","partOfSpeech":"Cụm danh từ"},"currency format":{"definition":"định dạng số tiền kèm ký hiệu tiền tệ","example":"Create a named range, then choose a number format or currency format.","exampleTranslation":"Tạo một vùng có tên, rồi chọn định dạng số hoặc định dạng tiền tệ.","partOfSpeech":"Cụm danh từ"},"percentage format":{"definition":"định dạng hiển thị giá trị dưới dạng phần trăm","example":"Set a percentage format, choose decimal places, and turn on text wrapping.","exampleTranslation":"Chọn định dạng phần trăm, đặt số chữ số thập phân và bật ngắt dòng trong ô.","partOfSpeech":"Cụm danh từ"},"decimal places":{"definition":"số chữ số được hiển thị sau dấu thập phân","example":"Set a percentage format, choose decimal places, and turn on text wrapping.","exampleTranslation":"Chọn định dạng phần trăm, đặt số chữ số thập phân và bật ngắt dòng trong ô.","partOfSpeech":"Cụm danh từ"},"text wrapping":{"definition":"cách hiển thị nội dung dài thành nhiều dòng trong ô","example":"Set a percentage format, choose decimal places, and turn on text wrapping.","exampleTranslation":"Chọn định dạng phần trăm, đặt số chữ số thập phân và bật ngắt dòng trong ô.","partOfSpeech":"Cụm danh từ"},"merge cells":{"definition":"gộp nhiều ô liền kề thành một ô","example":"Merge cells, adjust horizontal alignment, and increase the font size.","exampleTranslation":"Gộp các ô, chỉnh căn ngang và tăng cỡ chữ.","partOfSpeech":"Cụm động từ"},"horizontal alignment":{"definition":"cách căn nội dung sang trái, giữa hoặc phải","example":"Merge cells, adjust horizontal alignment, and increase the font size.","exampleTranslation":"Gộp các ô, chỉnh căn ngang và tăng cỡ chữ.","partOfSpeech":"Cụm danh từ"},"font size":{"definition":"kích thước chữ hiển thị trong ô","example":"Merge cells, adjust horizontal alignment, and increase the font size.","exampleTranslation":"Gộp các ô, chỉnh căn ngang và tăng cỡ chữ.","partOfSpeech":"Cụm danh từ"},"border style":{"definition":"kiểu đường viền quanh ô hoặc vùng ô","example":"Set a fill color, choose a border style, and add conditional formatting.","exampleTranslation":"Chọn màu nền, kiểu đường viền và định dạng có điều kiện.","partOfSpeech":"Cụm danh từ"},"fill color":{"definition":"màu nền bên trong ô","example":"Set a fill color, choose a border style, and add conditional formatting.","exampleTranslation":"Chọn màu nền, kiểu đường viền và định dạng có điều kiện.","partOfSpeech":"Cụm danh từ"},"conditional formatting":{"definition":"định dạng tự đổi theo điều kiện của dữ liệu","example":"Set a fill color, choose a border style, and add conditional formatting.","exampleTranslation":"Chọn màu nền, kiểu đường viền và định dạng có điều kiện.","partOfSpeech":"Cụm danh từ"},"data validation":{"definition":"quy tắc giới hạn dữ liệu được nhập vào ô","example":"Use data validation to create a drop-down list, then sort the options.","exampleTranslation":"Dùng xác thực dữ liệu để tạo danh sách thả xuống, rồi sắp xếp các lựa chọn.","partOfSpeech":"Cụm danh từ"},"drop-down list":{"definition":"danh sách lựa chọn mở ra khi bấm vào ô","example":"Use data validation to create a drop-down list, then sort the options.","exampleTranslation":"Dùng xác thực dữ liệu để tạo danh sách thả xuống, rồi sắp xếp các lựa chọn.","partOfSpeech":"Cụm danh từ"},"sort":{"definition":"sắp xếp dữ liệu theo thứ tự hoặc tiêu chí","example":"Use data validation to create a drop-down list, then sort the options.","exampleTranslation":"Dùng xác thực dữ liệu để tạo danh sách thả xuống, rồi sắp xếp các lựa chọn.","partOfSpeech":"Động từ"},"filter":{"definition":"lọc để chỉ hiển thị các hàng thỏa điều kiện","example":"Filter the data, insert a row, and summarize results with a pivot table.","exampleTranslation":"Lọc dữ liệu, chèn một hàng và tổng hợp kết quả bằng bảng tổng hợp.","partOfSpeech":"Động từ"},"pivot table":{"definition":"bảng tương tác dùng để nhóm và tổng hợp dữ liệu","example":"Filter the data, insert a row, and summarize results with a pivot table.","exampleTranslation":"Lọc dữ liệu, chèn một hàng và tổng hợp kết quả bằng bảng tổng hợp.","partOfSpeech":"Cụm danh từ"},"insert a row":{"definition":"thêm một hàng mới vào trang tính","example":"Filter the data, insert a row, and summarize results with a pivot table.","exampleTranslation":"Lọc dữ liệu, chèn một hàng và tổng hợp kết quả bằng bảng tổng hợp.","partOfSpeech":"Cụm động từ"},"chart":{"definition":"biểu đồ thể hiện dữ liệu bằng hình ảnh","example":"Add a chart, then label its chart axis and chart legend.","exampleTranslation":"Thêm biểu đồ, rồi ghi nhãn cho trục và chú giải biểu đồ.","partOfSpeech":"Danh từ"},"chart axis":{"definition":"trục ngang hoặc trục dọc trên biểu đồ","example":"Add a chart, then label its chart axis and chart legend.","exampleTranslation":"Thêm biểu đồ, rồi ghi nhãn cho trục và chú giải biểu đồ.","partOfSpeech":"Cụm danh từ"},"chart legend":{"definition":"chú giải cho biết màu hoặc ký hiệu đại diện cho dữ liệu nào","example":"Add a chart, then label its chart axis and chart legend.","exampleTranslation":"Thêm biểu đồ, rồi ghi nhãn cho trục và chú giải biểu đồ.","partOfSpeech":"Cụm danh từ"},"chart title":{"definition":"tiêu đề mô tả nội dung của biểu đồ","example":"Import data, check the source data, and add a chart title.","exampleTranslation":"Nhập dữ liệu, kiểm tra dữ liệu nguồn và thêm tiêu đề biểu đồ.","partOfSpeech":"Cụm danh từ"},"source data":{"definition":"dữ liệu gốc được dùng để tạo kết quả hoặc biểu đồ","example":"Import data, check the source data, and add a chart title.","exampleTranslation":"Nhập dữ liệu, kiểm tra dữ liệu nguồn và thêm tiêu đề biểu đồ.","partOfSpeech":"Cụm danh từ"},"import data":{"definition":"đưa dữ liệu từ tệp hoặc nguồn khác vào Excel","example":"Import data, check the source data, and add a chart title.","exampleTranslation":"Nhập dữ liệu, kiểm tra dữ liệu nguồn và thêm tiêu đề biểu đồ.","partOfSpeech":"Cụm động từ"},"export data":{"definition":"đưa dữ liệu ra tệp hoặc định dạng khác","example":"Export data to a CSV file before selecting Protect Sheet.","exampleTranslation":"Xuất dữ liệu thành tệp CSV trước khi chọn lệnh Protect Sheet.","partOfSpeech":"Cụm động từ"},"CSV file":{"definition":"tệp văn bản lưu dữ liệu theo hàng, các mục thường cách nhau bằng dấu phẩy","example":"Export data to a CSV file before selecting Protect Sheet.","exampleTranslation":"Xuất dữ liệu thành tệp CSV trước khi chọn lệnh Protect Sheet.","partOfSpeech":"Cụm danh từ"},"protect sheet":{"definition":"bảo vệ trang tính để hạn chế thay đổi ô hoặc cấu trúc","example":"Export data to a CSV file before selecting Protect Sheet.","exampleTranslation":"Xuất dữ liệu thành tệp CSV trước khi chọn lệnh Protect Sheet.","partOfSpeech":"Cụm danh từ"},"hidden row":{"definition":"hàng đã bị ẩn khỏi trang tính","example":"Unhide a hidden row or hidden column, then delete a column if needed.","exampleTranslation":"Hiện lại hàng hoặc cột đang ẩn, rồi xóa cột nếu cần.","partOfSpeech":"Cụm danh từ"},"hidden column":{"definition":"cột đã bị ẩn khỏi trang tính","example":"Unhide a hidden row or hidden column, then delete a column if needed.","exampleTranslation":"Hiện lại hàng hoặc cột đang ẩn, rồi xóa cột nếu cần.","partOfSpeech":"Cụm danh từ"},"delete a column":{"definition":"xóa một cột cùng dữ liệu trong cột đó","example":"Unhide a hidden row or hidden column, then delete a column if needed.","exampleTranslation":"Hiện lại hàng hoặc cột đang ẩn, rồi xóa cột nếu cần.","partOfSpeech":"Cụm động từ"},"recalculate":{"definition":"tính lại công thức để cập nhật kết quả","example":"Undo the last change, redo it, and recalculate the workbook.","exampleTranslation":"Hoàn tác thay đổi gần nhất, làm lại thao tác đó và tính lại workbook.","partOfSpeech":"Động từ"},"undo":{"definition":"hoàn tác thao tác vừa thực hiện","example":"Undo the last change, redo it, and recalculate the workbook.","exampleTranslation":"Hoàn tác thay đổi gần nhất, làm lại thao tác đó và tính lại workbook.","partOfSpeech":"Động từ"},"redo":{"definition":"làm lại thao tác vừa được hoàn tác","example":"Undo the last change, redo it, and recalculate the workbook.","exampleTranslation":"Hoàn tác thay đổi gần nhất, làm lại thao tác đó và tính lại workbook.","partOfSpeech":"Động từ"},"document":{"definition":"tài liệu được tạo và chỉnh sửa trong Word","example":"Open the document, choose page layout, and set the page margin.","exampleTranslation":"Mở tài liệu, chọn bố trí trang và đặt lề trang.","partOfSpeech":"Danh từ"},"page layout":{"definition":"cách sắp xếp nội dung và các thành phần trên trang","example":"Open the document, choose page layout, and set the page margin.","exampleTranslation":"Mở tài liệu, chọn bố trí trang và đặt lề trang.","partOfSpeech":"Cụm danh từ"},"page margin":{"definition":"lề trống giữa nội dung và mép trang","example":"Open the document, choose page layout, and set the page margin.","exampleTranslation":"Mở tài liệu, chọn bố trí trang và đặt lề trang.","partOfSpeech":"Cụm danh từ"},"page orientation":{"definition":"hướng giấy dọc hoặc ngang","example":"Change page orientation for a section, then edit the header.","exampleTranslation":"Đổi hướng trang cho một phần, rồi chỉnh đầu trang.","partOfSpeech":"Cụm danh từ"},"section":{"definition":"phần tài liệu có thể có thiết lập trang riêng","example":"Change page orientation for a section, then edit the header.","exampleTranslation":"Đổi hướng trang cho một phần, rồi chỉnh đầu trang.","partOfSpeech":"Danh từ"},"header":{"definition":"vùng nội dung lặp ở đầu các trang","example":"Change page orientation for a section, then edit the header.","exampleTranslation":"Đổi hướng trang cho một phần, rồi chỉnh đầu trang.","partOfSpeech":"Danh từ"},"footer":{"definition":"vùng nội dung lặp ở cuối các trang","example":"Add a page number in the footer and format the opening paragraph.","exampleTranslation":"Thêm số trang ở chân trang và định dạng đoạn mở đầu.","partOfSpeech":"Danh từ"},"page number":{"definition":"số thứ tự hiển thị trên trang","example":"Add a page number in the footer and format the opening paragraph.","exampleTranslation":"Thêm số trang ở chân trang và định dạng đoạn mở đầu.","partOfSpeech":"Cụm danh từ"},"paragraph":{"definition":"đoạn văn kết thúc khi người dùng xuống dòng bằng Enter","example":"Add a page number in the footer and format the opening paragraph.","exampleTranslation":"Thêm số trang ở chân trang và định dạng đoạn mở đầu.","partOfSpeech":"Danh từ"},"line spacing":{"definition":"khoảng cách giữa các dòng văn bản","example":"Adjust line spacing, a first-line indent, and a hanging indent.","exampleTranslation":"Chỉnh giãn dòng, thụt đầu dòng đầu tiên và thụt treo.","partOfSpeech":"Cụm danh từ"},"first-line indent":{"definition":"khoảng thụt chỉ áp dụng cho dòng đầu đoạn","example":"Adjust line spacing, a first-line indent, and a hanging indent.","exampleTranslation":"Chỉnh giãn dòng, thụt đầu dòng đầu tiên và thụt treo.","partOfSpeech":"Cụm danh từ"},"hanging indent":{"definition":"kiểu thụt lề khiến dòng đầu nhô ra, các dòng sau thụt vào","example":"Adjust line spacing, a first-line indent, and a hanging indent.","exampleTranslation":"Chỉnh giãn dòng, thụt đầu dòng đầu tiên và thụt treo.","partOfSpeech":"Cụm danh từ"},"tab stop":{"definition":"vị trí con trỏ sẽ nhảy tới khi nhấn phím Tab","example":"Set a tab stop, add a page break, and insert a section break.","exampleTranslation":"Đặt điểm dừng tab, thêm ngắt trang và chèn ngắt phần.","partOfSpeech":"Cụm danh từ"},"page break":{"definition":"ngắt trang để phần tiếp theo bắt đầu ở trang mới","example":"Set a tab stop, add a page break, and insert a section break.","exampleTranslation":"Đặt điểm dừng tab, thêm ngắt trang và chèn ngắt phần.","partOfSpeech":"Cụm danh từ"},"section break":{"definition":"ngắt phần để áp dụng bố cục khác cho phần sau","example":"Set a tab stop, add a page break, and insert a section break.","exampleTranslation":"Đặt điểm dừng tab, thêm ngắt trang và chèn ngắt phần.","partOfSpeech":"Cụm danh từ"},"line break":{"definition":"ngắt dòng mà không bắt đầu một đoạn mới","example":"Add a line break, increase character spacing, and make the title bold.","exampleTranslation":"Ngắt dòng, tăng khoảng cách ký tự và in đậm tiêu đề.","partOfSpeech":"Cụm danh từ"},"character spacing":{"definition":"khoảng cách giữa các ký tự","example":"Add a line break, increase character spacing, and make the title bold.","exampleTranslation":"Ngắt dòng, tăng khoảng cách ký tự và in đậm tiêu đề.","partOfSpeech":"Cụm danh từ"},"bold":{"definition":"định dạng chữ đậm để nhấn mạnh","example":"Add a line break, increase character spacing, and make the title bold.","exampleTranslation":"Ngắt dòng, tăng khoảng cách ký tự và in đậm tiêu đề.","partOfSpeech":"Tính từ"},"italic":{"definition":"định dạng chữ nghiêng","example":"Apply italic and underline, then use strikethrough for removed text.","exampleTranslation":"In nghiêng và gạch dưới, rồi gạch ngang phần văn bản đã bỏ.","partOfSpeech":"Danh từ"},"underline":{"definition":"định dạng có đường gạch dưới chữ","example":"Apply italic and underline, then use strikethrough for removed text.","exampleTranslation":"In nghiêng và gạch dưới, rồi gạch ngang phần văn bản đã bỏ.","partOfSpeech":"Danh từ"},"strikethrough":{"definition":"định dạng có đường kẻ ngang qua chữ","example":"Apply italic and underline, then use strikethrough for removed text.","exampleTranslation":"In nghiêng và gạch dưới, rồi gạch ngang phần văn bản đã bỏ.","partOfSpeech":"Danh từ"},"text highlight":{"definition":"màu nền đánh dấu một phần văn bản","example":"Set the font color and paragraph alignment, then apply text highlight.","exampleTranslation":"Chọn màu chữ và căn đoạn, rồi tô sáng văn bản.","partOfSpeech":"Cụm danh từ"},"font color":{"definition":"màu hiển thị của ký tự","example":"Set the font color and paragraph alignment, then apply text highlight.","exampleTranslation":"Chọn màu chữ và căn đoạn, rồi tô sáng văn bản.","partOfSpeech":"Cụm danh từ"},"paragraph alignment":{"definition":"cách căn đoạn sang trái, giữa, phải hoặc đều hai bên","example":"Set the font color and paragraph alignment, then apply text highlight.","exampleTranslation":"Chọn màu chữ và căn đoạn, rồi tô sáng văn bản.","partOfSpeech":"Cụm danh từ"},"bullet list":{"definition":"danh sách dùng ký hiệu ở đầu mỗi mục","example":"Choose a bullet list, numbered list, or multilevel list for the outline.","exampleTranslation":"Chọn danh sách dấu đầu dòng, danh sách đánh số hoặc danh sách nhiều cấp cho dàn ý.","partOfSpeech":"Cụm danh từ"},"numbered list":{"definition":"danh sách có số thứ tự ở đầu mỗi mục","example":"Choose a bullet list, numbered list, or multilevel list for the outline.","exampleTranslation":"Chọn danh sách dấu đầu dòng, danh sách đánh số hoặc danh sách nhiều cấp cho dàn ý.","partOfSpeech":"Cụm danh từ"},"multilevel list":{"definition":"danh sách có nhiều cấp thụt lề và đánh số","example":"Choose a bullet list, numbered list, or multilevel list for the outline.","exampleTranslation":"Chọn danh sách dấu đầu dòng, danh sách đánh số hoặc danh sách nhiều cấp cho dàn ý.","partOfSpeech":"Cụm danh từ"},"style":{"definition":"tập hợp định dạng có sẵn cho văn bản","example":"Apply a heading style and match it to the document theme.","exampleTranslation":"Áp dụng kiểu tiêu đề và đồng bộ với chủ đề tài liệu.","partOfSpeech":"Danh từ"},"heading":{"definition":"tiêu đề dùng để chia cấu trúc tài liệu","example":"Apply a heading style and match it to the document theme.","exampleTranslation":"Áp dụng kiểu tiêu đề và đồng bộ với chủ đề tài liệu.","partOfSpeech":"Danh từ"},"document theme":{"definition":"bộ màu và phông chữ thống nhất cho tài liệu","example":"Apply a heading style and match it to the document theme.","exampleTranslation":"Áp dụng kiểu tiêu đề và đồng bộ với chủ đề tài liệu.","partOfSpeech":"Cụm danh từ"},"document template":{"definition":"tệp mẫu có sẵn bố cục và định dạng tài liệu","example":"Start from a document template, add a page border, and format text in columns.","exampleTranslation":"Bắt đầu từ mẫu tài liệu, thêm viền trang và chia văn bản thành cột.","partOfSpeech":"Cụm danh từ"},"page border":{"definition":"đường viền bao quanh trang","example":"Start from a document template, add a page border, and format text in columns.","exampleTranslation":"Bắt đầu từ mẫu tài liệu, thêm viền trang và chia văn bản thành cột.","partOfSpeech":"Cụm danh từ"},"columns":{"definition":"các cột dọc dùng để chia nội dung trang","example":"Start from a document template, add a page border, and format text in columns.","exampleTranslation":"Bắt đầu từ mẫu tài liệu, thêm viền trang và chia văn bản thành cột.","partOfSpeech":"Danh từ"},"table of contents":{"definition":"mục lục liệt kê tiêu đề và số trang","example":"Insert a table and generate a table of contents and index.","exampleTranslation":"Chèn bảng, rồi tạo mục lục và chỉ mục tra cứu.","partOfSpeech":"Cụm danh từ"},"index":{"definition":"chỉ mục tra cứu các thuật ngữ và vị trí xuất hiện","example":"Insert a table and generate a table of contents and index.","exampleTranslation":"Chèn bảng, rồi tạo mục lục và chỉ mục tra cứu.","partOfSpeech":"Danh từ"},"table":{"definition":"bảng gồm các hàng và cột trong tài liệu","example":"Insert a table and generate a table of contents and index.","exampleTranslation":"Chèn bảng, rồi tạo mục lục và chỉ mục tra cứu.","partOfSpeech":"Danh từ"},"table row":{"definition":"hàng ngang gồm các ô trong bảng","example":"Format a table row and table column, then apply cell shading.","exampleTranslation":"Định dạng hàng và cột của bảng, rồi tô nền ô.","partOfSpeech":"Cụm danh từ"},"table column":{"definition":"cột dọc gồm các ô trong bảng","example":"Format a table row and table column, then apply cell shading.","exampleTranslation":"Định dạng hàng và cột của bảng, rồi tô nền ô.","partOfSpeech":"Cụm danh từ"},"cell shading":{"definition":"màu nền bên trong một hoặc nhiều ô của bảng","example":"Format a table row and table column, then apply cell shading.","exampleTranslation":"Định dạng hàng và cột của bảng, rồi tô nền ô.","partOfSpeech":"Cụm danh từ"},"table border":{"definition":"đường viền quanh hoặc bên trong bảng","example":"Set a table border, add a caption, and link to a source with a hyperlink.","exampleTranslation":"Đặt đường viền bảng, thêm chú thích và liên kết tới nguồn bằng siêu liên kết.","partOfSpeech":"Cụm danh từ"},"caption":{"definition":"chú thích đặt cho hình, bảng hoặc đối tượng","example":"Set a table border, add a caption, and link to a source with a hyperlink.","exampleTranslation":"Đặt đường viền bảng, thêm chú thích và liên kết tới nguồn bằng siêu liên kết.","partOfSpeech":"Danh từ"},"hyperlink":{"definition":"liên kết mở trang web, tệp hoặc vị trí khác","example":"Set a table border, add a caption, and link to a source with a hyperlink.","exampleTranslation":"Đặt đường viền bảng, thêm chú thích và liên kết tới nguồn bằng siêu liên kết.","partOfSpeech":"Danh từ"},"bookmark":{"definition":"dấu lưu vị trí để quay lại nhanh trong tài liệu","example":"Add a bookmark, cite it with a cross-reference, and insert a footnote.","exampleTranslation":"Đánh dấu một vị trí, dẫn chiếu tới đó và chèn chú thích cuối trang.","partOfSpeech":"Danh từ"},"cross-reference":{"definition":"dẫn chiếu tới tiêu đề, hình, bảng hoặc vị trí khác","example":"Add a bookmark, cite it with a cross-reference, and insert a footnote.","exampleTranslation":"Đánh dấu một vị trí, dẫn chiếu tới đó và chèn chú thích cuối trang.","partOfSpeech":"Danh từ"},"footnote":{"definition":"ghi chú giải thích ở cuối trang","example":"Add a bookmark, cite it with a cross-reference, and insert a footnote.","exampleTranslation":"Đánh dấu một vị trí, dẫn chiếu tới đó và chèn chú thích cuối trang.","partOfSpeech":"Danh từ"},"endnote":{"definition":"ghi chú giải thích đặt ở cuối tài liệu hoặc chương","example":"Use find and replace to update a term, then add an endnote.","exampleTranslation":"Dùng tìm và thay thế để cập nhật một từ, rồi thêm chú thích cuối tài liệu.","partOfSpeech":"Danh từ"},"find":{"definition":"tìm từ hoặc cụm từ trong tài liệu","example":"Use find and replace to update a term, then add an endnote.","exampleTranslation":"Dùng tìm và thay thế để cập nhật một từ, rồi thêm chú thích cuối tài liệu.","partOfSpeech":"Danh từ"},"replace":{"definition":"thay từ hoặc cụm từ đã tìm bằng nội dung khác","example":"Use find and replace to update a term, then add an endnote.","exampleTranslation":"Dùng tìm và thay thế để cập nhật một từ, rồi thêm chú thích cuối tài liệu.","partOfSpeech":"Danh từ"},"navigation pane":{"definition":"ngăn dùng để tìm và chuyển nhanh giữa các phần","example":"Open the navigation pane, run spell check, and review grammar check suggestions.","exampleTranslation":"Mở ngăn dẫn hướng, kiểm tra chính tả và xem gợi ý ngữ pháp.","partOfSpeech":"Cụm danh từ"},"spell check":{"definition":"tính năng dò lỗi chính tả","example":"Open the navigation pane, run spell check, and review grammar check suggestions.","exampleTranslation":"Mở ngăn dẫn hướng, kiểm tra chính tả và xem gợi ý ngữ pháp.","partOfSpeech":"Cụm danh từ"},"grammar check":{"definition":"tính năng gợi ý sửa ngữ pháp","example":"Open the navigation pane, run spell check, and review grammar check suggestions.","exampleTranslation":"Mở ngăn dẫn hướng, kiểm tra chính tả và xem gợi ý ngữ pháp.","partOfSpeech":"Cụm danh từ"},"word count":{"definition":"tổng số từ trong tài liệu hoặc phần được chọn","example":"Check the word count, add a comment, and turn on track changes.","exampleTranslation":"Kiểm tra số từ, thêm nhận xét và bật theo dõi thay đổi.","partOfSpeech":"Cụm danh từ"},"comment":{"definition":"nhận xét gắn với một đoạn hoặc vị trí trong tài liệu","example":"Check the word count, add a comment, and turn on track changes.","exampleTranslation":"Kiểm tra số từ, thêm nhận xét và bật theo dõi thay đổi.","partOfSpeech":"Danh từ"},"track changes":{"definition":"chế độ ghi lại các chỉnh sửa của người dùng","example":"Check the word count, add a comment, and turn on track changes.","exampleTranslation":"Kiểm tra số từ, thêm nhận xét và bật theo dõi thay đổi.","partOfSpeech":"Cụm danh từ"},"revision markup":{"definition":"ký hiệu hiển thị nội dung đã thêm, xóa hoặc sửa","example":"Review revision markup, accept changes you need, and reject changes you do not.","exampleTranslation":"Xem dấu sửa đổi, chấp nhận thay đổi cần giữ và từ chối thay đổi không dùng.","partOfSpeech":"Cụm danh từ"},"accept changes":{"definition":"chấp nhận các chỉnh sửa đang được theo dõi","example":"Review revision markup, accept changes you need, and reject changes you do not.","exampleTranslation":"Xem dấu sửa đổi, chấp nhận thay đổi cần giữ và từ chối thay đổi không dùng.","partOfSpeech":"Cụm động từ"},"reject changes":{"definition":"từ chối chỉnh sửa và khôi phục nội dung trước đó","example":"Review revision markup, accept changes you need, and reject changes you do not.","exampleTranslation":"Xem dấu sửa đổi, chấp nhận thay đổi cần giữ và từ chối thay đổi không dùng.","partOfSpeech":"Cụm động từ"},"mail merge":{"definition":"trộn mẫu tài liệu với dữ liệu để tạo nhiều bản riêng","example":"Use mail merge with a recipient list to create each label.","exampleTranslation":"Dùng trộn thư với danh sách người nhận để tạo từng nhãn.","partOfSpeech":"Cụm danh từ"},"recipient list":{"definition":"danh sách người nhận dùng trong trộn thư","example":"Use mail merge with a recipient list to create each label.","exampleTranslation":"Dùng trộn thư với danh sách người nhận để tạo từng nhãn.","partOfSpeech":"Cụm danh từ"},"label":{"definition":"nhãn địa chỉ hoặc nhãn thông tin được dàn trang để in","example":"Use mail merge with a recipient list to create each label.","exampleTranslation":"Dùng trộn thư với danh sách người nhận để tạo từng nhãn.","partOfSpeech":"Danh từ"},"presentation":{"definition":"bài thuyết trình gồm các trang chiếu","example":"Create a presentation, add a slide, and save the slide deck.","exampleTranslation":"Tạo một bài thuyết trình, thêm trang chiếu và lưu bộ trang chiếu.","partOfSpeech":"Danh từ"},"slide":{"definition":"trang chiếu riêng lẻ trong bài thuyết trình","example":"Create a presentation, add a slide, and save the slide deck.","exampleTranslation":"Tạo một bài thuyết trình, thêm trang chiếu và lưu bộ trang chiếu.","partOfSpeech":"Danh từ"},"slide deck":{"definition":"toàn bộ bộ trang chiếu của một bài thuyết trình","example":"Create a presentation, add a slide, and save the slide deck.","exampleTranslation":"Tạo một bài thuyết trình, thêm trang chiếu và lưu bộ trang chiếu.","partOfSpeech":"Cụm danh từ"},"slide layout":{"definition":"cách sắp xếp các vùng nội dung trên một trang chiếu","example":"Choose a presentation template, apply a slide theme, and select a slide layout.","exampleTranslation":"Chọn mẫu bài thuyết trình, áp dụng chủ đề trang chiếu và chọn bố cục.","partOfSpeech":"Cụm danh từ"},"slide theme":{"definition":"bộ màu, phông và hiệu ứng thống nhất cho trang chiếu","example":"Choose a presentation template, apply a slide theme, and select a slide layout.","exampleTranslation":"Chọn mẫu bài thuyết trình, áp dụng chủ đề trang chiếu và chọn bố cục.","partOfSpeech":"Cụm danh từ"},"presentation template":{"definition":"tệp mẫu có sẵn thiết kế cho bài thuyết trình","example":"Choose a presentation template, apply a slide theme, and select a slide layout.","exampleTranslation":"Chọn mẫu bài thuyết trình, áp dụng chủ đề trang chiếu và chọn bố cục.","partOfSpeech":"Cụm danh từ"},"title slide":{"definition":"trang chiếu mở đầu thường có tên bài và người trình bày","example":"Add a title slide, create a slide section, and fill a content placeholder.","exampleTranslation":"Thêm trang tiêu đề, tạo một phần trang chiếu và điền vùng giữ chỗ nội dung.","partOfSpeech":"Cụm danh từ"},"slide section":{"definition":"nhóm trang chiếu được gom theo một phần","example":"Add a title slide, create a slide section, and fill a content placeholder.","exampleTranslation":"Thêm trang tiêu đề, tạo một phần trang chiếu và điền vùng giữ chỗ nội dung.","partOfSpeech":"Cụm danh từ"},"content placeholder":{"definition":"vùng giữ chỗ để nhập văn bản hoặc chèn nội dung","example":"Add a title slide, create a slide section, and fill a content placeholder.","exampleTranslation":"Thêm trang tiêu đề, tạo một phần trang chiếu và điền vùng giữ chỗ nội dung.","partOfSpeech":"Cụm danh từ"},"text box":{"definition":"hộp dùng để nhập và đặt văn bản tự do","example":"Insert a text box and shape, then arrange each slide object.","exampleTranslation":"Chèn hộp văn bản và hình khối, rồi sắp xếp từng đối tượng trên trang chiếu.","partOfSpeech":"Cụm danh từ"},"shape":{"definition":"hình khối như mũi tên, hình tròn hoặc hình chữ nhật","example":"Insert a text box and shape, then arrange each slide object.","exampleTranslation":"Chèn hộp văn bản và hình khối, rồi sắp xếp từng đối tượng trên trang chiếu.","partOfSpeech":"Danh từ"},"slide object":{"definition":"thành phần có thể chọn và chỉnh sửa trên trang chiếu","example":"Insert a text box and shape, then arrange each slide object.","exampleTranslation":"Chèn hộp văn bản và hình khối, rồi sắp xếp từng đối tượng trên trang chiếu.","partOfSpeech":"Cụm danh từ"},"picture":{"definition":"ảnh được chèn vào trang chiếu","example":"Insert a picture, presentation chart, and slide table.","exampleTranslation":"Chèn ảnh, biểu đồ thuyết trình và bảng trên trang chiếu.","partOfSpeech":"Danh từ"},"presentation chart":{"definition":"biểu đồ dùng để trình bày dữ liệu trên trang chiếu","example":"Insert a picture, presentation chart, and slide table.","exampleTranslation":"Chèn ảnh, biểu đồ thuyết trình và bảng trên trang chiếu.","partOfSpeech":"Cụm danh từ"},"slide table":{"definition":"bảng gồm hàng và cột được chèn vào trang chiếu","example":"Insert a picture, presentation chart, and slide table.","exampleTranslation":"Chèn ảnh, biểu đồ thuyết trình và bảng trên trang chiếu.","partOfSpeech":"Cụm danh từ"},"SmartArt graphic":{"definition":"sơ đồ trực quan dùng để trình bày quy trình hoặc quan hệ","example":"Add a SmartArt graphic, write speaker notes, and print the notes page.","exampleTranslation":"Thêm đồ họa SmartArt, viết ghi chú người thuyết trình và in trang ghi chú.","partOfSpeech":"Cụm danh từ"},"speaker notes":{"definition":"ghi chú riêng hỗ trợ người thuyết trình","example":"Add a SmartArt graphic, write speaker notes, and print the notes page.","exampleTranslation":"Thêm đồ họa SmartArt, viết ghi chú người thuyết trình và in trang ghi chú.","partOfSpeech":"Cụm danh từ"},"notes page":{"definition":"trang in gồm một trang chiếu và phần ghi chú","example":"Add a SmartArt graphic, write speaker notes, and print the notes page.","exampleTranslation":"Thêm đồ họa SmartArt, viết ghi chú người thuyết trình và in trang ghi chú.","partOfSpeech":"Cụm danh từ"},"slide master":{"definition":"trang chiếu điều khiển thiết kế chung của bài thuyết trình","example":"Use the slide master to edit a master layout and set theme colors.","exampleTranslation":"Dùng trang chiếu cái để chỉnh bố cục cái và đặt màu chủ đề.","partOfSpeech":"Cụm danh từ"},"master layout":{"definition":"bố cục mẫu được quản lý bởi slide master","example":"Use the slide master to edit a master layout and set theme colors.","exampleTranslation":"Dùng trang chiếu cái để chỉnh bố cục cái và đặt màu chủ đề.","partOfSpeech":"Cụm danh từ"},"theme colors":{"definition":"bảng màu được dùng thống nhất trong chủ đề","example":"Use the slide master to edit a master layout and set theme colors.","exampleTranslation":"Dùng trang chiếu cái để chỉnh bố cục cái và đặt màu chủ đề.","partOfSpeech":"Cụm danh từ"},"slide size":{"definition":"kích thước và tỷ lệ khung hình của trang chiếu","example":"Choose widescreen format for the slide size, then choose Duplicate Slide.","exampleTranslation":"Đặt kích thước trang chiếu dạng màn hình rộng, rồi nhân đôi trang chiếu.","partOfSpeech":"Cụm danh từ"},"widescreen format":{"definition":"tỷ lệ trang chiếu rộng thường dùng cho màn hình hiện đại","example":"Choose widescreen format for the slide size, then choose Duplicate Slide.","exampleTranslation":"Đặt kích thước trang chiếu dạng màn hình rộng, rồi nhân đôi trang chiếu.","partOfSpeech":"Cụm danh từ"},"duplicate slide":{"definition":"tạo bản sao của trang chiếu đang chọn","example":"Choose widescreen format for the slide size, then choose Duplicate Slide.","exampleTranslation":"Đặt kích thước trang chiếu dạng màn hình rộng, rồi nhân đôi trang chiếu.","partOfSpeech":"Cụm danh từ"},"slide order":{"definition":"thứ tự các trang chiếu trong bài thuyết trình","example":"Change the slide order, group objects, and ungroup objects to edit them.","exampleTranslation":"Đổi thứ tự trang chiếu, nhóm đối tượng rồi bỏ nhóm để chỉnh sửa.","partOfSpeech":"Cụm danh từ"},"group objects":{"definition":"gom nhiều đối tượng để di chuyển hoặc định dạng cùng nhau","example":"Change the slide order, group objects, and ungroup objects to edit them.","exampleTranslation":"Đổi thứ tự trang chiếu, nhóm đối tượng rồi bỏ nhóm để chỉnh sửa.","partOfSpeech":"Cụm động từ"},"ungroup objects":{"definition":"tách nhóm để chỉnh từng đối tượng riêng","example":"Change the slide order, group objects, and ungroup objects to edit them.","exampleTranslation":"Đổi thứ tự trang chiếu, nhóm đối tượng rồi bỏ nhóm để chỉnh sửa.","partOfSpeech":"Cụm động từ"},"align objects":{"definition":"căn các đối tượng theo cạnh hoặc tâm","example":"Align objects, distribute objects evenly, and crop the picture.","exampleTranslation":"Căn các đối tượng, phân bố đều chúng và cắt ảnh.","partOfSpeech":"Cụm động từ"},"distribute objects":{"definition":"chia đều khoảng cách giữa các đối tượng","example":"Align objects, distribute objects evenly, and crop the picture.","exampleTranslation":"Căn các đối tượng, phân bố đều chúng và cắt ảnh.","partOfSpeech":"Cụm động từ"},"crop":{"definition":"cắt bỏ phần rìa không cần thiết của ảnh","example":"Align objects, distribute objects evenly, and crop the picture.","exampleTranslation":"Căn các đối tượng, phân bố đều chúng và cắt ảnh.","partOfSpeech":"Động từ"},"compress pictures":{"definition":"giảm dung lượng ảnh trong bài thuyết trình","example":"Compress pictures, add a slide transition, and apply an animation.","exampleTranslation":"Nén ảnh, thêm hiệu ứng chuyển trang và áp dụng hoạt ảnh.","partOfSpeech":"Cụm động từ"},"slide transition":{"definition":"hiệu ứng khi chuyển từ trang chiếu này sang trang khác","example":"Compress pictures, add a slide transition, and apply an animation.","exampleTranslation":"Nén ảnh, thêm hiệu ứng chuyển trang và áp dụng hoạt ảnh.","partOfSpeech":"Cụm danh từ"},"animation":{"definition":"hiệu ứng chuyển động áp dụng cho đối tượng trên trang chiếu","example":"Compress pictures, add a slide transition, and apply an animation.","exampleTranslation":"Nén ảnh, thêm hiệu ứng chuyển trang và áp dụng hoạt ảnh.","partOfSpeech":"Danh từ"},"entrance effect":{"definition":"hoạt ảnh làm đối tượng xuất hiện","example":"Use an entrance effect, an emphasis effect, and an exit effect.","exampleTranslation":"Dùng hiệu ứng xuất hiện, hiệu ứng nhấn mạnh và hiệu ứng biến mất.","partOfSpeech":"Cụm danh từ"},"exit effect":{"definition":"hoạt ảnh làm đối tượng biến mất","example":"Use an entrance effect, an emphasis effect, and an exit effect.","exampleTranslation":"Dùng hiệu ứng xuất hiện, hiệu ứng nhấn mạnh và hiệu ứng biến mất.","partOfSpeech":"Cụm danh từ"},"emphasis effect":{"definition":"hoạt ảnh làm nổi bật đối tượng đang hiển thị","example":"Use an entrance effect, an emphasis effect, and an exit effect.","exampleTranslation":"Dùng hiệu ứng xuất hiện, hiệu ứng nhấn mạnh và hiệu ứng biến mất.","partOfSpeech":"Cụm danh từ"},"motion path":{"definition":"đường đi mà đối tượng chuyển động theo","example":"Set animation timing and duration for a shape's motion path.","exampleTranslation":"Đặt thời điểm và thời lượng hoạt ảnh cho đường di chuyển của hình khối.","partOfSpeech":"Cụm danh từ"},"animation timing":{"definition":"thiết lập thời điểm bắt đầu và trình tự hoạt ảnh","example":"Set animation timing and duration for a shape's motion path.","exampleTranslation":"Đặt thời điểm và thời lượng hoạt ảnh cho đường di chuyển của hình khối.","partOfSpeech":"Cụm danh từ"},"duration":{"definition":"thời lượng để hiệu ứng hoàn tất","example":"Set animation timing and duration for a shape's motion path.","exampleTranslation":"Đặt thời điểm và thời lượng hoạt ảnh cho đường di chuyển của hình khối.","partOfSpeech":"Danh từ"},"delay":{"definition":"thời gian chờ trước khi hiệu ứng bắt đầu","example":"Set a delay, choose a trigger, and start on click.","exampleTranslation":"Đặt độ trễ, chọn điều kiện kích hoạt và bắt đầu khi bấm chuột.","partOfSpeech":"Danh từ"},"trigger":{"definition":"điều kiện hoặc thao tác làm hoạt ảnh bắt đầu","example":"Set a delay, choose a trigger, and start on click.","exampleTranslation":"Đặt độ trễ, chọn điều kiện kích hoạt và bắt đầu khi bấm chuột.","partOfSpeech":"Danh từ"},"start on click":{"definition":"tùy chọn bắt đầu hiệu ứng khi người trình bày bấm","example":"Set a delay, choose a trigger, and start on click.","exampleTranslation":"Đặt độ trễ, chọn điều kiện kích hoạt và bắt đầu khi bấm chuột.","partOfSpeech":"Cụm động từ"},"after previous":{"definition":"tùy chọn chạy hiệu ứng sau khi hiệu ứng trước kết thúc","example":"Play the next effect after previous or with previous during the slideshow.","exampleTranslation":"Chạy hiệu ứng tiếp theo sau hiệu ứng trước hoặc cùng lúc trong khi trình chiếu.","partOfSpeech":"Cụm giới từ"},"with previous":{"definition":"tùy chọn chạy hiệu ứng đồng thời với hiệu ứng trước","example":"Play the next effect after previous or with previous during the slideshow.","exampleTranslation":"Chạy hiệu ứng tiếp theo sau hiệu ứng trước hoặc cùng lúc trong khi trình chiếu.","partOfSpeech":"Cụm giới từ"},"slideshow":{"definition":"chế độ trình chiếu lần lượt các trang chiếu","example":"Play the next effect after previous or with previous during the slideshow.","exampleTranslation":"Chạy hiệu ứng tiếp theo sau hiệu ứng trước hoặc cùng lúc trong khi trình chiếu.","partOfSpeech":"Danh từ"},"presenter view":{"definition":"chế độ hiển thị ghi chú và điều khiển cho người trình bày","example":"Open presenter view, rehearse timings, and record narration.","exampleTranslation":"Mở chế độ người thuyết trình, tập thời gian và ghi lời thuyết minh.","partOfSpeech":"Cụm danh từ"},"rehearse timings":{"definition":"tập và ghi thời lượng cho từng trang chiếu","example":"Open presenter view, rehearse timings, and record narration.","exampleTranslation":"Mở chế độ người thuyết trình, tập thời gian và ghi lời thuyết minh.","partOfSpeech":"Cụm động từ"},"record narration":{"definition":"ghi âm lời thuyết minh đi kèm bài thuyết trình","example":"Open presenter view, rehearse timings, and record narration.","exampleTranslation":"Mở chế độ người thuyết trình, tập thời gian và ghi lời thuyết minh.","partOfSpeech":"Cụm động từ"},"closed captions":{"definition":"phụ đề hiển thị lời nói hoặc âm thanh trong video","example":"Add closed captions, print a handout, and review outline view.","exampleTranslation":"Thêm phụ đề, in bản phát tay và xem dạng dàn ý.","partOfSpeech":"Cụm danh từ"},"handout":{"definition":"bản in gồm các trang chiếu phát cho người tham dự","example":"Add closed captions, print a handout, and review outline view.","exampleTranslation":"Thêm phụ đề, in bản phát tay và xem dạng dàn ý.","partOfSpeech":"Danh từ"},"outline view":{"definition":"chế độ xem nội dung văn bản theo dạng dàn ý","example":"Add closed captions, print a handout, and review outline view.","exampleTranslation":"Thêm phụ đề, in bản phát tay và xem dạng dàn ý.","partOfSpeech":"Cụm danh từ"},"reading view":{"definition":"chế độ xem bài thuyết trình trong cửa sổ ứng dụng","example":"Use reading view, choose Hide Slide, or switch to kiosk mode.","exampleTranslation":"Dùng chế độ đọc, ẩn một trang chiếu hoặc chuyển sang chế độ ki-ốt.","partOfSpeech":"Cụm danh từ"},"hide slide":{"definition":"ẩn trang chiếu để không phát trong trình chiếu","example":"Use reading view, choose Hide Slide, or switch to kiosk mode.","exampleTranslation":"Dùng chế độ đọc, ẩn một trang chiếu hoặc chuyển sang chế độ ki-ốt.","partOfSpeech":"Cụm danh từ"},"kiosk mode":{"definition":"chế độ trình chiếu tự chạy hoặc điều khiển giới hạn","example":"Use reading view, choose Hide Slide, or switch to kiosk mode.","exampleTranslation":"Dùng chế độ đọc, ẩn một trang chiếu hoặc chuyển sang chế độ ki-ốt.","partOfSpeech":"Cụm danh từ"},"loop continuously":{"definition":"tùy chọn phát lại bài trình chiếu từ đầu sau khi kết thúc","example":"Embed video and embed audio, then set the slideshow to loop continuously.","exampleTranslation":"Nhúng video và âm thanh, rồi đặt trình chiếu lặp liên tục.","partOfSpeech":"Cụm động từ"},"embed video":{"definition":"nhúng video vào tệp bài thuyết trình","example":"Embed video and embed audio, then set the slideshow to loop continuously.","exampleTranslation":"Nhúng video và âm thanh, rồi đặt trình chiếu lặp liên tục.","partOfSpeech":"Cụm động từ"},"embed audio":{"definition":"nhúng âm thanh vào tệp bài thuyết trình","example":"Embed video and embed audio, then set the slideshow to loop continuously.","exampleTranslation":"Nhúng video và âm thanh, rồi đặt trình chiếu lặp liên tục.","partOfSpeech":"Cụm động từ"},"slide hyperlink":{"definition":"liên kết trên trang chiếu mở trang, tệp hoặc vị trí khác","example":"Add a slide hyperlink, export as video, or export as PDF.","exampleTranslation":"Thêm siêu liên kết trên trang chiếu, xuất thành video hoặc xuất thành PDF.","partOfSpeech":"Cụm danh từ"},"export as video":{"definition":"xuất bài thuyết trình thành tệp video","example":"Add a slide hyperlink, export as video, or export as PDF.","exampleTranslation":"Thêm siêu liên kết trên trang chiếu, xuất thành video hoặc xuất thành PDF.","partOfSpeech":"Cụm động từ"},"export as PDF":{"definition":"xuất bài thuyết trình thành tệp PDF","example":"Add a slide hyperlink, export as video, or export as PDF.","exampleTranslation":"Thêm siêu liên kết trên trang chiếu, xuất thành video hoặc xuất thành PDF.","partOfSpeech":"Cụm động từ"}},"wordCount":180,"topicCount":3}]}
