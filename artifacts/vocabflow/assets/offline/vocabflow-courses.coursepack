Id":"daily-actions","topicTitle":"Hoạt động hằng ngày","questions":[{"term":"get up","prompt":"Từ tiếng Anh nào có nghĩa “thức dậy”?","choices":["get up","finish","help","call"]},{"term":"wash","prompt":"Từ tiếng Anh nào có nghĩa “rửa”?","choices":["wash","close","start","finish"]},{"term":"clean","prompt":"Từ tiếng Anh nào có nghĩa “dọn dẹp hoặc làm sạch”?","choices":["clean","help","call","ask"]},{"term":"open","prompt":"Từ tiếng Anh nào có nghĩa “mở”?","choices":["open","call","ask","tell"]},{"term":"close","prompt":"Từ tiếng Anh nào có nghĩa “đóng”?","choices":["close","wash","clean","open"]},{"term":"start","prompt":"Từ tiếng Anh nào có nghĩa “bắt đầu”?","choices":["start","get up","wash","clean"]},{"term":"finish","prompt":"Từ tiếng Anh nào có nghĩa “hoàn thành hoặc kết thúc”?","choices":["finish","ask","tell","show"]},{"term":"help","prompt":"Từ tiếng Anh nào có nghĩa “giúp đỡ”?","choices":["help","call","ask","tell"]},{"term":"call","prompt":"Từ tiếng Anh nào có nghĩa “gọi điện”?","choices":["call","start","finish","help"]},{"term":"ask","prompt":"Từ tiếng Anh nào có nghĩa “hỏi”?","choices":["ask","wash","clean","open"]},{"term":"tell","prompt":"Từ tiếng Anh nào có nghĩa “nói hoặc kể cho ai”?","choices":["tell","finish","help","call"]},{"term":"show","prompt":"Từ tiếng Anh nào có nghĩa “cho xem hoặc chỉ ra”?","choices":["show","ask","tell","get up"]}]},{"id":"basic-vocabulary-a1-a2-v1-daily-actions-lesson-3","title":"Hoạt động hằng ngày · Tính chất và cảm xúc","focus":"Động từ và từ mô tả giúp người học nói về sinh hoạt thường ngày.","topicId":"daily-actions","topicTitle":"Hoạt động hằng ngày","questions":[{"term":"good","prompt":"Từ tiếng Anh nào có nghĩa “tốt”?","choices":["good","old","easy","difficult"]},{"term":"bad","prompt":"Từ tiếng Anh nào có nghĩa “xấu hoặc tệ”?","choices":["bad","big","small","new"]},{"term":"big","prompt":"Từ tiếng Anh nào có nghĩa “to”?","choices":["big","busy","good","bad"]},{"term":"small","prompt":"Từ tiếng Anh nào có nghĩa “nhỏ”?","choices":["small","easy","difficult","happy"]},{"term":"new","prompt":"Từ tiếng Anh nào có nghĩa “mới”?","choices":["new","easy","difficult","happy"]},{"term":"old","prompt":"Từ tiếng Anh nào có nghĩa “cũ hoặc già”?","choices":["old","tired","busy","good"]},{"term":"easy","prompt":"Từ tiếng Anh nào có nghĩa “dễ”?","choices":["easy","busy","good","bad"]},{"term":"difficult","prompt":"Từ tiếng Anh nào có nghĩa “khó”?","choices":["difficult","busy","good","bad"]},{"term":"happy","prompt":"Từ tiếng Anh nào có nghĩa “vui”?","choices":["happy","bad","big","small"]},{"term":"sad","prompt":"Từ tiếng Anh nào có nghĩa “buồn”?","choices":["sad","small","new","old"]},{"term":"tired","prompt":"Từ tiếng Anh nào có nghĩa “mệt”?","choices":["tired","easy","difficult","happy"]},{"term":"busy","prompt":"Từ tiếng Anh nào có nghĩa “bận”?","choices":["busy","new","old","easy"]}]},{"id":"basic-vocabulary-a1-a2-v1-daily-actions-lesson-4","title":"Hoạt động hằng ngày · Từ hỏi và từ nối","focus":"Động từ và từ mô tả giúp người học nói về sinh hoạt thường ngày.","topicId":"daily-actions","topicTitle":"Hoạt động hằng ngày","questions":[{"term":"who","prompt":"Từ tiếng Anh nào có nghĩa “ai”?","choices":["who","this","that","these"]},{"term":"what","prompt":"Từ tiếng Anh nào có nghĩa “cái gì”?","choices":["what","when","why","how"]},{"term":"where","prompt":"Từ tiếng Anh nào có nghĩa “ở đâu”?","choices":["where","these","those","and"]},{"term":"when","prompt":"Từ tiếng Anh nào có nghĩa “khi nào”?","choices":["when","but","who","what"]},{"term":"why","prompt":"Từ tiếng Anh nào có nghĩa “tại sao”?","choices":["why","how","this","that"]},{"term":"how","prompt":"Từ tiếng Anh nào có nghĩa “như thế nào”?","choices":["how","this","that","these"]},{"term":"this","prompt":"Từ tiếng Anh nào có nghĩa “cái này”?","choices":["this","and","but","who"]},{"term":"that","prompt":"Từ tiếng Anh nào có nghĩa “cái kia”?","choices":["that","why","how","this"]},{"term":"these","prompt":"Từ tiếng Anh nào có nghĩa “những cái này”?","choices":["these","what","where","when"]},{"term":"those","prompt":"Từ tiếng Anh nào có nghĩa “những cái kia”?","choices":["those","these","and","but"]},{"term":"and","prompt":"Từ tiếng Anh nào có nghĩa “và”?","choices":["and","why","how","this"]},{"term":"but","prompt":"Từ tiếng Anh nào có nghĩa “nhưng”?","choices":["but","and","who","what"]}]}],"entriesByTerm":{"person":{"definition":"người","example":"There is one person waiting outside.","exampleTranslation":"Có một người đang đợi bên ngoài."},"people":{"definition":"mọi người","example":"Many people come to this park on weekends.","exampleTranslation":"Nhiều người đến công viên này vào cuối tuần."},"man":{"definition":"đàn ông","example":"That man is my English teacher.","exampleTranslation":"Người đàn ông đó là giáo viên tiếng Anh của tôi."},"woman":{"definition":"phụ nữ","example":"The woman on the bus gave me her seat.","exampleTranslation":"Người phụ nữ trên xe buýt đã nhường ghế cho tôi."},"child":{"definition":"trẻ em","example":"The child is playing with a red ball.","exampleTranslation":"Đứa trẻ đang chơi với một quả bóng đỏ."},"boy":{"definition":"cậu bé","example":"The boy is reading a book under the tree.","exampleTranslation":"Cậu bé đang đọc sách dưới gốc cây."},"girl":{"definition":"cô bé","example":"The girl has a beautiful blue bag.","exampleTranslation":"Cô bé có một chiếc túi màu xanh rất đẹp."},"family":{"definition":"gia đình","example":"My family lives in a small town.","exampleTranslation":"Gia đình tôi sống ở một thị trấn nhỏ."},"mother":{"definition":"mẹ","example":"My mother cooks dinner every evening.","exampleTranslation":"Mẹ tôi nấu bữa tối mỗi tối."},"father":{"definition":"bố","example":"My father drives to work every day.","exampleTranslation":"Bố tôi lái xe đi làm mỗi ngày."},"parent":{"definition":"cha hoặc mẹ","example":"Each parent must sign this form.","exampleTranslation":"Mỗi phụ huynh phải ký vào mẫu đơn này."},"friend":{"definition":"bạn","example":"My best friend lives next door.","exampleTranslation":"Bạn thân nhất của tôi sống ngay nhà bên cạnh."},"sister":{"definition":"chị hoặc em gái","example":"My sister is studying at university.","exampleTranslation":"Chị gái tôi đang học đại học."},"brother":{"definition":"anh hoặc em trai","example":"My brother plays football on Sundays.","exampleTranslation":"Anh trai tôi chơi bóng đá vào các ngày Chủ nhật."},"son":{"definition":"con trai","example":"Their son is five years old.","exampleTranslation":"Con trai của họ năm tuổi."},"daughter":{"definition":"con gái","example":"She has a daughter and a son.","exampleTranslation":"Cô ấy có một con gái và một con trai."},"husband":{"definition":"chồng","example":"Her husband works in a bank.","exampleTranslation":"Chồng cô ấy làm việc ở ngân hàng."},"wife":{"definition":"vợ","example":"His wife is a very kind doctor.","exampleTranslation":"Vợ anh ấy là một bác sĩ rất tốt bụng."},"baby":{"definition":"em bé","example":"The baby is sleeping in the bedroom.","exampleTranslation":"Em bé đang ngủ trong phòng ngủ."},"aunt":{"definition":"cô, dì hoặc bác gái","example":"My aunt makes the best cakes.","exampleTranslation":"Dì tôi làm những chiếc bánh ngon nhất."},"uncle":{"definition":"chú, cậu hoặc bác trai","example":"My uncle lives in another city.","exampleTranslation":"Chú tôi sống ở một thành phố khác."},"cousin":{"definition":"anh, chị hoặc em họ","example":"My cousin and I are the same age.","exampleTranslation":"Anh họ của tôi và tôi bằng tuổi nhau."},"grandmother":{"definition":"bà","example":"My grandmother tells us stories at night.","exampleTranslation":"Bà tôi kể chuyện cho chúng tôi nghe vào buổi tối."},"grandfather":{"definition":"ông","example":"My grandfather likes to walk in the morning.","exampleTranslation":"Ông tôi thích đi bộ vào buổi sáng."},"guest":{"definition":"khách","example":"The guest arrived at six o'clock.","exampleTranslation":"Vị khách đã đến lúc sáu giờ."},"customer":{"definition":"khách hàng","example":"The customer asked about the price.","exampleTranslation":"Khách hàng đã hỏi về giá."},"partner":{"definition":"bạn đời hoặc đối tác","example":"She started a company with her partner.","exampleTranslation":"Cô ấy đã thành lập một công ty cùng với đối tác của mình."},"colleague":{"definition":"đồng nghiệp","example":"My colleague helped me finish the report.","exampleTranslation":"Đồng nghiệp đã giúp tôi hoàn thành báo cáo."},"adult":{"definition":"người trưởng thành","example":"An adult must come with each child.","exampleTranslation":"Mỗi trẻ em phải đi cùng một người trưởng thành."},"teenager":{"definition":"thiếu niên","example":"The teenager spends hours on his phone.","exampleTranslation":"Cậu thiếu niên dành hàng giờ trên điện thoại."},"couple":{"definition":"cặp đôi","example":"The couple walked along the beach.","exampleTranslation":"Cặp đôi đi dạo dọc bờ biển."},"marriage":{"definition":"hôn nhân","example":"Their marriage is very happy.","exampleTranslation":"Cuộc hôn nhân của họ rất hạnh phúc."},"surname":{"definition":"họ","example":"Please write your surname on the form.","exampleTranslation":"Vui lòng viết họ của bạn vào mẫu đơn."},"address":{"definition":"địa chỉ","example":"What is your home address?","exampleTranslation":"Địa chỉ nhà của bạn là gì?"},"age":{"definition":"tuổi","example":"What is your age?","exampleTranslation":"Bạn bao nhiêu tuổi?"},"birthday":{"definition":"sinh nhật","example":"Today is my birthday.","exampleTranslation":"Hôm nay là sinh nhật của tôi."},"house":{"definition":"ngôi nhà","example":"They bought a big house near the river.","exampleTranslation":"Họ đã mua một ngôi nhà lớn gần dòng sông."},"home":{"definition":"nhà, nơi ở","example":"I want to go home now.","exampleTranslation":"Bây giờ tôi muốn về nhà."},"apartment":{"definition":"căn hộ","example":"We rent a small apartment in the city centre.","exampleTranslation":"Chúng tôi thuê một căn hộ nhỏ ở trung tâm thành phố."},"room":{"definition":"phòng","example":"My room is on the second floor.","exampleTranslation":"Phòng của tôi ở tầng hai."},"kitchen":{"definition":"nhà bếp","example":"She is making tea in the kitchen.","exampleTranslation":"Cô ấy đang pha trà trong nhà bếp."},"bedroom":{"definition":"phòng ngủ","example":"There is a large bed in my bedroom.","exampleTranslation":"Có một chiếc giường lớn trong phòng ngủ của tôi."},"bathroom":{"definition":"phòng tắm","example":"The bathroom is next to the kitchen.","exampleTranslation":"Phòng tắm nằm cạnh nhà bếp."},"door":{"definition":"cửa ra vào","example":"Please close the door when you leave.","exampleTranslation":"Làm ơn đóng cửa khi bạn ra ngoài."},"window":{"definition":"cửa sổ","example":"Could you open the window? It is hot.","exampleTranslation":"Bạn có thể mở cửa sổ được không? Trời nóng quá."},"wall":{"definition":"bức tường","example":"There is a picture on the wall.","exampleTranslation":"Có một bức tranh trên tường."},"floor":{"definition":"sàn nhà","example":"The floor is wet, so be careful.","exampleTranslation":"Sàn nhà đang ướt, nên hãy cẩn thận."},"garden":{"definition":"khu vườn","example":"They have a small garden behind the house.","exampleTranslation":"Họ có một khu vườn nhỏ phía sau nhà."},"table":{"definition":"cái bàn","example":"Put the books on the table.","exampleTranslation":"Hãy đặt những cuốn sách lên bàn."},"chair":{"definition":"cái ghế","example":"Please sit on that chair.","exampleTranslation":"Xin hãy ngồi lên chiếc ghế đó."},"bed":{"definition":"cái giường","example":"The bed is soft and comfortable.","exampleTranslation":"Chiếc giường mềm và thoải mái."},"sofa":{"definition":"ghế sô-pha","example":"We watch television on the sofa.","exampleTranslation":"Chúng tôi xem ti vi trên ghế sô-pha."},"desk":{"definition":"bàn làm việc hoặc bàn học","example":"He is working at his desk.","exampleTranslation":"Anh ấy đang làm việc ở bàn làm việc của mình."},"lamp":{"definition":"đèn","example":"Please turn on the lamp.","exampleTranslation":"Làm ơn bật đèn lên."},"mirror":{"definition":"gương","example":"She looked at herself in the mirror.","exampleTranslation":"Cô ấy nhìn mình trong gương."},"key":{"definition":"chìa khóa","example":"I can't find my key.","exampleTranslation":"Tôi không tìm thấy chìa khóa của mình."},"cup":{"definition":"cái cốc","example":"I would like a cup of tea.","exampleTranslation":"Tôi muốn một cốc trà."},"plate":{"definition":"cái đĩa","example":"She put the food on a white plate.","exampleTranslation":"Cô ấy đặt thức ăn lên một chiếc đĩa trắng."},"spoon":{"definition":"cái thìa","example":"Use a spoon to eat the soup.","exampleTranslation":"Hãy dùng thìa để ăn súp."},"fork":{"definition":"cái nĩa","example":"He eats noodles with a fork.","exampleTranslation":"Anh ấy ăn mì bằng nĩa."},"fridge":{"definition":"tủ lạnh","example":"There is some milk in the fridge.","exampleTranslation":"Có một ít sữa trong tủ lạnh."},"oven":{"definition":"lò nướng","example":"The cake is in the oven.","exampleTranslation":"Chiếc bánh đang ở trong lò nướng."},"sink":{"definition":"bồn rửa","example":"The dirty dishes are in the sink.","exampleTranslation":"Những chiếc bát đĩa bẩn đang ở trong bồn rửa."},"shower":{"definition":"vòi sen","example":"I take a shower every morning.","exampleTranslation":"Tôi tắm vòi sen mỗi buổi sáng."},"toilet":{"definition":"nhà vệ sinh hoặc bồn cầu","example":"Where is the toilet, please?","exampleTranslation":"Làm ơn cho hỏi nhà vệ sinh ở đâu?"},"towel":{"definition":"khăn tắm","example":"Please bring me a clean towel.","exampleTranslation":"Làm ơn mang cho tôi một chiếc khăn tắm sạch."},"soap":{"definition":"xà phòng","example":"Wash your hands with soap and water.","exampleTranslation":"Hãy rửa tay bằng xà phòng và nước."},"blanket":{"definition":"chăn","example":"I need a warm blanket tonight.","exampleTranslation":"Tối nay tôi cần một chiếc chăn ấm."},"pillow":{"definition":"gối","example":"This pillow is very soft.","exampleTranslation":"Chiếc gối này rất mềm."},"shelf":{"definition":"kệ","example":"Put the books on the top shelf.","exampleTranslation":"Hãy đặt những cuốn sách lên kệ trên cùng."},"fan":{"definition":"quạt","example":"Turn on the fan, please. It is hot.","exampleTranslation":"Làm ơn bật quạt lên. Trời nóng quá."},"drawer":{"definition":"ngăn kéo","example":"The pens are in the top drawer.","exampleTranslation":"Những chiếc bút ở trong ngăn kéo trên cùng."},"bread":{"definition":"bánh mì","example":"I eat bread for breakfast.","exampleTranslation":"Tôi ăn bánh mì vào bữa sáng."},"rice":{"definition":"cơm hoặc gạo","example":"We eat rice every day.","exampleTranslation":"Chúng tôi ăn cơm mỗi ngày."},"egg":{"definition":"trứng","example":"I had an egg for breakfast.","exampleTranslation":"Tôi đã ăn một quả trứng vào bữa sáng."},"milk":{"definition":"sữa","example":"She drinks a glass of milk every morning.","exampleTranslation":"Cô ấy uống một ly sữa mỗi buổi sáng."},"water":{"definition":"nước","example":"Please drink more water.","exampleTranslation":"Hãy uống nhiều nước hơn."},"tea":{"definition":"trà","example":"Would you like some tea?","exampleTranslation":"Bạn có muốn dùng một chút trà không?"},"coffee":{"definition":"cà phê","example":"He drinks coffee before work.","exampleTranslation":"Anh ấy uống cà phê trước khi đi làm."},"fruit":{"definition":"trái cây","example":"Fresh fruit is good for your health.","exampleTranslation":"Trái cây tươi tốt cho sức khỏe của bạn."},"apple":{"definition":"quả táo","example":"She ate a red apple after lunch.","exampleTranslation":"Cô ấy ăn một quả táo đỏ sau bữa trưa."},"banana":{"definition":"quả chuối","example":"I eat a banana every morning.","exampleTranslation":"Tôi ăn một quả chuối mỗi buổi sáng."},"orange":{"definition":"quả cam","example":"She peeled an orange for her son.","exampleTranslation":"Cô ấy bóc một quả cam cho con trai mình."},"vegetable":{"definition":"rau củ","example":"We should eat more vegetables.","exampleTranslation":"Chúng ta nên ăn nhiều rau củ hơn."},"chicken":{"definition":"thịt gà","example":"We had chicken and rice for dinner.","exampleTranslation":"Chúng tôi đã ăn gà và cơm vào bữa tối."},"fish":{"definition":"cá","example":"My father catches fish at the lake.","exampleTranslation":"Bố tôi câu cá ở hồ."},"meat":{"definition":"thịt","example":"She doesn't eat meat.","exampleTranslation":"Cô ấy không ăn thịt."},"soup":{"definition":"canh hoặc súp","example":"The soup is hot, so be careful.","exampleTranslation":"Súp đang nóng nên hãy cẩn thận."},"salad":{"definition":"món rau trộn","example":"I made a fresh salad for lunch.","exampleTranslation":"Tôi đã làm một món salad tươi cho bữa trưa."},"cheese":{"definition":"phô mai","example":"He put some cheese on the bread.","exampleTranslation":"Anh ấy cho một ít phô mai lên bánh mì."},"sugar":{"definition":"đường","example":"I don't take sugar in my tea.","exampleTranslation":"Tôi không cho đường vào trà."},"salt":{"definition":"muối","example":"This soup needs a little salt.","exampleTranslation":"Món súp này cần thêm một chút muối."},"oil":{"definition":"dầu ăn","example":"She fried the fish in hot oil.","exampleTranslation":"Cô ấy chiên cá trong dầu nóng."},"cook":{"definition":"nấu ăn","example":"I like to cook dinner for my family.","exampleTranslation":"Tôi thích nấu bữa tối cho gia đình mình."},"eat":{"definition":"ăn","example":"We eat lunch at noon.","exampleTranslation":"Chúng tôi ăn bữa trưa vào buổi trưa."},"drink":{"definition":"uống","example":"I drink two glasses of water a day.","exampleTranslation":"Tôi uống hai ly nước mỗi ngày."},"buy":{"definition":"mua","example":"I want to buy a new phone.","exampleTranslation":"Tôi muốn mua một chiếc điện thoại mới."},"sell":{"definition":"bán","example":"They sell fresh vegetables at the market.","exampleTranslation":"Họ bán rau củ tươi ở chợ."},"price":{"definition":"giá","example":"What is the price of this shirt?","exampleTranslation":"Giá của chiếc áo sơ mi này là bao nhiêu?"},"money":{"definition":"tiền","example":"I don't have much money.","exampleTranslation":"Tôi không có nhiều tiền."},"cash":{"definition":"tiền mặt","example":"Do you take cash or card?","exampleTranslation":"Bạn nhận tiền mặt hay thẻ?"},"card":{"definition":"thẻ","example":"Can I pay by card?","exampleTranslation":"Tôi có thể trả bằng thẻ không?"},"shop":{"definition":"cửa hàng","example":"The shop opens at nine o'clock.","exampleTranslation":"Cửa hàng mở cửa lúc chín giờ."},"market":{"definition":"chợ","example":"We buy fruit at the market.","exampleTranslation":"Chúng tôi mua trái cây ở chợ."},"store":{"definition":"cửa hàng","example":"She works in a clothing store.","exampleTranslation":"Cô ấy làm việc ở một cửa hàng quần áo."},"cheap":{"definition":"rẻ","example":"This bag is cheap, so I will buy it.","exampleTranslation":"Chiếc túi này rẻ nên tôi sẽ mua nó."},"expensive":{"definition":"đắt","example":"That car is too expensive for me.","exampleTranslation":"Chiếc xe đó quá đắt đối với tôi."},"change":{"definition":"tiền thừa được trả lại","example":"Keep the change.","exampleTranslation":"Hãy giữ lại tiền thừa."},"body":{"definition":"cơ thể","example":"The human body needs water.","exampleTranslation":"Cơ thể con người cần nước."},"head":{"definition":"đầu","example":"He hit his head on the door.","exampleTranslation":"Anh ấy đập đầu vào cửa."},"face":{"definition":"khuôn mặt","example":"Wash your face before bed.","exampleTranslation":"Hãy rửa mặt trước khi đi ngủ."},"hair":{"definition":"tóc","example":"She has long black hair.","exampleTranslation":"Cô ấy có mái tóc đen dài."},"eye":{"definition":"mắt","example":"He has a small cut near his eye.","exampleTranslation":"Anh ấy có một vết cắt nhỏ gần mắt."},"ear":{"definition":"tai","example":"I can't hear well with my left ear.","exampleTranslation":"Tôi nghe không rõ bằng tai trái."},"nose":{"definition":"mũi","example":"He has a cold, so his nose is red.","exampleTranslation":"Anh ấy bị cảm nên mũi bị đỏ."},"mouth":{"definition":"miệng","example":"Please open your mouth.","exampleTranslation":"Làm ơn há miệng ra."},"tooth":{"definition":"răng","example":"I brush my teeth twice a day.","exampleTranslation":"Tôi đánh răng hai lần mỗi ngày."},"hand":{"definition":"bàn tay","example":"Wash your hands before eating.","exampleTranslation":"Hãy rửa tay trước khi ăn."},"arm":{"definition":"cánh tay","example":"He broke his arm playing football.","exampleTranslation":"Anh ấy bị gãy tay khi chơi bóng đá."},"leg":{"definition":"chân","example":"My leg hurts after the long walk.","exampleTranslation":"Chân tôi đau sau chuyến đi bộ dài."},"foot":{"definition":"bàn chân","example":"She hurt her foot while running.","exampleTranslation":"Cô ấy bị đau chân khi đang chạy."},"back":{"definition":"lưng","example":"I have a pain in my back.","exampleTranslation":"Tôi bị đau lưng."},"heart":{"definition":"tim","example":"His heart beats very fast.","exampleTranslation":"Tim anh ấy đập rất nhanh."},"stomach":{"definition":"dạ dày hoặc bụng","example":"My stomach hurts after lunch.","exampleTranslation":"Bụng tôi đau sau bữa trưa."},"finger":{"definition":"ngón tay","example":"She cut her finger with a knife.","exampleTranslation":"Cô ấy bị đứt ngón tay bằng con dao."},"shoulder":{"definition":"vai","example":"He carried the bag on his shoulder.","exampleTranslation":"Anh ấy đeo chiếc túi trên vai."},"neck":{"definition":"cổ","example":"She wears a scarf around her neck.","exampleTranslation":"Cô ấy quàng một chiếc khăn quanh cổ."},"skin":{"definition":"da","example":"The sun can hurt your skin.","exampleTranslation":"Ánh nắng có thể làm tổn thương làn da của bạn."},"blood":{"definition":"máu","example":"There was blood on his hand.","exampleTranslation":"Có máu trên tay anh ấy."},"pain":{"definition":"cơn đau","example":"I feel a sharp pain in my knee.","exampleTranslation":"Tôi cảm thấy một cơn đau nhói ở đầu gối."},"sick":{"definition":"ốm","example":"I stayed at home because I was sick.","exampleTranslation":"Tôi ở nhà vì bị ốm."},"healthy":{"definition":"khỏe mạnh","example":"He eats well and stays healthy.","exampleTranslation":"Anh ấy ăn uống tốt và luôn khỏe mạnh."},"patient":{"definition":"bệnh nhân","example":"The patient is waiting for the doctor.","exampleTranslation":"Bệnh nhân đang đợi bác sĩ."},"nurse":{"definition":"y tá","example":"The nurse took my temperature.","exampleTranslation":"Y tá đã đo nhiệt độ cho tôi."},"clinic":{"definition":"phòng khám","example":"The clinic opens at eight o'clock.","exampleTranslation":"Phòng khám mở cửa lúc tám giờ."},"hospital":{"definition":"bệnh viện","example":"He was taken to the hospital last night.","exampleTranslation":"Anh ấy đã được đưa đến bệnh viện đêm qua."},"medicine":{"definition":"thuốc","example":"Take this medicine twice a day.","exampleTranslation":"Hãy uống thuốc này hai lần mỗi ngày."},"rest":{"definition":"nghỉ ngơi","example":"You should rest after the long trip.","exampleTranslation":"Bạn nên nghỉ ngơi sau chuyến đi dài."},"sleep":{"definition":"ngủ","example":"I sleep for eight hours every night.","exampleTranslation":"Tôi ngủ tám tiếng mỗi đêm."},"exercise":{"definition":"tập thể dục","example":"I exercise every morning before work.","exampleTranslation":"Tôi tập thể dục mỗi sáng trước khi đi làm."},"breathe":{"definition":"thở","example":"It is hard to breathe in this smoke.","exampleTranslation":"Rất khó thở trong làn khói này."},"cough":{"definition":"ho","example":"She has a bad cough.","exampleTranslation":"Cô ấy bị ho nặng."},"fever":{"definition":"cơn sốt","example":"The child has a high fever.","exampleTranslation":"Đứa trẻ bị sốt cao."},"headache":{"definition":"đau đầu","example":"I have a headache, so I'm going to lie down.","exampleTranslation":"Tôi bị đau đầu nên tôi sẽ đi nằm một lát."},"school":{"definition":"trường học","example":"My brother goes to school by bike.","exampleTranslation":"Anh trai tôi đi học bằng xe đạp."},"classroom":{"definition":"phòng học","example":"The classroom is on the third floor.","exampleTranslation":"Phòng học ở tầng ba."},"class":{"definition":"lớp học","example":"There are thirty students in my class.","exampleTranslation":"Có ba mươi học sinh trong lớp của tôi."},"lesson":{"definition":"bài học","example":"Today's lesson is about food.","exampleTranslation":"Bài học hôm nay nói về đồ ăn."},"question":{"definition":"câu hỏi","example":"Can I ask you a question?","exampleTranslation":"Tôi có thể hỏi bạn một câu hỏi được không?"},"answer":{"definition":"câu trả lời","example":"Please write your answer here.","exampleTranslation":"Vui lòng viết câu trả lời của bạn vào đây."},"test":{"definition":"bài kiểm tra","example":"We have a test on Friday.","exampleTranslation":"Chúng tôi có một bài kiểm tra vào thứ Sáu."},"exam":{"definition":"kỳ thi","example":"The final exam is next week.","exampleTranslation":"Kỳ thi cuối kỳ diễn ra vào tuần sau."},"homework":{"definition":"bài tập về nhà","example":"I finish my homework before dinner.","exampleTranslation":"Tôi làm xong bài tập về nhà trước bữa tối."},"learn":{"definition":"học","example":"I want to learn English.","exampleTranslation":"Tôi muốn học tiếng Anh."},"study":{"definition":"học tập hoặc nghiên cứu","example":"I study for two hours every evening.","exampleTranslation":"Tôi học hai tiếng mỗi buổi tối."},"write":{"definition":"viết","example":"Please write your name here.","exampleTranslation":"Vui lòng viết tên của bạn vào đây."},"read":{"definition":"đọc","example":"I like to read before bed.","exampleTranslation":"Tôi thích đọc sách trước khi đi ngủ."},"listen":{"definition":"nghe","example":"Please listen carefully.","exampleTranslation":"Hãy lắng nghe cẩn thận."},"speak":{"definition":"nói","example":"Can you speak more slowly?","exampleTranslation":"Bạn có thể nói chậm hơn được không?"},"teacher":{"definition":"giáo viên","example":"Our teacher is very friendly.","exampleTranslation":"Giáo viên của chúng tôi rất thân thiện."},"student":{"definition":"học sinh hoặc sinh viên","example":"Each student has a new book.","exampleTranslation":"Mỗi học sinh có một cuốn sách mới."},"classmate":{"definition":"bạn cùng lớp","example":"My classmate lent me a pen.","exampleTranslation":"Bạn cùng lớp đã cho tôi mượn một chiếc bút."},"notebook":{"definition":"vở ghi","example":"Write the new words in your notebook.","exampleTranslation":"Hãy viết các từ mới vào vở ghi của bạn."},"pencil":{"definition":"bút chì","example":"Please use a pencil for the test.","exampleTranslation":"Vui lòng dùng bút chì để làm bài kiểm tra."},"ruler":{"definition":"thước kẻ","example":"Use a ruler to draw a straight line.","exampleTranslation":"Hãy dùng thước kẻ để vẽ một đường thẳng."},"course":{"definition":"khóa học","example":"I am taking a cooking course.","exampleTranslation":"Tôi đang học một khóa học nấu ăn."},"subject":{"definition":"môn học","example":"My favourite subject is science.","exampleTranslation":"Môn học yêu thích của tôi là khoa học."},"grade":{"definition":"điểm số","example":"She got a good grade on the test.","exampleTranslation":"Cô ấy đã được điểm cao trong bài kiểm tra."},"work":{"definition":"làm việc","example":"I work from nine to five.","exampleTranslation":"Tôi làm việc từ chín giờ đến năm giờ."},"job":{"definition":"công việc hoặc nghề nghiệp","example":"He is looking for a new job.","exampleTranslation":"Anh ấy đang tìm một công việc mới."},"office":{"definition":"văn phòng","example":"Her office is on the fifth floor.","exampleTranslation":"Văn phòng của cô ấy ở tầng năm."},"meeting":{"definition":"cuộc họp","example":"We have a meeting at ten o'clock.","exampleTranslation":"Chúng tôi có một cuộc họp lúc mười giờ."},"email":{"definition":"thư điện tử","example":"I will send you an email tomorrow.","exampleTranslation":"Ngày mai tôi sẽ gửi cho bạn một email."},"computer":{"definition":"máy tính","example":"I use my computer for work.","exampleTranslation":"Tôi dùng máy tính để làm việc."},"file":{"definition":"tệp","example":"Please save the file on your desktop.","exampleTranslation":"Vui lòng lưu tệp này trên màn hình nền của bạn."},"task":{"definition":"nhiệm vụ","example":"This task is easy, so I can finish it today.","exampleTranslation":"Nhiệm vụ này dễ nên tôi có thể hoàn thành nó trong hôm nay."},"team":{"definition":"nhóm","example":"Our team works well together.","exampleTranslation":"Nhóm của chúng tôi làm việc với nhau rất tốt."},"manager":{"definition":"quản lý","example":"The manager is in a meeting now.","exampleTranslation":"Quản lý hiện đang họp."},"worker":{"definition":"người lao động","example":"Each worker wears a safety helmet.","exampleTranslation":"Mỗi công nhân đều đội một chiếc mũ bảo hộ."},"company":{"definition":"công ty","example":"She works for a large company.","exampleTranslation":"Cô ấy làm việc cho một công ty lớn."},"time":{"definition":"thời gian","example":"I don't have enough time today.","exampleTranslation":"Hôm nay tôi không có đủ thời gian."},"day":{"definition":"ngày","example":"Which day is the party?","exampleTranslation":"Bữa tiệc diễn ra vào ngày nào?"},"week":{"definition":"tuần","example":"I visit my grandparents once a week.","exampleTranslation":"Tôi thăm ông bà một lần mỗi tuần."},"month":{"definition":"tháng","example":"There are twelve months in a year.","exampleTranslation":"Một năm có mười hai tháng."},"year":{"definition":"năm","example":"I was born in this year.","exampleTranslation":"Tôi sinh ra vào năm này."},"today":{"definition":"hôm nay","example":"Today is a sunny day.","exampleTranslation":"Hôm nay là một ngày nắng."},"tomorrow":{"definition":"ngày mai","example":"I will call you tomorrow.","exampleTranslation":"Ngày mai tôi sẽ gọi cho bạn."},"yesterday":{"definition":"hôm qua","example":"I saw him yesterday.","exampleTranslation":"Hôm qua tôi đã gặp anh ấy."},"morning":{"definition":"buổi sáng","example":"I drink coffee every morning.","exampleTranslation":"Tôi uống cà phê mỗi buổi sáng."},"afternoon":{"definition":"buổi chiều","example":"We have a class this afternoon.","exampleTranslation":"Chiều nay chúng tôi có một buổi học."},"evening":{"definition":"buổi tối","example":"We usually eat dinner in the evening.","exampleTranslation":"Chúng tôi thường ăn tối vào buổi tối."},"night":{"definition":"ban đêm","example":"The stars are bright at night.","exampleTranslation":"Những vì sao sáng rực vào ban đêm."},"Monday":{"definition":"thứ Hai","example":"I go to the gym on Monday.","exampleTranslation":"Tôi đến phòng tập vào thứ Hai."},"Tuesday":{"definition":"thứ Ba","example":"We have an English class on Tuesday.","exampleTranslation":"Chúng tôi có một buổi học tiếng Anh vào thứ Ba."},"Wednesday":{"definition":"thứ Tư","example":"The meeting is on Wednesday.","exampleTranslation":"Cuộc họp diễn ra vào thứ Tư."},"Thursday":{"definition":"thứ Năm","example":"I have a dentist appointment on Thursday.","exampleTranslation":"Tôi có hẹn với nha sĩ vào thứ Năm."},"Friday":{"definition":"thứ Sáu","example":"We are going to the cinema on Friday.","exampleTranslation":"Chúng tôi sẽ đi xem phim vào thứ Sáu."},"Saturday":{"definition":"thứ Bảy","example":"We usually go shopping on Saturday.","exampleTranslation":"Chúng tôi thường đi mua sắm vào thứ Bảy."},"Sunday":{"definition":"Chủ nhật","example":"My family has lunch together on Sunday.","exampleTranslation":"Gia đình tôi cùng ăn trưa vào Chủ nhật."},"hour":{"definition":"giờ","example":"The film lasts one hour.","exampleTranslation":"Bộ phim kéo dài một tiếng."},"minute":{"definition":"phút","example":"Wait a minute, please.","exampleTranslation":"Xin hãy đợi một phút."},"early":{"definition":"sớm","example":"I get up early every day.","exampleTranslation":"Tôi thức dậy sớm mỗi ngày."},"late":{"definition":"muộn","example":"Sorry, I am late for the meeting.","exampleTranslation":"Xin lỗi, tôi đến muộn cuộc họp."},"weekend":{"definition":"cuối tuần","example":"What are you doing this weekend?","exampleTranslation":"Cuối tuần này bạn định làm gì?"},"spring":{"definition":"mùa xuân","example":"Flowers bloom in spring.","exampleTranslation":"Hoa nở vào mùa xuân."},"summer":{"definition":"mùa hè","example":"It is very hot in summer.","exampleTranslation":"Trời rất nóng vào mùa hè."},"autumn":{"definition":"mùa thu","example":"The leaves fall in autumn.","exampleTranslation":"Lá rụng vào mùa thu."},"winter":{"definition":"mùa đông","example":"It is cold and dark in winter.","exampleTranslation":"Trời lạnh và tối vào mùa đông."},"weather":{"definition":"thời tiết","example":"The weather is nice today.","exampleTranslation":"Thời tiết hôm nay đẹp."},"rain":{"definition":"mưa","example":"It will rain this afternoon.","exampleTranslation":"Chiều nay trời sẽ mưa."},"snow":{"definition":"tuyết","example":"It snows a lot in winter here.","exampleTranslation":"Ở đây tuyết rơi nhiều vào mùa đông."},"wind":{"definition":"gió","example":"The wind is strong today.","exampleTranslation":"Hôm nay gió rất mạnh."},"sun":{"definition":"mặt trời","example":"The sun is shining brightly.","exampleTranslation":"Mặt trời đang chiếu sáng rực rỡ."},"sky":{"definition":"bầu trời","example":"The sky is clear and blue.","exampleTranslation":"Bầu trời trong và xanh."},"cloud":{"definition":"đám mây","example":"A dark cloud covered the sun.","exampleTranslation":"Một đám mây đen che khuất mặt trời."},"season":{"definition":"mùa","example":"Summer is my favourite season.","exampleTranslation":"Mùa hè là mùa tôi yêu thích nhất."},"street":{"definition":"đường phố","example":"There are many shops on this street.","exampleTranslation":"Có nhiều cửa hàng trên con phố này."},"road":{"definition":"con đường","example":"This road leads to the beach.","exampleTranslation":"Con đường này dẫn ra bãi biển."},"bridge":{"definition":"cây cầu","example":"We walked across the old bridge.","exampleTranslation":"Chúng tôi đi bộ qua cây cầu cũ."},"station":{"definition":"nhà ga","example":"The train station is near my house.","exampleTranslation":"Nhà ga ở gần nhà tôi."},"airport":{"definition":"sân bay","example":"We arrived at the airport two hours early.","exampleTranslation":"Chúng tôi đến sân bay sớm hai tiếng."},"bus":{"definition":"xe buýt","example":"I take the bus to school.","exampleTranslation":"Tôi đi xe buýt đến trường."},"train":{"definition":"tàu hỏa","example":"The train leaves at eight o'clock.","exampleTranslation":"Tàu hỏa khởi hành lúc tám giờ."},"taxi":{"definition":"xe taxi","example":"Let's take a taxi to the hotel.","exampleTranslation":"Chúng ta hãy đi taxi đến khách sạn."},"bicycle":{"definition":"xe đạp","example":"She rides her bicycle to work.","exampleTranslation":"Cô ấy đạp xe đạp đi làm."},"car":{"definition":"ô tô","example":"My father bought a new car.","exampleTranslation":"Bố tôi đã mua một chiếc ô tô mới."},"ticket":{"definition":"vé","example":"I need to buy a ticket for the train.","exampleTranslation":"Tôi cần mua một vé tàu."},"map":{"definition":"bản đồ","example":"Can you show me the map?","exampleTranslation":"Bạn có thể chỉ cho tôi xem bản đồ không?"},"hotel":{"definition":"khách sạn","example":"We stayed at a small hotel near the sea.","exampleTranslation":"Chúng tôi ở một khách sạn nhỏ gần biển."},"restaurant":{"definition":"nhà hàng","example":"We had dinner at a Japanese restaurant.","exampleTranslation":"Chúng tôi đã ăn tối ở một nhà hàng Nhật."},"cafe":{"definition":"quán cà phê","example":"Let's meet at the cafe at five.","exampleTranslation":"Chúng ta hãy gặp nhau ở quán cà phê lúc năm giờ."},"bank":{"definition":"ngân hàng","example":"I need to go to the bank.","exampleTranslation":"Tôi cần đến ngân hàng."},"post office":{"definition":"bưu điện","example":"I went to the post office to send a letter.","exampleTranslation":"Tôi đã đến bưu điện để gửi một lá thư."},"park":{"definition":"công viên","example":"Children are playing in the park.","exampleTranslation":"Bọn trẻ đang chơi trong công viên."},"supermarket":{"definition":"siêu thị","example":"I buy food at the supermarket on Saturdays.","exampleTranslation":"Tôi mua thực phẩm ở siêu thị vào các ngày thứ Bảy."},"museum":{"definition":"bảo tàng","example":"The museum is closed on Mondays.","exampleTranslation":"Bảo tàng đóng cửa vào các ngày thứ Hai."},"library":{"definition":"thư viện","example":"I borrowed three books from the library.","exampleTranslation":"Tôi đã mượn ba cuốn sách từ thư viện."},"beach":{"definition":"bãi biển","example":"We swim at the beach every summer.","exampleTranslation":"Chúng tôi bơi ở bãi biển mỗi mùa hè."},"village":{"definition":"ngôi làng","example":"My grandparents live in a quiet village.","exampleTranslation":"Ông bà tôi sống trong một ngôi làng yên tĩnh."},"town":{"definition":"thị trấn","example":"This town is small but beautiful.","exampleTranslation":"Thị trấn này nhỏ nhưng đẹp."},"left":{"definition":"bên trái","example":"Turn left at the corner.","exampleTranslation":"Hãy rẽ trái ở góc đường."},"right":{"definition":"bên phải","example":"The bank is on the right.","exampleTranslation":"Ngân hàng ở bên phải."},"north":{"definition":"phía bắc","example":"The wind comes from the north.","exampleTranslation":"Gió thổi từ phía bắc đến."},"south":{"definition":"phía nam","example":"We drove to the south of the country.","exampleTranslation":"Chúng tôi lái xe về phía nam của đất nước."},"near":{"definition":"gần","example":"My school is near my house.","exampleTranslation":"Trường của tôi ở gần nhà tôi."},"far":{"definition":"xa","example":"The airport is far from the city.","exampleTranslation":"Sân bay ở xa thành phố."},"here":{"definition":"ở đây","example":"Please come here.","exampleTranslation":"Hãy đến đây."},"there":{"definition":"ở đó","example":"The keys are over there.","exampleTranslation":"Chìa khóa ở đằng kia."},"enter":{"definition":"đi vào","example":"Please enter the room quietly.","exampleTranslation":"Hãy vào phòng một cách yên lặng."},"exit":{"definition":"lối ra","example":"The exit is behind you.","exampleTranslation":"Lối ra ở phía sau bạn."},"turn":{"definition":"rẽ","example":"Turn right at the traffic lights.","exampleTranslation":"Hãy rẽ phải ở chỗ đèn giao thông."},"cross":{"definition":"băng qua","example":"Be careful when you cross the street.","exampleTranslation":"Hãy cẩn thận khi bạn băng qua đường."},"go":{"definition":"đi","example":"I go to school by bus.","exampleTranslation":"Tôi đi học bằng xe buýt."},"come":{"definition":"đến","example":"Please come to my house tomorrow.","exampleTranslation":"Ngày mai hãy đến nhà tôi nhé."},"get":{"definition":"nhận hoặc lấy","example":"I got a letter from my friend.","exampleTranslation":"Tôi đã nhận được một lá thư từ bạn tôi."},"make":{"definition":"làm hoặc tạo ra","example":"She makes a cake every Sunday.","exampleTranslation":"Cô ấy làm một chiếc bánh vào mỗi Chủ nhật."},"take":{"definition":"lấy hoặc mang theo","example":"Take an umbrella with you today.","exampleTranslation":"Hôm nay hãy mang theo một chiếc ô."},"give":{"definition":"đưa hoặc cho","example":"Please give me a glass of water.","exampleTranslation":"Làm ơn đưa cho tôi một ly nước."},"want":{"definition":"muốn","example":"I want a cup of coffee.","exampleTranslation":"Tôi muốn một tách cà phê."},"need":{"definition":"cần","example":"I need some help with this exercise.","exampleTranslation":"Tôi cần một chút giúp đỡ với bài tập này."},"use":{"definition":"sử dụng","example":"You can use my pen.","exampleTranslation":"Bạn có thể dùng bút của tôi."},"live":{"definition":"sống","example":"They live in a small town.","exampleTranslation":"Họ sống ở một thị trấn nhỏ."},"like":{"definition":"thích","example":"I like pizza very much.","exampleTranslation":"Tôi rất thích pizza."},"love":{"definition":"yêu hoặc rất thích","example":"I love my family.","exampleTranslation":"Tôi yêu gia đình mình."},"get up":{"definition":"thức dậy","example":"I get up at six o'clock every morning.","exampleTranslation":"Tôi thức dậy lúc sáu giờ mỗi sáng."},"wash":{"definition":"rửa","example":"Wash your hands before dinner.","exampleTranslation":"Hãy rửa tay trước bữa tối."},"clean":{"definition":"dọn dẹp hoặc làm sạch","example":"I clean my room every weekend.","exampleTranslation":"Tôi dọn phòng của mình vào mỗi cuối tuần."},"open":{"definition":"mở","example":"Please open the door.","exampleTranslation":"Làm ơn mở cửa ra."},"close":{"definition":"đóng","example":"Please close the window.","exampleTranslation":"Làm ơn đóng cửa sổ lại."},"start":{"definition":"bắt đầu","example":"The class starts at eight o'clock.","exampleTranslation":"Lớp học bắt đầu lúc tám giờ."},"finish":{"definition":"hoàn thành hoặc kết thúc","example":"I will finish my homework soon.","exampleTranslation":"Tôi sẽ sớm làm xong bài tập về nhà."},"help":{"definition":"giúp đỡ","example":"Can you help me carry this bag?","exampleTranslation":"Bạn có thể giúp tôi xách chiếc túi này không?"},"call":{"definition":"gọi điện","example":"I will call you tonight.","exampleTranslation":"Tối nay tôi sẽ gọi điện cho bạn."},"ask":{"definition":"hỏi","example":"May I ask you a question?","exampleTranslation":"Tôi có thể hỏi bạn một câu được không?"},"tell":{"definition":"nói hoặc kể cho ai","example":"Please tell me your name.","exampleTranslation":"Vui lòng cho tôi biết tên của bạn."},"show":{"definition":"cho xem hoặc chỉ ra","example":"Can you show me your passport, please?","exampleTranslation":"Bạn có thể cho tôi xem hộ chiếu của bạn được không?"},"good":{"definition":"tốt","example":"This is a good book.","exampleTranslation":"Đây là một cuốn sách hay."},"bad":{"definition":"xấu hoặc tệ","example":"The weather is bad today.","exampleTranslation":"Hôm nay thời tiết xấu."},"big":{"definition":"to","example":"They live in a big house.","exampleTranslation":"Họ sống trong một ngôi nhà lớn."},"small":{"definition":"nhỏ","example":"I have a small dog.","exampleTranslation":"Tôi có một chú chó nhỏ."},"new":{"definition":"mới","example":"I bought a new phone yesterday.","exampleTranslation":"Hôm qua tôi đã mua một chiếc điện thoại mới."},"old":{"definition":"cũ hoặc già","example":"This is an old building.","exampleTranslation":"Đây là một tòa nhà cũ."},"easy":{"definition":"dễ","example":"The test was easy.","exampleTranslation":"Bài kiểm tra rất dễ."},"difficult":{"definition":"khó","example":"This question is very difficult.","exampleTranslation":"Câu hỏi này rất khó."},"happy":{"definition":"vui","example":"I am happy to see you.","exampleTranslation":"Tôi rất vui khi gặp bạn."},"sad":{"definition":"buồn","example":"She felt sad after the news.","exampleTranslation":"Cô ấy cảm thấy buồn sau khi nghe tin."},"tired":{"definition":"mệt","example":"I am tired after work.","exampleTranslation":"Tôi mệt sau giờ làm."},"busy":{"definition":"bận","example":"I'm busy today, so I can't come.","exampleTranslation":"Hôm nay tôi bận nên không thể đến."},"who":{"definition":"ai","example":"Who is that man?","exampleTranslation":"Người đàn ông đó là ai?"},"what":{"definition":"cái gì","example":"What is your name?","exampleTranslation":"Tên bạn là gì?"},"where":{"definition":"ở đâu","example":"Where do you live?","exampleTranslation":"Bạn sống ở đâu?"},"when":{"definition":"khi nào","example":"When does the class start?","exampleTranslation":"Khi nào lớp học bắt đầu?"},"why":{"definition":"tại sao","example":"Why are you late?","exampleTranslation":"Tại sao bạn đến muộn?"},"how":{"definition":"như thế nào","example":"How do you get to school?","exampleTranslation":"Bạn đến trường bằng cách nào?"},"this":{"definition":"cái này","example":"This is my brother.","exampleTranslation":"Đây là anh trai tôi."},"that":{"definition":"cái kia","example":"That is my house.","exampleTranslation":"Kia là nhà của tôi."},"these":{"definition":"những cái này","example":"These are my new shoes.","exampleTranslation":"Đây là những đôi giày mới của tôi."},"those":{"definition":"những cái kia","example":"Those are my parents.","exampleTranslation":"Kia là bố mẹ của tôi."},"and":{"definition":"và","example":"I like tea and coffee.","exampleTranslation":"Tôi thích trà và cà phê."},"but":{"definition":"nhưng","example":"I want to go, but I'm tired.","exampleTranslation":"Tôi muốn đi, nhưng tôi mệt."}},"wordCount":300,"topicCount":8},{"id":"idioms-v1","title":"Idioms","description":"Học 1.499 thành ngữ có nghĩa tiếng Việt từ từ điển offline, qua câu ví dụ và bài chọn cụm phù hợp.","lessons":[{"id":"idioms-v1-lesson-001","title":"Bài 1","focus":"Thành ngữ từ “9-to-5” đến “a feather in one's cap”.","questions":[{"term":"9-to-5","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giờ làm việc hành chính; công việc toàn thời gian (thường từ 9 giờ sáng đến 5 giờ chiều).”. Cậu chọn cụm phù hợp nhé.","prompt":"I’m tired of the _____ grind and want a more flexible schedule.","choices":["Slow and steady wins the race","Slip of the tongue","9-to-5","Slim chance"]},{"term":"A bad apple","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ xấu trong nhóm; con sâu làm rầu nồi canh.”. Cậu chọn cụm phù hợp nhé.","prompt":"They had to fire him because he was _____ disrupting the workplace harmony.","choices":["Where were we?","A bad apple","Where the rubber meets the road","White elephant"]},{"term":"A baker’s dozen","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mười ba (13).”. Cậu chọn cụm phù hợp nhé.","prompt":"I ordered a dozen bagels, but the kind baker gave me _____.","choices":["Bookworm","Bone of contention","Born with a silver spoon in one's mouth","A baker’s dozen"]},{"term":"A ballpark figure","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Con số ước tính; lượng ước đoán.”. Cậu chọn cụm phù hợp nhé.","prompt":"Can you give me _____ of the total cost?","choices":["A ballpark figure","Leave someone alone","Leave someone in the lurch","Leave someone high and dry"]},{"term":"A bird in the hand is worth two in the bush","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có còn hơn không; trân trọng những gì đang có (thay vì theo đuổi những thứ viển vông).”. Cậu chọn cụm phù hợp nhé.","prompt":"You should take the job offer; remember, _____.","choices":["Get into deep water","Get in touch with","A bird in the hand is worth two in the bush","Get in someone’s hair"]},{"term":"A bit/A little bit","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một chút; hơi hơi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A bit/A little bit","Not a spark of decency","Not have a leg to stand on","Not one's cup of tea"]},{"term":"A blessing in disguise","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong cái rủi có cái may; việc tốt đội lốt việc xấu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Losing that job was _____; it pushed me to start my own business.","choices":["Play it by ear","A blessing in disguise","Play hardball","Play dumb"]},{"term":"A bone to pick","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện cần phải làm rõ; vấn đề cần giải quyết (thường mang tính chất phàn nàn, cãi vã).”. Cậu chọn cụm phù hợp nhé.","prompt":"I have _____ with you about your comments yesterday.","choices":["cram for an exam","Crack someone up","A bone to pick","Crack open a cold one"]},{"term":"A breath of fresh air","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làn gió mới; luồng sinh khí mới.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her innovative ideas were _____ for the company.","choices":["to make matters worse","A breath of fresh air","Too big for one's boots","Tongue-in-cheek"]},{"term":"A bunch of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một mớ; một đống; rất nhiều.”. Cậu chọn cụm phù hợp nhé.","prompt":"There’s _____ paperwork on my desk I need to finish.","choices":["A bunch of","Go through something with a fine-tooth comb","Go the whole hog","Go the extra mile"]},{"term":"A chip off the old block","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cha nào con nấy, bản sao của bố/mẹ.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s _____ – just as stubborn as his father.","choices":["Hair’s breadth","Hair of the dog","Half a mind to do something","A chip off the old block"]},{"term":"A chip on your shoulder","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dễ nổi cáu; ôm hận trong lòng; thái độ hằn học.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A chip on your shoulder","Tilt at windmills","Time flies when you're having fun","time flies"]},{"term":"A day late and a dollar short","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quá muộn màng và không đủ (thường dùng khi sự giúp đỡ hoặc hành động đã quá muộn để xoay chuyển tình thế).”. Cậu chọn cụm phù hợp nhé.","prompt":"Her apology felt _____ after the damage was already done.","choices":["Cool as a cucumber","Copycat","Cool your jets","A day late and a dollar short"]},{"term":"A dime a dozen","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rẻ như bèo; đồ bỏ đi; nhiều vô kể.”. Cậu chọn cụm phù hợp nhé.","prompt":"Cheap souvenirs are _____ at the tourist market.","choices":["Chew something over","cherry-pick","A dime a dozen","Chew someone out"]},{"term":"A doozy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện kinh khủng; thứ phi thường; việc rất khó khăn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A flash in the pan","A fifth wheel","A doozy","A fool and his money are easily parted"]},{"term":"A doubting Thomas","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ đa nghi; người không dễ tin vào người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s such _____, always needing proof before he believes anything we say.","choices":["A doubting Thomas","Turn a place upside down","Turn a blind eye","Tuckered out"]},{"term":"a drop in the bucket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hạt muối bỏ biển, chả thấm vào đâu.”. Cậu chọn cụm phù hợp nhé.","prompt":"The charity event raised $500, but it's just _____ compared to what's needed.","choices":["Birds of a feather flock together","bit off more than one can chew","a drop in the bucket","Bird’s-eye view"]},{"term":"a drop in the ocean","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giọt nước giữa biển khơi, hạt cát trong sa mạc; số lượng quá ít ỏi.”. Cậu chọn cụm phù hợp nhé.","prompt":"A thousand dollars is just _____ compared to the millions needed for the hospital.","choices":["a drop in the ocean","You bet","X marks the spot","You can bet your boots"]},{"term":"A far cry from (something)","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khác xa với; một trời một vực.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Clean slate","Clear as mud","Clean someone out","A far cry from (something)"]},{"term":"a feather in one's cap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một thành tựu đáng tự hào, niềm hãnh diện.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Splitting hairs","Spread yourself too thin","a feather in one's cap","Square meal"]}]},{"id":"idioms-v1-lesson-002","title":"Bài 2","focus":"Thành ngữ từ “A fifth wheel” đến “A memory like a sieve”.","questions":[{"term":"A fifth wheel","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người thừa; kỳ đà cản mũi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Whenever my friends go out on dates, I always feel like _____.","choices":["wear your heart on your sleeve","A fifth wheel","wear the pants","Wear one's heart on one's sleeve"]},{"term":"A flash in the pan","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiện tượng sớm nở tối tàn; thành công chớp nhoáng.”. Cậu chọn cụm phù hợp nhé.","prompt":"His performance was impressive, but it turned out to be just _____.","choices":["Get hold of something","A flash in the pan","Get from A to B","Get hold of someone"]},{"term":"A fool and his money are easily parted","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ ngốc không biết giữ tiền; tiêu tiền như nước.”. Cậu chọn cụm phù hợp nhé.","prompt":"He spent all his savings on lottery tickets. _____.","choices":["cry over spilled milk","Cry wolf","Cup of joe","A fool and his money are easily parted"]},{"term":"A for effort","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điểm 10 cho sự nỗ lực; đáng khen vì đã cố gắng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The project didn’t work out as planned, but the team deserves an _____.","choices":["let by-gones be by-gones","A for effort","Lend an ear","Lend a hand"]},{"term":"A fork in the road","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngã rẽ cuộc đời; bước ngoặt mang tính quyết định.”. Cậu chọn cụm phù hợp nhé.","prompt":"When the company restructured, she found herself at _____ in her professional life.","choices":["Until the cows come home","A fork in the road","Under the wire","Up a blind alley"]},{"term":"a friend in need is a friend indeed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bạn lúc hoạn nạn mới là bạn chân tình; gian nan mới tỏ mặt bạn bè.”. Cậu chọn cụm phù hợp nhé.","prompt":"She stood by me when I lost my job, proving that _____.","choices":["Take it easy","take a turn for the worse","take for granted","a friend in need is a friend indeed"]},{"term":"A good Samaritan","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người tốt bụng thiện nguyện; người hay giúp đỡ người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ reached out to help the elderly man who had fallen on the sidewalk.","choices":["Sleep like a log","Slap on the wrist","A good Samaritan","Slim chance"]},{"term":"A hang-up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mặc cảm tâm lý; nỗi ám ảnh; sự lo âu vô cớ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Add fuel to the fire","Add insult to injury","Against the clock","A hang-up"]},{"term":"A hard nut to crack","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bài toán khó; vấn đề hóc búa; người khó nhằn.”. Cậu chọn cụm phù hợp nhé.","prompt":"The math problem was _____, but she finally solved it.","choices":["It is always darkest before the dawn","It takes one to know one","It is a poor workman who blames his tools","A hard nut to crack"]},{"term":"a heart of gold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trái tim nhân hậu, tấm lòng vàng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Grandmother has _____ and is always helping the needy in our town.","choices":["Black-and-white","Blackball someone","a heart of gold","Blast from the past"]},{"term":"A hot potato","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Củ khoai lang nóng; chủ đề nhạy cảm; vấn đề nan giải không ai muốn giải quyết.”. Cậu chọn cụm phù hợp nhé.","prompt":"The issue of rising taxes has become _____ for the government.","choices":["A hot potato","the cat's meow","the devil is in the details","the early bird gets the worm"]},{"term":"A kickback","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiền hoa hồng bất chính; tiền hối lộ.”. Cậu chọn cụm phù hợp nhé.","prompt":"The contractor was arrested for offering _____ to secure the project.","choices":["Leave no stone unturned","Learn one's lesson","A kickback","Learn the ropes"]},{"term":"A level playing field","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sân chơi bình đẳng.”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to ensure _____ for all businesses, big and small.","choices":["Don't hold your breath","A level playing field","Don't know him from Adam","Don't know if I'm coming or going"]},{"term":"A little bird told me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có người tiết lộ cho tôi; nghe phong thanh rằng.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ you’re getting a promotion soon.","choices":["A little bird told me","In a jam","In a bind","Ignorance is bliss"]},{"term":"A little learning is a dangerous thing","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nửa cái bánh mì vẫn là bánh mì, nhưng nửa sự thật thì không phải là sự thật; biết nửa vời rất nguy hiểm.”. Cậu chọn cụm phù hợp nhé.","prompt":"He tried to fix the car himself, but _____ — now it’s in worse condition.","choices":["Midas touch","Middle of the road","Mind your own beeswax","A little learning is a dangerous thing"]},{"term":"A long face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mặt mày ủ rũ, buồn thiu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Do something by the seat of your pants","A long face","Do something at the drop of a hat","Doesn't hold water"]},{"term":"A loose cannon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ bốc đồng, người khó lường dễ gây họa.”. Cậu chọn cụm phù hợp nhé.","prompt":"He's _____ and often makes impulsive decisions that get the company in trouble.","choices":["Make a big stink","A loose cannon","Make a beeline for","Make a long story short"]},{"term":"A lucky break","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vận may bất ngờ, cơ hội may mắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After years of hard work, he finally got _____ in his career.","choices":["Head over heels","Heads-up","A lucky break","Hear it on the grapevine"]},{"term":"A lucky dog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người chó ngáp phải ruồi, kẻ may mắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"He won the lottery again! What _____!","choices":["A lucky dog","Know zip","Know which way the wind is blowing","Know the ropes"]},{"term":"A memory like a sieve","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trí nhớ cá vàng; não cá vàng; hay quên.”. Cậu chọn cụm phù hợp nhé.","prompt":"My mom has _____ and keeps forgetting where she put her keys.","choices":["Like a chicken with its head cut off","A memory like a sieve","Like clockwork","Like a deer in the headlights"]}]},{"id":"idioms-v1-lesson-003","title":"Bài 3","focus":"Thành ngữ từ “A penny for your thoughts” đến “A storm is brewing”.","questions":[{"term":"A penny for your thoughts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bạn đang nghĩ gì vậy? (dùng để hỏi khi thấy ai đó đang mải suy nghĩ).”. Cậu chọn cụm phù hợp nhé.","prompt":"You’ve been awfully quiet. _____?","choices":["Blow smoke","A penny for your thoughts","Blow someone away","Blow one's top"]},{"term":"A penny saved is a penny earned","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tích tiểu thành đại; tiết kiệm một đồng cũng bằng kiếm được một đồng.”. Cậu chọn cụm phù hợp nhé.","prompt":"You don’t need that expensive gadget. Remember: _____.","choices":["A penny saved is a penny earned","Birds of a feather flock together","Bird’s-eye view","bit off more than one can chew"]},{"term":"A perfect storm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cơn bão hoàn hảo; tình huống tồi tệ nhất có thể xảy ra (do nhiều yếu tố bất lợi cùng lúc).”. Cậu chọn cụm phù hợp nhé.","prompt":"The company’s financial issues, combined with the economic downturn, created _____.","choices":["A perfect storm","Good to know","Goody-goody gumdrops","Good things come to those who wait"]},{"term":"A picture is worth a thousand words","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một bức ảnh bằng ngàn lời nói; trăm nghe không bằng một thấy.”. Cậu chọn cụm phù hợp nhé.","prompt":"She showed us the photos from her vacation because _____.","choices":["9-to-5","A picture is worth a thousand words","zip it","zero tolerance"]},{"term":"A piece of cake","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất dễ dàng, dễ như ăn kẹo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Fixing this bike is _____ for me.","choices":["The straight and narrow","The tide has turned","The squeaky wheel gets the grease","A piece of cake"]},{"term":"A ray of sunshine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tia hy vọng; nguồn vui; người mang lại niềm vui.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her smile is like _____ on a cloudy day.","choices":["As easy as ABC","As easy as pie","As genuine as a three-dollar bill","A ray of sunshine"]},{"term":"a red-letter day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngày đáng nhớ, ngày trọng đại”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["a red-letter day","Shoot off one's mouth","Shoot the breeze","Shoot hoops"]},{"term":"A rip-off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giá cắt cổ; trò bịp bợm móc túi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Don't know if I'm coming or going","A rip-off","Don't know him from Adam","Don't look a gift horse in the mouth"]},{"term":"A scorcher","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một ngày nóng đổ lửa, nóng thiêu đốt.”. Cậu chọn cụm phù hợp nhé.","prompt":"We picked the wrong day for a hike — it's _____ out there.","choices":["Go on a wild goose chase","Go off the deep end","A scorcher","Go off half-cocked"]},{"term":"A screw loose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị chập mạch; hâm hâm dở dở; không bình thường.”. Cậu chọn cụm phù hợp nhé.","prompt":"I think he’s got _____ for jumping into that freezing water.","choices":["Paint the town red","Pain in the neck","Paddle your own canoe","A screw loose"]},{"term":"A screwup","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự thất bại thảm hại; một sai lầm nghiêm trọng (hoặc người hay làm hỏng việc).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A screwup","A good Samaritan","A fork in the road","a friend in need is a friend indeed"]},{"term":"a shoulder to cry on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chỗ dựa tinh thần, người lắng nghe và an ủi tâm sự.”. Cậu chọn cụm phù hợp nhé.","prompt":"Whenever she feels overwhelmed by life, she knows her best friend is _____.","choices":["You can lead a horse to water, but you can't make him drink","a shoulder to cry on","You can't have your cake and eat it too","You can say that again"]},{"term":"A sledgehammer to crack a nut","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dùng dao mổ trâu để giết gà.”. Cậu chọn cụm phù hợp nhé.","prompt":"Bringing in a lawyer for this minor dispute is like using _____.","choices":["Foam at the mouth","Fly-by-night","A sledgehammer to crack a nut","fly through"]},{"term":"A smart cookie","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người thông minh; người lanh lợi; người tài trí.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Out of my hands","Out of left field","A smart cookie","Out of order"]},{"term":"A snowball effect","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiệu ứng quả cầu tuyết (sự việc ngày càng lớn dần/nghiêm trọng hơn).”. Cậu chọn cụm phù hợp nhé.","prompt":"Once the rumor started, it created _____ and spread quickly.","choices":["Go around in circles","A snowball effect","Go against the grain","Give someone/something short shrift"]},{"term":"A snowball’s chance in hell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không có chút cơ hội nào; hy vọng cực kỳ mong manh.”. Cậu chọn cụm phù hợp nhé.","prompt":"He doesn’t have _____ of passing that exam without studying.","choices":["A snowball’s chance in hell","the Big Apple","the Big Easy","the best thing since sliced bread"]},{"term":"A stitch in time saves nine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phòng bệnh hơn chữa bệnh; xử lý sớm tránh phiền phức về sau.”. Cậu chọn cụm phù hợp nhé.","prompt":"You should update the software immediately; _____.","choices":["make up for lost time","Make the grade","Make tracks","A stitch in time saves nine"]},{"term":"A stone’s throw","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khoảng cách rất gần; chỉ cách một bước chân.”. Cậu chọn cụm phù hợp nhé.","prompt":"The store is just _____ from my house.","choices":["Clean someone out","A stone’s throw","Clean slate","Clear as mud"]},{"term":"A storm in a teacup","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện bé xé ra to; giông bão trong tách trà.”. Cậu chọn cụm phù hợp nhé.","prompt":"The argument between them was just _____; it was nothing serious.","choices":["Down in the dumps","Doom and gloom","A storm in a teacup","Double whammy"]},{"term":"A storm is brewing","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giông bão sắp ập tới; rắc rối sắp xảy ra.”. Cậu chọn cụm phù hợp nhé.","prompt":"You could tell from their argument that _____.","choices":["A storm is brewing","Make out what someone says","Make tracks","Make the grade"]}]},{"id":"idioms-v1-lesson-004","title":"Bài 4","focus":"Thành ngữ từ “A surefire way” đến “ahead of time”.","questions":[{"term":"A surefire way","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cách chắc ăn nhất; biện pháp nắm chắc phần thắng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Studying hard is _____ to improve your grades.","choices":["String someone along","Stuffed shirt","A surefire way","Strike it rich"]},{"term":"A sweet tooth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người hảo ngọt; thích ăn đồ ngọt.”. Cậu chọn cụm phù hợp nhé.","prompt":"She has _____ and never skips dessert.","choices":["A sweet tooth","A snowball’s chance in hell","A snowball effect","A smart cookie"]},{"term":"a tall story","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chuyện nói khoác, chuyện khó tin”. Cậu chọn cụm phù hợp nhé.","prompt":"He told us _____ about how he once wrestled a bear.","choices":["Go the extra mile","Go postal","a tall story","Go south"]},{"term":"A toss-up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khả năng 50-50; hên xui; ngang tài ngang sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"Who will win the election? At this point, it’s _____.","choices":["Troubled waters","Tuckered out","A toss-up","True blue"]},{"term":"A walk in the park","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dễ như ăn bánh, chuyện nhỏ”. Cậu chọn cụm phù hợp nhé.","prompt":"Fixing the computer was _____ for him.","choices":["Under someone's thumb","A walk in the park","Under a cloud","Under the table"]},{"term":"a wet blanket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ phá đám, người làm mất hứng (kẻ dội gáo nước lạnh vào cuộc vui).”. Cậu chọn cụm phù hợp nhé.","prompt":"Do not invite Mark to the beach party; he is such _____.","choices":["a wet blanket","Hammer out a deal","Hand in glove","Half-baked"]},{"term":"A wolf in sheep's clothing","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sói đội lốt cừu, kẻ tâm địa hiểm độc giả dạng người hiền lành”. Cậu chọn cụm phù hợp nhé.","prompt":"The new CEO was _____, pretending to care about employees while planning massive layoffs.","choices":["put someone in their place","A wolf in sheep's clothing","put one's money where one's mouth is","put our heads together"]},{"term":"Absentminded","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đãng trí; lơ đãng; đểnh đoảng.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s always so _____; he forgot his keys again.","choices":["Hammer out a deal","Absentminded","Hand in glove","Half-baked"]},{"term":"Ace in the hole","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vũ khí bí mật, quân bài tẩy có thể xoay chuyển tình thế vào phút chót.”. Cậu chọn cụm phù hợp nhé.","prompt":"His experience in negotiating is his _____ during business meetings.","choices":["Spineless","Splitting hairs","Spitting image","Ace in the hole"]},{"term":"Ace up the sleeve","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bảo bối giấu kín, vũ khí bí mật.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Dead quiet","Ace up the sleeve","Dead ringer","Dead tired"]},{"term":"Achilles’ heel","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điểm yếu chí mạng, gót chân Achilles.”. Cậu chọn cụm phù hợp nhé.","prompt":"The software is great, but its security issues are its _____.","choices":["Give someone a piece of one's mind","Give someone a hard time","Give someone a run for their money","Achilles’ heel"]},{"term":"Acid test","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phép thử quyết định, bài kiểm tra gắt gao nhất để xác định giá trị thật.”. Cậu chọn cụm phù hợp nhé.","prompt":"Facing a crisis is often the _____ of true leadership.","choices":["Give someone the thumbs-up","Acid test","Give someone the slip","Give someone the heads-up"]},{"term":"Across the board","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Toàn diện, đồng loạt, áp dụng cho mọi người hoặc mọi khía cạnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"The company announced a 10% salary increase _____ for all employees.","choices":["On the spur of the moment","Across the board","On the spot","On the up and up"]},{"term":"action speaks louder than words","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hành động có ý nghĩa hơn lời nói; nói đi đôi với làm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bend over backward","Bent out of shape","action speaks louder than words","Bend someone's ear"]},{"term":"Actions Speak Louder Than Words","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hành động có giá trị hơn lời nói, nói ít làm nhiều.”. Cậu chọn cụm phù hợp nhé.","prompt":"He keeps promising to help, but _____; so far, he hasn’t done anything.","choices":["Time flies when you're having fun","Time is money","time will tell","Actions Speak Louder Than Words"]},{"term":"Add fuel to the fire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thêm dầu vào lửa, đổ thêm dầu vào lửa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["everything but the kitchen sink","every now and then","Add fuel to the fire","every dog has his day"]},{"term":"Add insult to injury","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xát muối vào vết thương, đổ thêm dầu vào lửa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sour grapes","Spice things up","Add insult to injury","Speak of the devil"]},{"term":"Against the clock","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chạy đua với thời gian.”. Cậu chọn cụm phù hợp nhé.","prompt":"We are working _____ to meet the project deadline.","choices":["Against the clock","Break the ice","Breeze through","Break the news"]},{"term":"Ahead of schedule","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sớm hơn dự kiến, vượt tiến độ.”. Cậu chọn cụm phù hợp nhé.","prompt":"We finished the project _____, so we can start the next phase early.","choices":["Ahead of schedule","Bring one's A game","Bring down the house","Bring home the bacon"]},{"term":"ahead of time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trước thời hạn, sớm hơn lịch trình.”. Cậu chọn cụm phù hợp nhé.","prompt":"She completed the project two days _____ and impressed the client.","choices":["ahead of time","Greased lightning","Gray area","Grease monkey"]}]},{"id":"idioms-v1-lesson-005","title":"Bài 5","focus":"Thành ngữ từ “All bark and no bite” đến “An open book”.","questions":[{"term":"All bark and no bite","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khẩu xà tâm phật, thùng rỗng kêu to (chỉ đe dọa chứ không hành động).”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t be afraid of him; he’s _____.","choices":["All bark and no bite","Cost a mint","Corner the market","Copycat"]},{"term":"All bets are off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mọi chuyện đều có thể xảy ra, không thể đoán trước được điều gì nữa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Once the CEO resigned, _____ regarding the company’s future.","choices":["All bets are off","As the crow flies","As white as a sheet/as white as a ghost","At best"]},{"term":"all ears","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lắng tai nghe, chăm chú lắng nghe.”. Cậu chọn cụm phù hợp nhé.","prompt":"Tell me all about your trip to Paris; I am _____!","choices":["Big fish in a small pond","all ears","Big cheese","Big shot"]},{"term":"All Greek to me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Như vịt nghe sấm, hoàn toàn không hiểu gì cả.”. Cậu chọn cụm phù hợp nhé.","prompt":"When they started discussing quantum physics, it was _____.","choices":["cross your fingers","All Greek to me","cry over spilled milk","Crunch time"]},{"term":"All heart","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất tốt bụng, có trái tim nhân hậu.”. Cậu chọn cụm phù hợp nhé.","prompt":"She’s _____, always helping those in need.","choices":["Off-color","Old school","Off the wall","All heart"]},{"term":"all in all","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhìn chung, tóm lại, sau khi xét mọi khía cạnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, the annual conference was a tremendous success.","choices":["all in all","Get in someone’s hair","Get in touch with","Get hold of something"]},{"term":"All in the same boat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cùng chung hội chung thuyền, cùng cảnh ngộ.”. Cậu chọn cụm phù hợp nhé.","prompt":"During the pandemic, we were _____, trying to adjust to new norms.","choices":["Good to know","Good things come to those who wait","Good riddance","All in the same boat"]},{"term":"All kidding aside","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói nghiêm túc nhé, đùa thế đủ rồi.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, we really need to focus and finish this project by Friday.","choices":["See the big picture","All kidding aside","See someone's true colors","See the light"]},{"term":"All over the map","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lung tung, không có định hướng rõ ràng, lan man.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her speech was _____, covering too many unrelated topics.","choices":["Dead-end job","Dead to the world","All over the map","Deep down"]},{"term":"All set","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đã sẵn sàng, đã chuẩn bị xong.”. Cậu chọn cụm phù hợp nhé.","prompt":"We’re _____ for the trip. Did you pack your bag?","choices":["Dog days of summer","All set","Doesn't know beans about it","Dog and pony show"]},{"term":"All thumbs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vụng về, lóng ngóng.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s _____ in the kitchen and always makes a mess.","choices":["All thumbs","Damn someone with faint praise","Cutting corners","Cute as a bug"]},{"term":"All wet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn toàn sai lầm.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s _____ if he thinks the boss will approve that plan.","choices":["Bed of roses","All wet","Before you know it","Behind someone’s back"]},{"term":"Along for the ride","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi theo cho vui, tham gia mà không đóng vai trò gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"He wasn’t an active participant in the project; he was just _____.","choices":["bringing up a family","Bug someone","Brownie points","Along for the ride"]},{"term":"An about-face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự thay đổi 180 độ (ý kiến, kế hoạch).”. Cậu chọn cụm phù hợp nhé.","prompt":"The company did _____ on its policy after the customer backlash.","choices":["An about-face","kill time","Kill the mood","Kill two birds with one stone"]},{"term":"An albatross around my neck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gánh nặng đeo bám, của nợ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the bottom line","An albatross around my neck","the Big Easy","the Big Apple"]},{"term":"An apple a day keeps the doctor away","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mỗi ngày một quả táo, cả đời không phải gặp bác sĩ (ăn uống lành mạnh giúp khỏe mạnh).”. Cậu chọn cụm phù hợp nhé.","prompt":"_____.","choices":["Have the world by the tail","Have something down pat","Have time off","An apple a day keeps the doctor away"]},{"term":"An old head on young shoulders","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trẻ người non dạ nhưng suy nghĩ thấu đáo; già dặn trước tuổi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite being only 12, she speaks with the wisdom of someone many years older, truly _____.","choices":["on the rocks","An old head on young shoulders","On the line","on the mend"]},{"term":"An old soul","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người có tâm hồn già cỗi, chín chắn và sâu sắc trước tuổi.”. Cậu chọn cụm phù hợp nhé.","prompt":"His thoughtful and introspective nature makes everyone see him as _____.","choices":["Bent out of shape","An old soul","Beside oneself","Beside the point"]},{"term":"an old wives' tale","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quan niệm mê tín dân gian vô căn cứ, chuyện truyền miệng thất thiệt.”. Cậu chọn cụm phù hợp nhé.","prompt":"The idea that eating carrots gives you night vision is mostly _____.","choices":["drag one's feet","down-to-earth","an old wives' tale","down to the wire"]},{"term":"An open book","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người dễ đoán, không giấu giếm điều gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"Unlike her sister, Sarah is _____ and shares everything about her life.","choices":["In the sticks","An open book","In the way","in the same boat"]}]},{"id":"idioms-v1-lesson-006","title":"Bài 6","focus":"Thành ngữ từ “An ounce of prevention is worth a pound of cure” đến “At least”.","questions":[{"term":"An ounce of prevention is worth a pound of cure","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phòng bệnh hơn chữa bệnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"She always follows the saying '_____' by keeping her house well-maintained.","choices":["Fuddy-duddy","Full of crap","An ounce of prevention is worth a pound of cure","full of beans"]},{"term":"apple of my eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Báu vật / cục cưng / người được yêu thương cưng chiều nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["keep one's temper","Keep one's nose to the grindstone","apple of my eye","Keep one's nose clean"]},{"term":"Are you kidding me?","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cậu đang đùa mình đấy à?”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ There’s no way she finished that project in one day.","choices":["See eye to eye","See the big picture","See someone's true colors","Are you kidding me?"]},{"term":"Armchair quarterback","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người giỏi phán xét sau khi sự việc đã rồi (chuyên gia chém gió).”. Cậu chọn cụm phù hợp nhé.","prompt":"It’s easy to be an _____ when you’re not the one making the tough decisions.","choices":["Armchair quarterback","Make a pit stop","Make a scene","make a point of"]},{"term":"Armed to the teeth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trang bị tận răng, vũ trang đầy đủ.”. Cậu chọn cụm phù hợp nhé.","prompt":"He entered the meeting _____ with data and reports.","choices":["Like taking candy from a baby","Like riding a bike","Armed to the teeth","Like there's no tomorrow"]},{"term":"around the clock","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Suốt ngày đêm không ngừng nghỉ, 24/7.”. Cậu chọn cụm phù hợp nhé.","prompt":"Rescue teams worked _____ to clear the debris and find survivors.","choices":["Junk food","around the clock","Jump the gun","Jump through hoops"]},{"term":"Around-the-clock","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Suốt ngày đêm, 24/24.”. Cậu chọn cụm phù hợp nhé.","prompt":"The tech team is working _____ to fix the server issues.","choices":["Get one's act together","Around-the-clock","get on someone's nerves","Get on one's nerves"]},{"term":"As busy as a bee","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bận rộn tối mắt tối mũi, bận rộn như ong.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ organizing the event.","choices":["bringing up a family","Bug someone","As busy as a bee","Brownie points"]},{"term":"as cool as a cucumber","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điềm tĩnh như không, cực kỳ bình tĩnh và tỉnh táo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Even under intense pressure during the live interview, the politician remained _____.","choices":["Wet one's whistle","Wet behind the ears","Wet blanket","as cool as a cucumber"]},{"term":"As easy as ABC","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dễ như trở bàn tay, dễ như ăn kẹo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Learning how to use this phone is _____.","choices":["Hard sell","Haste makes waste","As easy as ABC","Hard pill to swallow"]},{"term":"As easy as pie","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dễ như ăn bánh, dễ như trở bàn tay.”. Cậu chọn cụm phù hợp nhé.","prompt":"Fixing the computer was _____ for her.","choices":["Have the world by the tail","As easy as pie","Have something down pat","Have time off"]},{"term":"As genuine as a three-dollar bill","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giả tạo, hoàn toàn không đáng tin.”. Cậu chọn cụm phù hợp nhé.","prompt":"His apology was _____.","choices":["A for effort","A flash in the pan","A fool and his money are easily parted","As genuine as a three-dollar bill"]},{"term":"As happy as a clam","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ vui sướng và mãn nguyện.”. Cậu chọn cụm phù hợp nhé.","prompt":"After getting the promotion, he was _____.","choices":["Throw a monkey wrench in the works","Throw caution to the wind","Throw someone for a loop","As happy as a clam"]},{"term":"As quiet as a mouse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Im lặng như tờ, im lặng như chuột.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ when sneaking into the kitchen for a midnight snack.","choices":["Take something with a grain of salt","Take something for granted","take something in stride","As quiet as a mouse"]},{"term":"As rare as hen’s teeth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiếm như lá mùa thu, vô cùng quý hiếm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Honest politicians are _____ these days.","choices":["As rare as hen’s teeth","Splitting hairs","Spineless","Spitting image"]},{"term":"As right as rain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khỏe mạnh trở lại, hoàn toàn ổn thỏa.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a few days of rest, I’m feeling _____.","choices":["Come hell or high water","come of age","As right as rain","Come in handy"]},{"term":"As the crow flies","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đường chim bay.”. Cậu chọn cụm phù hợp nhé.","prompt":"The village is about 10 miles away _____.","choices":["Hand over fist","Hammer out a deal","As the crow flies","Hand in glove"]},{"term":"As white as a sheet/as white as a ghost","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trắng bệch như tờ giấy (vì sợ hãi, bệnh tật).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["As white as a sheet/as white as a ghost","come to terms with","Comfort food","Compare apples and oranges"]},{"term":"At best","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tốt nhất là, cùng lắm là.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, the project will be completed by next month.","choices":["Play it by ear","Play with fire","Play second fiddle","At best"]},{"term":"At least","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ít nhất thì, chí ít.”. Cậu chọn cụm phù hợp nhé.","prompt":"We were late, but _____ we got to see the end of the movie.","choices":["Different strokes for different folks","At least","Diamond in the rough","devil's advocate"]}]},{"id":"idioms-v1-lesson-007","title":"Bài 7","focus":"Thành ngữ từ “At loggerheads” đến “Batting a thousand”.","questions":[{"term":"At loggerheads","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bất đồng gay gắt, mâu thuẫn đối đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"The two politicians have been _____ over the new policy.","choices":["Up the creek without a paddle","Up in the air","At loggerheads","Up to snuff"]},{"term":"At my wits’ end","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bó tay, hết cách, không biết làm sao nữa.”. Cậu chọn cụm phù hợp nhé.","prompt":"After trying everything to get the project back on track, I’m _____.","choices":["At my wits’ end","Running on fumes","Run/blow hot and cold","safe and sound"]},{"term":"At the bottom of the totem pole","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ở vị trí thấp kém nhất, dưới đáy xã hội/tổ chức.”. Cậu chọn cụm phù hợp nhé.","prompt":"As a new intern, I started _____.","choices":["Sweating bullets","Take a load off someone's back","At the bottom of the totem pole","Take a rain check"]},{"term":"At the crack of dawn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vào lúc bình minh, sáng sớm tinh mơ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Farmers often wake up _____ to tend to their fields.","choices":["At the crack of dawn","Have bigger fish to fry","have egg on one's face","Have bats in one’s belfry"]},{"term":"At the drop of a hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngay lập tức, không do dự.”. Cậu chọn cụm phù hợp nhé.","prompt":"He would help his friends _____.","choices":["Salt of the earth","save face","At the drop of a hat","Sales pitch"]},{"term":"At the end of your rope","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tới giới hạn chịu đựng, không thể chịu nổi nữa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sail close to the wind","Sales pitch","safe and sound","At the end of your rope"]},{"term":"At-large","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tự do, chưa bị bắt (tội phạm); đại diện cho toàn khu vực bầu cử”. Cậu chọn cụm phù hợp nhé.","prompt":"The criminal is still _____ and considered dangerous.","choices":["At-large","Cast-iron stomach","Cat got your tongue?","Castle in the sky"]},{"term":"Baby boomer","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “người sinh ra trong thời kỳ bùng nổ dân số (1946-1964)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Baby boomer","the patience of Job","the pits","the other day"]},{"term":"back on one's feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phục hồi, đứng vững trở lại (sau bạo bệnh hoặc khó khăn tài chính).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Look before you leap","Look down one's nose","look high and low","back on one's feet"]},{"term":"Back to basics","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “quay về những điều cơ bản, cốt lõi”. Cậu chọn cụm phù hợp nhé.","prompt":"When things get too complicated, it’s important to go _____.","choices":["Back to basics","Pig out","Pipe down","Pigheaded"]},{"term":"Back to square one","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “trở lại điểm xuất phát, làm lại từ đầu”. Cậu chọn cụm phù hợp nhé.","prompt":"We took the wrong approach with this project, so it’s _____.","choices":["Go to pieces","Go to hell in a handbasket","Go to the dogs","Back to square one"]},{"term":"Back to the drawing board","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bắt đầu lại từ đầu, vạch lại kế hoạch mới”. Cậu chọn cụm phù hợp nhé.","prompt":"The initial plan didn’t work, so it’s _____.","choices":["Laugh all the way to the bank","Last-ditch effort","last straw","Back to the drawing board"]},{"term":"Backhanded compliment","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “lời khen ẩn ý chê bai, lời khen đểu”. Cậu chọn cụm phù hợp nhé.","prompt":"When he told me my cooking was surprisingly good, I knew it was a _____.","choices":["Paint the town red","Paint you a picture","Backhanded compliment","pale as a ghost"]},{"term":"Backseat driver","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “người ngồi sau chỉ đạo tài xế; người thích can thiệp vào việc của người khác”. Cậu chọn cụm phù hợp nhé.","prompt":"Stop being a _____ and let me handle this.","choices":["Backseat driver","On the warpath","On the spur of the moment","On the up and up"]},{"term":"bad apple","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Con sâu làm rầu nồi canh; kẻ xấu làm ảnh hưởng cả tập thể.”. Cậu chọn cụm phù hợp nhé.","prompt":"One _____ in the sales team was spreading false rumors and damaging morale.","choices":["Sail close to the wind","bad apple","Salt of the earth","Sales pitch"]},{"term":"Bad blood","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “sự thù hằn, hiềm khích”. Cậu chọn cụm phù hợp nhé.","prompt":"Even after all these years, there’s still _____ between them.","choices":["Good riddance","Bad blood","Good for you!","Good egg"]},{"term":"Bad hair day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “một ngày tồi tệ, xui xẻo”. Cậu chọn cụm phù hợp nhé.","prompt":"I’m having a _____; everything is going wrong.","choices":["Catch-22","Bad hair day","Caught someone red-handed","Caught red-handed"]},{"term":"Band-Aid on a bullet wound","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “biện pháp tạm thời, không giải quyết được gốc rễ vấn đề nghiêm trọng”. Cậu chọn cụm phù hợp nhé.","prompt":"Offering temporary shelter to the homeless is just a _____. We need a long-term solution.","choices":["Coin a phrase","Cold feet","Band-Aid on a bullet wound","Cold enough to freeze the balls off a brass monkey"]},{"term":"Barking up the wrong tree","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đoán sai, nhầm lẫn, đi chệch hướng”. Cậu chọn cụm phù hợp nhé.","prompt":"If you think I was the one who broke the vase, you’re _____.","choices":["Living the dream","Live it up","Barking up the wrong tree","live paycheck to paycheck"]},{"term":"Batting a thousand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thành công rực rỡ, làm việc gì cũng trót lọt”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s been _____ with his business deals lately.","choices":["Go to the dogs","Batting a thousand","Go to town","Go to pieces"]}]},{"id":"idioms-v1-lesson-008","title":"Bài 8","focus":"Thành ngữ từ “Be beside oneself” đến “Beating a dead horse”.","questions":[{"term":"Be beside oneself","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không kiềm chế được cảm xúc; Quá kích động”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lose one's shirt","Lose one's touch","Lose one's marbles","Be beside oneself"]},{"term":"Be close-fisted","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Keo kiệt; Bủn xỉn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bigwig","Bird’s-eye view","Bigger bang for your buck","Be close-fisted"]},{"term":"Be loaded","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhiều tiền; Giàu sụ”. Cậu chọn cụm phù hợp nhé.","prompt":"They must _____ if they can afford such a house.","choices":["Wouldn't touch it with a ten-foot pole","wrap your head around","Wrap one's head around something","Be loaded"]},{"term":"Be my guest","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cứ tự nhiên, xin mời”. Cậu chọn cụm phù hợp nhé.","prompt":"If you need to use my phone, _____.","choices":["Be my guest","Give someone the cold shoulder","Give someone the benefit of the doubt","give someone the brush-off"]},{"term":"Be named after","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Được đặt tên theo”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Be named after","Cost an arm and a leg","Cost a mint","Corner the market"]},{"term":"Be out of the question","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không thể xảy ra; Miễn bàn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["get the hang of","Get the message","Be out of the question","Get the hang of it"]},{"term":"be the talk of the town","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chủ đề bàn tán của mọi người, tâm điểm chú ý”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fish out of water","be the talk of the town","Fishy","Finger-lickin' good"]},{"term":"Be thrown together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị đẩy vào tình thế phải làm việc cùng nhau”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Stonewall","Stop on a dime","Sticky fingers","Be thrown together"]},{"term":"Be tied up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bận rộn tối mắt tối mũi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Like a deer in the headlights","Letter-perfect","Be tied up","Like a chicken with its head cut off"]},{"term":"Be up to something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang ấp ủ âm mưu; Đang tính toán gì đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["get on someone's nerves","Be up to something","Get one's dander up","Get one's act together"]},{"term":"bear in mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ghi nhớ, lưu tâm, ghi nhớ trong đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ that the museum closes early on Sunday afternoons.","choices":["Bed head","bear in mind","Bed of roses","beats me"]},{"term":"Bear in mind/keep in mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ghi nhớ, lưu ý rằng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Step up your game","step up one's game","Steal someone's thunder","Bear in mind/keep in mind"]},{"term":"Beat a hasty retreat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “rút lui nhanh chóng, bỏ chạy”. Cậu chọn cụm phù hợp nhé.","prompt":"When the fire alarm went off, everyone _____ from the building.","choices":["Buy something for a song","by and large","Beat a hasty retreat","by all means"]},{"term":"Beat around the bush","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói vòng vo, không đi thẳng vào vấn đề”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pass the course","Beat around the bush","Pass the buck","Party animal"]},{"term":"Beat someone to the draw","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhanh tay hơn ai đó, giành phần trước”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Beat someone to the draw","ahead of time","All bark and no bite","Ahead of schedule"]},{"term":"Beat someone to the punch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đi trước một bước, nẫng tay trên”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["catch someone's eye","Beat someone to the punch","Catch someones eye","Catch the bus"]},{"term":"Beat the band","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng; Hết sức”. Cậu chọn cụm phù hợp nhé.","prompt":"They celebrated to _____ when their team won the championship.","choices":["On the fritz","On the fly","On the house","Beat the band"]},{"term":"Beat the bushes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tìm kiếm khắp nơi, lùng sục”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Beat the bushes","the bottom line","the burning question","the boys in blue"]},{"term":"beat the clock","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chạy đua với thời gian để hoàn thành kịp trước hạn chót.”. Cậu chọn cụm phù hợp nhé.","prompt":"She sprinted to the post office and _____ just two minutes before closing.","choices":["Gut feeling","Hair of the dog","beat the clock","Hair’s breadth"]},{"term":"Beating a dead horse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “làm chuyện vô ích, phí công vô ích”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to move on to new ideas instead of _____ with the old ones.","choices":["Beating a dead horse","Close shave","Clouds on the horizon","Closed-minded"]}]},{"id":"idioms-v1-lesson-009","title":"Bài 9","focus":"Thành ngữ từ “Beating around the bush” đến “Beyond the pale”.","questions":[{"term":"Beating around the bush","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vòng vo tam quốc, lảng tránh vấn đề chính”. Cậu chọn cụm phù hợp nhé.","prompt":"Stop _____ and tell me what you really think.","choices":["At the crack of dawn","At the drop of a hat","At the end of your rope","Beating around the bush"]},{"term":"beats me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi chịu thôi, tôi hoàn toàn không biết.”. Cậu chọn cụm phù hợp nhé.","prompt":"\"Why is the printer not working again?\" \"_____, it was fine an hour ago.\"","choices":["drop someone a line","drop-dead gorgeous","dry run","beats me"]},{"term":"Bed head","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tóc rối bù sau khi ngủ dậy”. Cậu chọn cụm phù hợp nhé.","prompt":"I looked in the mirror and saw _____ like never before.","choices":["run the show","Bed head","run out of time","Run-of-the-mill"]},{"term":"Bed of roses","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cuộc sống trải hoa hồng, hoàn cảnh dễ chịu và sung sướng”. Cậu chọn cụm phù hợp nhé.","prompt":"Life is not always a _____; sometimes, you have to face challenges.","choices":["Bed of roses","In a nutshell","In a jam","In a bind"]},{"term":"Before you know it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chẳng mấy chốc, nháy mắt đã đến”. Cậu chọn cụm phù hợp nhé.","prompt":"The kids grow up so fast; _____, they’re off to college.","choices":["Keep one's nose clean","Before you know it","Keep one's head above water","Keep one's mouth shut"]},{"term":"Behind someone’s back","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “sau lưng ai đó, lén lút”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Baby boomer","At the end of your rope","At-large","Behind someone’s back"]},{"term":"Behind the eight ball","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ở thế bất lợi, trong tình thế khó khăn”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s really _____ at work since he missed the deadline.","choices":["Behind the eight ball","the pot calling the kettle black","the patience of Job","the pits"]},{"term":"behind the times","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lạc hậu, lỗi thời, cổ lỗ sĩ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Their company policy on remote work is completely _____.","choices":["Up in the air","Up to snuff","Up the creek without a paddle","behind the times"]},{"term":"Belt and suspenders","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cẩn tắc vô áy náy, dùng nhiều biện pháp an toàn cùng lúc”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s using a _____ approach to make sure the project succeeds.","choices":["behind the times","Belt and suspenders","Behind someone’s back","Behind the eight ball"]},{"term":"Bend over backward","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cố gắng hết sức, nhượng bộ tối đa để giúp ai”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["drawing card","Bend over backward","Drink like a fish","dressed to kill"]},{"term":"Bend someone's ear","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói lải nhải vào tai ai; Nói chuyện dông dài”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pitch in","Bend someone's ear","Play catch-up","Play devil’s advocate"]},{"term":"Bent out of shape","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nổi giận, vô cùng bực tức”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t get _____ over something so trivial.","choices":["Bent out of shape","It takes one to know one","It takes two to tango","It is always darkest before the dawn"]},{"term":"Beside oneself","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “mất tự chủ vì cảm xúc (vui, buồn, giận...)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Close but no cigar","Closed-minded","Beside oneself","Close shave"]},{"term":"Beside the point","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “không liên quan, lạc đề”. Cậu chọn cụm phù hợp nhé.","prompt":"What you’re saying is interesting, but it’s _____.","choices":["Bring home the bacon","Bring one's A game","Bring down the house","Beside the point"]},{"term":"Bestie","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bạn thân, bạn chí cốt”. Cậu chọn cụm phù hợp nhé.","prompt":"My _____ and I are going on a road trip this weekend.","choices":["Strike it rich","Bestie","Stuffed shirt","String someone along"]},{"term":"Bet the ranch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đánh cược tất cả, được ăn cả ngã về không”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s willing to _____ on this new business venture.","choices":["Don't know if I'm coming or going","Bet the ranch","Don't put all your eggs in one basket","Don't look a gift horse in the mouth"]},{"term":"Better late than never","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “muộn còn hơn không”. Cậu chọn cụm phù hợp nhé.","prompt":"He finally finished the project. _____.","choices":["Get this show on the road","Get the sack","Better late than never","Get the third degree"]},{"term":"Between a rock and a hard place","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tiến thoái lưỡng nan, ở thế kẹt”. Cậu chọn cụm phù hợp nhé.","prompt":"She felt like she was _____ when deciding whether to quit her job or stay in a toxic environment.","choices":["quality time","Rain cats and dogs","rack one's brain","Between a rock and a hard place"]},{"term":"Between the devil and the deep blue sea","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tiến thoái lưỡng nan, tránh vỏ dưa gặp vỏ dừa”. Cậu chọn cụm phù hợp nhé.","prompt":"John found himself _____ when he had to choose between a pay cut or losing his job entirely.","choices":["Keep one's head","Between the devil and the deep blue sea","Keep one's head above water","Keep one's cool"]},{"term":"Beyond the pale","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “quá đáng, không thể chấp nhận được”. Cậu chọn cụm phù hợp nhé.","prompt":"His comments during the meeting were _____.","choices":["Run-of-the-mill","Run/blow hot and cold","Beyond the pale","Running on fumes"]}]},{"id":"idioms-v1-lesson-010","title":"Bài 10","focus":"Thành ngữ từ “Big cheese” đến “Black-and-white”.","questions":[{"term":"Big cheese","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhân vật tai to mặt lớn, sếp sỏ”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s the _____ in our department, and all major decisions go through him.","choices":["Big cheese","Hold out an olive branch","Hold one's own","Hold the fort"]},{"term":"Big fish in a small pond","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ếch ngồi đáy giếng, nhân vật quan trọng trong một môi trường nhỏ”. Cậu chọn cụm phù hợp nhé.","prompt":"Susan feels like a _____ at her current job, but she’s considering moving to a larger company.","choices":["a wet blanket","A walk in the park","Big fish in a small pond","A wolf in sheep's clothing"]},{"term":"Big shot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhân vật quan trọng, người có thế lực”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t try to act like a _____ in front of your colleagues.","choices":["Give someone the thumbs-up","Big shot","Go against the grain","Give someone/something short shrift"]},{"term":"Big wheel","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhân vật có thế lực, người quan trọng”. Cậu chọn cụm phù hợp nhé.","prompt":"She’s the _____ around here, making all the important decisions.","choices":["the long and short of it","the munchies","Big wheel","the lion's share"]},{"term":"Bigger bang for your buck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đáng đồng tiền bát gạo, mang lại nhiều giá trị hơn so với chi phí bỏ ra”. Cậu chọn cụm phù hợp nhé.","prompt":"This new software offers a _____ compared to the old one.","choices":["Come out flat-footed","come of age","Come in handy","Bigger bang for your buck"]},{"term":"Bigwig","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhân vật quan trọng, người có quyền thế”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bigwig","Know which way the wind is blowing","Know the ropes","Know the ins and outs"]},{"term":"Bird’s-eye view","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cái nhìn toàn cảnh, cái nhìn bao quát”. Cậu chọn cụm phù hợp nhé.","prompt":"The CEO gave us a _____ of the company’s future plans.","choices":["put on one's thinking cap","push one's luck","Bird’s-eye view","put a sock in it"]},{"term":"Birds of a feather flock together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ngưu tầm ngưu, mã tầm mã”. Cậu chọn cụm phù hợp nhé.","prompt":"It’s no surprise that they became friends; _____.","choices":["Goody-goody gumdrops","Good things come to those who wait","Good to know","Birds of a feather flock together"]},{"term":"bit off more than one can chew","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gánh vác quá sức mình, ôm đồm quá nhiều việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Buy something for a song","by all means","bit off more than one can chew","by and large"]},{"term":"Bite off more than you can chew","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ôm rơm nặng bụng, làm việc quá sức”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bite off more than you can chew","Two peas in a pod","Under a cloud","Twist someone's arm"]},{"term":"Bite the bullet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cắn răng chịu đựng, dũng cảm đối mặt với khó khăn”. Cậu chọn cụm phù hợp nhé.","prompt":"She had to _____ and go to the dentist despite her fear.","choices":["under the weather","Under someone's thumb","Bite the bullet","Under the table"]},{"term":"Bite the dust","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thất bại, chết, bỏ mạng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Poker face","Pound the pavement","Pony up","Bite the dust"]},{"term":"Bite your tongue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cố giữ im lặng, không nói ra”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Knee-high to a grasshopper","Kit and caboodle","Bite your tongue","Kill two birds with one stone"]},{"term":"Black and blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bầm dập, thâm tím”. Cậu chọn cụm phù hợp nhé.","prompt":"After the fight, he was _____ all over.","choices":["The last straw","Black and blue","the last minute","The jury is still out"]},{"term":"Black market","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chợ đen; thị trường giao dịch bất hợp pháp.”. Cậu chọn cụm phù hợp nhé.","prompt":"During war times, food was often available only on the _____.","choices":["feather one's nest","fashion victim","Black market","fat cat"]},{"term":"Black out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bất tỉnh nhân sự; Ngất xỉu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Black out","You're telling me","You've sold me","your guess is as good as mine"]},{"term":"Black sheep","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thành viên cá biệt; người lạc loài (trong một gia đình hoặc tập thể).”. Cậu chọn cụm phù hợp nhé.","prompt":"He's the _____ of the family because he chose to be an artist instead of a doctor.","choices":["Black sheep","Cute as a bug","Cutting corners","Damn someone with faint praise"]},{"term":"black sheep of the family","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đứa con lạc loài, đứa con phá gia chi tử / người khác biệt trong gia đình.”. Cậu chọn cụm phù hợp nhé.","prompt":"He chose to pursue rock music instead of law and was considered the _____.","choices":["Leave no stone unturned","Learn the ropes","Leave someone alone","black sheep of the family"]},{"term":"Black tie event","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự kiện trang trọng (yêu cầu khách nam mặc tuxedo, khách nữ mặc dạ hội).”. Cậu chọn cụm phù hợp nhé.","prompt":"The charity gala is a _____, so don't forget your tuxedo.","choices":["A far cry from (something)","a feather in one's cap","Black tie event","A fifth wheel"]},{"term":"Black-and-white","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rõ ràng, rành mạch; cách nhìn nhận vấn đề trắng đen rõ ràng (không có vùng xám).”. Cậu chọn cụm phù hợp nhé.","prompt":"Life isn't always _____; sometimes there are shades of grey.","choices":["Head over heels","Black-and-white","Heads-up","Hear it on the grapevine"]}]},{"id":"idioms-v1-lesson-011","title":"Bài 11","focus":"Thành ngữ từ “Blackball someone” đến “Born with a silver spoon in one's mouth”.","questions":[{"term":"Blackball someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tẩy chay, loại bỏ ai đó (khỏi một nhóm hoặc tổ chức).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Blackball someone","See the light","See the big picture","See through someone"]},{"term":"Blast from the past","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện xưa gọi về; điều gì đó bất ngờ gợi nhớ mạnh mẽ về quá khứ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Running into my old high school friend was a real _____.","choices":["Along for the ride","Blast from the past","All wet","All thumbs"]},{"term":"Blaze a trail","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiên phong, mở đường.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put one's money where one's mouth is","put someone in their place","Blaze a trail","put our heads together"]},{"term":"blind as a bat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mắt mờ tịt, mù như dơi (thị lực rất kém khi không đeo kính).”. Cậu chọn cụm phù hợp nhé.","prompt":"Without my prescription glasses, I am as _____.","choices":["blind as a bat","A bad apple","9-to-5","zip it"]},{"term":"Blonde bombshell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người phụ nữ tóc vàng quyến rũ (thường mang tính biểu tượng).”. Cậu chọn cụm phù hợp nhé.","prompt":"In the 1950s, Marilyn Monroe epitomized the _____ look.","choices":["Kick up one's heels","kill time","Blonde bombshell","Kill the mood"]},{"term":"blood is thicker than water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một giọt máu đào hơn ao nước lã.”. Cậu chọn cụm phù hợp nhé.","prompt":"When disaster struck, his siblings were the first to help him, proving that _____.","choices":["puppy love","pull your weight","blood is thicker than water","push one's luck"]},{"term":"Blow a fuse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tức điên lên; nổi trận lôi đình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Burn bridges","Blow a fuse","Burn the candle at both ends","Burn out"]},{"term":"Blow off steam","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xả hơi; giải tỏa căng thẳng hoặc tức giận.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a long week at work, I usually _____ by going for a run.","choices":["Blow off steam","Go bananas","Go back to the drawing board","Go around in circles"]},{"term":"Blow one's own horn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tự vỗ ngực xưng tên; Tự khoe khoang”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the burning question","Blow one's own horn","the devil is in the details","the cat's meow"]},{"term":"Blow one's top","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tức giận tột độ; giận bốc khói.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Blow one's top","Blue law","Bolt from the blue","Boiling point"]},{"term":"Blow smoke","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói khoác, chém gió; nói những điều không có thật để đánh lừa hoặc khoe khoang.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["You can bet your bottom dollar","You bet","Blow smoke","You can bet your boots"]},{"term":"Blow someone away","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó vô cùng kinh ngạc và ấn tượng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["eat one's heart out","eat one's hat","Blow someone away","egg on one's face"]},{"term":"Blue blood","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dòng máu quý tộc; người xuất thân từ gia đình quý tộc.”. Cậu chọn cụm phù hợp nhé.","prompt":"The family claims to have _____ dating back centuries.","choices":["talk through one's hat","talk someone's ear off","talk shop","Blue blood"]},{"term":"Blue law","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Luật ngày Chủ nhật (luật cấm các hoạt động mua bán, giải trí vào Chủ nhật vì lý do tôn giáo).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Goof off","Grasp at straws","Blue law","Goody-goody gumdrops"]},{"term":"Boiling point","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giới hạn chịu đựng; đỉnh điểm của sự tức giận hoặc căng thẳng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Tensions in the meeting hit the _____ when they couldn't agree on a solution.","choices":["Barking up the wrong tree","Bad hair day","Boiling point","Band-Aid on a bullet wound"]},{"term":"Bolt from the blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện bất ngờ như sét đánh ngang tai.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her resignation was a _____ for the whole team.","choices":["A hang-up","Bolt from the blue","a friend in need is a friend indeed","A good Samaritan"]},{"term":"Bomb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thất bại thảm hại”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["One's hands are tied","One's eyes are bigger than one's stomach","One-trick pony","Bomb"]},{"term":"Bone of contention","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vấn đề gây tranh cãi; nguyên nhân bất hòa.”. Cậu chọn cụm phù hợp nhé.","prompt":"The terms of the contract became a _____ between the two companies.","choices":["full of beans","Bone of contention","Full of crap","Full of hot air"]},{"term":"Bookworm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mọt sách.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's a real _____; you'll always find her with her nose in a book.","choices":["Go cold turkey","Bookworm","Go down like a lead balloon","Go down in flames"]},{"term":"Born with a silver spoon in one's mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngậm thìa vàng (sinh ra trong một gia đình giàu có, quyền quý).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Out of left field","Out of date","Born with a silver spoon in one's mouth","Out of my hands"]}]},{"id":"idioms-v1-lesson-012","title":"Bài 12","focus":"Thành ngữ từ “Bottom of the barrel” đến “bringing up a family”.","questions":[{"term":"Bottom of the barrel","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lựa chọn tồi tệ nhất; thứ cặn bã, bét nhè.”. Cậu chọn cụm phù hợp nhé.","prompt":"The team is scraping the _____ to find players.","choices":["Calm before the storm","Bottom of the barrel","Call the shots","Calm someone down"]},{"term":"Box someone in","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dồn ai vào thế bí”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Big cheese","Box someone in","Big fish in a small pond","Beyond the pale"]},{"term":"Boxed in","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị dồn vào chân tường; bị mắc kẹt, không có lối thoát.”. Cậu chọn cụm phù hợp nhé.","prompt":"I feel so _____ by my current job. There's no room for creativity.","choices":["Make ends meet","Boxed in","Make eyes at someone","Make hay while the sun shines"]},{"term":"Brainstorm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Động não; cùng nhau thảo luận để đưa ra ý tưởng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's _____ ideas for the new marketing campaign.","choices":["Brainstorm","Go-to guy","Golden age","Golden opportunity"]},{"term":"Bread and butter","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cần câu cơm; nguồn thu nhập chính, thứ thiết yếu.”. Cậu chọn cụm phù hợp nhé.","prompt":"His freelance work is just extra; his _____ comes from his full-time job.","choices":["Foam at the mouth","Bread and butter","Follow in someone's footsteps","Follow the money"]},{"term":"Break a leg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chúc may mắn (thường dùng trước khi lên sân khấu biểu diễn).”. Cậu chọn cụm phù hợp nhé.","prompt":"You're going to do great in your performance tonight. _____!","choices":["A chip off the old block","A day late and a dollar short","Break a leg","A chip on your shoulder"]},{"term":"Break even","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hòa vốn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After all the expenses, we finally managed to _____ with the event.","choices":["Break even","window shopping","Wing it","Wine and dine"]},{"term":"break out in a cold sweat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Toát mồ hôi hột, toát mồ hôi lạnh (vì quá sợ hãi hoặc căng thẳng).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hear something straight from the horse’s mouth","Heads-up","Hear it on the grapevine","break out in a cold sweat"]},{"term":"Break someone's heart","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó tan nát cõi lòng; gây ra nỗi đau buồn sâu sắc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Scot-free","School someone in something","Break someone's heart","School of thought"]},{"term":"Break the bank","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phá sản vì tiêu xài quá mức; tốn rất nhiều tiền.”. Cậu chọn cụm phù hợp nhé.","prompt":"A nice dinner out doesn't have to _____.","choices":["Break the bank","wicked","window shopping","Wild and woolly"]},{"term":"Break the ice","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phá vỡ bầu không khí ngượng ngùng; làm quen, mở lời.”. Cậu chọn cụm phù hợp nhé.","prompt":"He told a joke to _____ at the beginning of the meeting.","choices":["Save for a rainy day","Break the ice","Save someone's skin","save face"]},{"term":"Break the news","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Báo tin (thường là tin xấu hoặc quan trọng).”. Cậu chọn cụm phù hợp nhé.","prompt":"He had to _____ to his family about his illness.","choices":["Break the news","Go on a wild goose chase","Go off the deep end","Go out of one's way"]},{"term":"Breeze through","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn thành một cách dễ dàng, nhanh chóng.”. Cậu chọn cụm phù hợp nhé.","prompt":"He managed to _____ the exam without any difficulties.","choices":["take the cake","take the floor","Take something with a grain of salt","Breeze through"]},{"term":"Bright and early","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sáng sớm tinh mơ.”. Cậu chọn cụm phù hợp nhé.","prompt":"We have to get up _____ for the hike tomorrow.","choices":["fall on deaf ears","familiarity breeds contempt","fancy pants","Bright and early"]},{"term":"Bring down the house","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trình diễn xuất sắc khiến cả khán đài vỗ tay rần rần.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["shed light on","Shoestring budget","Ships passing in the night","Bring down the house"]},{"term":"Bring home the bacon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trụ cột gia đình; kiếm tiền nuôi gia đình.”. Cậu chọn cụm phù hợp nhé.","prompt":"She worked hard to _____ for her children.","choices":["Train wreck","Bring home the bacon","Train of thought","Travel light"]},{"term":"Bring one's A game","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thể hiện phong độ tốt nhất; nỗ lực hết mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Squeaky clean","Bring one's A game","Stab someone in the back","Stand one's ground"]},{"term":"bring to light","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đưa ra ánh sáng, phơi bày sự thật bị che giấu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Carry the ball","Card shark","Carry a torch for someone","bring to light"]},{"term":"Bring up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nuôi nấng (trẻ em); đề cập, gợi lên (một chủ đề).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bring up","Give someone a song and dance","Give someone a run for their money","Give someone a piece of one's mind"]},{"term":"bringing up a family","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nuôi nấng một gia đình, nuôi dạy con cái.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ in a big city requires patience and financial stability.","choices":["Crocodile tears","Crickets","bringing up a family","Cream of the crop"]}]},{"id":"idioms-v1-lesson-013","title":"Bài 13","focus":"Thành ngữ từ “Brownie points” đến “by and large”.","questions":[{"term":"Brownie points","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điểm cộng; sự ghi nhận nỗ lực (để lấy lòng ai đó).”. Cậu chọn cụm phù hợp nhé.","prompt":"He brought coffee for everyone in the office to earn some _____ with the boss.","choices":["Smoke like a chimney","Smooth things over","Snowed under","Brownie points"]},{"term":"Bug someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm phiền ai đó; Quấy rầy”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bug someone","Burn the midnight oil","Bury one's head in the sand","Bury the hatchet"]},{"term":"build bridges","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xây dựng cầu nối quan hệ, hàn gắn bất đồng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The new manager worked hard to _____ between the marketing and engineering teams.","choices":["A scorcher","a red-letter day","A rip-off","build bridges"]},{"term":"Bull in a china shop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ vụng về, thô lỗ (trong tình huống cần sự tế nhị).”. Cậu chọn cụm phù hợp nhé.","prompt":"When negotiating deals, you can't be a _____.","choices":["Bull in a china shop","Keyed up","Kill the mood","Kick up one's heels"]},{"term":"Burgers and dogs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bánh mì kẹp thịt và xúc xích (món ăn truyền thống trong các buổi tiệc nướng ngoài trời ở Mỹ).”. Cậu chọn cụm phù hợp nhé.","prompt":"We're having a cookout this weekend, so we'll need plenty of _____.","choices":["Learn by rote","learn by heart","Burgers and dogs","Learn one's lesson"]},{"term":"Burn bridges","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phá vỡ quan hệ; qua cầu rút ván; tự cắt đứt đường lui.”. Cậu chọn cụm phù hợp nhé.","prompt":"Leaving the company without notice is a sure way to _____.","choices":["Burn bridges","rinky-dink","roll in it","roll out the red carpet"]},{"term":"Burn out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiệt sức, mất hết động lực do làm việc quá sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["The tip of the iceberg","Burn out","The tide has turned","The straight and narrow"]},{"term":"Burn the candle at both ends","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc quá sức từ sáng sớm đến đêm khuya; vắt kiệt sức lực.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Burn the candle at both ends","It's in the bag","Itchy feet","It takes two to tango"]},{"term":"Burn the midnight oil","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thức khuya làm việc hoặc học bài.”. Cậu chọn cụm phù hợp nhé.","prompt":"She had to _____ to finish her project on time.","choices":["Caught red-handed","Catch-22","Caught someone red-handed","Burn the midnight oil"]},{"term":"Bury one's head in the sand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trốn tránh thực tại; nhắm mắt làm ngơ trước khó khăn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A loose cannon","A little learning is a dangerous thing","A long face","Bury one's head in the sand"]},{"term":"Bury the hatchet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giảng hòa; bỏ qua hiềm khích.”. Cậu chọn cụm phù hợp nhé.","prompt":"After years of fighting, the two neighbors finally decided to _____.","choices":["Doom and gloom","Down in the dumps","Bury the hatchet","Double whammy"]},{"term":"Busy bee","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người bận rộn; người làm việc chăm chỉ.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's always a _____, never taking time to rest.","choices":["Throw caution to the wind","Throw someone for a loop","Busy bee","Throw a monkey wrench in the works"]},{"term":"Butt in","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chen ngang; Chõ mũi vào việc người khác”. Cậu chọn cụm phù hợp nhé.","prompt":"It’s rude to _____ when someone else is speaking.","choices":["Hold your horses","Hold the fort","Butt in","Hold out an olive branch"]},{"term":"Butter someone up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nịnh nọt, tâng bốc ai đó để trục lợi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["hit the spot","Butter someone up","Hocus-pocus","Hit the sack"]},{"term":"butterflies in one's stomach","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm giác bồn chồn, hồi hộp nôn nao (trước sự kiện quan trọng).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["kill time","Kill the mood","Kill two birds with one stone","butterflies in one's stomach"]},{"term":"Button one's lip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ mồm giữ miệng; ngậm miệng lại.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["fancy pants","Button one's lip","fall on deaf ears","familiarity breeds contempt"]},{"term":"Buy a lemon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mua phải món hàng dỏm, kém chất lượng (thường dùng cho xe cộ).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Feeling blue","Fender bender","Buy a lemon","feeling under the weather"]},{"term":"Buy something for a song","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mua được món gì đó với giá rẻ bèo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Buy something for a song","Out to lunch","Outdo oneself","Over my dead body"]},{"term":"by all means","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tất nhiên, bằng mọi giá; cứ tự nhiên.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you need to borrow my laptop for the presentation, _____ take it.","choices":["by all means","It ain't over till the fat lady sings","In the sticks","In the way"]},{"term":"by and large","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhìn chung, nói chung.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, the new policy has been well received by employees.","choices":["by and large","A little bird told me","A long face","A little learning is a dangerous thing"]}]},{"id":"idioms-v1-lesson-014","title":"Bài 14","focus":"Thành ngữ từ “By hook or by crook” đến “Carry the ball”.","questions":[{"term":"By hook or by crook","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bằng mọi giá, bằng bất cứ thủ đoạn nào”. Cậu chọn cụm phù hợp nhé.","prompt":"They were determined to get the project done _____.","choices":["By hook or by crook","mother nature","More than meets the eye","More than one bargained for"]},{"term":"By the book","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm đúng theo sách vở, tuân thủ nghiêm ngặt các quy tắc”. Cậu chọn cụm phù hợp nhé.","prompt":"The new manager insists on doing everything _____.","choices":["Don't cry over spilt milk","Don't beat a dead horse","By the book","Don't count your chickens before they hatch"]},{"term":"By the skin of ones teeth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sát nút, trong gang tấc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Shot in the dark","Show of hands","Sick as a dog","By the skin of ones teeth"]},{"term":"By word of mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Truyền miệng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["rinky-dink","By word of mouth","roll out the red carpet","roll in it"]},{"term":"Call a spade a spade","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói toạc móng heo, nói thẳng nói thật”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s _____ – that project failed because of poor planning.","choices":["eat one's heart out","elevator pitch","egg on one's face","Call a spade a spade"]},{"term":"Call it a day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kết thúc công việc; Nghỉ tay”. Cậu chọn cụm phù hợp nhé.","prompt":"We didn’t finish the project, but we were tired and decided to _____.","choices":["Call it a day","Go bananas","Go back to the drawing board","Go around in circles"]},{"term":"call it quits","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dừng lại, nghỉ tay, buông xuôi kết thúc công việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"We have been studying for eight straight hours; let us _____ for tonight.","choices":["call it quits","come to light","Come rain or shine","come to terms with"]},{"term":"Call someone on the carpet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gọi lên mắng vốn; Khiển trách”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["In the black","Call someone on the carpet","In the bag","In stitches"]},{"term":"Call someones bluff","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lật tẩy, thách thức ai đó chứng minh lời đe dọa của họ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get the third degree","Call someones bluff","Get the sack","Get this show on the road"]},{"term":"Call the shots","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người chỉ huy, người đưa ra quyết định”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Think outside the box","Call the shots","There's a method to his madness","There's no such thing as a free lunch"]},{"term":"Calm before the storm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự bình yên trước cơn bão”. Cậu chọn cụm phù hợp nhé.","prompt":"The office was quiet, but it felt like the _____.","choices":["The hilt","Calm before the storm","the gift of the gab","The jury is still out"]},{"term":"Calm someone down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó bình tĩnh lại”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Calm someone down","Midas touch","Mind your own beeswax","Middle of the road"]},{"term":"Cant hold a candle to","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không thể sánh bằng, thua xa”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cant hold a candle to","everything but the kitchen sink","every now and then","exact change"]},{"term":"Cant judge a book by its cover","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng trông mặt mà bắt hình dong”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wet blanket","Cant judge a book by its cover","Wet one's whistle","What are you up to?"]},{"term":"Cant keep up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không theo kịp”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["As right as rain","Cant keep up","As the crow flies","As white as a sheet/as white as a ghost"]},{"term":"Cant put a face to the name","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Biết tên nhưng không nhớ mặt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cant put a face to the name","Burn the midnight oil","Burn the candle at both ends","Burn out"]},{"term":"Cant see the forest for the trees","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thấy cây mà không thấy rừng (chỉ nhìn chi tiết mà bỏ qua toàn cục)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cant see the forest for the trees","Scot-free","School someone in something","Screw up"]},{"term":"Card shark","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tay cờ bạc bịp, cao thủ chơi bài”. Cậu chọn cụm phù hợp nhé.","prompt":"Be careful; he’s known to be a _____ in high-stakes poker games.","choices":["Card shark","Break the bank","Break the news","Break the ice"]},{"term":"Carry a torch for someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Yêu đơn phương”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Carry a torch for someone","In the least","In the long run","In the loop"]},{"term":"Carry the ball","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chịu trách nhiệm chính, gánh vác công việc”. Cậu chọn cụm phù hợp nhé.","prompt":"After John left the company, Lisa had to _____ for their department.","choices":["Cost an arm and a leg","Corner the market","Carry the ball","Cost a mint"]}]},{"id":"idioms-v1-lesson-015","title":"Bài 15","focus":"Thành ngữ từ “cash cow” đến “Change of heart”.","questions":[{"term":"cash cow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cỗ máy in tiền, nguồn hái ra tiền béo bở.”. Cậu chọn cụm phù hợp nhé.","prompt":"That subscription service has become the company's biggest _____.","choices":["cash cow","Go out of one's way","Go off the deep end","Go on a wild goose chase"]},{"term":"Cast pearls before swine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đàn gảy tai trâu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cast pearls before swine","Bad hair day","Bad blood","Band-Aid on a bullet wound"]},{"term":"Cast-iron stomach","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dạ dày tốt, ăn gì cũng không bị đau bụng”. Cậu chọn cụm phù hợp nhé.","prompt":"My grandmother has a _____; she can eat anything and never gets sick.","choices":["Hit it on the nose","Cast-iron stomach","Hit pay dirt","Hit me up"]},{"term":"Castle in the sky","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kế hoạch viển vông, ảo tưởng”. Cậu chọn cụm phù hợp nhé.","prompt":"Without realistic steps, his aspirations are nothing but a _____.","choices":["Filthy rich","Fight tooth and nail","Fill in the blanks","Castle in the sky"]},{"term":"Cat got your tongue?","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mèo tha mất lưỡi rồi à? (Sao tự dưng im lặng thế?)”. Cậu chọn cụm phù hợp nhé.","prompt":"Why are you so quiet? _____","choices":["Cat got your tongue?","Just a moment","Junk food","Jump through hoops"]},{"term":"Cat nap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giấc ngủ ngắn”. Cậu chọn cụm phù hợp nhé.","prompt":"I took a quick _____ during my lunch break.","choices":["Cat nap","fall into place","fall by the wayside","fair-weather friend"]},{"term":"catch one's death of cold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị cảm lạnh nặng (do dầm mưa, chịu rét).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sitting like a bump on a log","catch one's death of cold","Sitting pretty","Sixth sense"]},{"term":"catch red-handed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt quả tang, bắt tận tay day tận trán.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["that is to say","test the waters","catch red-handed","tell me about it"]},{"term":"Catch some rays","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tắm nắng”. Cậu chọn cụm phù hợp nhé.","prompt":"I’m planning to head to the beach this weekend to _____.","choices":["Pitch in","Play catch-up","Pitch dark","Catch some rays"]},{"term":"Catch some Zs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chợp mắt, đi ngủ”. Cậu chọn cụm phù hợp nhé.","prompt":"I need to _____ before the long drive.","choices":["Fly-by-night","fly through","Catch some Zs","Fly the coop"]},{"term":"catch someone's eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thu hút sự chú ý của ai, bắt gặp ánh mắt ai.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["catch someone's eye","Slip of the tongue","Slim chance","Slow and steady wins the race"]},{"term":"Catch someones eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thu hút sự chú ý của ai đó, lọt vào mắt xanh”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["In the way","It ain't over till the fat lady sings","It is a poor workman who blames his tools","Catch someones eye"]},{"term":"Catch the bus","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt xe buýt kịp lúc”. Cậu chọn cụm phù hợp nhé.","prompt":"I need to leave now if I want to _____.","choices":["nuclear family","Catch the bus","Odd man out","Number cruncher"]},{"term":"catch you later","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gặp lại bạn sau nhé! / Tạm biệt nhé!”. Cậu chọn cụm phù hợp nhé.","prompt":"I have to rush to my meeting now—_____!","choices":["Smell a rat","catch you later","Slow and steady wins the race","Small world"]},{"term":"Catch-22","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình huống trớ trêu, tiến thoái lưỡng nan”. Cậu chọn cụm phù hợp nhé.","prompt":"It’s a _____: you need a credit history to get a credit card, but you need a credit card to build a credit history.","choices":["Go-to guy","Golden age","Catch-22","Golden opportunity"]},{"term":"Caught red-handed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị bắt quả tang”. Cậu chọn cụm phù hợp nhé.","prompt":"The thief was _____ trying to steal the car.","choices":["Caught red-handed","Go it alone","Go off half-cocked","Go haywire"]},{"term":"Caught someone red-handed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt quả tang ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Stay on budget","step up one's game","Caught someone red-handed","Steal someone's thunder"]},{"term":"Caught with ones hand in the cookie jar","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị bắt tại trận khi đang làm việc xấu mờ ám”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["as cool as a cucumber","As easy as ABC","As easy as pie","Caught with ones hand in the cookie jar"]},{"term":"Change horses in midstream","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thay ngựa giữa dòng (thay đổi kế hoạch/lãnh đạo giữa chừng)”. Cậu chọn cụm phù hợp nhé.","prompt":"We can’t _____ now; let’s see this through to the end.","choices":["Change horses in midstream","Strike it rich","Street-smart","Stretch the truth"]},{"term":"Change of heart","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thay đổi tâm ý, đổi ý”. Cậu chọn cụm phù hợp nhé.","prompt":"After much consideration, she had a _____ about moving to another city.","choices":["Fool's gold","foot the bill","Change of heart","Foot in the door"]}]},{"id":"idioms-v1-lesson-016","title":"Bài 16","focus":"Thành ngữ từ “Charley horse” đến “Close but no cigar”.","questions":[{"term":"Charley horse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuột rút”. Cậu chọn cụm phù hợp nhé.","prompt":"I woke up in the middle of the night with a painful _____.","choices":["Play catch-up","Play dumb","Charley horse","Play devil’s advocate"]},{"term":"Charmed life","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cuộc sống may mắn, suôn sẻ như có quý nhân phù trợ”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite all the dangers he’s faced, he seems to be living a _____.","choices":["Charmed life","In a nutshell","In a rut","In a pinch"]},{"term":"Chasing rainbows","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Theo đuổi ảo vọng, mơ mộng hão huyền”. Cậu chọn cụm phù hợp nhé.","prompt":"Stop _____ and focus on what’s important right now.","choices":["Chasing rainbows","Don't count your chickens before they hatch","Don't cry over spilt milk","Don't do anything I wouldn't do"]},{"term":"Checkered past","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quá khứ thăng trầm, quá khứ có vết nhơ”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite his _____, he has turned his life around.","choices":["Get one's head around something","Get one's hackles up","Checkered past","Get out of hand"]},{"term":"Cheer up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vui lên đi”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, Tom! Everything will be alright.","choices":["Cheer up","The whole ball of wax","The tip of the iceberg","The whole nine yards"]},{"term":"cherry-pick","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kén cá chọn canh; chọn lọc lấy những cái tốt nhất / có lợi nhất cho mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["cherry-pick","Pull the wool over someone's eyes","pull up stakes","pull your weight"]},{"term":"Chew someone out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mắng nhiếc, chửi mắng thậm tệ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wash one's hands of something","Wallflower","Waste not, want not","Chew someone out"]},{"term":"Chew something over","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Suy nghĩ kỹ càng, cân nhắc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Saved by the bell","Save for a rainy day","Chew something over","Save someone's skin"]},{"term":"Chewing the fat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tán gẫu, buôn dưa lê”. Cậu chọn cụm phù hợp nhé.","prompt":"We spent the afternoon _____ and catching up on each other’s lives.","choices":["Give someone a hard time","Chewing the fat","Give someone a piece of one's mind","Give someone a run for their money"]},{"term":"Chicken out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhát gan; Chùn bước”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["drop by","drop out of school","Chicken out","drive someone up the wall"]},{"term":"Chow down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn ngấu nghiến, đánh chén”. Cậu chọn cụm phù hợp nhé.","prompt":"After the hike, we all wanted to _____ on some burgers and fries.","choices":["Look like a million bucks","Look like the cat that got the cream","Chow down","look like death warmed over"]},{"term":"Chuffed to bits","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ vui sướng, hãnh diện”. Cậu chọn cụm phù hợp nhé.","prompt":"He was _____ after winning the award.","choices":["Have one's heart set on","have one's ducks in a row","Have one's head in the clouds","Chuffed to bits"]},{"term":"clean bill of health","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giấy chứng nhận sức khỏe tốt; kết luận hoàn toàn khỏe mạnh / đạt chuẩn an toàn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a comprehensive physical checkup, the doctor gave him a _____.","choices":["Goof off","clean bill of health","Good to know","Goody-goody gumdrops"]},{"term":"Clean slate","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm lại từ đầu, xóa bỏ quá khứ”. Cậu chọn cụm phù hợp nhé.","prompt":"After the company’s restructuring, everyone was given a _____ to prove themselves.","choices":["Clean slate","Throw someone to the wolves","Tickled pink","Throw someone for a loop"]},{"term":"Clean someone out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vét sạch tiền túi của ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["on the rocks","On the same wavelength","On the same page","Clean someone out"]},{"term":"Clear as mud","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khó hiểu, rối rắm (nghĩa mỉa mai)”. Cậu chọn cụm phù hợp nhé.","prompt":"His explanations were _____; no one could understand them.","choices":["a tall story","A toss-up","A walk in the park","Clear as mud"]},{"term":"Clear the air","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xóa bỏ hiểu lầm, làm rõ vấn đề để giải tỏa căng thẳng”. Cậu chọn cụm phù hợp nhé.","prompt":"After their argument, they needed to sit down and _____.","choices":["Clear the air","Collect dust","Come a long way","Come alive"]},{"term":"climb the corporate ladder","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thăng tiến trên con đường sự nghiệp công sở.”. Cậu chọn cụm phù hợp nhé.","prompt":"She worked long hours with great dedication to _____.","choices":["run out of time","run out of steam","climb the corporate ladder","run one's mouth off"]},{"term":"Climb the walls","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phát cuồng, bồn chồn bứt rứt”. Cậu chọn cụm phù hợp nhé.","prompt":"Being cooped up inside all day makes me feel like I could _____.","choices":["Climb the walls","Hit the ceiling","Hit someone below the belt","Hit the books"]},{"term":"Close but no cigar","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Suýt trúng, gần đúng nhưng vẫn sai”. Cậu chọn cụm phù hợp nhé.","prompt":"He almost won the race, but _____.","choices":["Close but no cigar","Mad as a hornet","Make a beeline for","Made for each other"]}]},{"id":"idioms-v1-lesson-017","title":"Bài 17","focus":"Thành ngữ từ “Close shave” đến “Come out of one's shell”.","questions":[{"term":"Close shave","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thoát hiểm trong gang tấc”. Cậu chọn cụm phù hợp nhé.","prompt":"That was a _____; I almost broke my leg!","choices":["Close shave","Knee-jerk reaction","Knee-high to a grasshopper","Kit and caboodle"]},{"term":"Closed-minded","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bảo thủ, hẹp hòi, không chịu tiếp thu ý kiến mới.”. Cậu chọn cụm phù hợp nhé.","prompt":"He was too _____ to appreciate the new ideas presented in the meeting.","choices":["Cock-and-bull story","Clown around","Clouds on the horizon","Closed-minded"]},{"term":"Clouds on the horizon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sắp có chuyện chẳng lành; Dấu hiệu điềm gở”. Cậu chọn cụm phù hợp nhé.","prompt":"The doctor’s serious tone made it clear that there are _____ regarding his health.","choices":["Turn over a new leaf","Turn a place upside down","Turn the other cheek","Clouds on the horizon"]},{"term":"Clown around","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm trò hề, đùa cợt lố lăng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Clown around","Down the tube","down to the wire","down to earth"]},{"term":"Cock-and-bull story","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện bịa đặt, chuyện hoang đường không đáng tin.”. Cậu chọn cụm phù hợp nhé.","prompt":"He told me a real _____ about why he was late.","choices":["fashion victim","far and wide","fancy pants","Cock-and-bull story"]},{"term":"Coin a new term","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đặt ra một thuật ngữ mới.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Coin a new term","Sticky fingers","Stick-in-the-mud","Sticking point"]},{"term":"Coin a phrase","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đặt ra một cụm từ mới, tạo ra một thành ngữ mới.”. Cậu chọn cụm phù hợp nhé.","prompt":"Who was the first person to _____?","choices":["Stab someone in the back","Stand one's ground","Stand up for","Coin a phrase"]},{"term":"Cold enough to freeze the balls off a brass monkey","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rét thấu xương, lạnh cóng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The temperature dropped so low last night, it was _____.","choices":["If you can't stand the heat, get out of the kitchen","If you play your cards right","Ignorance is bliss","Cold enough to freeze the balls off a brass monkey"]},{"term":"Cold feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chùn bước, mất hết can đảm (ngay trước khi làm việc gì đó).”. Cậu chọn cụm phù hợp nhé.","prompt":"He got _____ right before the wedding and called it off.","choices":["Play hardball","Cold feet","Play devil’s advocate","Play dumb"]},{"term":"Cold shoulder","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự lạnh nhạt, sự hờ hững.”. Cậu chọn cụm phù hợp nhé.","prompt":"She gave him the _____ after their argument.","choices":["Cold shoulder","Knock something into a cocked hat","Knock on wood","Knock someone's socks off"]},{"term":"Collect dust","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị bỏ xó, đóng bụi (vì lâu không được sử dụng).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Curiosity killed the cat","cup of tea","Collect dust","Curveball"]},{"term":"Come a long way","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiến bộ vượt bậc, có bước tiến dài.”. Cậu chọn cụm phù hợp nhé.","prompt":"She has _____ since she first started learning to play the piano.","choices":["Come a long way","Go off the deep end","Go off half-cocked","Go on a wild goose chase"]},{"term":"Come alive","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trở nên sống động, nhộn nhịp hẳn lên.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Ivory tower","Itchy feet","Come alive","Jaywalking"]},{"term":"Come clean","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thú nhận sự thật, khai báo thành khẩn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After months of lying, he decided to _____ about his mistakes.","choices":["Come clean","keep tabs on","Keep the ball rolling","Keep something under wraps"]},{"term":"Come down with a cold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị cảm lạnh, đổ bệnh cảm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["window shopping","Wild and woolly","wicked","Come down with a cold"]},{"term":"Come hell or high water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dù có chuyện gì xảy ra, dù khó khăn đến mấy.”. Cậu chọn cụm phù hợp nhé.","prompt":"I’ll be at your wedding, _____.","choices":["familiarity breeds contempt","fancy pants","Come hell or high water","fall on deaf ears"]},{"term":"Come in handy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trở nên hữu ích, có ích.”. Cậu chọn cụm phù hợp nhé.","prompt":"Keep this tool in your bag, it might _____ one day.","choices":["Sales pitch","Come in handy","Salt of the earth","Sail close to the wind"]},{"term":"come of age","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đến tuổi trưởng thành, đạt độ chín muồi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get something out of one's system","come of age","Get something through one's head","Get something off one's chest"]},{"term":"Come out flat-footed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị bất ngờ, không kịp trở tay, thiếu sự chuẩn bị.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take your time","take with a grain of salt","Come out flat-footed","take the wind out of someone's sails"]},{"term":"Come out of one's shell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bớt rụt rè, trở nên cởi mở và tự tin hơn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Grease monkey","Come out of one's shell","Gravy train","Gray area"]}]},{"id":"idioms-v1-lesson-018","title":"Bài 18","focus":"Thành ngữ từ “Come out smelling like a rose” đến “Country mile”.","questions":[{"term":"Come out smelling like a rose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình yên vô sự, không bị mang tiếng xấu (sau một vụ rắc rối).”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite the controversy, she managed to _____.","choices":["Do a number on something","Dish the dirt","Divide the spoils","Come out smelling like a rose"]},{"term":"Come out swinging","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phản kháng quyết liệt, đáp trả mạnh mẽ ngay từ đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Come out swinging","Turn over a new leaf","Turn the other cheek","Turn a place upside down"]},{"term":"Come rain or shine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dù mưa hay nắng, trong bất kỳ hoàn cảnh nào.”. Cậu chọn cụm phù hợp nhé.","prompt":"I’ll be there to support you, _____.","choices":["Greased lightning","Come rain or shine","Grease monkey","Gray area"]},{"term":"come to light","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị phơi bày, lộ ra ánh sáng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Shocking details of the corporate scandal have recently _____.","choices":["come to light","Get along with someone","Get a word in edgewise","Get ahold of yourself"]},{"term":"come to terms with","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chấp nhận, đành lòng làm quen với một sự thật đau buồn.”. Cậu chọn cụm phù hợp nhé.","prompt":"It took her years to _____ the loss of her dear friend.","choices":["Out to lunch","Out on the town","Outdo oneself","come to terms with"]},{"term":"Comfort food","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Món ăn xoa dịu tinh thần (thường gợi nhớ tuổi thơ).”. Cậu chọn cụm phù hợp nhé.","prompt":"When I’m stressed, I turn to macaroni and cheese as my _____.","choices":["Close shave","Climb the walls","Comfort food","Close but no cigar"]},{"term":"Compare apples and oranges","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “So sánh khập khiễng (hai thứ hoàn toàn khác nhau).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Compare apples and oranges","Not worth a red cent","Nothing to write home about","nuclear family"]},{"term":"Computer crashed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Máy tính bị treo, sập nguồn.”. Cậu chọn cụm phù hợp nhé.","prompt":"My _____ right before I could save my work.","choices":["run out of time","Computer crashed","run one's mouth off","run out of steam"]},{"term":"Cook someone's goose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm hỏng kế hoạch của ai đó, khiến ai đó chuốc lấy thất bại.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Scapegoat","Say uncle","Say one's piece","Cook someone's goose"]},{"term":"Cook the books","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm giả sổ sách, gian lận sổ sách kế toán.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cook the books","Cold shoulder","Cold enough to freeze the balls off a brass monkey","Cold feet"]},{"term":"Cook up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bịa đặt (câu chuyện, lý do), vạch ra (kế hoạch).”. Cậu chọn cụm phù hợp nhé.","prompt":"He tried to _____ an excuse for being late to the meeting.","choices":["build bridges","Bull in a china shop","Cook up","Bug someone"]},{"term":"Cool as a cucumber","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng bình tĩnh, điềm nhiên như không.”. Cậu chọn cụm phù hợp nhé.","prompt":"Even during the intense meeting, she remained as _____.","choices":["It takes one to know one","It takes two to tango","It is always darkest before the dawn","Cool as a cucumber"]},{"term":"Cool your jets","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình tĩnh lại đi, bớt nóng nảy đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"You need to _____ and think this through.","choices":["extended family","exact change","Cool your jets","excuse my French / pardon my French"]},{"term":"Copycat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ bắt chước, người chuyên sao chép người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"Stop being a _____ and come up with your own ideas.","choices":["Copycat","If I had a nickel for every time something happened","Icing on the cake","Idle hands are the devil's tools"]},{"term":"Corner the market","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Độc quyền thị trường, lũng đoạn thị trường.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Idle hands are the devil's tools","Icing on the cake","I'm losing it","Corner the market"]},{"term":"Cost a mint","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đắt đỏ, tốn cả đống tiền.”. Cậu chọn cụm phù hợp nhé.","prompt":"The new car _____, but it’s worth every penny.","choices":["At best","Cost a mint","As the crow flies","As white as a sheet/as white as a ghost"]},{"term":"Cost an arm and a leg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đắt cắt cổ, tốn một khoản tiền lớn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Out to lunch","Over my dead body","Outdo oneself","Cost an arm and a leg"]},{"term":"Couch potato","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người lười biếng suốt ngày dán mắt vào tivi.”. Cậu chọn cụm phù hợp nhé.","prompt":"He became a _____ after retiring from work.","choices":["Like riding a bike","Like taking candy from a baby","Couch potato","Like there's no tomorrow"]},{"term":"Couldn't care less","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn toàn không quan tâm, không mảy may bận tâm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go to pieces","Couldn't care less","Go to hell in a handbasket","Go through something with a fine-tooth comb"]},{"term":"Country mile","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một khoảng cách rất xa.”. Cậu chọn cụm phù hợp nhé.","prompt":"We still have a _____ to go before we reach the nearest town.","choices":["Josh someone","jump for joy","Jump down someone's throat","Country mile"]}]},{"id":"idioms-v1-lesson-019","title":"Bài 19","focus":"Thành ngữ từ “Cover a lot of ground” đến “Curveball”.","questions":[{"term":"Cover a lot of ground","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bàn luận/giải quyết nhiều vấn đề, bao quát nhiều nội dung.”. Cậu chọn cụm phù hợp nhé.","prompt":"In today’s meeting, we need to _____ in a short time.","choices":["Spread yourself too thin","Cover a lot of ground","Square meal","Squeaky clean"]},{"term":"Crack a book","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mở sách ra học, đụng đến sách vở.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you want to pass the test, you need to _____ tonight.","choices":["Hit the ceiling","Hit the hay","Hit the jackpot","Crack a book"]},{"term":"Crack open a cold one","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mở một lon bia lạnh để giải khát/thư giãn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a long day at work, he likes to _____ and unwind.","choices":["a drop in the bucket","Crack open a cold one","A far cry from (something)","a drop in the ocean"]},{"term":"Crack someone up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm cho ai đó cười phá lên, chọc cười ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Street-smart","Crack someone up","Stop on a dime","Stonewall"]},{"term":"cram for an exam","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Học nhồi học nhét trước kỳ thi, học dồn nước đến chân mới nhảy.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["out of sorts","cram for an exam","out of shape","Out of the blue"]},{"term":"Crank out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sản xuất hàng loạt, làm ra một cách vội vã.”. Cậu chọn cụm phù hợp nhé.","prompt":"During finals week, I had to _____ several papers in a row.","choices":["Go-to guy","Golden opportunity","Golden age","Crank out"]},{"term":"Cream of the crop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phần tinh túy nhất, người/vật xuất sắc nhất trong nhóm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Only the _____ get selected for the elite team.","choices":["Get your walking papers","Get wind of something","Get with it","Cream of the crop"]},{"term":"Crickets","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự im lặng đáng sợ (khi không ai lên tiếng hưởng ứng hay trả lời).”. Cậu chọn cụm phù hợp nhé.","prompt":"When I asked for volunteers, I was met with _____.","choices":["Crickets","It takes one to know one","It is always darkest before the dawn","It is a poor workman who blames his tools"]},{"term":"Crocodile tears","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nước mắt cá sấu, sự đau buồn giả tạo.”. Cậu chọn cụm phù hợp nhé.","prompt":"He shed _____ at the funeral, though everyone knew he didn’t care.","choices":["Whitewash","White lie","White elephant","Crocodile tears"]},{"term":"Cross one's fingers","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cầu may mắn, đan chéo ngón tay cầu nguyện.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cross one's fingers","shop till you drop","Shoot the breeze","Shoot off one's mouth"]},{"term":"cross paths","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình cờ gặp gỡ, hội ngộ tình cờ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Walk on air","Wash one's hands of something","cross paths","Wallflower"]},{"term":"Cross that bridge when one comes to it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tới đâu hay tới đó, khi nào có chuyện mới giải quyết.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cross that bridge when one comes to it","From time to time","Fuddy-duddy","full of beans"]},{"term":"cross your fingers","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cầu chúc may mắn, hy vọng mọi chuyện suôn sẻ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Greased lightning","cross your fingers","Great minds think alike","Grease monkey"]},{"term":"Crunch time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thời khắc quyết định, giai đoạn nước rút.”. Cậu chọn cụm phù hợp nhé.","prompt":"With the project deadline tomorrow, it's _____ for the whole team.","choices":["Poker face","Crunch time","Pony up","Play with fire"]},{"term":"cry over spilled milk","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kêu khóc nuối tiếc chuyện đã rồi (chuyện đã qua không cứu vãn được).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Through thick and thin","cry over spilled milk","Three sheets to the wind","thrilled to bits"]},{"term":"Cry wolf","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kêu cứu giả vờ, báo động giả nhiều lần khiến không ai tin nữa.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you _____ too many times, people won't believe you when you're telling the truth.","choices":["Pay through the nose","Pay the piper","Cry wolf","peanut gallery"]},{"term":"Cup of joe","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một tách cà phê.”. Cậu chọn cụm phù hợp nhé.","prompt":"I need a _____ to start my day.","choices":["Lose touch","Lose one's touch","Cup of joe","Lose one's shirt"]},{"term":"cup of tea","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sở thích, gu ưa thích của ai.”. Cậu chọn cụm phù hợp nhé.","prompt":"Horror movies are really not my _____; I prefer romantic comedies.","choices":["fat cat","feather one's nest","fashion victim","cup of tea"]},{"term":"Curiosity killed the cat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tò mò hại thân.”. Cậu chọn cụm phù hợp nhé.","prompt":"You shouldn’t go poking around in his room, remember, _____.","choices":["As happy as a clam","Curiosity killed the cat","As genuine as a three-dollar bill","As easy as pie"]},{"term":"Curveball","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự việc bất ngờ (thường gây khó khăn), quả bóng xoáy.”. Cậu chọn cụm phù hợp nhé.","prompt":"Life threw me a _____ when I lost my job suddenly.","choices":["Curveball","rest on one's laurels","ring a bell","right this way"]}]},{"id":"idioms-v1-lesson-020","title":"Bài 20","focus":"Thành ngữ từ “Cut and dried” đến “Deep down”.","questions":[{"term":"Cut and dried","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đã được định đoạt, rõ ràng rành rọt.”. Cậu chọn cụm phù hợp nhé.","prompt":"The rules for the competition are _____.","choices":["You're telling me","You get what you pay for","You've sold me","Cut and dried"]},{"term":"cut corners","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đốt cháy giai đoạn, làm ẩu để tiết kiệm tiền/thời gian.”. Cậu chọn cụm phù hợp nhé.","prompt":"Never _____ when it comes to construction safety standards.","choices":["jump for joy","cut corners","Josh someone","Jump down someone's throat"]},{"term":"Cut someone off at the knees","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Triệt hạ uy tín, làm bẽ mặt, dập tắt sự tự tin của ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Just now","Just around the corner","Keep an eye on","Cut someone off at the knees"]},{"term":"Cut someone some slack","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chiếu cố, nương tay cho ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A penny saved is a penny earned","Cut someone some slack","A penny for your thoughts","A perfect storm"]},{"term":"Cut the mustard","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đạt yêu cầu, đáp ứng được tiêu chuẩn.”. Cậu chọn cụm phù hợp nhé.","prompt":"I’m not sure if he can _____ in this highly competitive industry.","choices":["Go haywire","Go it alone","Cut the mustard","Go off half-cocked"]},{"term":"Cut to the chase","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi thẳng vào vấn đề.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's _____ — how much is this going to cost?","choices":["Turn a blind eye","Turn over a new leaf","Cut to the chase","Turn a place upside down"]},{"term":"Cut to the quick","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chạm nọc, làm tổn thương sâu sắc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Barking up the wrong tree","Batting a thousand","Band-Aid on a bullet wound","Cut to the quick"]},{"term":"Cute as a bug","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất dễ thương.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her baby is _____; everyone loves to hold him.","choices":["Keep one's head","Keep one's mouth shut","Cute as a bug","Keep one's head above water"]},{"term":"Cutting corners","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi tắt đón đầu, làm việc cẩu thả để tiết kiệm thời gian hoặc tiền bạc.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you keep _____, the project will not meet the quality standards.","choices":["Smoke like a chimney","Smooth things over","Smoke and mirrors","Cutting corners"]},{"term":"Damn someone with faint praise","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khen để mà chê, khen lấy lệ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Tuckered out","Damn someone with faint praise","Troubled waters","True blue"]},{"term":"Dawned on me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chợt nhận ra.”. Cậu chọn cụm phù hợp nhé.","prompt":"It finally _____ that I had left my keys at home.","choices":["Dawned on me","Along for the ride","All thumbs","All wet"]},{"term":"day in day out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngày này qua ngày khác, ngày nào cũng như ngày nào.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, he rode the same crowded commuter train to work.","choices":["day in day out","Who do you think you are?","wicked","Wild and woolly"]},{"term":"Dead from the neck up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngu ngốc, không có não.”. Cậu chọn cụm phù hợp nhé.","prompt":"He's so careless with his work; he's practically _____.","choices":["Last but not least","last straw","Last-ditch effort","Dead from the neck up"]},{"term":"Dead in the water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bế tắc, dậm chân tại chỗ.”. Cậu chọn cụm phù hợp nhé.","prompt":"The project is _____ without additional funding.","choices":["It is always darkest before the dawn","It takes one to know one","Dead in the water","It is a poor workman who blames his tools"]},{"term":"Dead quiet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Yên tĩnh tĩnh mịch, lặng ngắt như tờ.”. Cậu chọn cụm phù hợp nhé.","prompt":"The classroom was _____ during the exam.","choices":["Dead quiet","keep your chin up","Keep up with","Keep up with the Joneses"]},{"term":"Dead ringer","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bản sao giống hệt.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's a _____ for her mother.","choices":["the long and short of it","Dead ringer","the other day","the munchies"]},{"term":"Dead tired","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mệt lử, mệt chết đi được.”. Cậu chọn cụm phù hợp nhé.","prompt":"After hiking all day, I was completely _____.","choices":["Keep the ball rolling","keep tabs on","Dead tired","Keep something under wraps"]},{"term":"Dead to the world","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngủ say như chết.”. Cậu chọn cụm phù hợp nhé.","prompt":"After the long hike, he was _____ as soon as he hit the bed.","choices":["Dead to the world","Touch and go","Touch base","Top-notch"]},{"term":"Dead-end job","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Công việc không có cơ hội thăng tiến.”. Cậu chọn cụm phù hợp nhé.","prompt":"Tom felt stuck in a _____ with no hope of promotion.","choices":["Dead-end job","the other day","the patience of Job","the pits"]},{"term":"Deep down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tận đáy lòng, sâu thẳm bên trong.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, he knows he should apologize.","choices":["Deep down","Bottom of the barrel","Born with a silver spoon in one's mouth","Bookworm"]}]},{"id":"idioms-v1-lesson-021","title":"Bài 21","focus":"Thành ngữ từ “devil's advocate” đến “Don't count your chickens before they hatch”.","questions":[{"term":"devil's advocate","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người phản biện, người đóng vai phản bác để đào sâu vấn đề.”. Cậu chọn cụm phù hợp nhé.","prompt":"I agree with your plan, but let me play _____ to test its weaknesses.","choices":["Leave someone in the lurch","Leave someone out in the cold","Leave well enough alone","devil's advocate"]},{"term":"Diamond in the rough","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Viên ngọc thô (người/vật có tiềm năng nhưng chưa được mài giũa).”. Cậu chọn cụm phù hợp nhé.","prompt":"The new intern is a real _____; with some training, he could become a great asset to the team.","choices":["Diamond in the rough","Whitewash","Who asked you?","Who do you think you are?"]},{"term":"Different strokes for different folks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mỗi người một sở thích.”. Cậu chọn cụm phù hợp nhé.","prompt":"Some people like hiking, while others prefer reading. _____.","choices":["cram for an exam","Cream of the crop","Crank out","Different strokes for different folks"]},{"term":"Dig in your heels","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiên quyết giữ vững lập trường, ngoan cố.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Dig in your heels","Caught red-handed","Caught someone red-handed","Catch-22"]},{"term":"Dirt cheap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rẻ bèo, rẻ như cho.”. Cậu chọn cụm phù hợp nhé.","prompt":"I found this shirt at the market, and it was _____.","choices":["When pigs fly","When the chips are down","Dirt cheap","When push comes to shove"]},{"term":"Dish the dirt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngồi lê đôi mách, nói xấu người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"She loves to _____ about her coworkers.","choices":["cram for an exam","Crack open a cold one","Dish the dirt","Crack someone up"]},{"term":"Divide the spoils","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chia chác chiến lợi phẩm.”. Cậu chọn cụm phù hợp nhé.","prompt":"After the successful business venture, the partners gathered to _____.","choices":["Graveyard shift","Gravy train","Gray area","Divide the spoils"]},{"term":"Do a number on something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gây tổn hại nghiêm trọng, tàn phá.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["set foot in","Sell someone short","Do a number on something","Serve one right"]},{"term":"Do or die","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chơi tới bến, được ăn cả ngã về không.”. Cậu chọn cụm phù hợp nhé.","prompt":"I have to nail this presentation. It's a _____ situation.","choices":["drop out of school","drop someone a line","drop by","Do or die"]},{"term":"Do someone a good turn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc tốt giúp đỡ ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Do someone a good turn","give someone the brush-off","Give someone the heads-up","Give someone the cold shoulder"]},{"term":"Do something at the drop of a hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc gì đó ngay lập tức, không chút do dự.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get off scot-free","Do something at the drop of a hat","Get off on the wrong foot","Get off one's high horse"]},{"term":"Do something by the seat of your pants","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc theo bản năng, không có kế hoạch trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Do something by the seat of your pants","Carry a torch for someone","Carry the ball","cash cow"]},{"term":"Doesn't hold water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không đáng tin, vô lý.”. Cậu chọn cụm phù hợp nhé.","prompt":"His explanation for being late just _____.","choices":["Doesn't hold water","Sharp as a tack","Shape up or ship out","shed light on"]},{"term":"Doesn't know beans about it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không biết tí gì về chuyện đó, mù tịt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Doesn't know beans about it","Get hold of someone","Get hold of something","Get from A to B"]},{"term":"Dog and pony show","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Buổi biểu diễn màu mè, làm màu.”. Cậu chọn cụm phù hợp nhé.","prompt":"The investors saw right through the _____ and asked for more concrete details.","choices":["Dog and pony show","Last but not least","last straw","Last-ditch effort"]},{"term":"Dog days of summer","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Những ngày nóng nực nhất của mùa hè.”. Cậu chọn cụm phù hợp nhé.","prompt":"The _____ make it hard to enjoy outdoor activities.","choices":["rest on one's laurels","Dog days of summer","ring a bell","right this way"]},{"term":"Dog-eat-dog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cạnh tranh khốc liệt, cá lớn nuốt cá bé.”. Cậu chọn cụm phù hợp nhé.","prompt":"The corporate world can often be a _____ environment.","choices":["Dog-eat-dog","Off the top of my head","Off the hook","Off the record"]},{"term":"Dollars to doughnuts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dám cá là, chắc chắn là.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, they'll be late again.","choices":["Be up to something","bear in mind","Dollars to doughnuts","Bear in mind/keep in mind"]},{"term":"Don't beat a dead horse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tốn công vô ích, nhai đi nhai lại một vấn đề đã ngã ngũ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pull up stakes","pull your weight","Don't beat a dead horse","Pull the wool over someone's eyes"]},{"term":"Don't count your chickens before they hatch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đếm cua trong lỗ, nói trước bước không qua.”. Cậu chọn cụm phù hợp nhé.","prompt":"You may get the promotion, but _____.","choices":["wicked","Who do you think you are?","Wild and woolly","Don't count your chickens before they hatch"]}]},{"id":"idioms-v1-lesson-022","title":"Bài 22","focus":"Thành ngữ từ “Don't cry over spilt milk” đến “down to the wire”.","questions":[{"term":"Don't cry over spilt milk","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng tiếc rẻ những gì đã mất.”. Cậu chọn cụm phù hợp nhé.","prompt":"You failed the test, but _____; focus on the next one.","choices":["Get down to business","get cold feet","Don't cry over spilt milk","Get down to brass tacks"]},{"term":"Don't do anything I wouldn't do","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng làm gì bậy bạ nhé (lời khuyên đùa cợt).”. Cậu chọn cụm phù hợp nhé.","prompt":"Have fun on your trip, and _____!","choices":["Go-to guy","Go without saying","Golden age","Don't do anything I wouldn't do"]},{"term":"Don't give up your day job","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng bỏ công việc chính (ý chê bai tài năng mới không đủ giỏi để kiếm sống).”. Cậu chọn cụm phù hợp nhé.","prompt":"His singing is bad, so _____.","choices":["Don't give up your day job","Hear something straight from the horse’s mouth","helicopter parent","Heebie-jeebies"]},{"term":"Don't hold your breath","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng hi vọng quá nhiều.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you're waiting for him to apologize, _____.","choices":["Don't hold your breath","get wind of","Get up on the wrong side of the bed","Get to the point"]},{"term":"Don't know him from Adam","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn toàn không biết người đó là ai.”. Cậu chọn cụm phù hợp nhé.","prompt":"I wouldn't trust him with my car; I _____.","choices":["Cream of the crop","Crank out","Crickets","Don't know him from Adam"]},{"term":"Don't know if I'm coming or going","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rối bời, không biết đường nào mà lần.”. Cậu chọn cụm phù hợp nhé.","prompt":"With all these deadlines, I _____.","choices":["beats me","Don't know if I'm coming or going","Bed of roses","Bed head"]},{"term":"Don't look a gift horse in the mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng săm soi món quà được tặng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Even if it's not exactly what you wanted, _____.","choices":["Don't look a gift horse in the mouth","Collect dust","Cold shoulder","Come a long way"]},{"term":"Don't put all your eggs in one basket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng bỏ tất cả trứng vào một giỏ (đừng mạo hiểm dồn hết mọi thứ vào một chỗ).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Come out smelling like a rose","Don't put all your eggs in one basket","Come out of one's shell","Come out flat-footed"]},{"term":"Don't quote me on that","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng trích lời tôi nhé (tôi không chắc chắn 100% đâu).”. Cậu chọn cụm phù hợp nhé.","prompt":"I think the meeting is at 3 PM, but _____.","choices":["Don't quote me on that","roll out the red carpet","rolling in it","Rome wasn't built in a day"]},{"term":"Don't sweat the small stuff","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng bận tâm những chuyện vặt vãnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"Life's too short to worry about every little mistake. _____.","choices":["Throw someone for a loop","Don't sweat the small stuff","Throw someone to the wolves","Throw caution to the wind"]},{"term":"Don't throw the baby out with the bath water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng vứt bỏ thứ quý giá cùng với những thứ vô ích.”. Cậu chọn cụm phù hợp nhé.","prompt":"While redesigning the website, _____; keep what works well.","choices":["a red-letter day","Don't throw the baby out with the bath water","A piece of cake","A ray of sunshine"]},{"term":"Don't want to hear that","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không muốn nghe, từ chối chấp nhận sự thật.”. Cậu chọn cụm phù hợp nhé.","prompt":"I _____ you're quitting the team.","choices":["Leave someone alone","Learn the ropes","Don't want to hear that","Leave no stone unturned"]},{"term":"Done to a turn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chín tới (thức ăn) hoặc làm hoàn hảo (công việc).”. Cậu chọn cụm phù hợp nhé.","prompt":"The steak was _____, juicy and flavorful.","choices":["Out of date","Out of left field","Done to a turn","Out of my hands"]},{"term":"Doom and gloom","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bi quan, u ám.”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite the _____ prediction, the company posted record profits.","choices":["On the cheap","On the blink","On the ball","Doom and gloom"]},{"term":"Double whammy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Họa vô đơn chí, tổn thất kép.”. Cậu chọn cụm phù hợp nhé.","prompt":"Losing his job and wrecking his car on the same day was a real _____ for John.","choices":["Double whammy","Cut and dried","Curiosity killed the cat","Curveball"]},{"term":"Down in the dumps","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Buồn bã, chán nản.”. Cậu chọn cụm phù hợp nhé.","prompt":"Jane's been _____ since she lost her job.","choices":["Poker face","Pony up","Play with fire","Down in the dumps"]},{"term":"Down in the mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trông ủ rũ, chán chường.”. Cậu chọn cụm phù hợp nhé.","prompt":"After hearing the bad news, she was really _____.","choices":["know someone inside out","Know one's onions","Down in the mouth","Know by sight"]},{"term":"Down the tube","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đổ sông đổ biển, thất bại hoàn toàn.”. Cậu chọn cụm phù hợp nhé.","prompt":"All the time and effort went _____ when the project was canceled.","choices":["Flavor of the month","Fixed in one's ways","Fix someone's wagon","Down the tube"]},{"term":"down to earth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thực tế, bình dị, gần gũi, không kiểu cách.”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite her massive international fame, she remains remarkably _____.","choices":["pull up stakes","Pull the wool over someone's eyes","down to earth","pull the rug out from under someone"]},{"term":"down to the wire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tới phút chót, đến phút cuối cùng mới ngã ngũ.”. Cậu chọn cụm phù hợp nhé.","prompt":"The election came _____ with results revealed just before midnight.","choices":["Sweat blood","Swallow your pride","down to the wire","Stuffed shirt"]}]},{"id":"idioms-v1-lesson-023","title":"Bài 23","focus":"Thành ngữ từ “down-to-earth” đến “eat crow”.","questions":[{"term":"down-to-earth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thực tế, giản dị, không viển vông.”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite his success, he remains _____ and humble.","choices":["down-to-earth","Get a handle on something","Get a second wind","Get a move on"]},{"term":"drag one's feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chần chừ, cố ý kéo dài thời gian (vì miễn cưỡng).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Man's best friend","Make waves","Make yourself at home","drag one's feet"]},{"term":"drastic times call for drastic measures","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình thế nguy cấp đòi hỏi những biện pháp quyết liệt (tùy cơ ứng biến).”. Cậu chọn cụm phù hợp nhé.","prompt":"During the economic crisis, the government decided that _____ and implemented severe budget cuts.","choices":["drastic times call for drastic measures","Find your feet","Filthy rich","Find fault with"]},{"term":"draw a blank","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trống rỗng, không nhớ ra được gì, không tìm thấy kết quả.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["drive someone crazy","drive someone nuts","drive someone up the wall","draw a blank"]},{"term":"drawing card","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Yếu tố thu hút, sức hút chính (đối với khán giả hoặc khách hàng).”. Cậu chọn cụm phù hợp nhé.","prompt":"The new roller coaster is the main _____ of the amusement park.","choices":["Mom-and-pop","money doesn't grow on trees","drawing card","Money burns a hole in someone's pocket"]},{"term":"dressed to kill","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn mặc lộng lẫy, diện đồ lồng lộn để gây ấn tượng mạnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"She arrived at the party _____, with a stunning red gown that caught everyone's eye.","choices":["Hot under the collar","dressed to kill","Horse of a different color","Horse around"]},{"term":"Drink like a fish","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Uống rượu như nước lã, nhậu nhẹt nát rượu.”. Cậu chọn cụm phù hợp nhé.","prompt":"After his breakup, he started to _____ every night.","choices":["Go off half-cocked","Go off the deep end","Go on a wild goose chase","Drink like a fish"]},{"term":"drive someone crazy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai phát điên, làm ai phát cáu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Blue law","drive someone crazy","Bolt from the blue","Boiling point"]},{"term":"drive someone nuts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó phát điên, chọc tức ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Beating a dead horse","Beat the bushes","beat the clock","drive someone nuts"]},{"term":"drive someone up the wall","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó bực tức, phát điên lên được.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Stuffed shirt","Swallow your pride","Sweat blood","drive someone up the wall"]},{"term":"drop by","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ghé ngang qua, tạt qua (thăm viếng ngắn).”. Cậu chọn cụm phù hợp nhé.","prompt":"Feel free to _____ my office if you have any questions.","choices":["drop by","talk turkey","talk to the hand","tall order"]},{"term":"drop out of school","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ học giữa chừng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["wear the pants","Weasel out of something","wear your heart on your sleeve","drop out of school"]},{"term":"drop someone a line","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Viết vài dòng, gửi một tin nhắn hoặc lá thư ngắn cho ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["drop someone a line","to make matters worse","time will tell","Time is money"]},{"term":"drop-dead gorgeous","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đẹp rạng ngời, đẹp nghiêng nước nghiêng thành.”. Cậu chọn cụm phù hợp nhé.","prompt":"She walked into the room, and everyone was stunned because she looked _____.","choices":["drop-dead gorgeous","talk to someone like a Dutch uncle","talk someone's ear off","talk through one's hat"]},{"term":"dry run","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Buổi diễn tập, buổi chạy thử.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's do a _____ of the presentation to make sure everything goes smoothly.","choices":["Like riding a bike","Like taking candy from a baby","dry run","Like there's no tomorrow"]},{"term":"dyed-in-the-wool","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cố hữu, thâm căn cố đế, không thể thay đổi.”. Cậu chọn cụm phù hợp nhé.","prompt":"He's a _____ conservative; no argument will change his mind.","choices":["Keep something under control","dyed-in-the-wool","Keep something under one's hat","Keep something at bay"]},{"term":"eager beaver","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người nhiệt tình, tham công tiếc việc, hăng hái quá mức.”. Cậu chọn cụm phù hợp nhé.","prompt":"John is such an _____; he volunteers for every project.","choices":["Get in someone’s hair","eager beaver","Get hold of someone","Get hold of something"]},{"term":"easy come, easy go","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Của thiên trả địa, dễ đến dễ đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"He spent his lottery winnings in a month — _____.","choices":["easy come, easy go","It is always darkest before the dawn","It takes one to know one","It is a poor workman who blames his tools"]},{"term":"easy does it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cẩn thận nào, từ từ thôi, nhẹ tay thôi.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ when you're carrying those dishes.","choices":["Dead from the neck up","Dead in the water","easy does it","Dead quiet"]},{"term":"eat crow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phải nhận sai, phải muối mặt thừa nhận mình đã lầm.”. Cậu chọn cụm phù hợp nhé.","prompt":"After insisting that he was right, John had to _____ when the true facts came out.","choices":["eat crow","If you can't stand the heat, get out of the kitchen","Ignorance is bliss","If you play your cards right"]}]},{"id":"idioms-v1-lesson-024","title":"Bài 24","focus":"Thành ngữ từ “eat like a bird” đến “fair-weather friend”.","questions":[{"term":"eat like a bird","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn nhỏ nhẻ, ăn ít như mèo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get to the point","eat like a bird","Get to the bottom of something","get to the bottom of"]},{"term":"eat like a horse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn thùng bất chiêng, ăn rất khỏe.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["eat like a horse","Like taking candy from a baby","Like there's no tomorrow","Like water off a duck's back"]},{"term":"eat one's hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chắc chắn không xảy ra (nếu xảy ra thì tôi đi đầu xuống đất).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["eat one's hat","Street-smart","Stop on a dime","Stretch the truth"]},{"term":"eat one's heart out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ghen tị đi nha, cứ thèm thuồng đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["eat one's heart out","Well begun is half done","Well-heeled","Weather the storm"]},{"term":"egg on one's face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bẽ mặt, xấu hổ vì bị quê / làm trò cười.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["egg on one's face","A perfect storm","A piece of cake","A picture is worth a thousand words"]},{"term":"elevator pitch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bài thuyết trình ngắn gọn (chỉ vài chục giây), lời tự giới thiệu súc tích.”. Cậu chọn cụm phù hợp nhé.","prompt":"In just two minutes, he delivered a convincing _____ to the investors.","choices":["the eleventh hour","the elephant in the room","elevator pitch","the early bird gets the worm"]},{"term":"eleventh hour","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phút chót, giờ thứ 11 (thời khắc cuối cùng trước khi quá muộn).”. Cậu chọn cụm phù hợp nhé.","prompt":"The labor union reached an agreement with management at the _____, avoiding a strike.","choices":["On thin ice","On the up and up","eleventh hour","On the warpath"]},{"term":"Elvis has left the building","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mọi chuyện đã kết thúc, vãn tuồng rồi.”. Cậu chọn cụm phù hợp nhé.","prompt":"The show is over. It's time to go home; _____.","choices":["Go haywire","Elvis has left the building","Go it alone","Go fry an egg"]},{"term":"empty nest syndrome","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hội chứng tổ trống (cảm giác cô đơn, trống trải của cha mẹ khi con cái trưởng thành dọn ra ở riêng).”. Cậu chọn cụm phù hợp nhé.","prompt":"After their youngest daughter went to college, they experienced _____.","choices":["Hand in glove","empty nest syndrome","Half-baked","Hammer out a deal"]},{"term":"every cloud has a silver lining","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong cái rủi có cái may, sau cơn mưa trời lại sáng.”. Cậu chọn cụm phù hợp nhé.","prompt":"After losing his job, he realized that _____ when he found a better position.","choices":["every cloud has a silver lining","the elephant in the room","the early bird gets the worm","the devil is in the details"]},{"term":"every dog has his day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ai rồi cũng có lúc vinh quang, sông có khúc người có lúc.”. Cậu chọn cụm phù hợp nhé.","prompt":"He finally got his breakthrough. I guess _____.","choices":["Get a handle on something","get a grip","every dog has his day","Get a move on"]},{"term":"every now and then","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thỉnh thoảng, đôi khi.”. Cậu chọn cụm phù hợp nhé.","prompt":"I like to take a walk _____ to clear my mind.","choices":["every now and then","Wave of the future","Watering hole","Water under the bridge"]},{"term":"everything but the kitchen sink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thượng vàng hạ cám, đem theo mọi thứ có thể (đồ lỉnh kỉnh).”. Cậu chọn cụm phù hợp nhé.","prompt":"They packed _____ for their camping trip.","choices":["Go down in flames","Go Dutch","Go down like a lead balloon","everything but the kitchen sink"]},{"term":"exact change","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiền lẻ trả vừa đủ (không cần thối lại).”. Cậu chọn cụm phù hợp nhé.","prompt":"Do you have _____ for the bus fare?","choices":["In full swing","exact change","in due course","In high gear"]},{"term":"excuse my French / pardon my French","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xin lỗi vì đã văng tục/nói bậy.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Like there's no tomorrow","Live and learn","excuse my French / pardon my French","Like water off a duck's back"]},{"term":"extended family","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đại gia đình (bao gồm ông bà, cô dì chú bác, anh em họ).”. Cậu chọn cụm phù hợp nhé.","prompt":"During the Lunar New Year, our whole _____ gathers for a festive reunion dinner.","choices":["extended family","A blessing in disguise","A bit/A little bit","A bone to pick"]},{"term":"face the music","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dám làm dám chịu, đối mặt với hậu quả.”. Cậu chọn cụm phù hợp nhé.","prompt":"After avoiding his responsibilities for months, John finally had to _____ and confess his mistakes.","choices":["face the music","Lock, stock, and barrel","live paycheck to paycheck","Living the dream"]},{"term":"fair and square","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Công bằng, đường đường chính chính.”. Cậu chọn cụm phù hợp nhé.","prompt":"He won the competition _____.","choices":["You can lead a horse to water, but you can't make him drink","You can bet your boots","fair and square","You can bet your bottom dollar"]},{"term":"fair to middling","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thường thường bậc trung, tàm tạm.”. Cậu chọn cụm phù hợp nhé.","prompt":"My health is _____ at the moment.","choices":["In a jam","In a nutshell","fair to middling","In a bind"]},{"term":"fair-weather friend","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bạn bè khi vui thì vỗ tay vào (lúc hoạn nạn thì bỏ đi), bạn đểu.”. Cậu chọn cụm phù hợp nhé.","prompt":"I realized he was just a _____ when he wasn't there for me during hard times.","choices":["feel like a million dollars","feel blue","feeding frenzy","fair-weather friend"]}]},{"id":"idioms-v1-lesson-025","title":"Bài 25","focus":"Thành ngữ từ “fall by the wayside” đến “Fight an uphill battle”.","questions":[{"term":"fall by the wayside","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ cuộc giữa chừng, thất bại, rơi rụng dần.”. Cậu chọn cụm phù hợp nhé.","prompt":"Many good ideas _____ due to lack of funding.","choices":["Cant judge a book by its cover","fall by the wayside","Cant put a face to the name","Cant keep up"]},{"term":"fall into place","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vào guồng, đâu vào đấy một cách trôi chảy và thuận lợi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Be close-fisted","Be beside oneself","Be loaded","fall into place"]},{"term":"fall off the wagon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngựa quen đường cũ, tái nghiện (đặc biệt là rượu).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get a move on","fall off the wagon","Get a taste of one's own medicine","Get a second wind"]},{"term":"fall on deaf ears","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ ngoài tai, đàn gảy tai trâu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Band-Aid on a bullet wound","fall on deaf ears","Bad hair day","Bad blood"]},{"term":"familiarity breeds contempt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quá gần gũi đâm ra khinh nhờn, thân quá hóa nhờn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After working with him for years, she realized that _____ and they no longer got along.","choices":["Walk on air","familiarity breeds contempt","Walk in someone's shoes","Wallflower"]},{"term":"fancy pants","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ chải chuốt, người thích ăn diện lòe loẹt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Look at Mr. _____ over there with his shiny new car.","choices":["At the bottom of the totem pole","At my wits’ end","At loggerheads","fancy pants"]},{"term":"far and wide","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khắp nơi, rộng khắp, xa gần.”. Cậu chọn cụm phù hợp nhé.","prompt":"People came from _____ to attend the annual cultural festival.","choices":["Bring up","bringing up a family","far and wide","Brownie points"]},{"term":"fashion victim","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nạn nhân của thời trang (chạy theo mốt một cách mù quáng).”. Cậu chọn cụm phù hợp nhé.","prompt":"She buys every new design but ends up looking like a _____.","choices":["Bent out of shape","Bend over backward","fashion victim","Bend someone's ear"]},{"term":"fat cat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ trọc phú, tư bản gộc (quyền thế và giàu có).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["feeding frenzy","feel like a million dollars","feel blue","fat cat"]},{"term":"feather one's nest","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thu vén cá nhân, vơ vét của công làm của riêng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["feather one's nest","the Big Easy","the Big Apple","the bottom line"]},{"term":"feeding frenzy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự tranh giành điên cuồng, cơn sốt xâu xé.”. Cậu chọn cụm phù hợp nhé.","prompt":"Investors went into a _____ when the company's stock price started rising rapidly.","choices":["behind the times","Belt and suspenders","Behind the eight ball","feeding frenzy"]},{"term":"feel blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm thấy buồn bã, ủ rũ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Whenever I _____, going for a brisk walk outdoors helps lift my spirits.","choices":["feel blue","bringing up a family","Bring up","Brownie points"]},{"term":"feel like a million dollars","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm thấy khỏe khoắn tuyệt vời, sung sức ngập tràn.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a good night's sleep, you'll _____.","choices":["a heart of gold","A kickback","A hot potato","feel like a million dollars"]},{"term":"feel the pinch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt đầu thiếu hụt tiền bạc, cảm thấy gánh nặng tài chính.”. Cậu chọn cụm phù hợp nhé.","prompt":"With the rising cost of living, many families are beginning to _____.","choices":["feeling under the weather","Fender bender","Feeling blue","feel the pinch"]},{"term":"Feeling blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm thấy buồn bã, chán nản.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's been _____ ever since her pet dog passed away.","choices":["put on one's thinking cap","push one's luck","Feeling blue","put a sock in it"]},{"term":"feeling under the weather","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm thấy hơi mệt, khó ở trong người.”. Cậu chọn cụm phù hợp nhé.","prompt":"She left the office early because she was _____.","choices":["feeling under the weather","Call a spade a spade","Call it a day","By word of mouth"]},{"term":"Fender bender","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vụ va chạm xe nhẹ, không nghiêm trọng.”. Cậu chọn cụm phù hợp nhé.","prompt":"I got into a _____ on my way to work.","choices":["Fender bender","A fork in the road","A fool and his money are easily parted","A for effort"]},{"term":"Field day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dịp vui vẻ, ngày hội (hoặc cơ hội lợi dụng tình hình để làm điều mình thích).”. Cậu chọn cụm phù hợp nhé.","prompt":"The media had a _____ with the politician's scandal.","choices":["Dig in your heels","Diamond in the rough","Field day","Different strokes for different folks"]},{"term":"Fifteen minutes of fame","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự nổi tiếng ngắn ngủi, chớp nhoáng.”. Cậu chọn cụm phù hợp nhé.","prompt":"His viral video brought him _____, but now he's back to his normal life.","choices":["On a shoestring","Fifteen minutes of fame","On a tear","On a treadmill"]},{"term":"Fight an uphill battle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đấu tranh trong hoàn cảnh khó khăn, gian nan.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["far and wide","fashion victim","fat cat","Fight an uphill battle"]}]},{"id":"idioms-v1-lesson-026","title":"Bài 26","focus":"Thành ngữ từ “Fight tooth and nail” đến “Fly off the handle”.","questions":[{"term":"Fight tooth and nail","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đấu tranh quyết liệt, chiến đấu đến cùng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Give someone the heads-up","Give someone the thumbs-up","Give someone the slip","Fight tooth and nail"]},{"term":"Fill in the blanks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điền vào chỗ trống, bổ sung thông tin còn thiếu.”. Cậu chọn cụm phù hợp nhé.","prompt":"I didn't understand the whole plan, but my manager will _____ for me.","choices":["Different strokes for different folks","Dig in your heels","Dirt cheap","Fill in the blanks"]},{"term":"Filthy rich","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng giàu có, giàu nứt đố đổ vách.”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite his humble beginnings, he became _____ through hard work and innovation.","choices":["Butt in","Busy bee","Bury the hatchet","Filthy rich"]},{"term":"Find fault with","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt bẻ, bới lông tìm vết, chê bai.”. Cậu chọn cụm phù hợp nhé.","prompt":"Instead of being helpful, she just likes to _____ others.","choices":["Find fault with","make heads or tails of","Make eyes at someone","Make hay while the sun shines"]},{"term":"Find your feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trở nên tự tin, quen thuộc với môi trường mới.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["You can bet your bottom dollar","You can bet your boots","Find your feet","You can lead a horse to water, but you can't make him drink"]},{"term":"Finger-lickin' good","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngon tuyệt cú mèo, ngon khó cưỡng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The barbecue at that new place is _____! It's worth every penny.","choices":["All in the same boat","All kidding aside","all in all","Finger-lickin' good"]},{"term":"Fish out of water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người lạc lõng, cảm thấy không thoải mái trong môi trường lạ.”. Cậu chọn cụm phù hợp nhé.","prompt":"At her new job, she felt like a _____, not knowing anyone or how things worked.","choices":["Greased lightning","Fish out of water","Gray area","Grease monkey"]},{"term":"Fishy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đáng ngờ, ám muội.”. Cậu chọn cụm phù hợp nhé.","prompt":"The deal sounds _____ to me; I think we should investigate further.","choices":["An open book","an old wives' tale","An old soul","Fishy"]},{"term":"Fit as a fiddle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ khỏe mạnh, sung sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"After his recovery from the flu, he is now _____.","choices":["A storm is brewing","A surefire way","A sweet tooth","Fit as a fiddle"]},{"term":"Fit to be tied","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ tức giận, nổi trận lôi đình.”. Cậu chọn cụm phù hợp nhé.","prompt":"When she found out her flight was canceled, she was _____.","choices":["When pigs fly","Fit to be tied","When it rains, it pours","When push comes to shove"]},{"term":"Fits and starts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thất thường, không đều đặn (làm việc chập chờn).”. Cậu chọn cụm phù hợp nhé.","prompt":"Their progress on the project was made in _____.","choices":["butterflies in one's stomach","Button one's lip","Fits and starts","Buy a lemon"]},{"term":"Five o'clock shadow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Râu mọc lún phún (sau một ngày dài không cạo râu).”. Cậu chọn cụm phù hợp nhé.","prompt":"He had a _____ by the time the meeting ended.","choices":["Let the dust settle","Letter-perfect","Five o'clock shadow","Let your hair down"]},{"term":"Fix someone's wagon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dạy cho ai đó một bài học, phá đám ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["In a rut","Fix someone's wagon","In a nutshell","In a pinch"]},{"term":"Fixed in one's ways","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bảo thủ, không chịu thay đổi thói quen.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Have bigger fish to fry","have egg on one's face","Fixed in one's ways","Have hell to pay"]},{"term":"Flavor of the month","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trào lưu nhất thời, người/vật nổi lên chốc lát.”. Cậu chọn cụm phù hợp nhé.","prompt":"That singer might be the _____, but will people remember his songs next year?","choices":["Give props to","give someone a hand","Flavor of the month","give it a shot"]},{"term":"Flea market","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chợ đồ cũ, chợ trời.”. Cậu chọn cụm phù hợp nhé.","prompt":"We found some amazing vintage items at the _____ last weekend.","choices":["Stand one's ground","Stab someone in the back","Squeaky clean","Flea market"]},{"term":"Flesh and blood","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Máu mủ ruột thịt, người nhà.”. Cậu chọn cụm phù hợp nhé.","prompt":"He is my _____; I will always support him.","choices":["learn by heart","Flesh and blood","Lead someone around by the nose","Lay someone off"]},{"term":"Fly in the face of something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi ngược lại, chống đối hoàn toàn (quan điểm, quy tắc).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fly in the face of something","Odd man out","off color","Number cruncher"]},{"term":"Fly in the ointment","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Con sâu làm rầu nồi canh, điều gây mất vui.”. Cậu chọn cụm phù hợp nhé.","prompt":"Everything was perfect for the trip, but the flight delay was a real _____.","choices":["Fly in the ointment","Head honcho","He who laughs last laughs loudest","Head and shoulders above"]},{"term":"Fly off the handle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đột nhiên nổi cáu, mất bình tĩnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fly off the handle","the pits","the patience of Job","the pot calling the kettle black"]}]},{"id":"idioms-v1-lesson-027","title":"Bài 27","focus":"Thành ngữ từ “Fly the coop” đến “Forty winks”.","questions":[{"term":"Fly the coop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tẩu thoát, chuồn êm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Half a mind to do something","Hair’s breadth","Half the battle","Fly the coop"]},{"term":"fly through","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm/vượt qua cái gì một cách vèo vèo, siêu nhanh và dễ dàng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["cup of tea","Cup of joe","fly through","Cry wolf"]},{"term":"Fly-by-night","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ăn chớp nhoáng, không đáng tin cậy.”. Cậu chọn cụm phù hợp nhé.","prompt":"The investment looked promising, but it turned out to be a _____ scam.","choices":["Smell a rat","Smoke and mirrors","Fly-by-night","Smoke like a chimney"]},{"term":"Foam at the mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tức sùi bọt mép, giận điên người.”. Cậu chọn cụm phù hợp nhé.","prompt":"He started to _____ when he heard about the unfair decision.","choices":["He who laughs last laughs loudest","Head and shoulders above","Head honcho","Foam at the mouth"]},{"term":"Follow in someone's footsteps","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nối nghiệp, theo bước chân ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Call it a day","Follow in someone's footsteps","call it quits","Call a spade a spade"]},{"term":"Follow the money","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lần theo dấu vết tiền bạc (để tìm ra sự thật).”. Cậu chọn cụm phù hợp nhé.","prompt":"In many corruption cases, investigators usually _____ to find evidence.","choices":["Calm someone down","Follow the money","Call the shots","Calm before the storm"]},{"term":"Follow up on something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Theo dõi, tiếp tục xử lý, bám sát (một vấn đề/công việc).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep someone posted","Keep someone in the dark","Follow up on something","Keep someone at arm's length"]},{"term":"Food for thought","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điều đáng suy ngẫm, gợi suy nghĩ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her lecture provided a lot of _____ about the future of technology.","choices":["Off one's rocker","Off on the wrong foot","off color","Food for thought"]},{"term":"Fool around","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chơi đùa nhảm nhí, làm chuyện vớ vẩn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sell someone out","Fool around","Sell like hotcakes","Sell someone short"]},{"term":"Fool's gold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vàng thau lẫn lộn, vật lấp lánh nhưng vô giá trị.”. Cậu chọn cụm phù hợp nhé.","prompt":"The investment seemed promising, but it turned out to be _____.","choices":["Carry a torch for someone","cash cow","Carry the ball","Fool's gold"]},{"term":"Foot in the door","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bước chân vào nghề, cơ hội ban đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Getting an internship is a good way to get your _____ of the industry.","choices":["Knock someone's socks off","Knock something into a cocked hat","Know by sight","Foot in the door"]},{"term":"foot the bill","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đứng ra thanh toán toàn bộ chi phí/hóa đơn.”. Cậu chọn cụm phù hợp nhé.","prompt":"The company agreed to _____ for all our travel and hotel expenses.","choices":["Man's best friend","Make yourself at home","foot the bill","Mark time"]},{"term":"Footloose and fancy-free","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tự do tự tại, không bị ràng buộc.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's been traveling the world, _____, ever since she quit her job.","choices":["Here and there","Footloose and fancy-free","helicopter parent","Heebie-jeebies"]},{"term":"For crying out loud","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bực mình quá đi mất, thật là bực bội!”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, can you please turn down the music?","choices":["At-large","back on one's feet","For crying out loud","Baby boomer"]},{"term":"For goodness' sake","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trời đất ơi, lạy Chúa tôi (thể hiện sự mất kiên nhẫn).”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, turn the music down!","choices":["If I had a nickel for every time something happened","For goodness' sake","If you can't stand the heat, get out of the kitchen","If worst comes to worst"]},{"term":"For heaven's sake","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vì Chúa, ơn trời (biểu lộ sự kinh ngạc hoặc bực dọc).”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, clean up your room!","choices":["wear your heart on your sleeve","wear the pants","For heaven's sake","Wear one's heart on one's sleeve"]},{"term":"For the birds","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô nghĩa, vớ vẩn, nhảm nhí.”. Cậu chọn cụm phù hợp nhé.","prompt":"All this paperwork is _____. I prefer real, hands-on work.","choices":["No big deal","No pain, no gain","No dice","For the birds"]},{"term":"Fork over / Shell out money","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bấm bụng chi tiền, nôn tiền ra.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["to make matters worse","Fork over / Shell out money","Time is money","time will tell"]},{"term":"Fortune favors the bold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liều ăn nhiều, dũng cảm sẽ gặp may mắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"He took a risk by starting his own business, but _____.","choices":["Fortune favors the bold","Gut feeling","Gung ho","Hair of the dog"]},{"term":"Forty winks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giấc ngủ ngắn, chợp mắt.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a busy morning, I need _____ to recharge.","choices":["Off the wall","Forty winks","Off the top of my head","Off-color"]}]},{"id":"idioms-v1-lesson-028","title":"Bài 28","focus":"Thành ngữ từ “Freak out” đến “Get ahold of yourself”.","questions":[{"term":"Freak out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoảng sợ tột độ, mất bình tĩnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"She started to _____ when she realized she had lost her wallet.","choices":["Freak out","the best thing since sliced bread","the Big Apple","the best of both worlds"]},{"term":"fresh as a daisy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tươi như hoa, tràn đầy năng lượng sau giấc ngủ ngon.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a good eight hours of sound sleep, she woke up _____.","choices":["Keep something under wraps","fresh as a daisy","keep tabs on","Keep something under one's hat"]},{"term":"From day one","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngay từ ngày đầu tiên, từ thuở ban đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"He has been dedicated to the project _____.","choices":["Clear the air","climb the corporate ladder","From day one","Clear as mud"]},{"term":"From rags to riches","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Từ tay trắng làm nên sự nghiệp, từ nghèo khó trở nên giàu sang.”. Cậu chọn cụm phù hợp nhé.","prompt":"He went _____ in just a few years thanks to his brilliant startup.","choices":["From rags to riches","talk a blue streak","take your time","talk shop"]},{"term":"From the get-go","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngay từ đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"I've known she was the right person for the job _____.","choices":["Chicken out","From the get-go","Chow down","Chuffed to bits"]},{"term":"From the word go","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngay từ lúc bắt đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, he was determined to win.","choices":["Between the devil and the deep blue sea","From the word go","Between a rock and a hard place","Beyond the pale"]},{"term":"From time to time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thỉnh thoảng, đôi khi.”. Cậu chọn cụm phù hợp nhé.","prompt":"We like to go hiking _____.","choices":["Cut someone some slack","Cut to the chase","Cut the mustard","From time to time"]},{"term":"Fuddy-duddy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người cổ hủ, lạc hậu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Stop being such a _____. Try something new for once!","choices":["Fuddy-duddy","Do someone a good turn","Do a number on something","Do or die"]},{"term":"full of beans","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tràn đầy năng lượng, dồi dào sức sống và hăng hái.”. Cậu chọn cụm phù hợp nhé.","prompt":"The kids were _____ this morning and played outdoors for hours.","choices":["Curveball","cut corners","Cut and dried","full of beans"]},{"term":"Full of crap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói xạo, bốc phét, nói nhảm.”. Cậu chọn cụm phù hợp nhé.","prompt":"I can't believe anything she says; she's always _____.","choices":["Bent out of shape","Bend someone's ear","Full of crap","Bend over backward"]},{"term":"Full of hot air","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói khoác, thùng rỗng kêu to.”. Cậu chọn cụm phù hợp nhé.","prompt":"He said he could solve all our problems, but I think he's just _____.","choices":["Full of hot air","Hear it on the grapevine","Heads-up","Head over heels"]},{"term":"Full steam ahead","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiến lên hết tốc lực; dốc toàn lực”. Cậu chọn cụm phù hợp nhé.","prompt":"After the funding came through, they went _____ with their plans.","choices":["Full steam ahead","Across the board","action speaks louder than words","Acid test"]},{"term":"Gain ground","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đạt được tiến bộ; giành được lợi thế; trở nên phổ biến”. Cậu chọn cụm phù hợp nhé.","prompt":"The company’s new product is starting to _____ in the market.","choices":["pass with flying colors","Pay a pretty penny","Pay an arm and a leg","Gain ground"]},{"term":"get a grip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình tĩnh lại, kiểm soát lại cảm xúc của bản thân.”. Cậu chọn cụm phù hợp nhé.","prompt":"Take a deep breath and _____ on yourself before making an emotional decision.","choices":["In the least","In the loop","In the long run","get a grip"]},{"term":"Get a handle on something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm bắt được; kiểm soát được tình hình”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Let the dust settle","Get a handle on something","Let someone off the hook","Let the cat out of the bag"]},{"term":"Get a move on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhanh lên; khẩn trương lên”. Cậu chọn cụm phù hợp nhé.","prompt":"If we want to catch the train, we need to _____.","choices":["your guess is as good as mine","zip it","Get a move on","zero tolerance"]},{"term":"Get a second wind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lấy lại sức lực; phục hồi phong độ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Too big for one's boots","Tongue-in-cheek","to make matters worse","Get a second wind"]},{"term":"Get a taste of one's own medicine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gậy ông đập lưng ông; nếm mùi đau khổ do chính mình gây ra”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Walk in someone's shoes","Walk on air","Get a taste of one's own medicine","Veg out"]},{"term":"Get a word in edgewise","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chen ngang vào câu chuyện; có cơ hội lên tiếng”. Cậu chọn cụm phù hợp nhé.","prompt":"He talks so much that it’s hard to _____.","choices":["Pull one's weight","pull a rabbit out of one's hat","Pull it off","Get a word in edgewise"]},{"term":"Get ahold of yourself","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình tĩnh lại; kiềm chế cảm xúc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lose touch","Get ahold of yourself","Low-hanging fruit","Lost at sea"]}]},{"id":"idioms-v1-lesson-029","title":"Bài 29","focus":"Thành ngữ từ “Get along with someone” đến “Get on one's nerves”.","questions":[{"term":"Get along with someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hòa thuận; ăn ý với ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go off the deep end","Go it alone","Go off half-cocked","Get along with someone"]},{"term":"Get back to someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phản hồi lại; liên lạc lại sau”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A breath of fresh air","A bone to pick","Get back to someone","A bunch of"]},{"term":"Get bent out of shape","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi giận đùng đùng, bực tức (thường vì chuyện nhỏ).”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't _____ over a little misunderstanding; let's talk it through.","choices":["Know one's onions","Know by sight","Get bent out of shape","Knock something into a cocked hat"]},{"term":"Get by","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xoay xở đủ sống; sống qua ngày”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Not what it's cracked up to be","Not worth a red cent","Not rocket science","Get by"]},{"term":"get cold feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chùn bước, mất hết can đảm vào phút chót.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["In hot water","In my book","In high gear","get cold feet"]},{"term":"Get down to brass tacks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi vào vấn đề chính; bàn vào những chi tiết thực tế”. Cậu chọn cụm phù hợp nhé.","prompt":"We don’t have much time, so let’s _____ immediately.","choices":["extended family","Get down to brass tacks","exact change","excuse my French / pardon my French"]},{"term":"Get down to business","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt tay vào việc; nghiêm túc làm việc”. Cậu chọn cụm phù hợp nhé.","prompt":"After a quick introduction, the team decided to _____ and discuss the project details.","choices":["take the cake","Get down to business","Take something with a grain of salt","take something in stride"]},{"term":"Get down to the nuts and bolts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi vào chi tiết cốt lõi; tìm hiểu ngọn ngành”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ of the project before we can proceed.","choices":["rolling in it","rub elbows with someone","Get down to the nuts and bolts","Rome wasn't built in a day"]},{"term":"Get from A to B","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi từ nơi này đến nơi khác”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get from A to B","You can bet your boots","You bet","You can bet your bottom dollar"]},{"term":"Get hold of someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liên lạc được với ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["a heart of gold","A hot potato","Get hold of someone","A hard nut to crack"]},{"term":"Get hold of something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm giữ; đoạt được; hiểu được”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Don't quote me on that","Don't look a gift horse in the mouth","Get hold of something","Don't put all your eggs in one basket"]},{"term":"Get in someone’s hair","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quấy rầy; làm phiền ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Jump the gun","jump for joy","Get in someone’s hair","Jump on the bandwagon"]},{"term":"Get in touch with","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liên lạc với, bắt liên lạc.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you have any questions, please _____ our support team.","choices":["Get in touch with","Shot in the arm","Shoot the breeze","shop till you drop"]},{"term":"Get into deep water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rơi vào tình thế khó khăn; rước họa vào thân”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go fly a kite","Go down like a lead balloon","Go Dutch","Get into deep water"]},{"term":"Get off on the wrong foot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khởi đầu không suôn sẻ; mất lòng từ đầu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["home sweet home","Hold your tongue","Holding the bag","Get off on the wrong foot"]},{"term":"Get off one's high horse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bớt kiêu ngạo lại; khiêm tốn chút đi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sell someone short","Sell someone out","Get off one's high horse","Serve one right"]},{"term":"Get off scot-free","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình yên vô sự, thoát tội mà không bị trừng phạt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get off scot-free","Gung ho","Grin and bear it","Guinea pig"]},{"term":"get on like a house on fire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hợp nhau như cá gặp nước, nhanh chóng trở nên thân thiết.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["You can bet your bottom dollar","You can bet your boots","get on like a house on fire","You can lead a horse to water, but you can't make him drink"]},{"term":"Get on one's last nerve","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó hết sức chịu đựng; chọc tức tận cùng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Beating a dead horse","Beating around the bush","beat the clock","Get on one's last nerve"]},{"term":"Get on one's nerves","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chọc tức; làm phiền ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get on one's nerves","Fifteen minutes of fame","Fight an uphill battle","Fight tooth and nail"]}]},{"id":"idioms-v1-lesson-030","title":"Bài 30","focus":"Thành ngữ từ “get on someone's nerves” đến “Get the message”.","questions":[{"term":"get on someone's nerves","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm phiền, làm ai bực mình hoặc phát cáu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Just a moment","Just around the corner","get on someone's nerves","Just now"]},{"term":"Get one's act together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chỉnh đốn lại bản thân; xốc lại tinh thần”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["On the ball","On the cheap","On the blink","Get one's act together"]},{"term":"Get one's dander up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi cáu; tức giận”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get one's dander up","Dirt cheap","Dish the dirt","Divide the spoils"]},{"term":"Get one's feet wet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bước đầu làm quen; thử nghiệm”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Dead from the neck up","Dawned on me","day in day out","Get one's feet wet"]},{"term":"Get one's goat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó phát cáu; chọc tức”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get one's goat","Have bats in one’s belfry","Have another thing coming","Have an axe to grind"]},{"term":"Get one's hackles up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tức điên lên, xù lông nhím (phòng thủ, tức giận)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get one's hackles up","Weather the storm","wear your heart on your sleeve","Weasel out of something"]},{"term":"Get one's head around something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu thấu được; tiếp thu được”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bet the ranch","Better late than never","Bestie","Get one's head around something"]},{"term":"Get out of hand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt tầm kiểm soát; mất kiểm soát”. Cậu chọn cụm phù hợp nhé.","prompt":"The party started to _____ when too many people showed up.","choices":["Lay an egg","Lay down the law","Get out of hand","Laugh all the way to the bank"]},{"term":"Get over it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt qua; quên đi để bước tiếp”. Cậu chọn cụm phù hợp nhé.","prompt":"I know you’re upset about the breakup, but you need to _____.","choices":["Get over it","Dirt cheap","Divide the spoils","Dish the dirt"]},{"term":"Get rid of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Loại bỏ, vứt bỏ, tống khứ.”. Cậu chọn cụm phù hợp nhé.","prompt":"They decided to _____ the company's outdated policies.","choices":["Cat nap","Get rid of","catch red-handed","catch one's death of cold"]},{"term":"Get something for peanuts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mua được với giá bèo; mua rẻ như cho”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["action speaks louder than words","Acid test","Get something for peanuts","Across the board"]},{"term":"Get something off one's chest","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói ra cho nhẹ lòng; trút bầu tâm sự”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["that ship has sailed","test the waters","Get something off one's chest","that is to say"]},{"term":"Get something out of one's system","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thỏa mãn mong muốn; xả hết bực tức/cảm xúc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get something out of one's system","keep in mind","keep at bay","Keep body and soul together"]},{"term":"Get something through one's head","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu ra vấn đề; nhét vào đầu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Good riddance","Good to know","Get something through one's head","Good things come to those who wait"]},{"term":"get the ball rolling","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt đầu hành động, khởi động dự án/tiến trình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let us introduce ourselves first to _____ in this meeting.","choices":["Country mile","get the ball rolling","Cover a lot of ground","Crack a book"]},{"term":"Get the go-ahead","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Được bật đèn xanh; được phép tiến hành”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Checkered past","Chasing rainbows","Cheer up","Get the go-ahead"]},{"term":"Get the green light","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Được bật đèn xanh; được phê duyệt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Take it easy","take it with a grain of salt","take for granted","Get the green light"]},{"term":"get the hang of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm bắt được cách làm, quen tay với việc gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"Once you _____ skiing, it becomes remarkably fun and easy.","choices":["get the hang of","Get one's dander up","Get one's feet wet","Get one's goat"]},{"term":"Get the hang of it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm được cách làm; quen tay”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fortune favors the bold","Forty winks","Fork over / Shell out money","Get the hang of it"]},{"term":"Get the message","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu ý; nắm bắt được ẩn ý”. Cậu chọn cụm phù hợp nhé.","prompt":"If he’s not replying to your texts, maybe it’s time to _____.","choices":["Get the message","Go the whole hog","Go through something with a fine-tooth comb","Go the extra mile"]}]},{"id":"idioms-v1-lesson-031","title":"Bài 31","focus":"Thành ngữ từ “Get the sack” đến “Give someone a run for their money”.","questions":[{"term":"Get the sack","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị sa thải; bị đuổi việc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pull someone's chain","Get the sack","Pull rank","Pull out all the stops"]},{"term":"Get the third degree","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị tra khảo gắt gao, hỏi cung”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get the third degree","your guess is as good as mine","You've sold me","zero tolerance"]},{"term":"Get this show on the road","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt đầu thôi; tiến hành ngay thôi”. Cậu chọn cụm phù hợp nhé.","prompt":"We have everything set up; let’s _____.","choices":["Hit pay dirt","Get this show on the road","Hit me up","Hit it on the nose"]},{"term":"get to the bottom of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tìm ra chân tướng, tìm hiểu ngọn ngành gốc rễ sự việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"The detectives worked tirelessly to _____ the mystery.","choices":["At loggerheads","get to the bottom of","At best","At least"]},{"term":"Get to the bottom of something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tìm ra chân tướng; điều tra ngọn ngành”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["With bells on","With bated breath","Get to the bottom of something","Wing it"]},{"term":"Get to the point","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi thẳng vào vấn đề”. Cậu chọn cụm phù hợp nhé.","prompt":"Please _____; we don’t have much time.","choices":["rack one's brain","Get to the point","put your thinking cap on","quality time"]},{"term":"Get up on the wrong side of the bed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tỉnh dậy với tâm trạng tồi tệ; cáu kỉnh vô cớ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Break a leg","Get up on the wrong side of the bed","Brainstorm","Bread and butter"]},{"term":"get wind of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe phong thanh, đánh hơi thấy tin tức bí mật.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep body and soul together","Keep one's chin up","keep in mind","get wind of"]},{"term":"Get wind of something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe phong phanh; biết được bí mật”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cheer up","cherry-pick","Get wind of something","Checkered past"]},{"term":"Get with it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cập nhật đi; thức thời đi”. Cậu chọn cụm phù hợp nhé.","prompt":"You need to _____ if you want to succeed in this industry.","choices":["Turn the tables","Turn the other cheek","Turn up the heat","Get with it"]},{"term":"Get your walking papers","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị sa thải, bị đuổi việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fool around","Food for thought","Follow up on something","Get your walking papers"]},{"term":"Get-up-and-go","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự hăng hái; nghị lực; động lực”. Cậu chọn cụm phù hợp nhé.","prompt":"Her _____ makes her a great leader at work.","choices":["No skin off one's nose","No-brainer","Get-up-and-go","No rhyme or reason"]},{"term":"give a hand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giúp một tay, hỗ trợ ai làm việc gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Black tie event","black sheep of the family","Black-and-white","give a hand"]},{"term":"Give in","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhượng bộ, bỏ cuộc, chịu thua.”. Cậu chọn cụm phù hợp nhé.","prompt":"She didn't want to _____ to their demands, but she had no choice.","choices":["A fifth wheel","a feather in one's cap","Give in","A far cry from (something)"]},{"term":"give it a shot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thử làm một phen, mạo hiểm thử sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"Even if coding seems hard at first, you should _____.","choices":["give it a shot","put something on the back burner","put the screws on someone","put something on ice"]},{"term":"Give props to","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khen ngợi; công nhận thành quả của ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"We should all _____ Jane for her hard work on this project.","choices":["Give props to","The whole nine yards","The whole ball of wax","There are plenty of other fish in the sea"]},{"term":"give someone a hand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giúp đỡ ai một tay.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["give someone a hand","Give in","give a hand","give it a shot"]},{"term":"Give someone a hard time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm khó dễ; bắt bẻ ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Off the top of my head","Give someone a hard time","Off the record","Off the wall"]},{"term":"Give someone a piece of one's mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mắng nhiếc, xỉ vả ai đó; nói thẳng cho ai đó biết sự bất bình của mình”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wet blanket","Wet one's whistle","What are you up to?","Give someone a piece of one's mind"]},{"term":"Give someone a run for their money","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ tám lạng người nửa cân; tạo ra sự cạnh tranh khốc liệt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cant hold a candle to","Give someone a run for their money","Calm someone down","Cant judge a book by its cover"]}]},{"id":"idioms-v1-lesson-032","title":"Bài 32","focus":"Thành ngữ từ “Give someone a song and dance” đến “Go fry an egg”.","questions":[{"term":"Give someone a song and dance","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bịa chuyện, viện cớ vòng vo để thoái thác hoặc lấp liếm”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Make the grade","Make tracks","Give someone a song and dance","Make out what someone says"]},{"term":"Give someone the benefit of the doubt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tin tưởng ai đó (khi chưa có bằng chứng kết tội); tạm thời tin ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wear one's heart on one's sleeve","wear the pants","Give someone the benefit of the doubt","Wear many hats"]},{"term":"give someone the brush-off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ngó lơ, phớt lờ ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["An old soul","give someone the brush-off","An old head on young shoulders","an old wives' tale"]},{"term":"Give someone the cold shoulder","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tỏ thái độ lạnh nhạt, hờ hững hoặc phớt lờ ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Half a mind to do something","Give someone the cold shoulder","Half the battle","Half-baked"]},{"term":"Give someone the heads-up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Báo trước, cảnh báo trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["talk a blue streak","take with a grain of salt","Give someone the heads-up","take your time"]},{"term":"Give someone the slip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trốn thoát, cắt đuôi ai đó đang bám theo mình”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Turn the other cheek","Turn over a new leaf","Give someone the slip","Turn the tables"]},{"term":"Give someone the thumbs-up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bật đèn xanh; tán thành; ủng hộ ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Give someone the thumbs-up","Bright and early","Breeze through","Bring down the house"]},{"term":"Give someone/something short shrift","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ qua, phớt lờ, hoặc dành rất ít sự chú ý cho ai/cái gì”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Give someone/something short shrift","Off the wall","Off-color","Off the top of my head"]},{"term":"Go against the grain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm trái với lẽ thường, đi ngược lại đám đông”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go against the grain","have one's ducks in a row","Have one's back to the wall","Have one's head in the clouds"]},{"term":"Go around in circles","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Luẩn quẩn, không có tiến triển”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go around in circles","Keyed up","Kick up one's heels","Kill the mood"]},{"term":"Go back to the drawing board","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm lại từ đầu, vạch lại kế hoạch mới vì kế hoạch cũ thất bại”. Cậu chọn cụm phù hợp nhé.","prompt":"The project didn’t work out as expected, so we have to _____.","choices":["Clear as mud","Clean someone out","Go back to the drawing board","Clear the air"]},{"term":"Go bananas","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phát điên lên (vì tức giận hoặc phấn khích)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go bananas","Fish out of water","Fishy","Fit as a fiddle"]},{"term":"Go belly up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phá sản, thất bại hoàn toàn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go belly up","Play with fire","Play it by ear","Play second fiddle"]},{"term":"Go bonkers","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phát rồ, phát cuồng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the boys in blue","the burning question","Go bonkers","the bottom line"]},{"term":"Go cold turkey","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Từ bỏ một thói quen (hoặc cơn nghiện) một cách đột ngột và hoàn toàn”. Cậu chọn cụm phù hợp nhé.","prompt":"He decided to _____ on smoking after 20 years.","choices":["Corner the market","Go cold turkey","Cost a mint","Copycat"]},{"term":"Go down in flames","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thất bại thảm hại, tiêu tùng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A fool and his money are easily parted","Go down in flames","A for effort","A flash in the pan"]},{"term":"Go down like a lead balloon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thất bại thảm hại, không được ai hưởng ứng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["From time to time","Fuddy-duddy","Go down like a lead balloon","From the word go"]},{"term":"Go Dutch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiền ai nấy trả, cưa đôi hóa đơn (khi đi ăn).”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's _____ on dinner tonight.","choices":["Along for the ride","Go Dutch","All wet","An about-face"]},{"term":"Go fly a kite","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Biến đi, tránh ra chỗ khác chơi”. Cậu chọn cụm phù hợp nhé.","prompt":"When he wouldn’t stop arguing, I told him to _____.","choices":["Armchair quarterback","Go fly a kite","Are you kidding me?","apple of my eye"]},{"term":"Go fry an egg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Biến đi, đừng chõ mũi vào chuyện người khác”. Cậu chọn cụm phù hợp nhé.","prompt":"He kept asking me questions, so finally, I told him to _____.","choices":["Sitting like a bump on a log","Sit tight","Sitting pretty","Go fry an egg"]}]},{"id":"idioms-v1-lesson-033","title":"Bài 33","focus":"Thành ngữ từ “Go haywire” đến “Go with the flow”.","questions":[{"term":"Go haywire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hỏng hóc, mất kiểm soát, rối tung lên”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep something under one's hat","Keep something under control","Go haywire","Keep something at bay"]},{"term":"Go it alone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tự lực cánh sinh, làm việc đơn độc không cần ai giúp”. Cậu chọn cụm phù hợp nhé.","prompt":"He decided to _____ and start his own business.","choices":["Like a chicken with its head cut off","Letter-perfect","Like a deer in the headlights","Go it alone"]},{"term":"Go off half-cocked","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hành động vội vàng, thiếu suy nghĩ hoặc chưa chuẩn bị kỹ”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t _____; make sure you have all the information first.","choices":["In the least","In the long run","In the loop","Go off half-cocked"]},{"term":"Go off the deep end","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mất kiểm soát cảm xúc, nổi trận lôi đình; hành động thiếu suy nghĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go off the deep end","In the heat of the moment","In the lap of luxury","In the least"]},{"term":"Go on a wild goose chase","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cất công tìm kiếm một thứ không có thật hoặc không thể tìm thấy (tốn công vô ích)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Gut feeling","Go on a wild goose chase","Hair’s breadth","Hair of the dog"]},{"term":"Go out of one's way","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cất công, chịu khó làm việc gì (thường là để giúp đỡ người khác)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go out of one's way","On top of the world","On thin ice","Once and for all"]},{"term":"Go out on a limb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liều lĩnh nói hoặc làm điều gì đó (không được nhiều người ủng hộ); mạo hiểm”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go out on a limb","come to light","Comfort food","come to terms with"]},{"term":"Go overboard","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm quá trớn, quá mức cần thiết”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t _____ with the decorations; we want a simple look.","choices":["Go overboard","Don't know if I'm coming or going","Don't know him from Adam","Don't hold your breath"]},{"term":"Go postal","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi điên, phát rồ lên (thường mang tính bạo lực)”. Cậu chọn cụm phù hợp nhé.","prompt":"The boss will _____ if the report isn’t finished by tomorrow.","choices":["get on someone's nerves","Get on one's nerves","Go postal","Get one's act together"]},{"term":"Go south","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trở nên tồi tệ, xuống dốc, thất bại”. Cậu chọn cụm phù hợp nhé.","prompt":"After the new policy was implemented, sales started to _____.","choices":["Sea legs","Screw up","Second-rate","Go south"]},{"term":"Go the extra mile","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nỗ lực hết mình, làm nhiều hơn mức được yêu cầu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go the extra mile","Horse around","home sweet home","Hopping mad"]},{"term":"Go the whole hog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc gì đó một cách triệt để, tới bến, không do dự”. Cậu chọn cụm phù hợp nhé.","prompt":"If we’re going to renovate the kitchen, let’s _____ and do it properly.","choices":["Jump through hoops","Jump on the bandwagon","Go the whole hog","Jump the gun"]},{"term":"Go through something with a fine-tooth comb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiểm tra kỹ lưỡng, săm soi từng ly từng tí”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Breeze through","Break the news","Go through something with a fine-tooth comb","Bright and early"]},{"term":"Go to hell in a handbasket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tụt dốc không phanh, rơi vào thảm họa”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hear something straight from the horse’s mouth","Heebie-jeebies","helicopter parent","Go to hell in a handbasket"]},{"term":"Go to pieces","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Suy sụp tinh thần, sụp đổ hoàn toàn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["feel the pinch","feel like a million dollars","feel blue","Go to pieces"]},{"term":"Go to the dogs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xuống cấp trầm trọng, đổ đốn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go to the dogs","Go through something with a fine-tooth comb","Go to hell in a handbasket","Go to pieces"]},{"term":"Go to town","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc gì đó với sự nhiệt tình và tập trung cao độ; tiêu xài thả ga”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["run out of steam","Go to town","run out of time","run one's mouth off"]},{"term":"go under the knife","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lên bàn mổ, trải qua phẫu thuật.”. Cậu chọn cụm phù hợp nhé.","prompt":"He is scheduled to _____ tomorrow to repair a torn ligament in his knee.","choices":["Just a moment","Junk food","Jump through hoops","go under the knife"]},{"term":"Go up in smoke","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tan thành mây khói, thất bại hoàn toàn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go up in smoke","Have one's back to the wall","have one's ducks in a row","Have hell to pay"]},{"term":"Go with the flow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thuận theo tự nhiên, để mọi thứ diễn ra theo cách của nó”. Cậu chọn cụm phù hợp nhé.","prompt":"Instead of planning every detail, sometimes it’s best to just _____.","choices":["Go the extra mile","Go south","Go with the flow","Go the whole hog"]}]},{"id":"idioms-v1-lesson-034","title":"Bài 34","focus":"Thành ngữ từ “Go without saying” đến “Green room”.","questions":[{"term":"Go without saying","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiển nhiên, không cần bàn cãi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A little bird told me","A little learning is a dangerous thing","A long face","Go without saying"]},{"term":"Go-to guy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người đáng tin cậy, người chuyên giải quyết vấn đề (trong một nhóm/tổ chức)”. Cậu chọn cụm phù hợp nhé.","prompt":"When it comes to fixing computers, John is our _____.","choices":["run its course","run errands","Go-to guy","run in the family"]},{"term":"Golden age","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thời kỳ hoàng kim”. Cậu chọn cụm phù hợp nhé.","prompt":"The 1950s are often considered the _____ of American cinema.","choices":["Golden age","Swallow your pride","Stuffed shirt","String someone along"]},{"term":"Golden opportunity","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cơ hội ngàn vàng”. Cậu chọn cụm phù hợp nhé.","prompt":"This job offer is a _____ you shouldn’t miss.","choices":["Smoke and mirrors","Smell a rat","Smoke like a chimney","Golden opportunity"]},{"term":"Good egg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người tốt tính, đáng tin cậy”. Cậu chọn cụm phù hợp nhé.","prompt":"Tom is such a _____; he’s always willing to help others.","choices":["Good egg","Fly the coop","fly through","Fly-by-night"]},{"term":"Good for you!","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giỏi lắm, chúc mừng nhé (thường dùng để tán dương)”. Cậu chọn cụm phù hợp nhé.","prompt":"You finally finished your degree? _____","choices":["Shake a leg","Good for you!","Shape up or ship out","Set one's teeth on edge"]},{"term":"Good riddance","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mừng vì đã tống khứ được (ai/cái gì); đi rảnh nợ”. Cậu chọn cụm phù hợp nhé.","prompt":"They moved out yesterday, and I say _____. They were terrible neighbors.","choices":["Pipe down","Pigheaded","Pig out","Good riddance"]},{"term":"Good things come to those who wait","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trời không phụ lòng người kiên nhẫn; phần thưởng tốt đẹp dành cho người biết chờ đợi”. Cậu chọn cụm phù hợp nhé.","prompt":"He finally got the promotion after years of hard work, proving that _____.","choices":["last straw","Laugh all the way to the bank","Last-ditch effort","Good things come to those who wait"]},{"term":"Good to know","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất đáng để biết, thông tin rất hữu ích”. Cậu chọn cụm phù hợp nhé.","prompt":"That is _____ for our trip.","choices":["run the show","Good to know","Run-of-the-mill","run out of time"]},{"term":"Goody-goody gumdrops","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tuyệt vời, ôi thích quá đi mất (thường dùng một cách trẻ con hoặc mỉa mai)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get in someone’s hair","Get hold of someone","Get hold of something","Goody-goody gumdrops"]},{"term":"Goof off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lãng phí thời gian, chểnh mảng, làm những việc linh tinh”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["right this way","ring a bell","rest on one's laurels","Goof off"]},{"term":"Grasp at straws","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vớt vát hy vọng, bấu víu vào bất cứ thứ gì trong tuyệt vọng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Goody-goody gumdrops","Good to know","Good things come to those who wait","Grasp at straws"]},{"term":"Graveyard shift","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ca làm đêm, ca trực đêm.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s working the _____ at the hospital this week.","choices":["A bone to pick","Graveyard shift","A blessing in disguise","A bit/A little bit"]},{"term":"Gravy train","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Việc nhẹ lương cao, món hời, cơ hội kiếm tiền dễ dàng.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s been riding the _____ ever since he landed that high-paying government contract.","choices":["Left behind","Leave someone out in the cold","Gravy train","Leave well enough alone"]},{"term":"Gray area","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vùng xám, ranh giới không rõ ràng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The legality of that business practice exists in a _____.","choices":["Make a long story short","Gray area","Make a big stink","Make a mountain out of a molehill"]},{"term":"Grease monkey","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thợ sửa xe, thợ máy.”. Cậu chọn cụm phù hợp nhé.","prompt":"The _____ fixed my car in no time.","choices":["Get something for peanuts","Get something out of one's system","Grease monkey","Get something off one's chest"]},{"term":"Greased lightning","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhanh như chớp, nhanh như điện.”. Cậu chọn cụm phù hợp nhé.","prompt":"She zipped through the crowd like _____ to catch the train.","choices":["X marks the spot","Wrap one's head around something","wrap your head around","Greased lightning"]},{"term":"Great minds think alike","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tư tưởng lớn gặp nhau, ý tưởng lớn trùng nhau.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ about this project.","choices":["Slap on the wrist","Slim chance","Great minds think alike","Sleep like a log"]},{"term":"Green around the gills","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xanh xao, nhợt nhạt, có vẻ ốm yếu hoặc buồn nôn.”. Cậu chọn cụm phù hợp nhé.","prompt":"He looked _____ after the roller coaster ride.","choices":["All heart","all in all","Green around the gills","All in the same boat"]},{"term":"Green room","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phòng chờ (dành cho diễn viên, khách mời trước khi lên sân khấu).”. Cậu chọn cụm phù hợp nhé.","prompt":"The actors chatted with each other in the _____ before the show.","choices":["Go bananas","Go bonkers","Green room","Go belly up"]}]},{"id":"idioms-v1-lesson-035","title":"Bài 35","focus":"Thành ngữ từ “Green thumb” đến “Hard pill to swallow”.","questions":[{"term":"Green thumb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có tay trồng cây, mát tay trồng trọt.”. Cậu chọn cụm phù hợp nhé.","prompt":"She must have a _____ because her garden is always full of beautiful flowers.","choices":["Breeze through","Green thumb","Break the news","Break the ice"]},{"term":"green with envy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ghen tị đỏ mắt, vô cùng đố kỵ.”. Cậu chọn cụm phù hợp nhé.","prompt":"When they saw his luxury sports car, all his colleagues were _____.","choices":["green with envy","Go bananas","Go back to the drawing board","Go belly up"]},{"term":"Grin and bear it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cắn răng chịu đựng, ngậm đắng nuốt cay.”. Cậu chọn cụm phù hợp nhé.","prompt":"Even though the project was stressful he chose to _____ until it was completed.","choices":["Here and there","Grin and bear it","High on the hog","helicopter parent"]},{"term":"Guinea pig","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuột bạch, vật thí nghiệm.”. Cậu chọn cụm phù hợp nhé.","prompt":"They used me as a _____ for their new training program.","choices":["Black and blue","Black market","Guinea pig","Black out"]},{"term":"Gung ho","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hăng hái, nhiệt tình, hừng hực khí thế.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s so _____ about the new project, it’s contagious.","choices":["Gung ho","An ounce of prevention is worth a pound of cure","apple of my eye","Are you kidding me?"]},{"term":"Gut feeling","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trực giác, linh cảm.”. Cậu chọn cụm phù hợp nhé.","prompt":"I had a _____ that something was wrong.","choices":["Get bent out of shape","Get back to someone","Get along with someone","Gut feeling"]},{"term":"Hair of the dog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rượu giải rượu, lấy độc trị độc (uống thêm rượu để chữa say rượu).”. Cậu chọn cụm phù hợp nhé.","prompt":"He had a bad hangover, so he decided to have a _____ in the morning.","choices":["Elvis has left the building","eleventh hour","empty nest syndrome","Hair of the dog"]},{"term":"Hair’s breadth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đường tơ kẽ tóc, trong gang tấc.”. Cậu chọn cụm phù hợp nhé.","prompt":"The car missed the pedestrian by a _____.","choices":["Screw up","Sea legs","Scot-free","Hair’s breadth"]},{"term":"Half a mind to do something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có ý định, nửa muốn nửa không (thường vì tức giận nhưng chưa quyết hẳn).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Half a mind to do something","break out in a cold sweat","Break someone's heart","Break the bank"]},{"term":"Half the battle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một nửa thành công, đã giải quyết được phần khó khăn nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"Understanding the problem is _____.","choices":["Flavor of the month","Flea market","Fixed in one's ways","Half the battle"]},{"term":"Half-baked","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chưa chín chắn, thiếu suy nghĩ, nửa vời.”. Cậu chọn cụm phù hợp nhé.","prompt":"He came up with a _____ scheme to start a business without any market research.","choices":["Come out of one's shell","Half-baked","Come out smelling like a rose","Come out flat-footed"]},{"term":"Hammer out a deal","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thỏa thuận thành công, chốt được hợp đồng sau khi thương lượng căng thẳng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Scare the pants off someone","School of thought","School someone in something","Hammer out a deal"]},{"term":"Hand in glove","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cấu kết chặt chẽ, ăn ý với nhau (thường mang nghĩa tiêu cực hoặc ám muội).”. Cậu chọn cụm phù hợp nhé.","prompt":"Those two companies have been operating _____ for years.","choices":["For heaven's sake","Hand in glove","For crying out loud","For goodness' sake"]},{"term":"Hand over fist","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vớ bở, kiếm hoặc mất (tiền) nhanh như nước.”. Cậu chọn cụm phù hợp nhé.","prompt":"The new product was a hit and the company started making money _____.","choices":["Handle someone with kid gloves","Hand over fist","Hang tight","Hang in there"]},{"term":"Handle someone with kid gloves","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đối xử một cách nhẹ nhàng, thận trọng (vì ai đó nhạy cảm)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["catch one's death of cold","Handle someone with kid gloves","Catch some rays","catch red-handed"]},{"term":"Hang in there","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cố gắng lên, đừng bỏ cuộc, kiên trì nhé.”. Cậu chọn cụm phù hợp nhé.","prompt":"I know the exam is tough, but _____; you’ll do great.","choices":["Hang in there","Fish out of water","Fishy","Fit as a fiddle"]},{"term":"Hang tight","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cứ chờ ở đó, kiên nhẫn đợi một chút.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, the doctor will be with you shortly.","choices":["Armed to the teeth","around the clock","Around-the-clock","Hang tight"]},{"term":"Happy-go-lucky","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô tư lự, lạc quan, phó mặc cho số phận.”. Cậu chọn cụm phù hợp nhé.","prompt":"She’s always been a _____ person never worrying too much about what tomorrow brings.","choices":["Happy-go-lucky","In seventh heaven","In my book","In my element"]},{"term":"hard nut to crack","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vấn đề hóc búa nan giải; người cứng đầu khó thuyết phục.”. Cậu chọn cụm phù hợp nhé.","prompt":"Analyzing customer retention in this market has proven to be a _____.","choices":["Be beside oneself","hard nut to crack","Be loaded","Be close-fisted"]},{"term":"Hard pill to swallow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự thật phũ phàng, điều đắng cay khó chấp nhận.”. Cậu chọn cụm phù hợp nhé.","prompt":"Losing the championship game was a _____ for the team.","choices":["The tide has turned","The whole ball of wax","Hard pill to swallow","The tip of the iceberg"]}]},{"id":"idioms-v1-lesson-036","title":"Bài 36","focus":"Thành ngữ từ “Hard sell” đến “Head in the clouds”.","questions":[{"term":"Hard sell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cách bán hàng ép buộc, ép mua bằng được.”. Cậu chọn cụm phù hợp nhé.","prompt":"The car salesman was giving me a _____ on the latest model.","choices":["Get the green light","Get the go-ahead","get the hang of","Hard sell"]},{"term":"Haste makes waste","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dục tốc bất đạt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t rush through your homework; remember, _____.","choices":["Haste makes waste","Knock something into a cocked hat","Know by sight","Know one's onions"]},{"term":"Have an axe to grind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có ý đồ riêng, có động cơ cá nhân, có xích mích cần giải quyết.”. Cậu chọn cụm phù hợp nhé.","prompt":"Be careful when talking to him; he always seems to _____.","choices":["Get hold of someone","Have an axe to grind","Get down to the nuts and bolts","Get from A to B"]},{"term":"Have another thing coming","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lầm to rồi, cứ chờ đấy mà xem.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Have another thing coming","Just now","Keep an eye on","keep at bay"]},{"term":"Have bats in one’s belfry","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị chập mạch, hâm dở, gàn dở.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Watch out for","Water under the bridge","Have bats in one’s belfry","Watering hole"]},{"term":"Have bigger fish to fry","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có việc quan trọng hơn cần giải quyết.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["On a tear","Have bigger fish to fry","On a shoestring","On a treadmill"]},{"term":"have egg on one's face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bẽ mặt, xấu hổ vì mắc sai lầm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Let bygones be bygones","have egg on one's face","Let sleeping dogs lie","let by-gones be by-gones"]},{"term":"Have hell to pay","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gặp rắc rối lớn, phải trả giá đắt.”. Cậu chọn cụm phù hợp nhé.","prompt":"If he finds out you broke his favorite vase, you’ll _____.","choices":["On a tear","On a treadmill","Have hell to pay","On cloud nine"]},{"term":"Have one's back to the wall","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị dồn vào chân tường, ở thế bí.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Time is money","Time flies when you're having fun","Have one's back to the wall","time will tell"]},{"term":"have one's ducks in a row","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuẩn bị kỹ càng, sắp xếp mọi thứ đâu ra đấy.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["have one's ducks in a row","Poker face","Play with fire","Play second fiddle"]},{"term":"Have one's head in the clouds","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mơ mộng hão huyền, để tâm hồn treo ngược cành cây.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Have one's head in the clouds","Head over heels","Heads-up","Head in the clouds"]},{"term":"Have one's heart set on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng khao khát; quyết tâm đạt được.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Have one's heart set on","get cold feet","Get bent out of shape","Get by"]},{"term":"Have something down pat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm rõ như lòng bàn tay, thuộc làu làu, thành thạo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take your time","take the wind out of someone's sails","Have something down pat","take with a grain of salt"]},{"term":"Have the world by the tail","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm chắc phần thắng, làm chủ thế giới, đang ở đỉnh cao danh vọng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Have the world by the tail","Burn the candle at both ends","Bury one's head in the sand","Burn the midnight oil"]},{"term":"Have time off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghỉ phép, có thời gian rảnh rỗi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["money doesn't grow on trees","Have time off","Money talks","Money to burn"]},{"term":"Have two left feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vụng về, lóng ngóng (đặc biệt là khi khiêu vũ).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["keep tabs on","Keep the ball rolling","Have two left feet","Keep up with"]},{"term":"He who laughs last laughs loudest","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cười người hôm trước hôm sau người cười; người chiến thắng cuối cùng mới là người giỏi nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"John didn’t do well in the early rounds, but _____ — he won the championship.","choices":["Give someone/something short shrift","Go against the grain","Go around in circles","He who laughs last laughs loudest"]},{"term":"Head and shoulders above","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt trội hoàn toàn, xuất sắc hơn hẳn.”. Cậu chọn cụm phù hợp nhé.","prompt":"In terms of problem-solving skills Jane is _____ her peers.","choices":["Fly the coop","Head and shoulders above","Fly off the handle","fly through"]},{"term":"Head honcho","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người sếp cao nhất, người đứng đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"The _____ will be in town next week for the annual meeting.","choices":["Get on one's last nerve","Head honcho","Get on one's nerves","get on like a house on fire"]},{"term":"Head in the clouds","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Để tâm hồn trên mây, viển vông, xa rời thực tế.”. Cậu chọn cụm phù hợp nhé.","prompt":"She’s a dreamer with her _____ but she has great ideas.","choices":["Head in the clouds","Don't want to hear that","Don't sweat the small stuff","Don't throw the baby out with the bath water"]}]},{"id":"idioms-v1-lesson-037","title":"Bài 37","focus":"Thành ngữ từ “Head over heels” đến “Hit the road”.","questions":[{"term":"Head over heels","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Say đắm, mê mệt (thường nói về tình yêu).”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s _____ in love with her.","choices":["A hot potato","Head over heels","A kickback","A level playing field"]},{"term":"Heads-up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lời báo trước, thông báo trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"Thanks for the _____ about the meeting tomorrow.","choices":["Lead someone around by the nose","Heads-up","Lay someone off","Lay down the law"]},{"term":"Hear it on the grapevine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe đồn, hóng hớt được.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put something into practice","put something on ice","Hear it on the grapevine","put something on the back burner"]},{"term":"Hear something straight from the horse’s mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe từ chính chủ, lấy thông tin từ nguồn đáng tin cậy nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hear something straight from the horse’s mouth","Pass the buck","Pass the course","pass with flying colors"]},{"term":"Heebie-jeebies","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi da gà, rợn tóc gáy, sợ hãi, ớn lạnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"The creepy old house gave me the _____.","choices":["Ignorance is bliss","Heebie-jeebies","If you play your cards right","If you can't stand the heat, get out of the kitchen"]},{"term":"helicopter parent","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phụ huynh trực thăng (cha mẹ bảo bọc, kiểm soát con cái thái quá mọi lúc mọi nơi).”. Cậu chọn cụm phù hợp nhé.","prompt":"Her mother was a classic _____ who called the teacher over every minor dispute.","choices":["action speaks louder than words","Actions Speak Louder Than Words","Add fuel to the fire","helicopter parent"]},{"term":"Here and there","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chỗ này chỗ kia, rải rác, thỉnh thoảng.”. Cậu chọn cụm phù hợp nhé.","prompt":"We found small cafes _____ in the city.","choices":["Cool as a cucumber","Here and there","Cook the books","Cook up"]},{"term":"High on the hog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống xa hoa, ăn sung mặc sướng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Ever since he got his promotion he’s been living _____.","choices":["Run/blow hot and cold","safe and sound","Running on fumes","High on the hog"]},{"term":"High, wide, and handsome","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đầy tự tin và phóng khoáng; đường hoàng đĩnh đạc.”. Cậu chọn cụm phù hợp nhé.","prompt":"He entered the room, _____, capturing everyone's attention.","choices":["Pull the plug","pull the rug out from under someone","Pull strings","High, wide, and handsome"]},{"term":"Hissy fit","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cơn thịnh nộ vô cớ; ăn vạ (thường dùng với ý hài hước).”. Cậu chọn cụm phù hợp nhé.","prompt":"She threw a _____ just because her coffee was cold.","choices":["Hissy fit","School of thought","Scare the pants off someone","School someone in something"]},{"term":"Hit it on the nose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói đúng phóc; đoán trúng phóc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Your analysis of the sales trends was right; you _____.","choices":["the lion's share","Hit it on the nose","The life of Riley","The light of my life"]},{"term":"Hit me up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liên lạc với tôi; nhắn tin/gọi cho tôi nhé.”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm free this weekend, _____ if you want to hang out.","choices":["The short end of the stick","The squeaky wheel gets the grease","The straight and narrow","Hit me up"]},{"term":"Hit pay dirt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trúng quả đậm; tìm thấy mỏ vàng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The startup _____ when they launched their innovative app.","choices":["Out of date","Out of left field","Hit pay dirt","Open a can of worms"]},{"term":"Hit someone below the belt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chơi đòn hiểm; đánh dưới thắt lưng (công kích cá nhân một cách hèn hạ).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hit someone below the belt","Get down to the nuts and bolts","Get down to business","Get down to brass tacks"]},{"term":"Hit the books","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vùi đầu vào sách vở; cắm đầu vào học.”. Cậu chọn cụm phù hợp nhé.","prompt":"I've got a big exam next week, so it's time to _____.","choices":["Are you kidding me?","Hit the books","apple of my eye","Armchair quarterback"]},{"term":"Hit the ceiling","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi trận lôi đình; tức điên lên.”. Cậu chọn cụm phù hợp nhé.","prompt":"My dad _____ when I told him I crashed the car.","choices":["Hit the ceiling","go under the knife","Go with the flow","Go up in smoke"]},{"term":"Hit the hay","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi ngủ; lên giường đi ngủ.”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm really exhausted; it's time to _____.","choices":["Go south","Go the extra mile","Go the whole hog","Hit the hay"]},{"term":"Hit the jackpot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trúng số độc đắc; vớ được món hời lớn.”. Cậu chọn cụm phù hợp nhé.","prompt":"They _____ with their new product; it sold out in a week.","choices":["Get wind of something","Hit the jackpot","get wind of","Get with it"]},{"term":"Hit the nail on the head","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói trúng tim đen; nói đúng phóc.”. Cậu chọn cụm phù hợp nhé.","prompt":"You really _____ with your analysis of the problem.","choices":["Between the devil and the deep blue sea","Between a rock and a hard place","Hit the nail on the head","Beyond the pale"]},{"term":"Hit the road","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lên đường; khởi hành.”. Cậu chọn cụm phù hợp nhé.","prompt":"We should _____ early to avoid traffic.","choices":["Lend an ear","Hit the road","let by-gones be by-gones","Let bygones be bygones"]}]},{"id":"idioms-v1-lesson-038","title":"Bài 38","focus":"Thành ngữ từ “Hit the sack” đến “I can't imagine”.","questions":[{"term":"Hit the sack","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lên giường đi ngủ.”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm really tired, so I'm going to _____ early tonight.","choices":["Go-to guy","Golden age","Hit the sack","Go without saying"]},{"term":"hit the spot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “gãi đúng chỗ ngứa, đúng thứ đang thèm”. Cậu chọn cụm phù hợp nhé.","prompt":"After a long hike, a cold lemonade really _____.","choices":["Grasp at straws","Goody-goody gumdrops","hit the spot","Goof off"]},{"term":"Hocus-pocus","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trò bịp bợm; trò ma thuật.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't believe his _____; it's all sleight of hand.","choices":["Head over heels","Head in the clouds","Heads-up","Hocus-pocus"]},{"term":"hold ground","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ vững vị trí, kiên định không nhượng bộ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Leave someone alone","hold ground","Leave no stone unturned","Learn the ropes"]},{"term":"Hold one's own","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đứng vững, không hề kém cạnh (trong khó khăn, cạnh tranh).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hold one's own","Dawned on me","day in day out","Damn someone with faint praise"]},{"term":"Hold out an olive branch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chìa cành ô liu, tỏ ý muốn hòa giải.”. Cậu chọn cụm phù hợp nhé.","prompt":"After the heated argument, she decided to _____ and apologized.","choices":["rain or shine","Hold out an olive branch","raise Cain","read between the lines"]},{"term":"Hold the fort","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quán xuyến công việc (trong lúc ai đó đi vắng); trông nom nhà cửa.”. Cậu chọn cụm phù hợp nhé.","prompt":"The manager asked me to _____ until she returns.","choices":["Leave someone high and dry","Leave someone alone","Hold the fort","Leave someone in the lurch"]},{"term":"Hold your horses","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình tĩnh lại nào; từ từ đã.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, the meeting doesn't start for another 30 minutes.","choices":["clean bill of health","Chow down","Hold your horses","Chuffed to bits"]},{"term":"Hold your tongue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ mồm giữ miệng; im lặng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Break the news","Break the ice","Breeze through","Hold your tongue"]},{"term":"Holding the bag","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phải giơ đầu chịu báng; gánh chịu hậu quả một mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"She ended up _____ after her teammates didn't show up for the presentation.","choices":["A snowball’s chance in hell","A smart cookie","A snowball effect","Holding the bag"]},{"term":"home sweet home","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không đâu bằng nhà mình; mái ấm thân yêu.”. Cậu chọn cụm phù hợp nhé.","prompt":"After traveling abroad for a grueling month, I walked through the door and whispered, '_____.'","choices":["home sweet home","One's eyes are bigger than one's stomach","One's hands are tied","One's neck of the woods"]},{"term":"Hopping mad","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tức nhảy cồ cồ; giận sôi máu.”. Cậu chọn cụm phù hợp nhé.","prompt":"When she found out about the broken vase, she was _____.","choices":["give it a shot","Give props to","Give in","Hopping mad"]},{"term":"Horse around","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đùa giỡn ầm ĩ; nghịch ngợm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["There's no such thing as a free lunch","Third time's a charm","Horse around","Think outside the box"]},{"term":"Horse of a different color","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một chuyện hoàn toàn khác; một vấn đề khác hẳn.”. Cậu chọn cụm phù hợp nhé.","prompt":"I thought the meeting was about budget cuts, but it turned out to be a _____.","choices":["It ain't over till the fat lady sings","In the way","Horse of a different color","It is a poor workman who blames his tools"]},{"term":"Hot under the collar","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi giận đùng đùng; bực tức.”. Cậu chọn cụm phù hợp nhé.","prompt":"He got _____ when his colleague blamed him for the mistake.","choices":["Last-ditch effort","Laugh all the way to the bank","Lay an egg","Hot under the collar"]},{"term":"Hot-button issue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vấn đề nhức nhối; chủ đề gây tranh cãi gay gắt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Gun control is a _____ that divides many Americans.","choices":["Keep one's mouth shut","Hot-button issue","Keep one's nose to the grindstone","Keep one's nose clean"]},{"term":"Hotshot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ xuất chúng nhưng kiêu ngạo; người tài giỏi xuất sắc.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's a _____ lawyer known for winning difficult cases.","choices":["Skeleton in the closet","Slap on the wrist","Hotshot","Skip class"]},{"term":"How do you like them apples","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thấy sao hả?; Nhìn mà xem! (dùng khi đắc ý).”. Cậu chọn cụm phù hợp nhé.","prompt":"We won the championship! _____?","choices":["Blow one's top","How do you like them apples","Blow smoke","Blow one's own horn"]},{"term":"Hunky-dory","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mọi chuyện đều ổn thỏa; êm đẹp.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't worry, everything will be _____ by the weekend.","choices":["If worst comes to worst","If you play your cards right","If you can't stand the heat, get out of the kitchen","Hunky-dory"]},{"term":"I can't imagine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi không thể tưởng tượng được.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ living without the internet these days.","choices":["Forty winks","I can't imagine","Freak out","Fortune favors the bold"]}]},{"id":"idioms-v1-lesson-039","title":"Bài 39","focus":"Thành ngữ từ “I don't have two nickels to rub together” đến “In full swing”.","questions":[{"term":"I don't have two nickels to rub together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cháy túi; không có một xu dính túi.”. Cậu chọn cụm phù hợp nhé.","prompt":"After losing my job, _____.","choices":["talk someone's ear off","talk a blue streak","I don't have two nickels to rub together","talk shop"]},{"term":"I suck at something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi rất tệ ở việc gì đó; dở tệ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["I don't have two nickels to rub together","I suck at something","I'd give my right hand to","I wasn't born yesterday"]},{"term":"I wasn't born yesterday","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi đâu có phải trẻ lên ba; tôi đâu có dễ bị lừa.”. Cậu chọn cụm phù hợp nhé.","prompt":"You can't trick me with such a simple scam; _____.","choices":["High, wide, and handsome","Hissy fit","Hit it on the nose","I wasn't born yesterday"]},{"term":"I'd give my right hand to","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi sẵn sàng đánh đổi tất cả để; tôi vô cùng khao khát.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ meet my favorite author in person.","choices":["I'd give my right hand to","Go to the dogs","go under the knife","Go to town"]},{"term":"I'm losing it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi sắp phát điên rồi; tôi sắp mất kiểm soát rồi.”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm so stressed out with all these deadlines; _____.","choices":["Jump on the bandwagon","Jump the gun","I'm losing it","jump for joy"]},{"term":"Icing on the cake","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thêm phần rực rỡ; phần thưởng thêm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Getting a promotion was great, but the bonus was the _____.","choices":["Icing on the cake","Pitch dark","Pipe down","Pipe dream"]},{"term":"Idle hands are the devil's tools","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhàn cư vi bất thiện.”. Cậu chọn cụm phù hợp nhé.","prompt":"Parents often encourage their children to find a hobby because they believe _____.","choices":["Country mile","Couldn't care less","Couch potato","Idle hands are the devil's tools"]},{"term":"If I had a nickel for every time something happened","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nếu mỗi lần như vậy tôi có một đồng xu thì tôi đã giàu to; chuyện xảy ra như cơm bữa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["If I had a nickel for every time something happened","In the loop","In the long run","In the nick of time"]},{"term":"If worst comes to worst","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong trường hợp xấu nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, I'll use my savings to cover the expenses.","choices":["the other day","the patience of Job","If worst comes to worst","the pits"]},{"term":"If you can't stand the heat, get out of the kitchen","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không chịu được áp lực thì đừng làm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Running a business is tough. _____.","choices":["Get ahold of yourself","Get along with someone","Get a word in edgewise","If you can't stand the heat, get out of the kitchen"]},{"term":"If you play your cards right","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nếu biết cách tính toán; nếu khéo léo xử lý.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, you might get that promotion.","choices":["If you play your cards right","Caught someone red-handed","Caught red-handed","Caught with ones hand in the cookie jar"]},{"term":"Ignorance is bliss","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không biết thì không đau lòng; ngu si hưởng thái bình.”. Cậu chọn cụm phù hợp nhé.","prompt":"He decided not to tell her about the bad news; after all, _____.","choices":["Carry the ball","Cast pearls before swine","Ignorance is bliss","cash cow"]},{"term":"In a bind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang gặp rắc rối; rơi vào tình thế tiến thoái lưỡng nan.”. Cậu chọn cụm phù hợp nhé.","prompt":"She is really _____ with all these bills to pay.","choices":["In a bind","Twist someone's arm","Turn up the heat","Turn the tables"]},{"term":"In a jam","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang kẹt cứng; rơi vào hoàn cảnh khó khăn.”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm really _____ right now. My car broke down, and I have no way to get to work.","choices":["Par for the course","In a jam","Party animal","Pandora’s box"]},{"term":"In a nutshell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tóm lại; nói ngắn gọn.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, the company is facing financial difficulties.","choices":["A bird in the hand is worth two in the bush","A bit/A little bit","A ballpark figure","In a nutshell"]},{"term":"In a pinch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong trường hợp khẩn cấp; dùng tạm khi cấp bách.”. Cậu chọn cụm phù hợp nhé.","prompt":"I can use my phone as a flashlight _____.","choices":["In a pinch","Veg out","Walk in someone's shoes","Walk on air"]},{"term":"In a rut","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rơi vào lối mòn; bế tắc trong công việc/cuộc sống.”. Cậu chọn cụm phù hợp nhé.","prompt":"She feels like she's _____ at her current job.","choices":["Go cold turkey","Go bonkers","Go down in flames","In a rut"]},{"term":"In charge of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chịu trách nhiệm (quản lý, điều hành).”. Cậu chọn cụm phù hợp nhé.","prompt":"She is _____ the marketing team.","choices":["In charge of","Lost at sea","Low-hanging fruit","Lose touch"]},{"term":"in due course","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đúng lúc, vào thời điểm thích hợp trong tương lai.”. Cậu chọn cụm phù hợp nhé.","prompt":"Your application will be processed and you will receive a response _____.","choices":["keep one's temper","Keep one's wits about one","in due course","Keep one's nose to the grindstone"]},{"term":"In full swing","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang ở lúc cao trào; đang hoạt động hết công suất.”. Cậu chọn cụm phù hợp nhé.","prompt":"The party was _____ by the time we arrived.","choices":["Bend someone's ear","In full swing","Bend over backward","Belt and suspenders"]}]},{"id":"idioms-v1-lesson-040","title":"Bài 40","focus":"Thành ngữ từ “In high gear” đến “In the pink”.","questions":[{"term":"In high gear","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tăng tốc; làm việc với cường độ cao.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cream of the crop","cram for an exam","Crank out","In high gear"]},{"term":"In hot water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gặp rắc rối lớn; dầu sôi lửa bỏng.”. Cậu chọn cụm phù hợp nhé.","prompt":"He got _____ with his parents after coming home late.","choices":["rain on someone's parade","In hot water","raise Cain","rain or shine"]},{"term":"In my book","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Theo quan điểm của tôi; theo suy nghĩ của tôi.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, honesty is always the best policy.","choices":["Filthy rich","Find fault with","In my book","Fill in the blanks"]},{"term":"In my element","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Như cá gặp nước; ở đúng sở trường của mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wing it","Wine and dine","In my element","window shopping"]},{"term":"In seventh heaven","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm thấy vô cùng sung sướng, hạnh phúc ngất ngây (như ở trên chín tầng mây).”. Cậu chọn cụm phù hợp nhé.","prompt":"When she got the promotion, she was _____.","choices":["In seventh heaven","In stitches","In the black","In the bag"]},{"term":"In spades","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất nhiều, ở mức độ cao.”. Cậu chọn cụm phù hợp nhé.","prompt":"Their hard work paid off _____ when they won the championship.","choices":["You can't judge a book by its cover","You can't squeeze blood out of a turnip","In spades","You can't make an omelet without breaking some eggs"]},{"term":"In stitches","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cười ngặt nghẽo, cười đau cả bụng.”. Cậu chọn cụm phù hợp nhé.","prompt":"The comedian had the entire audience _____ during his performance.","choices":["Itchy feet","It's in the bag","It takes two to tango","In stitches"]},{"term":"In the bag","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chắc ăn, nắm chắc phần thắng trong tay.”. Cậu chọn cụm phù hợp nhé.","prompt":"With the way they are playing, the championship is _____.","choices":["Beside the point","In the bag","Beside oneself","Bestie"]},{"term":"In the black","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có lãi, làm ăn có lợi nhuận, không bị mắc nợ.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a tough year, the company is finally _____.","choices":["Do a number on something","Dish the dirt","Divide the spoils","In the black"]},{"term":"in the blink of an eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong chớp mắt, trong khoảnh khắc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Summer vacation seemed to pass by _____.","choices":["in the blink of an eye","Up for grabs","Up in arms","Up a gum tree"]},{"term":"In the boondocks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ở nơi khỉ ho cò gáy, vùng sâu vùng xa.”. Cậu chọn cụm phù hợp nhé.","prompt":"His grandparents live way out _____.","choices":["easy does it","easy come, easy go","eat crow","In the boondocks"]},{"term":"In the chips / In the money","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giàu có, rủng rỉnh tiền bạc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cast pearls before swine","Carry the ball","In the chips / In the money","cash cow"]},{"term":"In the doghouse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang bị ai đó giận, gặp rắc rối vì làm phật ý người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"He forgot their anniversary, so he's really _____ now.","choices":["The tip of the iceberg","The whole nine yards","In the doghouse","The whole ball of wax"]},{"term":"In the heat of the moment","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong lúc nóng giận hoặc thiếu suy nghĩ do cảm xúc dâng trào.”. Cậu chọn cụm phù hợp nhé.","prompt":"He said something hurtful _____, but later apologized.","choices":["Who asked you?","In the heat of the moment","Whitewash","White lie"]},{"term":"In the lap of luxury","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong nhung lụa, sống xa hoa.”. Cậu chọn cụm phù hợp nhé.","prompt":"They've been living _____ since winning the lottery.","choices":["Barking up the wrong tree","Be beside oneself","In the lap of luxury","Batting a thousand"]},{"term":"In the least","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một chút nào (dùng trong câu phủ định mang nghĩa 'hoàn toàn không').”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm not worried _____ about the exam.","choices":["In the least","fall on deaf ears","fancy pants","familiarity breeds contempt"]},{"term":"In the long run","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Về lâu về dài, rốt cuộc thì.”. Cậu chọn cụm phù hợp nhé.","prompt":"Cutting corners might save money now, but _____, it could cost more.","choices":["In the long run","A snowball’s chance in hell","A smart cookie","A snowball effect"]},{"term":"In the loop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Được cập nhật thông tin, nắm rõ tình hình.”. Cậu chọn cụm phù hợp nhé.","prompt":"I need to stay _____ about the project's progress.","choices":["All bark and no bite","ahead of time","In the loop","All bets are off"]},{"term":"In the nick of time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vừa kịp lúc, sát nút.”. Cậu chọn cụm phù hợp nhé.","prompt":"The firefighters arrived _____ to save the building from burning down.","choices":["In the nick of time","Half-baked","Hand in glove","Hammer out a deal"]},{"term":"In the pink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng khỏe mạnh, ở trạng thái sức khỏe tốt nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a few weeks of recovery, he's finally _____ again.","choices":["In the pink","Down in the mouth","down to earth","Down the tube"]}]},{"id":"idioms-v1-lesson-041","title":"Bài 41","focus":"Thành ngữ từ “In the red” đến “Jump the gun”.","questions":[{"term":"In the red","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị thua lỗ, mắc nợ.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a bad year, the company found itself _____.","choices":["In the red","test the waters","that is to say","tell me about it"]},{"term":"in the same boat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cùng chung cảnh ngộ, cùng hội cùng thuyền.”. Cậu chọn cụm phù hợp nhé.","prompt":"None of us finished the assignment yet, so we are all _____.","choices":["in the same boat","blood is thicker than water","Blow a fuse","Blow off steam"]},{"term":"In the sticks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ở vùng sâu vùng xa, nơi hẻo lánh.”. Cậu chọn cụm phù hợp nhé.","prompt":"She moved to a small house _____ to get away from the city noise.","choices":["In the sticks","Caught red-handed","Caught with ones hand in the cookie jar","Caught someone red-handed"]},{"term":"In the way","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngáng đường, gây cản trở.”. Cậu chọn cụm phù hợp nhé.","prompt":"He always feels like his big sister is _____ when he's trying to concentrate.","choices":["In the way","Between a rock and a hard place","Better late than never","Bet the ranch"]},{"term":"It ain't over till the fat lady sings","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chưa đến phút cuối thì chưa biết kết quả ra sao (30 chưa phải là Tết).”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't be discouraged by the score; _____.","choices":["From time to time","From the word go","Fuddy-duddy","It ain't over till the fat lady sings"]},{"term":"It is a poor workman who blames his tools","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thợ tồi thì đổ lỗi cho đồ nghề.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["It is a poor workman who blames his tools","Get one's head around something","Get over it","Get out of hand"]},{"term":"It is always darkest before the dawn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cơn bĩ cực qua đi, hồi thái lai sẽ đến (mọi việc thường trở nên tồi tệ nhất trước khi tốt đẹp lên).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["It is always darkest before the dawn","Third time's a charm","There's no such thing as a free lunch","Think outside the box"]},{"term":"It takes one to know one","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngưu tầm ngưu, mã tầm mã; tự nhận mình cũng thế mới đi chê người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, my friend.","choices":["Knee-high to a grasshopper","Knock it off","It takes one to know one","Knee-jerk reaction"]},{"term":"It takes two to tango","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có lửa mới có khói; cả hai bên đều phải chịu trách nhiệm cho sự việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't blame just one person for the argument; _____.","choices":["On a tear","It takes two to tango","On a shoestring","Old school"]},{"term":"It's in the bag","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chắc ăn, nắm chắc phần thắng trong tay.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bookworm","Bone of contention","Bomb","It's in the bag"]},{"term":"Itchy feet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngứa ngáy tay chân, khao khát được đi du lịch hoặc chuyển đến nơi khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's had _____ ever since she got back from Europe and keeps talking about her next trip.","choices":["Beat a hasty retreat","Bear in mind/keep in mind","Itchy feet","bear in mind"]},{"term":"Ivory tower","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tháp ngà (nơi sống tách biệt với thực tế xã hội, thường ám chỉ giới học thuật).”. Cậu chọn cụm phù hợp nhé.","prompt":"Many people think professors live in an _____, disconnected from the real world.","choices":["bad apple","Bad blood","Ivory tower","Bad hair day"]},{"term":"Jaywalking","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hành vi qua đường ẩu, không đúng nơi quy định hoặc vượt đèn đỏ.”. Cậu chọn cụm phù hợp nhé.","prompt":"He got a ticket for _____ across the busy street.","choices":["Jaywalking","Make a pit stop","Make a long story short","Make a mountain out of a molehill"]},{"term":"Johnny-come-lately","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người mới đến, kẻ chân ướt chân ráo nhưng lại muốn được ưu ái như người cũ.”. Cậu chọn cụm phù hợp nhé.","prompt":"The team doesn't take kindly to a _____ giving suggestions.","choices":["All wet","All thumbs","All set","Johnny-come-lately"]},{"term":"Joined at the hip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dính lấy nhau như hình với bóng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Ever since they started dating, they've been _____.","choices":["time flies","Time flies when you're having fun","Time is money","Joined at the hip"]},{"term":"Josh someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói đùa, trêu chọc ai đó một cách vui vẻ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["hard nut to crack","Josh someone","Hard pill to swallow","Happy-go-lucky"]},{"term":"Jump down someone's throat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi trận lôi đình, mắng nhiếc ai đó té tát và vô cớ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Be loaded","Be my guest","Jump down someone's throat","Be named after"]},{"term":"jump for joy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhảy cẫng lên vì sung sướng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["get wind of","Get to the point","jump for joy","Get up on the wrong side of the bed"]},{"term":"Jump on the bandwagon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hùa theo phong trào, chạy theo xu hướng đang thịnh hành.”. Cậu chọn cụm phù hợp nhé.","prompt":"After the new show became a big hit, everyone seemed to _____.","choices":["You bet","You can bet your boots","Jump on the bandwagon","X marks the spot"]},{"term":"Jump the gun","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cầm đèn chạy trước ô tô, hấp tấp làm việc gì đó quá sớm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Jump the gun","Buy a lemon","by all means","Buy something for a song"]}]},{"id":"idioms-v1-lesson-042","title":"Bài 42","focus":"Thành ngữ từ “Jump through hoops” đến “Keep someone in the dark”.","questions":[{"term":"Jump through hoops","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt qua nhiều rào cản, thủ tục rườm rà để đạt được mục đích.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Jump through hoops","Blow a fuse","Blonde bombshell","blood is thicker than water"]},{"term":"Junk food","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đồ ăn vặt, thức ăn nhanh có hại cho sức khỏe (ít dinh dưỡng, nhiều calo).”. Cậu chọn cụm phù hợp nhé.","prompt":"Try to avoid eating too much _____ and focus on healthier options.","choices":["Wallflower","Junk food","Wash one's hands of something","Waste not, want not"]},{"term":"Just a moment","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chờ một lát, xin đợi một chút.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, I'll be right with you.","choices":["One-trick pony","One's hands are tied","Just a moment","One's eyes are bigger than one's stomach"]},{"term":"Just around the corner","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sắp tới rồi, rất gần (về mặt thời gian hoặc khoảng cách).”. Cậu chọn cụm phù hợp nhé.","prompt":"With the deadline _____, everyone's working overtime.","choices":["Just around the corner","Look like the cat that got the cream","look the other way","look on the bright side"]},{"term":"Just now","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vừa mới đây, cách đây một lát.”. Cậu chọn cụm phù hợp nhé.","prompt":"She called me _____ to inform me of the meeting.","choices":["Make a big stink","Made for each other","Just now","Make a beeline for"]},{"term":"Keep an eye on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Để mắt tới, trông chừng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Can you _____ the baby while I cook dinner?","choices":["Finger-lickin' good","Fishy","Keep an eye on","Fish out of water"]},{"term":"keep at bay","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngăn chặn, kìm hãm mối nguy hiểm ở khoảng cách an toàn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["For heaven's sake","keep at bay","For the birds","For goodness' sake"]},{"term":"Keep body and soul together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cố gắng cầm cự để sống sót, kiếm vừa đủ ăn để sống qua ngày.”. Cậu chọn cụm phù hợp nhé.","prompt":"With his low wages, he can only just _____.","choices":["Burn out","Burn the candle at both ends","Burn the midnight oil","Keep body and soul together"]},{"term":"keep in mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ghi nhớ trong đầu, lưu tâm khi ra quyết định.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ that stores close early on national holidays.","choices":["Keep up with","keep tabs on","Keep the ball rolling","keep in mind"]},{"term":"Keep one's chin up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ tinh thần lạc quan, đừng nản chí.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["nuclear family","Not worth a red cent","Keep one's chin up","Nothing to write home about"]},{"term":"Keep one's cool","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ bình tĩnh, không nổi nóng trong những tình huống căng thẳng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep one's cool","Worth one's salt","Work against the clock","With flying colors"]},{"term":"Keep one's head","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ bình tĩnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Do someone a good turn","Keep one's head","Do something at the drop of a hat","Do something by the seat of your pants"]},{"term":"Keep one's head above water","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cố gắng xoay xở để không bị ngập trong nợ nần hoặc khó khăn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["wrap your head around","Wrap one's head around something","Keep one's head above water","Wouldn't touch it with a ten-foot pole"]},{"term":"Keep one's mouth shut","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ im lặng, không nói ra.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Come clean","Come hell or high water","Come down with a cold","Keep one's mouth shut"]},{"term":"Keep one's nose clean","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tránh rắc rối, cư xử đúng mực.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep one's nose clean","Freak out","Forty winks","fresh as a daisy"]},{"term":"Keep one's nose to the grindstone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm việc chăm chỉ, cặm cụi làm việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Start over from scratch","Keep one's nose to the grindstone","Stand up for","start a family"]},{"term":"keep one's temper","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ bình tĩnh, kìm nén cơn giận.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["See eye to eye","keep one's temper","Security blanket","Second-rate"]},{"term":"Keep one's wits about one","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ tỉnh táo và cảnh giác.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep one's wits about one","Odd man out","Number cruncher","off color"]},{"term":"Keep someone at arm's length","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ khoảng cách với ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wouldn't touch it with a ten-foot pole","Wrap one's head around something","Keep someone at arm's length","wrap your head around"]},{"term":"Keep someone in the dark","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ ai đó trong sự thiếu hiểu biết, giấu giếm ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["On the cheap","On the fence","On the dot","Keep someone in the dark"]}]},{"id":"idioms-v1-lesson-043","title":"Bài 43","focus":"Thành ngữ từ “Keep someone posted” đến “Knock it off”.","questions":[{"term":"Keep someone posted","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cập nhật thông tin cho ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A bone to pick","Keep someone posted","A bunch of","A breath of fresh air"]},{"term":"Keep someone posted / Keep someone in the loop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cập nhật tình hình cho ai đó, giữ cho họ nắm bắt được thông tin.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Money burns a hole in someone's pocket","Keep someone posted / Keep someone in the loop","Mom-and-pop","money doesn't grow on trees"]},{"term":"Keep something at bay","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngăn chặn, kiểm soát điều gì đó xấu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hotshot","Keep something at bay","Hot-button issue","How do you like them apples"]},{"term":"Keep something under control","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiểm soát tình hình, không để mọi chuyện vượt quá tầm kiểm soát.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Start over from scratch","start a family","Keep something under control","Stay in touch"]},{"term":"Keep something under one's hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ bí mật điều gì đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get in touch with","Get into deep water","Keep something under one's hat","Get off on the wrong foot"]},{"term":"Keep something under wraps","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ bí mật về chuyện gì đó, không tiết lộ ra ngoài.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get wind of something","Keep something under wraps","Get your walking papers","Get with it"]},{"term":"keep tabs on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Theo dõi sát sao, để mắt canh chừng ai/cái gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Full steam ahead","keep tabs on","Gain ground","get a grip"]},{"term":"Keep the ball rolling","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Duy trì sự tiến triển của một việc gì đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ on this project to meet the deadline.","choices":["eat like a bird","eat crow","easy does it","Keep the ball rolling"]},{"term":"Keep up with","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Theo kịp, bắt kịp.”. Cậu chọn cụm phù hợp nhé.","prompt":"It's hard to _____ the latest technology trends.","choices":["Castle in the sky","Keep up with","Cat got your tongue?","Cast-iron stomach"]},{"term":"Keep up with the Joneses","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đua đòi, cố gắng bằng bạn bằng bè.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep up with the Joneses","Be close-fisted","Be loaded","Be my guest"]},{"term":"keep your chin up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hãy lạc quan lên, đừng nản lòng, ngẩng cao đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____; you will do much better on the next interview.","choices":["Give someone/something short shrift","Give someone the slip","Give someone the thumbs-up","keep your chin up"]},{"term":"Keyed up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Căng thẳng, hồi hộp hoặc phấn khích.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was all _____ before her big presentation.","choices":["Throw someone to the wolves","Throw someone for a loop","Tickled pink","Keyed up"]},{"term":"Kick up one's heels","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thư giãn và vui vẻ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Kick up one's heels","Blackball someone","Black-and-white","Black tie event"]},{"term":"Kill the mood","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm mất vui, phá hỏng bầu không khí.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Black sheep","Kill the mood","Black market","Black out"]},{"term":"kill time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giết thời gian, tiêu khiển trong lúc chờ đợi.”. Cậu chọn cụm phù hợp nhé.","prompt":"We browsed books at the airport bookstore to _____ before boarding our flight.","choices":["Make tracks","kill time","Make the grade","Make out what someone says"]},{"term":"Kill two birds with one stone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một mũi tên trúng hai đích, một công đôi việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"By carpooling, we can _____ — save money on gas and reduce our carbon footprint.","choices":["Play devil’s advocate","Play hardball","Kill two birds with one stone","Play dumb"]},{"term":"Kit and caboodle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Toàn bộ, tất cả mọi thứ.”. Cậu chọn cụm phù hợp nhé.","prompt":"I just bought a new computer, mouse, keyboard, and the whole _____.","choices":["Cant judge a book by its cover","Cant keep up","Kit and caboodle","Cant hold a candle to"]},{"term":"Knee-high to a grasshopper","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Còn rất nhỏ, còn bé xíu.”. Cậu chọn cụm phù hợp nhé.","prompt":"I've known her since she was _____.","choices":["come to light","Come rain or shine","Knee-high to a grasshopper","come to terms with"]},{"term":"Knee-jerk reaction","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phản xạ tự nhiên, phản ứng thiếu suy nghĩ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Instead of having a _____, take a moment to think it through.","choices":["In my element","In my book","Knee-jerk reaction","In seventh heaven"]},{"term":"Knock it off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thôi đi, dừng ngay lại.”. Cậu chọn cụm phù hợp nhé.","prompt":"Hey, _____! I'm trying to concentrate.","choices":["Lose one's marbles","Lose one's head","Lose one's shirt","Knock it off"]}]},{"id":"idioms-v1-lesson-044","title":"Bài 44","focus":"Thành ngữ từ “Knock on wood” đến “Lead someone around by the nose”.","questions":[{"term":"Knock on wood","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trộm vía (mong điều tốt đẹp hoặc tránh xui xẻo).”. Cậu chọn cụm phù hợp nhé.","prompt":"I've never gotten a speeding ticket, _____.","choices":["Green thumb","Knock on wood","Grin and bear it","green with envy"]},{"term":"Knock someone's socks off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gây ấn tượng mạnh mẽ với ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Knock someone's socks off","Under the table","under the weather","Under the wire"]},{"term":"Knock something into a cocked hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đánh bại hoàn toàn, phá hỏng hoàn toàn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["off color","Number cruncher","Knock something into a cocked hat","Odd man out"]},{"term":"Know by sight","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Biết mặt (nhưng không quen thân).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Dead tired","Dead ringer","Dead to the world","Know by sight"]},{"term":"Know one's onions","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rành rẽ, am hiểu tường tận.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Know one's onions","Come in handy","come of age","Come out flat-footed"]},{"term":"know someone inside out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu ai tường tận từ trong ra ngoài, hiểu thấu tâm can ai.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Be named after","Be loaded","Be my guest","know someone inside out"]},{"term":"Know the ins and outs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm rõ ngọn ngành, biết tường tận.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lay down the law","Lay someone off","Know the ins and outs","Lead someone around by the nose"]},{"term":"Know the ropes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm vững tình hình, biết cách làm việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a few weeks on the job, you'll start to _____.","choices":["Know the ropes","Here and there","High on the hog","High, wide, and handsome"]},{"term":"Know which way the wind is blowing","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm bắt tình hình, biết gió chiều nào che chiều ấy.”. Cậu chọn cụm phù hợp nhé.","prompt":"Before making any big decisions, it's important to _____ in the market.","choices":["set foot in","Serve one right","Know which way the wind is blowing","Set one's teeth on edge"]},{"term":"Know zip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không biết một tí gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"I _____ about repairing cars.","choices":["Know zip","Heads-up","Hear it on the grapevine","Head over heels"]},{"term":"Knuckle under","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đầu hàng, chịu khuất phục.”. Cậu chọn cụm phù hợp nhé.","prompt":"After hours of negotiation, he finally had to _____ and agree to the terms.","choices":["Over my dead body","Knuckle under","over the moon","Outdo oneself"]},{"term":"Labor of love","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Công việc làm vì đam mê.”. Cậu chọn cụm phù hợp nhé.","prompt":"Writing her novel was a _____; she spent years perfecting it.","choices":["Wear many hats","Labor of love","Wave of the future","Watering hole"]},{"term":"Last but not least","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cuối cùng nhưng không kém phần quan trọng.”. Cậu chọn cụm phù hợp nhé.","prompt":"And _____, I'd like to thank all the volunteers for their hard work.","choices":["Last but not least","Chew someone out","Chewing the fat","Chew something over"]},{"term":"last straw","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giọt nước tràn ly, điều cuối cùng khiến sự chịu đựng bùng nổ.”. Cậu chọn cụm phù hợp nhé.","prompt":"When he arrived two hours late again, it was the _____ and she fired him.","choices":["Wet blanket","Well-heeled","Wet behind the ears","last straw"]},{"term":"Last-ditch effort","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nỗ lực cuối cùng, cố gắng vớt vát.”. Cậu chọn cụm phù hợp nhé.","prompt":"In a _____ to save their home, they organized a fundraising event.","choices":["Go to the dogs","Go to town","Last-ditch effort","go under the knife"]},{"term":"Laugh all the way to the bank","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiếm được món hời lớn một cách dễ dàng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Laugh all the way to the bank","In stitches","In seventh heaven","In spades"]},{"term":"Lay an egg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thất bại thảm hại (thường trong biểu diễn hoặc ra mắt).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["New kid on the block","never mind","New York minute","Lay an egg"]},{"term":"Lay down the law","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đặt ra luật lệ, ra oai.”. Cậu chọn cụm phù hợp nhé.","prompt":"The boss had to _____ after too many employees started arriving late.","choices":["Bed head","beats me","Bed of roses","Lay down the law"]},{"term":"Lay someone off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sa thải (vì lý do kinh tế, tổ chức lại).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lay someone off","Weasel out of something","wear your heart on your sleeve","Weather the storm"]},{"term":"Lead someone around by the nose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xỏ mũi ai đó, dắt mũi ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Handle someone with kid gloves","Lead someone around by the nose","Hang in there","Hand over fist"]}]},{"id":"idioms-v1-lesson-045","title":"Bài 45","focus":"Thành ngữ từ “learn by heart” đến “Let your hair down”.","questions":[{"term":"learn by heart","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Học thuộc lòng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["get on like a house on fire","learn by heart","Get on one's nerves","Get on one's last nerve"]},{"term":"Learn by rote","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Học vẹt, học thuộc lòng một cách máy móc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Learn by rote","Tighten your belt","tie the knot","tied to mother's apron strings"]},{"term":"Learn one's lesson","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rút ra bài học, chừa đến già.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["make up one's mind","Make tracks","make up for lost time","Learn one's lesson"]},{"term":"Learn the ropes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Học việc, làm quen với công việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"It will take a few weeks for the new intern to _____.","choices":["A penny for your thoughts","A penny saved is a penny earned","A perfect storm","Learn the ropes"]},{"term":"Leave no stone unturned","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thử mọi cách, lật tung mọi thứ.”. Cậu chọn cụm phù hợp nhé.","prompt":"The detectives promised to _____ in their search for the missing girl.","choices":["Gut feeling","Leave no stone unturned","Gung ho","Guinea pig"]},{"term":"Leave someone alone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Để ai đó yên.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pull out all the stops","Leave someone alone","pull someone's chain","Pull rank"]},{"term":"Leave someone high and dry","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ mặc ai đó trong lúc khó khăn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pour money down the drain","Pound the pavement","Leave someone high and dry","Power dressing"]},{"term":"Leave someone in the lurch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ rơi ai đó trong lúc hoạn nạn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["As the crow flies","Leave someone in the lurch","As right as rain","As rare as hen’s teeth"]},{"term":"Leave someone out in the cold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngó lơ ai đó, cho ai đó ra rìa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["home sweet home","Leave someone out in the cold","Hopping mad","Holding the bag"]},{"term":"Leave well enough alone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tránh chữa lợn lành thành lợn què, cứ để yên mọi chuyện.”. Cậu chọn cụm phù hợp nhé.","prompt":"The project is going smoothly, so let's just _____.","choices":["Haste makes waste","Leave well enough alone","Have an axe to grind","Hard sell"]},{"term":"Left behind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ lại phía sau, bỏ rơi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Left behind","Like clockwork","Like a deer in the headlights","Like a chicken with its head cut off"]},{"term":"Lend a hand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giúp đỡ một tay.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go off half-cocked","Go it alone","Lend a hand","Go off the deep end"]},{"term":"Lend an ear","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lắng nghe, chú ý lắng nghe.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lend an ear","Add insult to injury","Against the clock","Add fuel to the fire"]},{"term":"let by-gones be by-gones","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện gì qua hãy để nó qua, bỏ qua chuyện cũ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pull one's weight","pull oneself together","let by-gones be by-gones","Pull it off"]},{"term":"Let bygones be bygones","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hãy để quá khứ ngủ yên, bỏ qua chuyện cũ.”. Cậu chọn cụm phù hợp nhé.","prompt":"After their argument, they decided to _____ and move on.","choices":["Use your loaf","Let bygones be bygones","Veg out","Upset the apple cart"]},{"term":"Let sleeping dogs lie","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng bới bèo ra bọ, để mọi chuyện yên ổn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's not bring up that old argument again; it's better to just _____.","choices":["Off the wall","Let sleeping dogs lie","Off the record","Off the top of my head"]},{"term":"Let someone off the hook","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tha lỗi cho ai đó, giải thoát ai đó khỏi trách nhiệm hoặc rắc rối.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go Dutch","Go fly a kite","Let someone off the hook","Go down like a lead balloon"]},{"term":"Let the cat out of the bag","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô tình để lộ bí mật.”. Cậu chọn cụm phù hợp nhé.","prompt":"Oops, I think I just _____ about her surprise party.","choices":["Let the cat out of the bag","Swallow your pride","Sweating bullets","Sweat blood"]},{"term":"Let the dust settle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chờ cho mọi việc lắng xuống.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's just wait for a while and _____ before making any big decisions.","choices":["Sell someone short","Sell someone out","Sell like hotcakes","Let the dust settle"]},{"term":"Let your hair down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thư giãn, xõa đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"After a long week of work, it's important to just _____ on the weekend.","choices":["Up the creek without a paddle","Up to snuff","Let your hair down","Up in the air"]}]},{"id":"idioms-v1-lesson-046","title":"Bài 46","focus":"Thành ngữ từ “Letter-perfect” đến “Long in the tooth”.","questions":[{"term":"Letter-perfect","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn hảo, không sai một chữ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her presentation was _____ and impressed everyone in the meeting.","choices":["Turn a place upside down","Turn a blind eye","Letter-perfect","Tuckered out"]},{"term":"Like a chicken with its head cut off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lăng xăng, cuống cuồng như gà mắc tóc.”. Cậu chọn cụm phù hợp nhé.","prompt":"He was running around _____, trying to get everything ready for the party.","choices":["by and large","Like a chicken with its head cut off","by all means","Buy something for a song"]},{"term":"Like a deer in the headlights","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chết trân, sững sờ (vì sợ hãi hoặc bất ngờ).”. Cậu chọn cụm phù hợp nhé.","prompt":"Caught off guard by the news, she stood there _____.","choices":["Like a deer in the headlights","Call it a day","call it quits","Call someone on the carpet"]},{"term":"Like clockwork","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đều đặn, trơn tru như một cái máy.”. Cậu chọn cụm phù hợp nhé.","prompt":"The train arrives at the station _____ every morning.","choices":["Sit tight","Sitting pretty","Sitting like a bump on a log","Like clockwork"]},{"term":"like father like son","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cha nào con nấy, hổ phụ sinh hổ tử.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the last minute","The jury is still out","like father like son","The last straw"]},{"term":"Like nailing jello to a wall","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khó như mò kim đáy bể, việc bất khả thi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Getting my toddler to sit still is _____.","choices":["build bridges","Burgers and dogs","Bull in a china shop","Like nailing jello to a wall"]},{"term":"Like pulling teeth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khó khăn, cực nhọc (đặc biệt khi thuyết phục ai).”. Cậu chọn cụm phù hợp nhé.","prompt":"Getting a straight answer from him is _____.","choices":["New kid on the block","never mind","New York minute","Like pulling teeth"]},{"term":"Like riding a bike","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dễ như đi xe đạp, học một lần nhớ mãi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Programming is _____; you'll quickly get back into it.","choices":["Compare apples and oranges","Computer crashed","Like riding a bike","Comfort food"]},{"term":"Like taking candy from a baby","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dễ như ăn kẹo, dễ như trở bàn tay.”. Cậu chọn cụm phù hợp nhé.","prompt":"For a professional chef, making this dish is _____.","choices":["Burn the candle at both ends","Bury one's head in the sand","Like taking candy from a baby","Burn the midnight oil"]},{"term":"Like there's no tomorrow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “(Làm gì đó) như không có ngày mai, hết mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"They were spending money _____ during their vacation.","choices":["Curveball","Cut and dried","Like there's no tomorrow","Curiosity killed the cat"]},{"term":"Like water off a duck's back","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nước đổ đầu vịt.”. Cậu chọn cụm phù hợp nhé.","prompt":"When they make fun of him, it's _____; he doesn't take it to heart.","choices":["For goodness' sake","For heaven's sake","Like water off a duck's back","For the birds"]},{"term":"Live and learn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi một ngày đàng học một sàng khôn, sống qua mới biết.”. Cậu chọn cụm phù hợp nhé.","prompt":"You thought you could fix the car yourself, but it broke down again. _____.","choices":["Sell like hotcakes","See through someone","Live and learn","Sell someone out"]},{"term":"Live and let live","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống và để người khác sống, tôn trọng sự khác biệt.”. Cậu chọn cụm phù hợp nhé.","prompt":"I don't always agree with my neighbors, but I believe in _____.","choices":["Ignorance is bliss","If you play your cards right","In a bind","Live and let live"]},{"term":"Live beyond your means","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiêu xài hoang phí, vung tay quá trán.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you _____, you might end up in serious debt.","choices":["Wine and dine","window shopping","Wild and woolly","Live beyond your means"]},{"term":"Live hand-to-mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống chật vật qua ngày, kiếm đồng nào xào đồng ấy.”. Cậu chọn cụm phù hợp nhé.","prompt":"After losing his job, he had to _____.","choices":["Stretch the truth","Live hand-to-mouth","Stop on a dime","Street-smart"]},{"term":"Live it up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống hết mình, ăn chơi xả láng.”. Cậu chọn cụm phù hợp nhé.","prompt":"After winning the lottery, he decided to _____ and travel the world.","choices":["fresh as a daisy","Live it up","From day one","Freak out"]},{"term":"live paycheck to paycheck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống chật vật qua ngày (lĩnh lương tháng nào tiêu hết tháng đó, không dư dả).”. Cậu chọn cụm phù hợp nhé.","prompt":"With rising rent and inflation, many young workers are forced to _____.","choices":["Spineless","live paycheck to paycheck","Spin doctor","Spitting image"]},{"term":"Living the dream","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống cuộc đời trong mơ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Ever since he moved to Los Angeles to pursue acting, he's been _____.","choices":["cup of tea","Living the dream","Cup of joe","Cry wolf"]},{"term":"Lock, stock, and barrel","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Toàn bộ, không thiếu thứ gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"They sold the business _____ to a new owner.","choices":["In my element","In hot water","In my book","Lock, stock, and barrel"]},{"term":"Long in the tooth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đã có tuổi, già nua.”. Cậu chọn cụm phù hợp nhé.","prompt":"That computer model is getting a bit _____; it's time for an upgrade.","choices":["On the same page","Long in the tooth","on the rocks","On the same wavelength"]}]},{"id":"idioms-v1-lesson-047","title":"Bài 47","focus":"Thành ngữ từ “Long time no see” đến “Make a beeline for”.","questions":[{"term":"Long time no see","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lâu rồi không gặp.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____! How have you been?","choices":["Long time no see","Luck out","Low-hanging fruit","Lost at sea"]},{"term":"Look before you leap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phải suy nghĩ cẩn thận trước khi hành động, cẩn tắc vô áy náy.”. Cậu chọn cụm phù hợp nhé.","prompt":"Before quitting your job, remember to _____.","choices":["Go to the dogs","Go to hell in a handbasket","Go to pieces","Look before you leap"]},{"term":"Look down one's nose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khinh khỉnh, coi thường người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hold your horses","Look down one's nose","Hold out an olive branch","Hold the fort"]},{"term":"look high and low","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tìm kiếm khắp nơi, lùng sục mọi xó xỉnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fits and starts","look high and low","Fix someone's wagon","Five o'clock shadow"]},{"term":"Look like a million bucks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trông rất tuyệt vời, lộng lẫy.”. Cậu chọn cụm phù hợp nhé.","prompt":"You _____ in that dress!","choices":["In a pinch","In charge of","Look like a million bucks","In a rut"]},{"term":"look like death warmed over","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trông như xác chết trôi, phờ phạc rũ rượi.”. Cậu chọn cụm phù hợp nhé.","prompt":"You should go see a doctor; you _____.","choices":["Fork over / Shell out money","look like death warmed over","For the birds","Fortune favors the bold"]},{"term":"Look like the cat that got the cream","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trông vô cùng mãn nguyện, đắc ý.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Look like the cat that got the cream","A lucky break","A loose cannon","A lucky dog"]},{"term":"look on the bright side","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhìn vào mặt tích cực, lạc quan.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____: at least the delay gave us time to finish our homework.","choices":["For the birds","For heaven's sake","For goodness' sake","look on the bright side"]},{"term":"look the other way","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ngơ, quay mặt đi giả vờ không thấy chuyện xấu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Corrupt officials chose to _____ while illegal dumping occurred.","choices":["tell me about it","teacher's pet","look the other way","test the waters"]},{"term":"Lose one's head","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mất bình tĩnh, mất kiểm soát.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lose one's head","a drop in the ocean","A doubting Thomas","a drop in the bucket"]},{"term":"Lose one's marbles","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mất trí, phát điên.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Lose one's marbles","rest on one's laurels","red in the face","red herring"]},{"term":"Lose one's shirt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mất sạch tiền, sạt nghiệp.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Let your hair down","Letter-perfect","Lose one's shirt","Like a chicken with its head cut off"]},{"term":"Lose one's touch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lụt nghề, mất phong độ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Fix someone's wagon","Flavor of the month","Lose one's touch","Fixed in one's ways"]},{"term":"Lose touch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mất liên lạc, mất kết nối.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["every dog has his day","every now and then","every cloud has a silver lining","Lose touch"]},{"term":"Lost at sea","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mất phương hướng, bơ vơ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Without proper guidance, many new employees feel _____ in their first week.","choices":["Hand in glove","Hammer out a deal","Lost at sea","Hand over fist"]},{"term":"Low-hanging fruit","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mục tiêu dễ đạt được, việc dễ xơi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's focus on the _____ before tackling the bigger issues.","choices":["Spineless","Spin doctor","Spitting image","Low-hanging fruit"]},{"term":"Luck out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn may, gặp may mắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A piece of cake","A picture is worth a thousand words","A perfect storm","Luck out"]},{"term":"Mad as a hornet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giận điên người, tức giận sôi máu.”. Cậu chọn cụm phù hợp nhé.","prompt":"He was _____ when he found out someone had scratched his new car.","choices":["Mad as a hornet","run like the wind","run one's mouth off","run out of steam"]},{"term":"Made for each other","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sinh ra là để cho nhau, tâm đầu ý hợp.”. Cậu chọn cụm phù hợp nhé.","prompt":"The way they understand each other makes it clear they are truly _____.","choices":["Do someone a good turn","Made for each other","Do something at the drop of a hat","Do something by the seat of your pants"]},{"term":"Make a beeline for","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi thẳng tới, lao thẳng đến.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Johnny-come-lately","Joined at the hip","Make a beeline for","Josh someone"]}]},{"id":"idioms-v1-lesson-048","title":"Bài 48","focus":"Thành ngữ từ “Make a big stink” đến “make up your mind”.","questions":[{"term":"Make a big stink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ầm lên, phàn nàn rùm beng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Make a big stink","Go against the grain","Give someone the thumbs-up","Give someone/something short shrift"]},{"term":"Make a long story short","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói tóm lại, tóm gọn lại.”. Cậu chọn cụm phù hợp nhé.","prompt":"To _____, we missed the flight but managed to get another one.","choices":["the bottom line","Make a long story short","the boys in blue","the Big Easy"]},{"term":"Make a mountain out of a molehill","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện bé xé ra to.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't _____; it's just a minor mistake.","choices":["Pull one's weight","Make a mountain out of a molehill","pull a rabbit out of one's hat","Pull it off"]},{"term":"Make a pit stop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dừng chân nghỉ ngơi (giữa chuyến đi).”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ at the next gas station for a bathroom break.","choices":["Hold your horses","Make a pit stop","Hold your tongue","Holding the bag"]},{"term":"make a point of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Để tâm, coi trọng và chú ý đặc biệt làm việc gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Brainstorm","make a point of","Boxed in","Bread and butter"]},{"term":"Make a scene","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ầm ĩ (nơi công cộng).”. Cậu chọn cụm phù hợp nhé.","prompt":"Please don’t _____ at the restaurant; let’s talk about it later.","choices":["put a sock in it","put on one's thinking cap","Make a scene","push one's luck"]},{"term":"Make ends meet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiếm đủ sống; xoay xở đủ chi tiêu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Many families struggle to _____ in today’s economy.","choices":["Make ends meet","Get something out of one's system","Get something off one's chest","Get something for peanuts"]},{"term":"Make eyes at someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liếc mắt đưa tình; nhìn đắm đuối.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Make eyes at someone","Square meal","Squeaky clean","Spread yourself too thin"]},{"term":"Make hay while the sun shines","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chớp lấy thời cơ.”. Cậu chọn cụm phù hợp nhé.","prompt":"You should apply for the job now before the position gets filled. _____.","choices":["Give someone the cold shoulder","give someone the brush-off","Make hay while the sun shines","Give someone the benefit of the doubt"]},{"term":"make heads or tails of","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu đầu cua tai nheo gì (thường dùng ở dạng phủ định).”. Cậu chọn cụm phù hợp nhé.","prompt":"I cannot _____ these complicated tax forms.","choices":["make heads or tails of","Look down one's nose","Long time no see","Look before you leap"]},{"term":"Make matters worse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm cho mọi chuyện tồi tệ hơn, họa vô đơn chí.”. Cậu chọn cụm phù hợp nhé.","prompt":"We were caught in the rain, and to _____, the car broke down.","choices":["run out of time","Make matters worse","Run-of-the-mill","run the show"]},{"term":"Make no bones about","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thẳng thắn; không ngần ngại giấu giếm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bomb","Bookworm","Bone of contention","Make no bones about"]},{"term":"Make one's hair stand on end","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dựng tóc gáy, vô cùng sợ hãi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Spread yourself too thin","Make one's hair stand on end","Squeaky clean","Square meal"]},{"term":"Make out like a bandit","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trúng quả đậm; kiếm được bộn tiền.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the early bird gets the worm","the eleventh hour","the elephant in the room","Make out like a bandit"]},{"term":"Make out what someone says","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe rõ; hiểu được lời ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Make out what someone says","Bet the ranch","Between a rock and a hard place","Better late than never"]},{"term":"Make the grade","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đạt tiêu chuẩn; đủ điều kiện.”. Cậu chọn cụm phù hợp nhé.","prompt":"She studied hard to _____ in her final exams.","choices":["On the same page","on the rocks","On the same wavelength","Make the grade"]},{"term":"Make tracks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rời đi gấp gáp; chuồn nhanh.”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ if we want to catch the last train.","choices":["Make tracks","Learn by rote","Lead someone around by the nose","learn by heart"]},{"term":"make up for lost time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bù đắp lại khoảng thời gian đã mất.”. Cậu chọn cụm phù hợp nhé.","prompt":"Having not seen each other for years, the childhood friends talked all night to _____.","choices":["The whole nine yards","make up for lost time","The whole ball of wax","The tip of the iceberg"]},{"term":"make up one's mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quyết định, đưa ra lựa chọn dứt khoát.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Grease monkey","Gray area","make up one's mind","Gravy train"]},{"term":"make up your mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đưa ra quyết định, dứt khoát quyết định.”. Cậu chọn cụm phù hợp nhé.","prompt":"You need to _____ about which university course to attend.","choices":["make up your mind","shop till you drop","Shot in the arm","Shot in the dark"]}]},{"id":"idioms-v1-lesson-049","title":"Bài 49","focus":"Thành ngữ từ “Make waves” đến “More than one bargained for”.","questions":[{"term":"Make waves","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gây sóng gió; tạo sự chú ý.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go through something with a fine-tooth comb","Go to hell in a handbasket","Go to pieces","Make waves"]},{"term":"Make yourself at home","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cứ tự nhiên như ở nhà nhé.”. Cậu chọn cụm phù hợp nhé.","prompt":"Please, _____. There’s no need to be formal.","choices":["Make yourself at home","Be loaded","Be my guest","Be close-fisted"]},{"term":"Man's best friend","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người bạn tốt nhất của con người (thường chỉ chó).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bed of roses","Behind someone’s back","Man's best friend","Before you know it"]},{"term":"Mark time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dậm chân tại chỗ; chờ thời.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["climb the corporate ladder","Mark time","Climb the walls","Close but no cigar"]},{"term":"match made in heaven","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cặp đôi trời sinh, sự kết hợp hoàn hảo.”. Cậu chọn cụm phù hợp nhé.","prompt":"They share identical values and hobbies; they are truly a _____.","choices":["Party animal","Par for the course","Pass the buck","match made in heaven"]},{"term":"Meat and potatoes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phần cốt lõi; phần cơ bản và quan trọng nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"The _____ of the project involve data analysis and reporting.","choices":["Meat and potatoes","Make one's hair stand on end","Make no bones about","Make out like a bandit"]},{"term":"Meet halfway","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thỏa hiệp; nhượng bộ nhau.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s _____ on this issue and find a solution that works for both of us.","choices":["X marks the spot","wrap your head around","Meet halfway","You bet"]},{"term":"Mickey Mouse job","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Công việc nhàn hạ, lặt vặt (không quan trọng).”. Cậu chọn cụm phù hợp nhé.","prompt":"I don’t want a _____; I want something with real responsibility.","choices":["Carry a torch for someone","Mickey Mouse job","Carry the ball","cash cow"]},{"term":"Midas touch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bàn tay vàng (khả năng làm đâu thắng đó).”. Cậu chọn cụm phù hợp nhé.","prompt":"He seems to have the _____; every business he starts becomes a success.","choices":["draw a blank","dressed to kill","drawing card","Midas touch"]},{"term":"Middle of the road","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ở mức trung bình; không có gì nổi trội.”. Cậu chọn cụm phù hợp nhé.","prompt":"The band’s new album is pretty _____; it’s okay, but nothing special.","choices":["Go up in smoke","go under the knife","Middle of the road","Go with the flow"]},{"term":"Mind your own beeswax","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lo chuyện của mình đi; đừng chúi mũi vào chuyện người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["No dice","Nix something","Mind your own beeswax","No big deal"]},{"term":"Miss the boat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ lỡ cơ hội.”. Cậu chọn cụm phù hợp nhé.","prompt":"If we don’t act now, we might _____ on this great deal.","choices":["Until the cows come home","under the weather","Under the wire","Miss the boat"]},{"term":"Mom-and-pop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “(Cửa hàng) kinh doanh nhỏ lẻ theo hộ gia đình.”. Cậu chọn cụm phù hợp nhé.","prompt":"They decided to open a _____ grocery store in their neighborhood.","choices":["Greased lightning","Mom-and-pop","Green around the gills","Great minds think alike"]},{"term":"Money burns a hole in someone's pocket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có tiền là tiêu liền; không giữ được tiền.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["be the talk of the town","Money burns a hole in someone's pocket","Be named after","Be out of the question"]},{"term":"money doesn't grow on trees","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiền bạc không phải là vỏ hến (tiền không tự nhiên sinh ra trên cây).”. Cậu chọn cụm phù hợp nhé.","prompt":"Stop wasting your allowance on useless gadgets; _____!","choices":["money doesn't grow on trees","Actions Speak Louder Than Words","Across the board","action speaks louder than words"]},{"term":"Money talks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đồng tiền có sức mạnh; có tiền mua tiên cũng được.”. Cậu chọn cụm phù hợp nhé.","prompt":"When it comes to getting things done, _____.","choices":["Give someone the cold shoulder","Give someone the benefit of the doubt","give someone the brush-off","Money talks"]},{"term":"Money to burn","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiền xài không hết; rủng rỉnh tiền bạc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Ever since he won the lottery, he’s had _____.","choices":["Doesn't know beans about it","Dog and pony show","Dog days of summer","Money to burn"]},{"term":"More bang for your buck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đáng đồng tiền bát gạo.”. Cậu chọn cụm phù hợp nhé.","prompt":"This restaurant gives you _____ compared to others in the area.","choices":["More bang for your buck","Get one's goat","Get one's feet wet","Get one's hackles up"]},{"term":"More than meets the eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phức tạp hơn vẻ bề ngoài; ẩn chứa nhiều điều bên trong.”. Cậu chọn cụm phù hợp nhé.","prompt":"The case seems simple, but there’s _____.","choices":["More than meets the eye","Bring one's A game","bring to light","Bring up"]},{"term":"More than one bargained for","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nằm ngoài dự kiến; rắc rối hơn dự tính.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["More than one bargained for","Armed to the teeth","Armchair quarterback","Are you kidding me?"]}]},{"id":"idioms-v1-lesson-050","title":"Bài 50","focus":"Thành ngữ từ “mother nature” đến “No-brainer”.","questions":[{"term":"mother nature","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mẹ thiên nhiên, mẹ tạo hóa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Human beings must learn to respect _____ before climate change gets worse.","choices":["run amok","mother nature","rule the roost","rule of thumb"]},{"term":"Move some things around","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thay đổi lịch trình; sắp xếp lại kế hoạch.”. Cậu chọn cụm phù hợp nhé.","prompt":"I need to _____ to fit in the meeting tomorrow.","choices":["Get with it","Move some things around","Get your walking papers","Get wind of something"]},{"term":"Mum's the word","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ bí mật nhé.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Treat someone to something","Mum's the word","Troubled waters","True blue"]},{"term":"Mumbo jumbo","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lới nói lảm nhảm; biệt ngữ khó hiểu.”. Cậu chọn cụm phù hợp nhé.","prompt":"All this technical _____ is hard to understand.","choices":["up to you","Upset the apple cart","Up to snuff","Mumbo jumbo"]},{"term":"My bad","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lỗi của tôi.”. Cậu chọn cụm phù hợp nhé.","prompt":"I forgot to bring the tickets. _____.","choices":["Out to lunch","Over my dead body","My bad","Outdo oneself"]},{"term":"Nest egg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khoản tiền tiết kiệm phòng thân.”. Cậu chọn cụm phù hợp nhé.","prompt":"She’s been saving a _____ for her retirement.","choices":["On cloud nine","on edge","Nest egg","On a treadmill"]},{"term":"Never bite the hand that feeds you","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng ăn cháo đá bát; đừng vong ơn bội nghĩa.”. Cậu chọn cụm phù hợp nhé.","prompt":"He lost his job because he didn’t follow the rule: _____.","choices":["Cover a lot of ground","Country mile","Crack a book","Never bite the hand that feeds you"]},{"term":"never mind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng bận tâm, không sao đâu, bỏ qua đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you cannot find my notebook, _____; I have an extra one.","choices":["never mind","Stay in touch","start a family","Start over from scratch"]},{"term":"New kid on the block","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thành viên mới; lính mới.”. Cậu chọn cụm phù hợp nhé.","prompt":"As the _____, she felt a bit overwhelmed at first.","choices":["New kid on the block","cry over spilled milk","Cry wolf","Crunch time"]},{"term":"New York minute","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong chớp mắt; một khoảnh khắc rất ngắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"In a _____, the deal was closed and they were out the door.","choices":["New York minute","Hopping mad","Horse around","Horse of a different color"]},{"term":"Night owl","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cú đêm (người hay thức khuya).”. Cậu chọn cụm phù hợp nhé.","prompt":"I’ve always been a _____, I get my best work done after midnight.","choices":["Stand up for","Stand one's ground","Night owl","Stab someone in the back"]},{"term":"Nip something in the bud","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngăn chặn từ đầu; dập tắt từ trong trứng nước.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep something at bay","Nip something in the bud","Keep someone posted / Keep someone in the loop","Keep something under control"]},{"term":"Nitty-gritty","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điểm mấu chốt; chi tiết cốt lõi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s get down to the _____ of the project and figure out what needs to be done.","choices":["take the wind out of someone's sails","take the plunge","take the floor","Nitty-gritty"]},{"term":"Nix something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hủy bỏ, bác bỏ, từ chối.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Elvis has left the building","Nix something","elevator pitch","eleventh hour"]},{"term":"No big deal","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện nhỏ; không có gì to tát.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t worry about the mistake; it’s _____.","choices":["red herring","No big deal","rest on one's laurels","red in the face"]},{"term":"No dice","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không thành công; vô ích.”. Cậu chọn cụm phù hợp nhé.","prompt":"I asked for a raise, but _____.","choices":["No dice","Keep one's head above water","Keep one's nose clean","Keep one's mouth shut"]},{"term":"No pain, no gain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có làm thì mới có ăn; không đổ mồ hôi, không có thành quả.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you want to get fit, remember: _____.","choices":["Bring down the house","No pain, no gain","Bring home the bacon","Bring one's A game"]},{"term":"No rhyme or reason","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không có lý do gì cả; chẳng có quy luật nào.”. Cậu chọn cụm phù hợp nhé.","prompt":"There is _____ to the way he organizes his desk.","choices":["Born with a silver spoon in one's mouth","Box someone in","No rhyme or reason","Bottom of the barrel"]},{"term":"No skin off one's nose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chẳng ảnh hưởng gì đến tôi cả, tôi không bận tâm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the cat's meow","the boys in blue","No skin off one's nose","the burning question"]},{"term":"No-brainer","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quyết định dễ dàng; chuyện hiển nhiên.”. Cậu chọn cụm phù hợp nhé.","prompt":"Accepting that job offer was a _____ for me.","choices":["In the doghouse","In the chips / In the money","No-brainer","In the heat of the moment"]}]},{"id":"idioms-v1-lesson-051","title":"Bài 51","focus":"Thành ngữ từ “Not a spark of decency” đến “Off-color”.","questions":[{"term":"Not a spark of decency","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bất lịch sự; không có chút ý tứ nào.”. Cậu chọn cụm phù hợp nhé.","prompt":"He shouted at the waiter and showed _____.","choices":["Odd man out","Number cruncher","nuclear family","Not a spark of decency"]},{"term":"Not have a leg to stand on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không có lý lẽ vững chắc; không có bằng chứng, căn cứ để bào chữa hay chứng minh (trong một cuộc tranh luận).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["eat crow","eat like a bird","easy does it","Not have a leg to stand on"]},{"term":"Not one's cup of tea","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không phải sở thích của ai đó; không phải thứ ai đó quan tâm hay thích thú.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wild and woolly","Not one's cup of tea","Who do you think you are?","wicked"]},{"term":"Not playing with a full deck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thiếu thông minh, chập mạch, không bình thường.”. Cậu chọn cụm phù hợp nhé.","prompt":"After hearing his bizarre theory, I started to think he’s _____.","choices":["Not playing with a full deck","An old head on young shoulders","An albatross around my neck","An apple a day keeps the doctor away"]},{"term":"Not rocket science","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chẳng có gì phức tạp cả, không khó hiểu đâu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cut the mustard","Cut to the quick","Not rocket science","Cut to the chase"]},{"term":"Not what it's cracked up to be","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không tốt như lời đồn; không giống như những gì được tâng bốc.”. Cậu chọn cụm phù hợp nhé.","prompt":"The new restaurant is _____; the food was mediocre at best.","choices":["Not what it's cracked up to be","Do something by the seat of your pants","Doesn't hold water","Doesn't know beans about it"]},{"term":"Not worth a red cent","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn toàn vô giá trị; không đáng một xu.”. Cậu chọn cụm phù hợp nhé.","prompt":"This old phone is _____.","choices":["Go postal","Go overboard","Not worth a red cent","Go south"]},{"term":"Nothing to write home about","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình thường, không có gì đặc sắc; không có gì đáng nói.”. Cậu chọn cụm phù hợp nhé.","prompt":"The restaurant was okay, but the food was _____.","choices":["Flavor of the month","Flea market","Nothing to write home about","Fixed in one's ways"]},{"term":"nuclear family","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gia đình hạt nhân (gia đình chỉ gồm cha mẹ và con cái).”. Cậu chọn cụm phù hợp nhé.","prompt":"Modern urban society is largely built around the _____ structure.","choices":["Catch-22","catch you later","Catch the bus","nuclear family"]},{"term":"Number cruncher","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người chuyên làm việc với các con số; chuyên gia xử lý và phân tích dữ liệu số liệu.”. Cậu chọn cụm phù hợp nhé.","prompt":"You need to be a good _____ to excel in a finance career.","choices":["time flies","Tilt at windmills","Time flies when you're having fun","Number cruncher"]},{"term":"Odd man out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người hoặc vật lạc lõng, khác biệt so với phần còn lại của nhóm.”. Cậu chọn cụm phù hợp nhé.","prompt":"He felt like the _____ at the party because he didn't know anyone.","choices":["You're telling me","You catch more flies with honey than with vinegar","You get what you pay for","Odd man out"]},{"term":"off color","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sắc mặt nhợt nhạt, trông có vẻ không được khỏe.”. Cậu chọn cụm phù hợp nhé.","prompt":"You look a bit _____ today; are you coming down with a flu?","choices":["action speaks louder than words","Across the board","Actions Speak Louder Than Words","off color"]},{"term":"Off on the wrong foot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt đầu một cách tồi tệ; có một sự khởi đầu không suôn sẻ (đặc biệt trong một mối quan hệ).”. Cậu chọn cụm phù hợp nhé.","prompt":"They got _____ during their first meeting and have been at odds since.","choices":["run in the family","run its course","run like the wind","Off on the wrong foot"]},{"term":"Off one's rocker","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị điên, dở hơi, mất trí.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Off one's rocker","It is a poor workman who blames his tools","It is always darkest before the dawn","It takes one to know one"]},{"term":"Off the cuff","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tùy cơ ứng biến; nói hoặc làm một việc gì đó tự phát, không có sự chuẩn bị trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Off the cuff","Walk on air","Walk in someone's shoes","Wallflower"]},{"term":"Off the hook","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thoát khỏi trách nhiệm; thoát nạn hoặc không bị trừng phạt vì một lỗi lầm.”. Cậu chọn cụm phù hợp nhé.","prompt":"He thought he would get in trouble for the mistake, but his boss let him _____.","choices":["All bark and no bite","all ears","Off the hook","All bets are off"]},{"term":"Off the record","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không chính thức; giữ kín, không được ghi âm, ghi chép hay công bố.”. Cậu chọn cụm phù hợp nhé.","prompt":"He made it clear that his comments were strictly _____.","choices":["Get one's dander up","Get one's act together","Off the record","Get one's feet wet"]},{"term":"Off the top of my head","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bật ra ngay trong đầu; theo những gì nhớ được ngay lúc này mà không cần suy nghĩ sâu xa hay kiểm tra lại.”. Cậu chọn cụm phù hợp nhé.","prompt":"I can't remember the exact date _____, but it was sometime in June.","choices":["Tongue-in-cheek","Too many irons in the fire","Too big for one's boots","Off the top of my head"]},{"term":"Off the wall","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kỳ quặc, khác thường; điên rồ nhưng đôi khi lại thú vị.”. Cậu chọn cụm phù hợp nhé.","prompt":"His idea for the project was completely _____, but it actually worked!","choices":["run in the family","run its course","Off the wall","run like the wind"]},{"term":"Off-color","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khiếm nhã, thô tục; không phù hợp với chuẩn mực giao tiếp (thường chỉ những trò đùa cợt nhả).”. Cậu chọn cụm phù hợp nhé.","prompt":"He was reprimanded for making an _____ joke in the office.","choices":["Comfort food","come to terms with","Off-color","come to light"]}]},{"id":"idioms-v1-lesson-052","title":"Bài 52","focus":"Thành ngữ từ “Old school” đến “On the same page”.","questions":[{"term":"Old school","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiểu cũ, cổ điển; theo phong cách hoặc giữ những giá trị truyền thống từ thời xưa.”. Cậu chọn cụm phù hợp nhé.","prompt":"My grandfather is really _____; he doesn't trust modern technology.","choices":["Old school","Cross that bridge when one comes to it","Crunch time","cross your fingers"]},{"term":"On a shoestring","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Với ngân sách eo hẹp; làm gì đó với chi phí rất thấp.”. Cậu chọn cụm phù hợp nhé.","prompt":"Starting a business _____ is challenging but possible.","choices":["Make a long story short","Make a big stink","On a shoestring","Make a beeline for"]},{"term":"On a tear","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang trên đà chiến thắng; liên tục đạt được những thành công vang dội trong thời gian ngắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"The team has been _____ lately, winning five games in a row.","choices":["Stuffed shirt","On a tear","Strike it rich","String someone along"]},{"term":"On a treadmill","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm những việc lặp đi lặp lại một cách nhàm chán mà không thấy sự tiến triển; giậm chân tại chỗ.”. Cậu chọn cụm phù hợp nhé.","prompt":"I feel like I'm just _____ with these endless meetings and no real results.","choices":["One's neck of the woods","One's hands are tied","One's eyes are bigger than one's stomach","On a treadmill"]},{"term":"On cloud nine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng hạnh phúc; sung sướng lâng lâng như trên chín tầng mây.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ after receiving the job offer.","choices":["Keep someone posted / Keep someone in the loop","Keep someone posted","Keep something at bay","On cloud nine"]},{"term":"on edge","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bồn chồn lo lắng, đứng ngồi không yên, dễ cáu kỉnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"Everyone in the office has been _____ while waiting for the company restructuring news.","choices":["Carry the ball","Card shark","on edge","Carry a torch for someone"]},{"term":"On pins and needles","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lo lắng, bồn chồn; cảm giác đứng ngồi không yên khi chờ đợi một điều gì đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ waiting for the job interview results.","choices":["Hear it on the grapevine","Heebie-jeebies","On pins and needles","Hear something straight from the horse’s mouth"]},{"term":"On the ball","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhanh nhẹn, nhạy bén; phản ứng nhanh và xử lý tình huống tốt.”. Cậu chọn cụm phù hợp nhé.","prompt":"She caught the mistake in the report right away; she's really _____.","choices":["See through someone","On the ball","Sell someone out","Sell like hotcakes"]},{"term":"On the blink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị hỏng hóc, chập chờn; không hoạt động bình thường (thường dùng cho máy móc).”. Cậu chọn cụm phù hợp nhé.","prompt":"The TV went _____ just before the big game.","choices":["Down in the mouth","Down the tube","down to earth","On the blink"]},{"term":"On the cheap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mua được với giá rẻ; làm việc gì đó với chi phí thấp nhất có thể.”. Cậu chọn cụm phù hợp nhé.","prompt":"They traveled across the country _____ by staying in hostels.","choices":["Know the ropes","On the cheap","Know which way the wind is blowing","Know zip"]},{"term":"On the dot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đúng giờ; chính xác tại một thời điểm đã định, không trễ một phút.”. Cậu chọn cụm phù hợp nhé.","prompt":"The meeting will start at 9 a.m. _____.","choices":["take your time","talk a blue streak","On the dot","talk shop"]},{"term":"On the fence","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang lưỡng lự; chưa đưa ra quyết định hoặc không đứng về phía nào.”. Cậu chọn cụm phù hợp nhé.","prompt":"She's still _____ about which university to attend.","choices":["On the fence","A lucky dog","A memory like a sieve","A penny for your thoughts"]},{"term":"On the fly","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tùy cơ ứng biến; đưa ra quyết định hoặc làm gì đó một cách nhanh chóng ngay tại thời điểm đó mà không có kế hoạch trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"We often have to solve problems _____ at work.","choices":["On the fly","Chow down","Chicken out","Chewing the fat"]},{"term":"On the fritz","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị hỏng hóc, dở chứng; thiết bị không hoạt động bình thường.”. Cậu chọn cụm phù hợp nhé.","prompt":"The coffee machine in the office is _____.","choices":["Well-heeled","Weather the storm","Well begun is half done","On the fritz"]},{"term":"On the house","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Miễn phí; được quán ăn, nhà hàng thiết đãi hoặc tặng (khách hàng không phải trả tiền).”. Cậu chọn cụm phù hợp nhé.","prompt":"The dessert is _____ tonight because it's our anniversary celebration.","choices":["blind as a bat","Blast from the past","Blaze a trail","On the house"]},{"term":"On the level","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trung thực, thẳng thắn; đáng tin cậy và không có ý đồ gian lận.”. Cậu chọn cụm phù hợp nhé.","prompt":"You can trust him; he's _____.","choices":["On the level","Make a beeline for","Made for each other","Mad as a hornet"]},{"term":"On the line","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị đe dọa, gặp rủi ro; đang trong tình thế ngàn cân treo sợi tóc (danh tiếng, sự nghiệp, tính mạng).”. Cậu chọn cụm phù hợp nhé.","prompt":"His job is _____ after the recent mistakes.","choices":["On the line","Knee-jerk reaction","Knock on wood","Knock it off"]},{"term":"on the mend","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang trên đà hồi phục, sức khỏe đang dần tiến triển tốt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Her fever has broken and she is finally _____.","choices":["Get something off one's chest","on the mend","Get rid of","Get something for peanuts"]},{"term":"on the rocks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rạn nứt, đứng trước bờ vực đổ vỡ (hôn nhân, quan hệ, kinh doanh).”. Cậu chọn cụm phù hợp nhé.","prompt":"Their marriage has been _____ for months due to poor communication.","choices":["on the rocks","Deep down","Dead to the world","Dead-end job"]},{"term":"On the same page","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cùng chung quan điểm; hiểu ý nhau và nhất trí về một vấn đề.”. Cậu chọn cụm phù hợp nhé.","prompt":"In order to ensure the project's success, we need to make sure everyone is _____.","choices":["Beside the point","Bestie","On the same page","Beside oneself"]}]},{"id":"idioms-v1-lesson-053","title":"Bài 53","focus":"Thành ngữ từ “On the same wavelength” đến “Out of my hands”.","questions":[{"term":"On the same wavelength","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt đúng tần số; Tâm đầu ý hợp”. Cậu chọn cụm phù hợp nhé.","prompt":"The new manager and I are _____ about the project goals.","choices":["Don't hold your breath","On the same wavelength","Don't know him from Adam","Don't know if I'm coming or going"]},{"term":"On the spot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngay lập tức, tại chỗ; bị đặt vào tình thế phải phản ứng hoặc quyết định ngay.”. Cậu chọn cụm phù hợp nhé.","prompt":"He solved the problem _____ without any help.","choices":["On the spot","Like there's no tomorrow","Like taking candy from a baby","Like riding a bike"]},{"term":"On the spur of the moment","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hành động một cách bốc đồng; quyết định nhất thời, không suy tính trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"We decided to go on a trip _____.","choices":["Computer crashed","Cook the books","On the spur of the moment","Cook someone's goose"]},{"term":"On the up and up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trung thực, đàng hoàng; (hoặc) ngày càng trở nên tốt hơn, đang phát triển theo chiều hướng tốt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Our business is _____ after the new investments.","choices":["Wave of the future","Water under the bridge","Watering hole","On the up and up"]},{"term":"On the warpath","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đang trong cơn thịnh nộ; sẵn sàng gây hấn hoặc trút giận lên người khác.”. Cậu chọn cụm phù hợp nhé.","prompt":"Watch out, the boss is _____ today after the project failed.","choices":["Keep body and soul together","On the warpath","Keep an eye on","keep at bay"]},{"term":"On thin ice","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ở trong tình thế rủi ro, nguy hiểm; như đi trên lớp băng mỏng (chỉ cần một sai lầm nhỏ cũng dẫn đến hậu quả lớn).”. Cậu chọn cụm phù hợp nhé.","prompt":"After missing several deadlines, John is really _____ with his boss.","choices":["Once bitten, twice shy","Once and for all","On top of the world","On thin ice"]},{"term":"On top of the world","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ hạnh phúc; cảm thấy như đang đứng trên đỉnh vinh quang.”. Cậu chọn cụm phù hợp nhé.","prompt":"After getting the job offer, she felt _____.","choices":["Lock, stock, and barrel","On top of the world","Long in the tooth","Long time no see"]},{"term":"Once and for all","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một lần và mãi mãi; giải quyết triệt để vấn đề để không bao giờ phải bận tâm lại.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's settle this _____.","choices":["get on like a house on fire","Get on one's last nerve","Once and for all","Get off scot-free"]},{"term":"Once bitten, twice shy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chim phải đạn sợ cành cong; trở nên cẩn trọng, e dè sau khi đã trải qua một thất bại hoặc tổn thương.”. Cậu chọn cụm phù hợp nhé.","prompt":"After getting scammed online, he is now _____ about shopping on unfamiliar websites.","choices":["Once bitten, twice shy","put our heads together","put one's money where one's mouth is","put one's foot down"]},{"term":"Once in a blue moon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Năm thì mười họa; hiếm khi xảy ra.”. Cậu chọn cụm phù hợp nhé.","prompt":"He only visits us _____, but it's always a great time when he does.","choices":["Once in a blue moon","Make one's hair stand on end","Make matters worse","Make no bones about"]},{"term":"once upon a time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngày xửa ngày xưa.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, there lived a humble woodcutter deep in an ancient enchanted forest.","choices":["pull up stakes","Pull the wool over someone's eyes","once upon a time","pull the rug out from under someone"]},{"term":"One fell swoop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhanh chóng trong một lần duy nhất; giải quyết gọn gàng trong một đợt.”. Cậu chọn cụm phù hợp nhé.","prompt":"The company launched three new products in _____.","choices":["Mickey Mouse job","Meet halfway","Meat and potatoes","One fell swoop"]},{"term":"One-trick pony","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người hoặc vật chỉ có một tài năng, kỹ năng duy nhất; người chỉ giỏi một thứ mà không có sự linh hoạt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Some critics say that he's just a _____, only good at drama roles.","choices":["One-trick pony","take something in stride","Take something with a grain of salt","take the cake"]},{"term":"One's eyes are bigger than one's stomach","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “No bụng đói con mắt.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bear in mind/keep in mind","One's eyes are bigger than one's stomach","Beat a hasty retreat","bear in mind"]},{"term":"One's hands are tied","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bó tay; không thể làm gì được.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["feel the pinch","One's hands are tied","feel like a million dollars","feel blue"]},{"term":"One's neck of the woods","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khu vực ai đó sinh sống.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Labor of love","Last but not least","One's neck of the woods","last straw"]},{"term":"Open a can of worms","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rước họa vào thân; gây ra những rắc rối mới phức tạp khi cố giải quyết một vấn đề.”. Cậu chọn cụm phù hợp nhé.","prompt":"Changing the project scope right now would _____.","choices":["Open a can of worms","Happy-go-lucky","Hard pill to swallow","hard nut to crack"]},{"term":"Out of date","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lỗi thời, cũ rích; không còn theo kịp xu hướng hoặc không còn được áp dụng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Using paper maps is pretty _____ now that we have GPS.","choices":["Go haywire","Out of date","Go fry an egg","Go it alone"]},{"term":"Out of left field","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bất thình lình, bất ngờ; đến từ nơi không ai lường trước được.”. Cậu chọn cụm phù hợp nhé.","prompt":"The new policy was completely _____ and surprised everyone.","choices":["Out of left field","Street-smart","Stretch the truth","Stop on a dime"]},{"term":"Out of my hands","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nằm ngoài tầm kiểm soát; không thuộc quyền quyết định hay trách nhiệm của mình nữa.”. Cậu chọn cụm phù hợp nhé.","prompt":"The decision is _____; it's up to the management now.","choices":["Get a taste of one's own medicine","Get a second wind","Get a word in edgewise","Out of my hands"]}]},{"id":"idioms-v1-lesson-054","title":"Bài 54","focus":"Thành ngữ từ “Out of order” đến “Pandora’s box”.","questions":[{"term":"Out of order","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị hỏng, trục trặc (máy móc); hoặc cư xử không đúng mực.”. Cậu chọn cụm phù hợp nhé.","prompt":"The elevator is _____, so you'll have to take the stairs.","choices":["Go overboard","Go south","Go postal","Out of order"]},{"term":"out of shape","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thân hình mất cân đối, thể lực kém (do lười vận động).”. Cậu chọn cụm phù hợp nhé.","prompt":"I got winded climbing just two flights of stairs—I am really _____.","choices":["out of shape","Spitting image","Splitting hairs","Spineless"]},{"term":"out of sorts","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khó ở, cảm thấy không khỏe hoặc ủ rũ khó chịu.”. Cậu chọn cụm phù hợp nhé.","prompt":"He has been _____ all morning because he did not get enough sleep.","choices":["Give someone the benefit of the doubt","Give someone the cold shoulder","out of sorts","give someone the brush-off"]},{"term":"Out of the blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bất thình lình; hoàn toàn bất ngờ mà không có dấu hiệu báo trước.”. Cậu chọn cụm phù hợp nhé.","prompt":"He called me _____ after five years of no contact.","choices":["get the hang of","Get the green light","Get the go-ahead","Out of the blue"]},{"term":"Out of the frying pan and into the fire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tránh vỏ dưa gặp vỏ dừa; thoát khỏi một hoàn cảnh khó khăn này lại rơi vào một hoàn cảnh tồi tệ hơn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Leaving the bad restaurant, we ended up in a place even worse. Talk about _____.","choices":["Leave well enough alone","Out of the frying pan and into the fire","Leave someone out in the cold","Leave someone in the lurch"]},{"term":"Out of the question","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không thể được, không đáng bàn tới.”. Cậu chọn cụm phù hợp nhé.","prompt":"Traveling abroad this year is _____ given our budget.","choices":["Out of the question","Blow someone away","Blow smoke","Blue blood"]},{"term":"Out of the woods","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thoát khỏi nguy hiểm, qua cơn nguy kịch.”. Cậu chọn cụm phù hợp nhé.","prompt":"After months of treatment, the doctors finally said he was _____.","choices":["Crack someone up","Crack open a cold one","Crack a book","Out of the woods"]},{"term":"Out of this world","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tuyệt vời ông mặt trời, xuất sắc.”. Cậu chọn cụm phù hợp nhé.","prompt":"The food at that restaurant is _____.","choices":["Pitch in","Pipe dream","Pitch dark","Out of this world"]},{"term":"Out on the town","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi chơi đêm, ăn chơi xả láng trên phố.”. Cậu chọn cụm phù hợp nhé.","prompt":"We’re going _____ to celebrate my birthday tonight.","choices":["Out on the town","Half a mind to do something","Hair of the dog","Hair’s breadth"]},{"term":"Out to lunch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mơ màng, mất tập trung, đầu óc trên mây.”. Cậu chọn cụm phù hợp nhé.","prompt":"During the meeting, he seemed completely _____.","choices":["Heads-up","Out to lunch","Head over heels","Head in the clouds"]},{"term":"Outdo oneself","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt lên chính mình, làm tốt hơn mong đợi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Beat the band","Beat the bushes","beat the clock","Outdo oneself"]},{"term":"Over my dead body","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bước qua xác tôi trước đã, không bao giờ.”. Cậu chọn cụm phù hợp nhé.","prompt":"You want to drop out of school? _____.","choices":["Hand over fist","Handle someone with kid gloves","Over my dead body","Hand in glove"]},{"term":"over the moon","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vui sướng tột cùng, ngập tràn hạnh phúc.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ when she found out she had won the scholarship.","choices":["over the moon","on the mend","On the line","on the rocks"]},{"term":"Packed like sardines","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chật như nêm, đông nghẹt.”. Cậu chọn cụm phù hợp nhé.","prompt":"The subway was _____ during rush hour.","choices":["Packed like sardines","Ace up the sleeve","Absentminded","Ace in the hole"]},{"term":"Paddle your own canoe","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tự lực cánh sinh, tự đứng trên đôi chân của mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bull in a china shop","build bridges","Paddle your own canoe","Burgers and dogs"]},{"term":"Pain in the neck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cái gai trong mắt, thứ phiền toái.”. Cậu chọn cụm phù hợp nhé.","prompt":"Filling out all this paperwork is a _____.","choices":["Done to a turn","Pain in the neck","Don't want to hear that","Don't throw the baby out with the bath water"]},{"term":"Paint the town red","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi quẩy tưng bừng, ăn chơi xả láng.”. Cậu chọn cụm phù hợp nhé.","prompt":"After finishing the project, they decided to _____ to celebrate.","choices":["Paint the town red","Cool as a cucumber","Cook the books","Cook up"]},{"term":"Paint you a picture","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Miêu tả chi tiết, vẽ nên viễn cảnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let me _____ of what happened at the party last night.","choices":["Hold out an olive branch","hold ground","Hold one's own","Paint you a picture"]},{"term":"pale as a ghost","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mặt mày tái mét như ma (do quá sợ hãi, sốc hoặc ốm nặng).”. Cậu chọn cụm phù hợp nhé.","prompt":"When he heard the shocking news, his face turned as _____.","choices":["pale as a ghost","Lose one's shirt","Lose one's marbles","Lose one's head"]},{"term":"Pandora’s box","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chiếc hộp Pandora, nguồn gốc của rắc rối.”. Cậu chọn cụm phù hợp nhé.","prompt":"Opening that old argument is like opening _____; it will only lead to more trouble.","choices":["By word of mouth","Pandora’s box","Call a spade a spade","By the skin of ones teeth"]}]},{"id":"idioms-v1-lesson-055","title":"Bài 55","focus":"Thành ngữ từ “Par for the course” đến “Pigheaded”.","questions":[{"term":"Par for the course","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện bình thường, đúng như dự đoán.”. Cậu chọn cụm phù hợp nhé.","prompt":"Traffic jams are _____ during rush hour in the city.","choices":["Don't count your chickens before they hatch","Don't cry over spilt milk","Par for the course","Don't do anything I wouldn't do"]},{"term":"Party animal","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người nghiện tiệc tùng, dân quẩy.”. Cậu chọn cụm phù hợp nhé.","prompt":"John is such a _____; he’s out every weekend.","choices":["Party animal","Have hell to pay","Have bigger fish to fry","have egg on one's face"]},{"term":"Pass the buck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đùn đẩy trách nhiệm.”. Cậu chọn cụm phù hợp nhé.","prompt":"The manager was known to _____ whenever something went wrong.","choices":["Pass the buck","Wash one's hands of something","Waste not, want not","Watch out for"]},{"term":"Pass the course","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt qua khóa học, thi đậu.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pass the course","A snowball’s chance in hell","A smart cookie","A snowball effect"]},{"term":"pass with flying colors","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đậu xuất sắc, vượt qua kỳ thi với kết quả rực rỡ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["wear your heart on your sleeve","Weather the storm","Weasel out of something","pass with flying colors"]},{"term":"Pay a pretty penny","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trả một khoản tiền lớn, tốn kha khá tiền.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Give someone a run for their money","Pay a pretty penny","Give someone a song and dance","Give someone a piece of one's mind"]},{"term":"Pay an arm and a leg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trả một cái giá cắt cổ, tốn rất nhiều tiền.”. Cậu chọn cụm phù hợp nhé.","prompt":"He had to _____ for that rare book.","choices":["teacher's pet","tar someone with the same brush","tall order","Pay an arm and a leg"]},{"term":"Pay the piper","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gánh chịu hậu quả, trả giá.”. Cậu chọn cụm phù hợp nhé.","prompt":"After years of ignoring his health, he had to _____ with a long hospital stay.","choices":["Get a move on","Pay the piper","get a grip","Get a handle on something"]},{"term":"Pay through the nose","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị chặt chém, phải trả giá trên trời.”. Cậu chọn cụm phù hợp nhé.","prompt":"We had to _____ for those concert tickets.","choices":["A picture is worth a thousand words","Pay through the nose","A perfect storm","A piece of cake"]},{"term":"peanut gallery","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hàng ghế khán giả nhiều chuyện, những kẻ chõ mồm bình phẩm vô bổ.”. Cậu chọn cụm phù hợp nhé.","prompt":"I do not need any unsolicited advice from the _____ while I am fixing this engine.","choices":["Too many irons in the fire","Top dog","Top-notch","peanut gallery"]},{"term":"Pedal to the metal","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tăng tốc tối đa, nỗ lực hết mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to put the _____ to meet the deadline.","choices":["Brainstorm","Boxed in","Bread and butter","Pedal to the metal"]},{"term":"Peg out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lăn ra chết, kiệt sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Don't count your chickens before they hatch","Dollars to doughnuts","Don't beat a dead horse","Peg out"]},{"term":"Pencil pusher","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhân viên bàn giấy, người làm công việc giấy tờ nhàm chán.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s just a _____ who files reports all day.","choices":["Pencil pusher","I can't imagine","I suck at something","I don't have two nickels to rub together"]},{"term":"People in glass houses shouldn't throw stones","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chó chê mèo lắm lông; Đừng chỉ trích người khác khi mình cũng có lỗi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["keep at bay","Keep an eye on","People in glass houses shouldn't throw stones","Just now"]},{"term":"Peter out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giảm dần rồi mất hẳn, đuối dần.”. Cậu chọn cụm phù hợp nhé.","prompt":"The excitement over the new game began to _____ after a few weeks.","choices":["Peter out","Pound the pavement","Power dressing","pour money down the drain"]},{"term":"Pick up the tab","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trả tiền hóa đơn, bao (ăn uống).”. Cậu chọn cụm phù hợp nhé.","prompt":"I will _____ for dinner tonight.","choices":["Pick up the tab","tall order","talk turkey","talk to the hand"]},{"term":"picture of health","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người trông vô cùng khỏe khoắn, tràn đầy sinh lực.”. Cậu chọn cụm phù hợp nhé.","prompt":"At the age of eighty, he exercises daily and is the very _____.","choices":["keep your chin up","Keep up with the Joneses","picture of health","Keyed up"]},{"term":"Pie in the sky","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Viển vông, hão huyền.”. Cậu chọn cụm phù hợp nhé.","prompt":"His dream of becoming a movie star seems like a _____.","choices":["As easy as ABC","As easy as pie","As genuine as a three-dollar bill","Pie in the sky"]},{"term":"Pig out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn thùng uống vại, ăn thỏa thích.”. Cậu chọn cụm phù hợp nhé.","prompt":"We decided to _____ on pizza at the party.","choices":["in the blink of an eye","In the bag","Pig out","In the black"]},{"term":"Pigheaded","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cứng đầu, ngoan cố.”. Cậu chọn cụm phù hợp nhé.","prompt":"He’s so _____ that he refused to listen to anyone’s suggestions.","choices":["Crickets","Pigheaded","Crank out","Cream of the crop"]}]},{"id":"idioms-v1-lesson-056","title":"Bài 56","focus":"Thành ngữ từ “Pipe down” đến “Pride comes before a fall”.","questions":[{"term":"Pipe down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Im lặng, trật tự đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Can you two please _____? I’m trying to concentrate.","choices":["Pipe down","Turn the tables","Turn the other cheek","Turn up the heat"]},{"term":"Pipe dream","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mộng tưởng hão huyền, giấc mơ viển vông.”. Cậu chọn cụm phù hợp nhé.","prompt":"Thinking you can become a billionaire overnight is a _____.","choices":["Blackball someone","Blast from the past","Black-and-white","Pipe dream"]},{"term":"Pitch dark","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tối đen như mực.”. Cậu chọn cụm phù hợp nhé.","prompt":"It was _____ outside, so we could barely see anything.","choices":["Pitch dark","Food for thought","Fool's gold","Fool around"]},{"term":"Pitch in","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cùng xắn tay vào làm, góp sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s all _____ and clean up the park.","choices":["Pitch in","For heaven's sake","For crying out loud","For goodness' sake"]},{"term":"Play catch-up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cố gắng đuổi kịp, bù đắp thời gian”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Time is money","time will tell","Play catch-up","Time flies when you're having fun"]},{"term":"Play devil’s advocate","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đóng vai ác, người phản biện.”. Cậu chọn cụm phù hợp nhé.","prompt":"I’ll _____ and argue that we should consider other options.","choices":["Achilles’ heel","Play devil’s advocate","Acid test","Ace up the sleeve"]},{"term":"Play dumb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giả ngu, giả vờ không biết.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don’t _____ with me; I know you saw everything.","choices":["As white as a sheet/as white as a ghost","At best","Play dumb","At least"]},{"term":"Play hardball","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dùng biện pháp mạnh, chơi rắn.”. Cậu chọn cụm phù hợp nhé.","prompt":"The company decided to _____ in the negotiations to get better terms.","choices":["eat one's heart out","egg on one's face","Play hardball","eat one's hat"]},{"term":"Play it by ear","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tùy cơ ứng biến.”. Cậu chọn cụm phù hợp nhé.","prompt":"We don’t have a strict itinerary for the trip; we’ll just _____.","choices":["Play it by ear","take for granted","take a turn for the worse","take a stand"]},{"term":"Play second fiddle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đóng vai phụ, ở vị thế thấp hơn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["call it quits","Play second fiddle","Call a spade a spade","Call it a day"]},{"term":"Play with fire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đùa với lửa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["that ship has sailed","that is to say","that's all she wrote","Play with fire"]},{"term":"Poker face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khuôn mặt lạnh tanh, không bộc lộ cảm xúc.”. Cậu chọn cụm phù hợp nhé.","prompt":"She maintained a perfect _____ throughout the negotiations.","choices":["Never bite the hand that feeds you","Nest egg","Poker face","never mind"]},{"term":"Pony up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Móc hầu bao, thanh toán.”. Cậu chọn cụm phù hợp nhé.","prompt":"It's time for everyone to _____ and pay their share of the meal.","choices":["the bottom line","the Big Easy","Pony up","the boys in blue"]},{"term":"Pound the pavement","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rảo bước tìm việc, đi bộ khắp nơi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pound the pavement","A walk in the park","a wet blanket","A toss-up"]},{"term":"pour money down the drain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ném tiền qua cửa sổ, phung phí tiền bạc vô ích.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pour money down the drain","Get to the bottom of something","Get up on the wrong side of the bed","Get to the point"]},{"term":"Power dressing","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trang phục quyền lực, ăn mặc thể hiện uy quyền.”. Cậu chọn cụm phù hợp nhé.","prompt":"She believes in _____ to make a strong impression during business meetings.","choices":["Be my guest","Power dressing","Be loaded","Be named after"]},{"term":"practice makes perfect","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có công mài sắt có ngày nên kim; luyện tập tạo nên sự hoàn hảo.”. Cậu chọn cụm phù hợp nhé.","prompt":"Do not get discouraged by early mistakes; remember that _____.","choices":["Off on the wrong foot","practice makes perfect","off color","Off one's rocker"]},{"term":"Prick up your ears","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dỏng tai lên nghe.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["The shoe is on the other foot","The school of hard knocks","Prick up your ears","The short end of the stick"]},{"term":"pride and joy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Niềm tự hào và nguồn vui lớn nhất.”. Cậu chọn cụm phù hợp nhé.","prompt":"That restored vintage sports car is his absolute _____.","choices":["Five o'clock shadow","Fix someone's wagon","pride and joy","Fits and starts"]},{"term":"Pride comes before a fall","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trèo cao ngã đau.”. Cậu chọn cụm phù hợp nhé.","prompt":"He boasted about winning the game, but _____ - he ended up losing badly.","choices":["A scorcher","Pride comes before a fall","A screw loose","A screwup"]}]},{"id":"idioms-v1-lesson-057","title":"Bài 57","focus":"Thành ngữ từ “pull a rabbit out of one's hat” đến “put one's finger on it”.","questions":[{"term":"pull a rabbit out of one's hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bất ngờ tìm ra giải pháp, làm chuyện không tưởng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["down to earth","down to the wire","pull a rabbit out of one's hat","Down the tube"]},{"term":"Pull it off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hoàn thành xuất sắc, làm được chuyện khó nhằn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite all the challenges, they managed to _____ and win the championship.","choices":["Dead in the water","Dead from the neck up","day in day out","Pull it off"]},{"term":"Pull one's weight","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm tròn bổn phận, làm phần việc của mình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["New York minute","Nip something in the bud","Night owl","Pull one's weight"]},{"term":"pull oneself together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình tĩnh lại, kiềm chế cảm xúc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Beat around the bush","Beat someone to the draw","pull oneself together","Beat someone to the punch"]},{"term":"Pull out all the stops","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nỗ lực hết mình, làm mọi cách.”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ to finish this project on time.","choices":["Get into deep water","Get off one's high horse","Pull out all the stops","Get off on the wrong foot"]},{"term":"Pull rank","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cậy quyền thế, lấy quyền ép người.”. Cậu chọn cụm phù hợp nhé.","prompt":"He always tries to _____ to get his way in the office.","choices":["By word of mouth","Pull rank","By the skin of ones teeth","By the book"]},{"term":"pull someone's chain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trêu chọc, đùa cợt ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pull someone's chain","match made in heaven","Meet halfway","Meat and potatoes"]},{"term":"pull someone's leg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trêu đùa, nói giỡn với ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pull someone's leg","zip it","zero tolerance","9-to-5"]},{"term":"Pull someone’s leg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trêu chọc, nói đùa.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["It is a poor workman who blames his tools","It is always darkest before the dawn","Pull someone’s leg","It ain't over till the fat lady sings"]},{"term":"Pull strings","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giật dây, dùng các mối quan hệ (để có lợi thế).”. Cậu chọn cụm phù hợp nhé.","prompt":"She managed to _____ and get her son into that prestigious school.","choices":["Cock-and-bull story","Coin a new term","Coin a phrase","Pull strings"]},{"term":"Pull the plug","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rút phích cắm, chấm dứt dự án.”. Cậu chọn cụm phù hợp nhé.","prompt":"After years of poor sales, the company decided to _____ on the project.","choices":["Whitewash","White lie","Who asked you?","Pull the plug"]},{"term":"pull the rug out from under someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đột ngột ngừng hỗ trợ, hất cẳng ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["pull the rug out from under someone","Follow up on something","Follow the money","Food for thought"]},{"term":"Pull the wool over someone's eyes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Che mắt, qua mặt ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Heebie-jeebies","Hear something straight from the horse’s mouth","Pull the wool over someone's eyes","Hear it on the grapevine"]},{"term":"pull up stakes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rời đi, chuyển chỗ ở”. Cậu chọn cụm phù hợp nhé.","prompt":"After living in the city for ten years, they decided it was time to _____ and move to the countryside.","choices":["Learn one's lesson","learn by heart","pull up stakes","Learn by rote"]},{"term":"pull your weight","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm tròn trách nhiệm, gánh vác phần việc của mình trong nhóm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["On thin ice","pull your weight","Once and for all","On top of the world"]},{"term":"puppy love","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình yêu tuổi học trò, tình cảm bồng bột”. Cậu chọn cụm phù hợp nhé.","prompt":"Their relationship in high school was just _____, but it felt very real at the time.","choices":["On the warpath","puppy love","On the up and up","On the spur of the moment"]},{"term":"push one's luck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm tới, đòi hỏi quá đáng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Back to the drawing board","Back to basics","push one's luck","Back to square one"]},{"term":"put a sock in it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Im miệng đi, bớt nói lại”. Cậu chọn cụm phù hợp nhé.","prompt":"Hey, _____! We’re trying to watch the movie.","choices":["learn by heart","put a sock in it","Lead someone around by the nose","Learn by rote"]},{"term":"put on one's thinking cap","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tập trung suy nghĩ, vắt óc suy nghĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put on one's thinking cap","Luck out","Lost at sea","Low-hanging fruit"]},{"term":"put one's finger on it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chỉ ra chính xác (vấn đề, nguyên nhân)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Show of hands","Sick as a dog","put one's finger on it","Shot in the dark"]}]},{"id":"idioms-v1-lesson-058","title":"Bài 58","focus":"Thành ngữ từ “put one's foot down” đến “red flag”.","questions":[{"term":"put one's foot down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiên quyết phản đối, tỏ thái độ dứt khoát”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put one's foot down","Beat someone to the draw","Beat the band","Beat someone to the punch"]},{"term":"put one's money where one's mouth is","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói đi đôi với làm (nhất là bằng tiền bạc)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Splitting hairs","put one's money where one's mouth is","Spread yourself too thin","Spitting image"]},{"term":"put our heads together","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cùng nhau suy nghĩ, hội ý”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ to come up with a solution for this issue.","choices":["Calm before the storm","Call the shots","Call someones bluff","put our heads together"]},{"term":"put someone in their place","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cho ai đó biết thân biết phận”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Watch out for","put someone in their place","Waste not, want not","Water under the bridge"]},{"term":"put someone on the spot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đưa ai vào thế khó, làm ai bối rối”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Jump on the bandwagon","Jump the gun","put someone on the spot","Jump through hoops"]},{"term":"put something down in black and white","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Viết giấy trắng mực đen, ghi chép rõ ràng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put something down in black and white","For heaven's sake","For crying out loud","For goodness' sake"]},{"term":"put something into practice","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đưa vào thực tiễn, áp dụng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put something into practice","Let someone off the hook","Let sleeping dogs lie","Let bygones be bygones"]},{"term":"put something on ice","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trì hoãn, đóng băng kế hoạch”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put something on the back burner","put something on ice","put the screws on someone","put something into practice"]},{"term":"put something on the back burner","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tạm gác lại, để giải quyết sau”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["down to the wire","put something on the back burner","Down the tube","down to earth"]},{"term":"put the screws on someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gây áp lực, ép buộc ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Jump the gun","Jump on the bandwagon","put the screws on someone","jump for joy"]},{"term":"put your thinking cap on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Động não, tập trung suy nghĩ kỹ càng.”. Cậu chọn cụm phù hợp nhé.","prompt":"We need a fresh marketing campaign, so _____ and give me some ideas.","choices":["Off on the wrong foot","off color","put your thinking cap on","Odd man out"]},{"term":"quality time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khoảng thời gian ý nghĩa bên nhau”. Cậu chọn cụm phù hợp nhé.","prompt":"We decided to spend some _____ together this weekend to strengthen our relationship.","choices":["quality time","Good riddance","Good egg","Good for you!"]},{"term":"rack one's brain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vắt óc suy nghĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["rack one's brain","Go back to the drawing board","Go around in circles","Go against the grain"]},{"term":"Rain cats and dogs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mưa nặng hạt, mưa tầm tã.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Like nailing jello to a wall","Like pulling teeth","Rain cats and dogs","Like riding a bike"]},{"term":"rain on someone's parade","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phá đám, làm cụt hứng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["rain on someone's parade","Stick out like a sore thumb","Stew in your own juices","Stick to your guns"]},{"term":"rain or shine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dù mưa hay nắng, dù có chuyện gì xảy ra”. Cậu chọn cụm phù hợp nhé.","prompt":"The soccer game will take place _____.","choices":["rain or shine","As happy as a clam","As quiet as a mouse","As genuine as a three-dollar bill"]},{"term":"raise Cain","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gây rắc rối, làm ầm ĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"If the boss finds out about the mistake, he’s going to _____.","choices":["raise Cain","A picture is worth a thousand words","A piece of cake","A ray of sunshine"]},{"term":"read between the lines","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu được ẩn ý, đọc được ngụ ý giữa các con chữ.”. Cậu chọn cụm phù hợp nhé.","prompt":"If you _____ of his email, he is clearly planning to resign.","choices":["get a grip","Gain ground","Get a handle on something","read between the lines"]},{"term":"read someone the riot act","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảnh cáo nghiêm khắc, mắng mỏ thậm tệ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["You can't have your cake and eat it too","read someone the riot act","You can say that again","You can lead a horse to water, but you can't make him drink"]},{"term":"red flag","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dấu hiệu cảnh báo, cờ đỏ”. Cậu chọn cụm phù hợp nhé.","prompt":"His sudden change in behavior was a major _____.","choices":["red flag","Beat the bushes","Beat the band","beat the clock"]}]},{"id":"idioms-v1-lesson-059","title":"Bài 59","focus":"Thành ngữ từ “red herring” đến “run its course”.","questions":[{"term":"red herring","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đánh lạc hướng”. Cậu chọn cụm phù hợp nhé.","prompt":"The detective knew the clue was a _____ to divert them from the real crime.","choices":["Prick up your ears","red herring","pride and joy","Pride comes before a fall"]},{"term":"red in the face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đỏ mặt (vì bối rối hoặc tức giận)”. Cậu chọn cụm phù hợp nhé.","prompt":"She got _____ when she realized she had made a mistake in the meeting.","choices":["beat the clock","Beat the band","red in the face","Beat the bushes"]},{"term":"rest on one's laurels","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngủ quên trên chiến thắng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["On the spur of the moment","rest on one's laurels","On the up and up","On the warpath"]},{"term":"right this way","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xin mời đi lối này”. Cậu chọn cụm phù hợp nhé.","prompt":"Welcome to our restaurant. _____, please.","choices":["right this way","A day late and a dollar short","A chip on your shoulder","A chip off the old block"]},{"term":"ring a bell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe quen quen”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go out of one's way","Go on a wild goose chase","ring a bell","Go off the deep end"]},{"term":"rings a bell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nghe quen quen, gợi nhớ đến điều gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"His name _____, but I cannot remember where we first met.","choices":["Get on one's nerves","rings a bell","get on like a house on fire","Get on one's last nerve"]},{"term":"rinky-dink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tầm thường, rẻ tiền, chất lượng kém”. Cậu chọn cụm phù hợp nhé.","prompt":"I can’t believe we stayed at that _____ motel.","choices":["Between the devil and the deep blue sea","Beyond the pale","Big cheese","rinky-dink"]},{"term":"roll in it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ngập trong tiền, giàu nứt đố đổ vách.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Leave well enough alone","Lend a hand","Left behind","roll in it"]},{"term":"roll out the red carpet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đón tiếp nồng hậu, trải thảm đỏ”. Cậu chọn cụm phù hợp nhé.","prompt":"The city decided to _____ for the visiting celebrities.","choices":["Blue blood","roll out the red carpet","Blow smoke","Blow someone away"]},{"term":"rolling in it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giàu nứt đố đổ vách, rất nhiều tiền”. Cậu chọn cụm phù hợp nhé.","prompt":"They must be _____ to afford such a luxurious lifestyle.","choices":["Be beside oneself","rolling in it","Be close-fisted","Be loaded"]},{"term":"Rome wasn't built in a day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Việc lớn không thể làm xong trong một sớm một chiều”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Rome wasn't built in a day","make heads or tails of","Make hay while the sun shines","Make matters worse"]},{"term":"rub elbows with someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giao du, kết giao (với người nổi tiếng, quan trọng)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Come out swinging","rub elbows with someone","come to light","Come rain or shine"]},{"term":"ruffle feathers","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó phật ý, mất lòng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A fork in the road","ruffle feathers","A for effort","A fool and his money are easily parted"]},{"term":"rule of thumb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nguyên tắc theo kinh nghiệm thực tế”. Cậu chọn cụm phù hợp nhé.","prompt":"A good _____ is to save at least 10% of your income.","choices":["rule of thumb","Call someones bluff","Calm before the storm","Call the shots"]},{"term":"rule the roost","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm chủ gia đình, nắm quyền quyết định tối cao trong nhà/nhóm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["get wind of","Get up on the wrong side of the bed","Get wind of something","rule the roost"]},{"term":"run amok","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nổi điên, làm loạn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["If you can't stand the heat, get out of the kitchen","run amok","If I had a nickel for every time something happened","If worst comes to worst"]},{"term":"run circles around someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bỏ xa ai đó, hoàn toàn lấn lướt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Get-up-and-go","Get your walking papers","run circles around someone","Get with it"]},{"term":"run errands","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chạy việc vặt”. Cậu chọn cụm phù hợp nhé.","prompt":"I have to _____ this afternoon, including going to the bank and picking up groceries.","choices":["Go without saying","Go with the flow","run errands","Go up in smoke"]},{"term":"run in the family","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Di truyền trong gia đình, là nét đặc trưng gia truyền.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["run in the family","Five o'clock shadow","Fits and starts","Fix someone's wagon"]},{"term":"run its course","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phát triển tự nhiên đến hồi kết thúc”. Cậu chọn cụm phù hợp nhé.","prompt":"The doctors decided to let the fever _____.","choices":["run its course","Where the rubber meets the road","Where were we?","White elephant"]}]},{"id":"idioms-v1-lesson-060","title":"Bài 60","focus":"Thành ngữ từ “run like the wind” đến “Scare the pants off someone”.","questions":[{"term":"run like the wind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chạy nhanh như gió”. Cậu chọn cụm phù hợp nhé.","prompt":"When he saw the dog chasing him, he started to _____.","choices":["by all means","run like the wind","Buy something for a song","Buy a lemon"]},{"term":"run one's mouth off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói nhiều, ba hoa, ăn nói thiếu suy nghĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take a stand","run one's mouth off","Take a shine to someone/something","Take a rain check"]},{"term":"run out of steam","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đuối sức, mất đà”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["run out of steam","bad apple","Bad hair day","Bad blood"]},{"term":"run out of time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hết thời gian, cạn thời gian.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Throw someone to the wolves","Throw someone for a loop","run out of time","Throw caution to the wind"]},{"term":"run the show","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Điều hành, nắm quyền kiểm soát”. Cậu chọn cụm phù hợp nhé.","prompt":"After the manager left, Rob stepped up to _____.","choices":["run the show","take it with a grain of salt","Take it easy","take pains"]},{"term":"Run-of-the-mill","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tầm thường, bình thường, không có gì nổi trội”. Cậu chọn cụm phù hợp nhé.","prompt":"The restaurant was just a _____ place; nothing special.","choices":["Run-of-the-mill","Saved by the bell","Save someone's skin","Save for a rainy day"]},{"term":"Run/blow hot and cold","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sáng nắng chiều mưa, thay đổi thất thường.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Run/blow hot and cold","Handle someone with kid gloves","Hand over fist","Hand in glove"]},{"term":"Running on fumes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “kiệt sức, cố sức làm dù đã cạn kiệt năng lượng”. Cậu chọn cụm phù hợp nhé.","prompt":"After working three 12-hour shifts in a row, she’s _____.","choices":["At least","Running on fumes","At my wits’ end","At loggerheads"]},{"term":"safe and sound","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bình an vô sự, an toàn khỏe mạnh.”. Cậu chọn cụm phù hợp nhé.","prompt":"After three days lost in the mountains, the hikers were found _____.","choices":["In a rut","In a pinch","safe and sound","In charge of"]},{"term":"Sail close to the wind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “mạo hiểm, liều lĩnh, làm chuyện rủi ro”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hit the hay","Hit the ceiling","Hit the jackpot","Sail close to the wind"]},{"term":"Sales pitch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “lời chào hàng, bài thuyết trình bán hàng”. Cậu chọn cụm phù hợp nhé.","prompt":"The sales representative gave an excellent _____ that convinced us to buy the new software.","choices":["Beat someone to the punch","Sales pitch","Beat someone to the draw","Beat around the bush"]},{"term":"Salt of the earth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “người tốt bụng, trung thực và giản dị”. Cậu chọn cụm phù hợp nhé.","prompt":"John is the _____, always willing to lend a hand to anyone in need.","choices":["See eye to eye","See someone's true colors","Salt of the earth","Security blanket"]},{"term":"save face","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giữ thể diện, giữ danh dự.”. Cậu chọn cụm phù hợp nhé.","prompt":"He accepted a compromise in the dispute just to _____ in front of his team.","choices":["Give someone the cold shoulder","Give someone the benefit of the doubt","give someone the brush-off","save face"]},{"term":"Save for a rainy day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “dành dụm phòng khi túng thiếu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Screw up","Save for a rainy day","School someone in something","Scot-free"]},{"term":"Save someone's skin","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cứu nguy cho ai đó, cứu ai khỏi rắc rối”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Stand up for","Save someone's skin","Start over from scratch","start a family"]},{"term":"Saved by the bell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thoát nạn trong gang tấc (nhờ sự can thiệp kịp thời)”. Cậu chọn cụm phù hợp nhé.","prompt":"I was about to be called to present my project, but I was _____ when the fire alarm went off.","choices":["Bigwig","Bigger bang for your buck","Big wheel","Saved by the bell"]},{"term":"Say one's piece","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói ra suy nghĩ của mình, bày tỏ ý kiến”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Say one's piece","rule of thumb","ruffle feathers","rule the roost"]},{"term":"Say uncle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chịu thua, nhận thua”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["A kickback","A level playing field","A hot potato","Say uncle"]},{"term":"Scapegoat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “kẻ thế tội, con dê tế thần”. Cậu chọn cụm phù hợp nhé.","prompt":"When the project failed, John became the office _____.","choices":["red in the face","red herring","rest on one's laurels","Scapegoat"]},{"term":"Scare the pants off someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “làm ai sợ mất mật”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Have bats in one’s belfry","Have an axe to grind","Have another thing coming","Scare the pants off someone"]}]},{"id":"idioms-v1-lesson-061","title":"Bài 61","focus":"Thành ngữ từ “School of thought” đến “Shape up or ship out”.","questions":[{"term":"School of thought","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “trường phái tư tưởng, luồng suy nghĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Use your loaf","Upset the apple cart","School of thought","up to you"]},{"term":"School someone in something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “dạy dỗ ai đó về cái gì, chỉ bảo ai”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["When the chips are down","When push comes to shove","Where the rubber meets the road","School someone in something"]},{"term":"Scot-free","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bình an vô sự, thoát tội”. Cậu chọn cụm phù hợp nhé.","prompt":"After the trial, he walked away _____, despite all the evidence against him.","choices":["Dog-eat-dog","Dollars to doughnuts","Scot-free","Don't beat a dead horse"]},{"term":"Screw up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “làm hỏng bét, phá hỏng chuyện”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Treat someone to something","True blue","Screw up","Troubled waters"]},{"term":"Sea legs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “khả năng giữ thăng bằng trên tàu; quen với môi trường mới”. Cậu chọn cụm phù hợp nhé.","prompt":"It took me a few days to get my _____, but now I’m fine.","choices":["Sea legs","Don't sweat the small stuff","Don't put all your eggs in one basket","Don't quote me on that"]},{"term":"Second-rate","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “hạng hai, kém chất lượng, tồi tệ”. Cậu chọn cụm phù hợp nhé.","prompt":"The movie was _____ and barely kept my attention.","choices":["Cup of joe","Cry wolf","cup of tea","Second-rate"]},{"term":"Security blanket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vật làm an lòng, chỗ dựa tinh thần”. Cậu chọn cụm phù hợp nhé.","prompt":"She always carries her favorite book as a _____ during stressful times.","choices":["like father like son","Like nailing jello to a wall","Like clockwork","Security blanket"]},{"term":"See eye to eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đồng quan điểm, hoàn toàn đồng ý”. Cậu chọn cụm phù hợp nhé.","prompt":"We don’t always _____, but we respect each other’s opinions.","choices":["Play second fiddle","Play with fire","Play it by ear","See eye to eye"]},{"term":"See someone's true colors","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhìn rõ bộ mặt thật của ai”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bread and butter","Brainstorm","See someone's true colors","Boxed in"]},{"term":"See the big picture","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhìn nhận toàn cục, có cái nhìn bao quát”. Cậu chọn cụm phù hợp nhé.","prompt":"To solve this problem, we need to _____.","choices":["How do you like them apples","Hotshot","Hunky-dory","See the big picture"]},{"term":"See the light","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu ra vấn đề, giác ngộ, nhận ra chân lý.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["to make matters worse","time will tell","Time is money","See the light"]},{"term":"See through someone","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhìn thấu tâm can ai, biết người đó đang giả tạo”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Off on the wrong foot","See through someone","Off the cuff","Off one's rocker"]},{"term":"Sell like hotcakes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bán đắt như tôm tươi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bolt from the blue","Boiling point","Sell like hotcakes","Blue law"]},{"term":"Sell someone out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “phản bội, bán đứng ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Jump down someone's throat","Sell someone out","Josh someone","Joined at the hip"]},{"term":"Sell someone short","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đánh giá thấp ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Shoestring budget","Shoot from the hip","Sell someone short","Ships passing in the night"]},{"term":"Serve one right","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đáng đời, đáng kiếp.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Break someone's heart","Break even","Serve one right","break out in a cold sweat"]},{"term":"set foot in","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đặt chân đến, bước vào một nơi nào đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"It was the first time she had ever _____ a foreign country.","choices":["put one's foot down","put one's money where one's mouth is","set foot in","put our heads together"]},{"term":"Set one's teeth on edge","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “làm chướng tai gai mắt, gây khó chịu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Weather the storm","Set one's teeth on edge","Weasel out of something","Well begun is half done"]},{"term":"Shake a leg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhanh lên, khẩn trương lên”. Cậu chọn cụm phù hợp nhé.","prompt":"Come on, we need to leave soon. _____!","choices":["Food for thought","Fool around","Shake a leg","Follow up on something"]},{"term":"Shape up or ship out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thay đổi thái độ hoặc là nghỉ việc/cuốn gói ra đi”. Cậu chọn cụm phù hợp nhé.","prompt":"If you don’t start meeting deadlines, you’ll have to _____.","choices":["Shape up or ship out","Call a spade a spade","By the skin of ones teeth","By word of mouth"]}]},{"id":"idioms-v1-lesson-062","title":"Bài 62","focus":"Thành ngữ từ “Sharp as a tack” đến “Skip class”.","questions":[{"term":"Sharp as a tack","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cực kỳ thông minh, nhạy bén”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite his age, Grandpa is still _____.","choices":["Run-of-the-mill","Sharp as a tack","run the show","Run/blow hot and cold"]},{"term":"shed light on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm sáng tỏ, làm rõ một vấn đề.”. Cậu chọn cụm phù hợp nhé.","prompt":"Recent archaeological discoveries have _____ how ancient civilizations lived.","choices":["Serve one right","Sell someone out","Sell someone short","shed light on"]},{"term":"Ships passing in the night","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “người lướt qua đời nhau, tình cờ gặp gỡ rồi chia xa”. Cậu chọn cụm phù hợp nhé.","prompt":"We were like _____, only meeting briefly before moving on.","choices":["I'd give my right hand to","Ships passing in the night","I'm losing it","I wasn't born yesterday"]},{"term":"Shoestring budget","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ngân sách eo hẹp”. Cậu chọn cụm phù hợp nhé.","prompt":"The project was completed on a _____ but still turned out great.","choices":["drive someone up the wall","drop by","Shoestring budget","drive someone nuts"]},{"term":"Shoot from the hip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói thẳng thừng, phản ứng tức thời không suy nghĩ kỹ”. Cậu chọn cụm phù hợp nhé.","prompt":"He tends to _____ during meetings without considering the consequences.","choices":["Shoot from the hip","It's in the bag","Itchy feet","It takes two to tango"]},{"term":"Shoot hoops","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chơi bóng rổ”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s go to the park and _____ this afternoon.","choices":["Fender bender","feeling under the weather","Shoot hoops","Feeling blue"]},{"term":"Shoot off one's mouth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói năng thiếu suy nghĩ, ba hoa”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Screw up","Scot-free","Sea legs","Shoot off one's mouth"]},{"term":"Shoot the breeze","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chém gió, tán gẫu”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Shoot the breeze","Wouldn't be caught dead","Worth one's salt","Work against the clock"]},{"term":"shop till you drop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mua sắm thả ga đến kiệt sức.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["shop till you drop","A ray of sunshine","A piece of cake","A picture is worth a thousand words"]},{"term":"Shot in the arm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “liều thuốc tinh thần, sự khích lệ”. Cậu chọn cụm phù hợp nhé.","prompt":"The unexpected bonus at work was a real _____ for our motivation.","choices":["Bend over backward","Belt and suspenders","Shot in the arm","behind the times"]},{"term":"Shot in the dark","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “sự phỏng đoán, mò mẫm trong bóng tối”. Cậu chọn cụm phù hợp nhé.","prompt":"It was a _____, but I managed to guess the correct password.","choices":["by and large","by all means","Buy something for a song","Shot in the dark"]},{"term":"Show of hands","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “biểu quyết bằng cách giơ tay”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's have a _____ to see who agrees with the new proposal.","choices":["Show of hands","Screw up","Second-rate","Sea legs"]},{"term":"Sick as a dog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ốm liệt giường, ốm nặng”. Cậu chọn cụm phù hợp nhé.","prompt":"I was _____ after eating that spoiled food.","choices":["Play catch-up","Pitch in","Sick as a dog","Play devil’s advocate"]},{"term":"Sit tight","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ngồi yên đó, kiên nhẫn chờ đợi”. Cậu chọn cụm phù hợp nhé.","prompt":"Just _____, the doctor will be with you shortly.","choices":["Blow one's top","Blow someone away","Sit tight","Blow smoke"]},{"term":"Sitting like a bump on a log","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ngồi im như phỗng, trơ ra đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take it with a grain of salt","Take it easy","Sitting like a bump on a log","take for granted"]},{"term":"Sitting pretty","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ở vị thế thuận lợi (thường là về tài chính)”. Cậu chọn cụm phù hợp nhé.","prompt":"With their mortgage paid off, they are _____ for retirement.","choices":["You get what you pay for","Sitting pretty","You're telling me","You catch more flies with honey than with vinegar"]},{"term":"Sixth sense","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “giác quan thứ sáu, trực giác”. Cậu chọn cụm phù hợp nhé.","prompt":"She seemed to have a _____ when it came to knowing when her kids were lying.","choices":["Sixth sense","Skeleton in the closet","Skip class","Slap on the wrist"]},{"term":"Skeleton crew","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nhóm nhân viên tối thiểu (để duy trì hoạt động)”. Cậu chọn cụm phù hợp nhé.","prompt":"The factory operates with only a _____ during the holidays.","choices":["dry run","Skeleton crew","drop-dead gorgeous","drop someone a line"]},{"term":"Skeleton in the closet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bí mật đáng xấu hổ”. Cậu chọn cụm phù hợp nhé.","prompt":"Almost every family has at least one _____.","choices":["Skeleton in the closet","Carry a torch for someone","cash cow","Carry the ball"]},{"term":"Skip class","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cúp học, trốn học”. Cậu chọn cụm phù hợp nhé.","prompt":"He decided to _____ and go to the movies instead.","choices":["If I had a nickel for every time something happened","If you can't stand the heat, get out of the kitchen","Skip class","If worst comes to worst"]}]},{"id":"idioms-v1-lesson-063","title":"Bài 63","focus":"Thành ngữ từ “Slap on the wrist” đến “Spin doctor”.","questions":[{"term":"Slap on the wrist","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “phạt nhẹ, hình phạt chiếu lệ”. Cậu chọn cụm phù hợp nhé.","prompt":"He only got a _____ for speeding, which surprised everyone.","choices":["Slap on the wrist","The squeaky wheel gets the grease","The straight and narrow","The tide has turned"]},{"term":"Sleep like a log","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ngủ say như chết”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Big cheese","Sleep like a log","Big fish in a small pond","Big shot"]},{"term":"Slim chance","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cơ hội mong manh”. Cậu chọn cụm phù hợp nhé.","prompt":"There is a _____ of rain today, so you might not need an umbrella.","choices":["Small world","Slow and steady wins the race","Slip of the tongue","Slim chance"]},{"term":"Slip of the tongue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “lỡ lời, trượt miệng”. Cậu chọn cụm phù hợp nhé.","prompt":"It was just a _____; I didn't mean to say that.","choices":["Follow the money","Slip of the tongue","Follow in someone's footsteps","Foam at the mouth"]},{"term":"Slow and steady wins the race","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chậm mà chắc”. Cậu chọn cụm phù hợp nhé.","prompt":"She believes that _____, so she carefully plans her projects.","choices":["Go down like a lead balloon","Go cold turkey","Slow and steady wins the race","Go down in flames"]},{"term":"Small world","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “trái đất tròn, thế giới nhỏ bé”. Cậu chọn cụm phù hợp nhé.","prompt":"I can't believe I ran into my old college roommate in Tokyo. _____!","choices":["Stand up for","Stand one's ground","Small world","start a family"]},{"term":"Smell a rat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nghi ngờ có điều gì mờ ám, đánh hơi thấy mùi nguy hiểm”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bull in a china shop","Burgers and dogs","build bridges","Smell a rat"]},{"term":"Smoke and mirrors","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “sự lừa bịp, chiêu trò che mắt”. Cậu chọn cụm phù hợp nhé.","prompt":"The politician's promises were just _____ to gain votes.","choices":["fall off the wagon","Smoke and mirrors","fall into place","fall on deaf ears"]},{"term":"Smoke like a chimney","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “hút thuốc lá như ống khói, hút thuốc liên tục”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["When the chips are down","Where the rubber meets the road","Smoke like a chimney","Where were we?"]},{"term":"Smooth things over","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dàn xếp, xoa dịu tình hình.”. Cậu chọn cụm phù hợp nhé.","prompt":"He tried to _____ between his two friends who had a disagreement.","choices":["empty nest syndrome","Smooth things over","Elvis has left the building","every cloud has a silver lining"]},{"term":"Snowed under","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bận ngập đầu, ngập trong công việc”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm completely _____ with paperwork this week.","choices":["Between the devil and the deep blue sea","Snowed under","Between a rock and a hard place","Better late than never"]},{"term":"So far so good","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “mọi chuyện vẫn ổn, cho đến nay mọi thứ vẫn tốt đẹp”. Cậu chọn cụm phù hợp nhé.","prompt":"We've finished half the project; _____.","choices":["Black sheep","black sheep of the family","Black out","So far so good"]},{"term":"Something is killing me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đau chết đi được, làm ai đó vô cùng khổ sở”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Something is killing me","Poker face","Pony up","Pound the pavement"]},{"term":"Something sucks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tệ hại, chán ngắt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Something sucks","On the spur of the moment","On the same wavelength","On the spot"]},{"term":"Something to crow about","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “điều đáng tự hào, đáng để khoe khoang”. Cậu chọn cụm phù hợp nhé.","prompt":"Winning the championship is definitely _____.","choices":["Take a rain check","Take a shine to someone/something","take a stand","Something to crow about"]},{"term":"Sour grapes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “biện hộ kiểu con cáo và chùm nho, chê bai thứ mình không có được”. Cậu chọn cụm phù hợp nhé.","prompt":"It's just _____ when he says he didn't want the promotion anyway.","choices":["Live beyond your means","Live hand-to-mouth","Sour grapes","Live and let live"]},{"term":"Speak of the devil","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vừa nhắc tào tháo thì tào tháo tới”. Cậu chọn cụm phù hợp nhé.","prompt":"We were just talking about John, and _____, here he comes!","choices":["Bent out of shape","Beside oneself","Speak of the devil","Bend someone's ear"]},{"term":"Spice things up","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thêm mắm dặm muối, làm cho thú vị hơn”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ with some new activities at our next meeting.","choices":["devil's advocate","Spice things up","Dead-end job","Deep down"]},{"term":"Spill the beans","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tiết lộ bí mật”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["raise Cain","rain or shine","read between the lines","Spill the beans"]},{"term":"Spin doctor","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chuyên gia bóp méo sự thật, người giật dây truyền thông”. Cậu chọn cụm phù hợp nhé.","prompt":"The politician hired a _____ to handle the press after the scandal broke.","choices":["Do or die","Spin doctor","Divide the spoils","Do a number on something"]}]},{"id":"idioms-v1-lesson-064","title":"Bài 64","focus":"Thành ngữ từ “Spineless” đến “Stick-in-the-mud”.","questions":[{"term":"Spineless","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “yếu hèn, nhu nhược, không có lập trường”. Cậu chọn cụm phù hợp nhé.","prompt":"He was too _____ to stand up to his boss.","choices":["Spineless","By hook or by crook","by and large","By the book"]},{"term":"Spitting image","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “giống y đúc, bản sao hoàn hảo”. Cậu chọn cụm phù hợp nhé.","prompt":"Tim is the _____ of his father; they look exactly alike.","choices":["the best thing since sliced bread","Spitting image","the bee's knees","the best of both worlds"]},{"term":"Splitting hairs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vạch lá tìm sâu, bới bèo ra bọ, quá chi li”. Cậu chọn cụm phù hợp nhé.","prompt":"Arguing about this minor difference is just _____.","choices":["Cool your jets","Corner the market","Copycat","Splitting hairs"]},{"term":"Spread yourself too thin","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “ôm đồm quá nhiều việc, làm việc quá sức”. Cậu chọn cụm phù hợp nhé.","prompt":"If you _____, you won't be able to give your best effort to any of your tasks.","choices":["Come out smelling like a rose","Come out of one's shell","Come out swinging","Spread yourself too thin"]},{"term":"Square meal","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bữa ăn thịnh soạn, bữa ăn no nê”. Cậu chọn cụm phù hợp nhé.","prompt":"After working all day, he looks forward to having a _____ at home.","choices":["Wear many hats","wear the pants","Square meal","Wear one's heart on one's sleeve"]},{"term":"Squeaky clean","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “sạch bong kin kít; hoàn toàn trong sạch”. Cậu chọn cụm phù hợp nhé.","prompt":"He has a _____ record with no criminal history.","choices":["Fuddy-duddy","From time to time","Squeaky clean","full of beans"]},{"term":"Stab someone in the back","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đâm sau lưng, phản bội”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep someone posted / Keep someone in the loop","Stab someone in the back","Keep something at bay","Keep something under control"]},{"term":"Stand one's ground","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “giữ vững lập trường, không lùi bước”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sales pitch","Stand one's ground","Salt of the earth","save face"]},{"term":"Stand up for","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đứng lên bảo vệ, ủng hộ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sea legs","Stand up for","Second-rate","Security blanket"]},{"term":"start a family","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lập gia đình và sinh con, bắt đầu có con.”. Cậu chọn cụm phù hợp nhé.","prompt":"After buying their new house, the young couple decided it was time to _____.","choices":["talk to someone like a Dutch uncle","start a family","talk turkey","talk to the hand"]},{"term":"Start over from scratch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bắt đầu lại từ đầu (từ con số không).”. Cậu chọn cụm phù hợp nhé.","prompt":"After losing all the data, we had to _____ with the project.","choices":["Hit me up","Hit it on the nose","Start over from scratch","Hissy fit"]},{"term":"Stay in touch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “giữ liên lạc”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's _____ after you move to New York.","choices":["Give in","give it a shot","Stay in touch","Give props to"]},{"term":"Stay on budget","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bám sát ngân sách, chi tiêu trong giới hạn”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to _____ for this project to be profitable.","choices":["Stay on budget","Wouldn't hurt a fly","Wouldn't touch it with a ten-foot pole","Wrap one's head around something"]},{"term":"Steal someone's thunder","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cướp công, cướp sự chú ý của người khác”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Steal someone's thunder","Make tracks","Make the grade","Make out what someone says"]},{"term":"step up one's game","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nâng cao trình độ, nỗ lực và thể hiện tốt hơn.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Be named after","Be loaded","Be my guest","step up one's game"]},{"term":"Step up your game","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nỗ lực hơn, cố gắng hết sức”. Cậu chọn cụm phù hợp nhé.","prompt":"If you want to get that promotion, you'll need to _____.","choices":["Burgers and dogs","build bridges","Bull in a china shop","Step up your game"]},{"term":"Stew in your own juices","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tự làm tự chịu, tự chuốc lấy hậu quả”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["What are you up to?","Stew in your own juices","When it rains, it pours","Wet one's whistle"]},{"term":"Stick out like a sore thumb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “lạc lõng, nổi bần bật, khác người”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Come rain or shine","Come out swinging","Stick out like a sore thumb","Come out smelling like a rose"]},{"term":"Stick to your guns","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “giữ vững quan điểm, kiên định”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["There's no such thing as a free lunch","Stick to your guns","Third time's a charm","Think outside the box"]},{"term":"Stick-in-the-mud","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “người bảo thủ, người nhàm chán”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't be such a _____; try something new for a change!","choices":["Come a long way","Collect dust","Come alive","Stick-in-the-mud"]}]},{"id":"idioms-v1-lesson-065","title":"Bài 65","focus":"Thành ngữ từ “Sticking point” đến “take it with a grain of salt”.","questions":[{"term":"Sticking point","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “điểm bế tắc, trở ngại chính”. Cậu chọn cụm phù hợp nhé.","prompt":"The main _____ in the negotiation was the distribution of profits.","choices":["One's hands are tied","One's eyes are bigger than one's stomach","Sticking point","One's neck of the woods"]},{"term":"Sticky fingers","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tật ăn cắp vặt, táy máy”. Cậu chọn cụm phù hợp nhé.","prompt":"You'd better keep an eye on your wallet around Jimmy; he's known to have _____.","choices":["day in day out","Dawned on me","Damn someone with faint praise","Sticky fingers"]},{"term":"Stonewall","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Né tránh, cản trở, từ chối hợp tác.”. Cậu chọn cụm phù hợp nhé.","prompt":"Whenever we ask for details, they just _____ us.","choices":["Johnny-come-lately","Ivory tower","Stonewall","Jaywalking"]},{"term":"Stop on a dime","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “dừng lại đột ngột, phanh gấp”. Cậu chọn cụm phù hợp nhé.","prompt":"The new sports car can _____, making it really safe to drive.","choices":["Stop on a dime","Scapegoat","Say uncle","Say one's piece"]},{"term":"Street-smart","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bụi đời, ranh mãnh, lanh lợi”. Cậu chọn cụm phù hợp nhé.","prompt":"Growing up in New York, she became very _____.","choices":["never mind","New kid on the block","Street-smart","New York minute"]},{"term":"Stretch the truth","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “phóng đại sự thật, nói quá”. Cậu chọn cụm phù hợp nhé.","prompt":"He tends to _____ about his achievements.","choices":["Out of order","out of shape","Stretch the truth","out of sorts"]},{"term":"Strike it rich","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “trúng quả đậm, phất lên”. Cậu chọn cụm phù hợp nhé.","prompt":"They think they'll _____ by investing in that startup.","choices":["Strike it rich","drop someone a line","drop-dead gorgeous","drop out of school"]},{"term":"String someone along","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “lừa phỉnh, dắt mũi ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["ahead of time","All bark and no bite","String someone along","Ahead of schedule"]},{"term":"Stuffed shirt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “kẻ làm bộ làm tịch, người tự phụ”. Cậu chọn cụm phù hợp nhé.","prompt":"He's such a _____, always talking down to others.","choices":["Dead tired","Stuffed shirt","Dead to the world","Dead ringer"]},{"term":"Swallow your pride","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “dẹp bỏ tự ái, nuốt lòng tự trọng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Swallow your pride","Tickled pink","Throw someone for a loop","Throw someone to the wolves"]},{"term":"Sweat blood","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đổ mồ hôi sôi nước mắt, làm việc quần quật”. Cậu chọn cụm phù hợp nhé.","prompt":"We _____ on this project to meet the deadline.","choices":["Sweat blood","How do you like them apples","Hot-button issue","Hotshot"]},{"term":"Sweating bullets","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “căng thẳng tột độ, lo sốt vó”. Cậu chọn cụm phù hợp nhé.","prompt":"He was _____ before his big presentation.","choices":["Sweating bullets","Cry wolf","Cup of joe","cup of tea"]},{"term":"Take a load off someone's back","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trút bỏ gánh nặng cho ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Take a load off someone's back","Come out flat-footed","come of age","Come in handy"]},{"term":"Take a rain check","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “hẹn dịp khác, khất lại”. Cậu chọn cụm phù hợp nhé.","prompt":"I'm really busy tonight, but can I _____ on dinner?","choices":["A picture is worth a thousand words","A perfect storm","Take a rain check","A penny saved is a penny earned"]},{"term":"Take a shine to someone/something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cảm mến ngay lập tức, ưng ý ngay”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["wicked","Wild and woolly","Take a shine to someone/something","window shopping"]},{"term":"take a stand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bày tỏ lập trường kiên định, đứng lên bảo vệ quan điểm.”. Cậu chọn cụm phù hợp nhé.","prompt":"Citizens must _____ against injustice and inequality.","choices":["take a stand","Half the battle","Half-baked","Half a mind to do something"]},{"term":"take a turn for the worse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trở nặng đột ngột, diễn biến theo chiều hướng xấu đi.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Pitch dark","take a turn for the worse","Play catch-up","Pitch in"]},{"term":"take for granted","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Coi là điều hiển nhiên, không biết trân trọng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["around the clock","Around-the-clock","take for granted","Armed to the teeth"]},{"term":"Take it easy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thư giãn, nghỉ ngơi, bình tĩnh nào.”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't stress out about the test; just _____ and do your best.","choices":["Take it easy","Peter out","People in glass houses shouldn't throw stones","Pencil pusher"]},{"term":"take it with a grain of salt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nửa tin nửa ngờ, tiếp nhận thông tin có chọn lọc và thận trọng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take it with a grain of salt","Square meal","Stab someone in the back","Squeaky clean"]}]},{"id":"idioms-v1-lesson-066","title":"Bài 66","focus":"Thành ngữ từ “take pains” đến “talk to the hand”.","questions":[{"term":"take pains","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chịu khó, cẩn thận chu đáo hết mực trong công việc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Leave someone out in the cold","Leave someone in the lurch","take pains","Leave someone high and dry"]},{"term":"Take place","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Diễn ra, được tổ chức”. Cậu chọn cụm phù hợp nhé.","prompt":"The meeting will _____ on Monday.","choices":["Around-the-clock","As busy as a bee","as cool as a cucumber","Take place"]},{"term":"Take someone at their word","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tin lời ai đó”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bet the ranch","Take someone at their word","Better late than never","Between a rock and a hard place"]},{"term":"take someone for a ride","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bị lừa gạt, bị xỏ mũi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Bring home the bacon","Bring one's A game","take someone for a ride","Bring down the house"]},{"term":"Take something by storm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “gây bão, chinh phục hoàn toàn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Take something by storm","At loggerheads","At least","At best"]},{"term":"Take something for granted","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Coi điều gì đó là hiển nhiên (nên không trân trọng).”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["If worst comes to worst","If I had a nickel for every time something happened","Idle hands are the devil's tools","Take something for granted"]},{"term":"take something in stride","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bình tĩnh đối mặt, đương đầu một cách nhẹ nhàng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Don't want to hear that","Don't throw the baby out with the bath water","Don't sweat the small stuff","take something in stride"]},{"term":"Take something with a grain of salt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “bán tín bán nghi, không hoàn toàn tin tưởng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["It is always darkest before the dawn","It is a poor workman who blames his tools","It takes one to know one","Take something with a grain of salt"]},{"term":"take the cake","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tồi tệ nhất, sốc nhất (mang ý mỉa mai); đỉnh nhất”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take the cake","A far cry from (something)","a drop in the ocean","a feather in one's cap"]},{"term":"take the floor","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “phát biểu ý kiến, lên tiếng”. Cậu chọn cụm phù hợp nhé.","prompt":"After the chairman’s introduction, she was invited to _____ and present her ideas.","choices":["Pandora’s box","Party animal","Par for the course","take the floor"]},{"term":"take the plunge","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “quyết định liều lĩnh, đánh liều làm gì”. Cậu chọn cụm phù hợp nhé.","prompt":"After years of working in a corporate job, she finally decided to _____ and start her own business.","choices":["Armchair quarterback","Are you kidding me?","Armed to the teeth","take the plunge"]},{"term":"take the wind out of someone's sails","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “làm ai đó nản lòng, nhụt chí”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Out of this world","take the wind out of someone's sails","Out of the woods","Out of the question"]},{"term":"take with a grain of salt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bán tín bán nghi, nghe với thái độ dè dặt có chọn lọc.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["in the same boat","take with a grain of salt","In the red","In the sticks"]},{"term":"take your time","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cứ từ từ, thong thả mà làm (không cần phải vội).”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ reviewing the contract; we do not need your signature until next week.","choices":["Wine and dine","Wild and woolly","take your time","window shopping"]},{"term":"talk a blue streak","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói liến thoắng, nói thao thao bất tuyệt”. Cậu chọn cụm phù hợp nhé.","prompt":"When she gets nervous, she tends to _____.","choices":["jump for joy","Jump down someone's throat","Josh someone","talk a blue streak"]},{"term":"talk shop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói chuyện công việc (trong lúc nghỉ ngơi hoặc giao lưu)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["talk shop","Full of hot air","Full of crap","full of beans"]},{"term":"talk someone's ear off","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói đinh tai nhức óc, nói không ngừng nghỉ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Clean slate","Chuffed to bits","clean bill of health","talk someone's ear off"]},{"term":"talk through one's hat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói khoác, nói bừa không có căn cứ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Turn the other cheek","Turn the tables","talk through one's hat","Turn over a new leaf"]},{"term":"talk to someone like a Dutch uncle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “mắng mỏ hoặc khuyên răn một cách nghiêm khắc nhưng có ý tốt”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["You can't teach an old dog new tricks","talk to someone like a Dutch uncle","You catch more flies with honey than with vinegar","You can't take it with you"]},{"term":"talk to the hand","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “miễn trình bày, không muốn nghe đâu”. Cậu chọn cụm phù hợp nhé.","prompt":"She waved her hand and said _____.","choices":["tie the knot","Tickled pink","Throw someone to the wolves","talk to the hand"]}]},{"id":"idioms-v1-lesson-067","title":"Bài 67","focus":"Thành ngữ từ “talk turkey” đến “the cat's meow”.","questions":[{"term":"talk turkey","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “nói thẳng vào vấn đề, bàn luận nghiêm túc”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s _____ about the deal and see if we can agree.","choices":["put a sock in it","talk turkey","puppy love","push one's luck"]},{"term":"tall order","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “một yêu cầu khó khăn, một nhiệm vụ gian nan”. Cậu chọn cụm phù hợp nhé.","prompt":"Getting everyone to agree on the new plan will be a _____.","choices":["Shot in the arm","Shot in the dark","Show of hands","tall order"]},{"term":"tar someone with the same brush","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vơ đũa cả nắm, đánh đồng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["tar someone with the same brush","Sick as a dog","Sit tight","Show of hands"]},{"term":"teacher's pet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trò cưng của thầy cô (đôi khi mang nghĩa châm biếm).”. Cậu chọn cụm phù hợp nhé.","prompt":"He was always sitting in the front row and answering every question, acting like a _____.","choices":["Bend over backward","Bent out of shape","teacher's pet","Bend someone's ear"]},{"term":"tell me about it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tôi hiểu mà, khỏi phải nói”. Cậu chọn cụm phù hợp nhé.","prompt":"I am so tired today, _____.","choices":["Hissy fit","Hit it on the nose","Hit me up","tell me about it"]},{"term":"test the waters","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thăm dò ý kiến, thử nghiệm trước”. Cậu chọn cụm phù hợp nhé.","prompt":"We should _____ before committing to the new project.","choices":["Smoke like a chimney","Snowed under","Smooth things over","test the waters"]},{"term":"that is to say","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “có nghĩa là, nói cách khác”. Cậu chọn cụm phù hợp nhé.","prompt":"The project failed, _____, it didn’t meet our expectations.","choices":["rest on one's laurels","that is to say","red in the face","right this way"]},{"term":"that ship has sailed","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cơ hội đã trôi qua, ván đã đóng thuyền”. Cậu chọn cụm phù hợp nhé.","prompt":"We were considering buying that house last month, but now _____.","choices":["Not have a leg to stand on","No-brainer","that ship has sailed","Not a spark of decency"]},{"term":"that's all she wrote","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “thế là hết, chấm hết”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Take something by storm","that's all she wrote","take someone for a ride","Take someone at their word"]},{"term":"the apple of someone's eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “người được yêu thương, trân trọng nhất”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["On the dot","On the fly","On the fence","the apple of someone's eye"]},{"term":"the ball is in your court","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “quyết định giờ nằm ở bạn, đến lượt bạn”. Cậu chọn cụm phù hợp nhé.","prompt":"I’ve given you all the information. Now _____.","choices":["Lost at sea","Lose one's touch","the ball is in your court","Lose touch"]},{"term":"the bee's knees","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “xuất sắc, đỉnh của chóp”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the bee's knees","By word of mouth","By the skin of ones teeth","By the book"]},{"term":"the best of both worlds","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vẹn cả đôi đường, được cả chì lẫn chài”. Cậu chọn cụm phù hợp nhé.","prompt":"Working from home gives me _____; I can be productive and spend more time with my family.","choices":["If you can't stand the heat, get out of the kitchen","If you play your cards right","Ignorance is bliss","the best of both worlds"]},{"term":"the best thing since sliced bread","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “phát minh vĩ đại nhất, một thứ tuyệt vời”. Cậu chọn cụm phù hợp nhé.","prompt":"Everyone at the office says that the new coffee machine is _____.","choices":["Get-up-and-go","the best thing since sliced bread","Get with it","Get your walking papers"]},{"term":"the Big Apple","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quả Táo Lớn (biệt danh của thành phố New York)”. Cậu chọn cụm phù hợp nhé.","prompt":"They took a trip to _____ to see a Broadway show.","choices":["Dish the dirt","the Big Apple","Dig in your heels","Dirt cheap"]},{"term":"the Big Easy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “biệt danh của thành phố New Orleans”. Cậu chọn cụm phù hợp nhé.","prompt":"We decided to take a vacation in _____ to enjoy some jazz music.","choices":["the Big Easy","Black and blue","Black out","Black market"]},{"term":"the bottom line","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “điểm mấu chốt, điểm quan trọng nhất”. Cậu chọn cụm phù hợp nhé.","prompt":"You can offer all the excuses you want, but _____ is that the project is late.","choices":["look the other way","the bottom line","Lose one's marbles","Lose one's head"]},{"term":"the boys in blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cảnh sát”. Cậu chọn cụm phù hợp nhé.","prompt":"When trouble started, we called _____ immediately.","choices":["In the sticks","the boys in blue","In the way","in the same boat"]},{"term":"the burning question","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “câu hỏi cấp bách, vấn đề nóng hổi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Good to know","Good riddance","Good things come to those who wait","the burning question"]},{"term":"the cat's meow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tuyệt cú mèo, hết sẩy”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["the cat's meow","New York minute","New kid on the block","never mind"]}]},{"id":"idioms-v1-lesson-068","title":"Bài 68","focus":"Thành ngữ từ “the devil is in the details” đến “The road less travelled”.","questions":[{"term":"the devil is in the details","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “mấu chốt nằm ở chi tiết, chi tiết nhỏ có thể gây rắc rối lớn”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, so we need to review every part of the contract carefully.","choices":["the devil is in the details","Don't know if I'm coming or going","Don't put all your eggs in one basket","Don't look a gift horse in the mouth"]},{"term":"the early bird gets the worm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “trâu chậm uống nước đục, ai đến trước thì được”. Cậu chọn cụm phù hợp nhé.","prompt":"If you want the best deals, remember that _____.","choices":["pull someone's chain","Pull rank","pull someone's leg","the early bird gets the worm"]},{"term":"the elephant in the room","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vấn đề rõ rành rành nhưng ai cũng né tránh”. Cậu chọn cụm phù hợp nhé.","prompt":"We need to address _____ — why sales are declining.","choices":["start a family","the elephant in the room","Stand one's ground","Stand up for"]},{"term":"the eleventh hour","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vào phút chót, phút thứ 89”. Cậu chọn cụm phù hợp nhé.","prompt":"They presented their project at _____.","choices":["Go south","Go the extra mile","the eleventh hour","Go postal"]},{"term":"the gift of the gab","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “có tài ăn nói, khéo ăn nói”. Cậu chọn cụm phù hợp nhé.","prompt":"John has _____; he can persuade anyone to buy anything.","choices":["the gift of the gab","Copycat","Cool your jets","Corner the market"]},{"term":"The hilt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hết mình, triệt để, tới bến.”. Cậu chọn cụm phù hợp nhé.","prompt":"He backed his friend's idea to _____.","choices":["Lay an egg","Lay down the law","Laugh all the way to the bank","The hilt"]},{"term":"The jury is still out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chưa ngã ngũ, chưa có kết luận chính thức về việc gì.”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ on whether the new policy will be effective.","choices":["The jury is still out","Drink like a fish","drive someone crazy","drive someone nuts"]},{"term":"the last minute","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “vào phút chót, ngay trước khi quá muộn”. Cậu chọn cụm phù hợp nhé.","prompt":"He always does his homework at _____.","choices":["A penny for your thoughts","A memory like a sieve","A lucky dog","the last minute"]},{"term":"The last straw","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giọt nước tràn ly.”. Cậu chọn cụm phù hợp nhé.","prompt":"The broken vase was _____; she couldn't take the chaos anymore.","choices":["Get one's dander up","get on someone's nerves","The last straw","Get one's act together"]},{"term":"The life of Riley","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cuộc sống sung túc, nhàn hạ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Ever since he won the lottery, he's been living _____.","choices":["All in the same boat","All heart","all in all","The life of Riley"]},{"term":"The light of my life","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nguồn sống, ánh sáng của đời ai đó.”. Cậu chọn cụm phù hợp nhé.","prompt":"My daughter is _____; she brings joy to every day.","choices":["Learn the ropes","Leave someone alone","Leave no stone unturned","The light of my life"]},{"term":"the lion's share","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “phần lớn nhất, thị phần lớn nhất”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Hair of the dog","Gut feeling","Gung ho","the lion's share"]},{"term":"the long and short of it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “tóm lại là, tóm gọn lại”. Cậu chọn cụm phù hợp nhé.","prompt":"She gave a long explanation, but _____ is that she can’t come to the party.","choices":["Use your loaf","Walk in someone's shoes","Veg out","the long and short of it"]},{"term":"the munchies","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cơn thèm ăn vặt”. Cậu chọn cụm phù hợp nhé.","prompt":"After the party, everyone had _____ and raided the fridge.","choices":["the munchies","in the blink of an eye","In the chips / In the money","In the boondocks"]},{"term":"the other day","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “hôm nọ, mấy hôm trước”. Cậu chọn cụm phù hợp nhé.","prompt":"I saw John at the grocery store _____.","choices":["Cat got your tongue?","the other day","Castle in the sky","Cast-iron stomach"]},{"term":"the patience of Job","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “sự kiên nhẫn phi thường”. Cậu chọn cụm phù hợp nhé.","prompt":"He must have _____ to deal with all those difficult clients.","choices":["Break even","break out in a cold sweat","the patience of Job","Break a leg"]},{"term":"the pits","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “cực kỳ tệ hại, tồi tệ nhất”. Cậu chọn cụm phù hợp nhé.","prompt":"Missing the bus on a rainy day is just _____.","choices":["the pits","Close but no cigar","climb the corporate ladder","Climb the walls"]},{"term":"the pot calling the kettle black","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “chó chê mèo lắm lông, lươn ngắn chê chạch dài”. Cậu chọn cụm phù hợp nhé.","prompt":"When John complained about Sarah being late, it was like _____ - he’s always late himself.","choices":["the Big Apple","the best thing since sliced bread","the pot calling the kettle black","the best of both worlds"]},{"term":"the real McCoy","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đồ thật, hàng thật (không phải đồ giả)”. Cậu chọn cụm phù hợp nhé.","prompt":"This vintage watch is _____, not a replica.","choices":["It is a poor workman who blames his tools","It ain't over till the fat lady sings","It is always darkest before the dawn","the real McCoy"]},{"term":"The road less travelled","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Con đường ít người đi; Lối đi riêng”. Cậu chọn cụm phù hợp nhé.","prompt":"Choosing _____ often means facing more challenges, but can also lead to greater rewards.","choices":["Cool as a cucumber","Cook up","Cook the books","The road less travelled"]}]},{"id":"idioms-v1-lesson-069","title":"Bài 69","focus":"Thành ngữ từ “The school of hard knocks” đến “Throw a monkey wrench in the works”.","questions":[{"term":"The school of hard knocks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trường đời”. Cậu chọn cụm phù hợp nhé.","prompt":"She never went to college but learned everything she knows from _____.","choices":["Cost an arm and a leg","Cost a mint","The school of hard knocks","Couch potato"]},{"term":"The shoe is on the other foot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình thế đảo ngược”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["take pains","Take place","Take someone at their word","The shoe is on the other foot"]},{"term":"The short end of the stick","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chịu thiệt thòi; Nhận phần thiệt”. Cậu chọn cụm phù hợp nhé.","prompt":"If you don’t ask for what you deserve, you’ll end up with _____.","choices":["The short end of the stick","Not one's cup of tea","Not a spark of decency","Not have a leg to stand on"]},{"term":"The squeaky wheel gets the grease","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Con có khóc mẹ mới cho bú”. Cậu chọn cụm phù hợp nhé.","prompt":"If you want your request to be prioritized, remember: _____.","choices":["Keyed up","Kick up one's heels","keep your chin up","The squeaky wheel gets the grease"]},{"term":"The straight and narrow","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lối sống trung thực, ngay thẳng”. Cậu chọn cụm phù hợp nhé.","prompt":"Parents hope their children will remain on _____ as they grow up.","choices":["There's a method to his madness","There's no such thing as a free lunch","Think outside the box","The straight and narrow"]},{"term":"The tide has turned","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình thế đã thay đổi; Đảo chiều”. Cậu chọn cụm phù hợp nhé.","prompt":"I felt hopeless at first, but now it seems _____ in my favor.","choices":["The tide has turned","Fly off the handle","Fly the coop","fly through"]},{"term":"The tip of the iceberg","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Phần nổi của tảng băng chìm”. Cậu chọn cụm phù hợp nhé.","prompt":"The recent scandal is just _____; there’s a lot more we don’t know yet.","choices":["bad apple","Backhanded compliment","The tip of the iceberg","Backseat driver"]},{"term":"The whole ball of wax","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tất tần tật, toàn bộ mọi thứ”. Cậu chọn cụm phù hợp nhé.","prompt":"When you buy this service, you get _____ – technical support, free updates, and maintenance.","choices":["Dig in your heels","The whole ball of wax","Dish the dirt","Dirt cheap"]},{"term":"The whole nine yards","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tất tần tật; Mọi thứ có thể”. Cậu chọn cụm phù hợp nhé.","prompt":"When preparing for the presentation, she went _____ to make sure everything was perfect.","choices":["Hair of the dog","Gut feeling","The whole nine yards","Hair’s breadth"]},{"term":"There are plenty of other fish in the sea","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đời còn dài giai còn nhiều; Thiếu gì người khác”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Foam at the mouth","Fly-by-night","Follow in someone's footsteps","There are plenty of other fish in the sea"]},{"term":"There's a method to his madness","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm chuyện điên rồ nhưng có tính toán”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["There's a method to his madness","Wild and woolly","wicked","window shopping"]},{"term":"There's no such thing as a free lunch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không có bữa trưa nào là miễn phí; Không ai cho không ai cái gì”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["It is always darkest before the dawn","It takes two to tango","There's no such thing as a free lunch","It takes one to know one"]},{"term":"Think outside the box","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Suy nghĩ đột phá; Tư duy vượt giới hạn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Filthy rich","Think outside the box","Fill in the blanks","Find fault with"]},{"term":"Third time's a charm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quá tam ba bận; Lần thứ ba sẽ thành công”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Party animal","Third time's a charm","Par for the course","Pandora’s box"]},{"term":"This is the life","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đời là đây chứ đâu”. Cậu chọn cụm phù hợp nhé.","prompt":"After a long week, finally having a day off feels like, “_____.","choices":["A doubting Thomas","a drop in the bucket","This is the life","A doozy"]},{"term":"Three sheets to the wind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Say bí tỉ; Say khướt”. Cậu chọn cụm phù hợp nhé.","prompt":"You could tell he was _____ just by looking at his stagger.","choices":["Three sheets to the wind","Cat got your tongue?","Cast-iron stomach","Castle in the sky"]},{"term":"thrilled to bits","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ phấn khích, mừng rỡ vô cùng.”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ when her son got accepted into medical school.","choices":["Lay an egg","thrilled to bits","Lay down the law","Lay someone off"]},{"term":"Through thick and thin","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đồng cam cộng khổ; Vượt qua mọi thăng trầm”. Cậu chọn cụm phù hợp nhé.","prompt":"Despite all the challenges, he remained loyal _____.","choices":["The tip of the iceberg","The tide has turned","Through thick and thin","The straight and narrow"]},{"term":"Throw a curveball","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gây bất ngờ; Đưa ra một vấn đề hóc búa”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Keep someone at arm's length","Keep one's wits about one","Keep someone in the dark","Throw a curveball"]},{"term":"Throw a monkey wrench in the works","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thọc gậy bánh xe; Phá hoại kế hoạch”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Go overboard","Go out on a limb","Go out of one's way","Throw a monkey wrench in the works"]}]},{"id":"idioms-v1-lesson-070","title":"Bài 70","focus":"Thành ngữ từ “Throw caution to the wind” đến “Touch base”.","questions":[{"term":"Throw caution to the wind","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liều mạng; Không màng hậu quả”. Cậu chọn cụm phù hợp nhé.","prompt":"They decided to _____ and invest all their savings in the new venture.","choices":["learn by heart","Learn by rote","Lead someone around by the nose","Throw caution to the wind"]},{"term":"Throw someone for a loop","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm ai đó bất ngờ; Gây sốc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Throw someone for a loop","that is to say","that ship has sailed","that's all she wrote"]},{"term":"Throw someone to the wolves","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị bỏ mặc cho chết; Bị đẩy vào chỗ chết”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["put one's finger on it","put a sock in it","Throw someone to the wolves","put on one's thinking cap"]},{"term":"Tickled pink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vui như mở cờ trong bụng”. Cậu chọn cụm phù hợp nhé.","prompt":"She was _____ when she found out she had won the contest.","choices":["Wine and dine","Wild and woolly","Tickled pink","window shopping"]},{"term":"tie the knot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kết hôn, nên duyên vợ chồng, làm đám cưới.”. Cậu chọn cụm phù hợp nhé.","prompt":"After dating for seven years, they finally decided to _____ this autumn.","choices":["Wear one's heart on one's sleeve","Wear many hats","tie the knot","Wave of the future"]},{"term":"tied to mother's apron strings","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bám váy mẹ, quá phụ thuộc vào mẹ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Paddle your own canoe","Pain in the neck","tied to mother's apron strings","Paint the town red"]},{"term":"Tighten your belt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thắt lưng buộc bụng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Take something by storm","Tighten your belt","Take something for granted","take someone for a ride"]},{"term":"Tilt at windmills","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đánh lộn với cối xay gió; Làm việc hão huyền”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["keep tabs on","Tilt at windmills","Keep the ball rolling","Keep up with"]},{"term":"time flies","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thời gian trôi nhanh như tên bắn, thoắt cái đã trôi qua.”. Cậu chọn cụm phù hợp nhé.","prompt":"It feels like we just started the semester yesterday—how _____!","choices":["time flies","take something in stride","take the cake","Take something with a grain of salt"]},{"term":"Time flies when you're having fun","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thời gian thấm thoắt thoi đưa khi vui vẻ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["The squeaky wheel gets the grease","Time flies when you're having fun","The short end of the stick","The straight and narrow"]},{"term":"Time is money","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thời gian là vàng bạc”. Cậu chọn cụm phù hợp nhé.","prompt":"Let’s not delay the project any longer. Remember, _____.","choices":["In the long run","Time is money","In the nick of time","In the loop"]},{"term":"time will tell","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thời gian sẽ trả lời / Thời gian sẽ cho biết kết quả.”. Cậu chọn cụm phù hợp nhé.","prompt":"Whether this new investment strategy succeeds, only _____.","choices":["Be loaded","time will tell","Be my guest","Be named after"]},{"term":"to make matters worse","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tệ hơn nữa là, lại làm cho tình hình thêm tồi tệ.”. Cậu chọn cụm phù hợp nhé.","prompt":"Our car broke down in the middle of nowhere, and _____, it started to rain heavily.","choices":["Go fry an egg","Go it alone","to make matters worse","Go haywire"]},{"term":"Tongue-in-cheek","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nói đùa, châm biếm nhẹ nhàng.”. Cậu chọn cụm phù hợp nhé.","prompt":"His comments about the new policy were clearly _____.","choices":["Out to lunch","Tongue-in-cheek","Over my dead body","Outdo oneself"]},{"term":"Too big for one's boots","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiêu ngạo, hợm hĩnh, tự cao tự đại.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Too big for one's boots","A day late and a dollar short","A chip on your shoulder","A dime a dozen"]},{"term":"Too many irons in the fire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ôm đồm quá nhiều việc cùng lúc.”. Cậu chọn cụm phù hợp nhé.","prompt":"She has _____ and can't focus on any single project.","choices":["All in the same boat","Too many irons in the fire","All over the map","All kidding aside"]},{"term":"Top dog","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ cầm đầu, người có quyền lực nhất, người dẫn đầu.”. Cậu chọn cụm phù hợp nhé.","prompt":"In the tech industry, she is considered the _____.","choices":["rinky-dink","roll out the red carpet","Top dog","roll in it"]},{"term":"Top-notch","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xuất sắc, đỉnh cao, chất lượng tuyệt hảo”. Cậu chọn cụm phù hợp nhé.","prompt":"The restaurant is known for its _____ service.","choices":["Top-notch","Charmed life","Charley horse","Change of heart"]},{"term":"Touch and go","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình huống bấp bênh, không chắc chắn”. Cậu chọn cụm phù hợp nhé.","prompt":"It was _____ for a while after the surgery.","choices":["Touch and go","Cut to the chase","Cut to the quick","Cut the mustard"]},{"term":"Touch base","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Liên lạc nhanh, trao đổi ngắn gọn”. Cậu chọn cụm phù hợp nhé.","prompt":"Let's _____ next week to finalize the details.","choices":["Filthy rich","Touch base","Fill in the blanks","Find fault with"]}]},{"id":"idioms-v1-lesson-071","title":"Bài 71","focus":"Thành ngữ từ “Track record” đến “under the weather”.","questions":[{"term":"Track record","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bề dày thành tích, lịch sử hoạt động”. Cậu chọn cụm phù hợp nhé.","prompt":"She has an impressive _____ in sales.","choices":["Cut the mustard","Track record","Cut someone some slack","Cut someone off at the knees"]},{"term":"Train of thought","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Mạch suy nghĩ”. Cậu chọn cụm phù hợp nhé.","prompt":"I lost my _____ during the presentation.","choices":["A ray of sunshine","Train of thought","A piece of cake","A picture is worth a thousand words"]},{"term":"Train wreck","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thảm họa, tình trạng hỗn loạn”. Cậu chọn cụm phù hợp nhé.","prompt":"The meeting was a complete _____; nothing got resolved.","choices":["Train wreck","Bug someone","bringing up a family","Brownie points"]},{"term":"Travel light","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi du lịch gọn nhẹ, mang ít hành lý”. Cậu chọn cụm phù hợp nhé.","prompt":"When we go camping, we always try to _____.","choices":["Travel light","pull up stakes","pull your weight","Pull the wool over someone's eyes"]},{"term":"Treat someone to something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thiết đãi, khao ai cái gì”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Against the clock","Add fuel to the fire","Add insult to injury","Treat someone to something"]},{"term":"Troubled waters","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tình cảnh khó khăn, rắc rối”. Cậu chọn cụm phù hợp nhé.","prompt":"The company's financial issues have placed them in _____.","choices":["Come a long way","Cold shoulder","Troubled waters","Collect dust"]},{"term":"True blue","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vô cùng trung thành, đáng tin cậy”. Cậu chọn cụm phù hợp nhé.","prompt":"Jane is a _____ friend; you can always count on her.","choices":["True blue","Carry the ball","Carry a torch for someone","cash cow"]},{"term":"Tuckered out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kiệt sức, mệt lử”. Cậu chọn cụm phù hợp nhé.","prompt":"After the hike, we were all _____ and went straight to bed.","choices":["Where the rubber meets the road","Tuckered out","When the chips are down","When push comes to shove"]},{"term":"Turn a blind eye","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nhắm mắt làm ngơ, lờ đi”. Cậu chọn cụm phù hợp nhé.","prompt":"The manager decided to _____ to the minor rule-breaking.","choices":["Hit someone below the belt","Turn a blind eye","Hit the books","Hit pay dirt"]},{"term":"Turn a place upside down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lục tung lên”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Do someone a good turn","Turn a place upside down","Do or die","Do something at the drop of a hat"]},{"term":"Turn over a new leaf","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cải tà quy chính, làm lại cuộc đời, bước sang trang mới”. Cậu chọn cụm phù hợp nhé.","prompt":"After years of bad habits, he decided to _____ and live healthier.","choices":["By hook or by crook","by and large","by all means","Turn over a new leaf"]},{"term":"Turn the other cheek","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chìa má kia ra (chấp nhận bị tổn thương mà không trả đũa), nhẫn nhịn”. Cậu chọn cụm phù hợp nhé.","prompt":"When bullied in school, he chose to _____ rather than fight back.","choices":["Get on one's nerves","Turn the other cheek","Get on one's last nerve","get on like a house on fire"]},{"term":"Turn the tables","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lật ngược thế cờ”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Be close-fisted","Turn the tables","Be beside oneself","Batting a thousand"]},{"term":"Turn up the heat","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gia tăng áp lực”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["raise Cain","rain or shine","rain on someone's parade","Turn up the heat"]},{"term":"Twist someone's arm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thuyết phục ai đó, ép buộc ai đó làm gì”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Ships passing in the night","Shoot from the hip","Shoestring budget","Twist someone's arm"]},{"term":"Two peas in a pod","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giống nhau như đúc”. Cậu chọn cụm phù hợp nhé.","prompt":"They are _____; they do everything together.","choices":["Hit the hay","Hit the nail on the head","Two peas in a pod","Hit the jackpot"]},{"term":"Under a cloud","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bị nghi ngờ, bị mang tiếng xấu”. Cậu chọn cụm phù hợp nhé.","prompt":"Since the scandal, he's been _____ at work.","choices":["Under a cloud","Off one's rocker","Off the cuff","Off the hook"]},{"term":"Under someone's thumb","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chịu sự sai khiến, bị ai đó kiểm soát”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Sticky fingers","Under someone's thumb","Sticking point","Stick-in-the-mud"]},{"term":"Under the table","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lén lút, bất hợp pháp (đặc biệt là giao dịch)”. Cậu chọn cụm phù hợp nhé.","prompt":"He was fired for accepting money _____.","choices":["Brainstorm","Break a leg","Under the table","Bread and butter"]},{"term":"under the weather","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cảm thấy mệt mỏi, khó ở, hơi ốm.”. Cậu chọn cụm phù hợp nhé.","prompt":"I will stay home today because I am feeling a bit _____.","choices":["cram for an exam","under the weather","Crack open a cold one","Crack someone up"]}]},{"id":"idioms-v1-lesson-072","title":"Bài 72","focus":"Thành ngữ từ “Under the wire” đến “Water under the bridge”.","questions":[{"term":"Under the wire","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vào phút chót, sát giờ”. Cậu chọn cụm phù hợp nhé.","prompt":"She turned in her assignment just _____ before the deadline.","choices":["Par for the course","Under the wire","Party animal","Pass the buck"]},{"term":"Until the cows come home","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất lâu, vô tận”. Cậu chọn cụm phù hợp nhé.","prompt":"You can wait _____, but she's not going to change her mind.","choices":["Until the cows come home","All bets are off","All bark and no bite","all ears"]},{"term":"Up a blind alley","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi vào ngõ cụt, không mang lại kết quả”. Cậu chọn cụm phù hợp nhé.","prompt":"We spent months on this project, but in the end, we realized we were _____.","choices":["Up a blind alley","Turn the other cheek","Turn a place upside down","Turn over a new leaf"]},{"term":"Up a gum tree","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Gặp rắc rối lớn, tiến thoái lưỡng nan”. Cậu chọn cụm phù hợp nhé.","prompt":"When the project lost its funding, the whole team felt _____.","choices":["Up a blind alley","Up a gum tree","Until the cows come home","Up for grabs"]},{"term":"Up for grabs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có sẵn để ai cũng có thể lấy/giành được”. Cậu chọn cụm phù hợp nhé.","prompt":"The tickets to the concert are _____, so act fast!","choices":["Charley horse","Up for grabs","Charmed life","Chasing rainbows"]},{"term":"Up in arms","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất tức giận, phản đối gay gắt”. Cậu chọn cụm phù hợp nhé.","prompt":"The community is _____ about the proposed development project.","choices":["Lost at sea","Low-hanging fruit","Luck out","Up in arms"]},{"term":"Up in the air","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chưa được quyết định, còn dang dở”. Cậu chọn cụm phù hợp nhé.","prompt":"Our vacation plans are still _____ because we're waiting for confirmation from the hotel.","choices":["Prick up your ears","Up in the air","Power dressing","practice makes perfect"]},{"term":"Up the creek without a paddle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lâm vào cảnh khốn cùng, bế tắc”. Cậu chọn cụm phù hợp nhé.","prompt":"After losing his job, he felt he was _____.","choices":["Up the creek without a paddle","In the heat of the moment","In the doghouse","In the lap of luxury"]},{"term":"Up to snuff","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đạt tiêu chuẩn, đủ tốt”. Cậu chọn cụm phù hợp nhé.","prompt":"His work wasn't _____, so he had to redo it.","choices":["to make matters worse","Time is money","time will tell","Up to snuff"]},{"term":"up to you","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tùy bạn, do bạn quyết định.”. Cậu chọn cụm phù hợp nhé.","prompt":"We can eat Italian food or Japanese food tonight—it is completely _____.","choices":["up to you","Get a taste of one's own medicine","Get a move on","Get a second wind"]},{"term":"Upset the apple cart","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Làm hỏng chuyện, phá hỏng kế hoạch”. Cậu chọn cụm phù hợp nhé.","prompt":"His unexpected resignation _____ at the company.","choices":["Say uncle","Upset the apple cart","Scapegoat","Scare the pants off someone"]},{"term":"Use your loaf","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Động não đi, dùng cái đầu đi”. Cậu chọn cụm phù hợp nhé.","prompt":"Come on, _____! It's not that complicated.","choices":["Use your loaf","rinky-dink","rings a bell","ring a bell"]},{"term":"Veg out","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thư giãn hoàn toàn, không làm gì cả”. Cậu chọn cụm phù hợp nhé.","prompt":"After a long week at work, I just want to _____ on the couch and watch movies.","choices":["Veg out","Don't throw the baby out with the bath water","Don't quote me on that","Don't sweat the small stuff"]},{"term":"Walk in someone's shoes","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đặt mình vào vị trí của người khác”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Clear the air","Climb the walls","Walk in someone's shoes","climb the corporate ladder"]},{"term":"Walk on air","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cực kỳ hạnh phúc, vui như ở trên mây”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Cross one's fingers","Crocodile tears","Walk on air","cross paths"]},{"term":"Wallflower","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Người nhút nhát, người ít giao tiếp (thường ở các bữa tiệc)”. Cậu chọn cụm phù hợp nhé.","prompt":"At every party, she feels like a _____, afraid to dance or mingle.","choices":["Blow smoke","Blow one's top","Blow someone away","Wallflower"]},{"term":"Wash one's hands of something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rũ bỏ trách nhiệm, phủi tay”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wash one's hands of something","Blow a fuse","blood is thicker than water","Blonde bombshell"]},{"term":"Waste not, want not","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ăn tiêu chừng mực thì không lo túng thiếu”. Cậu chọn cụm phù hợp nhé.","prompt":"By following the _____ rule, we managed to save a lot of money over the years.","choices":["Make one's hair stand on end","Make no bones about","Make matters worse","Waste not, want not"]},{"term":"Watch out for","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cẩn thận, coi chừng”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ that car while crossing the street.","choices":["wear the pants","Weasel out of something","Watch out for","wear your heart on your sleeve"]},{"term":"Water under the bridge","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện đã qua, không còn quan trọng nữa”. Cậu chọn cụm phù hợp nhé.","prompt":"We had our differences in the past, but it's all _____ now.","choices":["Come a long way","Water under the bridge","Come clean","Come alive"]}]},{"id":"idioms-v1-lesson-073","title":"Bài 73","focus":"Thành ngữ từ “Watering hole” đến “Where were we?”.","questions":[{"term":"Watering hole","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Quán rượu, nơi tụ tập uống rượu”. Cậu chọn cụm phù hợp nhé.","prompt":"The local pub has become my favorite _____.","choices":["Weasel out of something","wear your heart on your sleeve","Watering hole","Weather the storm"]},{"term":"Wave of the future","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Xu hướng của tương lai”. Cậu chọn cụm phù hợp nhé.","prompt":"Electric cars are the _____.","choices":["Bring home the bacon","Bright and early","Wave of the future","Bring down the house"]},{"term":"Wear many hats","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đảm nhiệm nhiều vai trò, kiêm nhiệm nhiều việc”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["As rare as hen’s teeth","As happy as a clam","As quiet as a mouse","Wear many hats"]},{"term":"Wear one's heart on one's sleeve","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ruột để ngoài da, bộc lộ rõ cảm xúc ra ngoài”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["An old soul","An old head on young shoulders","Wear one's heart on one's sleeve","An apple a day keeps the doctor away"]},{"term":"wear the pants","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nắm quyền trong nhà, làm chủ mối quan hệ/gia đình.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["wear the pants","familiarity breeds contempt","fall off the wagon","fall on deaf ears"]},{"term":"wear your heart on your sleeve","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ruột để ngoài da, bộc lộ tình cảm một cách chân thật và rõ ràng.”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["All Greek to me","All heart","wear your heart on your sleeve","all ears"]},{"term":"Weasel out of something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trốn tránh trách nhiệm một cách khôn lỏi”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Weasel out of something","Steal someone's thunder","Stay on budget","Stay in touch"]},{"term":"Weather the storm","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vượt qua khó khăn, sóng gió”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Weather the storm","Itchy feet","Jaywalking","Ivory tower"]},{"term":"Well begun is half done","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đầu xuôi đuôi lọt, khởi đầu tốt là đã thành công một nửa”. Cậu chọn cụm phù hợp nhé.","prompt":"Remember, _____, so take your time with initial preparations.","choices":["Fill in the blanks","Well begun is half done","Find fault with","Filthy rich"]},{"term":"Well-heeled","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Giàu có, rủng rỉnh tiền bạc”. Cậu chọn cụm phù hợp nhé.","prompt":"The banquet was attended by many _____ guests.","choices":["Fender bender","Well-heeled","Field day","Fifteen minutes of fame"]},{"term":"Wet behind the ears","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trẻ người non dạ, còn non nớt (thiếu kinh nghiệm)”. Cậu chọn cụm phù hợp nhé.","prompt":"He may seem confident, but he's still _____ when it comes to finance.","choices":["fair-weather friend","fair and square","Wet behind the ears","fair to middling"]},{"term":"Wet blanket","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Kẻ phá đám, người làm mất vui”. Cậu chọn cụm phù hợp nhé.","prompt":"Don't be a _____; join us for the party!","choices":["On the level","On the line","Wet blanket","On the house"]},{"term":"Wet one's whistle","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Uống chút gì đó (thường là rượu bia) cho thấm giọng”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Running on fumes","Run/blow hot and cold","Run-of-the-mill","Wet one's whistle"]},{"term":"What are you up to?","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dạo này bạn thế nào? / Bạn đang làm gì đó?”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["The road less travelled","the real McCoy","What are you up to?","The school of hard knocks"]},{"term":"When it rains, it pours","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Họa vô đơn chí, họa không tới một mình”. Cậu chọn cụm phù hợp nhé.","prompt":"First, I got a flat tire, and then my favorite coffee shop closed — _____.","choices":["Buy something for a song","Buy a lemon","Button one's lip","When it rains, it pours"]},{"term":"When pigs fly","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chuyện hoang đường, không bao giờ xảy ra (chuyện mặt trời mọc đằng tây)”. Cậu chọn cụm phù hợp nhé.","prompt":"He said he'd tidy his room, but that will happen _____.","choices":["Go with the flow","go under the knife","When pigs fly","Go up in smoke"]},{"term":"When push comes to shove","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khi đến bước đường cùng, trong tình huống khẩn cấp”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, we can always count on Susan to take charge.","choices":["look on the bright side","When push comes to shove","look the other way","Lose one's head"]},{"term":"When the chips are down","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Trong những lúc khó khăn nhất, khi tình hình trở nên nghiêm trọng”. Cậu chọn cụm phù hợp nhé.","prompt":"_____, true friends will be there for you.","choices":["Go-to guy","Golden age","Go without saying","When the chips are down"]},{"term":"Where the rubber meets the road","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nơi thử thách thực sự, lúc lý thuyết được đưa vào thực tiễn”. Cậu chọn cụm phù hợp nhé.","prompt":"We can plan all we want, but this idea really shows its value _____.","choices":["Down the tube","Down in the mouth","Where the rubber meets the road","down to earth"]},{"term":"Where were we?","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chúng ta đang nói đến đâu rồi nhỉ?”. Cậu chọn cụm phù hợp nhé.","prompt":"Sorry for the interruption. _____","choices":["on edge","On the ball","On pins and needles","Where were we?"]}]},{"id":"idioms-v1-lesson-074","title":"Bài 74","focus":"Thành ngữ từ “White elephant” đến “wrap your head around”.","questions":[{"term":"White elephant","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sự vật đắt tiền nhưng vô dụng hoặc tốn kém để bảo trì”. Cậu chọn cụm phù hợp nhé.","prompt":"The new stadium turned out to be a _____; nobody uses it, and the maintenance costs are skyrocketing.","choices":["White elephant","have one's ducks in a row","Have one's back to the wall","Have hell to pay"]},{"term":"White lie","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lời nói dối vô hại, lời nói dối thiện ý”. Cậu chọn cụm phù hợp nhé.","prompt":"She told a _____ to spare his feelings.","choices":["Full of crap","Full of hot air","White lie","Full steam ahead"]},{"term":"Whitewash","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Che đậy sự thật, tẩy trắng (tội lỗi)”. Cậu chọn cụm phù hợp nhé.","prompt":"The company tried to _____ the environmental disaster it caused.","choices":["In a bind","In a nutshell","Whitewash","In a jam"]},{"term":"Who asked you?","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Ai mướn bạn nói? / Ai hỏi bạn đâu?”. Cậu chọn cụm phù hợp nhé.","prompt":"\"_____\" she replied angrily.","choices":["Who asked you?","A sledgehammer to crack a nut","A smart cookie","A snowball effect"]},{"term":"Who do you think you are?","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bạn nghĩ bạn là ai chứ?”. Cậu chọn cụm phù hợp nhé.","prompt":"_____","choices":["Who do you think you are?","Stand one's ground","Squeaky clean","Stab someone in the back"]},{"term":"wicked","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “đỉnh thật, ngầu quá”. Cậu chọn cụm phù hợp nhé.","prompt":"Wow, your skateboard tricks are _____!","choices":["wicked","Skip class","Slap on the wrist","Skeleton in the closet"]},{"term":"Wild and woolly","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hỗn loạn, hoang dã và thiếu kiểm soát”. Cậu chọn cụm phù hợp nhé.","prompt":"The party last night was _____; no one knew what would happen next.","choices":["Watering hole","Wild and woolly","Water under the bridge","Watch out for"]},{"term":"window shopping","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đi ngắm đồ qua tủ kính (đi dạo xem đồ chứ không mua).”. Cậu chọn cụm phù hợp nhé.","prompt":"We spent a relaxing Sunday afternoon _____ along the boulevard.","choices":["Break the ice","Break the bank","Break the news","window shopping"]},{"term":"Wine and dine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thiết đãi nồng hậu, chiêu đãi thịnh soạn”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Calm before the storm","Calm someone down","Wine and dine","Cant hold a candle to"]},{"term":"Wing it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tùy cơ ứng biến, làm mà không có sự chuẩn bị trước”. Cậu chọn cụm phù hợp nhé.","prompt":"I forgot my speech notes, so I had to _____ during the presentation.","choices":["Keep body and soul together","Wing it","keep at bay","keep in mind"]},{"term":"With bated breath","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Nín thở chờ đợi, hồi hộp mong đợi”. Cậu chọn cụm phù hợp nhé.","prompt":"Everyone in the room was listening _____ as the announcement was made.","choices":["run in the family","run errands","With bated breath","run circles around someone"]},{"term":"With bells on","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Với thái độ vô cùng háo hức và nhiệt tình”. Cậu chọn cụm phù hợp nhé.","prompt":"Count me in for the trip; I'll be there _____.","choices":["With bells on","Closed-minded","Close shave","Clouds on the horizon"]},{"term":"With flying colors","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Một cách xuất sắc, thành công mỹ mãn”. Cậu chọn cụm phù hợp nhé.","prompt":"She passed the exam _____.","choices":["Full steam ahead","With flying colors","Full of hot air","Full of crap"]},{"term":"Work against the clock","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chạy đua với thời gian, làm việc khẩn trương”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["tie the knot","Tighten your belt","Work against the clock","tied to mother's apron strings"]},{"term":"Worth one's salt","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đáng đồng tiền bát gạo, có năng lực xứng đáng với vị trí”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Worth one's salt","the munchies","the lion's share","the long and short of it"]},{"term":"Wouldn't be caught dead","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thà chết còn hơn, nhất quyết không bao giờ làm”. Cậu chọn cụm phù hợp nhé.","prompt":"He _____ wearing those old-fashioned shoes.","choices":["quality time","rack one's brain","Wouldn't be caught dead","Rain cats and dogs"]},{"term":"Wouldn't hurt a fly","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Rất hiền lành, hiền như cục đất (không dám làm hại một con ruồi)”. Cậu chọn cụm phù hợp nhé.","prompt":"John is the sweetest person; he _____.","choices":["eat like a bird","eat like a horse","eat crow","Wouldn't hurt a fly"]},{"term":"Wouldn't touch it with a ten-foot pole","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tránh xa ra, có cho thêm tiền cũng không dám đụng vào”. Cậu chọn cụm phù hợp nhé.","prompt":"That investment seems too risky; I _____.","choices":["Tighten your belt","Wouldn't touch it with a ten-foot pole","Tilt at windmills","tied to mother's apron strings"]},{"term":"Wrap one's head around something","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Cố gắng hiểu hoặc chấp nhận một điều gì đó phức tạp”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Wrap one's head around something","Grin and bear it","green with envy","Green thumb"]},{"term":"wrap your head around","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Hiểu thấu, tiêu hóa hay chấp nhận một khái niệm phức tạp.”. Cậu chọn cụm phù hợp nhé.","prompt":"Quantum physics is a fascinating subject, but it takes time to _____ its principles.","choices":["Fish out of water","wrap your head around","Fishy","Finger-lickin' good"]}]},{"id":"idioms-v1-lesson-075","title":"Bài 75","focus":"Thành ngữ từ “X marks the spot” đến “zip it”.","questions":[{"term":"X marks the spot","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chính là chỗ này, đúng ngay điểm này”. Cậu chọn cụm phù hợp nhé.","prompt":"The treasure map shows that _____ where the gold is buried.","choices":["An ounce of prevention is worth a pound of cure","apple of my eye","X marks the spot","Are you kidding me?"]},{"term":"You bet","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Chắc chắn rồi, tất nhiên rồi”. Cậu chọn cụm phù hợp nhé.","prompt":"Will you help me with this project? _____!","choices":["You bet","to make matters worse","time will tell","Time is money"]},{"term":"You can bet your boots","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Dám cá là, chắc chắn một trăm phần trăm”. Cậu chọn cụm phù hợp nhé.","prompt":"When he says he'll finish the project by Friday, _____ he will.","choices":["tied to mother's apron strings","Tighten your belt","Tilt at windmills","You can bet your boots"]},{"term":"You can bet your bottom dollar","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đảm bảo luôn, dám cá bằng đồng xu cuối cùng”. Cậu chọn cụm phù hợp nhé.","prompt":"_____ that she'll be at the party tonight.","choices":["See eye to eye","See someone's true colors","You can bet your bottom dollar","See the big picture"]},{"term":"You can lead a horse to water, but you can't make him drink","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Có thể mang lại cơ hội cho ai đó nhưng không thể ép họ đón nhận (không thể ép ai làm việc họ không muốn)”. Cậu chọn cụm phù hợp nhé.","prompt":"I gave her all the tools to succeed, but she still failed. _____.","choices":["Behind someone’s back","Behind the eight ball","You can lead a horse to water, but you can't make him drink","Before you know it"]},{"term":"You can say that again","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Bạn nói quá chuẩn, hoàn toàn đồng ý”. Cậu chọn cụm phù hợp nhé.","prompt":"The weather is beautiful today; _____.","choices":["Wet blanket","Wet behind the ears","You can say that again","Wet one's whistle"]},{"term":"You can't have your cake and eat it too","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Được cái này mất cái kia, không thể bắt cá hai tay”. Cậu chọn cụm phù hợp nhé.","prompt":"He wants the promotion without working hard. Well, _____.","choices":["You can't have your cake and eat it too","I'm losing it","Icing on the cake","Idle hands are the devil's tools"]},{"term":"You can't judge a book by its cover","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Đừng trông mặt mà bắt hình dong”. Cậu chọn cụm phù hợp nhé.","prompt":"The old house may look shabby, but _____. It is beautifully decorated inside.","choices":["Keep one's head","Keep one's head above water","You can't judge a book by its cover","Keep one's cool"]},{"term":"You can't make an omelet without breaking some eggs","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Muốn đạt được thành tựu thì phải chịu đánh đổi”. Cậu chọn cụm phù hợp nhé.","prompt":"Implementing new policies will face some resistance, but _____.","choices":["Get with it","You can't make an omelet without breaking some eggs","Get wind of something","Get your walking papers"]},{"term":"You can't squeeze blood out of a turnip","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Vắt cổ chày ra nước (không thể đòi hỏi thứ mà người ta không có)”. Cậu chọn cụm phù hợp nhé.","prompt":"Mình đoán idiom đó là: _____","choices":["Spread yourself too thin","Squeaky clean","You can't squeeze blood out of a turnip","Square meal"]},{"term":"You can't take it with you","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Sống để dạ chết mang đi, của cải không thể mang theo khi chết”. Cậu chọn cụm phù hợp nhé.","prompt":"He amassed a great fortune, but in the end, _____.","choices":["fall by the wayside","fair-weather friend","You can't take it with you","fall into place"]},{"term":"You can't teach an old dog new tricks","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tre già khó uốn, khó mà thay đổi thói quen của người già”. Cậu chọn cụm phù hợp nhé.","prompt":"My grandfather refuses to use a smartphone; you know what they say, _____.","choices":["Packed like sardines","Over my dead body","over the moon","You can't teach an old dog new tricks"]},{"term":"You catch more flies with honey than with vinegar","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Lời nói ngọt ngào dễ lọt tai hơn, lạt mềm buộc chặt”. Cậu chọn cụm phù hợp nhé.","prompt":"Try to be nicer when asking for help. _____.","choices":["Backhanded compliment","Back to square one","You catch more flies with honey than with vinegar","Back to the drawing board"]},{"term":"You get what you pay for","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tiền nào của nấy”. Cậu chọn cụm phù hợp nhé.","prompt":"I bought those cheap shoes, and now they're falling apart. I guess _____.","choices":["You get what you pay for","take the cake","Take something with a grain of salt","take the floor"]},{"term":"You're telling me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Khỏi phải nói, tôi biết quá đi chứ”. Cậu chọn cụm phù hợp nhé.","prompt":"He says he is busy, but _____.","choices":["fair-weather friend","fall by the wayside","You're telling me","fall into place"]},{"term":"You've sold me","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Thuyết phục được tôi rồi đấy”. Cậu chọn cụm phù hợp nhé.","prompt":"Okay, _____ on the idea of taking a weekend trip.","choices":["You've sold me","Big wheel","Bigwig","Bigger bang for your buck"]},{"term":"your guess is as good as mine","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Tôi cũng không biết; tôi cũng mờ mịt như bạn”. Cậu chọn cụm phù hợp nhé.","prompt":"When will the project be finished? _____.","choices":["A doubting Thomas","your guess is as good as mine","A dime a dozen","A doozy"]},{"term":"zero tolerance","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Không khoan nhượng; chính sách xử lý nghiêm ngặt mọi vi phạm”. Cậu chọn cụm phù hợp nhé.","prompt":"The school has a _____ policy for bullying.","choices":["take someone for a ride","Take someone at their word","Take place","zero tolerance"]},{"term":"zip it","dialoguePrompt":"Tớ đang nghĩ đến một idiom có nghĩa là “Im đi; ngậm miệng lại; đừng nói nữa”. Cậu chọn cụm phù hợp nhé.","prompt":"He was about to reveal the surprise, but she quickly told him to _____.","choices":["zip it","Fishy","Fit as a fiddle","Fish out of water"]}]}],"entriesByTerm":{"9-to-5":{"definition":"Giờ làm việc hành chính; công việc toàn thời gian (thường từ 9 giờ sáng đến 5 giờ chiều).","example":"I’m tired of the 9-to-5 grind and want a more flexible schedule.","exampleTranslation":"Tôi chán ngấy công việc giờ hành chính nhàm chán và muốn một lịch làm việc linh hoạt hơn.","partOfSpeech":"idiom"},"A bad apple":{"definition":"Kẻ xấu trong nhóm; con sâu làm rầu nồi canh.","example":"They had to fire him because he was a bad apple disrupting the workplace harmony.","exampleTranslation":"Họ phải sa thải anh ta vì anh ta là con sâu làm rầu nồi canh, phá vỡ sự hòa thuận nơi làm việc.","partOfSpeech":"idiom"},"A baker’s dozen":{"definition":"Mười ba (13).","example":"I ordered a dozen bagels, but the kind baker gave me a baker’s dozen.","exampleTranslation":"Tôi đặt một tá bánh mì vòng, nhưng người thợ làm bánh tốt bụng đã tặng tôi thêm một cái thành mười ba.","partOfSpeech":"idiom"},"A ballpark figure":{"definition":"Con số ước tính; lượng ước đoán.","example":"Can you give me a ballpark figure of the total cost?","exampleTranslation":"Bạn có thể cho tôi một con số ước tính về tổng chi phí không?","partOfSpeech":"idiom"},"A bird in the hand is worth two in the bush":{"definition":"Có còn hơn không; trân trọng những gì đang có (thay vì theo đuổi những thứ viển vông).","example":"You should take the job offer; remember, a bird in the hand is worth two in the bush.","exampleTranslation":"Bạn nên nhận lời đề nghị việc làm đó; hãy nhớ rằng có một con chim trong tay còn hơn hai con trong bụi rậm.","partOfSpeech":"idiom"},"A bit/A little bit":{"definition":"Một chút; hơi hơi.","example":"I’m feeling a bit tired today.","exampleTranslation":"Hôm nay tôi cảm thấy hơi mệt.","partOfSpeech":"idiom"},"A blessing in disguise":{"definition":"Trong cái rủi có cái may; việc tốt đội lốt việc xấu.","example":"Losing that job was a blessing in disguise; it pushed me to start my own business.","exampleTranslation":"Mất công việc đó hóa ra lại là trong cái rủi có cái may; nó thúc đẩy tôi khởi nghiệp.","partOfSpeech":"idiom"},"A bone to pick":{"definition":"Chuyện cần phải làm rõ; vấn đề cần giải quyết (thường mang tính chất phàn nàn, cãi vã).","example":"I have a bone to pick with you about your comments yesterday.","exampleTranslation":"Tôi có chuyện cần nói rõ với bạn về những lời bình luận của bạn hôm qua.","partOfSpeech":"idiom"},"A breath of fresh air":{"definition":"Làn gió mới; luồng sinh khí mới.","example":"Her innovative ideas were a breath of fresh air for the company.","exampleTranslation":"Những ý tưởng sáng tạo của cô ấy là một làn gió mới cho công ty.","partOfSpeech":"idiom"},"A bunch of":{"definition":"Một mớ; một đống; rất nhiều.","example":"There’s a bunch of paperwork on my desk I need to finish.","exampleTranslation":"Có một đống giấy tờ trên bàn tôi cần phải làm xong.","partOfSpeech":"idiom"},"A chip off the old block":{"definition":"Cha nào con nấy, bản sao của bố/mẹ.","example":"He’s a chip off the old block – just as stubborn as his father.","exampleTranslation":"Cậu ấy đúng là cha nào con nấy, cứng đầu y hệt bố mình.","partOfSpeech":"idiom"},"A chip on your shoulder":{"definition":"Dễ nổi cáu; ôm hận trong lòng; thái độ hằn học.","example":"He’s always had a chip on his shoulder ever since he got passed over for the promotion.","exampleTranslation":"Anh ta luôn mang trong lòng sự hằn học kể từ khi bị bỏ qua trong đợt thăng chức.","partOfSpeech":"idiom"},"A day late and a dollar short":{"definition":"Quá muộn màng và không đủ (thường dùng khi sự giúp đỡ hoặc hành động đã quá muộn để xoay chuyển tình thế).","example":"Her apology felt a day late and a dollar short after the damage was already done.","exampleTranslation":"Lời xin lỗi của cô ấy đến quá muộn màng khi thiệt hại đã xảy ra rồi.","partOfSpeech":"idiom"},"A dime a dozen":{"definition":"Rẻ như bèo; đồ bỏ đi; nhiều vô kể.","example":"Cheap souvenirs are a dime a dozen at the tourist market.","exampleTranslation":"Đồ lưu niệm rẻ tiền nhiều vô kể ở chợ du lịch.","partOfSpeech":"idiom"},"A doozy":{"definition":"Chuyện kinh khủng; thứ phi thường; việc rất khó khăn.","example":"That test was a real doozy — one of the hardest I’ve ever taken.","exampleTranslation":"Bài kiểm tra đó thật sự là một thử thách lớn, một trong những bài khó nhất mà tôi từng làm.","partOfSpeech":"idiom"},"A doubting Thomas":{"definition":"Kẻ đa nghi; người không dễ tin vào người khác.","example":"He’s such a doubting Thomas, always needing proof before he believes anything we say.","exampleTranslation":"Anh ta đúng là người hay hoài nghi, luôn đòi bằng chứng trước khi tin bất cứ điều gì chúng tôi nói.","partOfSpeech":"idiom"},"a drop in the bucket":{"definition":"Hạt muối bỏ biển, chả thấm vào đâu.","example":"The charity event raised $500, but it's just a drop in the bucket compared to what's needed.","exampleTranslation":"Sự kiện từ thiện đã quyên góp được 500 đô la, nhưng đó chỉ là muối bỏ biển so với những gì cần có.","partOfSpeech":"idiom"},"a drop in the ocean":{"definition":"Giọt nước giữa biển khơi, hạt cát trong sa mạc; số lượng quá ít ỏi.","example":"A thousand dollars is just a drop in the ocean compared to the millions needed for the hospital.","exampleTranslation":"Một nghìn đô la chỉ là muối bỏ bể so với hàng triệu đô la cần cho bệnh viện.","partOfSpeech":"idiom"},"A far cry from (something)":{"definition":"Khác xa với; một trời một vực.","example":"Living in the city is a far cry from living in the countryside.","exampleTranslation":"Sống ở thành phố khác xa một trời một vực so với sống ở nông thôn.","partOfSpeech":"idiom"},"a feather in one's cap":{"definition":"Một thành tựu đáng tự hào, niềm hãnh diện.","example":"Winning the championship was a real feather in his cap.","exampleTranslation":"Giành chức vô địch thực sự là một thành tích đáng tự hào của anh ấy.","partOfSpeech":"idiom"},"A fifth wheel":{"definition":"Người thừa; kỳ đà cản mũi.","example":"Whenever my friends go out on dates, I always feel like a fifth wheel.","exampleTranslation":"Mỗi khi bạn bè tôi đi hẹn hò, tôi luôn cảm thấy mình như người thừa.","partOfSpeech":"idiom"},"A flash in the pan":{"definition":"Hiện tượng sớm nở tối tàn; thành công chớp nhoáng.","example":"His performance was impressive, but it turned out to be just a flash in the pan.","exampleTranslation":"Màn trình diễn của anh ấy rất ấn tượng, nhưng hóa ra chỉ là nhất thời, rồi vụt tắt.","partOfSpeech":"idiom"},"A fool and his money are easily parted":{"definition":"Kẻ ngốc không biết giữ tiền; tiêu tiền như nước.","example":"He spent all his savings on lottery tickets. A fool and his money are easily parted.","exampleTranslation":"Anh ta tiêu hết tiền tiết kiệm vào vé số. Kẻ ngốc thì dễ mất tiền.","partOfSpeech":"idiom"},"A for effort":{"definition":"Điểm 10 cho sự nỗ lực; đáng khen vì đã cố gắng.","example":"The project didn’t work out as planned, but the team deserves an A for effort.","exampleTranslation":"Dự án không diễn ra như kế hoạch, nhưng cả nhóm xứng đáng được khen vì đã nỗ lực.","partOfSpeech":"idiom"},"A fork in the road":{"definition":"Ngã rẽ cuộc đời; bước ngoặt mang tính quyết định.","example":"When the company restructured, she found herself at a fork in the road in her professional life.","exampleTranslation":"Khi công ty tái cơ cấu, cô ấy nhận ra mình đang đứng trước ngã rẽ trong sự nghiệp.","partOfSpeech":"idiom"},"a friend in need is a friend indeed":{"definition":"Bạn lúc hoạn nạn mới là bạn chân tình; gian nan mới tỏ mặt bạn bè.","example":"She stood by me when I lost my job, proving that a friend in need is a friend indeed.","exampleTranslation":"Cô ấy đã ở bên tôi khi tôi mất việc, chứng tỏ rằng bạn trong lúc hoạn nạn mới là bạn thật sự.","partOfSpeech":"idiom"},"A good Samaritan":{"definition":"Người tốt bụng thiện nguyện; người hay giúp đỡ người khác.","example":"A good Samaritan reached out to help the elderly man who had fallen on the sidewalk.","exampleTranslation":"Một người tốt bụng đã đến giúp ông cụ bị ngã trên vỉa hè.","partOfSpeech":"idiom"},"A hang-up":{"definition":"Mặc cảm tâm lý; nỗi ám ảnh; sự lo âu vô cớ.","example":"She has a real hang-up about speaking in public.","exampleTranslation":"Cô ấy có một nỗi ám ảnh thực sự về việc nói trước đám đông.","partOfSpeech":"idiom"},"A hard nut to crack":{"definition":"Bài toán khó; vấn đề hóc búa; người khó nhằn.","example":"The math problem was a hard nut to crack, but she finally solved it.","exampleTranslation":"Bài toán đó là một vấn đề hóc búa, nhưng cuối cùng cô ấy cũng giải được.","partOfSpeech":"idiom"},"a heart of gold":{"definition":"Trái tim nhân hậu, tấm lòng vàng.","example":"Grandmother has a heart of gold and is always helping the needy in our town.","exampleTranslation":"Bà tôi có tấm lòng vàng và luôn giúp đỡ những người khó khăn trong thị trấn của chúng tôi.","partOfSpeech":"idiom"},"A hot potato":{"definition":"Củ khoai lang nóng; chủ đề nhạy cảm; vấn đề nan giải không ai muốn giải quyết.","example":"The issue of rising taxes has become a hot potato for the government.","exampleTranslation":"Vấn đề tăng thuế đã trở thành một củ khoai nóng đối với chính phủ.","partOfSpeech":"idiom"},"A kickback":{"definition":"Tiền hoa hồng bất chính; tiền hối lộ.","example":"The contractor was arrested for offering a kickback to secure the project.","exampleTranslation":"Nhà thầu bị bắt vì đưa tiền lại quả để giành được dự án.","partOfSpeech":"idiom"},"A level playing field":{"definition":"Sân chơi bình đẳng.","example":"We need to ensure a level playing field for all businesses, big and small.","exampleTranslation":"Chúng ta cần đảm bảo một sân chơi bình đẳng cho tất cả các doanh nghiệp, lớn lẫn nhỏ.","partOfSpeech":"idiom"},"A little bird told me":{"definition":"Có người tiết lộ cho tôi; nghe phong thanh rằng.","example":"A little bird told me you’re getting a promotion soon.","exampleTranslation":"Có người mách nhỏ với tôi là bạn sắp được thăng chức.","partOfSpeech":"idiom"},"A little learning is a dangerous thing":{"definition":"Nửa cái bánh mì vẫn là bánh mì, nhưng nửa sự thật thì không phải là sự thật; biết nửa vời rất nguy hiểm.","example":"He tried to fix the car himself, but a little learning is a dangerous thing — now it’s in worse condition.","exampleTranslation":"Anh ấy tự sửa xe, nhưng biết một chút mà làm thì nguy hiểm, giờ nó còn hỏng nặng hơn.","partOfSpeech":"idiom"},"A long face":{"definition":"Mặt mày ủ rũ, buồn thiu.","example":"Why the long face? Did something bad happen?","exampleTranslation":"Sao mặt mày ủ rũ vậy? Có chuyện gì không hay xảy ra à?","partOfSpeech":"idiom"},"A loose cannon":{"definition":"Kẻ bốc đồng, người khó lường dễ gây họa.","example":"He's a loose cannon and often makes impulsive decisions that get the company in trouble.","exampleTranslation":"Anh ta là kẻ khó lường, thường đưa ra những quyết định bốc đồng khiến công ty gặp rắc rối.","partOfSpeech":"idiom"},"A lucky break":{"definition":"Vận may bất ngờ, cơ hội may mắn.","example":"After years of hard work, he finally got a lucky break in his career.","exampleTranslation":"Sau nhiều năm làm việc chăm chỉ, cuối cùng anh ấy cũng gặp được cơ hội may mắn trong sự nghiệp.","partOfSpeech":"idiom"},"A lucky dog":{"definition":"Người chó ngáp phải ruồi, kẻ may mắn.","example":"He won the lottery again! What a lucky dog!","exampleTranslation":"Anh ấy lại trúng số nữa! Đúng là may mắn hết chỗ nói!","partOfSpeech":"idiom"},"A memory like a sieve":{"definition":"Trí nhớ cá vàng; não cá vàng; hay quên.","example":"My mom has a memory like a sieve and keeps forgetting where she put her keys.","exampleTranslation":"Mẹ tôi có trí nhớ như cái rây, cứ liên tục quên mất mình để chìa khóa ở đâu.","partOfSpeech":"idiom"},"A penny for your thoughts":{"definition":"Bạn đang nghĩ gì vậy? (dùng để hỏi khi thấy ai đó đang mải suy nghĩ).","example":"You’ve been awfully quiet. A penny for your thoughts?","exampleTranslation":"Bạn im lặng quá. Bạn đang nghĩ gì vậy, nói tôi nghe xem?","partOfSpeech":"idiom"},"A penny saved is a penny earned":{"definition":"Tích tiểu thành đại; tiết kiệm một đồng cũng bằng kiếm được một đồng.","example":"You don’t need that expensive gadget. Remember: A penny saved is a penny earned.","exampleTranslation":"Bạn không cần món đồ công nghệ đắt tiền đó. Hãy nhớ: tiết kiệm được đồng nào là kiếm được đồng đó.","partOfSpeech":"idiom"},"A perfect storm":{"definition":"Cơn bão hoàn hảo; tình huống tồi tệ nhất có thể xảy ra (do nhiều yếu tố bất lợi cùng lúc).","example":"The company’s financial issues, combined with the economic downturn, created a perfect storm.","exampleTranslation":"Các vấn đề tài chính của công ty, cộng với suy thoái kinh tế, đã tạo nên một cơn bão hoàn hảo.","partOfSpeech":"idiom"},"A picture is worth a thousand words":{"definition":"Một bức ảnh bằng ngàn lời nói; trăm nghe không bằng một thấy.","example":"She showed us the photos from her vacation because a picture is worth a thousand words.","exampleTranslation":"Cô ấy cho chúng tôi xem ảnh kỳ nghỉ vì một bức ảnh có giá trị hơn ngàn lời nói.","partOfSpeech":"idiom"},"A piece of cake":{"definition":"Rất dễ dàng, dễ như ăn kẹo.","example":"Fixing this bike is a piece of cake for me.","exampleTranslation":"Sửa chiếc xe đạp này đối với tôi dễ như ăn bánh.","partOfSpeech":"idiom"},"A ray of sunshine":{"definition":"Tia hy vọng; nguồn vui; người mang lại niềm vui.","example":"Her smile is like a ray of sunshine on a cloudy day.","exampleTranslation":"Nụ cười của cô ấy như một tia nắng giữa ngày u ám.","partOfSpeech":"idiom"},"a red-letter day":{"definition":"Ngày đáng nhớ, ngày trọng đại","example":"The day I got my dream job was a real red-letter day in my life.","exampleTranslation":"Ngày tôi nhận được công việc mơ ước thật sự là một ngày đáng nhớ trong đời tôi.","partOfSpeech":"idiom"},"A rip-off":{"definition":"Giá cắt cổ; trò bịp bợm móc túi.","example":"The tickets to the concert were a total rip-off.","exampleTranslation":"Vé xem buổi hòa nhạc thật sự là một vụ chặt chém.","partOfSpeech":"idiom"},"A scorcher":{"definition":"Một ngày nóng đổ lửa, nóng thiêu đốt.","example":"We picked the wrong day for a hike — it's a scorcher out there.","exampleTranslation":"Chúng ta đã chọn nhầm ngày đi bộ đường dài — ngoài kia nóng như thiêu đốt.","partOfSpeech":"idiom"},"A screw loose":{"definition":"Bị chập mạch; hâm hâm dở dở; không bình thường.","example":"I think he’s got a screw loose for jumping into that freezing water.","exampleTranslation":"Tôi nghĩ anh ta hơi khùng khi nhảy xuống làn nước lạnh cóng đó.","partOfSpeech":"idiom"},"A screwup":{"definition":"Sự thất bại thảm hại; một sai lầm nghiêm trọng (hoặc người hay làm hỏng việc).","example":"That was a major screwup on his part.","exampleTranslation":"Đó là một sai lầm nghiêm trọng của anh ta.","partOfSpeech":"idiom"},"a shoulder to cry on":{"definition":"Chỗ dựa tinh thần, người lắng nghe và an ủi tâm sự.","example":"Whenever she feels overwhelmed by life, she knows her best friend is a shoulder to cry on.","exampleTranslation":"Mỗi khi cô ấy cảm thấy bị cuộc sống đè nặng, cô ấy biết người bạn thân nhất luôn là bờ vai để tựa vào.","partOfSpeech":"idiom"},"A sledgehammer to crack a nut":{"definition":"Dùng dao mổ trâu để giết gà.","example":"Bringing in a lawyer for this minor dispute is like using a sledgehammer to crack a nut.","exampleTranslation":"Thuê luật sư cho một tranh chấp nhỏ như thế này chẳng khác nào dùng búa tạ đập hạt dẻ.","partOfSpeech":"idiom"},"A smart cookie":{"definition":"Người thông minh; người lanh lợi; người tài trí.","example":"She’s a real smart cookie and always finds a way to solve problems.","exampleTranslation":"Cô ấy là người rất thông minh và luôn tìm ra cách giải quyết vấn đề.","partOfSpeech":"idiom"},"A snowball effect":{"definition":"Hiệu ứng quả cầu tuyết (sự việc ngày càng lớn dần/nghiêm trọng hơn).","example":"Once the rumor started, it created a snowball effect and spread quickly.","exampleTranslation":"Khi tin đồn bắt đầu lan ra, nó tạo nên hiệu ứng quả cầu tuyết và lan nhanh chóng.","partOfSpeech":"idiom"},"A snowball’s chance in hell":{"definition":"Không có chút cơ hội nào; hy vọng cực kỳ mong manh.","example":"He doesn’t have a snowball’s chance in hell of passing that exam without studying.","exampleTranslation":"Anh ta không có chút cơ hội nào để qua kỳ thi đó nếu không học bài.","partOfSpeech":"idiom"},"A stitch in time saves nine":{"definition":"Phòng bệnh hơn chữa bệnh; xử lý sớm tránh phiền phức về sau.","example":"You should update the software immediately; a stitch in time saves nine.","exampleTranslation":"Bạn nên cập nhật phần mềm ngay lập tức; một mũi khâu đúng lúc tiết kiệm được chín mũi.","partOfSpeech":"idiom"},"A stone’s throw":{"definition":"Khoảng cách rất gần; chỉ cách một bước chân.","example":"The store is just a stone’s throw from my house.","exampleTranslation":"Cửa hàng chỉ cách nhà tôi một quãng ngắn.","partOfSpeech":"idiom"},"A storm in a teacup":{"definition":"Chuyện bé xé ra to; giông bão trong tách trà.","example":"The argument between them was just a storm in a teacup; it was nothing serious.","exampleTranslation":"Cuộc cãi vã giữa họ chỉ là chuyện bé xé ra to; không có gì nghiêm trọng cả.","partOfSpeech":"idiom"},"A storm is brewing":{"definition":"Giông bão sắp ập tới; rắc rối sắp xảy ra.","example":"You could tell from their argument that a storm is brewing.","exampleTranslation":"Nhìn cuộc cãi vã của họ là biết một cơn bão sắp nổ ra.","partOfSpeech":"idiom"},"A surefire way":{"definition":"Cách chắc ăn nhất; biện pháp nắm chắc phần thắng.","example":"Studying hard is a surefire way to improve your grades.","exampleTranslation":"Học chăm chỉ là cách chắc chắn để cải thiện điểm số của bạn.","partOfSpeech":"idiom"},"A sweet tooth":{"definition":"Người hảo ngọt; thích ăn đồ ngọt.","example":"She has a sweet tooth and never skips dessert.","exampleTranslation":"Cô ấy thích đồ ngọt và không bao giờ bỏ qua món tráng miệng.","partOfSpeech":"idiom"},"a tall story":{"definition":"chuyện nói khoác, chuyện khó tin","example":"He told us a tall story about how he once wrestled a bear.","exampleTranslation":"Anh ta kể cho chúng tôi nghe một câu chuyện khoác lác về việc anh ta từng vật lộn với một con gấu.","partOfSpeech":"idiom"},"A toss-up":{"definition":"Khả năng 50-50; hên xui; ngang tài ngang sức.","example":"Who will win the election? At this point, it’s a toss-up.","exampleTranslation":"Ai sẽ thắng cuộc bầu cử? Lúc này thì khó đoán lắm, khả năng ngang nhau.","partOfSpeech":"idiom"},"A walk in the park":{"definition":"Dễ như ăn bánh, chuyện nhỏ","example":"Fixing the computer was a walk in the park for him.","exampleTranslation":"Sửa chiếc máy tính đối với anh ấy dễ như đi dạo trong công viên.","partOfSpeech":"idiom"},"a wet blanket":{"definition":"Kẻ phá đám, người làm mất hứng (kẻ dội gáo nước lạnh vào cuộc vui).","example":"Do not invite Mark to the beach party; he is such a wet blanket.","exampleTranslation":"Đừng mời Mark đến bữa tiệc trên bãi biển; anh ta là kẻ phá đám.","partOfSpeech":"idiom"},"A wolf in sheep's clothing":{"definition":"Sói đội lốt cừu, kẻ tâm địa hiểm độc giả dạng người hiền lành","example":"The new CEO was a wolf in sheep's clothing, pretending to care about employees while planning massive layoffs.","exampleTranslation":"Vị CEO mới là sói đội lốt cừu, giả vờ quan tâm đến nhân viên trong khi lên kế hoạch sa thải hàng loạt.","partOfSpeech":"idiom"},"Absentminded":{"definition":"Đãng trí; lơ đãng; đểnh đoảng.","example":"He’s always so absentminded; he forgot his keys again.","exampleTranslation":"Anh ấy lúc nào cũng đãng trí; anh ấy lại quên chìa khóa rồi.","partOfSpeech":"idiom"},"Ace in the hole":{"definition":"Vũ khí bí mật, quân bài tẩy có thể xoay chuyển tình thế vào phút chót.","example":"His experience in negotiating is his ace in the hole during business meetings.","exampleTranslation":"Kinh nghiệm đàm phán là con át chủ bài của anh ấy trong các cuộc họp kinh doanh.","partOfSpeech":"idiom"},"Ace up the sleeve":{"definition":"Bảo bối giấu kín, vũ khí bí mật.","example":"He thought he had lost, but then he pulled an ace up his sleeve and won the game.","exampleTranslation":"Anh ta tưởng mình đã thua, nhưng rồi lại tung ra con át chủ bài giấu trong tay áo và thắng ván đó.","partOfSpeech":"idiom"},"Achilles’ heel":{"definition":"Điểm yếu chí mạng, gót chân Achilles.","example":"The software is great, but its security issues are its Achilles’ heel.","exampleTranslation":"Phần mềm này rất tốt, nhưng các vấn đề bảo mật chính là gót chân Achilles của nó.","partOfSpeech":"idiom"},"Acid test":{"definition":"Phép thử quyết định, bài kiểm tra gắt gao nhất để xác định giá trị thật.","example":"Facing a crisis is often the acid test of true leadership.","exampleTranslation":"Đối mặt với khủng hoảng thường là phép thử thực sự của khả năng lãnh đạo.","partOfSpeech":"idiom"},"Across the board":{"definition":"Toàn diện, đồng loạt, áp dụng cho mọi người hoặc mọi khía cạnh.","example":"The company announced a 10% salary increase across the board for all employees.","exampleTranslation":"Công ty thông báo tăng lương 10% cho tất cả nhân viên.","partOfSpeech":"idiom"},"action speaks louder than words":{"definition":"Hành động có ý nghĩa hơn lời nói; nói đi đôi với làm.","example":"He promised to change, but actions speak louder than words.","exampleTranslation":"Anh ta hứa sẽ thay đổi, nhưng hành động có sức nặng hơn lời nói.","partOfSpeech":"idiom"},"Actions Speak Louder Than Words":{"definition":"Hành động có giá trị hơn lời nói, nói ít làm nhiều.","example":"He keeps promising to help, but actions speak louder than words; so far, he hasn’t done anything.","exampleTranslation":"Anh ta cứ hứa sẽ giúp, nhưng hành động có sức nặng hơn lời nói; cho đến giờ anh ta vẫn chưa làm gì.","partOfSpeech":"idiom"},"Add fuel to the fire":{"definition":"Thêm dầu vào lửa, đổ thêm dầu vào lửa.","example":"His comments only added fuel to the fire during the argument.","exampleTranslation":"Những lời bình luận của anh ta chỉ đổ thêm dầu vào lửa trong cuộc tranh cãi.","partOfSpeech":"idiom"},"Add insult to injury":{"definition":"Xát muối vào vết thương, đổ thêm dầu vào lửa.","example":"After losing the game, the team’s captain criticized the players, adding insult to injury.","exampleTranslation":"Sau khi thua trận, đội trưởng chỉ trích các cầu thủ, khiến tình hình càng thêm tồi tệ.","partOfSpeech":"idiom"},"Against the clock":{"definition":"Chạy đua với thời gian.","example":"We are working against the clock to meet the project deadline.","exampleTranslation":"Chúng tôi đang chạy đua với thời gian để kịp hạn chót của dự án.","partOfSpeech":"idiom"},"Ahead of schedule":{"definition":"Sớm hơn dự kiến, vượt tiến độ.","example":"We finished the project ahead of schedule, so we can start the next phase early.","exampleTranslation":"Chúng tôi đã hoàn thành dự án trước thời hạn, nên có thể bắt đầu giai đoạn tiếp theo sớm.","partOfSpeech":"idiom"},"ahead of time":{"definition":"Trước thời hạn, sớm hơn lịch trình.","example":"She completed the project two days ahead of time and impressed the client.","exampleTranslation":"Cô ấy hoàn thành dự án sớm hai ngày và gây ấn tượng với khách hàng.","partOfSpeech":"idiom"},"All bark and no bite":{"definition":"Khẩu xà tâm phật, thùng rỗng kêu to (chỉ đe dọa chứ không hành động).","example":"Don’t be afraid of him; he’s all bark and no bite.","exampleTranslation":"Đừng sợ anh ta; anh ta chỉ được cái mạnh miệng chứ không dám làm gì.","partOfSpeech":"idiom"},"All bets are off":{"definition":"Mọi chuyện đều có thể xảy ra, không thể đoán trước được điều gì nữa.","example":"Once the CEO resigned, all bets are off regarding the company’s future.","exampleTranslation":"Một khi CEO từ chức, mọi dự đoán về tương lai công ty đều không còn chắc chắn.","partOfSpeech":"idiom"},"all ears":{"definition":"Lắng tai nghe, chăm chú lắng nghe.","example":"Tell me all about your trip to Paris; I am all ears!","exampleTranslation":"Hãy kể cho tôi nghe tất cả về chuyến đi Paris của bạn; tôi đang rất chăm chú lắng nghe đây!","partOfSpeech":"idiom"},"All Greek to me":{"definition":"Như vịt nghe sấm, hoàn toàn không hiểu gì cả.","example":"When they started discussing quantum physics, it was all Greek to me.","exampleTranslation":"Khi họ bắt đầu bàn về vật lý lượng tử, tôi hoàn toàn không hiểu gì cả.","partOfSpeech":"idiom"},"All heart":{"definition":"Rất tốt bụng, có trái tim nhân hậu.","example":"She’s all heart, always helping those in need.","exampleTranslation":"Cô ấy rất giàu lòng nhân ái, luôn giúp đỡ những người gặp khó khăn.","partOfSpeech":"idiom"},"all in all":{"definition":"Nhìn chung, tóm lại, sau khi xét mọi khía cạnh.","example":"All in all, the annual conference was a tremendous success.","exampleTranslation":"Nhìn chung, hội nghị thường niên đã thành công rực rỡ.","partOfSpeech":"idiom"},"All in the same boat":{"definition":"Cùng chung hội chung thuyền, cùng cảnh ngộ.","example":"During the pandemic, we were all in the same boat, trying to adjust to new norms.","exampleTranslation":"Trong thời kỳ đại dịch, tất cả chúng ta đều cùng chung cảnh ngộ, cố gắng thích nghi với những chuẩn mực mới.","partOfSpeech":"idiom"},"All kidding aside":{"definition":"Nói nghiêm túc nhé, đùa thế đủ rồi.","example":"All kidding aside, we really need to focus and finish this project by Friday.","exampleTranslation":"Đùa thì đùa, chúng ta thực sự cần tập trung và hoàn thành dự án này trước thứ Sáu.","partOfSpeech":"idiom"},"All over the map":{"definition":"Lung tung, không có định hướng rõ ràng, lan man.","example":"Her speech was all over the map, covering too many unrelated topics.","exampleTranslation":"Bài phát biểu của cô ấy lan man, đề cập quá nhiều chủ đề không liên quan.","partOfSpeech":"idiom"},"All set":{"definition":"Đã sẵn sàng, đã chuẩn bị xong.","example":"We’re all set for the trip. Did you pack your bag?","exampleTranslation":"Chúng tôi đã sẵn sàng cho chuyến đi. Bạn đã đóng gói túi chưa?","partOfSpeech":"idiom"},"All thumbs":{"definition":"Vụng về, lóng ngóng.","example":"He’s all thumbs in the kitchen and always makes a mess.","exampleTranslation":"Anh ấy vụng về tay chân trong bếp và luôn làm bừa bộn.","partOfSpeech":"idiom"},"All wet":{"definition":"Hoàn toàn sai lầm.","example":"He’s all wet if he thinks the boss will approve that plan.","exampleTranslation":"Anh ta nhầm to nếu nghĩ rằng sếp sẽ chấp thuận kế hoạch đó.","partOfSpeech":"idiom"},"Along for the ride":{"definition":"Đi theo cho vui, tham gia mà không đóng vai trò gì.","example":"He wasn’t an active participant in the project; he was just along for the ride.","exampleTranslation":"Anh ấy không phải là người tham gia tích cực trong dự án; anh ấy chỉ đi theo cho vui.","partOfSpeech":"idiom"},"An about-face":{"definition":"Sự thay đổi 180 độ (ý kiến, kế hoạch).","example":"The company did an about-face on its policy after the customer backlash.","exampleTranslation":"Công ty đã đảo ngược hoàn toàn chính sách của mình sau phản ứng dữ dội từ khách hàng.","partOfSpeech":"idiom"},"An albatross around my neck":{"definition":"Gánh nặng đeo bám, của nợ.","example":"His criminal record is an albatross around his neck, stopping him from getting a job.","exampleTranslation":"Tiền án tiền sự là gánh nặng đeo bám anh ta, khiến anh ta không thể kiếm được việc làm.","partOfSpeech":"idiom"},"An apple a day keeps the doctor away":{"definition":"Mỗi ngày một quả táo, cả đời không phải gặp bác sĩ (ăn uống lành mạnh giúp khỏe mạnh).","example":"An apple a day keeps the doctor away.","exampleTranslation":"Mỗi ngày một quả táo giúp bạn tránh xa bác sĩ.","partOfSpeech":"idiom"},"An old head on young shoulders":{"definition":"Trẻ người non dạ nhưng suy nghĩ thấu đáo; già dặn trước tuổi.","example":"Despite being only 12, she speaks with the wisdom of someone many years older, truly an old head on young shoulders.","exampleTranslation":"Dù mới 12 tuổi, cô bé nói chuyện chín chắn như người lớn hơn mình nhiều tuổi.","partOfSpeech":"idiom"},"An old soul":{"definition":"Người có tâm hồn già cỗi, chín chắn và sâu sắc trước tuổi.","example":"His thoughtful and introspective nature makes everyone see him as an old soul.","exampleTranslation":"Bản tính chín chắn và hay suy tư của anh ấy khiến mọi người xem anh ấy như một tâm hồn già dặn.","partOfSpeech":"idiom"},"an old wives' tale":{"definition":"Quan niệm mê tín dân gian vô căn cứ, chuyện truyền miệng thất thiệt.","example":"The idea that eating carrots gives you night vision is mostly an old wives' tale.","exampleTranslation":"Quan niệm rằng ăn cà rốt giúp nhìn rõ trong bóng tối chủ yếu chỉ là chuyện truyền miệng không có căn cứ.","partOfSpeech":"idiom"},"An open book":{"definition":"Người dễ đoán, không giấu giếm điều gì.","example":"Unlike her sister, Sarah is an open book and shares everything about her life.","exampleTranslation":"Không như chị gái, Sarah là người cởi mở và chia sẻ mọi thứ về cuộc sống của mình.","partOfSpeech":"idiom"},"An ounce of prevention is worth a pound of cure":{"definition":"Phòng bệnh hơn chữa bệnh.","example":"She always follows the saying 'an ounce of prevention is worth a pound of cure' by keeping her house well-maintained.","exampleTranslation":"Cô ấy luôn theo câu nói phòng bệnh hơn chữa bệnh bằng cách giữ cho ngôi nhà luôn được bảo trì tốt.","partOfSpeech":"idiom"},"apple of my eye":{"definition":"Báu vật / cục cưng / người được yêu thương cưng chiều nhất.","example":"His little granddaughter is the apple of his eye.","exampleTranslation":"Cô cháu gái bé nhỏ của ông là con ngươi trong mắt ông.","partOfSpeech":"idiom"},"Are you kidding me?":{"definition":"Cậu đang đùa mình đấy à?","example":"Are you kidding me? There’s no way she finished that project in one day.","exampleTranslation":"Bạn đùa tôi à? Không đời nào cô ấy hoàn thành dự án đó trong một ngày.","partOfSpeech":"idiom"},"Armchair quarterback":{"definition":"Người giỏi phán xét sau khi sự việc đã rồi (chuyên gia chém gió).","example":"It’s easy to be an armchair quarterback when you’re not the one making the tough decisions.","exampleTranslation":"Làm người ngồi ngoài chỉ trỏ thì dễ khi bạn không phải là người đưa ra những quyết định khó khăn.","partOfSpeech":"idiom"},"Armed to the teeth":{"definition":"Trang bị tận răng, vũ trang đầy đủ.","example":"He entered the meeting armed to the teeth with data and reports.","exampleTranslation":"Anh ấy bước vào cuộc họp với đầy đủ dữ liệu và báo cáo trong tay.","partOfSpeech":"idiom"},"around the clock":{"definition":"Suốt ngày đêm không ngừng nghỉ, 24/7.","example":"Rescue teams worked around the clock to clear the debris and find survivors.","exampleTranslation":"Các đội cứu hộ làm việc suốt ngày đêm để dọn đống đổ nát và tìm người sống sót.","partOfSpeech":"idiom"},"Around-the-clock":{"definition":"Suốt ngày đêm, 24/24.","example":"The tech team is working around-the-clock to fix the server issues.","exampleTranslation":"Nhóm kỹ thuật đang làm việc không ngừng nghỉ để khắc phục sự cố máy chủ.","partOfSpeech":"idiom"},"As busy as a bee":{"definition":"Bận rộn tối mắt tối mũi, bận rộn như ong.","example":"She was as busy as a bee organizing the event.","exampleTranslation":"Cô ấy bận rộn như ong khi tổ chức sự kiện.","partOfSpeech":"idiom"},"as cool as a cucumber":{"definition":"Điềm tĩnh như không, cực kỳ bình tĩnh và tỉnh táo.","example":"Even under intense pressure during the live interview, the politician remained as cool as a cucumber.","exampleTranslation":"Ngay cả khi chịu áp lực lớn trong buổi phỏng vấn trực tiếp, chính trị gia đó vẫn bình tĩnh như không.","partOfSpeech":"idiom"},"As easy as ABC":{"definition":"Dễ như trở bàn tay, dễ như ăn kẹo.","example":"Learning how to use this phone is as easy as ABC.","exampleTranslation":"Học cách sử dụng chiếc điện thoại này dễ như bảng chữ cái.","partOfSpeech":"idiom"},"As easy as pie":{"definition":"Dễ như ăn bánh, dễ như trở bàn tay.","example":"Fixing the computer was as easy as pie for her.","exampleTranslation":"Sửa chiếc máy tính này đối với cô ấy dễ như ăn bánh.","partOfSpeech":"idiom"},"As genuine as a three-dollar bill":{"definition":"Giả tạo, hoàn toàn không đáng tin.","example":"His apology was as genuine as a three-dollar bill.","exampleTranslation":"Lời xin lỗi của anh ta giả tạo hết sức.","partOfSpeech":"idiom"},"As happy as a clam":{"definition":"Cực kỳ vui sướng và mãn nguyện.","example":"After getting the promotion, he was as happy as a clam.","exampleTranslation":"Sau khi được thăng chức, anh ấy vui như mở cờ trong bụng.","partOfSpeech":"idiom"},"As quiet as a mouse":{"definition":"Im lặng như tờ, im lặng như chuột.","example":"She was as quiet as a mouse when sneaking into the kitchen for a midnight snack.","exampleTranslation":"Cô ấy im lặng như chuột khi rón rén vào bếp ăn đêm.","partOfSpeech":"idiom"},"As rare as hen’s teeth":{"definition":"Hiếm như lá mùa thu, vô cùng quý hiếm.","example":"Honest politicians are as rare as hen’s teeth these days.","exampleTranslation":"Những chính trị gia trung thực ngày nay hiếm như lông rùa sừng thỏ.","partOfSpeech":"idiom"},"As right as rain":{"definition":"Khỏe mạnh trở lại, hoàn toàn ổn thỏa.","example":"After a few days of rest, I’m feeling as right as rain.","exampleTranslation":"Sau vài ngày nghỉ ngơi, tôi cảm thấy khỏe khoắn hẳn.","partOfSpeech":"idiom"},"As the crow flies":{"definition":"Đường chim bay.","example":"The village is about 10 miles away as the crow flies.","exampleTranslation":"Ngôi làng cách đây khoảng 10 dặm theo đường chim bay.","partOfSpeech":"idiom"},"As white as a sheet/as white as a ghost":{"definition":"Trắng bệch như tờ giấy (vì sợ hãi, bệnh tật).","example":"When she heard the news, she turned as white as a sheet.","exampleTranslation":"Khi nghe tin đó, cô ấy tái mét mặt mày.","partOfSpeech":"idiom"},"At best":{"definition":"Tốt nhất là, cùng lắm là.","example":"At best, the project will be completed by next month.","exampleTranslation":"Tốt nhất thì dự án sẽ hoàn thành vào tháng tới.","partOfSpeech":"idiom"},"At least":{"definition":"Ít nhất thì, chí ít.","example":"We were late, but at least we got to see the end of the movie.","exampleTranslation":"Chúng tôi đến muộn, nhưng ít nhất cũng được xem đoạn cuối của bộ phim.","partOfSpeech":"idiom"},"At loggerheads":{"definition":"Bất đồng gay gắt, mâu thuẫn đối đầu.","example":"The two politicians have been at loggerheads over the new policy.","exampleTranslation":"Hai chính trị gia đó đang bất đồng gay gắt về chính sách mới.","partOfSpeech":"idiom"},"At my wits’ end":{"definition":"Bó tay, hết cách, không biết làm sao nữa.","example":"After trying everything to get the project back on track, I’m at my wits’ end.","exampleTranslation":"Sau khi thử mọi cách để đưa dự án trở lại đúng hướng, tôi đã hết cách rồi.","partOfSpeech":"idiom"},"At the bottom of the totem pole":{"definition":"Ở vị trí thấp kém nhất, dưới đáy xã hội/tổ chức.","example":"As a new intern, I started at the bottom of the totem pole.","exampleTranslation":"Là thực tập sinh mới, tôi bắt đầu từ vị trí thấp nhất.","partOfSpeech":"idiom"},"At the crack of dawn":{"definition":"Vào lúc bình minh, sáng sớm tinh mơ.","example":"Farmers often wake up at the crack of dawn to tend to their fields.","exampleTranslation":"Nông dân thường thức dậy từ tờ mờ sáng để chăm sóc đồng ruộng.","partOfSpeech":"idiom"},"At the drop of a hat":{"definition":"Ngay lập tức, không do dự.","example":"He would help his friends at the drop of a hat.","exampleTranslation":"Anh ấy sẵn sàng giúp bạn bè ngay lập tức không chút do dự.","partOfSpeech":"idiom"},"At the end of your rope":{"definition":"Tới giới hạn chịu đựng, không thể chịu nổi nữa.","example":"I’m really at the end of my rope with this project; nothing seems to work.","exampleTranslation":"Tôi thực sự đã đến giới hạn chịu đựng với dự án này; dường như chẳng có gì hiệu quả.","partOfSpeech":"idiom"},"At-large":{"definition":"tự do, chưa bị bắt (tội phạm); đại diện cho toàn khu vực bầu cử","example":"The criminal is still at-large and considered dangerous.","exampleTranslation":"Tên tội phạm vẫn đang trốn thoát và bị coi là nguy hiểm.","partOfSpeech":"idiom"},"Baby boomer":{"definition":"người sinh ra trong thời kỳ bùng nổ dân số (1946-1964)","example":"Many baby boomers are now reaching retirement age.","exampleTranslation":"Nhiều người thuộc thế hệ bùng nổ dân số hiện đã đến tuổi nghỉ hưu.","partOfSpeech":"idiom"},"back on one's feet":{"definition":"Phục hồi, đứng vững trở lại (sau bạo bệnh hoặc khó khăn tài chính).","example":"After two weeks in the hospital, he is finally back on his feet.","exampleTranslation":"Sau hai tuần ở bệnh viện, cuối cùng anh ấy cũng đã hồi phục.","partOfSpeech":"idiom"},"Back to basics":{"definition":"quay về những điều cơ bản, cốt lõi","example":"When things get too complicated, it’s important to go back to basics.","exampleTranslation":"Khi mọi thứ trở nên quá phức tạp, điều quan trọng là quay lại những điều cơ bản.","partOfSpeech":"idiom"},"Back to square one":{"definition":"trở lại điểm xuất phát, làm lại từ đầu","example":"We took the wrong approach with this project, so it’s back to square one.","exampleTranslation":"Chúng ta đã chọn sai cách tiếp cận với dự án này, nên giờ phải bắt đầu lại từ đầu.","partOfSpeech":"idiom"},"Back to the drawing board":{"definition":"bắt đầu lại từ đầu, vạch lại kế hoạch mới","example":"The initial plan didn’t work, so it’s back to the drawing board.","exampleTranslation":"Kế hoạch ban đầu không hiệu quả, nên phải quay lại làm lại từ đầu.","partOfSpeech":"idiom"},"Backhanded compliment":{"definition":"lời khen ẩn ý chê bai, lời khen đểu","example":"When he told me my cooking was surprisingly good, I knew it was a backhanded compliment.","exampleTranslation":"Khi anh ấy nói món ăn tôi nấu ngon đến bất ngờ, tôi biết đó là lời khen có ẩn ý chê bai.","partOfSpeech":"idiom"},"Backseat driver":{"definition":"người ngồi sau chỉ đạo tài xế; người thích can thiệp vào việc của người khác","example":"Stop being a backseat driver and let me handle this.","exampleTranslation":"Đừng làm người chỉ đạo từ ghế sau nữa và để tôi xử lý việc này.","partOfSpeech":"idiom"},"bad apple":{"definition":"Con sâu làm rầu nồi canh; kẻ xấu làm ảnh hưởng cả tập thể.","example":"One bad apple in the sales team was spreading false rumors and damaging morale.","exampleTranslation":"Một con sâu trong đội bán hàng đã lan truyền tin đồn thất thiệt và làm giảm tinh thần của mọi người.","partOfSpeech":"idiom"},"Bad blood":{"definition":"sự thù hằn, hiềm khích","example":"Even after all these years, there’s still bad blood between them.","exampleTranslation":"Ngay cả sau ngần ấy năm, giữa họ vẫn còn mối hiềm khích.","partOfSpeech":"idiom"},"Bad hair day":{"definition":"một ngày tồi tệ, xui xẻo","example":"I’m having a bad hair day; everything is going wrong.","exampleTranslation":"Hôm nay tôi gặp ngày xui xẻo; mọi thứ đều không suôn sẻ.","partOfSpeech":"idiom"},"Band-Aid on a bullet wound":{"definition":"biện pháp tạm thời, không giải quyết được gốc rễ vấn đề nghiêm trọng","example":"Offering temporary shelter to the homeless is just a Band-Aid on a bullet wound. We need a long-term solution.","exampleTranslation":"Cho người vô gia cư chỗ ở tạm thời chỉ là biện pháp chữa cháy hời hợt. Chúng ta cần một giải pháp lâu dài.","partOfSpeech":"idiom"},"Barking up the wrong tree":{"definition":"đoán sai, nhầm lẫn, đi chệch hướng","example":"If you think I was the one who broke the vase, you’re barking up the wrong tree.","exampleTranslation":"Nếu bạn nghĩ tôi là người làm vỡ cái bình thì bạn đang trách nhầm người rồi.","partOfSpeech":"idiom"},"Batting a thousand":{"definition":"thành công rực rỡ, làm việc gì cũng trót lọt","example":"He’s been batting a thousand with his business deals lately.","exampleTranslation":"Dạo gần đây anh ấy làm ăn thành công liên tiếp, lần nào cũng thắng.","partOfSpeech":"idiom"},"Be beside oneself":{"definition":"Không kiềm chế được cảm xúc; Quá kích động","example":"The mother was beside herself with worry when her child went missing.","exampleTranslation":"Người mẹ lo lắng đến mức mất bình tĩnh khi con bị mất tích.","partOfSpeech":"idiom"},"Be close-fisted":{"definition":"Keo kiệt; Bủn xỉn","example":"It’s difficult to be friends with someone so closefisted.","exampleTranslation":"Thật khó để làm bạn với một người hà tiện như vậy.","partOfSpeech":"idiom"},"Be loaded":{"definition":"Nhiều tiền; Giàu sụ","example":"They must be loaded if they can afford such a house.","exampleTranslation":"Họ chắc phải giàu lắm mới có đủ tiền mua một ngôi nhà như vậy.","partOfSpeech":"idiom"},"Be my guest":{"definition":"cứ tự nhiên, xin mời","example":"If you need to use my phone, be my guest.","exampleTranslation":"Nếu bạn cần dùng điện thoại của tôi, cứ tự nhiên.","partOfSpeech":"idiom"},"Be named after":{"definition":"Được đặt tên theo","example":"The new building was named after the founder of the company.","exampleTranslation":"Tòa nhà mới được đặt theo tên người sáng lập công ty.","partOfSpeech":"idiom"},"Be out of the question":{"definition":"Không thể xảy ra; Miễn bàn","example":"Skipping the final exam is simply out of the question if you want to pass the course.","exampleTranslation":"Bỏ kỳ thi cuối kỳ là điều hoàn toàn không thể nếu bạn muốn qua môn.","partOfSpeech":"idiom"},"be the talk of the town":{"definition":"chủ đề bàn tán của mọi người, tâm điểm chú ý","example":"The new restaurant is the talk of the town.","exampleTranslation":"Nhà hàng mới đang là chủ đề bàn tán của cả thị trấn.","partOfSpeech":"idiom"},"Be thrown together":{"definition":"Bị đẩy vào tình thế phải làm việc cùng nhau","example":"The new project required people from different departments, so they were thrown together.","exampleTranslation":"Dự án mới cần người từ nhiều phòng ban khác nhau, nên họ bị xếp chung vào một nhóm.","partOfSpeech":"idiom"},"Be tied up":{"definition":"Bận rộn tối mắt tối mũi","example":"I’m tied up with work right now and can’t meet for lunch.","exampleTranslation":"Hiện tại tôi đang bận việc nên không thể gặp ăn trưa được.","partOfSpeech":"idiom"},"Be up to something":{"definition":"Đang ấp ủ âm mưu; Đang tính toán gì đó","example":"He’s been acting strange lately; I wonder if he’s up to something.","exampleTranslation":"Dạo này anh ấy cư xử kỳ lạ; tôi tự hỏi liệu anh ấy có đang âm mưu gì không.","partOfSpeech":"idiom"},"bear in mind":{"definition":"Ghi nhớ, lưu tâm, ghi nhớ trong đầu.","example":"Bear in mind that the museum closes early on Sunday afternoons.","exampleTranslation":"Hãy nhớ rằng bảo tàng đóng cửa sớm vào các buổi chiều Chủ nhật.","partOfSpeech":"idiom"},"Bear in mind/keep in mind":{"definition":"ghi nhớ, lưu ý rằng","example":"Bear in mind that the deadline is next Monday.","exampleTranslation":"Hãy nhớ rằng hạn chót là thứ Hai tuần tới.","partOfSpeech":"idiom"},"Beat a hasty retreat":{"definition":"rút lui nhanh chóng, bỏ chạy","example":"When the fire alarm went off, everyone beat a hasty retreat from the building.","exampleTranslation":"Khi chuông báo cháy vang lên, mọi người vội vã rút khỏi tòa nhà.","partOfSpeech":"idiom"},"Beat around the bush":{"definition":"nói vòng vo, không đi thẳng vào vấn đề","example":"Stop beating around the bush and tell me what happened.","exampleTranslation":"Đừng vòng vo nữa và hãy nói cho tôi biết chuyện gì đã xảy ra.","partOfSpeech":"idiom"},"Beat someone to the draw":{"definition":"nhanh tay hơn ai đó, giành phần trước","example":"I wanted to buy that last ticket, but someone beat me to the draw.","exampleTranslation":"Tôi muốn mua chiếc vé cuối cùng đó, nhưng có người đã nhanh tay hơn tôi.","partOfSpeech":"idiom"},"Beat someone to the punch":{"definition":"đi trước một bước, nẫng tay trên","example":"We planned to release the new product next month, but our competitors beat us to the punch.","exampleTranslation":"Chúng tôi dự định ra mắt sản phẩm mới vào tháng tới, nhưng đối thủ cạnh tranh đã nhanh chân hơn chúng tôi.","partOfSpeech":"idiom"},"Beat the band":{"definition":"Vô cùng; Hết sức","example":"They celebrated to beat the band when their team won the championship.","exampleTranslation":"Họ ăn mừng hết cỡ khi đội của họ giành chức vô địch.","partOfSpeech":"idiom"},"Beat the bushes":{"definition":"tìm kiếm khắp nơi, lùng sục","example":"We’ve been beating the bushes for the best candidate for the job.","exampleTranslation":"Chúng tôi đã tìm kiếm khắp nơi ứng viên tốt nhất cho công việc này.","partOfSpeech":"idiom"},"beat the clock":{"definition":"Chạy đua với thời gian để hoàn thành kịp trước hạn chót.","example":"She sprinted to the post office and beat the clock just two minutes before closing.","exampleTranslation":"Cô ấy chạy nước rút đến bưu điện và kịp giờ chỉ hai phút trước khi đóng cửa.","partOfSpeech":"idiom"},"Beating a dead horse":{"definition":"làm chuyện vô ích, phí công vô ích","example":"We need to move on to new ideas instead of beating a dead horse with the old ones.","exampleTranslation":"Chúng ta cần chuyển sang những ý tưởng mới thay vì cứ nhai đi nhai lại những ý tưởng cũ vô ích.","partOfSpeech":"idiom"},"Beating around the bush":{"definition":"vòng vo tam quốc, lảng tránh vấn đề chính","example":"Stop beating around the bush and tell me what you really think.","exampleTranslation":"Đừng vòng vo nữa và hãy nói cho tôi biết bạn thực sự nghĩ gì.","partOfSpeech":"idiom"},"beats me":{"definition":"Tôi chịu thôi, tôi hoàn toàn không biết.","example":"\"Why is the printer not working again?\" \"Beats me, it was fine an hour ago.\"","exampleTranslation":"\"Sao máy in lại không hoạt động nữa vậy?\" \"Tôi cũng chịu, một tiếng trước vẫn còn tốt mà.\"","partOfSpeech":"idiom"},"Bed head":{"definition":"tóc rối bù sau khi ngủ dậy","example":"I looked in the mirror and saw bed head like never before.","exampleTranslation":"Tôi nhìn vào gương và thấy mái tóc rối bù hơn bao giờ hết.","partOfSpeech":"idiom"},"Bed of roses":{"definition":"cuộc sống trải hoa hồng, hoàn cảnh dễ chịu và sung sướng","example":"Life is not always a bed of roses; sometimes, you have to face challenges.","exampleTranslation":"Cuộc sống không phải lúc nào cũng trải đầy hoa hồng; đôi khi bạn phải đối mặt với thử thách.","partOfSpeech":"idiom"},"Before you know it":{"definition":"chẳng mấy chốc, nháy mắt đã đến","example":"The kids grow up so fast; before you know it, they’re off to college.","exampleTranslation":"Bọn trẻ lớn nhanh quá; chớp mắt một cái là chúng đã đi học đại học rồi.","partOfSpeech":"idiom"},"Behind someone’s back":{"definition":"sau lưng ai đó, lén lút","example":"She talked about her friend behind her back, which caused a lot of tension.","exampleTranslation":"Cô ấy nói xấu bạn mình sau lưng, điều đó gây ra nhiều căng thẳng.","partOfSpeech":"idiom"},"Behind the eight ball":{"definition":"ở thế bất lợi, trong tình thế khó khăn","example":"He’s really behind the eight ball at work since he missed the deadline.","exampleTranslation":"Anh ấy thực sự đang ở thế bất lợi trong công việc vì đã trễ hạn chót.","partOfSpeech":"idiom"},"behind the times":{"definition":"Lạc hậu, lỗi thời, cổ lỗ sĩ.","example":"Their company policy on remote work is completely behind the times.","exampleTranslation":"Chính sách làm việc từ xa của công ty họ hoàn toàn lạc hậu.","partOfSpeech":"idiom"},"Belt and suspenders":{"definition":"cẩn tắc vô áy náy, dùng nhiều biện pháp an toàn cùng lúc","example":"He’s using a belt and suspenders approach to make sure the project succeeds.","exampleTranslation":"Anh ấy đang dùng cách làm thật chắc chắn để đảm bảo dự án thành công.","partOfSpeech":"idiom"},"Bend over backward":{"definition":"cố gắng hết sức, nhượng bộ tối đa để giúp ai","example":"They bent over backward to provide excellent customer service.","exampleTranslation":"Họ đã hết sức chiều khách để mang đến dịch vụ khách hàng xuất sắc.","partOfSpeech":"idiom"},"Bend someone's ear":{"definition":"Nói lải nhải vào tai ai; Nói chuyện dông dài","example":"I hate when people try to bend my ear about things I have no control over.","exampleTranslation":"Tôi ghét khi người ta cứ lải nhải với tôi về những chuyện tôi không thể kiểm soát.","partOfSpeech":"idiom"},"Bent out of shape":{"definition":"nổi giận, vô cùng bực tức","example":"Don’t get bent out of shape over something so trivial.","exampleTranslation":"Đừng cáu giận vì một chuyện nhỏ nhặt như vậy.","partOfSpeech":"idiom"},"Beside oneself":{"definition":"mất tự chủ vì cảm xúc (vui, buồn, giận...)","example":"She was beside herself with joy when she heard the news.","exampleTranslation":"Cô ấy vui mừng khôn xiết khi nghe tin đó.","partOfSpeech":"idiom"},"Beside the point":{"definition":"không liên quan, lạc đề","example":"What you’re saying is interesting, but it’s beside the point.","exampleTranslation":"Điều bạn nói rất thú vị, nhưng nó lạc đề rồi.","partOfSpeech":"idiom"},"Bestie":{"definition":"bạn thân, bạn chí cốt","example":"My bestie and I are going on a road trip this weekend.","exampleTranslation":"Bạn thân của tôi và tôi sẽ đi phượt vào cuối tuần này.","partOfSpeech":"idiom"},"Bet the ranch":{"definition":"đánh cược tất cả, được ăn cả ngã về không","example":"He’s willing to bet the ranch on this new business venture.","exampleTranslation":"Anh ấy sẵn sàng đặt cược tất cả vào dự án kinh doanh mới này.","partOfSpeech":"idiom"},"Better late than never":{"definition":"muộn còn hơn không","example":"He finally finished the project. Better late than never.","exampleTranslation":"Cuối cùng anh ấy cũng hoàn thành dự án. Muộn còn hơn không.","partOfSpeech":"idiom"},"Between a rock and a hard place":{"definition":"tiến thoái lưỡng nan, ở thế kẹt","example":"She felt like she was between a rock and a hard place when deciding whether to quit her job or stay in a toxic environment.","exampleTranslation":"Cô ấy cảm thấy tiến thoái lưỡng nan khi phải quyết định nghỉ việc hay ở lại một môi trường độc hại.","partOfSpeech":"idiom"},"Between the devil and the deep blue sea":{"definition":"tiến thoái lưỡng nan, tránh vỏ dưa gặp vỏ dừa","example":"John found himself between the devil and the deep blue sea when he had to choose between a pay cut or losing his job entirely.","exampleTranslation":"John rơi vào thế tiến thoái lưỡng nan khi phải chọn giữa bị cắt lương hoặc mất việc hoàn toàn.","partOfSpeech":"idiom"},"Beyond the pale":{"definition":"quá đáng, không thể chấp nhận được","example":"His comments during the meeting were beyond the pale.","exampleTranslation":"Những lời bình luận của anh ta trong cuộc họp đã vượt quá giới hạn chấp nhận được.","partOfSpeech":"idiom"},"Big cheese":{"definition":"nhân vật tai to mặt lớn, sếp sỏ","example":"He’s the big cheese in our department, and all major decisions go through him.","exampleTranslation":"Anh ấy là nhân vật quyền lực nhất trong phòng ban của chúng tôi, và mọi quyết định lớn đều phải qua anh ấy.","partOfSpeech":"idiom"},"Big fish in a small pond":{"definition":"ếch ngồi đáy giếng, nhân vật quan trọng trong một môi trường nhỏ","example":"Susan feels like a big fish in a small pond at her current job, but she’s considering moving to a larger company.","exampleTranslation":"Susan cảm thấy mình như cá lớn trong ao nhỏ ở công việc hiện tại, nhưng cô ấy đang cân nhắc chuyển sang một công ty lớn hơn.","partOfSpeech":"idiom"},"Big shot":{"definition":"nhân vật quan trọng, người có thế lực","example":"Don’t try to act like a big shot in front of your colleagues.","exampleTranslation":"Đừng cố tỏ ra ta đây trước mặt đồng nghiệp.","partOfSpeech":"idiom"},"Big wheel":{"definition":"nhân vật có thế lực, người quan trọng","example":"She’s the big wheel around here, making all the important decisions.","exampleTranslation":"Cô ấy là người có quyền lực lớn ở đây, đưa ra mọi quyết định quan trọng.","partOfSpeech":"idiom"},"Bigger bang for your buck":{"definition":"đáng đồng tiền bát gạo, mang lại nhiều giá trị hơn so với chi phí bỏ ra","example":"This new software offers a bigger bang for your buck compared to the old one.","exampleTranslation":"Phần mềm mới này mang lại giá trị xứng đáng với đồng tiền bỏ ra hơn so với phần mềm cũ.","partOfSpeech":"idiom"},"Bigwig":{"definition":"nhân vật quan trọng, người có quyền thế","example":"The CEO and other bigwigs will be attending the meeting tomorrow.","exampleTranslation":"CEO và các nhân vật quyền lực khác sẽ tham dự cuộc họp vào ngày mai.","partOfSpeech":"idiom"},"Bird’s-eye view":{"definition":"cái nhìn toàn cảnh, cái nhìn bao quát","example":"The CEO gave us a bird’s-eye view of the company’s future plans.","exampleTranslation":"CEO đã cho chúng tôi một cái nhìn tổng quan về kế hoạch tương lai của công ty.","partOfSpeech":"idiom"},"Birds of a feather flock together":{"definition":"ngưu tầm ngưu, mã tầm mã","example":"It’s no surprise that they became friends; birds of a feather flock together.","exampleTranslation":"Không có gì ngạc nhiên khi họ trở thành bạn; ngưu tầm ngưu, mã tầm mã.","partOfSpeech":"idiom"},"bit off more than one can chew":{"definition":"Gánh vác quá sức mình, ôm đồm quá nhiều việc.","example":"By agreeing to lead three projects at once, she definitely bit off more than she could chew.","exampleTranslation":"Bằng việc đồng ý dẫn dắt ba dự án cùng lúc, cô ấy chắc chắn đã ôm đồm quá nhiều.","partOfSpeech":"idiom"},"Bite off more than you can chew":{"definition":"ôm rơm nặng bụng, làm việc quá sức","example":"John realized he had bitten off more than he could chew when he volunteered for all those projects.","exampleTranslation":"John nhận ra mình đã ôm đồm quá sức khi tình nguyện nhận tất cả các dự án đó.","partOfSpeech":"idiom"},"Bite the bullet":{"definition":"cắn răng chịu đựng, dũng cảm đối mặt với khó khăn","example":"She had to bite the bullet and go to the dentist despite her fear.","exampleTranslation":"Cô ấy phải cắn răng đi nha sĩ dù rất sợ.","partOfSpeech":"idiom"},"Bite the dust":{"definition":"thất bại, chết, bỏ mạng","example":"Another one of our competitors bit the dust this week.","exampleTranslation":"Thêm một đối thủ cạnh tranh của chúng tôi đã sụp đổ trong tuần này.","partOfSpeech":"idiom"},"Bite your tongue":{"definition":"cố giữ im lặng, không nói ra","example":"She had to bite her tongue to avoid arguing with her boss.","exampleTranslation":"Cô ấy phải kìm lời để tránh tranh cãi với sếp.","partOfSpeech":"idiom"},"Black and blue":{"definition":"bầm dập, thâm tím","example":"After the fight, he was black and blue all over.","exampleTranslation":"Sau cuộc ẩu đả, anh ấy bị bầm tím khắp người.","partOfSpeech":"idiom"},"Black market":{"definition":"Chợ đen; thị trường giao dịch bất hợp pháp.","example":"During war times, food was often available only on the black market.","exampleTranslation":"Trong thời chiến, thực phẩm thường chỉ có trên thị trường chợ đen.","partOfSpeech":"idiom"},"Black out":{"definition":"Bất tỉnh nhân sự; Ngất xỉu","example":"She blacked out during her presentation due to stage fright.","exampleTranslation":"Cô ấy ngất xỉu trong lúc thuyết trình vì sợ sân khấu.","partOfSpeech":"idiom"},"Black sheep":{"definition":"Thành viên cá biệt; người lạc loài (trong một gia đình hoặc tập thể).","example":"He's the black sheep of the family because he chose to be an artist instead of a doctor.","exampleTranslation":"Anh ấy là con cừu đen của gia đình vì chọn làm nghệ sĩ thay vì bác sĩ.","partOfSpeech":"idiom"},"black sheep of the family":{"definition":"Đứa con lạc loài, đứa con phá gia chi tử / người khác biệt trong gia đình.","example":"He chose to pursue rock music instead of law and was considered the black sheep of the family.","exampleTranslation":"Anh ấy chọn theo đuổi nhạc rock thay vì luật và bị coi là con cừu đen của gia đình.","partOfSpeech":"idiom"},"Black tie event":{"definition":"Sự kiện trang trọng (yêu cầu khách nam mặc tuxedo, khách nữ mặc dạ hội).","example":"The charity gala is a black tie event, so don't forget your tuxedo.","exampleTranslation":"Buổi tiệc từ thiện là sự kiện trang phục lịch sự, nên đừng quên mặc tuxedo.","partOfSpeech":"idiom"},"Black-and-white":{"definition":"Rõ ràng, rành mạch; cách nhìn nhận vấn đề trắng đen rõ ràng (không có vùng xám).","example":"Life isn't always black-and-white; sometimes there are shades of grey.","exampleTranslation":"Cuộc sống không phải lúc nào cũng trắng đen rõ ràng; đôi khi có những vùng xám.","partOfSpeech":"idiom"},"Blackball someone":{"definition":"Tẩy chay, loại bỏ ai đó (khỏi một nhóm hoặc tổ chức).","example":"They decided to blackball him from the club due to his controversial views.","exampleTranslation":"Họ quyết định loại anh ta khỏi câu lạc bộ vì những quan điểm gây tranh cãi của anh ta.","partOfSpeech":"idiom"},"Blast from the past":{"definition":"Chuyện xưa gọi về; điều gì đó bất ngờ gợi nhớ mạnh mẽ về quá khứ.","example":"Running into my old high school friend was a real blast from the past.","exampleTranslation":"Tình cờ gặp lại người bạn cấp ba cũ thực sự là một kỷ niệm sống lại từ quá khứ.","partOfSpeech":"idiom"},"Blaze a trail":{"definition":"Tiên phong, mở đường.","example":"Steve Jobs blazed a trail in the world of technology and design.","exampleTranslation":"Steve Jobs đã mở đường trong lĩnh vực công nghệ và thiết kế.","partOfSpeech":"idiom"},"blind as a bat":{"definition":"Mắt mờ tịt, mù như dơi (thị lực rất kém khi không đeo kính).","example":"Without my prescription glasses, I am as blind as a bat.","exampleTranslation":"Không có kính cận, tôi mù tịt như dơi.","partOfSpeech":"idiom"},"Blonde bombshell":{"definition":"Người phụ nữ tóc vàng quyến rũ (thường mang tính biểu tượng).","example":"In the 1950s, Marilyn Monroe epitomized the blonde bombshell look.","exampleTranslation":"Vào những năm 1950, Marilyn Monroe là hình mẫu tiêu biểu của vẻ đẹp tóc vàng quyến rũ.","partOfSpeech":"idiom"},"blood is thicker than water":{"definition":"Một giọt máu đào hơn ao nước lã.","example":"When disaster struck, his siblings were the first to help him, proving that blood is thicker than water.","exampleTranslation":"Khi tai họa ập đến, anh chị em là những người đầu tiên giúp đỡ anh, chứng tỏ một giọt máu đào hơn ao nước lã.","partOfSpeech":"idiom"},"Blow a fuse":{"definition":"Tức điên lên; nổi trận lôi đình.","example":"When he saw the mess in the kitchen, he totally blew a fuse.","exampleTranslation":"Khi thấy căn bếp bừa bộn, anh ta nổi cơn thịnh nộ.","partOfSpeech":"idiom"},"Blow off steam":{"definition":"Xả hơi; giải tỏa căng thẳng hoặc tức giận.","example":"After a long week at work, I usually blow off steam by going for a run.","exampleTranslation":"Sau một tuần làm việc dài, tôi thường xả hơi bằng cách đi chạy bộ.","partOfSpeech":"idiom"},"Blow one's own horn":{"definition":"Tự vỗ ngực xưng tên; Tự khoe khoang","example":"The manager blew his own horn during the meeting, which annoyed everyone.","exampleTranslation":"Người quản lý tự khoe khoang trong cuộc họp, khiến mọi người khó chịu.","partOfSpeech":"idiom"},"Blow one's top":{"definition":"Tức giận tột độ; giận bốc khói.","example":"When he found out someone had crashed his car, he almost blew his top.","exampleTranslation":"Khi phát hiện ra có người đã làm hỏng xe của mình, anh ấy suýt nổi trận lôi đình.","partOfSpeech":"idiom"},"Blow smoke":{"definition":"Nói khoác, chém gió; nói những điều không có thật để đánh lừa hoặc khoe khoang.","example":"I think the sales guy was blowing smoke about those discounts.","exampleTranslation":"Tôi nghĩ anh nhân viên bán hàng đã nói khoác về những đợt giảm giá đó.","partOfSpeech":"idiom"},"Blow someone away":{"definition":"Làm ai đó vô cùng kinh ngạc và ấn tượng.","example":"Her performance in the play blew me away. It was phenomenal!","exampleTranslation":"Màn trình diễn của cô ấy trong vở kịch khiến tôi choáng ngợp. Thật phi thường!","partOfSpeech":"idiom"},"Blue blood":{"definition":"Dòng máu quý tộc; người xuất thân từ gia đình quý tộc.","example":"The family claims to have blue blood dating back centuries.","exampleTranslation":"Gia đình đó tự nhận có dòng máu quý tộc từ hàng thế kỷ trước.","partOfSpeech":"idiom"},"Blue law":{"definition":"Luật ngày Chủ nhật (luật cấm các hoạt động mua bán, giải trí vào Chủ nhật vì lý do tôn giáo).","example":"Due to the blue laws, stores are closed on Sundays in some towns.","exampleTranslation":"Do luật cấm kinh doanh ngày Chủ nhật, các cửa hàng ở một số thị trấn đóng cửa vào Chủ nhật.","partOfSpeech":"idiom"},"Boiling point":{"definition":"Giới hạn chịu đựng; đỉnh điểm của sự tức giận hoặc căng thẳng.","example":"Tensions in the meeting hit the boiling point when they couldn't agree on a solution.","exampleTranslation":"Căng thẳng trong cuộc họp lên đến đỉnh điểm khi họ không thể thống nhất giải pháp.","partOfSpeech":"idiom"},"Bolt from the blue":{"definition":"Chuyện bất ngờ như sét đánh ngang tai.","example":"Her resignation was a bolt from the blue for the whole team.","exampleTranslation":"Đơn từ chức của cô ấy là một tin sét đánh đối với cả nhóm.","partOfSpeech":"idiom"},"Bomb":{"definition":"Thất bại thảm hại","example":"His presentation bombed and no one was impressed.","exampleTranslation":"Bài thuyết trình của anh ấy thất bại thảm hại và không ai bị ấn tượng.","partOfSpeech":"idiom"},"Bone of contention":{"definition":"Vấn đề gây tranh cãi; nguyên nhân bất hòa.","example":"The terms of the contract became a bone of contention between the two companies.","exampleTranslation":"Các điều khoản của hợp đồng trở thành nguồn tranh chấp giữa hai công ty.","partOfSpeech":"idiom"},"Bookworm":{"definition":"Mọt sách.","example":"She's a real bookworm; you'll always find her with her nose in a book.","exampleTranslation":"Cô ấy là một con mọt sách thực sự; lúc nào bạn cũng thấy cô ấy vùi đầu vào sách.","partOfSpeech":"idiom"},"Born with a silver spoon in one's mouth":{"definition":"Ngậm thìa vàng (sinh ra trong một gia đình giàu có, quyền quý).","example":"John never had to work a day in his life; he was born with a silver spoon in his mouth.","exampleTranslation":"John chưa bao giờ phải làm việc ngày nào trong đời; anh ấy sinh ra đã ngậm thìa vàng.","partOfSpeech":"idiom"},"Bottom of the barrel":{"definition":"Lựa chọn tồi tệ nhất; thứ cặn bã, bét nhè.","example":"The team is scraping the bottom of the barrel to find players.","exampleTranslation":"Đội đang phải vét đáy thùng để tìm cầu thủ.","partOfSpeech":"idiom"},"Box someone in":{"definition":"Dồn ai vào thế bí","example":"They tried to box him in during the meeting, forcing him to agree to their terms.","exampleTranslation":"Họ đã cố dồn anh ta vào thế bí trong cuộc họp, buộc anh ta phải đồng ý với điều khoản của họ.","partOfSpeech":"idiom"},"Boxed in":{"definition":"Bị dồn vào chân tường; bị mắc kẹt, không có lối thoát.","example":"I feel so boxed in by my current job. There's no room for creativity.","exampleTranslation":"Tôi cảm thấy bị gò bó bởi công việc hiện tại. Không có chỗ cho sự sáng tạo.","partOfSpeech":"idiom"},"Brainstorm":{"definition":"Động não; cùng nhau thảo luận để đưa ra ý tưởng.","example":"Let's brainstorm ideas for the new marketing campaign.","exampleTranslation":"Hãy cùng động não để tìm ý tưởng cho chiến dịch tiếp thị mới.","partOfSpeech":"idiom"},"Bread and butter":{"definition":"Cần câu cơm; nguồn thu nhập chính, thứ thiết yếu.","example":"His freelance work is just extra; his bread and butter comes from his full-time job.","exampleTranslation":"Công việc tự do của anh ấy chỉ là thu nhập thêm; nguồn sống chính đến từ công việc toàn thời gian.","partOfSpeech":"idiom"},"Break a leg":{"definition":"Chúc may mắn (thường dùng trước khi lên sân khấu biểu diễn).","example":"You're going to do great in your performance tonight. Break a leg!","exampleTranslation":"Tối nay bạn sẽ diễn tốt thôi. Chúc may mắn nhé!","partOfSpeech":"idiom"},"Break even":{"definition":"Hòa vốn.","example":"After all the expenses, we finally managed to break even with the event.","exampleTranslation":"Sau khi trừ mọi chi phí, cuối cùng chúng tôi cũng hòa vốn với sự kiện này.","partOfSpeech":"idiom"},"break out in a cold sweat":{"definition":"Toát mồ hôi hột, toát mồ hôi lạnh (vì quá sợ hãi hoặc căng thẳng).","example":"He broke out in a cold sweat when he realized his passport was missing at the airport.","exampleTranslation":"Anh ấy toát mồ hôi lạnh khi nhận ra mình mất hộ chiếu ở sân bay.","partOfSpeech":"idiom"},"Break someone's heart":{"definition":"Làm ai đó tan nát cõi lòng; gây ra nỗi đau buồn sâu sắc.","example":"She broke his heart when she decided to move to another city.","exampleTranslation":"Cô ấy làm anh ấy đau lòng khi quyết định chuyển đến thành phố khác.","partOfSpeech":"idiom"},"Break the bank":{"definition":"Phá sản vì tiêu xài quá mức; tốn rất nhiều tiền.","example":"A nice dinner out doesn't have to break the bank.","exampleTranslation":"Một bữa tối ngon miệng bên ngoài không nhất thiết phải tốn nhiều tiền.","partOfSpeech":"idiom"},"Break the ice":{"definition":"Phá vỡ bầu không khí ngượng ngùng; làm quen, mở lời.","example":"He told a joke to break the ice at the beginning of the meeting.","exampleTranslation":"Anh ấy kể một câu chuyện cười để phá vỡ sự ngượng ngùng khi bắt đầu cuộc họp.","partOfSpeech":"idiom"},"Break the news":{"definition":"Báo tin (thường là tin xấu hoặc quan trọng).","example":"He had to break the news to his family about his illness.","exampleTranslation":"Anh ấy phải báo cho gia đình biết tin về căn bệnh của mình.","partOfSpeech":"idiom"},"Breeze through":{"definition":"Hoàn thành một cách dễ dàng, nhanh chóng.","example":"He managed to breeze through the exam without any difficulties.","exampleTranslation":"Anh ấy vượt qua kỳ thi một cách dễ dàng mà không gặp khó khăn gì.","partOfSpeech":"idiom"},"Bright and early":{"definition":"Sáng sớm tinh mơ.","example":"We have to get up bright and early for the hike tomorrow.","exampleTranslation":"Chúng ta phải dậy thật sớm để đi leo núi vào ngày mai.","partOfSpeech":"idiom"},"Bring down the house":{"definition":"Trình diễn xuất sắc khiến cả khán đài vỗ tay rần rần.","example":"The comedian's hilarious act really brought down the house.","exampleTranslation":"Tiết mục hài hước của diễn viên hài khiến cả khán phòng cười vang.","partOfSpeech":"idiom"},"Bring home the bacon":{"definition":"Trụ cột gia đình; kiếm tiền nuôi gia đình.","example":"She worked hard to bring home the bacon for her children.","exampleTranslation":"Cô ấy đã làm việc chăm chỉ để kiếm tiền nuôi các con.","partOfSpeech":"idiom"},"Bring one's A game":{"definition":"Thể hiện phong độ tốt nhất; nỗ lực hết mình.","example":"If we're going to beat the other team, we all need to bring our A game.","exampleTranslation":"Nếu muốn đánh bại đội kia, tất cả chúng ta cần thể hiện hết khả năng của mình.","partOfSpeech":"idiom"},"bring to light":{"definition":"Đưa ra ánh sáng, phơi bày sự thật bị che giấu.","example":"Investigative journalists brought to light the corruption behind the project.","exampleTranslation":"Các nhà báo điều tra đã đưa ra ánh sáng vụ tham nhũng đằng sau dự án.","partOfSpeech":"idiom"},"Bring up":{"definition":"Nuôi nấng (trẻ em); đề cập, gợi lên (một chủ đề).","example":"During the meeting, he brought up the issue of employee benefits.","exampleTranslation":"Trong cuộc họp, anh ấy đã nêu vấn đề về phúc lợi của nhân viên.","partOfSpeech":"idiom"},"bringing up a family":{"definition":"Nuôi nấng một gia đình, nuôi dạy con cái.","example":"Bringing up a family in a big city requires patience and financial stability.","exampleTranslation":"Nuôi dạy gia đình ở một thành phố lớn đòi hỏi sự kiên nhẫn và sự ổn định về tài chính.","partOfSpeech":"idiom"},"Brownie points":{"definition":"Điểm cộng; sự ghi nhận nỗ lực (để lấy lòng ai đó).","example":"He brought coffee for everyone in the office to earn some brownie points with the boss.","exampleTranslation":"Anh ấy mang cà phê cho mọi người trong văn phòng để lấy lòng sếp.","partOfSpeech":"idiom"},"Bug someone":{"definition":"Làm phiền ai đó; Quấy rầy","example":"Can you stop asking me questions? You’re starting to bug me.","exampleTranslation":"Bạn có thể ngừng hỏi tôi được không? Bạn bắt đầu làm tôi khó chịu rồi.","partOfSpeech":"idiom"},"build bridges":{"definition":"Xây dựng cầu nối quan hệ, hàn gắn bất đồng.","example":"The new manager worked hard to build bridges between the marketing and engineering teams.","exampleTranslation":"Người quản lý mới đã nỗ lực xây dựng cầu nối giữa nhóm tiếp thị và nhóm kỹ thuật.","partOfSpeech":"idiom"},"Bull in a china shop":{"definition":"Kẻ vụng về, thô lỗ (trong tình huống cần sự tế nhị).","example":"When negotiating deals, you can't be a bull in a china shop.","exampleTranslation":"Khi đàm phán hợp đồng, bạn không được hấp tấp, vụng về làm hỏng việc.","partOfSpeech":"idiom"},"Burgers and dogs":{"definition":"Bánh mì kẹp thịt và xúc xích (món ăn truyền thống trong các buổi tiệc nướng ngoài trời ở Mỹ).","example":"We're having a cookout this weekend, so we'll need plenty of burgers and dogs.","exampleTranslation":"Cuối tuần này chúng tôi tổ chức tiệc nướng ngoài trời, nên cần nhiều bánh burger và xúc xích.","partOfSpeech":"idiom"},"Burn bridges":{"definition":"Phá vỡ quan hệ; qua cầu rút ván; tự cắt đứt đường lui.","example":"Leaving the company without notice is a sure way to burn bridges.","exampleTranslation":"Rời công ty mà không báo trước là cách chắc chắn để cắt đứt các mối quan hệ.","partOfSpeech":"idiom"},"Burn out":{"definition":"Kiệt sức, mất hết động lực do làm việc quá sức.","example":"After months of nonstop work, she's completely burned out.","exampleTranslation":"Sau nhiều tháng làm việc không ngừng nghỉ, cô ấy hoàn toàn kiệt sức.","partOfSpeech":"idiom"},"Burn the candle at both ends":{"definition":"Làm việc quá sức từ sáng sớm đến đêm khuya; vắt kiệt sức lực.","example":"She's been burning the candle at both ends to meet all her deadlines.","exampleTranslation":"Cô ấy làm việc cật lực không ngơi nghỉ để kịp tất cả các hạn chót.","partOfSpeech":"idiom"},"Burn the midnight oil":{"definition":"Thức khuya làm việc hoặc học bài.","example":"She had to burn the midnight oil to finish her project on time.","exampleTranslation":"Cô ấy phải thức khuya làm việc để hoàn thành dự án đúng hạn.","partOfSpeech":"idiom"},"Bury one's head in the sand":{"definition":"Trốn tránh thực tại; nhắm mắt làm ngơ trước khó khăn.","example":"You can't just bury your head in the sand every time there's a problem.","exampleTranslation":"Bạn không thể cứ chôn đầu vào cát mỗi khi có vấn đề.","partOfSpeech":"idiom"},"Bury the hatchet":{"definition":"Giảng hòa; bỏ qua hiềm khích.","example":"After years of fighting, the two neighbors finally decided to bury the hatchet.","exampleTranslation":"Sau nhiều năm xung đột, hai người hàng xóm cuối cùng đã quyết định làm hòa.","partOfSpeech":"idiom"},"Busy bee":{"definition":"Người bận rộn; người làm việc chăm chỉ.","example":"She's always a busy bee, never taking time to rest.","exampleTranslation":"Cô ấy lúc nào cũng bận rộn như ong, không bao giờ dành thời gian nghỉ ngơi.","partOfSpeech":"idiom"},"Butt in":{"definition":"Chen ngang; Chõ mũi vào việc người khác","example":"It’s rude to butt in when someone else is speaking.","exampleTranslation":"Thật bất lịch sự khi chen ngang lúc người khác đang nói.","partOfSpeech":"idiom"},"Butter someone up":{"definition":"Nịnh nọt, tâng bốc ai đó để trục lợi.","example":"He tried to butter up the boss before asking for a raise.","exampleTranslation":"Anh ta cố nịnh sếp trước khi xin tăng lương.","partOfSpeech":"idiom"},"butterflies in one's stomach":{"definition":"Cảm giác bồn chồn, hồi hộp nôn nao (trước sự kiện quan trọng).","example":"I always get butterflies in my stomach right before giving a presentation on stage.","exampleTranslation":"Tôi luôn thấy bồn chồn lo lắng ngay trước khi thuyết trình trên sân khấu.","partOfSpeech":"idiom"},"Button one's lip":{"definition":"Giữ mồm giữ miệng; ngậm miệng lại.","example":"When discussing confidential matters, it's best to button your lip.","exampleTranslation":"Khi bàn về những vấn đề bí mật, tốt nhất là nên giữ kín miệng.","partOfSpeech":"idiom"},"Buy a lemon":{"definition":"Mua phải món hàng dỏm, kém chất lượng (thường dùng cho xe cộ).","example":"I thought I was getting a great deal on that used car, but I ended up buying a lemon.","exampleTranslation":"Tôi tưởng mình mua được chiếc xe cũ đó với giá hời, nhưng cuối cùng lại mua phải xe lỗi.","partOfSpeech":"idiom"},"Buy something for a song":{"definition":"Mua được món gì đó với giá rẻ bèo.","example":"I bought this vintage lamp for a song at the flea market.","exampleTranslation":"Tôi mua chiếc đèn cổ này với giá rất rẻ ở chợ đồ cũ.","partOfSpeech":"idiom"},"by all means":{"definition":"Tất nhiên, bằng mọi giá; cứ tự nhiên.","example":"If you need to borrow my laptop for the presentation, by all means take it.","exampleTranslation":"Nếu bạn cần mượn máy tính xách tay của tôi để thuyết trình, cứ tự nhiên lấy đi.","partOfSpeech":"idiom"},"by and large":{"definition":"Nhìn chung, nói chung.","example":"By and large, the new policy has been well received by employees.","exampleTranslation":"Nhìn chung, chính sách mới đã được nhân viên đón nhận tích cực.","partOfSpeech":"idiom"},"By hook or by crook":{"definition":"Bằng mọi giá, bằng bất cứ thủ đoạn nào","example":"They were determined to get the project done by hook or by crook.","exampleTranslation":"Họ quyết tâm hoàn thành dự án bằng mọi giá, bất kể bằng cách nào.","partOfSpeech":"idiom"},"By the book":{"definition":"Làm đúng theo sách vở, tuân thủ nghiêm ngặt các quy tắc","example":"The new manager insists on doing everything by the book.","exampleTranslation":"Người quản lý mới khăng khăng làm mọi việc theo đúng quy định.","partOfSpeech":"idiom"},"By the skin of ones teeth":{"definition":"Sát nút, trong gang tấc","example":"She finished the race by the skin of her teeth, just seconds before it ended.","exampleTranslation":"Cô ấy về đích trong gang tấc, chỉ vài giây trước khi cuộc đua kết thúc.","partOfSpeech":"idiom"},"By word of mouth":{"definition":"Truyền miệng","example":"Many local businesses rely on word of mouth for advertising.","exampleTranslation":"Nhiều doanh nghiệp địa phương dựa vào truyền miệng để quảng cáo.","partOfSpeech":"idiom"},"Call a spade a spade":{"definition":"Nói toạc móng heo, nói thẳng nói thật","example":"Let’s call a spade a spade – that project failed because of poor planning.","exampleTranslation":"Hãy gọi thẳng sự việc bằng tên của nó – dự án đó thất bại vì lập kế hoạch kém.","partOfSpeech":"idiom"},"Call it a day":{"definition":"Kết thúc công việc; Nghỉ tay","example":"We didn’t finish the project, but we were tired and decided to call it a day.","exampleTranslation":"Chúng tôi chưa hoàn thành dự án, nhưng đã mệt nên quyết định dừng lại ở đây.","partOfSpeech":"idiom"},"call it quits":{"definition":"Dừng lại, nghỉ tay, buông xuôi kết thúc công việc.","example":"We have been studying for eight straight hours; let us call it quits for tonight.","exampleTranslation":"Chúng ta đã học tám tiếng liền; tối nay hãy nghỉ thôi.","partOfSpeech":"idiom"},"Call someone on the carpet":{"definition":"Gọi lên mắng vốn; Khiển trách","example":"After the error in the report, he knew he would be called on the carpet by his boss.","exampleTranslation":"Sau lỗi trong bản báo cáo, anh ấy biết mình sẽ bị sếp gọi lên khiển trách.","partOfSpeech":"idiom"},"Call someones bluff":{"definition":"Lật tẩy, thách thức ai đó chứng minh lời đe dọa của họ","example":"They threatened to quit if they didn’t get a raise, so the company called their bluff.","exampleTranslation":"Họ dọa sẽ nghỉ việc nếu không được tăng lương, nên công ty đã thách họ thử xem.","partOfSpeech":"idiom"},"Call the shots":{"definition":"Người chỉ huy, người đưa ra quyết định","example":"In this project, it’s clear that Sarah is the one who calls the shots.","exampleTranslation":"Trong dự án này, rõ ràng Sarah là người có tiếng nói quyết định.","partOfSpeech":"idiom"},"Calm before the storm":{"definition":"Sự bình yên trước cơn bão","example":"The office was quiet, but it felt like the calm before the storm.","exampleTranslation":"Văn phòng yên tĩnh, nhưng có cảm giác như sự yên lặng trước cơn bão.","partOfSpeech":"idiom"},"Calm someone down":{"definition":"Làm ai đó bình tĩnh lại","example":"She tried to calm him down before the big presentation.","exampleTranslation":"Cô ấy cố gắng làm anh ấy bình tĩnh lại trước buổi thuyết trình quan trọng.","partOfSpeech":"idiom"},"Cant hold a candle to":{"definition":"Không thể sánh bằng, thua xa","example":"No other singer today can hold a candle to her soulful voice.","exampleTranslation":"Không ca sĩ nào hiện nay có thể sánh bằng giọng hát đầy cảm xúc của cô ấy.","partOfSpeech":"idiom"},"Cant judge a book by its cover":{"definition":"Đừng trông mặt mà bắt hình dong","example":"You can’t judge a book by its cover; she might seem quiet, but she’s really talented.","exampleTranslation":"Đừng đánh giá người qua vẻ bề ngoài; cô ấy có vẻ ít nói, nhưng thực ra rất tài năng.","partOfSpeech":"idiom"},"Cant keep up":{"definition":"Không theo kịp","example":"I’m sorry, I just can’t keep up with all these new tasks.","exampleTranslation":"Xin lỗi, tôi thực sự không thể theo kịp tất cả những nhiệm vụ mới này.","partOfSpeech":"idiom"},"Cant put a face to the name":{"definition":"Biết tên nhưng không nhớ mặt","example":"I remember John from the meeting, but I just can’t put a face to the name.","exampleTranslation":"Tôi nhớ John từ cuộc họp, nhưng tôi không thể nhớ ra mặt người khi nghe cái tên đó.","partOfSpeech":"idiom"},"Cant see the forest for the trees":{"definition":"Thấy cây mà không thấy rừng (chỉ nhìn chi tiết mà bỏ qua toàn cục)","example":"He’s so focused on the details of the project, he can’t see the forest for the trees.","exampleTranslation":"Anh ấy quá tập trung vào các chi tiết của dự án nên không thấy được bức tranh toàn cảnh.","partOfSpeech":"idiom"},"Card shark":{"definition":"Tay cờ bạc bịp, cao thủ chơi bài","example":"Be careful; he’s known to be a card shark in high-stakes poker games.","exampleTranslation":"Hãy cẩn thận; anh ta nổi tiếng là tay chơi bài cao thủ trong những ván poker cược lớn.","partOfSpeech":"idiom"},"Carry a torch for someone":{"definition":"Yêu đơn phương","example":"She doesn’t date other people because she’s still carrying a torch for her first love.","exampleTranslation":"Cô ấy không hẹn hò với ai khác vì vẫn còn nặng lòng với mối tình đầu.","partOfSpeech":"idiom"},"Carry the ball":{"definition":"Chịu trách nhiệm chính, gánh vác công việc","example":"After John left the company, Lisa had to carry the ball for their department.","exampleTranslation":"Sau khi John rời công ty, Lisa phải gánh vác trách nhiệm cho bộ phận của họ.","partOfSpeech":"idiom"},"cash cow":{"definition":"Cỗ máy in tiền, nguồn hái ra tiền béo bở.","example":"That subscription service has become the company's biggest cash cow.","exampleTranslation":"Dịch vụ đăng ký đó đã trở thành nguồn thu chính của công ty.","partOfSpeech":"idiom"},"Cast pearls before swine":{"definition":"Đàn gảy tai trâu","example":"He felt he was casting pearls before swine when his detailed suggestions were ignored.","exampleTranslation":"Anh cảm thấy mình như ném ngọc cho heo khi những đề xuất chi tiết của anh bị phớt lờ.","partOfSpeech":"idiom"},"Cast-iron stomach":{"definition":"Dạ dày tốt, ăn gì cũng không bị đau bụng","example":"My grandmother has a cast-iron stomach; she can eat anything and never gets sick.","exampleTranslation":"Bà tôi có dạ dày sắt; bà ăn gì cũng không bao giờ bị ốm.","partOfSpeech":"idiom"},"Castle in the sky":{"definition":"Kế hoạch viển vông, ảo tưởng","example":"Without realistic steps, his aspirations are nothing but a castle in the sky.","exampleTranslation":"Nếu không có những bước đi thực tế, khát vọng của anh ta chỉ là lâu đài trên cát.","partOfSpeech":"idiom"},"Cat got your tongue?":{"definition":"Mèo tha mất lưỡi rồi à? (Sao tự dưng im lặng thế?)","example":"Why are you so quiet? Cat got your tongue?","exampleTranslation":"Sao bạn im lặng thế? Mèo cắn mất lưỡi rồi à?","partOfSpeech":"idiom"},"Cat nap":{"definition":"Giấc ngủ ngắn","example":"I took a quick cat nap during my lunch break.","exampleTranslation":"Tôi đã chợp mắt một lát trong giờ nghỉ trưa.","partOfSpeech":"idiom"},"catch one's death of cold":{"definition":"Bị cảm lạnh nặng (do dầm mưa, chịu rét).","example":"Put on your raincoat and boots, or you will catch your death of cold!","exampleTranslation":"Hãy mặc áo mưa và đi ủng vào, nếu không bạn sẽ bị cảm lạnh nặng đấy!","partOfSpeech":"idiom"},"catch red-handed":{"definition":"Bắt quả tang, bắt tận tay day tận trán.","example":"The thief was caught red-handed as he tried to open the store safe.","exampleTranslation":"Tên trộm bị bắt quả tang khi đang cố mở két sắt của cửa hàng.","partOfSpeech":"idiom"},"Catch some rays":{"definition":"Tắm nắng","example":"I’m planning to head to the beach this weekend to catch some rays.","exampleTranslation":"Tôi định ra bãi biển vào cuối tuần này để tắm nắng.","partOfSpeech":"idiom"},"Catch some Zs":{"definition":"Chợp mắt, đi ngủ","example":"I need to catch some Zs before the long drive.","exampleTranslation":"Tôi cần chợp mắt một chút trước chuyến đi dài.","partOfSpeech":"idiom"},"catch someone's eye":{"definition":"Thu hút sự chú ý của ai, bắt gặp ánh mắt ai.","example":"A beautiful oil painting in the gallery window caught my eye.","exampleTranslation":"Một bức tranh sơn dầu tuyệt đẹp ở cửa sổ phòng trưng bày đã thu hút ánh nhìn của tôi.","partOfSpeech":"idiom"},"Catch someones eye":{"definition":"Thu hút sự chú ý của ai đó, lọt vào mắt xanh","example":"The beautiful painting in the gallery really caught my eye.","exampleTranslation":"Bức tranh đẹp trong phòng trưng bày thực sự đã thu hút ánh nhìn của tôi.","partOfSpeech":"idiom"},"Catch the bus":{"definition":"Bắt xe buýt kịp lúc","example":"I need to leave now if I want to catch the bus.","exampleTranslation":"Tôi cần đi ngay nếu muốn kịp xe buýt.","partOfSpeech":"idiom"},"catch you later":{"definition":"Gặp lại bạn sau nhé! / Tạm biệt nhé!","example":"I have to rush to my meeting now—catch you later!","exampleTranslation":"Giờ tôi phải vội đến cuộc họp rồi, hẹn gặp lại sau nhé!","partOfSpeech":"idiom"},"Catch-22":{"definition":"Tình huống trớ trêu, tiến thoái lưỡng nan","example":"It’s a Catch-22: you need a credit history to get a credit card, but you need a credit card to build a credit history.","exampleTranslation":"Đó là tình huống tiến thoái lưỡng nan: bạn cần có lịch sử tín dụng để có thẻ tín dụng, nhưng lại cần có thẻ tín dụng để tạo lịch sử tín dụng.","partOfSpeech":"idiom"},"Caught red-handed":{"definition":"Bị bắt quả tang","example":"The thief was caught red-handed trying to steal the car.","exampleTranslation":"Tên trộm bị bắt quả tang khi đang cố trộm xe.","partOfSpeech":"idiom"},"Caught someone red-handed":{"definition":"Bắt quả tang ai đó","example":"The shoplifter was caught red-handed trying to steal a necklace.","exampleTranslation":"Kẻ trộm đồ trong cửa hàng bị bắt quả tang khi đang cố lấy cắp một chiếc vòng cổ.","partOfSpeech":"idiom"},"Caught with ones hand in the cookie jar":{"definition":"Bị bắt tại trận khi đang làm việc xấu mờ ám","example":"He was caught with his hand in the cookie jar when he tried to steal office supplies.","exampleTranslation":"Anh ta bị bắt quả tang khi cố lấy cắp đồ dùng văn phòng.","partOfSpeech":"idiom"},"Change horses in midstream":{"definition":"Thay ngựa giữa dòng (thay đổi kế hoạch/lãnh đạo giữa chừng)","example":"We can’t change horses in midstream now; let’s see this through to the end.","exampleTranslation":"Giờ chúng ta không thể đổi chiến lược giữa chừng; hãy làm cho xong đến cùng.","partOfSpeech":"idiom"},"Change of heart":{"definition":"Thay đổi tâm ý, đổi ý","example":"After much consideration, she had a change of heart about moving to another city.","exampleTranslation":"Sau khi suy nghĩ kỹ, cô ấy đã đổi ý về việc chuyển đến thành phố khác.","partOfSpeech":"idiom"},"Charley horse":{"definition":"Chuột rút","example":"I woke up in the middle of the night with a painful Charley horse.","exampleTranslation":"Tôi tỉnh dậy giữa đêm vì bị chuột rút đau đớn.","partOfSpeech":"idiom"},"Charmed life":{"definition":"Cuộc sống may mắn, suôn sẻ như có quý nhân phù trợ","example":"Despite all the dangers he’s faced, he seems to be living a charmed life.","exampleTranslation":"Dù đã đối mặt với bao nguy hiểm, anh ấy dường như có một cuộc sống được may mắn che chở.","partOfSpeech":"idiom"},"Chasing rainbows":{"definition":"Theo đuổi ảo vọng, mơ mộng hão huyền","example":"Stop chasing rainbows and focus on what’s important right now.","exampleTranslation":"Đừng theo đuổi những giấc mơ viển vông nữa và hãy tập trung vào những điều quan trọng lúc này.","partOfSpeech":"idiom"},"Checkered past":{"definition":"Quá khứ thăng trầm, quá khứ có vết nhơ","example":"Despite his checkered past, he has turned his life around.","exampleTranslation":"Dù có quá khứ không mấy tốt đẹp, anh ấy đã làm lại cuộc đời.","partOfSpeech":"idiom"},"Cheer up":{"definition":"Vui lên đi","example":"Cheer up, Tom! Everything will be alright.","exampleTranslation":"Vui lên nào, Tom! Mọi chuyện sẽ ổn thôi.","partOfSpeech":"idiom"},"cherry-pick":{"definition":"Kén cá chọn canh; chọn lọc lấy những cái tốt nhất / có lợi nhất cho mình.","example":"The researcher was criticized for cherry-picking only the data that supported his theory.","exampleTranslation":"Nhà nghiên cứu bị chỉ trích vì chỉ chọn những dữ liệu ủng hộ lý thuyết của mình.","partOfSpeech":"idiom"},"Chew someone out":{"definition":"Mắng nhiếc, chửi mắng thậm tệ","example":"The boss chewed him out for being late again.","exampleTranslation":"Sếp đã mắng anh ấy một trận vì lại đến muộn.","partOfSpeech":"idiom"},"Chew something over":{"definition":"Suy nghĩ kỹ càng, cân nhắc","example":"We should chew over the pros and cons before making a decision.","exampleTranslation":"Chúng ta nên cân nhắc kỹ những ưu và nhược điểm trước khi đưa ra quyết định.","partOfSpeech":"idiom"},"Chewing the fat":{"definition":"Tán gẫu, buôn dưa lê","example":"We spent the afternoon chewing the fat and catching up on each other’s lives.","exampleTranslation":"Chúng tôi đã dành cả buổi chiều tán gẫu và hỏi thăm cuộc sống của nhau.","partOfSpeech":"idiom"},"Chicken out":{"definition":"Nhát gan; Chùn bước","example":"He wanted to ask her out, but he chickened out at the last moment.","exampleTranslation":"Anh ấy muốn mời cô ấy đi chơi, nhưng đến phút cuối lại chùn bước.","partOfSpeech":"idiom"},"Chow down":{"definition":"Ăn ngấu nghiến, đánh chén","example":"After the hike, we all wanted to chow down on some burgers and fries.","exampleTranslation":"Sau chuyến đi bộ đường dài, tất cả chúng tôi đều muốn ăn ngấu nghiến bánh burger và khoai tây chiên.","partOfSpeech":"idiom"},"Chuffed to bits":{"definition":"Cực kỳ vui sướng, hãnh diện","example":"He was chuffed to bits after winning the award.","exampleTranslation":"Anh ấy vui sướng vô cùng sau khi giành giải thưởng.","partOfSpeech":"idiom"},"clean bill of health":{"definition":"Giấy chứng nhận sức khỏe tốt; kết luận hoàn toàn khỏe mạnh / đạt chuẩn an toàn.","example":"After a comprehensive physical checkup, the doctor gave him a clean bill of health.","exampleTranslation":"Sau đợt khám sức khỏe tổng quát, bác sĩ xác nhận anh ấy hoàn toàn khỏe mạnh.","partOfSpeech":"idiom"},"Clean slate":{"definition":"Làm lại từ đầu, xóa bỏ quá khứ","example":"After the company’s restructuring, everyone was given a clean slate to prove themselves.","exampleTranslation":"Sau khi công ty tái cơ cấu, mọi người đều có cơ hội làm lại từ đầu để chứng tỏ bản thân.","partOfSpeech":"idiom"},"Clean someone out":{"definition":"Vét sạch tiền túi của ai đó","example":"The casino trip cleaned him out completely.","exampleTranslation":"Chuyến đi sòng bạc đã khiến anh ta sạch túi.","partOfSpeech":"idiom"},"Clear as mud":{"definition":"Khó hiểu, rối rắm (nghĩa mỉa mai)","example":"His explanations were clear as mud; no one could understand them.","exampleTranslation":"Lời giải thích của anh ta mơ hồ khó hiểu; không ai hiểu nổi.","partOfSpeech":"idiom"},"Clear the air":{"definition":"Xóa bỏ hiểu lầm, làm rõ vấn đề để giải tỏa căng thẳng","example":"After their argument, they needed to sit down and clear the air.","exampleTranslation":"Sau cuộc cãi vã, họ cần ngồi xuống và giải tỏa hiểu lầm.","partOfSpeech":"idiom"},"climb the corporate ladder":{"definition":"Thăng tiến trên con đường sự nghiệp công sở.","example":"She worked long hours with great dedication to climb the corporate ladder.","exampleTranslation":"Cô ấy đã làm việc nhiều giờ với sự tận tâm lớn để thăng tiến trong sự nghiệp.","partOfSpeech":"idiom"},"Climb the walls":{"definition":"Phát cuồng, bồn chồn bứt rứt","example":"Being cooped up inside all day makes me feel like I could climb the walls.","exampleTranslation":"Bị nhốt trong nhà cả ngày khiến tôi cảm thấy bức bối đến phát điên.","partOfSpeech":"idiom"},"Close but no cigar":{"definition":"Suýt trúng, gần đúng nhưng vẫn sai","example":"He almost won the race, but close but no cigar.","exampleTranslation":"Anh ấy suýt thắng cuộc đua, nhưng chỉ tiếc là suýt soát thôi chứ không thắng.","partOfSpeech":"idiom"},"Close shave":{"definition":"Thoát hiểm trong gang tấc","example":"That was a close shave; I almost broke my leg!","exampleTranslation":"Suýt nữa thì nguy hiểm; tôi suýt gãy chân!","partOfSpeech":"idiom"},"Closed-minded":{"definition":"Bảo thủ, hẹp hòi, không chịu tiếp thu ý kiến mới.","example":"He was too closed-minded to appreciate the new ideas presented in the meeting.","exampleTranslation":"Anh ta quá bảo thủ nên không thể đánh giá cao những ý tưởng mới được đưa ra trong cuộc họp.","partOfSpeech":"idiom"},"Clouds on the horizon":{"definition":"Sắp có chuyện chẳng lành; Dấu hiệu điềm gở","example":"The doctor’s serious tone made it clear that there are clouds on the horizon regarding his health.","exampleTranslation":"Giọng điệu nghiêm trọng của bác sĩ cho thấy rõ có những dấu hiệu đáng lo về sức khỏe của anh ấy.","partOfSpeech":"idiom"},"Clown around":{"definition":"Làm trò hề, đùa cợt lố lăng.","example":"Stop clowning around and get to work.","exampleTranslation":"Đừng đùa giỡn nữa và bắt tay vào làm việc đi.","partOfSpeech":"idiom"},"Cock-and-bull story":{"definition":"Chuyện bịa đặt, chuyện hoang đường không đáng tin.","example":"He told me a real cock-and-bull story about why he was late.","exampleTranslation":"Anh ấy kể cho tôi một câu chuyện bịa đặt phi lý về lý do anh ấy đến muộn.","partOfSpeech":"idiom"},"Coin a new term":{"definition":"Đặt ra một thuật ngữ mới.","example":"The author coined a new term that quickly became popular in the industry.","exampleTranslation":"Tác giả đã đặt ra một thuật ngữ mới, nhanh chóng trở nên phổ biến trong ngành.","partOfSpeech":"idiom"},"Coin a phrase":{"definition":"Đặt ra một cụm từ mới, tạo ra một thành ngữ mới.","example":"Who was the first person to coin a phrase?","exampleTranslation":"Ai là người đầu tiên đặt ra một cụm từ mới?","partOfSpeech":"idiom"},"Cold enough to freeze the balls off a brass monkey":{"definition":"Rét thấu xương, lạnh cóng.","example":"The temperature dropped so low last night, it was cold enough to freeze the balls off a brass monkey.","exampleTranslation":"Đêm qua nhiệt độ giảm xuống thấp đến mức lạnh buốt thấu xương.","partOfSpeech":"idiom"},"Cold feet":{"definition":"Chùn bước, mất hết can đảm (ngay trước khi làm việc gì đó).","example":"He got cold feet right before the wedding and called it off.","exampleTranslation":"Anh ấy chùn bước ngay trước đám cưới và đã hủy hôn.","partOfSpeech":"idiom"},"Cold shoulder":{"definition":"Sự lạnh nhạt, sự hờ hững.","example":"She gave him the cold shoulder after their argument.","exampleTranslation":"Cô ấy lạnh nhạt với anh ấy sau cuộc cãi vã của họ.","partOfSpeech":"idiom"},"Collect dust":{"definition":"Bị bỏ xó, đóng bụi (vì lâu không được sử dụng).","example":"My old guitar has been collecting dust in the closet.","exampleTranslation":"Cây đàn guitar cũ của tôi đã phủ bụi trong tủ.","partOfSpeech":"idiom"},"Come a long way":{"definition":"Tiến bộ vượt bậc, có bước tiến dài.","example":"She has come a long way since she first started learning to play the piano.","exampleTranslation":"Cô ấy đã tiến bộ rất nhiều kể từ lúc bắt đầu học chơi piano.","partOfSpeech":"idiom"},"Come alive":{"definition":"Trở nên sống động, nhộn nhịp hẳn lên.","example":"The city comes alive during the festival with music and dancing everywhere.","exampleTranslation":"Thành phố trở nên sôi động trong lễ hội với âm nhạc và các điệu nhảy khắp nơi.","partOfSpeech":"idiom"},"Come clean":{"definition":"Thú nhận sự thật, khai báo thành khẩn.","example":"After months of lying, he decided to come clean about his mistakes.","exampleTranslation":"Sau nhiều tháng nói dối, anh ấy quyết định thú nhận những sai lầm của mình.","partOfSpeech":"idiom"},"Come down with a cold":{"definition":"Bị cảm lạnh, đổ bệnh cảm.","example":"I think I’m coming down with a cold; my throat is sore.","exampleTranslation":"Tôi nghĩ mình sắp bị cảm; cổ họng tôi đau.","partOfSpeech":"idiom"},"Come hell or high water":{"definition":"Dù có chuyện gì xảy ra, dù khó khăn đến mấy.","example":"I’ll be at your wedding, come hell or high water.","exampleTranslation":"Tôi sẽ có mặt ở đám cưới của bạn, dù có chuyện gì xảy ra đi nữa.","partOfSpeech":"idiom"},"Come in handy":{"definition":"Trở nên hữu ích, có ích.","example":"Keep this tool in your bag, it might come in handy one day.","exampleTranslation":"Hãy giữ dụng cụ này trong túi, biết đâu một ngày nào đó nó sẽ có ích.","partOfSpeech":"idiom"},"come of age":{"definition":"Đến tuổi trưởng thành, đạt độ chín muồi.","example":"In many countries, young people celebrate coming of age at eighteen.","exampleTranslation":"Ở nhiều quốc gia, thanh niên ăn mừng tuổi trưởng thành vào năm mười tám tuổi.","partOfSpeech":"idiom"},"Come out flat-footed":{"definition":"Bị bất ngờ, không kịp trở tay, thiếu sự chuẩn bị.","example":"The team was caught flat-footed by the unexpected change in schedule.","exampleTranslation":"Cả đội bị bất ngờ không kịp trở tay trước sự thay đổi lịch trình đột xuất.","partOfSpeech":"idiom"},"Come out of one's shell":{"definition":"Bớt rụt rè, trở nên cởi mở và tự tin hơn.","example":"After joining the drama club, she’s really come out of her shell.","exampleTranslation":"Sau khi tham gia câu lạc bộ kịch, cô ấy thực sự đã cởi mở hơn.","partOfSpeech":"idiom"},"Come out smelling like a rose":{"definition":"Bình yên vô sự, không bị mang tiếng xấu (sau một vụ rắc rối).","example":"Despite the controversy, she managed to come out smelling like a rose.","exampleTranslation":"Bất chấp tranh cãi, cô ấy vẫn thoát ra được mà không bị tổn hại danh tiếng.","partOfSpeech":"idiom"},"Come out swinging":{"definition":"Phản kháng quyết liệt, đáp trả mạnh mẽ ngay từ đầu.","example":"When faced with accusations, she came out swinging to defend herself.","exampleTranslation":"Khi bị buộc tội, cô ấy đã phản công mạnh mẽ để tự bảo vệ mình.","partOfSpeech":"idiom"},"Come rain or shine":{"definition":"Dù mưa hay nắng, trong bất kỳ hoàn cảnh nào.","example":"I’ll be there to support you, come rain or shine.","exampleTranslation":"Tôi sẽ ở đó ủng hộ bạn, dù mưa hay nắng.","partOfSpeech":"idiom"},"come to light":{"definition":"Bị phơi bày, lộ ra ánh sáng.","example":"Shocking details of the corporate scandal have recently come to light.","exampleTranslation":"Những chi tiết gây sốc về vụ bê bối của công ty gần đây đã được đưa ra ánh sáng.","partOfSpeech":"idiom"},"come to terms with":{"definition":"Chấp nhận, đành lòng làm quen với một sự thật đau buồn.","example":"It took her years to come to terms with the loss of her dear friend.","exampleTranslation":"Cô ấy mất nhiều năm mới chấp nhận được sự mất mát của người bạn thân.","partOfSpeech":"idiom"},"Comfort food":{"definition":"Món ăn xoa dịu tinh thần (thường gợi nhớ tuổi thơ).","example":"When I’m stressed, I turn to macaroni and cheese as my comfort food.","exampleTranslation":"Khi căng thẳng, tôi tìm đến món mì ống phô mai như một món ăn an ủi.","partOfSpeech":"idiom"},"Compare apples and oranges":{"definition":"So sánh khập khiễng (hai thứ hoàn toàn khác nhau).","example":"Comparing the two jobs is like comparing apples and oranges; they require completely different skill sets.","exampleTranslation":"So sánh hai công việc đó chẳng khác nào so sánh táo với cam; chúng đòi hỏi những bộ kỹ năng hoàn toàn khác nhau.","partOfSpeech":"idiom"},"Computer crashed":{"definition":"Máy tính bị treo, sập nguồn.","example":"My computer crashed right before I could save my work.","exampleTranslation":"Máy tính của tôi bị treo ngay trước khi tôi kịp lưu bài.","partOfSpeech":"idiom"},"Cook someone's goose":{"definition":"Làm hỏng kế hoạch của ai đó, khiến ai đó chuốc lấy thất bại.","example":"When he revealed their secret, he really cooked their goose.","exampleTranslation":"Khi anh ta tiết lộ bí mật của họ, anh ta đã thực sự hủy hoại họ.","partOfSpeech":"idiom"},"Cook the books":{"definition":"Làm giả sổ sách, gian lận sổ sách kế toán.","example":"The finance manager was fired for cooking the books to cover up losses.","exampleTranslation":"Giám đốc tài chính bị sa thải vì làm giả sổ sách để che giấu thua lỗ.","partOfSpeech":"idiom"},"Cook up":{"definition":"Bịa đặt (câu chuyện, lý do), vạch ra (kế hoạch).","example":"He tried to cook up an excuse for being late to the meeting.","exampleTranslation":"Anh ta cố bịa ra một lý do để biện minh cho việc đến muộn cuộc họp.","partOfSpeech":"idiom"},"Cool as a cucumber":{"definition":"Vô cùng bình tĩnh, điềm nhiên như không.","example":"Even during the intense meeting, she remained as cool as a cucumber.","exampleTranslation":"Ngay cả trong cuộc họp căng thẳng, cô ấy vẫn bình tĩnh như không.","partOfSpeech":"idiom"},"Cool your jets":{"definition":"Bình tĩnh lại đi, bớt nóng nảy đi.","example":"You need to cool your jets and think this through.","exampleTranslation":"Bạn cần bình tĩnh lại và suy nghĩ kỹ chuyện này.","partOfSpeech":"idiom"},"Copycat":{"definition":"Kẻ bắt chước, người chuyên sao chép người khác.","example":"Stop being a copycat and come up with your own ideas.","exampleTranslation":"Đừng bắt chước người khác nữa và hãy tự nghĩ ra ý tưởng của riêng mình.","partOfSpeech":"idiom"},"Corner the market":{"definition":"Độc quyền thị trường, lũng đoạn thị trường.","example":"With their new technology, they have cornered the market on electric cars.","exampleTranslation":"Với công nghệ mới, họ đã độc chiếm thị trường xe điện.","partOfSpeech":"idiom"},"Cost a mint":{"definition":"Đắt đỏ, tốn cả đống tiền.","example":"The new car cost a mint, but it’s worth every penny.","exampleTranslation":"Chiếc xe mới tốn cả một gia tài, nhưng xứng đáng với từng đồng bỏ ra.","partOfSpeech":"idiom"},"Cost an arm and a leg":{"definition":"Đắt cắt cổ, tốn một khoản tiền lớn.","example":"The new smartphone costs an arm and a leg, but it’s totally worth it.","exampleTranslation":"Chiếc điện thoại thông minh mới giá rất đắt, nhưng hoàn toàn xứng đáng.","partOfSpeech":"idiom"},"Couch potato":{"definition":"Người lười biếng suốt ngày dán mắt vào tivi.","example":"He became a couch potato after retiring from work.","exampleTranslation":"Anh ấy trở thành người lười biếng suốt ngày ngồi xem tivi sau khi nghỉ hưu.","partOfSpeech":"idiom"},"Couldn't care less":{"definition":"Hoàn toàn không quan tâm, không mảy may bận tâm.","example":"He couldn’t care less about what others think of him.","exampleTranslation":"Anh ta chẳng quan tâm chút nào người khác nghĩ gì về mình.","partOfSpeech":"idiom"},"Country mile":{"definition":"Một khoảng cách rất xa.","example":"We still have a country mile to go before we reach the nearest town.","exampleTranslation":"Chúng tôi vẫn còn một quãng đường dài nữa mới đến thị trấn gần nhất.","partOfSpeech":"idiom"},"Cover a lot of ground":{"definition":"Bàn luận/giải quyết nhiều vấn đề, bao quát nhiều nội dung.","example":"In today’s meeting, we need to cover a lot of ground in a short time.","exampleTranslation":"Trong cuộc họp hôm nay, chúng ta cần đề cập rất nhiều nội dung trong thời gian ngắn.","partOfSpeech":"idiom"},"Crack a book":{"definition":"Mở sách ra học, đụng đến sách vở.","example":"If you want to pass the test, you need to crack a book tonight.","exampleTranslation":"Nếu muốn qua kỳ thi, bạn cần mở sách ra học ngay tối nay.","partOfSpeech":"idiom"},"Crack open a cold one":{"definition":"Mở một lon bia lạnh để giải khát/thư giãn.","example":"After a long day at work, he likes to crack open a cold one and unwind.","exampleTranslation":"Sau một ngày làm việc dài, anh ấy thích mở một lon bia lạnh và thư giãn.","partOfSpeech":"idiom"},"Crack someone up":{"definition":"Làm cho ai đó cười phá lên, chọc cười ai đó.","example":"The comedian’s jokes always crack me up.","exampleTranslation":"Những câu chuyện cười của diễn viên hài luôn khiến tôi bật cười.","partOfSpeech":"idiom"},"cram for an exam":{"definition":"Học nhồi học nhét trước kỳ thi, học dồn nước đến chân mới nhảy.","example":"Instead of studying consistently, he stayed up all night to cram for the physics exam.","exampleTranslation":"Thay vì học đều đặn, anh ấy thức suốt đêm để học nhồi cho kỳ thi vật lý.","partOfSpeech":"idiom"},"Crank out":{"definition":"Sản xuất hàng loạt, làm ra một cách vội vã.","example":"During finals week, I had to crank out several papers in a row.","exampleTranslation":"Trong tuần thi cuối kỳ, tôi phải viết gấp vài bài luận liên tiếp.","partOfSpeech":"idiom"},"Cream of the crop":{"definition":"Phần tinh túy nhất, người/vật xuất sắc nhất trong nhóm.","example":"Only the cream of the crop get selected for the elite team.","exampleTranslation":"Chỉ những người xuất sắc nhất mới được chọn vào đội tinh nhuệ.","partOfSpeech":"idiom"},"Crickets":{"definition":"Sự im lặng đáng sợ (khi không ai lên tiếng hưởng ứng hay trả lời).","example":"When I asked for volunteers, I was met with crickets.","exampleTranslation":"Khi tôi hỏi có ai tình nguyện không, tôi chỉ nhận lại sự im lặng.","partOfSpeech":"idiom"},"Crocodile tears":{"definition":"Nước mắt cá sấu, sự đau buồn giả tạo.","example":"He shed crocodile tears at the funeral, though everyone knew he didn’t care.","exampleTranslation":"Anh ta rơi nước mắt cá sấu tại đám tang, dù ai cũng biết anh ta chẳng quan tâm.","partOfSpeech":"idiom"},"Cross one's fingers":{"definition":"Cầu may mắn, đan chéo ngón tay cầu nguyện.","example":"I’m crossing my fingers that it doesn’t rain during our picnic.","exampleTranslation":"Tôi đang cầu mong trời không mưa trong buổi dã ngoại của chúng ta.","partOfSpeech":"idiom"},"cross paths":{"definition":"Tình cờ gặp gỡ, hội ngộ tình cờ.","example":"We crossed paths at an international tech conference in Tokyo last year.","exampleTranslation":"Chúng tôi tình cờ gặp nhau tại một hội nghị công nghệ quốc tế ở Tokyo vào năm ngoái.","partOfSpeech":"idiom"},"Cross that bridge when one comes to it":{"definition":"Tới đâu hay tới đó, khi nào có chuyện mới giải quyết.","example":"We don’t know what the outcome will be, but let’s cross that bridge when we come to it.","exampleTranslation":"Chúng ta không biết kết quả sẽ ra sao, nhưng hãy đến lúc đó rồi tính.","partOfSpeech":"idiom"},"cross your fingers":{"definition":"Cầu chúc may mắn, hy vọng mọi chuyện suôn sẻ.","example":"Keep your fingers crossed for me while I do my job interview today!","exampleTranslation":"Hãy cầu may cho tôi trong lúc tôi phỏng vấn xin việc hôm nay nhé!","partOfSpeech":"idiom"},"Crunch time":{"definition":"Thời khắc quyết định, giai đoạn nước rút.","example":"With the project deadline tomorrow, it's crunch time for the whole team.","exampleTranslation":"Hạn chót của dự án là ngày mai, nên đây là lúc căng thẳng nhất của cả nhóm.","partOfSpeech":"idiom"},"cry over spilled milk":{"definition":"Kêu khóc nuối tiếc chuyện đã rồi (chuyện đã qua không cứu vãn được).","example":"The flight is already cancelled, so there is no use crying over spilled milk—let us book a hotel.","exampleTranslation":"Chuyến bay đã bị hủy rồi, nên tiếc nuối cũng vô ích — hãy đặt khách sạn thôi.","partOfSpeech":"idiom"},"Cry wolf":{"definition":"Kêu cứu giả vờ, báo động giả nhiều lần khiến không ai tin nữa.","example":"If you cry wolf too many times, people won't believe you when you're telling the truth.","exampleTranslation":"Nếu bạn kêu cứu giả quá nhiều lần, mọi người sẽ không tin khi bạn nói thật.","partOfSpeech":"idiom"},"Cup of joe":{"definition":"Một tách cà phê.","example":"I need a cup of joe to start my day.","exampleTranslation":"Tôi cần một tách cà phê để bắt đầu ngày mới.","partOfSpeech":"idiom"},"cup of tea":{"definition":"Sở thích, gu ưa thích của ai.","example":"Horror movies are really not my cup of tea; I prefer romantic comedies.","exampleTranslation":"Phim kinh dị thực sự không hợp gu của tôi; tôi thích phim hài lãng mạn hơn.","partOfSpeech":"idiom"},"Curiosity killed the cat":{"definition":"Tò mò hại thân.","example":"You shouldn’t go poking around in his room, remember, curiosity killed the cat.","exampleTranslation":"Bạn không nên tò mò lục lọi phòng anh ấy, hãy nhớ rằng tò mò hại thân.","partOfSpeech":"idiom"},"Curveball":{"definition":"Sự việc bất ngờ (thường gây khó khăn), quả bóng xoáy.","example":"Life threw me a curveball when I lost my job suddenly.","exampleTranslation":"Cuộc sống đã tung cho tôi một tình huống bất ngờ khi tôi đột ngột mất việc.","partOfSpeech":"idiom"},"Cut and dried":{"definition":"Đã được định đoạt, rõ ràng rành rọt.","example":"The rules for the competition are cut and dried.","exampleTranslation":"Các quy định của cuộc thi đã rõ ràng và dứt khoát.","partOfSpeech":"idiom"},"cut corners":{"definition":"Đốt cháy giai đoạn, làm ẩu để tiết kiệm tiền/thời gian.","example":"Never cut corners when it comes to construction safety standards.","exampleTranslation":"Không bao giờ làm ẩu khi liên quan đến các tiêu chuẩn an toàn xây dựng.","partOfSpeech":"idiom"},"Cut someone off at the knees":{"definition":"Triệt hạ uy tín, làm bẽ mặt, dập tắt sự tự tin của ai đó.","example":"Her rude remark cut him off at the knees during the meeting.","exampleTranslation":"Lời nhận xét thô lỗ của cô ấy đã khiến anh ta bị hạ nhục ngay trong cuộc họp.","partOfSpeech":"idiom"},"Cut someone some slack":{"definition":"Chiếu cố, nương tay cho ai đó.","example":"He’s new to the job, so let’s cut him some slack while he learns the ropes.","exampleTranslation":"Anh ấy mới vào làm nên hãy châm chước cho anh ấy trong lúc anh ấy học việc.","partOfSpeech":"idiom"},"Cut the mustard":{"definition":"Đạt yêu cầu, đáp ứng được tiêu chuẩn.","example":"I’m not sure if he can cut the mustard in this highly competitive industry.","exampleTranslation":"Tôi không chắc anh ta có đủ năng lực để thành công trong ngành cạnh tranh khốc liệt này.","partOfSpeech":"idiom"},"Cut to the chase":{"definition":"Đi thẳng vào vấn đề.","example":"Let's cut to the chase — how much is this going to cost?","exampleTranslation":"Hãy đi thẳng vào vấn đề — việc này sẽ tốn bao nhiêu tiền?","partOfSpeech":"idiom"},"Cut to the quick":{"definition":"Chạm nọc, làm tổn thương sâu sắc.","example":"His harsh words really cut her to the quick.","exampleTranslation":"Những lời gay gắt của anh ta thực sự làm cô ấy tổn thương sâu sắc.","partOfSpeech":"idiom"},"Cute as a bug":{"definition":"Rất dễ thương.","example":"Her baby is cute as a bug; everyone loves to hold him.","exampleTranslation":"Em bé của cô ấy dễ thương hết sức; ai cũng thích bế.","partOfSpeech":"idiom"},"Cutting corners":{"definition":"Đi tắt đón đầu, làm việc cẩu thả để tiết kiệm thời gian hoặc tiền bạc.","example":"If you keep cutting corners, the project will not meet the quality standards.","exampleTranslation":"Nếu bạn cứ làm ẩu, dự án sẽ không đạt tiêu chuẩn chất lượng.","partOfSpeech":"idiom"},"Damn someone with faint praise":{"definition":"Khen để mà chê, khen lấy lệ.","example":"The review called it 'a decent effort,' which seemed like damning the work with faint praise.","exampleTranslation":"Bài đánh giá gọi đó là \"một nỗ lực khá ổn\", nghe như đang chê bai công việc bằng lời khen nhạt nhẽo.","partOfSpeech":"idiom"},"Dawned on me":{"definition":"Chợt nhận ra.","example":"It finally dawned on me that I had left my keys at home.","exampleTranslation":"Cuối cùng tôi cũng chợt nhận ra mình đã để quên chìa khóa ở nhà.","partOfSpeech":"idiom"},"day in day out":{"definition":"Ngày này qua ngày khác, ngày nào cũng như ngày nào.","example":"Day in day out, he rode the same crowded commuter train to work.","exampleTranslation":"Ngày này qua ngày khác, anh ấy đi cùng chuyến tàu đông đúc đó để đến chỗ làm.","partOfSpeech":"idiom"},"Dead from the neck up":{"definition":"Ngu ngốc, không có não.","example":"He's so careless with his work; he's practically dead from the neck up.","exampleTranslation":"Anh ta làm việc cẩu thả quá; anh ta gần như chẳng có chút suy nghĩ nào.","partOfSpeech":"idiom"},"Dead in the water":{"definition":"Bế tắc, dậm chân tại chỗ.","example":"The project is dead in the water without additional funding.","exampleTranslation":"Dự án sẽ đứng yên không tiến triển nếu không có thêm vốn.","partOfSpeech":"idiom"},"Dead quiet":{"definition":"Yên tĩnh tĩnh mịch, lặng ngắt như tờ.","example":"The classroom was dead quiet during the exam.","exampleTranslation":"Lớp học yên lặng như tờ trong suốt kỳ thi.","partOfSpeech":"idiom"},"Dead ringer":{"definition":"Bản sao giống hệt.","example":"She's a dead ringer for her mother.","exampleTranslation":"Cô ấy giống mẹ như đúc.","partOfSpeech":"idiom"},"Dead tired":{"definition":"Mệt lử, mệt chết đi được.","example":"After hiking all day, I was completely dead tired.","exampleTranslation":"Sau khi đi bộ đường dài cả ngày, tôi mệt rã rời.","partOfSpeech":"idiom"},"Dead to the world":{"definition":"Ngủ say như chết.","example":"After the long hike, he was dead to the world as soon as he hit the bed.","exampleTranslation":"Sau chuyến đi bộ dài, vừa đặt lưng xuống giường là anh ấy ngủ say như chết.","partOfSpeech":"idiom"},"Dead-end job":{"definition":"Công việc không có cơ hội thăng tiến.","example":"Tom felt stuck in a dead-end job with no hope of promotion.","exampleTranslation":"Tom cảm thấy mắc kẹt trong một công việc bế tắc không có hy vọng thăng tiến.","partOfSpeech":"idiom"},"Deep down":{"definition":"Tận đáy lòng, sâu thẳm bên trong.","example":"Deep down, he knows he should apologize.","exampleTranslation":"Trong thâm tâm, anh ấy biết mình nên xin lỗi.","partOfSpeech":"idiom"},"devil's advocate":{"definition":"Người phản biện, người đóng vai phản bác để đào sâu vấn đề.","example":"I agree with your plan, but let me play devil's advocate to test its weaknesses.","exampleTranslation":"Tôi đồng ý với kế hoạch của bạn, nhưng hãy để tôi đóng vai phản biện để kiểm tra những điểm yếu của nó.","partOfSpeech":"idiom"},"Diamond in the rough":{"definition":"Viên ngọc thô (người/vật có tiềm năng nhưng chưa được mài giũa).","example":"The new intern is a real diamond in the rough; with some training, he could become a great asset to the team.","exampleTranslation":"Thực tập sinh mới thực sự là viên ngọc thô; chỉ cần đào tạo một chút, anh ấy có thể trở thành tài sản quý giá của nhóm.","partOfSpeech":"idiom"},"Different strokes for different folks":{"definition":"Mỗi người một sở thích.","example":"Some people like hiking, while others prefer reading. Different strokes for different folks.","exampleTranslation":"Có người thích đi bộ đường dài, người khác lại thích đọc sách. Mỗi người một sở thích.","partOfSpeech":"idiom"},"Dig in your heels":{"definition":"Kiên quyết giữ vững lập trường, ngoan cố.","example":"Despite the criticism, she decided to dig in her heels and stick to her plan.","exampleTranslation":"Bất chấp những lời chỉ trích, cô ấy quyết định kiên quyết giữ vững kế hoạch của mình.","partOfSpeech":"idiom"},"Dirt cheap":{"definition":"Rẻ bèo, rẻ như cho.","example":"I found this shirt at the market, and it was dirt cheap.","exampleTranslation":"Tôi tìm thấy chiếc áo này ở chợ, và nó rẻ như cho.","partOfSpeech":"idiom"},"Dish the dirt":{"definition":"Ngồi lê đôi mách, nói xấu người khác.","example":"She loves to dish the dirt about her coworkers.","exampleTranslation":"Cô ấy rất thích buôn chuyện xấu về đồng nghiệp.","partOfSpeech":"idiom"},"Divide the spoils":{"definition":"Chia chác chiến lợi phẩm.","example":"After the successful business venture, the partners gathered to divide the spoils.","exampleTranslation":"Sau thương vụ kinh doanh thành công, các đối tác tụ họp để chia chiến lợi phẩm.","partOfSpeech":"idiom"},"Do a number on something":{"definition":"Gây tổn hại nghiêm trọng, tàn phá.","example":"The storm really did a number on our roof.","exampleTranslation":"Cơn bão thực sự đã tàn phá mái nhà của chúng tôi.","partOfSpeech":"idiom"},"Do or die":{"definition":"Chơi tới bến, được ăn cả ngã về không.","example":"I have to nail this presentation. It's a do or die situation.","exampleTranslation":"Tôi phải làm thật tốt bài thuyết trình này. Đây là tình huống sống còn.","partOfSpeech":"idiom"},"Do someone a good turn":{"definition":"Làm việc tốt giúp đỡ ai đó.","example":"He did me a good turn by lending me his car for the weekend.","exampleTranslation":"Anh ấy đã giúp tôi một việc tốt khi cho tôi mượn xe vào cuối tuần.","partOfSpeech":"idiom"},"Do something at the drop of a hat":{"definition":"Làm việc gì đó ngay lập tức, không chút do dự.","example":"She's always ready to help her friends at the drop of a hat.","exampleTranslation":"Cô ấy luôn sẵn sàng giúp đỡ bạn bè ngay lập tức.","partOfSpeech":"idiom"},"Do something by the seat of your pants":{"definition":"Làm việc theo bản năng, không có kế hoạch trước.","example":"He decided to fix the bike by the seat of his pants, even though he had no experience.","exampleTranslation":"Anh ấy quyết định sửa chiếc xe đạp theo cảm tính, dù không có kinh nghiệm.","partOfSpeech":"idiom"},"Doesn't hold water":{"definition":"Không đáng tin, vô lý.","example":"His explanation for being late just doesn't hold water.","exampleTranslation":"Lời giải thích của anh ta về việc đến muộn chẳng thuyết phục chút nào.","partOfSpeech":"idiom"},"Doesn't know beans about it":{"definition":"Không biết tí gì về chuyện đó, mù tịt.","example":"He doesn't know beans about car mechanics.","exampleTranslation":"Anh ta chẳng biết gì về cơ khí ô tô cả.","partOfSpeech":"idiom"},"Dog and pony show":{"definition":"Buổi biểu diễn màu mè, làm màu.","example":"The investors saw right through the dog and pony show and asked for more concrete details.","exampleTranslation":"Các nhà đầu tư đã nhìn thấu màn trình diễn hào nhoáng và yêu cầu thông tin cụ thể hơn.","partOfSpeech":"idiom"},"Dog days of summer":{"definition":"Những ngày nóng nực nhất của mùa hè.","example":"The dog days of summer make it hard to enjoy outdoor activities.","exampleTranslation":"Những ngày nóng nhất của mùa hè khiến việc tham gia các hoạt động ngoài trời trở nên khó khăn.","partOfSpeech":"idiom"},"Dog-eat-dog":{"definition":"Cạnh tranh khốc liệt, cá lớn nuốt cá bé.","example":"The corporate world can often be a dog-eat-dog environment.","exampleTranslation":"Thế giới doanh nghiệp thường là môi trường cạnh tranh khốc liệt, kẻ mạnh nuốt kẻ yếu.","partOfSpeech":"idiom"},"Dollars to doughnuts":{"definition":"Dám cá là, chắc chắn là.","example":"Dollars to doughnuts, they'll be late again.","exampleTranslation":"Tôi cá chắc là họ sẽ lại đến muộn.","partOfSpeech":"idiom"},"Don't beat a dead horse":{"definition":"Tốn công vô ích, nhai đi nhai lại một vấn đề đã ngã ngũ.","example":"We have already decided to go with the new plan. Let's not beat a dead horse.","exampleTranslation":"Chúng ta đã quyết định theo kế hoạch mới. Đừng nhắc đi nhắc lại chuyện cũ vô ích nữa.","partOfSpeech":"idiom"},"Don't count your chickens before they hatch":{"definition":"Đếm cua trong lỗ, nói trước bước không qua.","example":"You may get the promotion, but don't count your chickens before they hatch.","exampleTranslation":"Bạn có thể được thăng chức, nhưng đừng vội mừng khi chưa chắc chắn.","partOfSpeech":"idiom"},"Don't cry over spilt milk":{"definition":"Đừng tiếc rẻ những gì đã mất.","example":"You failed the test, but don't cry over spilt milk; focus on the next one.","exampleTranslation":"Bạn thi trượt, nhưng đừng tiếc nuối chuyện đã rồi; hãy tập trung vào bài kế tiếp.","partOfSpeech":"idiom"},"Don't do anything I wouldn't do":{"definition":"Đừng làm gì bậy bạ nhé (lời khuyên đùa cợt).","example":"Have fun on your trip, and don't do anything I wouldn't do!","exampleTranslation":"Chúc bạn chuyến đi vui vẻ, và đừng làm gì mà tôi sẽ không làm nhé!","partOfSpeech":"idiom"},"Don't give up your day job":{"definition":"Đừng bỏ công việc chính (ý chê bai tài năng mới không đủ giỏi để kiếm sống).","example":"His singing is bad, so don't give up your day job.","exampleTranslation":"Giọng hát của anh ấy dở, nên đừng bỏ công việc hiện tại.","partOfSpeech":"idiom"},"Don't hold your breath":{"definition":"Đừng hi vọng quá nhiều.","example":"If you're waiting for him to apologize, don't hold your breath.","exampleTranslation":"Nếu bạn đang chờ anh ta xin lỗi, đừng mong đợi gì nhiều.","partOfSpeech":"idiom"},"Don't know him from Adam":{"definition":"Hoàn toàn không biết người đó là ai.","example":"I wouldn't trust him with my car; I don't know him from Adam.","exampleTranslation":"Tôi sẽ không giao xe cho anh ta; tôi hoàn toàn không biết anh ta là ai.","partOfSpeech":"idiom"},"Don't know if I'm coming or going":{"definition":"Rối bời, không biết đường nào mà lần.","example":"With all these deadlines, I don't know if I'm coming or going.","exampleTranslation":"Với tất cả những hạn chót này, tôi không biết mình đang đi hay đang đến nữa.","partOfSpeech":"idiom"},"Don't look a gift horse in the mouth":{"definition":"Đừng săm soi món quà được tặng.","example":"Even if it's not exactly what you wanted, don't look a gift horse in the mouth.","exampleTranslation":"Dù không đúng hoàn toàn như bạn mong muốn, đừng chê món quà được tặng.","partOfSpeech":"idiom"},"Don't put all your eggs in one basket":{"definition":"Đừng bỏ tất cả trứng vào một giỏ (đừng mạo hiểm dồn hết mọi thứ vào một chỗ).","example":"For his new business, he decided to diversify his product line rather than put all his eggs in one basket.","exampleTranslation":"Với công việc kinh doanh mới, anh ấy quyết định đa dạng hóa dòng sản phẩm thay vì bỏ tất cả trứng vào một giỏ.","partOfSpeech":"idiom"},"Don't quote me on that":{"definition":"Đừng trích lời tôi nhé (tôi không chắc chắn 100% đâu).","example":"I think the meeting is at 3 PM, but don't quote me on that.","exampleTranslation":"Tôi nghĩ cuộc họp là lúc 3 giờ chiều, nhưng đừng lấy đó làm chắc chắn nhé.","partOfSpeech":"idiom"},"Don't sweat the small stuff":{"definition":"Đừng bận tâm những chuyện vặt vãnh.","example":"Life's too short to worry about every little mistake. Don't sweat the small stuff.","exampleTranslation":"Cuộc sống quá ngắn để lo lắng về mọi sai sót nhỏ. Đừng bận tâm đến những chuyện nhỏ nhặt.","partOfSpeech":"idiom"},"Don't throw the baby out with the bath water":{"definition":"Đừng vứt bỏ thứ quý giá cùng với những thứ vô ích.","example":"While redesigning the website, don't throw the baby out with the bath water; keep what works well.","exampleTranslation":"Khi thiết kế lại trang web, đừng vứt bỏ cả những thứ tốt; hãy giữ lại những gì đang hoạt động hiệu quả.","partOfSpeech":"idiom"},"Don't want to hear that":{"definition":"Không muốn nghe, từ chối chấp nhận sự thật.","example":"I don't want to hear that you're quitting the team.","exampleTranslation":"Tôi không muốn nghe việc bạn rời khỏi đội.","partOfSpeech":"idiom"},"Done to a turn":{"definition":"Chín tới (thức ăn) hoặc làm hoàn hảo (công việc).","example":"The steak was done to a turn, juicy and flavorful.","exampleTranslation":"Miếng bít tết được nấu chín vừa tới, mọng nước và đậm đà.","partOfSpeech":"idiom"},"Doom and gloom":{"definition":"Bi quan, u ám.","example":"Despite the doom and gloom prediction, the company posted record profits.","exampleTranslation":"Bất chấp dự đoán bi quan, công ty đã công bố lợi nhuận kỷ lục.","partOfSpeech":"idiom"},"Double whammy":{"definition":"Họa vô đơn chí, tổn thất kép.","example":"Losing his job and wrecking his car on the same day was a real double whammy for John.","exampleTranslation":"Mất việc và hỏng xe trong cùng một ngày thực sự là một cú đòn kép đối với John.","partOfSpeech":"idiom"},"Down in the dumps":{"definition":"Buồn bã, chán nản.","example":"Jane's been down in the dumps since she lost her job.","exampleTranslation":"Jane đã buồn rầu kể từ khi mất việc.","partOfSpeech":"idiom"},"Down in the mouth":{"definition":"Trông ủ rũ, chán chường.","example":"After hearing the bad news, she was really down in the mouth.","exampleTranslation":"Sau khi nghe tin xấu, cô ấy thực sự rất buồn bã.","partOfSpeech":"idiom"},"Down the tube":{"definition":"Đổ sông đổ biển, thất bại hoàn toàn.","example":"All the time and effort went down the tube when the project was canceled.","exampleTranslation":"Toàn bộ thời gian và công sức đã đổ sông đổ biển khi dự án bị hủy bỏ.","partOfSpeech":"idiom"},"down to earth":{"definition":"Thực tế, bình dị, gần gũi, không kiểu cách.","example":"Despite her massive international fame, she remains remarkably down to earth.","exampleTranslation":"Dù nổi tiếng quốc tế, cô ấy vẫn rất giản dị, gần gũi.","partOfSpeech":"idiom"},"down to the wire":{"definition":"Tới phút chót, đến phút cuối cùng mới ngã ngũ.","example":"The election came down to the wire with results revealed just before midnight.","exampleTranslation":"Cuộc bầu cử diễn ra sít sao đến phút chót, kết quả chỉ được công bố ngay trước nửa đêm.","partOfSpeech":"idiom"},"down-to-earth":{"definition":"Thực tế, giản dị, không viển vông.","example":"Despite his success, he remains down-to-earth and humble.","exampleTranslation":"Dù thành công, anh ấy vẫn giản dị và khiêm tốn.","partOfSpeech":"idiom"},"drag one's feet":{"definition":"Chần chừ, cố ý kéo dài thời gian (vì miễn cưỡng).","example":"The committee is dragging its feet on making a final decision.","exampleTranslation":"Ủy ban đang kéo dài thời gian trong việc đưa ra quyết định cuối cùng.","partOfSpeech":"idiom"},"drastic times call for drastic measures":{"definition":"Tình thế nguy cấp đòi hỏi những biện pháp quyết liệt (tùy cơ ứng biến).","example":"During the economic crisis, the government decided that drastic times call for drastic measures and implemented severe budget cuts.","exampleTranslation":"Trong cuộc khủng hoảng kinh tế, chính phủ quyết định thời thế đặc biệt cần biện pháp đặc biệt và áp dụng cắt giảm ngân sách mạnh tay.","partOfSpeech":"idiom"},"draw a blank":{"definition":"Trống rỗng, không nhớ ra được gì, không tìm thấy kết quả.","example":"I tried to remember her name, but I completely drew a blank.","exampleTranslation":"Tôi cố nhớ tên cô ấy, nhưng đầu óc hoàn toàn trống rỗng.","partOfSpeech":"idiom"},"drawing card":{"definition":"Yếu tố thu hút, sức hút chính (đối với khán giả hoặc khách hàng).","example":"The new roller coaster is the main drawing card of the amusement park.","exampleTranslation":"Tàu lượn siêu tốc mới là điểm thu hút chính của công viên giải trí.","partOfSpeech":"idiom"},"dressed to kill":{"definition":"Ăn mặc lộng lẫy, diện đồ lồng lộn để gây ấn tượng mạnh.","example":"She arrived at the party dressed to kill, with a stunning red gown that caught everyone's eye.","exampleTranslation":"Cô ấy đến bữa tiệc trong bộ trang phục lộng lẫy, với chiếc váy đỏ rực rỡ thu hút mọi ánh nhìn.","partOfSpeech":"idiom"},"Drink like a fish":{"definition":"Uống rượu như nước lã, nhậu nhẹt nát rượu.","example":"After his breakup, he started to drink like a fish every night.","exampleTranslation":"Sau khi chia tay, anh ta bắt đầu uống rượu như hũ chìm mỗi đêm.","partOfSpeech":"idiom"},"drive someone crazy":{"definition":"Làm ai phát điên, làm ai phát cáu.","example":"The constant barking of the neighbor's dog is driving me crazy.","exampleTranslation":"Tiếng chó sủa liên tục của nhà hàng xóm đang làm tôi phát điên.","partOfSpeech":"idiom"},"drive someone nuts":{"definition":"Làm ai đó phát điên, chọc tức ai đó.","example":"The constant noise from the construction site is driving me nuts.","exampleTranslation":"Tiếng ồn liên tục từ công trường xây dựng đang làm tôi phát điên.","partOfSpeech":"idiom"},"drive someone up the wall":{"definition":"Làm ai đó bực tức, phát điên lên được.","example":"The constant noise from the construction site is driving me up the wall.","exampleTranslation":"Tiếng ồn liên tục từ công trường xây dựng đang khiến tôi bực bội đến mức muốn nổi điên.","partOfSpeech":"idiom"},"drop by":{"definition":"Ghé ngang qua, tạt qua (thăm viếng ngắn).","example":"Feel free to drop by my office if you have any questions.","exampleTranslation":"Cứ tự nhiên ghé qua văn phòng của tôi nếu bạn có câu hỏi nào.","partOfSpeech":"idiom"},"drop out of school":{"definition":"Bỏ học giữa chừng.","example":"Several tech founders famously dropped out of school to start their companies.","exampleTranslation":"Nhiều nhà sáng lập công nghệ nổi tiếng đã bỏ học để khởi nghiệp.","partOfSpeech":"idiom"},"drop someone a line":{"definition":"Viết vài dòng, gửi một tin nhắn hoặc lá thư ngắn cho ai đó.","example":"I'll drop you a line when I get to Paris.","exampleTranslation":"Tôi sẽ viết thư cho bạn khi đến Paris.","partOfSpeech":"idiom"},"drop-dead gorgeous":{"definition":"Đẹp rạng ngời, đẹp nghiêng nước nghiêng thành.","example":"She walked into the room, and everyone was stunned because she looked drop-dead gorgeous.","exampleTranslation":"Cô ấy bước vào phòng, và mọi người đều sững sờ vì cô ấy đẹp lộng lẫy.","partOfSpeech":"idiom"},"dry run":{"definition":"Buổi diễn tập, buổi chạy thử.","example":"Let's do a dry run of the presentation to make sure everything goes smoothly.","exampleTranslation":"Hãy chạy thử bài thuyết trình để đảm bảo mọi thứ diễn ra suôn sẻ.","partOfSpeech":"idiom"},"dyed-in-the-wool":{"definition":"Cố hữu, thâm căn cố đế, không thể thay đổi.","example":"He's a dyed-in-the-wool conservative; no argument will change his mind.","exampleTranslation":"Anh ta là người bảo thủ cố hữu; không lập luận nào có thể thay đổi suy nghĩ của anh ta.","partOfSpeech":"idiom"},"eager beaver":{"definition":"Người nhiệt tình, tham công tiếc việc, hăng hái quá mức.","example":"John is such an eager beaver; he volunteers for every project.","exampleTranslation":"John là người siêng năng nhiệt tình; anh ấy xung phong tham gia mọi dự án.","partOfSpeech":"idiom"},"easy come, easy go":{"definition":"Của thiên trả địa, dễ đến dễ đi.","example":"He spent his lottery winnings in a month — easy come, easy go.","exampleTranslation":"Anh ta tiêu hết tiền trúng số trong một tháng — của thiên trả địa.","partOfSpeech":"idiom"},"easy does it":{"definition":"Cẩn thận nào, từ từ thôi, nhẹ tay thôi.","example":"Easy does it when you're carrying those dishes.","exampleTranslation":"Hãy nhẹ nhàng khi bạn bê những chiếc đĩa đó.","partOfSpeech":"idiom"},"eat crow":{"definition":"Phải nhận sai, phải muối mặt thừa nhận mình đã lầm.","example":"After insisting that he was right, John had to eat crow when the true facts came out.","exampleTranslation":"Sau khi khăng khăng rằng mình đúng, John phải ăn nói khiêm tốn nhận sai khi sự thật được phơi bày.","partOfSpeech":"idiom"},"eat like a bird":{"definition":"Ăn nhỏ nhẻ, ăn ít như mèo.","example":"She always eats like a bird, barely finishing her plate.","exampleTranslation":"Cô ấy luôn ăn rất ít, hiếm khi ăn hết đĩa của mình.","partOfSpeech":"idiom"},"eat like a horse":{"definition":"Ăn thùng bất chiêng, ăn rất khỏe.","example":"He eats like a horse; he finished three plates of pasta!","exampleTranslation":"Anh ấy ăn như hổ đói; anh ấy ăn hết ba đĩa mì ống!","partOfSpeech":"idiom"},"eat one's hat":{"definition":"Chắc chắn không xảy ra (nếu xảy ra thì tôi đi đầu xuống đất).","example":"If he wins the lottery, I'll eat my hat.","exampleTranslation":"Nếu anh ta trúng số, tôi xin ăn cái mũ của mình.","partOfSpeech":"idiom"},"eat one's heart out":{"definition":"Ghen tị đi nha, cứ thèm thuồng đi.","example":"I've got front-row tickets to see Taylor Swift. Eat your heart out!","exampleTranslation":"Tôi có vé hàng ghế đầu xem Taylor Swift. Ghen tị đi nhé!","partOfSpeech":"idiom"},"egg on one's face":{"definition":"Bẽ mặt, xấu hổ vì bị quê / làm trò cười.","example":"He had egg on his face when his confident prediction about the stock market turned out completely wrong.","exampleTranslation":"Anh ta xấu hổ ê mặt khi dự đoán tự tin của mình về thị trường chứng khoán hóa ra hoàn toàn sai.","partOfSpeech":"idiom"},"elevator pitch":{"definition":"Bài thuyết trình ngắn gọn (chỉ vài chục giây), lời tự giới thiệu súc tích.","example":"In just two minutes, he delivered a convincing elevator pitch to the investors.","exampleTranslation":"Chỉ trong hai phút, anh ấy đã trình bày một bài giới thiệu ngắn gọn đầy thuyết phục với các nhà đầu tư.","partOfSpeech":"idiom"},"eleventh hour":{"definition":"Phút chót, giờ thứ 11 (thời khắc cuối cùng trước khi quá muộn).","example":"The labor union reached an agreement with management at the eleventh hour, avoiding a strike.","exampleTranslation":"Công đoàn đã đạt được thỏa thuận với ban quản lý vào phút chót, tránh được cuộc đình công.","partOfSpeech":"idiom"},"Elvis has left the building":{"definition":"Mọi chuyện đã kết thúc, vãn tuồng rồi.","example":"The show is over. It's time to go home; Elvis has left the building.","exampleTranslation":"Buổi diễn đã kết thúc. Đã đến lúc về nhà; mọi người đã ra về hết.","partOfSpeech":"idiom"},"empty nest syndrome":{"definition":"Hội chứng tổ trống (cảm giác cô đơn, trống trải của cha mẹ khi con cái trưởng thành dọn ra ở riêng).","example":"After their youngest daughter went to college, they experienced empty nest syndrome.","exampleTranslation":"Sau khi cô con gái út vào đại học, họ trải qua hội chứng tổ ấm trống vắng.","partOfSpeech":"idiom"},"every cloud has a silver lining":{"definition":"Trong cái rủi có cái may, sau cơn mưa trời lại sáng.","example":"After losing his job, he realized that every cloud has a silver lining when he found a better position.","exampleTranslation":"Sau khi mất việc, anh nhận ra trong cái rủi có cái may khi tìm được vị trí tốt hơn.","partOfSpeech":"idiom"},"every dog has his day":{"definition":"Ai rồi cũng có lúc vinh quang, sông có khúc người có lúc.","example":"He finally got his breakthrough. I guess every dog has his day.","exampleTranslation":"Cuối cùng anh ấy cũng có bước đột phá. Tôi đoán ai cũng có lúc gặp may.","partOfSpeech":"idiom"},"every now and then":{"definition":"Thỉnh thoảng, đôi khi.","example":"I like to take a walk every now and then to clear my mind.","exampleTranslation":"Tôi thích đi dạo thỉnh thoảng để đầu óc thư thái.","partOfSpeech":"idiom"},"everything but the kitchen sink":{"definition":"Thượng vàng hạ cám, đem theo mọi thứ có thể (đồ lỉnh kỉnh).","example":"They packed everything but the kitchen sink for their camping trip.","exampleTranslation":"Họ mang theo mọi thứ có thể cho chuyến cắm trại của họ.","partOfSpeech":"idiom"},"exact change":{"definition":"Tiền lẻ trả vừa đủ (không cần thối lại).","example":"Do you have exact change for the bus fare?","exampleTranslation":"Bạn có tiền lẻ đúng số tiền vé xe buýt không?","partOfSpeech":"idiom"},"excuse my French / pardon my French":{"definition":"Xin lỗi vì đã văng tục/nói bậy.","example":"He's such a... pardon my French, jerk.","exampleTranslation":"Anh ta đúng là... xin lỗi nói thô, đồ khốn.","partOfSpeech":"idiom"},"extended family":{"definition":"Đại gia đình (bao gồm ông bà, cô dì chú bác, anh em họ).","example":"During the Lunar New Year, our whole extended family gathers for a festive reunion dinner.","exampleTranslation":"Vào dịp Tết Nguyên đán, cả đại gia đình chúng tôi quây quần bên bữa cơm đoàn viên rộn ràng.","partOfSpeech":"idiom"},"face the music":{"definition":"Dám làm dám chịu, đối mặt với hậu quả.","example":"After avoiding his responsibilities for months, John finally had to face the music and confess his mistakes.","exampleTranslation":"Sau nhiều tháng trốn tránh trách nhiệm, cuối cùng John phải đối mặt với hậu quả và thú nhận những sai lầm của mình.","partOfSpeech":"idiom"},"fair and square":{"definition":"Công bằng, đường đường chính chính.","example":"He won the competition fair and square.","exampleTranslation":"Anh ấy đã thắng cuộc thi một cách công bằng, đàng hoàng.","partOfSpeech":"idiom"},"fair to middling":{"definition":"Thường thường bậc trung, tàm tạm.","example":"My health is fair to middling at the moment.","exampleTranslation":"Sức khỏe của tôi hiện giờ chỉ ở mức trung bình.","partOfSpeech":"idiom"},"fair-weather friend":{"definition":"Bạn bè khi vui thì vỗ tay vào (lúc hoạn nạn thì bỏ đi), bạn đểu.","example":"I realized he was just a fair-weather friend when he wasn't there for me during hard times.","exampleTranslation":"Tôi nhận ra anh ta chỉ là người bạn chỉ có mặt lúc thuận lợi khi anh ta không ở bên tôi trong lúc khó khăn.","partOfSpeech":"idiom"},"fall by the wayside":{"definition":"Bỏ cuộc giữa chừng, thất bại, rơi rụng dần.","example":"Many good ideas fall by the wayside due to lack of funding.","exampleTranslation":"Nhiều ý tưởng hay bị bỏ lại bên lề vì thiếu kinh phí.","partOfSpeech":"idiom"},"fall into place":{"definition":"Vào guồng, đâu vào đấy một cách trôi chảy và thuận lợi.","example":"Once we secured the project funding, all other details fell into place.","exampleTranslation":"Một khi chúng tôi đảm bảo được kinh phí cho dự án, mọi chi tiết khác đều vào đúng chỗ.","partOfSpeech":"idiom"},"fall off the wagon":{"definition":"Ngựa quen đường cũ, tái nghiện (đặc biệt là rượu).","example":"John was doing well with his diet, but he fell off the wagon and started eating junk food again.","exampleTranslation":"John đang ăn kiêng rất tốt, nhưng anh ấy đã thất bại và lại bắt đầu ăn đồ ăn vặt.","partOfSpeech":"idiom"},"fall on deaf ears":{"definition":"Bỏ ngoài tai, đàn gảy tai trâu.","example":"The warning fell on deaf ears, and no one took action.","exampleTranslation":"Lời cảnh báo bị làm ngơ, và không ai hành động.","partOfSpeech":"idiom"},"familiarity breeds contempt":{"definition":"Quá gần gũi đâm ra khinh nhờn, thân quá hóa nhờn.","example":"After working with him for years, she realized that familiarity breeds contempt and they no longer got along.","exampleTranslation":"Sau nhiều năm làm việc cùng anh ta, cô nhận ra quen thân sinh khinh nhờn và họ không còn hòa hợp nữa.","partOfSpeech":"idiom"},"fancy pants":{"definition":"Kẻ chải chuốt, người thích ăn diện lòe loẹt.","example":"Look at Mr. Fancy Pants over there with his shiny new car.","exampleTranslation":"Nhìn gã ra vẻ sang chảnh đằng kia với chiếc xe mới bóng loáng của hắn kìa.","partOfSpeech":"idiom"},"far and wide":{"definition":"Khắp nơi, rộng khắp, xa gần.","example":"People came from far and wide to attend the annual cultural festival.","exampleTranslation":"Mọi người từ khắp nơi đã đến tham dự lễ hội văn hóa thường niên.","partOfSpeech":"idiom"},"fashion victim":{"definition":"Nạn nhân của thời trang (chạy theo mốt một cách mù quáng).","example":"She buys every new design but ends up looking like a fashion victim.","exampleTranslation":"Cô ấy mua mọi mẫu thiết kế mới nhưng cuối cùng lại trông như nạn nhân của thời trang.","partOfSpeech":"idiom"},"fat cat":{"definition":"Kẻ trọc phú, tư bản gộc (quyền thế và giàu có).","example":"Many people believe that the fat cats on Wall Street have too much influence over the government.","exampleTranslation":"Nhiều người tin rằng những ông trùm giàu có ở Phố Wall có quá nhiều ảnh hưởng lên chính phủ.","partOfSpeech":"idiom"},"feather one's nest":{"definition":"Thu vén cá nhân, vơ vét của công làm của riêng.","example":"The corrupt official used the charity funds to feather his own nest.","exampleTranslation":"Viên chức tham nhũng đã dùng quỹ từ thiện để làm giàu cho bản thân.","partOfSpeech":"idiom"},"feeding frenzy":{"definition":"Sự tranh giành điên cuồng, cơn sốt xâu xé.","example":"Investors went into a feeding frenzy when the company's stock price started rising rapidly.","exampleTranslation":"Các nhà đầu tư lao vào mua ào ạt khi giá cổ phiếu của công ty bắt đầu tăng nhanh.","partOfSpeech":"idiom"},"feel blue":{"definition":"Cảm thấy buồn bã, ủ rũ.","example":"Whenever I feel blue, going for a brisk walk outdoors helps lift my spirits.","exampleTranslation":"Mỗi khi cảm thấy buồn, đi bộ nhanh ngoài trời giúp tôi vui lên.","partOfSpeech":"idiom"},"feel like a million dollars":{"definition":"Cảm thấy khỏe khoắn tuyệt vời, sung sức ngập tràn.","example":"After a good night's sleep, you'll feel like a million dollars.","exampleTranslation":"Sau một đêm ngủ ngon, bạn sẽ cảm thấy tuyệt vời.","partOfSpeech":"idiom"},"feel the pinch":{"definition":"Bắt đầu thiếu hụt tiền bạc, cảm thấy gánh nặng tài chính.","example":"With the rising cost of living, many families are beginning to feel the pinch.","exampleTranslation":"Với chi phí sinh hoạt ngày càng tăng, nhiều gia đình đang bắt đầu cảm thấy eo hẹp.","partOfSpeech":"idiom"},"Feeling blue":{"definition":"Cảm thấy buồn bã, chán nản.","example":"She's been feeling blue ever since her pet dog passed away.","exampleTranslation":"Cô ấy buồn bã kể từ khi chú chó cưng qua đời.","partOfSpeech":"idiom"},"feeling under the weather":{"definition":"Cảm thấy hơi mệt, khó ở trong người.","example":"She left the office early because she was feeling under the weather.","exampleTranslation":"Cô ấy rời văn phòng sớm vì cảm thấy không khỏe.","partOfSpeech":"idiom"},"Fender bender":{"definition":"Vụ va chạm xe nhẹ, không nghiêm trọng.","example":"I got into a fender bender on my way to work.","exampleTranslation":"Trên đường đi làm, tôi bị va chạm nhẹ với xe khác.","partOfSpeech":"idiom"},"Field day":{"definition":"Dịp vui vẻ, ngày hội (hoặc cơ hội lợi dụng tình hình để làm điều mình thích).","example":"The media had a field day with the politician's scandal.","exampleTranslation":"Giới truyền thông đã được dịp khai thác triệt để vụ bê bối của chính trị gia đó.","partOfSpeech":"idiom"},"Fifteen minutes of fame":{"definition":"Sự nổi tiếng ngắn ngủi, chớp nhoáng.","example":"His viral video brought him fifteen minutes of fame, but now he's back to his normal life.","exampleTranslation":"Đoạn video lan truyền khiến anh ấy nổi tiếng chốc lát, nhưng giờ anh ấy lại trở về cuộc sống bình thường.","partOfSpeech":"idiom"},"Fight an uphill battle":{"definition":"Đấu tranh trong hoàn cảnh khó khăn, gian nan.","example":"Starting a new business in this economy feels like fighting an uphill battle.","exampleTranslation":"Khởi nghiệp trong nền kinh tế này giống như một cuộc chiến gian nan.","partOfSpeech":"idiom"},"Fight tooth and nail":{"definition":"Đấu tranh quyết liệt, chiến đấu đến cùng.","example":"She fought tooth and nail to get the promotion.","exampleTranslation":"Cô ấy đã nỗ lực hết sức để được thăng chức.","partOfSpeech":"idiom"},"Fill in the blanks":{"definition":"Điền vào chỗ trống, bổ sung thông tin còn thiếu.","example":"I didn't understand the whole plan, but my manager will fill in the blanks for me.","exampleTranslation":"Tôi không hiểu toàn bộ kế hoạch, nhưng quản lý của tôi sẽ giải thích những phần còn thiếu cho tôi.","partOfSpeech":"idiom"},"Filthy rich":{"definition":"Vô cùng giàu có, giàu nứt đố đổ vách.","example":"Despite his humble beginnings, he became filthy rich through hard work and innovation.","exampleTranslation":"Dù xuất thân khiêm tốn, anh ấy đã trở nên giàu sụ nhờ làm việc chăm chỉ và đổi mới.","partOfSpeech":"idiom"},"Find fault with":{"definition":"Bắt bẻ, bới lông tìm vết, chê bai.","example":"Instead of being helpful, she just likes to find fault with others.","exampleTranslation":"Thay vì giúp đỡ, cô ấy chỉ thích bới lông tìm vết người khác.","partOfSpeech":"idiom"},"Find your feet":{"definition":"Trở nên tự tin, quen thuộc với môi trường mới.","example":"It took her a few months to find her feet in the new company.","exampleTranslation":"Cô ấy mất vài tháng mới quen được công việc ở công ty mới.","partOfSpeech":"idiom"},"Finger-lickin' good":{"definition":"Ngon tuyệt cú mèo, ngon khó cưỡng.","example":"The barbecue at that new place is finger-lickin' good! It's worth every penny.","exampleTranslation":"Món thịt nướng ở quán mới đó ngon đến mức muốn liếm cả ngón tay! Rất đáng đồng tiền.","partOfSpeech":"idiom"},"Fish out of water":{"definition":"Người lạc lõng, cảm thấy không thoải mái trong môi trường lạ.","example":"At her new job, she felt like a fish out of water, not knowing anyone or how things worked.","exampleTranslation":"Ở công việc mới, cô cảm thấy lạc lõng như cá mắc cạn, không quen ai và không biết mọi thứ vận hành ra sao.","partOfSpeech":"idiom"},"Fishy":{"definition":"Đáng ngờ, ám muội.","example":"The deal sounds fishy to me; I think we should investigate further.","exampleTranslation":"Thương vụ này nghe có vẻ đáng ngờ với tôi; tôi nghĩ chúng ta nên điều tra thêm.","partOfSpeech":"idiom"},"Fit as a fiddle":{"definition":"Cực kỳ khỏe mạnh, sung sức.","example":"After his recovery from the flu, he is now fit as a fiddle.","exampleTranslation":"Sau khi khỏi cúm, anh ấy giờ khỏe như vâm.","partOfSpeech":"idiom"},"Fit to be tied":{"definition":"Cực kỳ tức giận, nổi trận lôi đình.","example":"When she found out her flight was canceled, she was fit to be tied.","exampleTranslation":"Khi biết chuyến bay bị hủy, cô ấy tức đến phát điên.","partOfSpeech":"idiom"},"Fits and starts":{"definition":"Thất thường, không đều đặn (làm việc chập chờn).","example":"Their progress on the project was made in fits and starts.","exampleTranslation":"Tiến độ của họ trong dự án diễn ra thất thường, lúc nhanh lúc chậm.","partOfSpeech":"idiom"},"Five o'clock shadow":{"definition":"Râu mọc lún phún (sau một ngày dài không cạo râu).","example":"He had a five o'clock shadow by the time the meeting ended.","exampleTranslation":"Đến khi cuộc họp kết thúc, râu anh ấy đã mọc lởm chởm.","partOfSpeech":"idiom"},"Fix someone's wagon":{"definition":"Dạy cho ai đó một bài học, phá đám ai đó.","example":"Don't worry, we'll fix their wagon for trying to cheat us.","exampleTranslation":"Đừng lo, chúng ta sẽ cho họ biết tay vì dám lừa chúng ta.","partOfSpeech":"idiom"},"Fixed in one's ways":{"definition":"Bảo thủ, không chịu thay đổi thói quen.","example":"My grandfather is quite fixed in his ways and refuses to use a smartphone.","exampleTranslation":"Ông tôi khá cố chấp và từ chối dùng điện thoại thông minh.","partOfSpeech":"idiom"},"Flavor of the month":{"definition":"Trào lưu nhất thời, người/vật nổi lên chốc lát.","example":"That singer might be the flavor of the month, but will people remember his songs next year?","exampleTranslation":"Ca sĩ đó có thể đang là hiện tượng nhất thời, nhưng liệu năm sau mọi người có còn nhớ các bài hát của anh ấy không?","partOfSpeech":"idiom"},"Flea market":{"definition":"Chợ đồ cũ, chợ trời.","example":"We found some amazing vintage items at the flea market last weekend.","exampleTranslation":"Cuối tuần trước, chúng tôi tìm thấy vài món đồ cổ tuyệt vời ở chợ đồ cũ.","partOfSpeech":"idiom"},"Flesh and blood":{"definition":"Máu mủ ruột thịt, người nhà.","example":"He is my flesh and blood; I will always support him.","exampleTranslation":"Anh ấy là máu mủ của tôi; tôi sẽ luôn ủng hộ anh ấy.","partOfSpeech":"idiom"},"Fly in the face of something":{"definition":"Đi ngược lại, chống đối hoàn toàn (quan điểm, quy tắc).","example":"To deny climate change is to fly in the face of overwhelming scientific evidence.","exampleTranslation":"Phủ nhận biến đổi khí hậu là đi ngược lại các bằng chứng khoa học áp đảo.","partOfSpeech":"idiom"},"Fly in the ointment":{"definition":"Con sâu làm rầu nồi canh, điều gây mất vui.","example":"Everything was perfect for the trip, but the flight delay was a real fly in the ointment.","exampleTranslation":"Mọi thứ đều hoàn hảo cho chuyến đi, nhưng việc chuyến bay bị hoãn thực sự là điều làm hỏng niềm vui.","partOfSpeech":"idiom"},"Fly off the handle":{"definition":"Đột nhiên nổi cáu, mất bình tĩnh.","example":"When he heard the bad news, he flew off the handle and started shouting.","exampleTranslation":"Khi nghe tin xấu, anh ấy nổi nóng và bắt đầu la hét.","partOfSpeech":"idiom"},"Fly the coop":{"definition":"Tẩu thoát, chuồn êm.","example":"As soon as the boss left, the workers all flew the coop.","exampleTranslation":"Ngay khi sếp rời đi, công nhân đều trốn đi hết.","partOfSpeech":"idiom"},"fly through":{"definition":"Làm/vượt qua cái gì một cách vèo vèo, siêu nhanh và dễ dàng.","example":"Because he prepared so well, he flew through the math exam in just 30 minutes.","exampleTranslation":"Vì chuẩn bị rất kỹ, anh ấy làm xong bài thi toán chỉ trong 30 phút.","partOfSpeech":"idiom"},"Fly-by-night":{"definition":"Làm ăn chớp nhoáng, không đáng tin cậy.","example":"The investment looked promising, but it turned out to be a fly-by-night scam.","exampleTranslation":"Khoản đầu tư có vẻ hứa hẹn, nhưng hóa ra là một vụ lừa đảo chộp giật.","partOfSpeech":"idiom"},"Foam at the mouth":{"definition":"Tức sùi bọt mép, giận điên người.","example":"He started to foam at the mouth when he heard about the unfair decision.","exampleTranslation":"Anh ta bắt đầu sùi bọt mép vì tức giận khi nghe về quyết định bất công đó.","partOfSpeech":"idiom"},"Follow in someone's footsteps":{"definition":"Nối nghiệp, theo bước chân ai đó.","example":"She decided to follow in her mother's footsteps and become a doctor.","exampleTranslation":"Cô ấy quyết định nối nghiệp mẹ và trở thành bác sĩ.","partOfSpeech":"idiom"},"Follow the money":{"definition":"Lần theo dấu vết tiền bạc (để tìm ra sự thật).","example":"In many corruption cases, investigators usually follow the money to find evidence.","exampleTranslation":"Trong nhiều vụ tham nhũng, các điều tra viên thường lần theo dòng tiền để tìm bằng chứng.","partOfSpeech":"idiom"},"Follow up on something":{"definition":"Theo dõi, tiếp tục xử lý, bám sát (một vấn đề/công việc).","example":"Can you follow up on the project status with the team?","exampleTranslation":"Bạn có thể theo dõi tình trạng dự án với cả nhóm không?","partOfSpeech":"idiom"},"Food for thought":{"definition":"Điều đáng suy ngẫm, gợi suy nghĩ.","example":"Her lecture provided a lot of food for thought about the future of technology.","exampleTranslation":"Bài giảng của cô ấy cung cấp nhiều suy ngẫm về tương lai của công nghệ.","partOfSpeech":"idiom"},"Fool around":{"definition":"Chơi đùa nhảm nhí, làm chuyện vớ vẩn.","example":"Stop fooling around and focus on your homework.","exampleTranslation":"Đừng đùa giỡn nữa và hãy tập trung vào bài tập về nhà của bạn.","partOfSpeech":"idiom"},"Fool's gold":{"definition":"Vàng thau lẫn lộn, vật lấp lánh nhưng vô giá trị.","example":"The investment seemed promising, but it turned out to be fool's gold.","exampleTranslation":"Khoản đầu tư có vẻ hứa hẹn, nhưng hóa ra chỉ là thứ hào nhoáng bên ngoài.","partOfSpeech":"idiom"},"Foot in the door":{"definition":"Bước chân vào nghề, cơ hội ban đầu.","example":"Getting an internship is a good way to get your foot in the door of the industry.","exampleTranslation":"Xin thực tập là cách tốt để tạo cơ hội bước chân vào ngành.","partOfSpeech":"idiom"},"foot the bill":{"definition":"Đứng ra thanh toán toàn bộ chi phí/hóa đơn.","example":"The company agreed to foot the bill for all our travel and hotel expenses.","exampleTranslation":"Công ty đồng ý chi trả toàn bộ chi phí đi lại và khách sạn cho chúng tôi.","partOfSpeech":"idiom"},"Footloose and fancy-free":{"definition":"Tự do tự tại, không bị ràng buộc.","example":"She's been traveling the world, footloose and fancy-free, ever since she quit her job.","exampleTranslation":"Cô ấy đã đi khắp thế giới, tự do tự tại, kể từ khi nghỉ việc.","partOfSpeech":"idiom"},"For crying out loud":{"definition":"Bực mình quá đi mất, thật là bực bội!","example":"For crying out loud, can you please turn down the music?","exampleTranslation":"Trời ơi, bạn có thể vặn nhỏ nhạc xuống được không?","partOfSpeech":"idiom"},"For goodness' sake":{"definition":"Trời đất ơi, lạy Chúa tôi (thể hiện sự mất kiên nhẫn).","example":"For goodness' sake, turn the music down!","exampleTranslation":"Làm ơn, vặn nhỏ nhạc xuống đi!","partOfSpeech":"idiom"},"For heaven's sake":{"definition":"Vì Chúa, ơn trời (biểu lộ sự kinh ngạc hoặc bực dọc).","example":"For heaven's sake, clean up your room!","exampleTranslation":"Trời ơi, dọn phòng của con đi!","partOfSpeech":"idiom"},"For the birds":{"definition":"Vô nghĩa, vớ vẩn, nhảm nhí.","example":"All this paperwork is for the birds. I prefer real, hands-on work.","exampleTranslation":"Tất cả đống giấy tờ này thật vô bổ. Tôi thích công việc thực tế, làm bằng tay hơn.","partOfSpeech":"idiom"},"Fork over / Shell out money":{"definition":"Bấm bụng chi tiền, nôn tiền ra.","example":"You'll need to shell out some cash for this top-of-the-line laptop.","exampleTranslation":"Bạn sẽ phải bỏ ra một khoản tiền cho chiếc laptop cao cấp này.","partOfSpeech":"idiom"},"Fortune favors the bold":{"definition":"Liều ăn nhiều, dũng cảm sẽ gặp may mắn.","example":"He took a risk by starting his own business, but fortune favors the bold.","exampleTranslation":"Anh ấy đã mạo hiểm khi tự khởi nghiệp, nhưng may mắn luôn mỉm cười với người dám nghĩ dám làm.","partOfSpeech":"idiom"},"Forty winks":{"definition":"Giấc ngủ ngắn, chợp mắt.","example":"After a busy morning, I need forty winks to recharge.","exampleTranslation":"Sau một buổi sáng bận rộn, tôi cần chợp mắt một lát để lấy lại sức.","partOfSpeech":"idiom"},"Freak out":{"definition":"Hoảng sợ tột độ, mất bình tĩnh.","example":"She started to freak out when she realized she had lost her wallet.","exampleTranslation":"Cô ấy bắt đầu hoảng loạn khi nhận ra mình đã làm mất ví.","partOfSpeech":"idiom"},"fresh as a daisy":{"definition":"Tươi như hoa, tràn đầy năng lượng sau giấc ngủ ngon.","example":"After a good eight hours of sound sleep, she woke up fresh as a daisy.","exampleTranslation":"Sau một giấc ngủ ngon tám tiếng, cô ấy thức dậy tươi tắn.","partOfSpeech":"idiom"},"From day one":{"definition":"Ngay từ ngày đầu tiên, từ thuở ban đầu.","example":"He has been dedicated to the project from day one.","exampleTranslation":"Anh ấy đã tận tâm với dự án từ ngày đầu tiên.","partOfSpeech":"idiom"},"From rags to riches":{"definition":"Từ tay trắng làm nên sự nghiệp, từ nghèo khó trở nên giàu sang.","example":"He went from rags to riches in just a few years thanks to his brilliant startup.","exampleTranslation":"Anh ấy từ tay trắng trở nên giàu có chỉ trong vài năm nhờ công ty khởi nghiệp xuất sắc của mình.","partOfSpeech":"idiom"},"From the get-go":{"definition":"Ngay từ đầu.","example":"I've known she was the right person for the job from the get-go.","exampleTranslation":"Tôi biết cô ấy là người phù hợp với công việc ngay từ đầu.","partOfSpeech":"idiom"},"From the word go":{"definition":"Ngay từ lúc bắt đầu.","example":"From the word go, he was determined to win.","exampleTranslation":"Ngay từ đầu, anh ấy đã quyết tâm giành chiến thắng.","partOfSpeech":"idiom"},"From time to time":{"definition":"Thỉnh thoảng, đôi khi.","example":"We like to go hiking from time to time.","exampleTranslation":"Chúng tôi thích đi bộ đường dài thỉnh thoảng.","partOfSpeech":"idiom"},"Fuddy-duddy":{"definition":"Người cổ hủ, lạc hậu.","example":"Stop being such a fuddy-duddy. Try something new for once!","exampleTranslation":"Đừng cổ hủ như vậy nữa. Thử điều gì đó mới một lần xem!","partOfSpeech":"idiom"},"full of beans":{"definition":"Tràn đầy năng lượng, dồi dào sức sống và hăng hái.","example":"The kids were full of beans this morning and played outdoors for hours.","exampleTranslation":"Sáng nay bọn trẻ tràn đầy năng lượng và chơi ngoài trời hàng giờ.","partOfSpeech":"idiom"},"Full of crap":{"definition":"Nói xạo, bốc phét, nói nhảm.","example":"I can't believe anything she says; she's always full of crap.","exampleTranslation":"Tôi không thể tin bất cứ điều gì cô ấy nói; cô ấy lúc nào cũng nói nhảm.","partOfSpeech":"idiom"},"Full of hot air":{"definition":"Nói khoác, thùng rỗng kêu to.","example":"He said he could solve all our problems, but I think he's just full of hot air.","exampleTranslation":"Anh ta nói có thể giải quyết mọi vấn đề của chúng tôi, nhưng tôi nghĩ anh ta chỉ nói suông.","partOfSpeech":"idiom"},"Full steam ahead":{"definition":"Tiến lên hết tốc lực; dốc toàn lực","example":"After the funding came through, they went full steam ahead with their plans.","exampleTranslation":"Sau khi có vốn, họ tiến hành kế hoạch hết tốc lực.","partOfSpeech":"idiom"},"Gain ground":{"definition":"Đạt được tiến bộ; giành được lợi thế; trở nên phổ biến","example":"The company’s new product is starting to gain ground in the market.","exampleTranslation":"Sản phẩm mới của công ty đang bắt đầu chiếm lĩnh thị trường.","partOfSpeech":"idiom"},"get a grip":{"definition":"Bình tĩnh lại, kiểm soát lại cảm xúc của bản thân.","example":"Take a deep breath and get a grip on yourself before making an emotional decision.","exampleTranslation":"Hãy hít một hơi thật sâu và kiểm soát bản thân trước khi đưa ra quyết định cảm tính.","partOfSpeech":"idiom"},"Get a handle on something":{"definition":"Nắm bắt được; kiểm soát được tình hình","example":"I’m finally starting to get a handle on my new job responsibilities.","exampleTranslation":"Cuối cùng tôi cũng bắt đầu nắm bắt được trách nhiệm trong công việc mới.","partOfSpeech":"idiom"},"Get a move on":{"definition":"Nhanh lên; khẩn trương lên","example":"If we want to catch the train, we need to get a move on.","exampleTranslation":"Nếu muốn kịp chuyến tàu, chúng ta cần nhanh chân lên.","partOfSpeech":"idiom"},"Get a second wind":{"definition":"Lấy lại sức lực; phục hồi phong độ","example":"After the first mile, I was exhausted, but then I got a second wind and finished the race strong.","exampleTranslation":"Sau dặm đầu tiên, tôi đã kiệt sức, nhưng rồi tôi lấy lại sức và hoàn thành cuộc đua thật tốt.","partOfSpeech":"idiom"},"Get a taste of one's own medicine":{"definition":"Gậy ông đập lưng ông; nếm mùi đau khổ do chính mình gây ra","example":"After bullying others for years, he finally got a taste of his own medicine.","exampleTranslation":"Sau nhiều năm bắt nạt người khác, cuối cùng anh ta cũng nếm trải điều đó trên chính mình.","partOfSpeech":"idiom"},"Get a word in edgewise":{"definition":"Chen ngang vào câu chuyện; có cơ hội lên tiếng","example":"He talks so much that it’s hard to get a word in edgewise.","exampleTranslation":"Anh ta nói nhiều đến mức khó mà chen vào được lời nào.","partOfSpeech":"idiom"},"Get ahold of yourself":{"definition":"Bình tĩnh lại; kiềm chế cảm xúc","example":"You need to get a hold of yourself and think clearly.","exampleTranslation":"Bạn cần kiểm soát bản thân và suy nghĩ cho thấu đáo.","partOfSpeech":"idiom"},"Get along with someone":{"definition":"Hòa thuận; ăn ý với ai đó","example":"My siblings and I get along with each other really well.","exampleTranslation":"Tôi và các anh chị em rất hòa thuận với nhau.","partOfSpeech":"idiom"},"Get back to someone":{"definition":"Phản hồi lại; liên lạc lại sau","example":"I’ll check the details and get back to you tomorrow.","exampleTranslation":"Tôi sẽ kiểm tra chi tiết và liên hệ lại với bạn vào ngày mai.","partOfSpeech":"idiom"},"Get bent out of shape":{"definition":"Nổi giận đùng đùng, bực tức (thường vì chuyện nhỏ).","example":"Don't get bent out of shape over a little misunderstanding; let's talk it through.","exampleTranslation":"Đừng nổi nóng vì một hiểu lầm nhỏ; hãy cùng nói chuyện cho rõ ràng.","partOfSpeech":"idiom"},"Get by":{"definition":"Xoay xở đủ sống; sống qua ngày","example":"Even with two jobs, she’s just getting by.","exampleTranslation":"Dù làm hai công việc, cô ấy cũng chỉ vừa đủ sống.","partOfSpeech":"idiom"},"get cold feet":{"definition":"Chùn bước, mất hết can đảm vào phút chót.","example":"He got cold feet just before stepping on stage to deliver his keynote speech.","exampleTranslation":"Anh ấy chùn bước ngay trước khi bước lên sân khấu để phát biểu khai mạc.","partOfSpeech":"idiom"},"Get down to brass tacks":{"definition":"Đi vào vấn đề chính; bàn vào những chi tiết thực tế","example":"We don’t have much time, so let’s get down to brass tacks immediately.","exampleTranslation":"Chúng ta không có nhiều thời gian, nên hãy đi thẳng vào vấn đề chính ngay.","partOfSpeech":"idiom"},"Get down to business":{"definition":"Bắt tay vào việc; nghiêm túc làm việc","example":"After a quick introduction, the team decided to get down to business and discuss the project details.","exampleTranslation":"Sau phần giới thiệu ngắn, cả nhóm quyết định đi vào công việc và thảo luận chi tiết dự án.","partOfSpeech":"idiom"},"Get down to the nuts and bolts":{"definition":"Đi vào chi tiết cốt lõi; tìm hiểu ngọn ngành","example":"We need to get down to the nuts and bolts of the project before we can proceed.","exampleTranslation":"Chúng ta cần tìm hiểu những chi tiết cốt lõi của dự án trước khi có thể tiếp tục.","partOfSpeech":"idiom"},"Get from A to B":{"definition":"Đi từ nơi này đến nơi khác","example":"All I need is a car that can reliably get me from A to B.","exampleTranslation":"Tất cả những gì tôi cần là một chiếc xe có thể đưa tôi từ nơi này đến nơi khác một cách đáng tin cậy.","partOfSpeech":"idiom"},"Get hold of someone":{"definition":"Liên lạc được với ai đó","example":"I’ve been trying to get hold of my doctor all day.","exampleTranslation":"Tôi đã cố liên lạc với bác sĩ của mình cả ngày.","partOfSpeech":"idiom"},"Get hold of something":{"definition":"Nắm giữ; đoạt được; hiểu được","example":"It took me a while to get a hold of the new software.","exampleTranslation":"Tôi mất một thời gian mới làm quen được phần mềm mới.","partOfSpeech":"idiom"},"Get in someone’s hair":{"definition":"Quấy rầy; làm phiền ai đó","example":"The kids were running around and really got in her hair.","exampleTranslation":"Bọn trẻ chạy nhảy xung quanh và thực sự làm phiền cô ấy.","partOfSpeech":"idiom"},"Get in touch with":{"definition":"Liên lạc với, bắt liên lạc.","example":"If you have any questions, please get in touch with our support team.","exampleTranslation":"Nếu bạn có bất kỳ câu hỏi nào, vui lòng liên hệ với nhóm hỗ trợ của chúng tôi.","partOfSpeech":"idiom"},"Get into deep water":{"definition":"Rơi vào tình thế khó khăn; rước họa vào thân","example":"He got into deep water when he couldn’t pay back his debts on time.","exampleTranslation":"Anh ta rơi vào tình thế rắc rối khi không thể trả nợ đúng hạn.","partOfSpeech":"idiom"},"Get off on the wrong foot":{"definition":"Khởi đầu không suôn sẻ; mất lòng từ đầu","example":"We got off on the wrong foot during our first meeting.","exampleTranslation":"Chúng tôi đã có khởi đầu không suôn sẻ trong cuộc họp đầu tiên.","partOfSpeech":"idiom"},"Get off one's high horse":{"definition":"Bớt kiêu ngạo lại; khiêm tốn chút đi","example":"You need to get off your high horse and realize not everyone has the same opportunities as you.","exampleTranslation":"Bạn cần bớt kiêu ngạo và nhận ra không phải ai cũng có cơ hội như bạn.","partOfSpeech":"idiom"},"Get off scot-free":{"definition":"Bình yên vô sự, thoát tội mà không bị trừng phạt","example":"Despite the evidence, the suspect got off scot-free due to a technicality.","exampleTranslation":"Bất chấp bằng chứng, nghi phạm thoát tội mà không bị trừng phạt vì một lỗi kỹ thuật.","partOfSpeech":"idiom"},"get on like a house on fire":{"definition":"Hợp nhau như cá gặp nước, nhanh chóng trở nên thân thiết.","example":"From the moment they met at the orientation, they got on like a house on fire.","exampleTranslation":"Ngay từ khi gặp nhau ở buổi định hướng, họ đã rất hợp nhau.","partOfSpeech":"idiom"},"Get on one's last nerve":{"definition":"Làm ai đó hết sức chịu đựng; chọc tức tận cùng","example":"His constant complaining is really getting on my last nerve.","exampleTranslation":"Việc anh ta than phiền liên tục thực sự làm tôi hết kiên nhẫn.","partOfSpeech":"idiom"},"Get on one's nerves":{"definition":"Chọc tức; làm phiền ai đó","example":"The constant noise from the construction site is really getting on my nerves.","exampleTranslation":"Tiếng ồn liên tục từ công trường xây dựng thực sự làm tôi bực mình.","partOfSpeech":"idiom"},"get on someone's nerves":{"definition":"Làm phiền, làm ai bực mình hoặc phát cáu.","example":"That loud tapping noise is really starting to get on my nerves.","exampleTranslation":"Tiếng gõ ồn ào đó thực sự bắt đầu làm tôi khó chịu.","partOfSpeech":"idiom"},"Get one's act together":{"definition":"Chỉnh đốn lại bản thân; xốc lại tinh thần","example":"If you don’t get your act together, you’ll miss the deadline.","exampleTranslation":"Nếu bạn không chấn chỉnh bản thân, bạn sẽ lỡ hạn chót.","partOfSpeech":"idiom"},"Get one's dander up":{"definition":"Nổi cáu; tức giận","example":"His rude comments really got my dander up.","exampleTranslation":"Những lời bình luận thô lỗ của anh ta thực sự làm tôi nổi giận.","partOfSpeech":"idiom"},"Get one's feet wet":{"definition":"Bước đầu làm quen; thử nghiệm","example":"The internship was a good way for her to get her feet wet in the industry.","exampleTranslation":"Kỳ thực tập là cách tốt để cô ấy làm quen với ngành này.","partOfSpeech":"idiom"},"Get one's goat":{"definition":"Làm ai đó phát cáu; chọc tức","example":"It really gets my goat when people cut in line.","exampleTranslation":"Tôi thực sự rất bực khi người ta chen ngang hàng.","partOfSpeech":"idiom"},"Get one's hackles up":{"definition":"Tức điên lên, xù lông nhím (phòng thủ, tức giận)","example":"The comment he made got her hackles up immediately.","exampleTranslation":"Lời nhận xét của anh ta lập tức làm cô ấy nổi giận.","partOfSpeech":"idiom"},"Get one's head around something":{"definition":"Hiểu thấu được; tiếp thu được","example":"It took me a while to get my head around the new software.","exampleTranslation":"Tôi mất một thời gian mới hiểu được phần mềm mới.","partOfSpeech":"idiom"},"Get out of hand":{"definition":"Vượt tầm kiểm soát; mất kiểm soát","example":"The party started to get out of hand when too many people showed up.","exampleTranslation":"Bữa tiệc bắt đầu vượt khỏi tầm kiểm soát khi quá nhiều người đến.","partOfSpeech":"idiom"},"Get over it":{"definition":"Vượt qua; quên đi để bước tiếp","example":"I know you’re upset about the breakup, but you need to get over it.","exampleTranslation":"Tôi biết bạn buồn về chuyện chia tay, nhưng bạn cần phải vượt qua nó.","partOfSpeech":"idiom"},"Get rid of":{"definition":"Loại bỏ, vứt bỏ, tống khứ.","example":"They decided to get rid of the company's outdated policies.","exampleTranslation":"Họ quyết định loại bỏ những chính sách lỗi thời của công ty.","partOfSpeech":"idiom"},"Get something for peanuts":{"definition":"Mua được với giá bèo; mua rẻ như cho","example":"I bought this vintage chair for peanuts at a garage sale.","exampleTranslation":"Tôi mua chiếc ghế cổ này với giá rẻ mạt ở một buổi bán đồ cũ.","partOfSpeech":"idiom"},"Get something off one's chest":{"definition":"Nói ra cho nhẹ lòng; trút bầu tâm sự","example":"I need to get it off my chest and tell you how I really feel.","exampleTranslation":"Tôi cần nói ra điều đang đè nặng trong lòng và cho bạn biết tôi thực sự cảm thấy thế nào.","partOfSpeech":"idiom"},"Get something out of one's system":{"definition":"Thỏa mãn mong muốn; xả hết bực tức/cảm xúc","example":"He decided to take a long vacation to get the stress out of his system.","exampleTranslation":"Anh ấy quyết định đi nghỉ dài ngày để xua tan căng thẳng.","partOfSpeech":"idiom"},"Get something through one's head":{"definition":"Hiểu ra vấn đề; nhét vào đầu","example":"You need to get it through your head that this is not a game!","exampleTranslation":"Bạn cần hiểu rõ rằng đây không phải trò đùa!","partOfSpeech":"idiom"},"get the ball rolling":{"definition":"Bắt đầu hành động, khởi động dự án/tiến trình.","example":"Let us introduce ourselves first to get the ball rolling in this meeting.","exampleTranslation":"Chúng ta hãy giới thiệu bản thân trước để khởi động cuộc họp này.","partOfSpeech":"idiom"},"Get the go-ahead":{"definition":"Được bật đèn xanh; được phép tiến hành","example":"We got the go-ahead to start the new project next week.","exampleTranslation":"Chúng tôi đã được bật đèn xanh để bắt đầu dự án mới vào tuần sau.","partOfSpeech":"idiom"},"Get the green light":{"definition":"Được bật đèn xanh; được phê duyệt","example":"We finally got the green light from the boss to start the project.","exampleTranslation":"Cuối cùng chúng tôi đã nhận được sự đồng ý của sếp để bắt đầu dự án.","partOfSpeech":"idiom"},"get the hang of":{"definition":"Nắm bắt được cách làm, quen tay với việc gì.","example":"Once you get the hang of skiing, it becomes remarkably fun and easy.","exampleTranslation":"Khi bạn đã quen với việc trượt tuyết, nó trở nên cực kỳ thú vị và dễ dàng.","partOfSpeech":"idiom"},"Get the hang of it":{"definition":"Nắm được cách làm; quen tay","example":"It took a few hours, but I finally got the hang of it.","exampleTranslation":"Mất vài giờ, nhưng cuối cùng tôi cũng đã nắm được cách làm.","partOfSpeech":"idiom"},"Get the message":{"definition":"Hiểu ý; nắm bắt được ẩn ý","example":"If he’s not replying to your texts, maybe it’s time to get the message.","exampleTranslation":"Nếu anh ta không trả lời tin nhắn của bạn, có lẽ đã đến lúc hiểu ra vấn đề.","partOfSpeech":"idiom"},"Get the sack":{"definition":"Bị sa thải; bị đuổi việc","example":"He got the sack after missing several important deadlines.","exampleTranslation":"Anh ấy bị sa thải sau khi lỡ nhiều hạn chót quan trọng.","partOfSpeech":"idiom"},"Get the third degree":{"definition":"Bị tra khảo gắt gao, hỏi cung","example":"After the accident, the police gave her the third degree about what happened.","exampleTranslation":"Sau vụ tai nạn, cảnh sát đã tra hỏi cô ấy gắt gao về những gì đã xảy ra.","partOfSpeech":"idiom"},"Get this show on the road":{"definition":"Bắt đầu thôi; tiến hành ngay thôi","example":"We have everything set up; let’s get this show on the road.","exampleTranslation":"Chúng ta đã chuẩn bị xong mọi thứ; hãy bắt đầu thôi.","partOfSpeech":"idiom"},"get to the bottom of":{"definition":"Tìm ra chân tướng, tìm hiểu ngọn ngành gốc rễ sự việc.","example":"The detectives worked tirelessly to get to the bottom of the mystery.","exampleTranslation":"Các thám tử đã làm việc không mệt mỏi để làm rõ nguồn gốc của bí ẩn.","partOfSpeech":"idiom"},"Get to the bottom of something":{"definition":"Tìm ra chân tướng; điều tra ngọn ngành","example":"We need to get to the bottom of why the project failed.","exampleTranslation":"Chúng ta cần tìm ra gốc rễ của việc tại sao dự án thất bại.","partOfSpeech":"idiom"},"Get to the point":{"definition":"Đi thẳng vào vấn đề","example":"Please get to the point; we don’t have much time.","exampleTranslation":"Làm ơn nói thẳng vào vấn đề; chúng ta không có nhiều thời gian.","partOfSpeech":"idiom"},"Get up on the wrong side of the bed":{"definition":"Tỉnh dậy với tâm trạng tồi tệ; cáu kỉnh vô cớ","example":"He must have gotten up on the wrong side of the bed because he’s been grumpy all day.","exampleTranslation":"Chắc hẳn anh ấy đã dậy nhầm phía giường vì anh ấy cáu kỉnh cả ngày.","partOfSpeech":"idiom"},"get wind of":{"definition":"Nghe phong thanh, đánh hơi thấy tin tức bí mật.","example":"The press got wind of the merger before the official announcement was made.","exampleTranslation":"Báo chí đã nghe phong thanh về vụ sáp nhập trước khi có thông báo chính thức.","partOfSpeech":"idiom"},"Get wind of something":{"definition":"Nghe phong phanh; biết được bí mật","example":"If they get wind of our plans, the surprise will be ruined.","exampleTranslation":"Nếu họ nghe phong thanh về kế hoạch của chúng ta, sự bất ngờ sẽ bị phá hỏng.","partOfSpeech":"idiom"},"Get with it":{"definition":"Cập nhật đi; thức thời đi","example":"You need to get with it if you want to succeed in this industry.","exampleTranslation":"Bạn cần bắt kịp thời đại nếu muốn thành công trong ngành này.","partOfSpeech":"idiom"},"Get your walking papers":{"definition":"Bị sa thải, bị đuổi việc.","example":"Tom was late for work too many times and finally got his walking papers.","exampleTranslation":"Tom đi làm muộn quá nhiều lần và cuối cùng bị sa thải.","partOfSpeech":"idiom"},"Get-up-and-go":{"definition":"Sự hăng hái; nghị lực; động lực","example":"Her get-up-and-go makes her a great leader at work.","exampleTranslation":"Tinh thần chủ động của cô ấy khiến cô trở thành một nhà lãnh đạo tuyệt vời ở nơi làm việc.","partOfSpeech":"idiom"},"give a hand":{"definition":"Giúp một tay, hỗ trợ ai làm việc gì.","example":"Can you give me a hand lifting this heavy wooden box?","exampleTranslation":"Bạn có thể giúp tôi một tay nâng chiếc hộp gỗ nặng này không?","partOfSpeech":"idiom"},"Give in":{"definition":"Nhượng bộ, bỏ cuộc, chịu thua.","example":"She didn't want to give in to their demands, but she had no choice.","exampleTranslation":"Cô ấy không muốn nhượng bộ trước những yêu cầu của họ, nhưng cô ấy không còn lựa chọn nào khác.","partOfSpeech":"idiom"},"give it a shot":{"definition":"Thử làm một phen, mạo hiểm thử sức.","example":"Even if coding seems hard at first, you should give it a shot.","exampleTranslation":"Ngay cả khi lập trình ban đầu có vẻ khó, bạn vẫn nên thử một lần.","partOfSpeech":"idiom"},"Give props to":{"definition":"Khen ngợi; công nhận thành quả của ai đó","example":"We should all give props to Jane for her hard work on this project.","exampleTranslation":"Tất cả chúng ta nên ghi nhận công lao của Jane vì sự chăm chỉ của cô ấy trong dự án này.","partOfSpeech":"idiom"},"give someone a hand":{"definition":"Giúp đỡ ai một tay.","example":"Could you give me a hand carrying these heavy grocery bags into the kitchen?","exampleTranslation":"Bạn có thể giúp tôi một tay mang những túi hàng nặng này vào bếp không?","partOfSpeech":"idiom"},"Give someone a hard time":{"definition":"Làm khó dễ; bắt bẻ ai đó","example":"My boss always gives me a hard time for being a few minutes late.","exampleTranslation":"Sếp tôi luôn gây khó dễ cho tôi vì đến muộn vài phút.","partOfSpeech":"idiom"},"Give someone a piece of one's mind":{"definition":"Mắng nhiếc, xỉ vả ai đó; nói thẳng cho ai đó biết sự bất bình của mình","example":"After being late again, his boss gave him a piece of her mind.","exampleTranslation":"Sau khi lại đến muộn, sếp của anh ấy đã nói thẳng ý kiến của mình với anh ấy.","partOfSpeech":"idiom"},"Give someone a run for their money":{"definition":"Kẻ tám lạng người nửa cân; tạo ra sự cạnh tranh khốc liệt","example":"Our team is going to give them a run for their money in the finals.","exampleTranslation":"Đội của chúng ta sẽ khiến họ phải vất vả ở trận chung kết.","partOfSpeech":"idiom"},"Give someone a song and dance":{"definition":"Bịa chuyện, viện cớ vòng vo để thoái thác hoặc lấp liếm","example":"When asked why he was late, he gave them a song and dance about traffic.","exampleTranslation":"Khi được hỏi tại sao đến muộn, anh ta bịa ra một câu chuyện dài dòng về kẹt xe.","partOfSpeech":"idiom"},"Give someone the benefit of the doubt":{"definition":"Tin tưởng ai đó (khi chưa có bằng chứng kết tội); tạm thời tin ai đó","example":"She might be late, but I’ll give her the benefit of the doubt this time.","exampleTranslation":"Cô ấy có thể đến muộn, nhưng lần này tôi sẽ cho cô ấy cơ hội.","partOfSpeech":"idiom"},"give someone the brush-off":{"definition":"ngó lơ, phớt lờ ai đó","example":"She gave him the brush-off when he asked her out.","exampleTranslation":"Cô ấy lạnh nhạt từ chối khi anh ấy mời cô đi chơi.","partOfSpeech":"idiom"},"Give someone the cold shoulder":{"definition":"Tỏ thái độ lạnh nhạt, hờ hững hoặc phớt lờ ai đó","example":"After their argument, she gave him the cold shoulder all week.","exampleTranslation":"Sau cuộc cãi vã, cô ấy lạnh nhạt với anh ấy suốt cả tuần.","partOfSpeech":"idiom"},"Give someone the heads-up":{"definition":"Báo trước, cảnh báo trước.","example":"I just wanted to give you a heads-up that we might need to work late tonight.","exampleTranslation":"Tôi chỉ muốn báo trước với bạn rằng tối nay chúng ta có thể phải làm việc muộn.","partOfSpeech":"idiom"},"Give someone the slip":{"definition":"Trốn thoát, cắt đuôi ai đó đang bám theo mình","example":"The thief gave the police the slip and disappeared into the crowd.","exampleTranslation":"Tên trộm đã trốn thoát khỏi cảnh sát và biến mất trong đám đông.","partOfSpeech":"idiom"},"Give someone the thumbs-up":{"definition":"Bật đèn xanh; tán thành; ủng hộ ai đó","example":"After reviewing the project, they gave it a thumbs-up.","exampleTranslation":"Sau khi xem xét dự án, họ đã chấp thuận.","partOfSpeech":"idiom"},"Give someone/something short shrift":{"definition":"Bỏ qua, phớt lờ, hoặc dành rất ít sự chú ý cho ai/cái gì","example":"Her concerns were given short shrift in the meeting.","exampleTranslation":"Những lo ngại của cô ấy bị xem nhẹ trong cuộc họp.","partOfSpeech":"idiom"},"Go against the grain":{"definition":"Làm trái với lẽ thường, đi ngược lại đám đông","example":"Her decision to travel alone goes against the grain of what her family expects.","exampleTranslation":"Quyết định đi du lịch một mình của cô ấy trái với những gì gia đình mong đợi.","partOfSpeech":"idiom"},"Go around in circles":{"definition":"Luẩn quẩn, không có tiến triển","example":"We’ve been trying to solve this issue for hours, but we’re just going around in circles.","exampleTranslation":"Chúng tôi đã cố giải quyết vấn đề này hàng giờ liền, nhưng chỉ đang loay hoay quanh quẩn.","partOfSpeech":"idiom"},"Go back to the drawing board":{"definition":"Làm lại từ đầu, vạch lại kế hoạch mới vì kế hoạch cũ thất bại","example":"The project didn’t work out as expected, so we have to go back to the drawing board.","exampleTranslation":"Dự án không diễn ra như mong đợi, nên chúng ta phải bắt đầu lại từ đầu.","partOfSpeech":"idiom"},"Go bananas":{"definition":"Phát điên lên (vì tức giận hoặc phấn khích)","example":"The kids went bananas when they heard about the trip to Disneyland.","exampleTranslation":"Bọn trẻ phát cuồng khi nghe về chuyến đi Disneyland.","partOfSpeech":"idiom"},"Go belly up":{"definition":"Phá sản, thất bại hoàn toàn","example":"The company went belly up after years of financial trouble.","exampleTranslation":"Công ty đã phá sản sau nhiều năm gặp khó khăn tài chính.","partOfSpeech":"idiom"},"Go bonkers":{"definition":"Phát rồ, phát cuồng","example":"She went bonkers when she won the lottery.","exampleTranslation":"Cô ấy phát điên lên khi trúng số.","partOfSpeech":"idiom"},"Go cold turkey":{"definition":"Từ bỏ một thói quen (hoặc cơn nghiện) một cách đột ngột và hoàn toàn","example":"He decided to go cold turkey on smoking after 20 years.","exampleTranslation":"Anh ấy quyết định bỏ hẳn thuốc lá đột ngột sau 20 năm.","partOfSpeech":"idiom"},"Go down in flames":{"definition":"Thất bại thảm hại, tiêu tùng","example":"The project went down in flames due to poor planning and execution.","exampleTranslation":"Dự án đã thất bại thảm hại do lập kế hoạch và thực hiện kém.","partOfSpeech":"idiom"},"Go down like a lead balloon":{"definition":"Thất bại thảm hại, không được ai hưởng ứng.","example":"His joke about the boss went down like a lead balloon during the meeting.","exampleTranslation":"Câu đùa của anh ta về sếp đã thất bại hoàn toàn trong cuộc họp.","partOfSpeech":"idiom"},"Go Dutch":{"definition":"Tiền ai nấy trả, cưa đôi hóa đơn (khi đi ăn).","example":"Let's go Dutch on dinner tonight.","exampleTranslation":"Tối nay chúng ta hãy chia đôi tiền bữa tối nhé.","partOfSpeech":"idiom"},"Go fly a kite":{"definition":"Biến đi, tránh ra chỗ khác chơi","example":"When he wouldn’t stop arguing, I told him to go fly a kite.","exampleTranslation":"Khi anh ta không ngừng tranh cãi, tôi bảo anh ta đi chỗ khác chơi.","partOfSpeech":"idiom"},"Go fry an egg":{"definition":"Biến đi, đừng chõ mũi vào chuyện người khác","example":"He kept asking me questions, so finally, I told him to go fry an egg.","exampleTranslation":"Anh ta cứ hỏi tôi mãi, nên cuối cùng tôi bảo anh ta đi chỗ khác.","partOfSpeech":"idiom"},"Go haywire":{"definition":"Hỏng hóc, mất kiểm soát, rối tung lên","example":"Everything went haywire when the system crashed.","exampleTranslation":"Mọi thứ trở nên hỗn loạn khi hệ thống bị sập.","partOfSpeech":"idiom"},"Go it alone":{"definition":"Tự lực cánh sinh, làm việc đơn độc không cần ai giúp","example":"He decided to go it alone and start his own business.","exampleTranslation":"Anh ấy quyết định tự mình làm một mình và khởi nghiệp.","partOfSpeech":"idiom"},"Go off half-cocked":{"definition":"Hành động vội vàng, thiếu suy nghĩ hoặc chưa chuẩn bị kỹ","example":"Don’t go off half-cocked; make sure you have all the information first.","exampleTranslation":"Đừng hành động hấp tấp; hãy chắc chắn rằng bạn có đầy đủ thông tin trước.","partOfSpeech":"idiom"},"Go off the deep end":{"definition":"Mất kiểm soát cảm xúc, nổi trận lôi đình; hành động thiếu suy nghĩ","example":"She went off the deep end when she found out her project had been canceled.","exampleTranslation":"Cô ấy mất bình tĩnh hoàn toàn khi biết dự án của mình bị hủy.","partOfSpeech":"idiom"},"Go on a wild goose chase":{"definition":"Cất công tìm kiếm một thứ không có thật hoặc không thể tìm thấy (tốn công vô ích)","example":"We went on a wild goose chase trying to find that old book.","exampleTranslation":"Chúng tôi đã mất công vô ích khi cố tìm cuốn sách cũ đó.","partOfSpeech":"idiom"},"Go out of one's way":{"definition":"Cất công, chịu khó làm việc gì (thường là để giúp đỡ người khác)","example":"She really went out of her way to make sure everyone felt comfortable at the party.","exampleTranslation":"Cô ấy thực sự đã cố gắng hết sức để đảm bảo mọi người đều cảm thấy thoải mái ở bữa tiệc.","partOfSpeech":"idiom"},"Go out on a limb":{"definition":"Liều lĩnh nói hoặc làm điều gì đó (không được nhiều người ủng hộ); mạo hiểm","example":"She went out on a limb to defend her friend in the meeting.","exampleTranslation":"Cô ấy đã mạo hiểm để bảo vệ bạn mình trong cuộc họp.","partOfSpeech":"idiom"},"Go overboard":{"definition":"Làm quá trớn, quá mức cần thiết","example":"Don’t go overboard with the decorations; we want a simple look.","exampleTranslation":"Đừng làm quá lên với đồ trang trí; chúng ta muốn vẻ đơn giản.","partOfSpeech":"idiom"},"Go postal":{"definition":"Nổi điên, phát rồ lên (thường mang tính bạo lực)","example":"The boss will go postal if the report isn’t finished by tomorrow.","exampleTranslation":"Sếp sẽ nổi điên nếu báo cáo không hoàn thành vào ngày mai.","partOfSpeech":"idiom"},"Go south":{"definition":"Trở nên tồi tệ, xuống dốc, thất bại","example":"After the new policy was implemented, sales started to go south.","exampleTranslation":"Sau khi chính sách mới được áp dụng, doanh số bắt đầu đi xuống.","partOfSpeech":"idiom"},"Go the extra mile":{"definition":"Nỗ lực hết mình, làm nhiều hơn mức được yêu cầu","example":"The customer service team went the extra mile to resolve my issue quickly.","exampleTranslation":"Đội chăm sóc khách hàng đã nỗ lực hết mình để giải quyết vấn đề của tôi nhanh chóng.","partOfSpeech":"idiom"},"Go the whole hog":{"definition":"Làm việc gì đó một cách triệt để, tới bến, không do dự","example":"If we’re going to renovate the kitchen, let’s go the whole hog and do it properly.","exampleTranslation":"Nếu chúng ta định sửa nhà bếp, hãy làm đến nơi đến chốn và làm cho đúng cách.","partOfSpeech":"idiom"},"Go through something with a fine-tooth comb":{"definition":"Kiểm tra kỹ lưỡng, săm soi từng ly từng tí","example":"The auditor will go through the records with a fine-tooth comb to ensure there are no discrepancies.","exampleTranslation":"Kiểm toán viên sẽ rà soát hồ sơ thật kỹ lưỡng để đảm bảo không có sai lệch.","partOfSpeech":"idiom"},"Go to hell in a handbasket":{"definition":"Tụt dốc không phanh, rơi vào thảm họa","example":"With the economy collapsing, the whole country’s going to hell in a handbasket.","exampleTranslation":"Với nền kinh tế đang sụp đổ, cả đất nước đang đi vào chỗ suy tàn.","partOfSpeech":"idiom"},"Go to pieces":{"definition":"Suy sụp tinh thần, sụp đổ hoàn toàn","example":"After hearing the tragic news, she completely went to pieces.","exampleTranslation":"Sau khi nghe tin bi thảm, cô ấy hoàn toàn suy sụp.","partOfSpeech":"idiom"},"Go to the dogs":{"definition":"Xuống cấp trầm trọng, đổ đốn","example":"After the new management took over, the company went to the dogs.","exampleTranslation":"Sau khi ban quản lý mới tiếp quản, công ty đã sa sút trầm trọng.","partOfSpeech":"idiom"},"Go to town":{"definition":"Làm việc gì đó với sự nhiệt tình và tập trung cao độ; tiêu xài thả ga","example":"They really went to town on the decorations for the party.","exampleTranslation":"Họ thực sự đã đầu tư hết mình vào việc trang trí cho bữa tiệc.","partOfSpeech":"idiom"},"go under the knife":{"definition":"Lên bàn mổ, trải qua phẫu thuật.","example":"He is scheduled to go under the knife tomorrow to repair a torn ligament in his knee.","exampleTranslation":"Anh ấy được lên lịch phẫu thuật vào ngày mai để chữa dây chằng đầu gối bị rách.","partOfSpeech":"idiom"},"Go up in smoke":{"definition":"Tan thành mây khói, thất bại hoàn toàn","example":"The celebration plans went up in smoke due to the sudden storm.","exampleTranslation":"Kế hoạch ăn mừng đã tan thành mây khói do cơn bão bất ngờ.","partOfSpeech":"idiom"},"Go with the flow":{"definition":"Thuận theo tự nhiên, để mọi thứ diễn ra theo cách của nó","example":"Instead of planning every detail, sometimes it’s best to just go with the flow.","exampleTranslation":"Thay vì lên kế hoạch từng chi tiết, đôi khi tốt nhất là cứ thuận theo tự nhiên.","partOfSpeech":"idiom"},"Go without saying":{"definition":"Hiển nhiên, không cần bàn cãi","example":"It goes without saying that safety is our top priority.","exampleTranslation":"Không cần phải nói, an toàn là ưu tiên hàng đầu của chúng tôi.","partOfSpeech":"idiom"},"Go-to guy":{"definition":"Người đáng tin cậy, người chuyên giải quyết vấn đề (trong một nhóm/tổ chức)","example":"When it comes to fixing computers, John is our go-to guy.","exampleTranslation":"Khi nói đến sửa máy tính, John là người chúng tôi tìm đến.","partOfSpeech":"idiom"},"Golden age":{"definition":"Thời kỳ hoàng kim","example":"The 1950s are often considered the golden age of American cinema.","exampleTranslation":"Thập niên 1950 thường được coi là thời kỳ hoàng kim của điện ảnh Mỹ.","partOfSpeech":"idiom"},"Golden opportunity":{"definition":"Cơ hội ngàn vàng","example":"This job offer is a golden opportunity you shouldn’t miss.","exampleTranslation":"Lời mời làm việc này là cơ hội vàng mà bạn không nên bỏ lỡ.","partOfSpeech":"idiom"},"Good egg":{"definition":"Người tốt tính, đáng tin cậy","example":"Tom is such a good egg; he’s always willing to help others.","exampleTranslation":"Tom là người rất tốt bụng; anh ấy luôn sẵn lòng giúp đỡ người khác.","partOfSpeech":"idiom"},"Good for you!":{"definition":"Giỏi lắm, chúc mừng nhé (thường dùng để tán dương)","example":"You finally finished your degree? Good for you!","exampleTranslation":"Cuối cùng bạn cũng hoàn thành bằng cấp rồi à? Giỏi quá!","partOfSpeech":"idiom"},"Good riddance":{"definition":"Mừng vì đã tống khứ được (ai/cái gì); đi rảnh nợ","example":"They moved out yesterday, and I say good riddance. They were terrible neighbors.","exampleTranslation":"Họ đã chuyển đi hôm qua, và tôi nói thật là mừng vì thoát nợ. Họ là những người hàng xóm tệ hại.","partOfSpeech":"idiom"},"Good things come to those who wait":{"definition":"Trời không phụ lòng người kiên nhẫn; phần thưởng tốt đẹp dành cho người biết chờ đợi","example":"He finally got the promotion after years of hard work, proving that good things come to those who wait.","exampleTranslation":"Cuối cùng anh ấy cũng được thăng chức sau nhiều năm làm việc chăm chỉ, chứng minh rằng điều tốt đẹp sẽ đến với người biết chờ đợi.","partOfSpeech":"idiom"},"Good to know":{"definition":"Rất đáng để biết, thông tin rất hữu ích","example":"That is good to know for our trip.","exampleTranslation":"Thật hữu ích khi biết điều đó cho chuyến đi của chúng ta.","partOfSpeech":"idiom"},"Goody-goody gumdrops":{"definition":"Tuyệt vời, ôi thích quá đi mất (thường dùng một cách trẻ con hoặc mỉa mai)","example":"The kids shouted, “Goody, goody gumdrops!” when they found out they were going to the amusement park.","exampleTranslation":"Bọn trẻ reo lên: \"Hay quá, hay quá!\" khi biết mình sẽ đến công viên giải trí.","partOfSpeech":"idiom"},"Goof off":{"definition":"Lãng phí thời gian, chểnh mảng, làm những việc linh tinh","example":"Instead of doing his homework, he spent the entire afternoon goofing off.","exampleTranslation":"Thay vì làm bài tập về nhà, anh ấy dành cả buổi chiều để chơi bời lêu lổng.","partOfSpeech":"idiom"},"Grasp at straws":{"definition":"Vớt vát hy vọng, bấu víu vào bất cứ thứ gì trong tuyệt vọng","example":"In his search for a cure, he was grasping at straws by trying various unproven remedies.","exampleTranslation":"Trong hành trình tìm cách chữa bệnh, anh ta vớ lấy bất cứ cái gì có thể bằng cách thử nhiều phương thuốc chưa được kiểm chứng.","partOfSpeech":"idiom"},"Graveyard shift":{"definition":"Ca làm đêm, ca trực đêm.","example":"He’s working the graveyard shift at the hospital this week.","exampleTranslation":"Tuần này anh ấy làm ca đêm ở bệnh viện.","partOfSpeech":"idiom"},"Gravy train":{"definition":"Việc nhẹ lương cao, món hời, cơ hội kiếm tiền dễ dàng.","example":"He’s been riding the gravy train ever since he landed that high-paying government contract.","exampleTranslation":"Anh ấy sống sung sướng nhàn hạ kể từ khi giành được hợp đồng chính phủ lương cao đó.","partOfSpeech":"idiom"},"Gray area":{"definition":"Vùng xám, ranh giới không rõ ràng.","example":"The legality of that business practice exists in a gray area.","exampleTranslation":"Tính hợp pháp của hoạt động kinh doanh đó nằm trong vùng xám.","partOfSpeech":"idiom"},"Grease monkey":{"definition":"Thợ sửa xe, thợ máy.","example":"The grease monkey fixed my car in no time.","exampleTranslation":"Người thợ máy đã sửa xe của tôi trong chốc lát.","partOfSpeech":"idiom"},"Greased lightning":{"definition":"Nhanh như chớp, nhanh như điện.","example":"She zipped through the crowd like greased lightning to catch the train.","exampleTranslation":"Cô ấy lao qua đám đông nhanh như chớp để kịp chuyến tàu.","partOfSpeech":"idiom"},"Great minds think alike":{"definition":"Tư tưởng lớn gặp nhau, ý tưởng lớn trùng nhau.","example":"Great minds think alike about this project.","exampleTranslation":"Những bộ óc lớn gặp nhau về dự án này.","partOfSpeech":"idiom"},"Green around the gills":{"definition":"Xanh xao, nhợt nhạt, có vẻ ốm yếu hoặc buồn nôn.","example":"He looked green around the gills after the roller coaster ride.","exampleTranslation":"Anh ấy trông xanh xao sau chuyến đi tàu lượn siêu tốc.","partOfSpeech":"idiom"},"Green room":{"definition":"Phòng chờ (dành cho diễn viên, khách mời trước khi lên sân khấu).","example":"The actors chatted with each other in the green room before the show.","exampleTranslation":"Các diễn viên trò chuyện với nhau trong phòng chờ trước buổi diễn.","partOfSpeech":"idiom"},"Green thumb":{"definition":"Có tay trồng cây, mát tay trồng trọt.","example":"She must have a green thumb because her garden is always full of beautiful flowers.","exampleTranslation":"Chắc hẳn cô ấy có bàn tay làm vườn vì khu vườn của cô lúc nào cũng đầy hoa đẹp.","partOfSpeech":"idiom"},"green with envy":{"definition":"Ghen tị đỏ mắt, vô cùng đố kỵ.","example":"When they saw his luxury sports car, all his colleagues were green with envy.","exampleTranslation":"Khi thấy chiếc xe thể thao sang trọng của anh ấy, tất cả đồng nghiệp đều ghen tị.","partOfSpeech":"idiom"},"Grin and bear it":{"definition":"Cắn răng chịu đựng, ngậm đắng nuốt cay.","example":"Even though the project was stressful he chose to grin and bear it until it was completed.","exampleTranslation":"Dù dự án rất căng thẳng, anh ấy chọn cách chịu đựng cho đến khi hoàn thành.","partOfSpeech":"idiom"},"Guinea pig":{"definition":"Chuột bạch, vật thí nghiệm.","example":"They used me as a guinea pig for their new training program.","exampleTranslation":"Họ đã dùng tôi làm chuột thí nghiệm cho chương trình đào tạo mới của họ.","partOfSpeech":"idiom"},"Gung ho":{"definition":"Hăng hái, nhiệt tình, hừng hực khí thế.","example":"He’s so gung ho about the new project, it’s contagious.","exampleTranslation":"Anh ấy nhiệt tình với dự án mới đến mức lan sang cả người khác.","partOfSpeech":"idiom"},"Gut feeling":{"definition":"Trực giác, linh cảm.","example":"I had a gut feeling that something was wrong.","exampleTranslation":"Tôi có linh cảm rằng có điều gì đó không ổn.","partOfSpeech":"idiom"},"Hair of the dog":{"definition":"Rượu giải rượu, lấy độc trị độc (uống thêm rượu để chữa say rượu).","example":"He had a bad hangover, so he decided to have a hair of the dog in the morning.","exampleTranslation":"Anh ấy bị nôn nao nặng, nên quyết định uống thêm chút rượu vào buổi sáng.","partOfSpeech":"idiom"},"Hair’s breadth":{"definition":"Đường tơ kẽ tóc, trong gang tấc.","example":"The car missed the pedestrian by a hair’s breadth.","exampleTranslation":"Chiếc xe suýt chạm vào người đi bộ trong gang tấc.","partOfSpeech":"idiom"},"Half a mind to do something":{"definition":"Có ý định, nửa muốn nửa không (thường vì tức giận nhưng chưa quyết hẳn).","example":"She has half a mind to tell her boss off, but she won’t.","exampleTranslation":"Cô ấy rất muốn mắng sếp một trận, nhưng sẽ không làm vậy.","partOfSpeech":"idiom"},"Half the battle":{"definition":"Một nửa thành công, đã giải quyết được phần khó khăn nhất.","example":"Understanding the problem is half the battle.","exampleTranslation":"Hiểu được vấn đề là đã thành công một nửa.","partOfSpeech":"idiom"},"Half-baked":{"definition":"Chưa chín chắn, thiếu suy nghĩ, nửa vời.","example":"He came up with a half-baked scheme to start a business without any market research.","exampleTranslation":"Anh ta nghĩ ra một kế hoạch thiếu cân nhắc để khởi nghiệp mà không nghiên cứu thị trường.","partOfSpeech":"idiom"},"Hammer out a deal":{"definition":"Thỏa thuận thành công, chốt được hợp đồng sau khi thương lượng căng thẳng.","example":"After weeks of negotiation the two companies finally hammered out a deal.","exampleTranslation":"Sau nhiều tuần đàm phán, hai công ty cuối cùng đã chốt được thỏa thuận.","partOfSpeech":"idiom"},"Hand in glove":{"definition":"Cấu kết chặt chẽ, ăn ý với nhau (thường mang nghĩa tiêu cực hoặc ám muội).","example":"Those two companies have been operating hand in glove for years.","exampleTranslation":"Hai công ty đó đã hợp tác chặt chẽ với nhau trong nhiều năm.","partOfSpeech":"idiom"},"Hand over fist":{"definition":"Vớ bở, kiếm hoặc mất (tiền) nhanh như nước.","example":"The new product was a hit and the company started making money hand over fist.","exampleTranslation":"Sản phẩm mới đã thành công và công ty bắt đầu kiếm tiền như nước.","partOfSpeech":"idiom"},"Handle someone with kid gloves":{"definition":"Đối xử một cách nhẹ nhàng, thận trọng (vì ai đó nhạy cảm)","example":"He has been very stressed lately, so please handle him with kid gloves.","exampleTranslation":"Dạo này anh ấy rất căng thẳng, nên hãy đối xử với anh ấy thật nhẹ nhàng.","partOfSpeech":"idiom"},"Hang in there":{"definition":"Cố gắng lên, đừng bỏ cuộc, kiên trì nhé.","example":"I know the exam is tough, but hang in there; you’ll do great.","exampleTranslation":"Tôi biết kỳ thi khó, nhưng hãy cố lên; bạn sẽ làm tốt thôi.","partOfSpeech":"idiom"},"Hang tight":{"definition":"Cứ chờ ở đó, kiên nhẫn đợi một chút.","example":"Hang tight, the doctor will be with you shortly.","exampleTranslation":"Hãy chờ một chút, bác sĩ sẽ đến gặp bạn ngay.","partOfSpeech":"idiom"},"Happy-go-lucky":{"definition":"Vô tư lự, lạc quan, phó mặc cho số phận.","example":"She’s always been a happy-go-lucky person never worrying too much about what tomorrow brings.","exampleTranslation":"Cô ấy luôn là người vô tư lự, không lo nghĩ nhiều về ngày mai.","partOfSpeech":"idiom"},"hard nut to crack":{"definition":"Vấn đề hóc búa nan giải; người cứng đầu khó thuyết phục.","example":"Analyzing customer retention in this market has proven to be a hard nut to crack.","exampleTranslation":"Việc phân tích khả năng giữ chân khách hàng trong thị trường này đã chứng tỏ là một thách thức lớn.","partOfSpeech":"idiom"},"Hard pill to swallow":{"definition":"Sự thật phũ phàng, điều đắng cay khó chấp nhận.","example":"Losing the championship game was a hard pill to swallow for the team.","exampleTranslation":"Thua trận chung kết là điều khó chấp nhận đối với cả đội.","partOfSpeech":"idiom"},"Hard sell":{"definition":"Cách bán hàng ép buộc, ép mua bằng được.","example":"The car salesman was giving me a hard sell on the latest model.","exampleTranslation":"Người bán xe đã ra sức thúc ép tôi mua mẫu xe mới nhất.","partOfSpeech":"idiom"},"Haste makes waste":{"definition":"Dục tốc bất đạt.","example":"Don’t rush through your homework; remember, haste makes waste.","exampleTranslation":"Đừng làm bài tập vội vàng; hãy nhớ, dục tốc bất đạt.","partOfSpeech":"idiom"},"Have an axe to grind":{"definition":"Có ý đồ riêng, có động cơ cá nhân, có xích mích cần giải quyết.","example":"Be careful when talking to him; he always seems to have an axe to grind.","exampleTranslation":"Hãy cẩn thận khi nói chuyện với anh ta; anh ta dường như luôn có mối hận cá nhân để trả.","partOfSpeech":"idiom"},"Have another thing coming":{"definition":"Lầm to rồi, cứ chờ đấy mà xem.","example":"If he thinks he'll get away without punishment, he has another thing coming.","exampleTranslation":"Nếu anh ta nghĩ rằng mình sẽ thoát khỏi hình phạt, thì anh ta đã nhầm to.","partOfSpeech":"idiom"},"Have bats in one’s belfry":{"definition":"Bị chập mạch, hâm dở, gàn dở.","example":"People say he’s got bats in his belfry because of his strange inventions.","exampleTranslation":"Mọi người nói anh ấy hơi gàn dở vì những phát minh kỳ lạ của mình.","partOfSpeech":"idiom"},"Have bigger fish to fry":{"definition":"Có việc quan trọng hơn cần giải quyết.","example":"He didn’t attend the meeting because he has bigger fish to fry at the moment.","exampleTranslation":"Anh ấy không tham dự cuộc họp vì lúc này có việc quan trọng hơn phải giải quyết.","partOfSpeech":"idiom"},"have egg on one's face":{"definition":"Bẽ mặt, xấu hổ vì mắc sai lầm.","example":"When the CEO's prediction about the market was completely wrong, he ended up with egg on his face.","exampleTranslation":"Khi dự đoán của CEO về thị trường hoàn toàn sai, ông ấy trở nên mất mặt.","partOfSpeech":"idiom"},"Have hell to pay":{"definition":"Gặp rắc rối lớn, phải trả giá đắt.","example":"If he finds out you broke his favorite vase, you’ll have hell to pay.","exampleTranslation":"Nếu anh ta phát hiện bạn làm vỡ chiếc bình yêu thích của anh ta, bạn sẽ phải chịu hậu quả nặng nề.","partOfSpeech":"idiom"},"Have one's back to the wall":{"definition":"Bị dồn vào chân tường, ở thế bí.","example":"With no other options, he felt like he had his back to the wall and had to fight.","exampleTranslation":"Không còn lựa chọn nào khác, anh cảm thấy mình đã bị dồn vào chân tường và phải chiến đấu.","partOfSpeech":"idiom"},"have one's ducks in a row":{"definition":"Chuẩn bị kỹ càng, sắp xếp mọi thứ đâu ra đấy.","example":"Before the big presentation, I need to make sure I have my ducks in a row.","exampleTranslation":"Trước buổi thuyết trình lớn, tôi cần đảm bảo mọi thứ đều đã được sắp xếp ngăn nắp.","partOfSpeech":"idiom"},"Have one's head in the clouds":{"definition":"Mơ mộng hão huyền, để tâm hồn treo ngược cành cây.","example":"He’s always got his head in the clouds during meetings.","exampleTranslation":"Trong các cuộc họp, anh ấy luôn để đầu óc trên mây.","partOfSpeech":"idiom"},"Have one's heart set on":{"definition":"Vô cùng khao khát; quyết tâm đạt được.","example":"My heart is set on going to Paris for vacation this year.","exampleTranslation":"Tôi quyết tâm đi Paris nghỉ mát năm nay.","partOfSpeech":"idiom"},"Have something down pat":{"definition":"Nắm rõ như lòng bàn tay, thuộc làu làu, thành thạo.","example":"She has the whole presentation down pat and can deliver it without any notes.","exampleTranslation":"Cô ấy thuộc làu cả bài thuyết trình và có thể trình bày mà không cần ghi chú.","partOfSpeech":"idiom"},"Have the world by the tail":{"definition":"Nắm chắc phần thắng, làm chủ thế giới, đang ở đỉnh cao danh vọng.","example":"After landing his dream job he felt like he had the world by the tail.","exampleTranslation":"Sau khi có được công việc mơ ước, anh ấy cảm thấy mình như nắm cả thế giới trong tay.","partOfSpeech":"idiom"},"Have time off":{"definition":"Nghỉ phép, có thời gian rảnh rỗi.","example":"I need to have some time off to relax and recharge.","exampleTranslation":"Tôi cần nghỉ ngơi một chút để thư giãn và nạp lại năng lượng.","partOfSpeech":"idiom"},"Have two left feet":{"definition":"Vụng về, lóng ngóng (đặc biệt là khi khiêu vũ).","example":"When it comes to dancing, John has two left feet.","exampleTranslation":"Khi nói đến khiêu vũ, John vụng về hết sức.","partOfSpeech":"idiom"},"He who laughs last laughs loudest":{"definition":"Cười người hôm trước hôm sau người cười; người chiến thắng cuối cùng mới là người giỏi nhất.","example":"John didn’t do well in the early rounds, but he who laughs last laughs loudest — he won the championship.","exampleTranslation":"John không làm tốt ở những vòng đầu, nhưng cười người cuối cùng mới là người cười tươi nhất — anh ấy đã giành chức vô địch.","partOfSpeech":"idiom"},"Head and shoulders above":{"definition":"Vượt trội hoàn toàn, xuất sắc hơn hẳn.","example":"In terms of problem-solving skills Jane is head and shoulders above her peers.","exampleTranslation":"Về kỹ năng giải quyết vấn đề, Jane vượt trội hơn hẳn các đồng nghiệp.","partOfSpeech":"idiom"},"Head honcho":{"definition":"Người sếp cao nhất, người đứng đầu.","example":"The head honcho will be in town next week for the annual meeting.","exampleTranslation":"Ông trùm sẽ đến thị trấn vào tuần sau để dự cuộc họp thường niên.","partOfSpeech":"idiom"},"Head in the clouds":{"definition":"Để tâm hồn trên mây, viển vông, xa rời thực tế.","example":"She’s a dreamer with her head in the clouds but she has great ideas.","exampleTranslation":"Cô ấy là người mơ mộng với cái đầu trên mây nhưng có những ý tưởng tuyệt vời.","partOfSpeech":"idiom"},"Head over heels":{"definition":"Say đắm, mê mệt (thường nói về tình yêu).","example":"He’s head over heels in love with her.","exampleTranslation":"Anh ấy yêu cô ấy say đắm.","partOfSpeech":"idiom"},"Heads-up":{"definition":"Lời báo trước, thông báo trước.","example":"Thanks for the heads-up about the meeting tomorrow.","exampleTranslation":"Cảm ơn bạn đã báo trước về cuộc họp ngày mai.","partOfSpeech":"idiom"},"Hear it on the grapevine":{"definition":"Nghe đồn, hóng hớt được.","example":"I heard it on the grapevine that they are planning to merge with another company.","exampleTranslation":"Tôi nghe phong thanh rằng họ đang có kế hoạch sáp nhập với một công ty khác.","partOfSpeech":"idiom"},"Hear something straight from the horse’s mouth":{"definition":"Nghe từ chính chủ, lấy thông tin từ nguồn đáng tin cậy nhất.","example":"I heard the news straight from the horse’s mouth; the CEO himself confirmed it.","exampleTranslation":"Tôi nghe tin trực tiếp từ nguồn đáng tin; chính CEO đã xác nhận điều đó.","partOfSpeech":"idiom"},"Heebie-jeebies":{"definition":"Nổi da gà, rợn tóc gáy, sợ hãi, ớn lạnh.","example":"The creepy old house gave me the heebie-jeebies.","exampleTranslation":"Ngôi nhà cũ rùng rợn đó khiến tôi sởn gai ốc.","partOfSpeech":"idiom"},"helicopter parent":{"definition":"Phụ huynh trực thăng (cha mẹ bảo bọc, kiểm soát con cái thái quá mọi lúc mọi nơi).","example":"Her mother was a classic helicopter parent who called the teacher over every minor dispute.","exampleTranslation":"Mẹ cô ấy là kiểu phụ huynh bao bọc con quá mức, gọi giáo viên về mọi tranh chấp nhỏ.","partOfSpeech":"idiom"},"Here and there":{"definition":"Chỗ này chỗ kia, rải rác, thỉnh thoảng.","example":"We found small cafes here and there in the city.","exampleTranslation":"Chúng tôi tìm thấy những quán cà phê nhỏ rải rác khắp thành phố.","partOfSpeech":"idiom"},"High on the hog":{"definition":"Sống xa hoa, ăn sung mặc sướng.","example":"Ever since he got his promotion he’s been living high on the hog.","exampleTranslation":"Kể từ khi được thăng chức, anh ấy sống rất xa hoa.","partOfSpeech":"idiom"},"High, wide, and handsome":{"definition":"Đầy tự tin và phóng khoáng; đường hoàng đĩnh đạc.","example":"He entered the room, high, wide, and handsome, capturing everyone's attention.","exampleTranslation":"Anh ấy bước vào phòng, đầy phong thái và bảnh bao, thu hút sự chú ý của mọi người.","partOfSpeech":"idiom"},"Hissy fit":{"definition":"Cơn thịnh nộ vô cớ; ăn vạ (thường dùng với ý hài hước).","example":"She threw a hissy fit just because her coffee was cold.","exampleTranslation":"Cô ấy nổi cơn giận dỗi chỉ vì cà phê của cô bị nguội.","partOfSpeech":"idiom"},"Hit it on the nose":{"definition":"Nói đúng phóc; đoán trúng phóc.","example":"Your analysis of the sales trends was right; you hit it on the nose.","exampleTranslation":"Phân tích của bạn về xu hướng doanh số hoàn toàn chính xác; bạn đã nói trúng phóc.","partOfSpeech":"idiom"},"Hit me up":{"definition":"Liên lạc với tôi; nhắn tin/gọi cho tôi nhé.","example":"I'm free this weekend, hit me up if you want to hang out.","exampleTranslation":"Cuối tuần này tôi rảnh, hãy liên hệ với tôi nếu bạn muốn đi chơi.","partOfSpeech":"idiom"},"Hit pay dirt":{"definition":"Trúng quả đậm; tìm thấy mỏ vàng.","example":"The startup hit pay dirt when they launched their innovative app.","exampleTranslation":"Công ty khởi nghiệp đã trúng mánh khi ra mắt ứng dụng sáng tạo của họ.","partOfSpeech":"idiom"},"Hit someone below the belt":{"definition":"Chơi đòn hiểm; đánh dưới thắt lưng (công kích cá nhân một cách hèn hạ).","example":"Criticizing someone's family to win an argument is definitely hitting below the belt.","exampleTranslation":"Chỉ trích gia đình ai đó để thắng một cuộc tranh cãi chắc chắn là đòn chơi xấu.","partOfSpeech":"idiom"},"Hit the books":{"definition":"Vùi đầu vào sách vở; cắm đầu vào học.","example":"I've got a big exam next week, so it's time to hit the books.","exampleTranslation":"Tuần sau tôi có một kỳ thi lớn, nên đã đến lúc phải học bài.","partOfSpeech":"idiom"},"Hit the ceiling":{"definition":"Nổi trận lôi đình; tức điên lên.","example":"My dad hit the ceiling when I told him I crashed the car.","exampleTranslation":"Bố tôi nổi giận đùng đùng khi tôi nói tôi làm hỏng xe.","partOfSpeech":"idiom"},"Hit the hay":{"definition":"Đi ngủ; lên giường đi ngủ.","example":"I'm really exhausted; it's time to hit the hay.","exampleTranslation":"Tôi thực sự kiệt sức; đã đến lúc đi ngủ rồi.","partOfSpeech":"idiom"},"Hit the jackpot":{"definition":"Trúng số độc đắc; vớ được món hời lớn.","example":"They hit the jackpot with their new product; it sold out in a week.","exampleTranslation":"Họ trúng lớn với sản phẩm mới; nó bán hết sạch trong một tuần.","partOfSpeech":"idiom"},"Hit the nail on the head":{"definition":"Nói trúng tim đen; nói đúng phóc.","example":"You really hit the nail on the head with your analysis of the problem.","exampleTranslation":"Bạn thực sự nói trúng ý khi phân tích vấn đề.","partOfSpeech":"idiom"},"Hit the road":{"definition":"Lên đường; khởi hành.","example":"We should hit the road early to avoid traffic.","exampleTranslation":"Chúng ta nên lên đường sớm để tránh kẹt xe.","partOfSpeech":"idiom"},"Hit the sack":{"definition":"Lên giường đi ngủ.","example":"I'm really tired, so I'm going to hit the sack early tonight.","exampleTranslation":"Tôi thực sự mệt, nên tối nay tôi sẽ đi ngủ sớm.","partOfSpeech":"idiom"},"hit the spot":{"definition":"gãi đúng chỗ ngứa, đúng thứ đang thèm","example":"After a long hike, a cold lemonade really hit the spot.","exampleTranslation":"Sau chuyến đi bộ đường dài, một ly nước chanh lạnh thực sự rất đã khát.","partOfSpeech":"idiom"},"Hocus-pocus":{"definition":"Trò bịp bợm; trò ma thuật.","example":"Don't believe his hocus-pocus; it's all sleight of hand.","exampleTranslation":"Đừng tin những trò bịp bợm của anh ta; tất cả chỉ là mánh khóe.","partOfSpeech":"idiom"},"hold ground":{"definition":"Giữ vững vị trí, kiên định không nhượng bộ.","example":"The debate team held their ground skillfully during the challenging questioning.","exampleTranslation":"Đội tranh biện đã giữ vững lập trường một cách khéo léo trong phần chất vấn khó khăn.","partOfSpeech":"idiom"},"Hold one's own":{"definition":"Đứng vững, không hề kém cạnh (trong khó khăn, cạnh tranh).","example":"Despite his inexperience, he managed to hold his own in the debate.","exampleTranslation":"Dù thiếu kinh nghiệm, anh ấy vẫn giữ được thế cân bằng trong cuộc tranh luận.","partOfSpeech":"idiom"},"Hold out an olive branch":{"definition":"Chìa cành ô liu, tỏ ý muốn hòa giải.","example":"After the heated argument, she decided to hold out an olive branch and apologized.","exampleTranslation":"Sau cuộc cãi vã nảy lửa, cô ấy quyết định làm hòa và xin lỗi.","partOfSpeech":"idiom"},"Hold the fort":{"definition":"Quán xuyến công việc (trong lúc ai đó đi vắng); trông nom nhà cửa.","example":"The manager asked me to hold the fort until she returns.","exampleTranslation":"Quản lý yêu cầu tôi trông coi mọi việc cho đến khi cô ấy trở về.","partOfSpeech":"idiom"},"Hold your horses":{"definition":"Bình tĩnh lại nào; từ từ đã.","example":"Hold your horses, the meeting doesn't start for another 30 minutes.","exampleTranslation":"Khoan đã, cuộc họp phải 30 phút nữa mới bắt đầu.","partOfSpeech":"idiom"},"Hold your tongue":{"definition":"Giữ mồm giữ miệng; im lặng.","example":"She wanted to argue, but decided to hold her tongue.","exampleTranslation":"Cô ấy muốn tranh cãi, nhưng quyết định giữ im lặng.","partOfSpeech":"idiom"},"Holding the bag":{"definition":"Phải giơ đầu chịu báng; gánh chịu hậu quả một mình.","example":"She ended up holding the bag after her teammates didn't show up for the presentation.","exampleTranslation":"Cô ấy phải gánh hậu quả một mình sau khi đồng đội không xuất hiện trong buổi thuyết trình.","partOfSpeech":"idiom"},"home sweet home":{"definition":"Không đâu bằng nhà mình; mái ấm thân yêu.","example":"After traveling abroad for a grueling month, I walked through the door and whispered, 'Home sweet home.'","exampleTranslation":"Sau một tháng mệt mỏi đi nước ngoài, tôi bước qua cửa và thì thầm: \"Không đâu bằng nhà.\"","partOfSpeech":"idiom"},"Hopping mad":{"definition":"Tức nhảy cồ cồ; giận sôi máu.","example":"When she found out about the broken vase, she was hopping mad.","exampleTranslation":"Khi biết chiếc bình bị vỡ, cô ấy giận sôi lên.","partOfSpeech":"idiom"},"Horse around":{"definition":"Đùa giỡn ầm ĩ; nghịch ngợm.","example":"Stop horsing around, we need to get this project done!","exampleTranslation":"Đừng đùa nghịch nữa, chúng ta cần hoàn thành dự án này!","partOfSpeech":"idiom"},"Horse of a different color":{"definition":"Một chuyện hoàn toàn khác; một vấn đề khác hẳn.","example":"I thought the meeting was about budget cuts, but it turned out to be a horse of a different color.","exampleTranslation":"Tôi tưởng cuộc họp nói về cắt giảm ngân sách, nhưng hóa ra là chuyện hoàn toàn khác.","partOfSpeech":"idiom"},"Hot under the collar":{"definition":"Nổi giận đùng đùng; bực tức.","example":"He got hot under the collar when his colleague blamed him for the mistake.","exampleTranslation":"Anh ấy nổi nóng khi đồng nghiệp đổ lỗi cho anh ấy về sai sót.","partOfSpeech":"idiom"},"Hot-button issue":{"definition":"Vấn đề nhức nhối; chủ đề gây tranh cãi gay gắt.","example":"Gun control is a hot-button issue that divides many Americans.","exampleTranslation":"Kiểm soát súng đạn là vấn đề nhạy cảm chia rẽ nhiều người Mỹ.","partOfSpeech":"idiom"},"Hotshot":{"definition":"Kẻ xuất chúng nhưng kiêu ngạo; người tài giỏi xuất sắc.","example":"She's a hotshot lawyer known for winning difficult cases.","exampleTranslation":"Cô ấy là một luật sư tài giỏi nổi tiếng với việc thắng những vụ khó.","partOfSpeech":"idiom"},"How do you like them apples":{"definition":"Thấy sao hả?; Nhìn mà xem! (dùng khi đắc ý).","example":"We won the championship! How do you like them apples?","exampleTranslation":"Chúng ta đã giành chức vô địch! Các bạn thấy thế nào?","partOfSpeech":"idiom"},"Hunky-dory":{"definition":"Mọi chuyện đều ổn thỏa; êm đẹp.","example":"Don't worry, everything will be hunky-dory by the weekend.","exampleTranslation":"Đừng lo, mọi thứ sẽ ổn thỏa vào cuối tuần.","partOfSpeech":"idiom"},"I can't imagine":{"definition":"Tôi không thể tưởng tượng được.","example":"I can't imagine living without the internet these days.","exampleTranslation":"Tôi không thể tưởng tượng được cuộc sống không có internet ngày nay.","partOfSpeech":"idiom"},"I don't have two nickels to rub together":{"definition":"Cháy túi; không có một xu dính túi.","example":"After losing my job, I don't have two nickels to rub together.","exampleTranslation":"Sau khi mất việc, tôi nghèo rớt mồng tơi.","partOfSpeech":"idiom"},"I suck at something":{"definition":"Tôi rất tệ ở việc gì đó; dở tệ.","example":"I really suck at math. I always get bad grades.","exampleTranslation":"Tôi thực sự rất dở môn toán. Tôi luôn bị điểm kém.","partOfSpeech":"idiom"},"I wasn't born yesterday":{"definition":"Tôi đâu có phải trẻ lên ba; tôi đâu có dễ bị lừa.","example":"You can't trick me with such a simple scam; I wasn't born yesterday.","exampleTranslation":"Bạn không thể lừa tôi bằng trò lừa đảo đơn giản như vậy; tôi không phải đứa trẻ ngây thơ.","partOfSpeech":"idiom"},"I'd give my right hand to":{"definition":"Tôi sẵn sàng đánh đổi tất cả để; tôi vô cùng khao khát.","example":"I'd give my right hand to meet my favorite author in person.","exampleTranslation":"Tôi sẵn sàng đánh đổi tất cả để được gặp tác giả yêu thích của mình.","partOfSpeech":"idiom"},"I'm losing it":{"definition":"Tôi sắp phát điên rồi; tôi sắp mất kiểm soát rồi.","example":"I'm so stressed out with all these deadlines; I'm losing it.","exampleTranslation":"Tôi căng thẳng quá với tất cả những hạn chót này; tôi sắp mất kiểm soát.","partOfSpeech":"idiom"},"Icing on the cake":{"definition":"Thêm phần rực rỡ; phần thưởng thêm.","example":"Getting a promotion was great, but the bonus was the icing on the cake.","exampleTranslation":"Được thăng chức đã tuyệt vời rồi, nhưng khoản thưởng còn là điều tuyệt hơn nữa.","partOfSpeech":"idiom"},"Idle hands are the devil's tools":{"definition":"Nhàn cư vi bất thiện.","example":"Parents often encourage their children to find a hobby because they believe idle hands are the devil's tools.","exampleTranslation":"Cha mẹ thường khuyến khích con tìm một sở thích vì họ tin rằng nhàn cư vi bất thiện.","partOfSpeech":"idiom"},"If I had a nickel for every time something happened":{"definition":"Nếu mỗi lần như vậy tôi có một đồng xu thì tôi đã giàu to; chuyện xảy ra như cơm bữa.","example":"If I had a nickel for every time my phone battery died, I'd have a lot of nickels.","exampleTranslation":"Nếu tôi nhận được một đồng cho mỗi lần pin điện thoại hết, tôi đã có rất nhiều tiền.","partOfSpeech":"idiom"},"If worst comes to worst":{"definition":"Trong trường hợp xấu nhất.","example":"If worst comes to worst, I'll use my savings to cover the expenses.","exampleTranslation":"Nếu điều tồi tệ nhất xảy ra, tôi sẽ dùng tiền tiết kiệm để trang trải chi phí.","partOfSpeech":"idiom"},"If you can't stand the heat, get out of the kitchen":{"definition":"Không chịu được áp lực thì đừng làm.","example":"Running a business is tough. If you can't stand the heat, get out of the kitchen.","exampleTranslation":"Kinh doanh rất khó khăn. Nếu bạn không chịu được áp lực thì hãy rút lui.","partOfSpeech":"idiom"},"If you play your cards right":{"definition":"Nếu biết cách tính toán; nếu khéo léo xử lý.","example":"If you play your cards right, you might get that promotion.","exampleTranslation":"Nếu bạn biết cách hành động khéo léo, bạn có thể được thăng chức.","partOfSpeech":"idiom"},"Ignorance is bliss":{"definition":"Không biết thì không đau lòng; ngu si hưởng thái bình.","example":"He decided not to tell her about the bad news; after all, ignorance is bliss.","exampleTranslation":"Anh ấy quyết định không nói cho cô ấy biết tin xấu; dù sao thì không biết lại là hạnh phúc.","partOfSpeech":"idiom"},"In a bind":{"definition":"Đang gặp rắc rối; rơi vào tình thế tiến thoái lưỡng nan.","example":"She is really in a bind with all these bills to pay.","exampleTranslation":"Cô ấy thực sự đang gặp khó khăn với tất cả những hóa đơn phải trả này.","partOfSpeech":"idiom"},"In a jam":{"definition":"Đang kẹt cứng; rơi vào hoàn cảnh khó khăn.","example":"I'm really in a jam right now. My car broke down, and I have no way to get to work.","exampleTranslation":"Hiện tôi đang gặp rắc rối lớn. Xe của tôi bị hỏng và tôi không có cách nào đi làm.","partOfSpeech":"idiom"},"In a nutshell":{"definition":"Tóm lại; nói ngắn gọn.","example":"In a nutshell, the company is facing financial difficulties.","exampleTranslation":"Tóm lại, công ty đang gặp khó khăn tài chính.","partOfSpeech":"idiom"},"In a pinch":{"definition":"Trong trường hợp khẩn cấp; dùng tạm khi cấp bách.","example":"I can use my phone as a flashlight in a pinch.","exampleTranslation":"Trong trường hợp khẩn cấp, tôi có thể dùng điện thoại làm đèn pin.","partOfSpeech":"idiom"},"In a rut":{"definition":"Rơi vào lối mòn; bế tắc trong công việc/cuộc sống.","example":"She feels like she's in a rut at her current job.","exampleTranslation":"Cô ấy cảm thấy mình đang mắc kẹt trong sự nhàm chán ở công việc hiện tại.","partOfSpeech":"idiom"},"In charge of":{"definition":"Chịu trách nhiệm (quản lý, điều hành).","example":"She is in charge of the marketing team.","exampleTranslation":"Cô ấy phụ trách nhóm tiếp thị.","partOfSpeech":"idiom"},"in due course":{"definition":"Đúng lúc, vào thời điểm thích hợp trong tương lai.","example":"Your application will be processed and you will receive a response in due course.","exampleTranslation":"Đơn đăng ký của bạn sẽ được xử lý và bạn sẽ nhận được phản hồi vào thời điểm thích hợp.","partOfSpeech":"idiom"},"In full swing":{"definition":"Đang ở lúc cao trào; đang hoạt động hết công suất.","example":"The party was in full swing by the time we arrived.","exampleTranslation":"Bữa tiệc đã đang náo nhiệt khi chúng tôi đến.","partOfSpeech":"idiom"},"In high gear":{"definition":"Tăng tốc; làm việc với cường độ cao.","example":"After the meeting, the team kicked into high gear and started implementing the new plan.","exampleTranslation":"Sau cuộc họp, cả nhóm tăng tốc và bắt đầu thực hiện kế hoạch mới.","partOfSpeech":"idiom"},"In hot water":{"definition":"Gặp rắc rối lớn; dầu sôi lửa bỏng.","example":"He got in hot water with his parents after coming home late.","exampleTranslation":"Anh ấy gặp rắc rối với bố mẹ sau khi về nhà muộn.","partOfSpeech":"idiom"},"In my book":{"definition":"Theo quan điểm của tôi; theo suy nghĩ của tôi.","example":"In my book, honesty is always the best policy.","exampleTranslation":"Theo quan điểm của tôi, trung thực luôn là chính sách tốt nhất.","partOfSpeech":"idiom"},"In my element":{"definition":"Như cá gặp nước; ở đúng sở trường của mình.","example":"When she's baking in the kitchen, she's truly in her element.","exampleTranslation":"Khi cô ấy nướng bánh trong bếp, cô ấy thực sự như cá gặp nước.","partOfSpeech":"idiom"},"In seventh heaven":{"definition":"Cảm thấy vô cùng sung sướng, hạnh phúc ngất ngây (như ở trên chín tầng mây).","example":"When she got the promotion, she was in seventh heaven.","exampleTranslation":"Khi được thăng chức, cô ấy sướng như lên chín tầng mây.","partOfSpeech":"idiom"},"In spades":{"definition":"Rất nhiều, ở mức độ cao.","example":"Their hard work paid off in spades when they won the championship.","exampleTranslation":"Sự chăm chỉ của họ đã được đền đáp xứng đáng khi họ giành chức vô địch.","partOfSpeech":"idiom"},"In stitches":{"definition":"Cười ngặt nghẽo, cười đau cả bụng.","example":"The comedian had the entire audience in stitches during his performance.","exampleTranslation":"Diễn viên hài khiến toàn bộ khán giả cười nghiêng ngả trong suốt buổi biểu diễn.","partOfSpeech":"idiom"},"In the bag":{"definition":"Chắc ăn, nắm chắc phần thắng trong tay.","example":"With the way they are playing, the championship is in the bag.","exampleTranslation":"Với cách họ đang chơi, chức vô địch coi như đã nằm trong tay.","partOfSpeech":"idiom"},"In the black":{"definition":"Có lãi, làm ăn có lợi nhuận, không bị mắc nợ.","example":"After a tough year, the company is finally in the black.","exampleTranslation":"Sau một năm khó khăn, công ty cuối cùng cũng có lãi.","partOfSpeech":"idiom"},"in the blink of an eye":{"definition":"Trong chớp mắt, trong khoảnh khắc.","example":"Summer vacation seemed to pass by in the blink of an eye.","exampleTranslation":"Kỳ nghỉ hè dường như trôi qua trong nháy mắt.","partOfSpeech":"idiom"},"In the boondocks":{"definition":"Ở nơi khỉ ho cò gáy, vùng sâu vùng xa.","example":"His grandparents live way out in the boondocks.","exampleTranslation":"Ông bà anh ấy sống tận vùng hẻo lánh xa xôi.","partOfSpeech":"idiom"},"In the chips / In the money":{"definition":"Giàu có, rủng rỉnh tiền bạc.","example":"Since landing that high-paying job, Jake has been in the money.","exampleTranslation":"Kể từ khi có công việc lương cao đó, Jake đã có nhiều tiền.","partOfSpeech":"idiom"},"In the doghouse":{"definition":"Đang bị ai đó giận, gặp rắc rối vì làm phật ý người khác.","example":"He forgot their anniversary, so he's really in the doghouse now.","exampleTranslation":"Anh ta quên ngày kỷ niệm của họ, nên bây giờ anh ta thực sự đang bị thất sủng.","partOfSpeech":"idiom"},"In the heat of the moment":{"definition":"Trong lúc nóng giận hoặc thiếu suy nghĩ do cảm xúc dâng trào.","example":"He said something hurtful in the heat of the moment, but later apologized.","exampleTranslation":"Anh ấy đã nói điều gây tổn thương trong lúc nóng giận, nhưng sau đó đã xin lỗi.","partOfSpeech":"idiom"},"In the lap of luxury":{"definition":"Trong nhung lụa, sống xa hoa.","example":"They've been living in the lap of luxury since winning the lottery.","exampleTranslation":"Họ đã sống trong cảnh xa hoa kể từ khi trúng số.","partOfSpeech":"idiom"},"In the least":{"definition":"Một chút nào (dùng trong câu phủ định mang nghĩa 'hoàn toàn không').","example":"I'm not worried in the least about the exam.","exampleTranslation":"Tôi không lo lắng chút nào về kỳ thi.","partOfSpeech":"idiom"},"In the long run":{"definition":"Về lâu về dài, rốt cuộc thì.","example":"Cutting corners might save money now, but in the long run, it could cost more.","exampleTranslation":"Làm ẩu có thể tiết kiệm tiền bây giờ, nhưng về lâu dài có thể tốn kém hơn.","partOfSpeech":"idiom"},"In the loop":{"definition":"Được cập nhật thông tin, nắm rõ tình hình.","example":"I need to stay in the loop about the project's progress.","exampleTranslation":"Tôi cần luôn được cập nhật thông tin về tiến độ của dự án.","partOfSpeech":"idiom"},"In the nick of time":{"definition":"Vừa kịp lúc, sát nút.","example":"The firefighters arrived in the nick of time to save the building from burning down.","exampleTranslation":"Lính cứu hỏa đã đến kịp lúc để cứu tòa nhà khỏi bị thiêu rụi.","partOfSpeech":"idiom"},"In the pink":{"definition":"Vô cùng khỏe mạnh, ở trạng thái sức khỏe tốt nhất.","example":"After a few weeks of recovery, he's finally in the pink again.","exampleTranslation":"Sau vài tuần hồi phục, cuối cùng anh ấy lại khỏe mạnh như thường.","partOfSpeech":"idiom"},"In the red":{"definition":"Bị thua lỗ, mắc nợ.","example":"After a bad year, the company found itself in the red.","exampleTranslation":"Sau một năm tồi tệ, công ty rơi vào cảnh thua lỗ.","partOfSpeech":"idiom"},"in the same boat":{"definition":"Cùng chung cảnh ngộ, cùng hội cùng thuyền.","example":"None of us finished the assignment yet, so we are all in the same boat.","exampleTranslation":"Chưa ai trong chúng tôi hoàn thành bài tập, nên tất cả đều cùng chung cảnh ngộ.","partOfSpeech":"idiom"},"In the sticks":{"definition":"Ở vùng sâu vùng xa, nơi hẻo lánh.","example":"She moved to a small house in the sticks to get away from the city noise.","exampleTranslation":"Cô ấy chuyển đến một ngôi nhà nhỏ ở vùng hẻo lánh để tránh xa tiếng ồn thành phố.","partOfSpeech":"idiom"},"In the way":{"definition":"Ngáng đường, gây cản trở.","example":"He always feels like his big sister is in the way when he's trying to concentrate.","exampleTranslation":"Anh ấy luôn cảm thấy chị gái mình vướng víu khi anh đang cố tập trung.","partOfSpeech":"idiom"},"It ain't over till the fat lady sings":{"definition":"Chưa đến phút cuối thì chưa biết kết quả ra sao (30 chưa phải là Tết).","example":"Don't be discouraged by the score; it ain't over till the fat lady sings.","exampleTranslation":"Đừng nản lòng vì tỷ số; chưa đến phút cuối thì chưa biết ai thắng.","partOfSpeech":"idiom"},"It is a poor workman who blames his tools":{"definition":"Thợ tồi thì đổ lỗi cho đồ nghề.","example":"Sarah was frustrated with her old paintbrushes, but her teacher reminded her that it's a poor workman who blames his tools.","exampleTranslation":"Sarah bực bội với những chiếc cọ vẽ cũ của mình, nhưng giáo viên nhắc cô rằng thợ dở thường hay trách dụng cụ.","partOfSpeech":"idiom"},"It is always darkest before the dawn":{"definition":"Cơn bĩ cực qua đi, hồi thái lai sẽ đến (mọi việc thường trở nên tồi tệ nhất trước khi tốt đẹp lên).","example":"Remember, it's always darkest before the dawn; things will get better soon.","exampleTranslation":"Hãy nhớ rằng đêm tối nhất là trước bình minh; mọi chuyện sẽ sớm tốt đẹp hơn.","partOfSpeech":"idiom"},"It takes one to know one":{"definition":"Ngưu tầm ngưu, mã tầm mã; tự nhận mình cũng thế mới đi chê người khác.","example":"It takes one to know one, my friend.","exampleTranslation":"Ngưu tầm ngưu, mã tầm mã, bạn ạ.","partOfSpeech":"idiom"},"It takes two to tango":{"definition":"Có lửa mới có khói; cả hai bên đều phải chịu trách nhiệm cho sự việc.","example":"Don't blame just one person for the argument; it takes two to tango.","exampleTranslation":"Đừng chỉ đổ lỗi cho một người trong cuộc tranh cãi; một cái vỗ tay không kêu.","partOfSpeech":"idiom"},"It's in the bag":{"definition":"Chắc ăn, nắm chắc phần thắng trong tay.","example":"Once he scored the third goal, the victory was in the bag.","exampleTranslation":"Khi anh ấy ghi bàn thứ ba, chiến thắng coi như chắc chắn.","partOfSpeech":"idiom"},"Itchy feet":{"definition":"Ngứa ngáy tay chân, khao khát được đi du lịch hoặc chuyển đến nơi khác.","example":"She's had itchy feet ever since she got back from Europe and keeps talking about her next trip.","exampleTranslation":"Cô ấy lúc nào cũng ngứa ngáy muốn đi từ khi trở về từ châu Âu và cứ nhắc đến chuyến đi tiếp theo.","partOfSpeech":"idiom"},"Ivory tower":{"definition":"Tháp ngà (nơi sống tách biệt với thực tế xã hội, thường ám chỉ giới học thuật).","example":"Many people think professors live in an ivory tower, disconnected from the real world.","exampleTranslation":"Nhiều người nghĩ rằng các giáo sư sống trong tháp ngà, tách biệt với thế giới thực.","partOfSpeech":"idiom"},"Jaywalking":{"definition":"Hành vi qua đường ẩu, không đúng nơi quy định hoặc vượt đèn đỏ.","example":"He got a ticket for jaywalking across the busy street.","exampleTranslation":"Anh ta bị phạt vì băng qua đường không đúng nơi quy định trên con phố đông đúc.","partOfSpeech":"idiom"},"Johnny-come-lately":{"definition":"Người mới đến, kẻ chân ướt chân ráo nhưng lại muốn được ưu ái như người cũ.","example":"The team doesn't take kindly to a Johnny-come-lately giving suggestions.","exampleTranslation":"Cả đội không có thiện cảm với kẻ mới đến mà lại đưa ra đề xuất.","partOfSpeech":"idiom"},"Joined at the hip":{"definition":"Dính lấy nhau như hình với bóng.","example":"Ever since they started dating, they've been joined at the hip.","exampleTranslation":"Từ khi họ bắt đầu hẹn hò, họ luôn dính nhau như hình với bóng.","partOfSpeech":"idiom"},"Josh someone":{"definition":"Nói đùa, trêu chọc ai đó một cách vui vẻ.","example":"Are you joshing me? There's no way you finished that project in one day.","exampleTranslation":"Bạn đùa tôi à? Không đời nào bạn hoàn thành dự án đó trong một ngày.","partOfSpeech":"idiom"},"Jump down someone's throat":{"definition":"Nổi trận lôi đình, mắng nhiếc ai đó té tát và vô cớ.","example":"He made a small mistake and she jumped down his throat.","exampleTranslation":"Anh ấy mắc một lỗi nhỏ và cô ấy đã mắng anh ấy thậm tệ.","partOfSpeech":"idiom"},"jump for joy":{"definition":"Nhảy cẫng lên vì sung sướng.","example":"The team jumped for joy when the final whistle blew and they won the championship.","exampleTranslation":"Cả đội nhảy lên vui mừng khi tiếng còi cuối trận vang lên và họ giành chức vô địch.","partOfSpeech":"idiom"},"Jump on the bandwagon":{"definition":"Hùa theo phong trào, chạy theo xu hướng đang thịnh hành.","example":"After the new show became a big hit, everyone seemed to jump on the bandwagon.","exampleTranslation":"Sau khi chương trình mới trở nên nổi tiếng, mọi người dường như đều chạy theo phong trào.","partOfSpeech":"idiom"},"Jump the gun":{"definition":"Cầm đèn chạy trước ô tô, hấp tấp làm việc gì đó quá sớm.","example":"She jumped the gun by submitting her application before getting all the necessary documents.","exampleTranslation":"Cô ấy đã hành động quá vội khi nộp đơn trước khi có đủ giấy tờ cần thiết.","partOfSpeech":"idiom"},"Jump through hoops":{"definition":"Vượt qua nhiều rào cản, thủ tục rườm rà để đạt được mục đích.","example":"She had to jump through a lot of hoops to get her visa approved.","exampleTranslation":"Cô ấy phải trải qua rất nhiều thủ tục rườm rà để được duyệt thị thực.","partOfSpeech":"idiom"},"Junk food":{"definition":"Đồ ăn vặt, thức ăn nhanh có hại cho sức khỏe (ít dinh dưỡng, nhiều calo).","example":"Try to avoid eating too much junk food and focus on healthier options.","exampleTranslation":"Hãy cố tránh ăn quá nhiều đồ ăn vặt và tập trung vào những lựa chọn lành mạnh hơn.","partOfSpeech":"idiom"},"Just a moment":{"definition":"Chờ một lát, xin đợi một chút.","example":"Just a moment, I'll be right with you.","exampleTranslation":"Chờ một chút, tôi sẽ đến ngay với bạn.","partOfSpeech":"idiom"},"Just around the corner":{"definition":"Sắp tới rồi, rất gần (về mặt thời gian hoặc khoảng cách).","example":"With the deadline just around the corner, everyone's working overtime.","exampleTranslation":"Hạn chót đã cận kề, ai nấy đều đang làm thêm giờ.","partOfSpeech":"idiom"},"Just now":{"definition":"Vừa mới đây, cách đây một lát.","example":"She called me just now to inform me of the meeting.","exampleTranslation":"Cô ấy vừa gọi cho tôi để thông báo về cuộc họp.","partOfSpeech":"idiom"},"Keep an eye on":{"definition":"Để mắt tới, trông chừng.","example":"Can you keep an eye on the baby while I cook dinner?","exampleTranslation":"Bạn có thể trông chừng em bé trong lúc tôi nấu bữa tối không?","partOfSpeech":"idiom"},"keep at bay":{"definition":"Ngăn chặn, kìm hãm mối nguy hiểm ở khoảng cách an toàn.","example":"Drinking citrus juice and getting enough sleep helps keep common colds at bay.","exampleTranslation":"Uống nước cam quýt và ngủ đủ giấc giúp phòng ngừa cảm lạnh thông thường.","partOfSpeech":"idiom"},"Keep body and soul together":{"definition":"Cố gắng cầm cự để sống sót, kiếm vừa đủ ăn để sống qua ngày.","example":"With his low wages, he can only just keep body and soul together.","exampleTranslation":"Với mức lương thấp, anh ấy chỉ vừa đủ sống qua ngày.","partOfSpeech":"idiom"},"keep in mind":{"definition":"Ghi nhớ trong đầu, lưu tâm khi ra quyết định.","example":"Keep in mind that stores close early on national holidays.","exampleTranslation":"Hãy nhớ rằng các cửa hàng đóng cửa sớm vào những ngày lễ quốc gia.","partOfSpeech":"idiom"},"Keep one's chin up":{"definition":"Giữ tinh thần lạc quan, đừng nản chí.","example":"Even though times are tough, try to keep your chin up.","exampleTranslation":"Dù thời buổi khó khăn, hãy cố gắng giữ vững tinh thần.","partOfSpeech":"idiom"},"Keep one's cool":{"definition":"Giữ bình tĩnh, không nổi nóng trong những tình huống căng thẳng.","example":"It's important to keep your cool in stressful situations at work.","exampleTranslation":"Điều quan trọng là phải giữ bình tĩnh trong những tình huống căng thẳng ở nơi làm việc.","partOfSpeech":"idiom"},"Keep one's head":{"definition":"Giữ bình tĩnh.","example":"In the chaotic meeting, he was the only one who managed to keep his head.","exampleTranslation":"Trong cuộc họp hỗn loạn, anh ấy là người duy nhất giữ được sự bình tĩnh.","partOfSpeech":"idiom"},"Keep one's head above water":{"definition":"Cố gắng xoay xở để không bị ngập trong nợ nần hoặc khó khăn.","example":"Ever since losing my job, I've been struggling to keep my head above water.","exampleTranslation":"Kể từ khi mất việc, tôi đã phải vật lộn để gượng dậy.","partOfSpeech":"idiom"},"Keep one's mouth shut":{"definition":"Giữ im lặng, không nói ra.","example":"If you know what's good for you, you'll keep your mouth shut about this.","exampleTranslation":"Nếu bạn biết điều gì tốt cho mình, bạn sẽ giữ im lặng về chuyện này.","partOfSpeech":"idiom"},"Keep one's nose clean":{"definition":"Tránh rắc rối, cư xử đúng mực.","example":"If you want to stay out of trouble, you better keep your nose clean.","exampleTranslation":"Nếu muốn tránh rắc rối, tốt hơn hết bạn nên giữ mình trong sạch.","partOfSpeech":"idiom"},"Keep one's nose to the grindstone":{"definition":"Làm việc chăm chỉ, cặm cụi làm việc.","example":"If you want to succeed, you have to keep your nose to the grindstone.","exampleTranslation":"Nếu muốn thành công, bạn phải làm việc miệt mài không ngừng nghỉ.","partOfSpeech":"idiom"},"keep one's temper":{"definition":"Giữ bình tĩnh, kìm nén cơn giận.","example":"It was difficult, but she managed to keep her temper during the heated argument.","exampleTranslation":"Rất khó khăn, nhưng cô ấy đã kiềm chế được cơn giận trong cuộc tranh cãi nảy lửa.","partOfSpeech":"idiom"},"Keep one's wits about one":{"definition":"Giữ tỉnh táo và cảnh giác.","example":"When walking through a crowded market, you need to keep your wits about you.","exampleTranslation":"Khi đi qua một khu chợ đông đúc, bạn cần cảnh giác.","partOfSpeech":"idiom"},"Keep someone at arm's length":{"definition":"Giữ khoảng cách với ai đó.","example":"She's been keeping her coworkers at arm's length since her promotion.","exampleTranslation":"Cô ấy giữ khoảng cách với đồng nghiệp kể từ khi được thăng chức.","partOfSpeech":"idiom"},"Keep someone in the dark":{"definition":"Giữ ai đó trong sự thiếu hiểu biết, giấu giếm ai đó.","example":"The employees were kept in the dark about the company's merger plans.","exampleTranslation":"Nhân viên bị giấu kín về kế hoạch sáp nhập của công ty.","partOfSpeech":"idiom"},"Keep someone posted":{"definition":"Cập nhật thông tin cho ai đó.","example":"I'll keep you posted on any new developments.","exampleTranslation":"Tôi sẽ thông báo cho bạn về mọi diễn biến mới.","partOfSpeech":"idiom"},"Keep someone posted / Keep someone in the loop":{"definition":"Cập nhật tình hình cho ai đó, giữ cho họ nắm bắt được thông tin.","example":"Please keep me posted on any changes to the schedule.","exampleTranslation":"Vui lòng cập nhật cho tôi về mọi thay đổi trong lịch trình.","partOfSpeech":"idiom"},"Keep something at bay":{"definition":"Ngăn chặn, kiểm soát điều gì đó xấu.","example":"Regular exercise can help to keep stress at bay.","exampleTranslation":"Tập thể dục thường xuyên có thể giúp ngăn chặn căng thẳng.","partOfSpeech":"idiom"},"Keep something under control":{"definition":"Kiểm soát tình hình, không để mọi chuyện vượt quá tầm kiểm soát.","example":"It's important to keep it under control during an emergency.","exampleTranslation":"Điều quan trọng là phải kiểm soát được tình hình trong tình huống khẩn cấp.","partOfSpeech":"idiom"},"Keep something under one's hat":{"definition":"Giữ bí mật điều gì đó.","example":"I have some exciting news, but you gotta keep it under your hat for now.","exampleTranslation":"Tôi có một tin thú vị, nhưng bạn phải giữ bí mật vào lúc này.","partOfSpeech":"idiom"},"Keep something under wraps":{"definition":"Giữ bí mật về chuyện gì đó, không tiết lộ ra ngoài.","example":"They decided to keep it under wraps until the official announcement.","exampleTranslation":"Họ quyết định giữ kín cho đến khi có thông báo chính thức.","partOfSpeech":"idiom"},"keep tabs on":{"definition":"Theo dõi sát sao, để mắt canh chừng ai/cái gì.","example":"The manager keeps close tabs on stock levels to prevent inventory shortages.","exampleTranslation":"Người quản lý theo dõi sát sao lượng hàng tồn kho để ngăn ngừa tình trạng thiếu hàng.","partOfSpeech":"idiom"},"Keep the ball rolling":{"definition":"Duy trì sự tiến triển của một việc gì đó.","example":"We need to keep the ball rolling on this project to meet the deadline.","exampleTranslation":"Chúng ta cần duy trì tiến độ của dự án này để kịp hạn chót.","partOfSpeech":"idiom"},"Keep up with":{"definition":"Theo kịp, bắt kịp.","example":"It's hard to keep up with the latest technology trends.","exampleTranslation":"Thật khó để theo kịp các xu hướng công nghệ mới nhất.","partOfSpeech":"idiom"},"Keep up with the Joneses":{"definition":"Đua đòi, cố gắng bằng bạn bằng bè.","example":"They're always keeping up with the Joneses, trying to buy every new gadget their neighbors get.","exampleTranslation":"Họ lúc nào cũng chạy đua với hàng xóm, cố mua mọi thiết bị mới mà hàng xóm có.","partOfSpeech":"idiom"},"keep your chin up":{"definition":"Hãy lạc quan lên, đừng nản lòng, ngẩng cao đầu.","example":"Keep your chin up; you will do much better on the next interview.","exampleTranslation":"Hãy ngẩng cao đầu lên; bạn sẽ làm tốt hơn nhiều trong buổi phỏng vấn tiếp theo.","partOfSpeech":"idiom"},"Keyed up":{"definition":"Căng thẳng, hồi hộp hoặc phấn khích.","example":"She was all keyed up before her big presentation.","exampleTranslation":"Cô ấy đã rất hồi hộp trước buổi thuyết trình quan trọng.","partOfSpeech":"idiom"},"Kick up one's heels":{"definition":"Thư giãn và vui vẻ.","example":"After finishing the project, they decided to kick up their heels and throw a big party.","exampleTranslation":"Sau khi hoàn thành dự án, họ quyết định thư giãn tưng bừng và tổ chức một bữa tiệc lớn.","partOfSpeech":"idiom"},"Kill the mood":{"definition":"Làm mất vui, phá hỏng bầu không khí.","example":"His rude comment killed the mood at the party.","exampleTranslation":"Lời nhận xét thô lỗ của anh ta đã phá hỏng không khí bữa tiệc.","partOfSpeech":"idiom"},"kill time":{"definition":"Giết thời gian, tiêu khiển trong lúc chờ đợi.","example":"We browsed books at the airport bookstore to kill time before boarding our flight.","exampleTranslation":"Chúng tôi lướt xem sách ở hiệu sách sân bay để giết thời gian trước khi lên máy bay.","partOfSpeech":"idiom"},"Kill two birds with one stone":{"definition":"Một mũi tên trúng hai đích, một công đôi việc.","example":"By carpooling, we can kill two birds with one stone — save money on gas and reduce our carbon footprint.","exampleTranslation":"Bằng cách đi chung xe, chúng ta có thể một công đôi việc — tiết kiệm tiền xăng và giảm lượng khí thải carbon.","partOfSpeech":"idiom"},"Kit and caboodle":{"definition":"Toàn bộ, tất cả mọi thứ.","example":"I just bought a new computer, mouse, keyboard, and the whole kit and caboodle.","exampleTranslation":"Tôi vừa mua một chiếc máy tính mới, chuột, bàn phím và toàn bộ mọi thứ đi kèm.","partOfSpeech":"idiom"},"Knee-high to a grasshopper":{"definition":"Còn rất nhỏ, còn bé xíu.","example":"I've known her since she was knee-high to a grasshopper.","exampleTranslation":"Tôi biết cô ấy từ khi cô ấy còn bé tí.","partOfSpeech":"idiom"},"Knee-jerk reaction":{"definition":"Phản xạ tự nhiên, phản ứng thiếu suy nghĩ.","example":"Instead of having a knee-jerk reaction, take a moment to think it through.","exampleTranslation":"Thay vì phản ứng theo phản xạ, hãy dành một chút thời gian suy nghĩ kỹ.","partOfSpeech":"idiom"},"Knock it off":{"definition":"Thôi đi, dừng ngay lại.","example":"Hey, knock it off! I'm trying to concentrate.","exampleTranslation":"Này, dừng lại đi! Tôi đang cố tập trung.","partOfSpeech":"idiom"},"Knock on wood":{"definition":"Trộm vía (mong điều tốt đẹp hoặc tránh xui xẻo).","example":"I've never gotten a speeding ticket, knock on wood.","exampleTranslation":"Tôi chưa bao giờ bị phạt vì chạy quá tốc độ, cầu trời đừng xui.","partOfSpeech":"idiom"},"Knock someone's socks off":{"definition":"Gây ấn tượng mạnh mẽ với ai đó.","example":"Her presentation knocked everyone's socks off at the meeting.","exampleTranslation":"Bài thuyết trình của cô ấy khiến mọi người trong cuộc họp kinh ngạc.","partOfSpeech":"idiom"},"Knock something into a cocked hat":{"definition":"Đánh bại hoàn toàn, phá hỏng hoàn toàn.","example":"The new evidence knocked their theory into a cocked hat.","exampleTranslation":"Bằng chứng mới đã đánh bại hoàn toàn lý thuyết của họ.","partOfSpeech":"idiom"},"Know by sight":{"definition":"Biết mặt (nhưng không quen thân).","example":"I know him by sight, but we've never talked.","exampleTranslation":"Tôi biết mặt anh ấy, nhưng chúng tôi chưa bao giờ nói chuyện.","partOfSpeech":"idiom"},"Know one's onions":{"definition":"Rành rẽ, am hiểu tường tận.","example":"When it comes to digital marketing, she really knows her onions.","exampleTranslation":"Khi nói về tiếp thị kỹ thuật số, cô ấy thực sự rất am hiểu.","partOfSpeech":"idiom"},"know someone inside out":{"definition":"Hiểu ai tường tận từ trong ra ngoài, hiểu thấu tâm can ai.","example":"They have been best friends since childhood, so they know each other inside out.","exampleTranslation":"Họ là bạn thân từ thời thơ ấu, nên hiểu nhau tường tận.","partOfSpeech":"idiom"},"Know the ins and outs":{"definition":"Nắm rõ ngọn ngành, biết tường tận.","example":"She knows the ins and outs of the company's policy.","exampleTranslation":"Cô ấy biết rõ mọi ngóc ngách trong chính sách của công ty.","partOfSpeech":"idiom"},"Know the ropes":{"definition":"Nắm vững tình hình, biết cách làm việc.","example":"After a few weeks on the job, you'll start to know the ropes.","exampleTranslation":"Sau vài tuần làm việc, bạn sẽ bắt đầu quen với công việc.","partOfSpeech":"idiom"},"Know which way the wind is blowing":{"definition":"Nắm bắt tình hình, biết gió chiều nào che chiều ấy.","example":"Before making any big decisions, it's important to know which way the wind is blowing in the market.","exampleTranslation":"Trước khi đưa ra bất kỳ quyết định lớn nào, điều quan trọng là phải biết xu hướng của thị trường.","partOfSpeech":"idiom"},"Know zip":{"definition":"Không biết một tí gì.","example":"I know zip about repairing cars.","exampleTranslation":"Tôi chẳng biết gì về việc sửa xe.","partOfSpeech":"idiom"},"Knuckle under":{"definition":"Đầu hàng, chịu khuất phục.","example":"After hours of negotiation, he finally had to knuckle under and agree to the terms.","exampleTranslation":"Sau nhiều giờ đàm phán, cuối cùng anh ấy phải nhượng bộ và đồng ý với các điều khoản.","partOfSpeech":"idiom"},"Labor of love":{"definition":"Công việc làm vì đam mê.","example":"Writing her novel was a labor of love; she spent years perfecting it.","exampleTranslation":"Viết tiểu thuyết của cô ấy là công việc tâm huyết; cô ấy đã dành nhiều năm để hoàn thiện nó.","partOfSpeech":"idiom"},"Last but not least":{"definition":"Cuối cùng nhưng không kém phần quan trọng.","example":"And last but not least, I'd like to thank all the volunteers for their hard work.","exampleTranslation":"Và cuối cùng nhưng không kém phần quan trọng, tôi muốn cảm ơn tất cả các tình nguyện viên vì sự chăm chỉ của họ.","partOfSpeech":"idiom"},"last straw":{"definition":"Giọt nước tràn ly, điều cuối cùng khiến sự chịu đựng bùng nổ.","example":"When he arrived two hours late again, it was the last straw and she fired him.","exampleTranslation":"Khi anh ấy lại đến muộn hai tiếng, đó là giọt nước tràn ly và cô ấy đã sa thải anh ấy.","partOfSpeech":"idiom"},"Last-ditch effort":{"definition":"Nỗ lực cuối cùng, cố gắng vớt vát.","example":"In a last-ditch effort to save their home, they organized a fundraising event.","exampleTranslation":"Trong nỗ lực cuối cùng để cứu ngôi nhà của họ, họ tổ chức một sự kiện gây quỹ.","partOfSpeech":"idiom"},"Laugh all the way to the bank":{"definition":"Kiếm được món hời lớn một cách dễ dàng.","example":"After selling his startup, he was laughing all the way to the bank.","exampleTranslation":"Sau khi bán công ty khởi nghiệp của mình, anh ấy cười tít mắt vì kiếm được món lời lớn.","partOfSpeech":"idiom"},"Lay an egg":{"definition":"Thất bại thảm hại (thường trong biểu diễn hoặc ra mắt).","example":"The new product launch laid an egg; customers were not interested.","exampleTranslation":"Việc ra mắt sản phẩm mới đã thất bại; khách hàng không quan tâm.","partOfSpeech":"idiom"},"Lay down the law":{"definition":"Đặt ra luật lệ, ra oai.","example":"The boss had to lay down the law after too many employees started arriving late.","exampleTranslation":"Sếp phải đặt ra quy định nghiêm khắc sau khi quá nhiều nhân viên bắt đầu đến muộn.","partOfSpeech":"idiom"},"Lay someone off":{"definition":"Sa thải (vì lý do kinh tế, tổ chức lại).","example":"He was laid off last month because the company had to downsize.","exampleTranslation":"Anh ấy bị cho nghỉ việc vào tháng trước vì công ty phải cắt giảm nhân sự.","partOfSpeech":"idiom"},"Lead someone around by the nose":{"definition":"Xỏ mũi ai đó, dắt mũi ai đó.","example":"Don't let your boss lead you around by the nose; stand up for yourself.","exampleTranslation":"Đừng để sếp dắt mũi bạn; hãy tự bảo vệ mình.","partOfSpeech":"idiom"},"learn by heart":{"definition":"Học thuộc lòng.","example":"The students were required to learn the entire poem by heart.","exampleTranslation":"Học sinh được yêu cầu học thuộc lòng toàn bộ bài thơ.","partOfSpeech":"idiom"},"Learn by rote":{"definition":"Học vẹt, học thuộc lòng một cách máy móc.","example":"Students often learn mathematical formulas by rote without understanding the concepts.","exampleTranslation":"Học sinh thường học thuộc công thức toán học một cách máy móc mà không hiểu khái niệm.","partOfSpeech":"idiom"},"Learn one's lesson":{"definition":"Rút ra bài học, chừa đến già.","example":"After forgetting my ID, I learned my lesson and always double-check my bag before leaving.","exampleTranslation":"Sau khi quên chứng minh thư, tôi đã rút ra bài học và luôn kiểm tra kỹ túi trước khi ra ngoài.","partOfSpeech":"idiom"},"Learn the ropes":{"definition":"Học việc, làm quen với công việc.","example":"It will take a few weeks for the new intern to learn the ropes.","exampleTranslation":"Phải mất vài tuần thì thực tập sinh mới học được cách làm việc.","partOfSpeech":"idiom"},"Leave no stone unturned":{"definition":"Thử mọi cách, lật tung mọi thứ.","example":"The detectives promised to leave no stone unturned in their search for the missing girl.","exampleTranslation":"Các thám tử hứa sẽ không bỏ sót chi tiết nào trong cuộc tìm kiếm cô gái mất tích.","partOfSpeech":"idiom"},"Leave someone alone":{"definition":"Để ai đó yên.","example":"I need some time to think, so please leave me alone.","exampleTranslation":"Tôi cần chút thời gian để suy nghĩ, nên làm ơn để tôi yên.","partOfSpeech":"idiom"},"Leave someone high and dry":{"definition":"Bỏ mặc ai đó trong lúc khó khăn.","example":"He promised to help, but then he left me high and dry.","exampleTranslation":"Anh ấy hứa sẽ giúp, nhưng rồi lại bỏ mặc tôi bơ vơ.","partOfSpeech":"idiom"},"Leave someone in the lurch":{"definition":"Bỏ rơi ai đó trong lúc hoạn nạn.","example":"Just when I needed help most, he left me in the lurch.","exampleTranslation":"Đúng lúc tôi cần giúp đỡ nhất, anh ấy lại bỏ rơi tôi.","partOfSpeech":"idiom"},"Leave someone out in the cold":{"definition":"Ngó lơ ai đó, cho ai đó ra rìa.","example":"When the team decided to go ahead without him, he was left out in the cold.","exampleTranslation":"Khi cả nhóm quyết định tiến hành mà không có anh ấy, anh ấy bị bỏ rơi ngoài lề.","partOfSpeech":"idiom"},"Leave well enough alone":{"definition":"Tránh chữa lợn lành thành lợn què, cứ để yên mọi chuyện.","example":"The project is going smoothly, so let's just leave well enough alone.","exampleTranslation":"Dự án đang diễn ra suôn sẻ, nên hãy cứ để mọi thứ như vậy.","partOfSpeech":"idiom"},"Left behind":{"definition":"Bỏ lại phía sau, bỏ rơi.","example":"When they promoted the other employees, they left Mark behind.","exampleTranslation":"Khi họ thăng chức cho các nhân viên khác, họ đã bỏ lại Mark phía sau.","partOfSpeech":"idiom"},"Lend a hand":{"definition":"Giúp đỡ một tay.","example":"Could you lend me a hand with these groceries?","exampleTranslation":"Bạn có thể giúp tôi một tay với những túi hàng này không?","partOfSpeech":"idiom"},"Lend an ear":{"definition":"Lắng nghe, chú ý lắng nghe.","example":"Could you lend me your ear for a moment? I need to talk about something important.","exampleTranslation":"Bạn có thể dành cho tôi chút thời gian lắng nghe không? Tôi cần nói về một việc quan trọng.","partOfSpeech":"idiom"},"let by-gones be by-gones":{"definition":"Chuyện gì qua hãy để nó qua, bỏ qua chuyện cũ.","example":"They decided to let bygones be bygones and rebuild their long friendship.","exampleTranslation":"Họ quyết định bỏ qua chuyện cũ và xây dựng lại tình bạn lâu năm.","partOfSpeech":"idiom"},"Let bygones be bygones":{"definition":"Hãy để quá khứ ngủ yên, bỏ qua chuyện cũ.","example":"After their argument, they decided to let bygones be bygones and move on.","exampleTranslation":"Sau cuộc cãi vã, họ quyết định gác lại chuyện cũ và tiếp tục sống.","partOfSpeech":"idiom"},"Let sleeping dogs lie":{"definition":"Đừng bới bèo ra bọ, để mọi chuyện yên ổn.","example":"Let's not bring up that old argument again; it's better to just let sleeping dogs lie.","exampleTranslation":"Đừng nhắc lại cuộc tranh cãi cũ nữa; tốt hơn hết là đừng khơi lại chuyện cũ.","partOfSpeech":"idiom"},"Let someone off the hook":{"definition":"Tha lỗi cho ai đó, giải thoát ai đó khỏi trách nhiệm hoặc rắc rối.","example":"The teacher let him off the hook despite missing his homework.","exampleTranslation":"Giáo viên đã bỏ qua cho anh ấy dù anh ấy không làm bài tập về nhà.","partOfSpeech":"idiom"},"Let the cat out of the bag":{"definition":"Vô tình để lộ bí mật.","example":"Oops, I think I just let the cat out of the bag about her surprise party.","exampleTranslation":"Ôi, hình như tôi vừa lỡ miệng tiết lộ về bữa tiệc bất ngờ của cô ấy.","partOfSpeech":"idiom"},"Let the dust settle":{"definition":"Chờ cho mọi việc lắng xuống.","example":"Let's just wait for a while and let the dust settle before making any big decisions.","exampleTranslation":"Hãy cứ chờ một lúc và để mọi chuyện lắng xuống trước khi đưa ra bất kỳ quyết định lớn nào.","partOfSpeech":"idiom"},"Let your hair down":{"definition":"Thư giãn, xõa đi.","example":"After a long week of work, it's important to just let your hair down on the weekend.","exampleTranslation":"Sau một tuần làm việc dài, điều quan trọng là phải thả lỏng bản thân vào cuối tuần.","partOfSpeech":"idiom"},"Letter-perfect":{"definition":"Hoàn hảo, không sai một chữ.","example":"Her presentation was letter-perfect and impressed everyone in the meeting.","exampleTranslation":"Bài thuyết trình của cô ấy hoàn hảo từng chi tiết và gây ấn tượng với mọi người trong cuộc họp.","partOfSpeech":"idiom"},"Like a chicken with its head cut off":{"definition":"Lăng xăng, cuống cuồng như gà mắc tóc.","example":"He was running around like a chicken with its head cut off, trying to get everything ready for the party.","exampleTranslation":"Anh ấy chạy khắp nơi như gà mất đầu, cố gắng chuẩn bị mọi thứ cho bữa tiệc.","partOfSpeech":"idiom"},"Like a deer in the headlights":{"definition":"Chết trân, sững sờ (vì sợ hãi hoặc bất ngờ).","example":"Caught off guard by the news, she stood there like a deer in the headlights.","exampleTranslation":"Bị bất ngờ trước tin tức, cô đứng đó sững sờ như nai bị đèn pha chiếu vào.","partOfSpeech":"idiom"},"Like clockwork":{"definition":"Đều đặn, trơn tru như một cái máy.","example":"The train arrives at the station like clockwork every morning.","exampleTranslation":"Chuyến tàu đến nhà ga đúng giờ như đồng hồ mỗi sáng.","partOfSpeech":"idiom"},"like father like son":{"definition":"Cha nào con nấy, hổ phụ sinh hổ tử.","example":"He has the same sharp business sense as his dad—like father, like son!","exampleTranslation":"Anh ấy có nhạy bén kinh doanh sắc sảo giống bố mình — cha nào con nấy!","partOfSpeech":"idiom"},"Like nailing jello to a wall":{"definition":"Khó như mò kim đáy bể, việc bất khả thi.","example":"Getting my toddler to sit still is like nailing jello to a wall.","exampleTranslation":"Bắt đứa trẻ mới biết đi ngồi yên khó như đóng đinh vào thạch.","partOfSpeech":"idiom"},"Like pulling teeth":{"definition":"Khó khăn, cực nhọc (đặc biệt khi thuyết phục ai).","example":"Getting a straight answer from him is like pulling teeth.","exampleTranslation":"Có được câu trả lời rõ ràng từ anh ta khó như nhổ răng.","partOfSpeech":"idiom"},"Like riding a bike":{"definition":"Dễ như đi xe đạp, học một lần nhớ mãi.","example":"Programming is like riding a bike; you'll quickly get back into it.","exampleTranslation":"Lập trình giống như đi xe đạp; bạn sẽ nhanh chóng quen lại.","partOfSpeech":"idiom"},"Like taking candy from a baby":{"definition":"Dễ như ăn kẹo, dễ như trở bàn tay.","example":"For a professional chef, making this dish is like taking candy from a baby.","exampleTranslation":"Đối với đầu bếp chuyên nghiệp, làm món này dễ như trở bàn tay.","partOfSpeech":"idiom"},"Like there's no tomorrow":{"definition":"(Làm gì đó) như không có ngày mai, hết mình.","example":"They were spending money like there's no tomorrow during their vacation.","exampleTranslation":"Họ tiêu tiền như nước trong kỳ nghỉ của mình.","partOfSpeech":"idiom"},"Like water off a duck's back":{"definition":"Nước đổ đầu vịt.","example":"When they make fun of him, it's like water off a duck's back; he doesn't take it to heart.","exampleTranslation":"Khi họ chế giễu anh ấy, nó như nước đổ đầu vịt; anh ấy không để bụng.","partOfSpeech":"idiom"},"Live and learn":{"definition":"Đi một ngày đàng học một sàng khôn, sống qua mới biết.","example":"You thought you could fix the car yourself, but it broke down again. Live and learn.","exampleTranslation":"Bạn nghĩ có thể tự sửa xe, nhưng nó lại hỏng nữa. Sống và học hỏi thôi.","partOfSpeech":"idiom"},"Live and let live":{"definition":"Sống và để người khác sống, tôn trọng sự khác biệt.","example":"I don't always agree with my neighbors, but I believe in live and let live.","exampleTranslation":"Tôi không phải lúc nào cũng đồng ý với hàng xóm, nhưng tôi tin vào sống và để người khác sống.","partOfSpeech":"idiom"},"Live beyond your means":{"definition":"Tiêu xài hoang phí, vung tay quá trán.","example":"If you live beyond your means, you might end up in serious debt.","exampleTranslation":"Nếu bạn sống vượt quá khả năng, bạn có thể rơi vào nợ nần nghiêm trọng.","partOfSpeech":"idiom"},"Live hand-to-mouth":{"definition":"Sống chật vật qua ngày, kiếm đồng nào xào đồng ấy.","example":"After losing his job, he had to live hand-to-mouth.","exampleTranslation":"Sau khi mất việc, anh ấy phải sống chật vật ngày nào hay ngày đó.","partOfSpeech":"idiom"},"Live it up":{"definition":"Sống hết mình, ăn chơi xả láng.","example":"After winning the lottery, he decided to live it up and travel the world.","exampleTranslation":"Sau khi trúng số, anh ấy quyết định tận hưởng cuộc sống và du lịch khắp thế giới.","partOfSpeech":"idiom"},"live paycheck to paycheck":{"definition":"Sống chật vật qua ngày (lĩnh lương tháng nào tiêu hết tháng đó, không dư dả).","example":"With rising rent and inflation, many young workers are forced to live paycheck to paycheck.","exampleTranslation":"Với tiền thuê nhà và lạm phát tăng cao, nhiều người lao động trẻ buộc phải sống chật vật từng tháng.","partOfSpeech":"idiom"},"Living the dream":{"definition":"Sống cuộc đời trong mơ.","example":"Ever since he moved to Los Angeles to pursue acting, he's been living the dream.","exampleTranslation":"Kể từ khi chuyển đến Los Angeles để theo đuổi nghề diễn, anh ấy đang sống trong giấc mơ của mình.","partOfSpeech":"idiom"},"Lock, stock, and barrel":{"definition":"Toàn bộ, không thiếu thứ gì.","example":"They sold the business lock, stock, and barrel to a new owner.","exampleTranslation":"Họ đã bán toàn bộ công việc kinh doanh cho một chủ mới.","partOfSpeech":"idiom"},"Long in the tooth":{"definition":"Đã có tuổi, già nua.","example":"That computer model is getting a bit long in the tooth; it's time for an upgrade.","exampleTranslation":"Mẫu máy tính đó đã hơi cũ; đã đến lúc nâng cấp.","partOfSpeech":"idiom"},"Long time no see":{"definition":"Lâu rồi không gặp.","example":"Long time no see! How have you been?","exampleTranslation":"Lâu rồi không gặp! Dạo này bạn thế nào?","partOfSpeech":"idiom"},"Look before you leap":{"definition":"Phải suy nghĩ cẩn thận trước khi hành động, cẩn tắc vô áy náy.","example":"Before quitting your job, remember to look before you leap.","exampleTranslation":"Trước khi nghỉ việc, hãy nhớ suy nghĩ kỹ trước khi hành động.","partOfSpeech":"idiom"},"Look down one's nose":{"definition":"Khinh khỉnh, coi thường người khác.","example":"She tends to look down her nose at people who don't dress as well as she does.","exampleTranslation":"Cô ấy có xu hướng coi thường những người ăn mặc không đẹp bằng mình.","partOfSpeech":"idiom"},"look high and low":{"definition":"Tìm kiếm khắp nơi, lùng sục mọi xó xỉnh.","example":"I looked high and low for my car keys before finding them in my coat pocket.","exampleTranslation":"Tôi tìm khắp nơi chìa khóa xe trước khi thấy nó trong túi áo khoác.","partOfSpeech":"idiom"},"Look like a million bucks":{"definition":"Trông rất tuyệt vời, lộng lẫy.","example":"You look like a million bucks in that dress!","exampleTranslation":"Bạn trông thật tuyệt trong chiếc váy đó!","partOfSpeech":"idiom"},"look like death warmed over":{"definition":"Trông như xác chết trôi, phờ phạc rũ rượi.","example":"You should go see a doctor; you look like death warmed over.","exampleTranslation":"Bạn nên đi khám bác sĩ; trông bạn tệ như người chết.","partOfSpeech":"idiom"},"Look like the cat that got the cream":{"definition":"Trông vô cùng mãn nguyện, đắc ý.","example":"When she won the game, she looked like the cat that got the cream.","exampleTranslation":"Khi cô ấy thắng ván đó, trông cô ấy hả hê như chú mèo vớ được kem.","partOfSpeech":"idiom"},"look on the bright side":{"definition":"Nhìn vào mặt tích cực, lạc quan.","example":"Look on the bright side: at least the delay gave us time to finish our homework.","exampleTranslation":"Hãy nhìn vào mặt tích cực: ít nhất sự chậm trễ cho chúng ta thời gian hoàn thành bài tập.","partOfSpeech":"idiom"},"look the other way":{"definition":"Làm ngơ, quay mặt đi giả vờ không thấy chuyện xấu.","example":"Corrupt officials chose to look the other way while illegal dumping occurred.","exampleTranslation":"Các quan chức tham nhũng chọn cách làm ngơ trong khi việc đổ rác trái phép diễn ra.","partOfSpeech":"idiom"},"Lose one's head":{"definition":"Mất bình tĩnh, mất kiểm soát.","example":"I'm sorry I shouted at you; I just lost my head for a moment.","exampleTranslation":"Xin lỗi vì đã hét vào mặt bạn; tôi chỉ mất bình tĩnh trong chốc lát.","partOfSpeech":"idiom"},"Lose one's marbles":{"definition":"Mất trí, phát điên.","example":"She's been so stressed she feels like she's losing her marbles.","exampleTranslation":"Cô ấy căng thẳng đến mức cảm thấy mình sắp mất trí.","partOfSpeech":"idiom"},"Lose one's shirt":{"definition":"Mất sạch tiền, sạt nghiệp.","example":"Invest carefully, or you might lose your shirt in the stock market.","exampleTranslation":"Hãy đầu tư cẩn thận, nếu không bạn có thể mất sạch tiền trên thị trường chứng khoán.","partOfSpeech":"idiom"},"Lose one's touch":{"definition":"Lụt nghề, mất phong độ.","example":"I can't seem to bake cookies like I used to; I must have lost my touch.","exampleTranslation":"Dường như tôi không thể nướng bánh quy như trước; chắc tôi đã mất đi tay nghề.","partOfSpeech":"idiom"},"Lose touch":{"definition":"Mất liên lạc, mất kết nối.","example":"We used to be close friends, but we lost touch after college.","exampleTranslation":"Chúng tôi từng là bạn thân, nhưng đã mất liên lạc sau khi tốt nghiệp đại học.","partOfSpeech":"idiom"},"Lost at sea":{"definition":"Mất phương hướng, bơ vơ.","example":"Without proper guidance, many new employees feel lost at sea in their first week.","exampleTranslation":"Nếu không có sự hướng dẫn phù hợp, nhiều nhân viên mới cảm thấy lạc lối trong tuần đầu tiên.","partOfSpeech":"idiom"},"Low-hanging fruit":{"definition":"Mục tiêu dễ đạt được, việc dễ xơi.","example":"Let's focus on the low-hanging fruit before tackling the bigger issues.","exampleTranslation":"Hãy tập trung vào những việc dễ làm trước khi giải quyết các vấn đề lớn hơn.","partOfSpeech":"idiom"},"Luck out":{"definition":"Ăn may, gặp may mắn.","example":"We really lucked out with the weather during our trip.","exampleTranslation":"Chúng tôi thực sự may mắn với thời tiết trong chuyến đi.","partOfSpeech":"idiom"},"Mad as a hornet":{"definition":"Giận điên người, tức giận sôi máu.","example":"He was mad as a hornet when he found out someone had scratched his new car.","exampleTranslation":"Anh ấy giận sôi lên khi phát hiện ra ai đó đã làm xước chiếc xe mới của mình.","partOfSpeech":"idiom"},"Made for each other":{"definition":"Sinh ra là để cho nhau, tâm đầu ý hợp.","example":"The way they understand each other makes it clear they are truly made for each other.","exampleTranslation":"Cách họ hiểu nhau cho thấy rõ họ thực sự sinh ra là để dành cho nhau.","partOfSpeech":"idiom"},"Make a beeline for":{"definition":"Đi thẳng tới, lao thẳng đến.","example":"As soon as the meeting was over, she made a beeline for the exit.","exampleTranslation":"Ngay khi cuộc họp kết thúc, cô ấy đi thẳng đến lối ra.","partOfSpeech":"idiom"},"Make a big stink":{"definition":"Làm ầm lên, phàn nàn rùm beng.","example":"She made a big stink when her order was wrong, insisting on speaking to the manager.","exampleTranslation":"Cô ấy làm ầm ĩ khi đơn hàng bị sai, nhất quyết đòi gặp quản lý.","partOfSpeech":"idiom"},"Make a long story short":{"definition":"Nói tóm lại, tóm gọn lại.","example":"To make a long story short, we missed the flight but managed to get another one.","exampleTranslation":"Nói ngắn gọn, chúng tôi lỡ chuyến bay nhưng đã kiếm được chuyến khác.","partOfSpeech":"idiom"},"Make a mountain out of a molehill":{"definition":"Chuyện bé xé ra to.","example":"Don't make a mountain out of a molehill; it's just a minor mistake.","exampleTranslation":"Đừng làm chuyện bé xé ra to; đó chỉ là một lỗi nhỏ.","partOfSpeech":"idiom"},"Make a pit stop":{"definition":"Dừng chân nghỉ ngơi (giữa chuyến đi).","example":"We need to make a pit stop at the next gas station for a bathroom break.","exampleTranslation":"Chúng ta cần dừng lại ở trạm xăng tiếp theo để đi vệ sinh.","partOfSpeech":"idiom"},"make a point of":{"definition":"Để tâm, coi trọng và chú ý đặc biệt làm việc gì.","example":"He always makes a point of thanking each team member individually.","exampleTranslation":"Anh ấy luôn chú ý cảm ơn từng thành viên trong nhóm một cách riêng biệt.","partOfSpeech":"idiom"},"Make a scene":{"definition":"Làm ầm ĩ (nơi công cộng).","example":"Please don’t make a scene at the restaurant; let’s talk about it later.","exampleTranslation":"Làm ơn đừng làm ầm ĩ ở nhà hàng; chúng ta hãy nói chuyện này sau.","partOfSpeech":"idiom"},"Make ends meet":{"definition":"Kiếm đủ sống; xoay xở đủ chi tiêu.","example":"Many families struggle to make ends meet in today’s economy.","exampleTranslation":"Nhiều gia đình đang vật lộn để kiếm đủ sống trong nền kinh tế ngày nay.","partOfSpeech":"idiom"},"Make eyes at someone":{"definition":"Liếc mắt đưa tình; nhìn đắm đuối.","example":"I saw him making eyes at her during the meeting.","exampleTranslation":"Tôi thấy anh ấy liếc mắt đưa tình với cô ấy trong cuộc họp.","partOfSpeech":"idiom"},"Make hay while the sun shines":{"definition":"Chớp lấy thời cơ.","example":"You should apply for the job now before the position gets filled. Make hay while the sun shines.","exampleTranslation":"Bạn nên nộp đơn xin việc ngay bây giờ trước khi vị trí được lấp đầy. Hãy tranh thủ thời cơ.","partOfSpeech":"idiom"},"make heads or tails of":{"definition":"Hiểu đầu cua tai nheo gì (thường dùng ở dạng phủ định).","example":"I cannot make heads or tails of these complicated tax forms.","exampleTranslation":"Tôi không thể hiểu nổi những mẫu khai thuế phức tạp này.","partOfSpeech":"idiom"},"Make matters worse":{"definition":"Làm cho mọi chuyện tồi tệ hơn, họa vô đơn chí.","example":"We were caught in the rain, and to make matters worse, the car broke down.","exampleTranslation":"Chúng tôi bị mắc mưa, và tệ hơn nữa, xe bị hỏng.","partOfSpeech":"idiom"},"Make no bones about":{"definition":"Thẳng thắn; không ngần ngại giấu giếm.","example":"She made no bones about her decision to leave the company.","exampleTranslation":"Cô ấy thẳng thắn nói rõ quyết định rời công ty.","partOfSpeech":"idiom"},"Make one's hair stand on end":{"definition":"Dựng tóc gáy, vô cùng sợ hãi.","example":"The horror movie I watched last night made my hair stand on end.","exampleTranslation":"Bộ phim kinh dị tôi xem tối qua làm tôi dựng tóc gáy.","partOfSpeech":"idiom"},"Make out like a bandit":{"definition":"Trúng quả đậm; kiếm được bộn tiền.","example":"He made out like a bandit with the stock sale.","exampleTranslation":"Anh ấy kiếm được món lời lớn từ vụ bán cổ phiếu.","partOfSpeech":"idiom"},"Make out what someone says":{"definition":"Nghe rõ; hiểu được lời ai đó.","example":"I couldn’t make out what he said over the phone because of the poor connection.","exampleTranslation":"Tôi không thể nghe rõ anh ấy nói gì qua điện thoại vì kết nối kém.","partOfSpeech":"idiom"},"Make the grade":{"definition":"Đạt tiêu chuẩn; đủ điều kiện.","example":"She studied hard to make the grade in her final exams.","exampleTranslation":"Cô ấy đã học chăm chỉ để đạt yêu cầu trong kỳ thi cuối kỳ.","partOfSpeech":"idiom"},"Make tracks":{"definition":"Rời đi gấp gáp; chuồn nhanh.","example":"We need to make tracks if we want to catch the last train.","exampleTranslation":"Chúng ta cần đi nhanh nếu muốn kịp chuyến tàu cuối.","partOfSpeech":"idiom"},"make up for lost time":{"definition":"Bù đắp lại khoảng thời gian đã mất.","example":"Having not seen each other for years, the childhood friends talked all night to make up for lost time.","exampleTranslation":"Sau nhiều năm không gặp, những người bạn thời thơ ấu nói chuyện suốt đêm để bù lại thời gian đã mất.","partOfSpeech":"idiom"},"make up one's mind":{"definition":"Quyết định, đưa ra lựa chọn dứt khoát.","example":"She could not make up her mind about which university degree to pursue.","exampleTranslation":"Cô ấy không thể quyết định nên theo đuổi ngành học nào ở đại học.","partOfSpeech":"idiom"},"make up your mind":{"definition":"Đưa ra quyết định, dứt khoát quyết định.","example":"You need to make up your mind about which university course to attend.","exampleTranslation":"Bạn cần quyết định nên học khóa học nào ở đại học.","partOfSpeech":"idiom"},"Make waves":{"definition":"Gây sóng gió; tạo sự chú ý.","example":"Her controversial speech really made waves among the community.","exampleTranslation":"Bài phát biểu gây tranh cãi của cô ấy thực sự gây ra làn sóng dư luận trong cộng đồng.","partOfSpeech":"idiom"},"Make yourself at home":{"definition":"Cứ tự nhiên như ở nhà nhé.","example":"Please, make yourself at home. There’s no need to be formal.","exampleTranslation":"Xin cứ tự nhiên như ở nhà. Không cần phải khách sáo.","partOfSpeech":"idiom"},"Man's best friend":{"definition":"Người bạn tốt nhất của con người (thường chỉ chó).","example":"Dogs are often called man’s best friend because they are so loyal.","exampleTranslation":"Chó thường được gọi là người bạn thân nhất của con người vì chúng rất trung thành.","partOfSpeech":"idiom"},"Mark time":{"definition":"Dậm chân tại chỗ; chờ thời.","example":"I’ve been marking time at this job until I find something better.","exampleTranslation":"Tôi chỉ làm việc này cho qua ngày cho đến khi tìm được việc tốt hơn.","partOfSpeech":"idiom"},"match made in heaven":{"definition":"Cặp đôi trời sinh, sự kết hợp hoàn hảo.","example":"They share identical values and hobbies; they are truly a match made in heaven.","exampleTranslation":"Họ có chung giá trị và sở thích; họ thực sự là một cặp trời sinh.","partOfSpeech":"idiom"},"Meat and potatoes":{"definition":"Phần cốt lõi; phần cơ bản và quan trọng nhất.","example":"The meat and potatoes of the project involve data analysis and reporting.","exampleTranslation":"Phần cốt lõi của dự án liên quan đến phân tích dữ liệu và báo cáo.","partOfSpeech":"idiom"},"Meet halfway":{"definition":"Thỏa hiệp; nhượng bộ nhau.","example":"Let’s meet halfway on this issue and find a solution that works for both of us.","exampleTranslation":"Hãy nhượng bộ lẫn nhau về vấn đề này và tìm ra giải pháp phù hợp với cả hai chúng ta.","partOfSpeech":"idiom"},"Mickey Mouse job":{"definition":"Công việc nhàn hạ, lặt vặt (không quan trọng).","example":"I don’t want a Mickey Mouse job; I want something with real responsibility.","exampleTranslation":"Tôi không muốn một công việc tầm thường; tôi muốn một công việc có trách nhiệm thực sự.","partOfSpeech":"idiom"},"Midas touch":{"definition":"Bàn tay vàng (khả năng làm đâu thắng đó).","example":"He seems to have the Midas touch; every business he starts becomes a success.","exampleTranslation":"Anh ấy dường như có bàn tay vàng; mọi công việc kinh doanh anh ấy bắt đầu đều thành công.","partOfSpeech":"idiom"},"Middle of the road":{"definition":"Ở mức trung bình; không có gì nổi trội.","example":"The band’s new album is pretty middle of the road; it’s okay, but nothing special.","exampleTranslation":"Album mới của ban nhạc chỉ ở mức trung bình; cũng được, nhưng không có gì đặc biệt.","partOfSpeech":"idiom"},"Mind your own beeswax":{"definition":"Lo chuyện của mình đi; đừng chúi mũi vào chuyện người khác.","example":"When he kept asking about my personal life, I told him to mind his own beeswax.","exampleTranslation":"Khi anh ta cứ hỏi về đời tư của tôi, tôi bảo anh ta đừng xen vào chuyện của người khác.","partOfSpeech":"idiom"},"Miss the boat":{"definition":"Bỏ lỡ cơ hội.","example":"If we don’t act now, we might miss the boat on this great deal.","exampleTranslation":"Nếu chúng ta không hành động ngay bây giờ, chúng ta có thể lỡ mất cơ hội của thương vụ tuyệt vời này.","partOfSpeech":"idiom"},"Mom-and-pop":{"definition":"(Cửa hàng) kinh doanh nhỏ lẻ theo hộ gia đình.","example":"They decided to open a mom-and-pop grocery store in their neighborhood.","exampleTranslation":"Họ quyết định mở một cửa hàng tạp hóa gia đình nhỏ trong khu phố của mình.","partOfSpeech":"idiom"},"Money burns a hole in someone's pocket":{"definition":"Có tiền là tiêu liền; không giữ được tiền.","example":"As soon as he gets his paycheck, it’s gone. Money burns a hole in his pocket.","exampleTranslation":"Vừa nhận lương là anh ấy tiêu hết ngay. Tiền như cháy túi anh ấy.","partOfSpeech":"idiom"},"money doesn't grow on trees":{"definition":"Tiền bạc không phải là vỏ hến (tiền không tự nhiên sinh ra trên cây).","example":"Stop wasting your allowance on useless gadgets; money doesn't grow on trees!","exampleTranslation":"Đừng phí tiền tiêu vặt vào những thiết bị vô dụng nữa; tiền đâu mọc trên cây!","partOfSpeech":"idiom"},"Money talks":{"definition":"Đồng tiền có sức mạnh; có tiền mua tiên cũng được.","example":"When it comes to getting things done, money talks.","exampleTranslation":"Khi nói đến việc hoàn thành công việc, đồng tiền có sức mạnh.","partOfSpeech":"idiom"},"Money to burn":{"definition":"Tiền xài không hết; rủng rỉnh tiền bạc.","example":"Ever since he won the lottery, he’s had money to burn.","exampleTranslation":"Kể từ khi trúng số, anh ấy có tiền dư dả để tiêu.","partOfSpeech":"idiom"},"More bang for your buck":{"definition":"Đáng đồng tiền bát gạo.","example":"This restaurant gives you more bang for your buck compared to others in the area.","exampleTranslation":"Nhà hàng này mang lại nhiều giá trị hơn cho đồng tiền bỏ ra so với những nơi khác trong khu vực.","partOfSpeech":"idiom"},"More than meets the eye":{"definition":"Phức tạp hơn vẻ bề ngoài; ẩn chứa nhiều điều bên trong.","example":"The case seems simple, but there’s more than meets the eye.","exampleTranslation":"Vụ án có vẻ đơn giản, nhưng còn nhiều điều ẩn giấu hơn bề ngoài.","partOfSpeech":"idiom"},"More than one bargained for":{"definition":"Nằm ngoài dự kiến; rắc rối hơn dự tính.","example":"The new project turned out to be more than I bargained for.","exampleTranslation":"Dự án mới hóa ra khó hơn tôi dự tính.","partOfSpeech":"idiom"},"mother nature":{"definition":"Mẹ thiên nhiên, mẹ tạo hóa.","example":"Human beings must learn to respect Mother Nature before climate change gets worse.","exampleTranslation":"Con người phải học cách tôn trọng Mẹ Thiên nhiên trước khi biến đổi khí hậu trở nên tồi tệ hơn.","partOfSpeech":"idiom"},"Move some things around":{"definition":"Thay đổi lịch trình; sắp xếp lại kế hoạch.","example":"I need to move some things around to fit in the meeting tomorrow.","exampleTranslation":"Tôi cần sắp xếp lại một số việc để có thể dự cuộc họp vào ngày mai.","partOfSpeech":"idiom"},"Mum's the word":{"definition":"Giữ bí mật nhé.","example":"Remember, mum’s the word about the surprise party.","exampleTranslation":"Hãy nhớ giữ bí mật về bữa tiệc bất ngờ nhé.","partOfSpeech":"idiom"},"Mumbo jumbo":{"definition":"Lới nói lảm nhảm; biệt ngữ khó hiểu.","example":"All this technical mumbo jumbo is hard to understand.","exampleTranslation":"Tất cả những thuật ngữ kỹ thuật khó hiểu này thật khó nắm bắt.","partOfSpeech":"idiom"},"My bad":{"definition":"Lỗi của tôi.","example":"I forgot to bring the tickets. My bad.","exampleTranslation":"Tôi quên mang vé. Lỗi của tôi.","partOfSpeech":"idiom"},"Nest egg":{"definition":"Khoản tiền tiết kiệm phòng thân.","example":"She’s been saving a nest egg for her retirement.","exampleTranslation":"Cô ấy đã tiết kiệm một khoản tiền để dành cho lúc nghỉ hưu.","partOfSpeech":"idiom"},"Never bite the hand that feeds you":{"definition":"Đừng ăn cháo đá bát; đừng vong ơn bội nghĩa.","example":"He lost his job because he didn’t follow the rule: never bite the hand that feeds you.","exampleTranslation":"Anh ấy mất việc vì không tuân theo nguyên tắc: không bao giờ phản bội người đã giúp đỡ mình.","partOfSpeech":"idiom"},"never mind":{"definition":"Đừng bận tâm, không sao đâu, bỏ qua đi.","example":"If you cannot find my notebook, never mind; I have an extra one.","exampleTranslation":"Nếu bạn không tìm thấy vở của tôi thì thôi; tôi có một cuốn dự phòng.","partOfSpeech":"idiom"},"New kid on the block":{"definition":"Thành viên mới; lính mới.","example":"As the new kid on the block, she felt a bit overwhelmed at first.","exampleTranslation":"Là người mới đến, cô ấy cảm thấy hơi choáng ngợp lúc đầu.","partOfSpeech":"idiom"},"New York minute":{"definition":"Trong chớp mắt; một khoảnh khắc rất ngắn.","example":"In a New York minute, the deal was closed and they were out the door.","exampleTranslation":"Trong chớp mắt, thương vụ đã được chốt và họ rời đi.","partOfSpeech":"idiom"},"Night owl":{"definition":"Cú đêm (người hay thức khuya).","example":"I’ve always been a night owl, I get my best work done after midnight.","exampleTranslation":"Tôi luôn là cú đêm, tôi làm việc hiệu quả nhất sau nửa đêm.","partOfSpeech":"idiom"},"Nip something in the bud":{"definition":"Ngăn chặn từ đầu; dập tắt từ trong trứng nước.","example":"We need to nip this problem in the bud before it gets out of control.","exampleTranslation":"Chúng ta cần dập tắt vấn đề này ngay từ đầu trước khi nó vượt khỏi tầm kiểm soát.","partOfSpeech":"idiom"},"Nitty-gritty":{"definition":"Điểm mấu chốt; chi tiết cốt lõi.","example":"Let’s get down to the nitty-gritty of the project and figure out what needs to be done.","exampleTranslation":"Hãy đi vào chi tiết cốt lõi của dự án và tìm ra việc cần làm.","partOfSpeech":"idiom"},"Nix something":{"definition":"Hủy bỏ, bác bỏ, từ chối.","example":"The manager decided to nix the project due to budget constraints.","exampleTranslation":"Người quản lý quyết định hủy dự án do hạn chế về ngân sách.","partOfSpeech":"idiom"},"No big deal":{"definition":"Chuyện nhỏ; không có gì to tát.","example":"Don’t worry about the mistake; it’s no big deal.","exampleTranslation":"Đừng lo về sai sót đó; không có gì to tát.","partOfSpeech":"idiom"},"No dice":{"definition":"Không thành công; vô ích.","example":"I asked for a raise, but no dice.","exampleTranslation":"Tôi xin tăng lương, nhưng không được.","partOfSpeech":"idiom"},"No pain, no gain":{"definition":"Có làm thì mới có ăn; không đổ mồ hôi, không có thành quả.","example":"If you want to get fit, remember: No pain, no gain.","exampleTranslation":"Nếu bạn muốn có vóc dáng cân đối, hãy nhớ: không có gian khổ thì không có thành quả.","partOfSpeech":"idiom"},"No rhyme or reason":{"definition":"Không có lý do gì cả; chẳng có quy luật nào.","example":"There is no rhyme or reason to the way he organizes his desk.","exampleTranslation":"Cách anh ấy sắp xếp bàn làm việc chẳng có quy luật hay lý do gì cả.","partOfSpeech":"idiom"},"No skin off one's nose":{"definition":"Chẳng ảnh hưởng gì đến tôi cả, tôi không bận tâm.","example":"If he wants to leave the team, it's no skin off my nose.","exampleTranslation":"Nếu anh ấy muốn rời đội, tôi cũng chẳng bận tâm.","partOfSpeech":"idiom"},"No-brainer":{"definition":"Quyết định dễ dàng; chuyện hiển nhiên.","example":"Accepting that job offer was a no-brainer for me.","exampleTranslation":"Chấp nhận lời mời làm việc đó là quyết định không cần suy nghĩ đối với tôi.","partOfSpeech":"idiom"},"Not a spark of decency":{"definition":"Bất lịch sự; không có chút ý tứ nào.","example":"He shouted at the waiter and showed not a spark of decency.","exampleTranslation":"Anh ta quát nhân viên phục vụ và không có chút tử tế nào.","partOfSpeech":"idiom"},"Not have a leg to stand on":{"definition":"Không có lý lẽ vững chắc; không có bằng chứng, căn cứ để bào chữa hay chứng minh (trong một cuộc tranh luận).","example":"Without any proof, his accusations really don't have a leg to stand on.","exampleTranslation":"Không có bằng chứng, những lời buộc tội của anh ta thực sự không có căn cứ.","partOfSpeech":"idiom"},"Not one's cup of tea":{"definition":"Không phải sở thích của ai đó; không phải thứ ai đó quan tâm hay thích thú.","example":"Thank you for the invitation, but horror movies are not my cup of tea.","exampleTranslation":"Cảm ơn lời mời, nhưng phim kinh dị không phải gu của tôi.","partOfSpeech":"idiom"},"Not playing with a full deck":{"definition":"Thiếu thông minh, chập mạch, không bình thường.","example":"After hearing his bizarre theory, I started to think he’s not playing with a full deck.","exampleTranslation":"Sau khi nghe lý thuyết kỳ quặc của anh ta, tôi bắt đầu nghĩ anh ta không được bình thường.","partOfSpeech":"idiom"},"Not rocket science":{"definition":"Chẳng có gì phức tạp cả, không khó hiểu đâu.","example":"I don't understand why you're so confused; filing taxes isn't rocket science.","exampleTranslation":"Tôi không hiểu sao bạn lại bối rối đến vậy; khai thuế đâu có khó khăn gì.","partOfSpeech":"idiom"},"Not what it's cracked up to be":{"definition":"Không tốt như lời đồn; không giống như những gì được tâng bốc.","example":"The new restaurant is not what it's cracked up to be; the food was mediocre at best.","exampleTranslation":"Nhà hàng mới không được như lời đồn; đồ ăn chỉ ở mức tầm thường.","partOfSpeech":"idiom"},"Not worth a red cent":{"definition":"Hoàn toàn vô giá trị; không đáng một xu.","example":"This old phone is not worth a red cent.","exampleTranslation":"Chiếc điện thoại cũ này chẳng đáng một xu.","partOfSpeech":"idiom"},"Nothing to write home about":{"definition":"Bình thường, không có gì đặc sắc; không có gì đáng nói.","example":"The restaurant was okay, but the food was nothing to write home about.","exampleTranslation":"Nhà hàng cũng tạm được, nhưng đồ ăn chẳng có gì đáng nhắc đến.","partOfSpeech":"idiom"},"nuclear family":{"definition":"Gia đình hạt nhân (gia đình chỉ gồm cha mẹ và con cái).","example":"Modern urban society is largely built around the nuclear family structure.","exampleTranslation":"Xã hội đô thị hiện đại phần lớn được xây dựng xoay quanh cấu trúc gia đình hạt nhân.","partOfSpeech":"idiom"},"Number cruncher":{"definition":"Người chuyên làm việc với các con số; chuyên gia xử lý và phân tích dữ liệu số liệu.","example":"You need to be a good number cruncher to excel in a finance career.","exampleTranslation":"Bạn cần là người giỏi tính toán số liệu để xuất sắc trong sự nghiệp tài chính.","partOfSpeech":"idiom"},"Odd man out":{"definition":"Người hoặc vật lạc lõng, khác biệt so với phần còn lại của nhóm.","example":"He felt like the odd man out at the party because he didn't know anyone.","exampleTranslation":"Anh ấy cảm thấy lạc lõng trong bữa tiệc vì không quen ai.","partOfSpeech":"idiom"},"off color":{"definition":"Sắc mặt nhợt nhạt, trông có vẻ không được khỏe.","example":"You look a bit off color today; are you coming down with a flu?","exampleTranslation":"Hôm nay bạn trông hơi nhợt nhạt; bạn sắp bị cúm à?","partOfSpeech":"idiom"},"Off on the wrong foot":{"definition":"Bắt đầu một cách tồi tệ; có một sự khởi đầu không suôn sẻ (đặc biệt trong một mối quan hệ).","example":"They got off on the wrong foot during their first meeting and have been at odds since.","exampleTranslation":"Họ đã có khởi đầu không suôn sẻ trong lần gặp đầu tiên và từ đó luôn bất hòa.","partOfSpeech":"idiom"},"Off one's rocker":{"definition":"Bị điên, dở hơi, mất trí.","example":"Don’t listen to him, he’s off his rocker.","exampleTranslation":"Đừng nghe anh ta, anh ta điên rồi.","partOfSpeech":"idiom"},"Off the cuff":{"definition":"Tùy cơ ứng biến; nói hoặc làm một việc gì đó tự phát, không có sự chuẩn bị trước.","example":"He gave an off-the-cuff speech that impressed everyone.","exampleTranslation":"Anh ấy có bài phát biểu ứng khẩu khiến mọi người ấn tượng.","partOfSpeech":"idiom"},"Off the hook":{"definition":"Thoát khỏi trách nhiệm; thoát nạn hoặc không bị trừng phạt vì một lỗi lầm.","example":"He thought he would get in trouble for the mistake, but his boss let him off the hook.","exampleTranslation":"Anh ấy tưởng mình sẽ gặp rắc rối vì lỗi đó, nhưng sếp đã bỏ qua cho anh ấy.","partOfSpeech":"idiom"},"Off the record":{"definition":"Không chính thức; giữ kín, không được ghi âm, ghi chép hay công bố.","example":"He made it clear that his comments were strictly off the record.","exampleTranslation":"Anh ấy nói rõ rằng những lời bình luận của mình hoàn toàn không chính thức.","partOfSpeech":"idiom"},"Off the top of my head":{"definition":"Bật ra ngay trong đầu; theo những gì nhớ được ngay lúc này mà không cần suy nghĩ sâu xa hay kiểm tra lại.","example":"I can't remember the exact date off the top of my head, but it was sometime in June.","exampleTranslation":"Tôi không thể nhớ chính xác ngày ngay lúc này, nhưng đó là vào khoảng tháng Sáu.","partOfSpeech":"idiom"},"Off the wall":{"definition":"Kỳ quặc, khác thường; điên rồ nhưng đôi khi lại thú vị.","example":"His idea for the project was completely off the wall, but it actually worked!","exampleTranslation":"Ý tưởng của anh ấy cho dự án hoàn toàn kỳ quặc, nhưng thực sự lại có hiệu quả!","partOfSpeech":"idiom"},"Off-color":{"definition":"Khiếm nhã, thô tục; không phù hợp với chuẩn mực giao tiếp (thường chỉ những trò đùa cợt nhả).","example":"He was reprimanded for making an off-color joke in the office.","exampleTranslation":"Anh ấy bị khiển trách vì kể một câu chuyện cười thiếu tế nhị ở văn phòng.","partOfSpeech":"idiom"},"Old school":{"definition":"Kiểu cũ, cổ điển; theo phong cách hoặc giữ những giá trị truyền thống từ thời xưa.","example":"My grandfather is really old school; he doesn't trust modern technology.","exampleTranslation":"Ông tôi thực sự theo lối cũ; ông không tin vào công nghệ hiện đại.","partOfSpeech":"idiom"},"On a shoestring":{"definition":"Với ngân sách eo hẹp; làm gì đó với chi phí rất thấp.","example":"Starting a business on a shoestring is challenging but possible.","exampleTranslation":"Khởi nghiệp với số vốn ít ỏi rất khó nhưng vẫn có thể.","partOfSpeech":"idiom"},"On a tear":{"definition":"Đang trên đà chiến thắng; liên tục đạt được những thành công vang dội trong thời gian ngắn.","example":"The team has been on a tear lately, winning five games in a row.","exampleTranslation":"Gần đây đội đang trong cơn thăng hoa, thắng liền năm trận.","partOfSpeech":"idiom"},"On a treadmill":{"definition":"Làm những việc lặp đi lặp lại một cách nhàm chán mà không thấy sự tiến triển; giậm chân tại chỗ.","example":"I feel like I'm just on a treadmill with these endless meetings and no real results.","exampleTranslation":"Tôi cảm thấy mình như đang chạy trên máy chạy bộ với những cuộc họp bất tận mà không có kết quả thực sự.","partOfSpeech":"idiom"},"On cloud nine":{"definition":"Vô cùng hạnh phúc; sung sướng lâng lâng như trên chín tầng mây.","example":"She was on cloud nine after receiving the job offer.","exampleTranslation":"Cô ấy vui như lên chín tầng mây sau khi nhận được lời mời làm việc.","partOfSpeech":"idiom"},"on edge":{"definition":"Bồn chồn lo lắng, đứng ngồi không yên, dễ cáu kỉnh.","example":"Everyone in the office has been on edge while waiting for the company restructuring news.","exampleTranslation":"Mọi người trong văn phòng đều căng thẳng chờ tin tái cơ cấu công ty.","partOfSpeech":"idiom"},"On pins and needles":{"definition":"Lo lắng, bồn chồn; cảm giác đứng ngồi không yên khi chờ đợi một điều gì đó.","example":"She was on pins and needles waiting for the job interview results.","exampleTranslation":"Cô ấy hồi hộp như ngồi trên đống lửa chờ kết quả phỏng vấn xin việc.","partOfSpeech":"idiom"},"On the ball":{"definition":"Nhanh nhẹn, nhạy bén; phản ứng nhanh và xử lý tình huống tốt.","example":"She caught the mistake in the report right away; she's really on the ball.","exampleTranslation":"Cô ấy phát hiện lỗi trong báo cáo ngay lập tức; cô ấy thực sự rất nhanh nhạy.","partOfSpeech":"idiom"},"On the blink":{"definition":"Bị hỏng hóc, chập chờn; không hoạt động bình thường (thường dùng cho máy móc).","example":"The TV went on the blink just before the big game.","exampleTranslation":"Chiếc tivi bị hỏng ngay trước trận đấu lớn.","partOfSpeech":"idiom"},"On the cheap":{"definition":"Mua được với giá rẻ; làm việc gì đó với chi phí thấp nhất có thể.","example":"They traveled across the country on the cheap by staying in hostels.","exampleTranslation":"Họ đi du lịch khắp đất nước với chi phí thấp bằng cách ở nhà trọ.","partOfSpeech":"idiom"},"On the dot":{"definition":"Đúng giờ; chính xác tại một thời điểm đã định, không trễ một phút.","example":"The meeting will start at 9 a.m. on the dot.","exampleTranslation":"Cuộc họp sẽ bắt đầu đúng 9 giờ sáng.","partOfSpeech":"idiom"},"On the fence":{"definition":"Đang lưỡng lự; chưa đưa ra quyết định hoặc không đứng về phía nào.","example":"She's still on the fence about which university to attend.","exampleTranslation":"Cô ấy vẫn còn lưỡng lự chưa quyết định nên học đại học nào.","partOfSpeech":"idiom"},"On the fly":{"definition":"Tùy cơ ứng biến; đưa ra quyết định hoặc làm gì đó một cách nhanh chóng ngay tại thời điểm đó mà không có kế hoạch trước.","example":"We often have to solve problems on the fly at work.","exampleTranslation":"Chúng tôi thường phải giải quyết vấn đề ngay tại chỗ trong công việc.","partOfSpeech":"idiom"},"On the fritz":{"definition":"Bị hỏng hóc, dở chứng; thiết bị không hoạt động bình thường.","example":"The coffee machine in the office is on the fritz.","exampleTranslation":"Máy pha cà phê ở văn phòng đang bị hỏng.","partOfSpeech":"idiom"},"On the house":{"definition":"Miễn phí; được quán ăn, nhà hàng thiết đãi hoặc tặng (khách hàng không phải trả tiền).","example":"The dessert is on the house tonight because it's our anniversary celebration.","exampleTranslation":"Món tráng miệng tối nay được tặng miễn phí vì đó là lễ kỷ niệm của chúng tôi.","partOfSpeech":"idiom"},"On the level":{"definition":"Trung thực, thẳng thắn; đáng tin cậy và không có ý đồ gian lận.","example":"You can trust him; he's on the level.","exampleTranslation":"Bạn có thể tin anh ấy; anh ấy là người ngay thẳng.","partOfSpeech":"idiom"},"On the line":{"definition":"Bị đe dọa, gặp rủi ro; đang trong tình thế ngàn cân treo sợi tóc (danh tiếng, sự nghiệp, tính mạng).","example":"His job is on the line after the recent mistakes.","exampleTranslation":"Công việc của anh ta đang bị đe dọa sau những sai lầm gần đây.","partOfSpeech":"idiom"},"on the mend":{"definition":"Đang trên đà hồi phục, sức khỏe đang dần tiến triển tốt.","example":"Her fever has broken and she is finally on the mend.","exampleTranslation":"Cơn sốt của cô ấy đã hạ và cuối cùng cô ấy đang hồi phục.","partOfSpeech":"idiom"},"on the rocks":{"definition":"Rạn nứt, đứng trước bờ vực đổ vỡ (hôn nhân, quan hệ, kinh doanh).","example":"Their marriage has been on the rocks for months due to poor communication.","exampleTranslation":"Cuộc hôn nhân của họ đã trục trặc nhiều tháng vì thiếu giao tiếp.","partOfSpeech":"idiom"},"On the same page":{"definition":"Cùng chung quan điểm; hiểu ý nhau và nhất trí về một vấn đề.","example":"In order to ensure the project's success, we need to make sure everyone is on the same page.","exampleTranslation":"Để đảm bảo dự án thành công, chúng ta cần chắc chắn rằng mọi người đều đồng thuận.","partOfSpeech":"idiom"},"On the same wavelength":{"definition":"Bắt đúng tần số; Tâm đầu ý hợp","example":"The new manager and I are on the same wavelength about the project goals.","exampleTranslation":"Người quản lý mới và tôi có cùng quan điểm về mục tiêu của dự án.","partOfSpeech":"idiom"},"On the spot":{"definition":"Ngay lập tức, tại chỗ; bị đặt vào tình thế phải phản ứng hoặc quyết định ngay.","example":"He solved the problem on the spot without any help.","exampleTranslation":"Anh ấy giải quyết vấn đề ngay tại chỗ mà không cần ai giúp đỡ.","partOfSpeech":"idiom"},"On the spur of the moment":{"definition":"Hành động một cách bốc đồng; quyết định nhất thời, không suy tính trước.","example":"We decided to go on a trip on the spur of the moment.","exampleTranslation":"Chúng tôi quyết định đi du lịch một cách bất chợt.","partOfSpeech":"idiom"},"On the up and up":{"definition":"Trung thực, đàng hoàng; (hoặc) ngày càng trở nên tốt hơn, đang phát triển theo chiều hướng tốt.","example":"Our business is on the up and up after the new investments.","exampleTranslation":"Công việc kinh doanh của chúng tôi đang phát triển tốt sau những khoản đầu tư mới.","partOfSpeech":"idiom"},"On the warpath":{"definition":"Đang trong cơn thịnh nộ; sẵn sàng gây hấn hoặc trút giận lên người khác.","example":"Watch out, the boss is on the warpath today after the project failed.","exampleTranslation":"Cẩn thận, hôm nay sếp đang nổi giận sau khi dự án thất bại.","partOfSpeech":"idiom"},"On thin ice":{"definition":"Ở trong tình thế rủi ro, nguy hiểm; như đi trên lớp băng mỏng (chỉ cần một sai lầm nhỏ cũng dẫn đến hậu quả lớn).","example":"After missing several deadlines, John is really on thin ice with his boss.","exampleTranslation":"Sau khi lỡ nhiều hạn chót, John thực sự đang ở thế nguy hiểm với sếp.","partOfSpeech":"idiom"},"On top of the world":{"definition":"Cực kỳ hạnh phúc; cảm thấy như đang đứng trên đỉnh vinh quang.","example":"After getting the job offer, she felt on top of the world.","exampleTranslation":"Sau khi nhận được lời mời làm việc, cô ấy cảm thấy sung sướng như đứng trên đỉnh thế giới.","partOfSpeech":"idiom"},"Once and for all":{"definition":"Một lần và mãi mãi; giải quyết triệt để vấn đề để không bao giờ phải bận tâm lại.","example":"Let's settle this once and for all.","exampleTranslation":"Hãy giải quyết chuyện này một lần cho xong.","partOfSpeech":"idiom"},"Once bitten, twice shy":{"definition":"Chim phải đạn sợ cành cong; trở nên cẩn trọng, e dè sau khi đã trải qua một thất bại hoặc tổn thương.","example":"After getting scammed online, he is now once bitten, twice shy about shopping on unfamiliar websites.","exampleTranslation":"Sau khi bị lừa trên mạng, giờ anh ấy bị rắn cắn một lần, sợ dây thừng mười năm khi mua sắm trên các trang web lạ.","partOfSpeech":"idiom"},"Once in a blue moon":{"definition":"Năm thì mười họa; hiếm khi xảy ra.","example":"He only visits us once in a blue moon, but it's always a great time when he does.","exampleTranslation":"Anh ấy chỉ hiếm hoi mới ghé thăm chúng tôi, nhưng lần nào cũng rất vui.","partOfSpeech":"idiom"},"once upon a time":{"definition":"Ngày xửa ngày xưa.","example":"Once upon a time, there lived a humble woodcutter deep in an ancient enchanted forest.","exampleTranslation":"Ngày xửa ngày xưa, có một người tiều phu nghèo sống sâu trong khu rừng huyền bí cổ xưa.","partOfSpeech":"idiom"},"One fell swoop":{"definition":"Nhanh chóng trong một lần duy nhất; giải quyết gọn gàng trong một đợt.","example":"The company launched three new products in one fell swoop.","exampleTranslation":"Công ty đã ra mắt ba sản phẩm mới chỉ trong một lần.","partOfSpeech":"idiom"},"One-trick pony":{"definition":"Người hoặc vật chỉ có một tài năng, kỹ năng duy nhất; người chỉ giỏi một thứ mà không có sự linh hoạt.","example":"Some critics say that he's just a one-trick pony, only good at drama roles.","exampleTranslation":"Một số nhà phê bình nói rằng anh ấy chỉ có một chiêu, chỉ giỏi các vai kịch tính.","partOfSpeech":"idiom"},"One's eyes are bigger than one's stomach":{"definition":"No bụng đói con mắt.","example":"I thought I could finish the whole pizza, but my eyes were bigger than my stomach.","exampleTranslation":"Tôi tưởng mình có thể ăn hết cả chiếc pizza, nhưng mắt to hơn bụng.","partOfSpeech":"idiom"},"One's hands are tied":{"definition":"Bó tay; không thể làm gì được.","example":"I’d love to help, but my hands are tied due to company policy.","exampleTranslation":"Tôi rất muốn giúp, nhưng tôi bị ràng buộc bởi chính sách của công ty.","partOfSpeech":"idiom"},"One's neck of the woods":{"definition":"Khu vực ai đó sinh sống.","example":"Why don’t you come over to my neck of the woods this weekend?","exampleTranslation":"Cuối tuần này bạn đến khu vực của tôi chơi nhé?","partOfSpeech":"idiom"},"Open a can of worms":{"definition":"Rước họa vào thân; gây ra những rắc rối mới phức tạp khi cố giải quyết một vấn đề.","example":"Changing the project scope right now would open a can of worms.","exampleTranslation":"Thay đổi phạm vi dự án lúc này sẽ gây ra rất nhiều rắc rối.","partOfSpeech":"idiom"},"Out of date":{"definition":"Lỗi thời, cũ rích; không còn theo kịp xu hướng hoặc không còn được áp dụng.","example":"Using paper maps is pretty out of date now that we have GPS.","exampleTranslation":"Dùng bản đồ giấy giờ đã khá lỗi thời khi có GPS.","partOfSpeech":"idiom"},"Out of left field":{"definition":"Bất thình lình, bất ngờ; đến từ nơi không ai lường trước được.","example":"The new policy was completely out of left field and surprised everyone.","exampleTranslation":"Chính sách mới hoàn toàn bất ngờ và khiến mọi người ngạc nhiên.","partOfSpeech":"idiom"},"Out of my hands":{"definition":"Nằm ngoài tầm kiểm soát; không thuộc quyền quyết định hay trách nhiệm của mình nữa.","example":"The decision is out of my hands; it's up to the management now.","exampleTranslation":"Quyết định này nằm ngoài tầm tay tôi; giờ là việc của ban quản lý.","partOfSpeech":"idiom"},"Out of order":{"definition":"Bị hỏng, trục trặc (máy móc); hoặc cư xử không đúng mực.","example":"The elevator is out of order, so you'll have to take the stairs.","exampleTranslation":"Thang máy bị hỏng, nên bạn sẽ phải đi cầu thang bộ.","partOfSpeech":"idiom"},"out of shape":{"definition":"Thân hình mất cân đối, thể lực kém (do lười vận động).","example":"I got winded climbing just two flights of stairs—I am really out of shape.","exampleTranslation":"Tôi bị hụt hơi khi leo chỉ hai tầng cầu thang — tôi thực sự thiếu rèn luyện.","partOfSpeech":"idiom"},"out of sorts":{"definition":"Khó ở, cảm thấy không khỏe hoặc ủ rũ khó chịu.","example":"He has been out of sorts all morning because he did not get enough sleep.","exampleTranslation":"Cả buổi sáng anh ấy khó chịu vì không ngủ đủ.","partOfSpeech":"idiom"},"Out of the blue":{"definition":"Bất thình lình; hoàn toàn bất ngờ mà không có dấu hiệu báo trước.","example":"He called me out of the blue after five years of no contact.","exampleTranslation":"Anh ấy gọi cho tôi đột ngột sau năm năm không liên lạc.","partOfSpeech":"idiom"},"Out of the frying pan and into the fire":{"definition":"Tránh vỏ dưa gặp vỏ dừa; thoát khỏi một hoàn cảnh khó khăn này lại rơi vào một hoàn cảnh tồi tệ hơn.","example":"Leaving the bad restaurant, we ended up in a place even worse. Talk about out of the frying pan and into the fire.","exampleTranslation":"Rời khỏi nhà hàng tệ đó, chúng tôi lại vào một nơi còn tệ hơn. Đúng là chạy khỏi vực lại rơi xuống hố.","partOfSpeech":"idiom"},"Out of the question":{"definition":"Không thể được, không đáng bàn tới.","example":"Traveling abroad this year is out of the question given our budget.","exampleTranslation":"Du lịch nước ngoài năm nay là điều không thể do ngân sách của chúng tôi.","partOfSpeech":"idiom"},"Out of the woods":{"definition":"Thoát khỏi nguy hiểm, qua cơn nguy kịch.","example":"After months of treatment, the doctors finally said he was out of the woods.","exampleTranslation":"Sau nhiều tháng điều trị, cuối cùng các bác sĩ nói anh ấy đã qua cơn nguy hiểm.","partOfSpeech":"idiom"},"Out of this world":{"definition":"Tuyệt vời ông mặt trời, xuất sắc.","example":"The food at that restaurant is out of this world.","exampleTranslation":"Đồ ăn ở nhà hàng đó ngon tuyệt vời.","partOfSpeech":"idiom"},"Out on the town":{"definition":"Đi chơi đêm, ăn chơi xả láng trên phố.","example":"We’re going out on the town to celebrate my birthday tonight.","exampleTranslation":"Tối nay chúng tôi sẽ đi chơi ở thành phố để mừng sinh nhật của tôi.","partOfSpeech":"idiom"},"Out to lunch":{"definition":"Mơ màng, mất tập trung, đầu óc trên mây.","example":"During the meeting, he seemed completely out to lunch.","exampleTranslation":"Trong cuộc họp, anh ấy có vẻ hoàn toàn lơ đễnh.","partOfSpeech":"idiom"},"Outdo oneself":{"definition":"Vượt lên chính mình, làm tốt hơn mong đợi.","example":"She really outdid herself with this year's presentation.","exampleTranslation":"Cô ấy thực sự vượt qua chính mình với bài thuyết trình năm nay.","partOfSpeech":"idiom"},"Over my dead body":{"definition":"Bước qua xác tôi trước đã, không bao giờ.","example":"You want to drop out of school? Over my dead body.","exampleTranslation":"Bạn muốn bỏ học à? Bước qua xác tôi đã.","partOfSpeech":"idiom"},"over the moon":{"definition":"Vui sướng tột cùng, ngập tràn hạnh phúc.","example":"She was over the moon when she found out she had won the scholarship.","exampleTranslation":"Cô ấy vui như trên mây khi biết mình đã giành được học bổng.","partOfSpeech":"idiom"},"Packed like sardines":{"definition":"Chật như nêm, đông nghẹt.","example":"The subway was packed like sardines during rush hour.","exampleTranslation":"Tàu điện ngầm chật cứng như cá mòi trong giờ cao điểm.","partOfSpeech":"idiom"},"Paddle your own canoe":{"definition":"Tự lực cánh sinh, tự đứng trên đôi chân của mình.","example":"After graduating from college, he decided to paddle his own canoe and start his own business.","exampleTranslation":"Sau khi tốt nghiệp đại học, anh ấy quyết định tự lập và khởi nghiệp.","partOfSpeech":"idiom"},"Pain in the neck":{"definition":"Cái gai trong mắt, thứ phiền toái.","example":"Filling out all this paperwork is a pain in the neck.","exampleTranslation":"Điền hết đống giấy tờ này thật phiền phức.","partOfSpeech":"idiom"},"Paint the town red":{"definition":"Đi quẩy tưng bừng, ăn chơi xả láng.","example":"After finishing the project, they decided to paint the town red to celebrate.","exampleTranslation":"Sau khi hoàn thành dự án, họ quyết định ăn mừng ăn chơi thỏa thích.","partOfSpeech":"idiom"},"Paint you a picture":{"definition":"Miêu tả chi tiết, vẽ nên viễn cảnh.","example":"Let me paint you a picture of what happened at the party last night.","exampleTranslation":"Để tôi kể bạn nghe chuyện gì đã xảy ra ở bữa tiệc tối qua.","partOfSpeech":"idiom"},"pale as a ghost":{"definition":"Mặt mày tái mét như ma (do quá sợ hãi, sốc hoặc ốm nặng).","example":"When he heard the shocking news, his face turned as pale as a ghost.","exampleTranslation":"Khi nghe tin gây sốc, mặt anh ấy tái nhợt như ma.","partOfSpeech":"idiom"},"Pandora’s box":{"definition":"Chiếc hộp Pandora, nguồn gốc của rắc rối.","example":"Opening that old argument is like opening Pandora’s box; it will only lead to more trouble.","exampleTranslation":"Khơi lại cuộc tranh cãi cũ giống như mở chiếc hộp Pandora; nó chỉ dẫn đến thêm rắc rối.","partOfSpeech":"idiom"},"Par for the course":{"definition":"Chuyện bình thường, đúng như dự đoán.","example":"Traffic jams are par for the course during rush hour in the city.","exampleTranslation":"Kẹt xe là chuyện thường tình vào giờ cao điểm ở thành phố.","partOfSpeech":"idiom"},"Party animal":{"definition":"Người nghiện tiệc tùng, dân quẩy.","example":"John is such a party animal; he’s out every weekend.","exampleTranslation":"John đúng là người mê tiệc tùng; cuối tuần nào anh ấy cũng ra ngoài.","partOfSpeech":"idiom"},"Pass the buck":{"definition":"Đùn đẩy trách nhiệm.","example":"The manager was known to pass the buck whenever something went wrong.","exampleTranslation":"Người quản lý nổi tiếng hay đùn đẩy trách nhiệm mỗi khi có chuyện không hay.","partOfSpeech":"idiom"},"Pass the course":{"definition":"Vượt qua khóa học, thi đậu.","example":"She studied really hard and finally passed the course with flying colors.","exampleTranslation":"Cô ấy đã học rất chăm chỉ và cuối cùng đã đạt môn học với kết quả xuất sắc.","partOfSpeech":"idiom"},"pass with flying colors":{"definition":"Đậu xuất sắc, vượt qua kỳ thi với kết quả rực rỡ.","example":"He studied diligently every evening and passed the bar exam with flying colors.","exampleTranslation":"Anh ấy học chăm chỉ mỗi buổi tối và đã vượt qua kỳ thi luật sư với kết quả xuất sắc.","partOfSpeech":"idiom"},"Pay a pretty penny":{"definition":"Trả một khoản tiền lớn, tốn kha khá tiền.","example":"He paid a pretty penny for that vintage car.","exampleTranslation":"Anh ấy đã trả một khoản tiền khá lớn cho chiếc xe cổ đó.","partOfSpeech":"idiom"},"Pay an arm and a leg":{"definition":"Trả một cái giá cắt cổ, tốn rất nhiều tiền.","example":"He had to pay an arm and a leg for that rare book.","exampleTranslation":"Anh ấy đã phải trả giá rất đắt cho cuốn sách hiếm đó.","partOfSpeech":"idiom"},"Pay the piper":{"definition":"Gánh chịu hậu quả, trả giá.","example":"After years of ignoring his health, he had to pay the piper with a long hospital stay.","exampleTranslation":"Sau nhiều năm bỏ bê sức khỏe, anh ấy phải trả giá bằng một đợt nằm viện dài.","partOfSpeech":"idiom"},"Pay through the nose":{"definition":"Bị chặt chém, phải trả giá trên trời.","example":"We had to pay through the nose for those concert tickets.","exampleTranslation":"Chúng tôi đã phải trả giá cắt cổ cho những chiếc vé hòa nhạc đó.","partOfSpeech":"idiom"},"peanut gallery":{"definition":"Hàng ghế khán giả nhiều chuyện, những kẻ chõ mồm bình phẩm vô bổ.","example":"I do not need any unsolicited advice from the peanut gallery while I am fixing this engine.","exampleTranslation":"Tôi không cần những lời khuyên không ai yêu cầu từ đám người chỉ đứng ngoài bình phẩm khi tôi đang sửa động cơ.","partOfSpeech":"idiom"},"Pedal to the metal":{"definition":"Tăng tốc tối đa, nỗ lực hết mình.","example":"We need to put the pedal to the metal to meet the deadline.","exampleTranslation":"Chúng ta cần tăng tốc hết cỡ để kịp hạn chót.","partOfSpeech":"idiom"},"Peg out":{"definition":"Lăn ra chết, kiệt sức.","example":"He suddenly pegged out during dinner last night.","exampleTranslation":"Anh ta đột ngột qua đời trong bữa tối tối qua.","partOfSpeech":"idiom"},"Pencil pusher":{"definition":"Nhân viên bàn giấy, người làm công việc giấy tờ nhàm chán.","example":"He’s just a pencil pusher who files reports all day.","exampleTranslation":"Anh ta chỉ là nhân viên văn phòng quèn suốt ngày lập báo cáo.","partOfSpeech":"idiom"},"People in glass houses shouldn't throw stones":{"definition":"Chó chê mèo lắm lông; Đừng chỉ trích người khác khi mình cũng có lỗi","example":"You shouldn’t insult others about their behavior; those who live in glass houses shouldn’t throw stones.","exampleTranslation":"Bạn không nên chê bai hành vi của người khác; người sống trong nhà kính đừng ném đá.","partOfSpeech":"idiom"},"Peter out":{"definition":"Giảm dần rồi mất hẳn, đuối dần.","example":"The excitement over the new game began to peter out after a few weeks.","exampleTranslation":"Sự hào hứng với trò chơi mới bắt đầu giảm dần sau vài tuần.","partOfSpeech":"idiom"},"Pick up the tab":{"definition":"Trả tiền hóa đơn, bao (ăn uống).","example":"I will pick up the tab for dinner tonight.","exampleTranslation":"Tối nay tôi sẽ trả tiền bữa tối.","partOfSpeech":"idiom"},"picture of health":{"definition":"Người trông vô cùng khỏe khoắn, tràn đầy sinh lực.","example":"At the age of eighty, he exercises daily and is the very picture of health.","exampleTranslation":"Ở tuổi tám mươi, ông ấy tập thể dục hàng ngày và là hình ảnh của sức khỏe.","partOfSpeech":"idiom"},"Pie in the sky":{"definition":"Viển vông, hão huyền.","example":"His dream of becoming a movie star seems like a pie in the sky.","exampleTranslation":"Giấc mơ trở thành ngôi sao điện ảnh của anh ấy dường như chỉ là ảo tưởng viển vông.","partOfSpeech":"idiom"},"Pig out":{"definition":"Ăn thùng uống vại, ăn thỏa thích.","example":"We decided to pig out on pizza at the party.","exampleTranslation":"Chúng tôi quyết định ăn pizza thỏa thích trong bữa tiệc.","partOfSpeech":"idiom"},"Pigheaded":{"definition":"Cứng đầu, ngoan cố.","example":"He’s so pigheaded that he refused to listen to anyone’s suggestions.","exampleTranslation":"Anh ta cứng đầu đến mức từ chối lắng nghe đề xuất của bất kỳ ai.","partOfSpeech":"idiom"},"Pipe down":{"definition":"Im lặng, trật tự đi.","example":"Can you two please pipe down? I’m trying to concentrate.","exampleTranslation":"Hai bạn có thể im lặng được không? Tôi đang cố tập trung.","partOfSpeech":"idiom"},"Pipe dream":{"definition":"Mộng tưởng hão huyền, giấc mơ viển vông.","example":"Thinking you can become a billionaire overnight is a pipe dream.","exampleTranslation":"Nghĩ rằng bạn có thể trở thành tỷ phú qua đêm là một giấc mơ viển vông.","partOfSpeech":"idiom"},"Pitch dark":{"definition":"Tối đen như mực.","example":"It was pitch dark outside, so we could barely see anything.","exampleTranslation":"Ngoài kia tối đen như mực, nên chúng tôi hầu như không thấy gì.","partOfSpeech":"idiom"},"Pitch in":{"definition":"Cùng xắn tay vào làm, góp sức.","example":"Let’s all pitch in and clean up the park.","exampleTranslation":"Hãy cùng nhau góp sức dọn dẹp công viên.","partOfSpeech":"idiom"},"Play catch-up":{"definition":"Cố gắng đuổi kịp, bù đắp thời gian","example":"After taking a few days off, he found himself playing catch-up at work.","exampleTranslation":"Sau khi nghỉ vài ngày, anh ấy thấy mình phải làm việc để bắt kịp tiến độ.","partOfSpeech":"idiom"},"Play devil’s advocate":{"definition":"Đóng vai ác, người phản biện.","example":"I’ll play devil’s advocate and argue that we should consider other options.","exampleTranslation":"Tôi sẽ đóng vai phản biện và lập luận rằng chúng ta nên xem xét các lựa chọn khác.","partOfSpeech":"idiom"},"Play dumb":{"definition":"Giả ngu, giả vờ không biết.","example":"Don’t play dumb with me; I know you saw everything.","exampleTranslation":"Đừng giả ngốc với tôi; tôi biết bạn đã thấy hết mọi thứ.","partOfSpeech":"idiom"},"Play hardball":{"definition":"Dùng biện pháp mạnh, chơi rắn.","example":"The company decided to play hardball in the negotiations to get better terms.","exampleTranslation":"Công ty quyết định cứng rắn trong đàm phán để có điều khoản tốt hơn.","partOfSpeech":"idiom"},"Play it by ear":{"definition":"Tùy cơ ứng biến.","example":"We don’t have a strict itinerary for the trip; we’ll just play it by ear.","exampleTranslation":"Chúng tôi không có lịch trình chặt chẽ cho chuyến đi; chúng tôi sẽ tùy cơ ứng biến.","partOfSpeech":"idiom"},"Play second fiddle":{"definition":"Đóng vai phụ, ở vị thế thấp hơn.","example":"I’m tired of always playing second fiddle to him at work.","exampleTranslation":"Tôi chán việc luôn đóng vai phụ trước anh ta ở nơi làm việc.","partOfSpeech":"idiom"},"Play with fire":{"definition":"Đùa với lửa.","example":"She’s playing with fire by investing all her money in that risky venture.","exampleTranslation":"Cô ấy đang chơi với lửa khi đầu tư toàn bộ tiền vào dự án rủi ro đó.","partOfSpeech":"idiom"},"Poker face":{"definition":"Khuôn mặt lạnh tanh, không bộc lộ cảm xúc.","example":"She maintained a perfect poker face throughout the negotiations.","exampleTranslation":"Cô ấy giữ vẻ mặt lạnh lùng không để lộ cảm xúc trong suốt cuộc đàm phán.","partOfSpeech":"idiom"},"Pony up":{"definition":"Móc hầu bao, thanh toán.","example":"It's time for everyone to pony up and pay their share of the meal.","exampleTranslation":"Đã đến lúc mọi người phải bỏ tiền ra trả phần của mình cho bữa ăn.","partOfSpeech":"idiom"},"Pound the pavement":{"definition":"Rảo bước tìm việc, đi bộ khắp nơi.","example":"After losing his job, he spent weeks pounding the pavement, looking for new opportunities.","exampleTranslation":"Sau khi mất việc, anh ấy dành nhiều tuần lang thang khắp nơi để tìm cơ hội mới.","partOfSpeech":"idiom"},"pour money down the drain":{"definition":"Ném tiền qua cửa sổ, phung phí tiền bạc vô ích.","example":"Investing in that outdated technology is just pouring money down the drain.","exampleTranslation":"Đầu tư vào công nghệ lỗi thời đó chỉ là ném tiền qua cửa sổ.","partOfSpeech":"idiom"},"Power dressing":{"definition":"Trang phục quyền lực, ăn mặc thể hiện uy quyền.","example":"She believes in power dressing to make a strong impression during business meetings.","exampleTranslation":"Cô ấy tin vào việc ăn mặc quyền lực để tạo ấn tượng mạnh trong các cuộc họp kinh doanh.","partOfSpeech":"idiom"},"practice makes perfect":{"definition":"Có công mài sắt có ngày nên kim; luyện tập tạo nên sự hoàn hảo.","example":"Do not get discouraged by early mistakes; remember that practice makes perfect.","exampleTranslation":"Đừng nản lòng vì những sai lầm ban đầu; hãy nhớ rằng có công mài sắt có ngày nên kim.","partOfSpeech":"idiom"},"Prick up your ears":{"definition":"Dỏng tai lên nghe.","example":"When the teacher said there would be a surprise quiz, everyone pricked up their ears.","exampleTranslation":"Khi giáo viên nói sẽ có bài kiểm tra bất ngờ, mọi người đều vểnh tai lên.","partOfSpeech":"idiom"},"pride and joy":{"definition":"Niềm tự hào và nguồn vui lớn nhất.","example":"That restored vintage sports car is his absolute pride and joy.","exampleTranslation":"Chiếc xe thể thao cổ được phục chế đó là niềm tự hào và niềm vui lớn nhất của anh ấy.","partOfSpeech":"idiom"},"Pride comes before a fall":{"definition":"Trèo cao ngã đau.","example":"He boasted about winning the game, but pride comes before a fall - he ended up losing badly.","exampleTranslation":"Anh ta khoe khoang về chiến thắng, nhưng kiêu ngạo ắt có ngày thất bại - anh ta đã thua đậm.","partOfSpeech":"idiom"},"pull a rabbit out of one's hat":{"definition":"Bất ngờ tìm ra giải pháp, làm chuyện không tưởng","example":"When the company was on the verge of bankruptcy, the CEO pulled a rabbit out of his hat and secured a major investor.","exampleTranslation":"Khi công ty đứng bên bờ vực phá sản, CEO đã tạo ra một bất ngờ và thu hút được nhà đầu tư lớn.","partOfSpeech":"idiom"},"Pull it off":{"definition":"Hoàn thành xuất sắc, làm được chuyện khó nhằn.","example":"Despite all the challenges, they managed to pull it off and win the championship.","exampleTranslation":"Bất chấp mọi thử thách, họ đã làm được và giành chức vô địch.","partOfSpeech":"idiom"},"Pull one's weight":{"definition":"Làm tròn bổn phận, làm phần việc của mình.","example":"In this project, everyone needs to pull their own weight to meet the deadline.","exampleTranslation":"Trong dự án này, mọi người đều cần làm tròn phần việc của mình để kịp hạn chót.","partOfSpeech":"idiom"},"pull oneself together":{"definition":"Bình tĩnh lại, kiềm chế cảm xúc","example":"She had a good cry but then decided to pull herself together and face the problem head-on.","exampleTranslation":"Cô ấy khóc một trận thỏa thích rồi quyết định lấy lại bình tĩnh và đối mặt trực diện với vấn đề.","partOfSpeech":"idiom"},"Pull out all the stops":{"definition":"Nỗ lực hết mình, làm mọi cách.","example":"We need to pull out all the stops to finish this project on time.","exampleTranslation":"Chúng ta cần dốc toàn lực để hoàn thành dự án này đúng hạn.","partOfSpeech":"idiom"},"Pull rank":{"definition":"Cậy quyền thế, lấy quyền ép người.","example":"He always tries to pull rank to get his way in the office.","exampleTranslation":"Anh ta luôn cố dùng cấp bậc để đạt được điều mình muốn ở văn phòng.","partOfSpeech":"idiom"},"pull someone's chain":{"definition":"Trêu chọc, đùa cợt ai đó","example":"I can’t believe you fell for that! He was just pulling your chain.","exampleTranslation":"Tôi không thể tin bạn lại mắc lừa! Anh ta chỉ trêu bạn thôi.","partOfSpeech":"idiom"},"pull someone's leg":{"definition":"Trêu đùa, nói giỡn với ai đó","example":"He said there was a ghost in the attic, but I think he’s just pulling my leg.","exampleTranslation":"Anh ta nói có ma trên gác mái, nhưng tôi nghĩ anh ta chỉ đang trêu tôi thôi.","partOfSpeech":"idiom"},"Pull someone’s leg":{"definition":"Trêu chọc, nói đùa.","example":"I thought he was serious, but he was just pulling my leg.","exampleTranslation":"Tôi tưởng anh ấy nghiêm túc, nhưng anh ấy chỉ trêu tôi.","partOfSpeech":"idiom"},"Pull strings":{"definition":"Giật dây, dùng các mối quan hệ (để có lợi thế).","example":"She managed to pull strings and get her son into that prestigious school.","exampleTranslation":"Cô ấy đã dùng quan hệ để đưa con trai vào ngôi trường danh tiếng đó.","partOfSpeech":"idiom"},"Pull the plug":{"definition":"Rút phích cắm, chấm dứt dự án.","example":"After years of poor sales, the company decided to pull the plug on the project.","exampleTranslation":"Sau nhiều năm doanh số kém, công ty quyết định dừng dự án.","partOfSpeech":"idiom"},"pull the rug out from under someone":{"definition":"Đột ngột ngừng hỗ trợ, hất cẳng ai đó","example":"My boss pulled the rug out from under me by canceling the project without notice.","exampleTranslation":"Sếp tôi đột ngột hủy dự án mà không báo trước, khiến tôi mất chỗ dựa.","partOfSpeech":"idiom"},"Pull the wool over someone's eyes":{"definition":"Che mắt, qua mặt ai đó.","example":"Don’t let the salesman pull the wool over your eyes with that fake discount.","exampleTranslation":"Đừng để người bán hàng lừa bạn bằng đợt giảm giá giả đó.","partOfSpeech":"idiom"},"pull up stakes":{"definition":"Rời đi, chuyển chỗ ở","example":"After living in the city for ten years, they decided it was time to pull up stakes and move to the countryside.","exampleTranslation":"Sau mười năm sống ở thành phố, họ quyết định đã đến lúc chuyển về nông thôn.","partOfSpeech":"idiom"},"pull your weight":{"definition":"Làm tròn trách nhiệm, gánh vác phần việc của mình trong nhóm.","example":"Everyone in the group project must pull their weight to get a high grade.","exampleTranslation":"Mọi người trong dự án nhóm phải làm tròn phần việc của mình để đạt điểm cao.","partOfSpeech":"idiom"},"puppy love":{"definition":"Tình yêu tuổi học trò, tình cảm bồng bột","example":"Their relationship in high school was just puppy love, but it felt very real at the time.","exampleTranslation":"Mối quan hệ của họ thời trung học chỉ là tình yêu trẻ con, nhưng lúc đó cảm thấy rất thật.","partOfSpeech":"idiom"},"push one's luck":{"definition":"Làm tới, đòi hỏi quá đáng","example":"You’ve won three games in a row. Don’t push your luck and quit while you’re ahead.","exampleTranslation":"Bạn đã thắng ba ván liên tiếp. Đừng thử vận may quá nhiều và hãy dừng lại khi còn đang dẫn trước.","partOfSpeech":"idiom"},"put a sock in it":{"definition":"Im miệng đi, bớt nói lại","example":"Hey, put a sock in it! We’re trying to watch the movie.","exampleTranslation":"Này, im đi! Chúng tôi đang cố xem phim.","partOfSpeech":"idiom"},"put on one's thinking cap":{"definition":"Tập trung suy nghĩ, vắt óc suy nghĩ","example":"Let’s all put on our thinking caps and come up with some creative ideas for the project.","exampleTranslation":"Hãy cùng nhau suy nghĩ và đưa ra vài ý tưởng sáng tạo cho dự án.","partOfSpeech":"idiom"},"put one's finger on it":{"definition":"Chỉ ra chính xác (vấn đề, nguyên nhân)","example":"There’s something not quite right, but I can’t put my finger on it.","exampleTranslation":"Có điều gì đó không ổn, nhưng tôi không thể chỉ ra chính xác là gì.","partOfSpeech":"idiom"},"put one's foot down":{"definition":"Kiên quyết phản đối, tỏ thái độ dứt khoát","example":"She had to put her foot down when her kids asked for ice cream before dinner.","exampleTranslation":"Cô ấy phải kiên quyết khi các con đòi ăn kem trước bữa tối.","partOfSpeech":"idiom"},"put one's money where one's mouth is":{"definition":"Nói đi đôi với làm (nhất là bằng tiền bạc)","example":"If you really believe in this project, you should put your money where your mouth is and invest in it.","exampleTranslation":"Nếu bạn thực sự tin vào dự án này, bạn nên nói đi đôi với làm và đầu tư vào đó.","partOfSpeech":"idiom"},"put our heads together":{"definition":"Cùng nhau suy nghĩ, hội ý","example":"We need to put our heads together to come up with a solution for this issue.","exampleTranslation":"Chúng ta cần cùng nhau suy nghĩ để tìm ra giải pháp cho vấn đề này.","partOfSpeech":"idiom"},"put someone in their place":{"definition":"Cho ai đó biết thân biết phận","example":"She was getting too arrogant, so her boss had to put her in her place during the meeting.","exampleTranslation":"Cô ấy đang trở nên quá kiêu ngạo, nên sếp phải nhắc nhở cô ấy về vị trí của mình trong cuộc họp.","partOfSpeech":"idiom"},"put someone on the spot":{"definition":"Đưa ai vào thế khó, làm ai bối rối","example":"He put me on the spot by asking me to explain the mistake during the meeting.","exampleTranslation":"Anh ấy khiến tôi lúng túng bằng cách yêu cầu tôi giải thích sai sót trong cuộc họp.","partOfSpeech":"idiom"},"put something down in black and white":{"definition":"Viết giấy trắng mực đen, ghi chép rõ ràng","example":"Make sure to put the agreement down in black and white to avoid any misunderstandings.","exampleTranslation":"Hãy nhớ ghi thỏa thuận ra giấy trắng mực đen để tránh hiểu lầm.","partOfSpeech":"idiom"},"put something into practice":{"definition":"Đưa vào thực tiễn, áp dụng","example":"We need to put these new strategies into practice to see if they work.","exampleTranslation":"Chúng ta cần áp dụng những chiến lược mới này vào thực tế để xem chúng có hiệu quả không.","partOfSpeech":"idiom"},"put something on ice":{"definition":"Trì hoãn, đóng băng kế hoạch","example":"We’ll have to put the project on ice until we get more funds.","exampleTranslation":"Chúng ta sẽ phải tạm hoãn dự án cho đến khi có thêm kinh phí.","partOfSpeech":"idiom"},"put something on the back burner":{"definition":"Tạm gác lại, để giải quyết sau","example":"We need to put the marketing project on the back burner until we finish the product launch.","exampleTranslation":"Chúng ta cần gác dự án tiếp thị sang một bên cho đến khi hoàn thành việc ra mắt sản phẩm.","partOfSpeech":"idiom"},"put the screws on someone":{"definition":"Gây áp lực, ép buộc ai đó","example":"The boss really put the screws on us to finish the project by Friday.","exampleTranslation":"Sếp đã thực sự gây áp lực để chúng tôi hoàn thành dự án trước thứ Sáu.","partOfSpeech":"idiom"},"put your thinking cap on":{"definition":"Động não, tập trung suy nghĩ kỹ càng.","example":"We need a fresh marketing campaign, so put your thinking cap on and give me some ideas.","exampleTranslation":"Chúng ta cần một chiến dịch tiếp thị mới, nên hãy suy nghĩ và cho tôi vài ý tưởng.","partOfSpeech":"idiom"},"quality time":{"definition":"Khoảng thời gian ý nghĩa bên nhau","example":"We decided to spend some quality time together this weekend to strengthen our relationship.","exampleTranslation":"Chúng tôi quyết định dành thời gian chất lượng bên nhau vào cuối tuần này để củng cố mối quan hệ.","partOfSpeech":"idiom"},"rack one's brain":{"definition":"Vắt óc suy nghĩ","example":"I’ve been racking my brain all week trying to figure out this equation.","exampleTranslation":"Cả tuần nay tôi vắt óc suy nghĩ để giải phương trình này.","partOfSpeech":"idiom"},"Rain cats and dogs":{"definition":"Mưa nặng hạt, mưa tầm tã.","example":"We had to cancel the picnic because it was raining cats and dogs.","exampleTranslation":"Chúng tôi phải hủy buổi dã ngoại vì trời mưa như trút nước.","partOfSpeech":"idiom"},"rain on someone's parade":{"definition":"Phá đám, làm cụt hứng","example":"I’m sorry to rain on your parade, but the event has been canceled.","exampleTranslation":"Tôi xin lỗi vì làm hỏng niềm vui của bạn, nhưng sự kiện đã bị hủy.","partOfSpeech":"idiom"},"rain or shine":{"definition":"Dù mưa hay nắng, dù có chuyện gì xảy ra","example":"The soccer game will take place rain or shine.","exampleTranslation":"Trận bóng đá sẽ diễn ra dù mưa hay nắng.","partOfSpeech":"idiom"},"raise Cain":{"definition":"Gây rắc rối, làm ầm ĩ","example":"If the boss finds out about the mistake, he’s going to raise Cain.","exampleTranslation":"Nếu sếp phát hiện ra sai sót, ông ấy sẽ nổi trận lôi đình.","partOfSpeech":"idiom"},"read between the lines":{"definition":"Hiểu được ẩn ý, đọc được ngụ ý giữa các con chữ.","example":"If you read between the lines of his email, he is clearly planning to resign.","exampleTranslation":"Nếu bạn đọc kỹ ý nghĩa ẩn trong email của anh ấy, rõ ràng anh ấy đang định nghỉ việc.","partOfSpeech":"idiom"},"read someone the riot act":{"definition":"Cảnh cáo nghiêm khắc, mắng mỏ thậm tệ","example":"The manager really read Tom the riot act for missing the deadline.","exampleTranslation":"Người quản lý thực sự đã khiển trách Tom nặng nề vì lỡ hạn chót.","partOfSpeech":"idiom"},"red flag":{"definition":"Dấu hiệu cảnh báo, cờ đỏ","example":"His sudden change in behavior was a major red flag.","exampleTranslation":"Sự thay đổi hành vi đột ngột của anh ấy là một dấu hiệu cảnh báo lớn.","partOfSpeech":"idiom"},"red herring":{"definition":"Đánh lạc hướng","example":"The detective knew the clue was a red herring to divert them from the real crime.","exampleTranslation":"Thám tử biết manh mối đó là đánh lạc hướng để họ bị phân tâm khỏi tội ác thật sự.","partOfSpeech":"idiom"},"red in the face":{"definition":"Đỏ mặt (vì bối rối hoặc tức giận)","example":"She got red in the face when she realized she had made a mistake in the meeting.","exampleTranslation":"Cô ấy đỏ mặt khi nhận ra mình đã mắc sai lầm trong cuộc họp.","partOfSpeech":"idiom"},"rest on one's laurels":{"definition":"Ngủ quên trên chiến thắng","example":"The company can’t afford to rest on its laurels if it wants to stay competitive.","exampleTranslation":"Công ty không thể ngủ quên trên chiến thắng nếu muốn duy trì tính cạnh tranh.","partOfSpeech":"idiom"},"right this way":{"definition":"Xin mời đi lối này","example":"Welcome to our restaurant. Right this way, please.","exampleTranslation":"Chào mừng đến nhà hàng của chúng tôi. Mời đi lối này.","partOfSpeech":"idiom"},"ring a bell":{"definition":"Nghe quen quen","example":"Her name rings a bell, but I can’t place where I know her from.","exampleTranslation":"Cái tên của cô ấy nghe quen quen, nhưng tôi không nhớ mình biết cô ấy từ đâu.","partOfSpeech":"idiom"},"rings a bell":{"definition":"Nghe quen quen, gợi nhớ đến điều gì.","example":"His name rings a bell, but I cannot remember where we first met.","exampleTranslation":"Cái tên của anh ấy nghe quen quen, nhưng tôi không nhớ chúng tôi gặp nhau lần đầu ở đâu.","partOfSpeech":"idiom"},"rinky-dink":{"definition":"Tầm thường, rẻ tiền, chất lượng kém","example":"I can’t believe we stayed at that rinky-dink motel.","exampleTranslation":"Tôi không thể tin chúng ta đã ở trong nhà nghỉ tồi tàn đó.","partOfSpeech":"idiom"},"roll in it":{"definition":"Ngập trong tiền, giàu nứt đố đổ vách.","example":"After selling his startup to a major tech firm, he is practically rolling in it.","exampleTranslation":"Sau khi bán công ty khởi nghiệp cho một hãng công nghệ lớn, anh ấy gần như giàu sụ.","partOfSpeech":"idiom"},"roll out the red carpet":{"definition":"Đón tiếp nồng hậu, trải thảm đỏ","example":"The city decided to roll out the red carpet for the visiting celebrities.","exampleTranslation":"Thành phố quyết định trải thảm đỏ chào đón những người nổi tiếng đến thăm.","partOfSpeech":"idiom"},"rolling in it":{"definition":"Giàu nứt đố đổ vách, rất nhiều tiền","example":"They must be rolling in it to afford such a luxurious lifestyle.","exampleTranslation":"Họ chắc phải rất giàu mới có thể chi trả cho lối sống xa hoa như vậy.","partOfSpeech":"idiom"},"Rome wasn't built in a day":{"definition":"Việc lớn không thể làm xong trong một sớm một chiều","example":"Don’t worry if you can’t see the results immediately. Rome wasn’t built in a day.","exampleTranslation":"Đừng lo nếu bạn chưa thấy kết quả ngay. Thành La Mã không xây trong một ngày.","partOfSpeech":"idiom"},"rub elbows with someone":{"definition":"Giao du, kết giao (với người nổi tiếng, quan trọng)","example":"At the gala, she got to rub elbows with some famous celebrities.","exampleTranslation":"Tại buổi dạ tiệc, cô ấy được dịp gặp gỡ vài người nổi tiếng.","partOfSpeech":"idiom"},"ruffle feathers":{"definition":"Làm ai đó phật ý, mất lòng","example":"His decision to cancel the project really ruffled some feathers in the team.","exampleTranslation":"Quyết định hủy dự án của anh ấy đã làm phật lòng một số người trong nhóm.","partOfSpeech":"idiom"},"rule of thumb":{"definition":"Nguyên tắc theo kinh nghiệm thực tế","example":"A good rule of thumb is to save at least 10% of your income.","exampleTranslation":"Một quy tắc kinh nghiệm hay là hãy tiết kiệm ít nhất 10% thu nhập của bạn.","partOfSpeech":"idiom"},"rule the roost":{"definition":"Làm chủ gia đình, nắm quyền quyết định tối cao trong nhà/nhóm.","example":"In their household, grandmother clearly rules the roost.","exampleTranslation":"Trong gia đình họ, bà rõ ràng là người nắm quyền.","partOfSpeech":"idiom"},"run amok":{"definition":"Nổi điên, làm loạn","example":"When the teacher left the room, the students ran amok.","exampleTranslation":"Khi giáo viên rời khỏi phòng, học sinh nô đùa náo loạn.","partOfSpeech":"idiom"},"run circles around someone":{"definition":"Bỏ xa ai đó, hoàn toàn lấn lướt","example":"In chess, she can run circles around most of her friends.","exampleTranslation":"Trong cờ vua, cô ấy có thể chơi giỏi hơn hầu hết bạn bè của mình.","partOfSpeech":"idiom"},"run errands":{"definition":"Chạy việc vặt","example":"I have to run errands this afternoon, including going to the bank and picking up groceries.","exampleTranslation":"Chiều nay tôi phải chạy vài việc vặt, bao gồm đến ngân hàng và mua đồ tạp hóa.","partOfSpeech":"idiom"},"run in the family":{"definition":"Di truyền trong gia đình, là nét đặc trưng gia truyền.","example":"Musical talent definitely runs in the family; both her parents are professional pianists.","exampleTranslation":"Tài năng âm nhạc chắc chắn là di truyền trong gia đình; cả bố mẹ cô ấy đều là nghệ sĩ piano chuyên nghiệp.","partOfSpeech":"idiom"},"run its course":{"definition":"Phát triển tự nhiên đến hồi kết thúc","example":"The doctors decided to let the fever run its course.","exampleTranslation":"Các bác sĩ quyết định để cơn sốt tự diễn biến hết.","partOfSpeech":"idiom"},"run like the wind":{"definition":"Chạy nhanh như gió","example":"When he saw the dog chasing him, he started to run like the wind.","exampleTranslation":"Khi thấy con chó đuổi theo, anh ấy chạy nhanh như gió.","partOfSpeech":"idiom"},"run one's mouth off":{"definition":"Nói nhiều, ba hoa, ăn nói thiếu suy nghĩ","example":"If you keep running your mouth off, you’ll alienate your friends.","exampleTranslation":"Nếu bạn cứ nói bừa, bạn sẽ làm bạn bè xa lánh mình.","partOfSpeech":"idiom"},"run out of steam":{"definition":"Đuối sức, mất đà","example":"After working non-stop for hours, I finally ran out of steam.","exampleTranslation":"Sau nhiều giờ làm việc không ngừng nghỉ, cuối cùng tôi cũng hết sức.","partOfSpeech":"idiom"},"run out of time":{"definition":"Hết thời gian, cạn thời gian.","example":"I could not answer the final essay question because I ran out of time.","exampleTranslation":"Tôi không thể trả lời câu hỏi tiểu luận cuối cùng vì hết thời gian.","partOfSpeech":"idiom"},"run the show":{"definition":"Điều hành, nắm quyền kiểm soát","example":"After the manager left, Rob stepped up to run the show.","exampleTranslation":"Sau khi quản lý rời đi, Rob đứng ra điều hành mọi việc.","partOfSpeech":"idiom"},"Run-of-the-mill":{"definition":"tầm thường, bình thường, không có gì nổi trội","example":"The restaurant was just a run-of-the-mill place; nothing special.","exampleTranslation":"Nhà hàng chỉ là một nơi bình thường; không có gì đặc biệt.","partOfSpeech":"idiom"},"Run/blow hot and cold":{"definition":"Sáng nắng chiều mưa, thay đổi thất thường.","example":"She tends to run hot and cold, making it hard to understand her feelings.","exampleTranslation":"Cô ấy có xu hướng lúc nóng lúc lạnh, khiến người ta khó hiểu cảm xúc của cô.","partOfSpeech":"idiom"},"Running on fumes":{"definition":"kiệt sức, cố sức làm dù đã cạn kiệt năng lượng","example":"After working three 12-hour shifts in a row, she’s running on fumes.","exampleTranslation":"Sau khi làm ba ca 12 tiếng liên tiếp, cô ấy gần như kiệt sức.","partOfSpeech":"idiom"},"safe and sound":{"definition":"Bình an vô sự, an toàn khỏe mạnh.","example":"After three days lost in the mountains, the hikers were found safe and sound.","exampleTranslation":"Sau ba ngày lạc trong núi, những người đi bộ đường dài đã được tìm thấy an toàn.","partOfSpeech":"idiom"},"Sail close to the wind":{"definition":"mạo hiểm, liều lĩnh, làm chuyện rủi ro","example":"He’s sailing close to the wind with those tax deductions.","exampleTranslation":"Anh ấy đang làm việc ở ranh giới nguy hiểm với những khoản khấu trừ thuế đó.","partOfSpeech":"idiom"},"Sales pitch":{"definition":"lời chào hàng, bài thuyết trình bán hàng","example":"The sales representative gave an excellent sales pitch that convinced us to buy the new software.","exampleTranslation":"Nhân viên bán hàng đã có bài chào hàng xuất sắc thuyết phục chúng tôi mua phần mềm mới.","partOfSpeech":"idiom"},"Salt of the earth":{"definition":"người tốt bụng, trung thực và giản dị","example":"John is the salt of the earth, always willing to lend a hand to anyone in need.","exampleTranslation":"John là người tốt bụng chất phác, luôn sẵn sàng giúp đỡ bất cứ ai gặp khó khăn.","partOfSpeech":"idiom"},"save face":{"definition":"Giữ thể diện, giữ danh dự.","example":"He accepted a compromise in the dispute just to save face in front of his team.","exampleTranslation":"Anh ấy chấp nhận một sự thỏa hiệp trong tranh chấp chỉ để giữ thể diện trước đội của mình.","partOfSpeech":"idiom"},"Save for a rainy day":{"definition":"dành dụm phòng khi túng thiếu","example":"She puts aside a part of her salary every month, saving for a rainy day.","exampleTranslation":"Cô ấy để dành một phần lương mỗi tháng, tiết kiệm phòng khi hoạn nạn.","partOfSpeech":"idiom"},"Save someone's skin":{"definition":"cứu nguy cho ai đó, cứu ai khỏi rắc rối","example":"Thanks for lending me your notes, you really saved my skin for the exam.","exampleTranslation":"Cảm ơn vì đã cho tôi mượn vở ghi, bạn thực sự đã cứu tôi trong kỳ thi.","partOfSpeech":"idiom"},"Saved by the bell":{"definition":"thoát nạn trong gang tấc (nhờ sự can thiệp kịp thời)","example":"I was about to be called to present my project, but I was saved by the bell when the fire alarm went off.","exampleTranslation":"Tôi sắp bị gọi lên trình bày dự án, nhưng nhờ tiếng chuông báo cháy vang lên mà tôi được cứu.","partOfSpeech":"idiom"},"Say one's piece":{"definition":"nói ra suy nghĩ của mình, bày tỏ ý kiến","example":"At the meeting, she finally got to say her piece about the new policy.","exampleTranslation":"Tại cuộc họp, cuối cùng cô ấy cũng được nói ý kiến của mình về chính sách mới.","partOfSpeech":"idiom"},"Say uncle":{"definition":"chịu thua, nhận thua","example":"After ten minutes of arm wrestling, he finally said uncle.","exampleTranslation":"Sau mười phút vật tay, cuối cùng anh ấy đã chịu thua.","partOfSpeech":"idiom"},"Scapegoat":{"definition":"kẻ thế tội, con dê tế thần","example":"When the project failed, John became the office scapegoat.","exampleTranslation":"Khi dự án thất bại, John trở thành vật tế thần của văn phòng.","partOfSpeech":"idiom"},"Scare the pants off someone":{"definition":"làm ai sợ mất mật","example":"That horror movie really scared the pants off me.","exampleTranslation":"Bộ phim kinh dị đó thực sự làm tôi sợ chết khiếp.","partOfSpeech":"idiom"},"School of thought":{"definition":"trường phái tư tưởng, luồng suy nghĩ","example":"There are different schools of thought concerning the best way to educate children.","exampleTranslation":"Có nhiều trường phái tư duy khác nhau về cách tốt nhất để giáo dục trẻ em.","partOfSpeech":"idiom"},"School someone in something":{"definition":"dạy dỗ ai đó về cái gì, chỉ bảo ai","example":"They were schooled in the art of negotiation by a top lawyer.","exampleTranslation":"Họ được một luật sư hàng đầu huấn luyện nghệ thuật đàm phán.","partOfSpeech":"idiom"},"Scot-free":{"definition":"bình an vô sự, thoát tội","example":"After the trial, he walked away scot-free, despite all the evidence against him.","exampleTranslation":"Sau phiên tòa, anh ta thoát tội dù có tất cả bằng chứng chống lại anh ta.","partOfSpeech":"idiom"},"Screw up":{"definition":"làm hỏng bét, phá hỏng chuyện","example":"I really screwed up that presentation.","exampleTranslation":"Tôi thực sự đã làm hỏng bài thuyết trình đó.","partOfSpeech":"idiom"},"Sea legs":{"definition":"khả năng giữ thăng bằng trên tàu; quen với môi trường mới","example":"It took me a few days to get my sea legs, but now I’m fine.","exampleTranslation":"Tôi mất vài ngày mới quen được với việc đi tàu, nhưng giờ tôi đã ổn.","partOfSpeech":"idiom"},"Second-rate":{"definition":"hạng hai, kém chất lượng, tồi tệ","example":"The movie was second-rate and barely kept my attention.","exampleTranslation":"Bộ phim chỉ ở hạng hai và hầu như không giữ được sự chú ý của tôi.","partOfSpeech":"idiom"},"Security blanket":{"definition":"vật làm an lòng, chỗ dựa tinh thần","example":"She always carries her favorite book as a security blanket during stressful times.","exampleTranslation":"Cô ấy luôn mang theo cuốn sách yêu thích như một chỗ dựa tinh thần trong những lúc căng thẳng.","partOfSpeech":"idiom"},"See eye to eye":{"definition":"đồng quan điểm, hoàn toàn đồng ý","example":"We don’t always see eye to eye, but we respect each other’s opinions.","exampleTranslation":"Không phải lúc nào chúng tôi cũng đồng quan điểm, nhưng chúng tôi tôn trọng ý kiến của nhau.","partOfSpeech":"idiom"},"See someone's true colors":{"definition":"nhìn rõ bộ mặt thật của ai","example":"She seemed so nice at first, but we saw her true colors when the pressure was on.","exampleTranslation":"Lúc đầu cô ấy có vẻ rất tử tế, nhưng chúng tôi đã thấy bộ mặt thật của cô khi gặp áp lực.","partOfSpeech":"idiom"},"See the big picture":{"definition":"nhìn nhận toàn cục, có cái nhìn bao quát","example":"To solve this problem, we need to see the big picture.","exampleTranslation":"Để giải quyết vấn đề này, chúng ta cần nhìn thấy bức tranh toàn cảnh.","partOfSpeech":"idiom"},"See the light":{"definition":"Hiểu ra vấn đề, giác ngộ, nhận ra chân lý.","example":"After years of struggling with his career, he finally saw the light and decided to pursue his passion.","exampleTranslation":"Sau nhiều năm vật lộn với sự nghiệp, cuối cùng anh ấy đã nhận ra và quyết định theo đuổi đam mê của mình.","partOfSpeech":"idiom"},"See through someone":{"definition":"nhìn thấu tâm can ai, biết người đó đang giả tạo","example":"I can see through his lies; he’s not telling the truth.","exampleTranslation":"Tôi có thể nhìn thấu những lời nói dối của anh ta; anh ta không nói thật.","partOfSpeech":"idiom"},"Sell like hotcakes":{"definition":"bán đắt như tôm tươi","example":"The new video game is selling like hotcakes.","exampleTranslation":"Trò chơi điện tử mới đang bán chạy như tôm tươi.","partOfSpeech":"idiom"},"Sell someone out":{"definition":"phản bội, bán đứng ai đó","example":"I can't believe you sold me out to the boss.","exampleTranslation":"Tôi không thể tin bạn đã bán đứng tôi với sếp.","partOfSpeech":"idiom"},"Sell someone short":{"definition":"đánh giá thấp ai đó","example":"Don’t sell yourself short. You have a lot of talent.","exampleTranslation":"Đừng coi thường bản thân. Bạn có rất nhiều tài năng.","partOfSpeech":"idiom"},"Serve one right":{"definition":"Đáng đời, đáng kiếp.","example":"After cheating on the test, it served him right to be expelled from school.","exampleTranslation":"Sau khi gian lận trong bài thi, anh ta bị đuổi học là đáng đời.","partOfSpeech":"idiom"},"set foot in":{"definition":"Đặt chân đến, bước vào một nơi nào đó.","example":"It was the first time she had ever set foot in a foreign country.","exampleTranslation":"Đó là lần đầu tiên cô ấy đặt chân đến một đất nước xa lạ.","partOfSpeech":"idiom"},"Set one's teeth on edge":{"definition":"làm chướng tai gai mắt, gây khó chịu","example":"The sound of nails on a chalkboard sets my teeth on edge.","exampleTranslation":"Âm thanh móng tay cào trên bảng đen làm tôi ghê răng.","partOfSpeech":"idiom"},"Shake a leg":{"definition":"nhanh lên, khẩn trương lên","example":"Come on, we need to leave soon. Shake a leg!","exampleTranslation":"Nhanh lên, chúng ta cần đi sớm. Mau lên!","partOfSpeech":"idiom"},"Shape up or ship out":{"definition":"thay đổi thái độ hoặc là nghỉ việc/cuốn gói ra đi","example":"If you don’t start meeting deadlines, you’ll have to shape up or ship out.","exampleTranslation":"Nếu bạn không bắt đầu đáp ứng thời hạn, bạn sẽ phải chấn chỉnh lại hoặc ra đi.","partOfSpeech":"idiom"},"Sharp as a tack":{"definition":"cực kỳ thông minh, nhạy bén","example":"Despite his age, Grandpa is still sharp as a tack.","exampleTranslation":"Dù đã già, ông vẫn minh mẫn tinh anh.","partOfSpeech":"idiom"},"shed light on":{"definition":"Làm sáng tỏ, làm rõ một vấn đề.","example":"Recent archaeological discoveries have shed light on how ancient civilizations lived.","exampleTranslation":"Những phát hiện khảo cổ gần đây đã làm sáng tỏ cách các nền văn minh cổ đại từng sống.","partOfSpeech":"idiom"},"Ships passing in the night":{"definition":"người lướt qua đời nhau, tình cờ gặp gỡ rồi chia xa","example":"We were like ships passing in the night, only meeting briefly before moving on.","exampleTranslation":"Chúng tôi như những con tàu đi ngang qua nhau trong đêm, chỉ gặp nhau thoáng chốc rồi lại đi tiếp.","partOfSpeech":"idiom"},"Shoestring budget":{"definition":"ngân sách eo hẹp","example":"The project was completed on a shoestring budget but still turned out great.","exampleTranslation":"Dự án được hoàn thành với ngân sách eo hẹp nhưng vẫn rất tốt.","partOfSpeech":"idiom"},"Shoot from the hip":{"definition":"nói thẳng thừng, phản ứng tức thời không suy nghĩ kỹ","example":"He tends to shoot from the hip during meetings without considering the consequences.","exampleTranslation":"Anh ấy có xu hướng nói bộp chộp trong các cuộc họp mà không cân nhắc hậu quả.","partOfSpeech":"idiom"},"Shoot hoops":{"definition":"chơi bóng rổ","example":"Let’s go to the park and shoot hoops this afternoon.","exampleTranslation":"Chiều nay chúng ta hãy ra công viên ném bóng rổ nhé.","partOfSpeech":"idiom"},"Shoot off one's mouth":{"definition":"nói năng thiếu suy nghĩ, ba hoa","example":"Don’t shoot off your mouth in the meeting, it’s better to listen first.","exampleTranslation":"Đừng phát biểu bừa bãi trong cuộc họp, tốt hơn là hãy lắng nghe trước.","partOfSpeech":"idiom"},"Shoot the breeze":{"definition":"chém gió, tán gẫu","example":"We spent the afternoon just shooting the breeze at the coffee shop.","exampleTranslation":"Chúng tôi dành cả buổi chiều chỉ tán gẫu ở quán cà phê.","partOfSpeech":"idiom"},"shop till you drop":{"definition":"Mua sắm thả ga đến kiệt sức.","example":"During the Black Friday sale, they went to the mall and shopped till they dropped.","exampleTranslation":"Trong đợt giảm giá Black Friday, họ đến trung tâm thương mại và mua sắm đến kiệt sức.","partOfSpeech":"idiom"},"Shot in the arm":{"definition":"liều thuốc tinh thần, sự khích lệ","example":"The unexpected bonus at work was a real shot in the arm for our motivation.","exampleTranslation":"Khoản thưởng bất ngờ ở công ty là một liều thuốc tăng lực thực sự cho động lực của chúng tôi.","partOfSpeech":"idiom"},"Shot in the dark":{"definition":"sự phỏng đoán, mò mẫm trong bóng tối","example":"It was a shot in the dark, but I managed to guess the correct password.","exampleTranslation":"Đó chỉ là đoán mò, nhưng tôi đã đoán trúng được mật khẩu.","partOfSpeech":"idiom"},"Show of hands":{"definition":"biểu quyết bằng cách giơ tay","example":"Let's have a show of hands to see who agrees with the new proposal.","exampleTranslation":"Hãy giơ tay xem ai đồng ý với đề xuất mới.","partOfSpeech":"idiom"},"Sick as a dog":{"definition":"ốm liệt giường, ốm nặng","example":"I was sick as a dog after eating that spoiled food.","exampleTranslation":"Tôi ốm nặng sau khi ăn đồ ăn bị hỏng đó.","partOfSpeech":"idiom"},"Sit tight":{"definition":"ngồi yên đó, kiên nhẫn chờ đợi","example":"Just sit tight, the doctor will be with you shortly.","exampleTranslation":"Cứ ngồi yên, bác sĩ sẽ đến với bạn ngay.","partOfSpeech":"idiom"},"Sitting like a bump on a log":{"definition":"ngồi im như phỗng, trơ ra đó","example":"Don't just sit there like a bump on a log—help me with these groceries!","exampleTranslation":"Đừng ngồi đó như khúc gỗ — hãy giúp tôi với những túi hàng này!","partOfSpeech":"idiom"},"Sitting pretty":{"definition":"ở vị thế thuận lợi (thường là về tài chính)","example":"With their mortgage paid off, they are sitting pretty for retirement.","exampleTranslation":"Khi đã trả hết tiền vay nhà, họ yên tâm cho tuổi nghỉ hưu.","partOfSpeech":"idiom"},"Sixth sense":{"definition":"giác quan thứ sáu, trực giác","example":"She seemed to have a sixth sense when it came to knowing when her kids were lying.","exampleTranslation":"Cô ấy dường như có giác quan thứ sáu khi biết con mình nói dối.","partOfSpeech":"idiom"},"Skeleton crew":{"definition":"nhóm nhân viên tối thiểu (để duy trì hoạt động)","example":"The factory operates with only a skeleton crew during the holidays.","exampleTranslation":"Nhà máy chỉ hoạt động với số ít nhân viên tối thiểu trong kỳ nghỉ lễ.","partOfSpeech":"idiom"},"Skeleton in the closet":{"definition":"bí mật đáng xấu hổ","example":"Almost every family has at least one skeleton in the closet.","exampleTranslation":"Hầu như gia đình nào cũng có ít nhất một bí mật không muốn ai biết.","partOfSpeech":"idiom"},"Skip class":{"definition":"cúp học, trốn học","example":"He decided to skip class and go to the movies instead.","exampleTranslation":"Anh ấy quyết định trốn học và đi xem phim.","partOfSpeech":"idiom"},"Slap on the wrist":{"definition":"phạt nhẹ, hình phạt chiếu lệ","example":"He only got a slap on the wrist for speeding, which surprised everyone.","exampleTranslation":"Anh ta chỉ bị phạt nhẹ vì chạy quá tốc độ, điều khiến mọi người ngạc nhiên.","partOfSpeech":"idiom"},"Sleep like a log":{"definition":"ngủ say như chết","example":"After a long day of hiking, I slept like a log.","exampleTranslation":"Sau một ngày đi bộ đường dài, tôi ngủ say như chết.","partOfSpeech":"idiom"},"Slim chance":{"definition":"cơ hội mong manh","example":"There is a slim chance of rain today, so you might not need an umbrella.","exampleTranslation":"Hôm nay có khả năng mưa rất thấp, nên bạn có thể không cần ô.","partOfSpeech":"idiom"},"Slip of the tongue":{"definition":"lỡ lời, trượt miệng","example":"It was just a slip of the tongue; I didn't mean to say that.","exampleTranslation":"Đó chỉ là lỡ lời; tôi không có ý nói như vậy.","partOfSpeech":"idiom"},"Slow and steady wins the race":{"definition":"chậm mà chắc","example":"She believes that slow and steady wins the race, so she carefully plans her projects.","exampleTranslation":"Cô ấy tin rằng chậm mà chắc sẽ thắng, nên cô lên kế hoạch cẩn thận cho các dự án.","partOfSpeech":"idiom"},"Small world":{"definition":"trái đất tròn, thế giới nhỏ bé","example":"I can't believe I ran into my old college roommate in Tokyo. Small world!","exampleTranslation":"Tôi không thể tin mình tình cờ gặp lại bạn cùng phòng đại học cũ ở Tokyo. Thế giới thật nhỏ bé!","partOfSpeech":"idiom"},"Smell a rat":{"definition":"nghi ngờ có điều gì mờ ám, đánh hơi thấy mùi nguy hiểm","example":"When she saw the strange email, she immediately smelled a rat.","exampleTranslation":"Khi thấy email lạ, cô ấy lập tức nghi ngờ có điều bất thường.","partOfSpeech":"idiom"},"Smoke and mirrors":{"definition":"sự lừa bịp, chiêu trò che mắt","example":"The politician's promises were just smoke and mirrors to gain votes.","exampleTranslation":"Những lời hứa của chính trị gia chỉ là mánh khóe lừa gạt để thu phiếu bầu.","partOfSpeech":"idiom"},"Smoke like a chimney":{"definition":"hút thuốc lá như ống khói, hút thuốc liên tục","example":"He smokes like a chimney; it's hard to believe he hasn't quit yet.","exampleTranslation":"Anh ấy hút thuốc như ống khói; khó tin là anh ấy chưa bỏ.","partOfSpeech":"idiom"},"Smooth things over":{"definition":"Dàn xếp, xoa dịu tình hình.","example":"He tried to smooth things over between his two friends who had a disagreement.","exampleTranslation":"Anh ấy cố gắng hòa giải cho hai người bạn đã bất đồng với nhau.","partOfSpeech":"idiom"},"Snowed under":{"definition":"bận ngập đầu, ngập trong công việc","example":"I'm completely snowed under with paperwork this week.","exampleTranslation":"Tuần này tôi ngập đầu trong đống giấy tờ.","partOfSpeech":"idiom"},"So far so good":{"definition":"mọi chuyện vẫn ổn, cho đến nay mọi thứ vẫn tốt đẹp","example":"We've finished half the project; so far so good.","exampleTranslation":"Chúng ta đã hoàn thành một nửa dự án; cho đến giờ mọi thứ vẫn ổn.","partOfSpeech":"idiom"},"Something is killing me":{"definition":"đau chết đi được, làm ai đó vô cùng khổ sở","example":"This headache is killing me.","exampleTranslation":"Cơn đau đầu này đang làm tôi khổ sở.","partOfSpeech":"idiom"},"Something sucks":{"definition":"tệ hại, chán ngắt","example":"This rainy weather really sucks.","exampleTranslation":"Thời tiết mưa này thật tệ.","partOfSpeech":"idiom"},"Something to crow about":{"definition":"điều đáng tự hào, đáng để khoe khoang","example":"Winning the championship is definitely something to crow about.","exampleTranslation":"Giành chức vô địch chắc chắn là điều đáng để khoe khoang.","partOfSpeech":"idiom"},"Sour grapes":{"definition":"biện hộ kiểu con cáo và chùm nho, chê bai thứ mình không có được","example":"It's just sour grapes when he says he didn't want the promotion anyway.","exampleTranslation":"Đó chỉ là nho chua khi anh ta nói dù sao mình cũng không muốn được thăng chức.","partOfSpeech":"idiom"},"Speak of the devil":{"definition":"vừa nhắc tào tháo thì tào tháo tới","example":"We were just talking about John, and speak of the devil, here he comes!","exampleTranslation":"Chúng tôi vừa nói về John, và vừa nhắc là anh ấy đến liền!","partOfSpeech":"idiom"},"Spice things up":{"definition":"thêm mắm dặm muối, làm cho thú vị hơn","example":"We need to spice things up with some new activities at our next meeting.","exampleTranslation":"Chúng ta cần làm mọi thứ thêm hấp dẫn bằng vài hoạt động mới trong cuộc họp tới.","partOfSpeech":"idiom"},"Spill the beans":{"definition":"tiết lộ bí mật","example":"He accidentally spilled the beans about the surprise party.","exampleTranslation":"Anh ấy vô tình lỡ miệng tiết lộ về bữa tiệc bất ngờ.","partOfSpeech":"idiom"},"Spin doctor":{"definition":"chuyên gia bóp méo sự thật, người giật dây truyền thông","example":"The politician hired a spin doctor to handle the press after the scandal broke.","exampleTranslation":"Chính trị gia đã thuê một chuyên gia truyền thông để xử lý báo chí sau khi bê bối nổ ra.","partOfSpeech":"idiom"},"Spineless":{"definition":"yếu hèn, nhu nhược, không có lập trường","example":"He was too spineless to stand up to his boss.","exampleTranslation":"Anh ta quá hèn nhát để đối đầu với sếp.","partOfSpeech":"idiom"},"Spitting image":{"definition":"giống y đúc, bản sao hoàn hảo","example":"Tim is the spitting image of his father; they look exactly alike.","exampleTranslation":"Tim giống bố như đúc; hai người trông giống hệt nhau.","partOfSpeech":"idiom"},"Splitting hairs":{"definition":"vạch lá tìm sâu, bới bèo ra bọ, quá chi li","example":"Arguing about this minor difference is just splitting hairs.","exampleTranslation":"Tranh cãi về sự khác biệt nhỏ này chỉ là chẻ sợi tóc làm tư.","partOfSpeech":"idiom"},"Spread yourself too thin":{"definition":"ôm đồm quá nhiều việc, làm việc quá sức","example":"If you spread yourself too thin, you won't be able to give your best effort to any of your tasks.","exampleTranslation":"Nếu bạn dàn trải bản thân quá mỏng, bạn sẽ không thể dốc hết sức cho bất kỳ nhiệm vụ nào.","partOfSpeech":"idiom"},"Square meal":{"definition":"bữa ăn thịnh soạn, bữa ăn no nê","example":"After working all day, he looks forward to having a square meal at home.","exampleTranslation":"Sau khi làm việc cả ngày, anh ấy mong được ăn một bữa no đủ ở nhà.","partOfSpeech":"idiom"},"Squeaky clean":{"definition":"sạch bong kin kít; hoàn toàn trong sạch","example":"He has a squeaky clean record with no criminal history.","exampleTranslation":"Anh ấy có lý lịch sạch sẽ không có tiền án.","partOfSpeech":"idiom"},"Stab someone in the back":{"definition":"đâm sau lưng, phản bội","example":"I can't believe he would stab me in the back after all we've been through.","exampleTranslation":"Tôi không thể tin anh ta lại đâm sau lưng tôi sau tất cả những gì chúng tôi đã trải qua.","partOfSpeech":"idiom"},"Stand one's ground":{"definition":"giữ vững lập trường, không lùi bước","example":"Despite the criticism, he decided to stand his ground on the project.","exampleTranslation":"Bất chấp những lời chỉ trích, anh ấy quyết định giữ vững lập trường về dự án.","partOfSpeech":"idiom"},"Stand up for":{"definition":"Đứng lên bảo vệ, ủng hộ.","example":"He always stands up for his friends when they are in trouble.","exampleTranslation":"Anh ấy luôn bênh vực bạn bè khi họ gặp rắc rối.","partOfSpeech":"idiom"},"start a family":{"definition":"Lập gia đình và sinh con, bắt đầu có con.","example":"After buying their new house, the young couple decided it was time to start a family.","exampleTranslation":"Sau khi mua nhà mới, cặp vợ chồng trẻ quyết định đã đến lúc lập gia đình.","partOfSpeech":"idiom"},"Start over from scratch":{"definition":"Bắt đầu lại từ đầu (từ con số không).","example":"After losing all the data, we had to start over from scratch with the project.","exampleTranslation":"Sau khi mất hết dữ liệu, chúng tôi phải làm lại dự án từ đầu.","partOfSpeech":"idiom"},"Stay in touch":{"definition":"giữ liên lạc","example":"Let's stay in touch after you move to New York.","exampleTranslation":"Hãy giữ liên lạc sau khi bạn chuyển đến New York.","partOfSpeech":"idiom"},"Stay on budget":{"definition":"bám sát ngân sách, chi tiêu trong giới hạn","example":"We need to stay on budget for this project to be profitable.","exampleTranslation":"Chúng ta cần giữ trong ngân sách để dự án có lãi.","partOfSpeech":"idiom"},"Steal someone's thunder":{"definition":"cướp công, cướp sự chú ý của người khác","example":"She announced her engagement at my birthday party, totally stealing my thunder.","exampleTranslation":"Cô ấy tuyên bố đính hôn tại bữa tiệc sinh nhật của tôi, hoàn toàn cướp mất hào quang của tôi.","partOfSpeech":"idiom"},"step up one's game":{"definition":"Nâng cao trình độ, nỗ lực và thể hiện tốt hơn.","example":"With the championship approaching, every player on the team needs to step up their game.","exampleTranslation":"Khi chức vô địch đến gần, mọi cầu thủ trong đội cần nâng cao phong độ.","partOfSpeech":"idiom"},"Step up your game":{"definition":"nỗ lực hơn, cố gắng hết sức","example":"If you want to get that promotion, you'll need to step up your game.","exampleTranslation":"Nếu muốn được thăng chức, bạn cần nâng cao hiệu suất làm việc của mình.","partOfSpeech":"idiom"},"Stew in your own juices":{"definition":"tự làm tự chịu, tự chuốc lấy hậu quả","example":"He made a mistake and now he has to stew in his own juices.","exampleTranslation":"Anh ấy đã mắc sai lầm và giờ phải tự chịu hậu quả.","partOfSpeech":"idiom"},"Stick out like a sore thumb":{"definition":"lạc lõng, nổi bần bật, khác người","example":"Her bright red dress stuck out like a sore thumb at the black-tie event.","exampleTranslation":"Chiếc váy đỏ rực của cô ấy nổi bật lạc lõng tại sự kiện trang phục lịch sự.","partOfSpeech":"idiom"},"Stick to your guns":{"definition":"giữ vững quan điểm, kiên định","example":"Even though everyone disagreed with her, she decided to stick to her guns.","exampleTranslation":"Dù mọi người đều không đồng ý với cô ấy, cô vẫn quyết định kiên định với quan điểm của mình.","partOfSpeech":"idiom"},"Stick-in-the-mud":{"definition":"người bảo thủ, người nhàm chán","example":"Don't be such a stick-in-the-mud; try something new for a change!","exampleTranslation":"Đừng bảo thủ như vậy; hãy thử điều gì đó mới mẻ để thay đổi!","partOfSpeech":"idiom"},"Sticking point":{"definition":"điểm bế tắc, trở ngại chính","example":"The main sticking point in the negotiation was the distribution of profits.","exampleTranslation":"Điểm vướng mắc chính trong cuộc đàm phán là việc phân chia lợi nhuận.","partOfSpeech":"idiom"},"Sticky fingers":{"definition":"tật ăn cắp vặt, táy máy","example":"You'd better keep an eye on your wallet around Jimmy; he's known to have sticky fingers.","exampleTranslation":"Bạn nên để mắt đến ví của mình khi ở gần Jimmy; anh ta nổi tiếng là tay ăn cắp vặt.","partOfSpeech":"idiom"},"Stonewall":{"definition":"Né tránh, cản trở, từ chối hợp tác.","example":"Whenever we ask for details, they just stonewall us.","exampleTranslation":"Mỗi khi chúng tôi hỏi chi tiết, họ chỉ cản trở và né tránh.","partOfSpeech":"idiom"},"Stop on a dime":{"definition":"dừng lại đột ngột, phanh gấp","example":"The new sports car can stop on a dime, making it really safe to drive.","exampleTranslation":"Chiếc xe thể thao mới có thể dừng ngay tức thì, giúp việc lái xe rất an toàn.","partOfSpeech":"idiom"},"Street-smart":{"definition":"bụi đời, ranh mãnh, lanh lợi","example":"Growing up in New York, she became very street-smart.","exampleTranslation":"Lớn lên ở New York, cô ấy trở nên rất lõi đời.","partOfSpeech":"idiom"},"Stretch the truth":{"definition":"phóng đại sự thật, nói quá","example":"He tends to stretch the truth about his achievements.","exampleTranslation":"Anh ta có xu hướng thổi phồng thành tích của mình.","partOfSpeech":"idiom"},"Strike it rich":{"definition":"trúng quả đậm, phất lên","example":"They think they'll strike it rich by investing in that startup.","exampleTranslation":"Họ nghĩ sẽ làm giàu nhanh chóng bằng cách đầu tư vào công ty khởi nghiệp đó.","partOfSpeech":"idiom"},"String someone along":{"definition":"lừa phỉnh, dắt mũi ai đó","example":"He strung her along for months, promising to make her a partner in the business.","exampleTranslation":"Anh ta đã lợi dụng cô ấy nhiều tháng, hứa sẽ cho cô làm đối tác trong công việc kinh doanh.","partOfSpeech":"idiom"},"Stuffed shirt":{"definition":"kẻ làm bộ làm tịch, người tự phụ","example":"He's such a stuffed shirt, always talking down to others.","exampleTranslation":"Anh ta là người cứng nhắc kiêu ngạo, luôn nói giọng bề trên với người khác.","partOfSpeech":"idiom"},"Swallow your pride":{"definition":"dẹp bỏ tự ái, nuốt lòng tự trọng","example":"He had to swallow his pride and apologize to his boss.","exampleTranslation":"Anh ấy phải nuốt lòng tự trọng và xin lỗi sếp.","partOfSpeech":"idiom"},"Sweat blood":{"definition":"đổ mồ hôi sôi nước mắt, làm việc quần quật","example":"We sweat blood on this project to meet the deadline.","exampleTranslation":"Chúng tôi đã đổ mồ hôi sôi nước mắt cho dự án này để kịp hạn chót.","partOfSpeech":"idiom"},"Sweating bullets":{"definition":"căng thẳng tột độ, lo sốt vó","example":"He was sweating bullets before his big presentation.","exampleTranslation":"Anh ấy toát mồ hôi hột trước buổi thuyết trình lớn của mình.","partOfSpeech":"idiom"},"Take a load off someone's back":{"definition":"Trút bỏ gánh nặng cho ai đó.","example":"By finishing some of his tasks, she took a load off his back.","exampleTranslation":"Bằng việc hoàn thành một số nhiệm vụ của anh ấy, cô đã giúp anh nhẹ gánh.","partOfSpeech":"idiom"},"Take a rain check":{"definition":"hẹn dịp khác, khất lại","example":"I'm really busy tonight, but can I take a rain check on dinner?","exampleTranslation":"Tối nay tôi thực sự bận, nhưng tôi có thể hẹn bữa tối vào dịp khác không?","partOfSpeech":"idiom"},"Take a shine to someone/something":{"definition":"cảm mến ngay lập tức, ưng ý ngay","example":"Sarah seems to have really taken a shine to the new intern.","exampleTranslation":"Sarah dường như thực sự có cảm tình với thực tập sinh mới.","partOfSpeech":"idiom"},"take a stand":{"definition":"Bày tỏ lập trường kiên định, đứng lên bảo vệ quan điểm.","example":"Citizens must take a stand against injustice and inequality.","exampleTranslation":"Công dân phải đứng lên chống lại bất công và bất bình đẳng.","partOfSpeech":"idiom"},"take a turn for the worse":{"definition":"Trở nặng đột ngột, diễn biến theo chiều hướng xấu đi.","example":"The patient was improving, but his condition suddenly took a turn for the worse last night.","exampleTranslation":"Bệnh nhân đang tiến triển tốt, nhưng tình trạng của ông ấy đột ngột xấu đi vào đêm qua.","partOfSpeech":"idiom"},"take for granted":{"definition":"Coi là điều hiển nhiên, không biết trân trọng.","example":"Never take your family's unconditional love and support for granted.","exampleTranslation":"Đừng bao giờ coi tình yêu và sự ủng hộ vô điều kiện của gia đình là điều hiển nhiên.","partOfSpeech":"idiom"},"Take it easy":{"definition":"Thư giãn, nghỉ ngơi, bình tĩnh nào.","example":"Don't stress out about the test; just take it easy and do your best.","exampleTranslation":"Đừng căng thẳng về bài kiểm tra; cứ thư giãn và làm hết sức mình.","partOfSpeech":"idiom"},"take it with a grain of salt":{"definition":"Nửa tin nửa ngờ, tiếp nhận thông tin có chọn lọc và thận trọng.","example":"Take the internet rumors with a grain of salt until the company makes an official statement.","exampleTranslation":"Hãy tiếp nhận những tin đồn trên mạng một cách dè dặt cho đến khi công ty đưa ra tuyên bố chính thức.","partOfSpeech":"idiom"},"take pains":{"definition":"Chịu khó, cẩn thận chu đáo hết mực trong công việc.","example":"She took great pains to ensure that every single calculation was completely accurate.","exampleTranslation":"Cô ấy đã rất cẩn thận để đảm bảo mọi phép tính đều hoàn toàn chính xác.","partOfSpeech":"idiom"},"Take place":{"definition":"Diễn ra, được tổ chức","example":"The meeting will take place on Monday.","exampleTranslation":"Cuộc họp sẽ diễn ra vào thứ Hai.","partOfSpeech":"idiom"},"Take someone at their word":{"definition":"tin lời ai đó","example":"When she promised to help, I took her at her word.","exampleTranslation":"Khi cô ấy hứa sẽ giúp, tôi đã tin lời cô ấy.","partOfSpeech":"idiom"},"take someone for a ride":{"definition":"bị lừa gạt, bị xỏ mũi","example":"He realized he’d been taken for a ride when the car he bought broke down the next day.","exampleTranslation":"Anh ấy nhận ra mình đã bị lừa khi chiếc xe anh mua bị hỏng vào ngày hôm sau.","partOfSpeech":"idiom"},"Take something by storm":{"definition":"gây bão, chinh phục hoàn toàn","example":"The new singer took the music industry by storm.","exampleTranslation":"Ca sĩ mới đã gây bão trong ngành âm nhạc.","partOfSpeech":"idiom"},"Take something for granted":{"definition":"Coi điều gì đó là hiển nhiên (nên không trân trọng).","example":"Many people take clean water for granted until it's gone.","exampleTranslation":"Nhiều người coi nước sạch là điều hiển nhiên cho đến khi không còn nữa.","partOfSpeech":"idiom"},"take something in stride":{"definition":"bình tĩnh đối mặt, đương đầu một cách nhẹ nhàng","example":"She took the bad news in stride and continued to focus on her work.","exampleTranslation":"Cô ấy đón nhận tin xấu một cách bình thản và tiếp tục tập trung vào công việc.","partOfSpeech":"idiom"},"Take something with a grain of salt":{"definition":"bán tín bán nghi, không hoàn toàn tin tưởng","example":"He told me an incredible story, but I decided to take it with a grain of salt.","exampleTranslation":"Anh ấy kể cho tôi một câu chuyện khó tin, nhưng tôi quyết định tiếp nhận nó một cách dè dặt.","partOfSpeech":"idiom"},"take the cake":{"definition":"tồi tệ nhất, sốc nhất (mang ý mỉa mai); đỉnh nhất","example":"Out of all the mistakes, that one really takes the cake.","exampleTranslation":"Trong tất cả các sai lầm, cái đó thực sự là tệ nhất.","partOfSpeech":"idiom"},"take the floor":{"definition":"phát biểu ý kiến, lên tiếng","example":"After the chairman’s introduction, she was invited to take the floor and present her ideas.","exampleTranslation":"Sau phần giới thiệu của chủ tịch, cô ấy được mời lên phát biểu và trình bày ý tưởng của mình.","partOfSpeech":"idiom"},"take the plunge":{"definition":"quyết định liều lĩnh, đánh liều làm gì","example":"After years of working in a corporate job, she finally decided to take the plunge and start her own business.","exampleTranslation":"Sau nhiều năm làm việc trong một công ty lớn, cuối cùng cô ấy quyết định mạo hiểm và tự khởi nghiệp.","partOfSpeech":"idiom"},"take the wind out of someone's sails":{"definition":"làm ai đó nản lòng, nhụt chí","example":"When I found out I didn’t get the job, it took the wind out of my sails.","exampleTranslation":"Khi biết mình không được nhận vào làm, tôi như bị dội gáo nước lạnh.","partOfSpeech":"idiom"},"take with a grain of salt":{"definition":"Bán tín bán nghi, nghe với thái độ dè dặt có chọn lọc.","example":"You should take online gossip with a grain of salt until verified by official sources.","exampleTranslation":"Bạn nên tiếp nhận những tin đồn trên mạng một cách dè dặt cho đến khi được xác minh bởi các nguồn chính thức.","partOfSpeech":"idiom"},"take your time":{"definition":"Cứ từ từ, thong thả mà làm (không cần phải vội).","example":"Take your time reviewing the contract; we do not need your signature until next week.","exampleTranslation":"Cứ từ từ xem hợp đồng; chúng tôi chưa cần chữ ký của bạn cho đến tuần sau.","partOfSpeech":"idiom"},"talk a blue streak":{"definition":"nói liến thoắng, nói thao thao bất tuyệt","example":"When she gets nervous, she tends to talk a blue streak.","exampleTranslation":"Khi cô ấy lo lắng, cô thường nói liên tục không ngừng.","partOfSpeech":"idiom"},"talk shop":{"definition":"nói chuyện công việc (trong lúc nghỉ ngơi hoặc giao lưu)","example":"Whenever those two get together, they can’t help but start talking shop.","exampleTranslation":"Mỗi khi hai người đó gặp nhau, họ không thể không bắt đầu nói chuyện công việc.","partOfSpeech":"idiom"},"talk someone's ear off":{"definition":"nói đinh tai nhức óc, nói không ngừng nghỉ","example":"He can really talk your ear off about his new hobby.","exampleTranslation":"Anh ấy thực sự có thể nói liên tục không ngừng về sở thích mới của mình.","partOfSpeech":"idiom"},"talk through one's hat":{"definition":"nói khoác, nói bừa không có căn cứ","example":"Stop talking through your hat and do some research before making such claims.","exampleTranslation":"Đừng nói bừa nữa và hãy nghiên cứu trước khi đưa ra những tuyên bố như vậy.","partOfSpeech":"idiom"},"talk to someone like a Dutch uncle":{"definition":"mắng mỏ hoặc khuyên răn một cách nghiêm khắc nhưng có ý tốt","example":"When I was slacking off, my mentor sat me down and talked to me like a Dutch uncle.","exampleTranslation":"Khi tôi lười biếng, người cố vấn của tôi đã gọi tôi lại và nói chuyện thẳng thắn như một người lớn tuổi nghiêm khắc.","partOfSpeech":"idiom"},"talk to the hand":{"definition":"miễn trình bày, không muốn nghe đâu","example":"She waved her hand and said talk to the hand.","exampleTranslation":"Cô ấy vẫy tay và nói đừng nói nữa, tôi không muốn nghe.","partOfSpeech":"idiom"},"talk turkey":{"definition":"nói thẳng vào vấn đề, bàn luận nghiêm túc","example":"Let’s talk turkey about the deal and see if we can agree.","exampleTranslation":"Hãy nói chuyện thẳng thắn về thương vụ và xem chúng ta có thể đồng ý không.","partOfSpeech":"idiom"},"tall order":{"definition":"một yêu cầu khó khăn, một nhiệm vụ gian nan","example":"Getting everyone to agree on the new plan will be a tall order.","exampleTranslation":"Làm cho mọi người đồng ý với kế hoạch mới sẽ là một việc rất khó.","partOfSpeech":"idiom"},"tar someone with the same brush":{"definition":"vơ đũa cả nắm, đánh đồng","example":"Just because he made a mistake doesn’t mean you should tar everyone with the same brush.","exampleTranslation":"Chỉ vì anh ấy mắc sai lầm không có nghĩa là bạn nên đánh đồng tất cả mọi người.","partOfSpeech":"idiom"},"teacher's pet":{"definition":"Trò cưng của thầy cô (đôi khi mang nghĩa châm biếm).","example":"He was always sitting in the front row and answering every question, acting like a teacher's pet.","exampleTranslation":"Anh ta luôn ngồi hàng đầu và trả lời mọi câu hỏi, cư xử như học trò cưng của thầy.","partOfSpeech":"idiom"},"tell me about it":{"definition":"tôi hiểu mà, khỏi phải nói","example":"I am so tired today, tell me about it.","exampleTranslation":"Hôm nay tôi mệt quá, tôi hiểu mà.","partOfSpeech":"idiom"},"test the waters":{"definition":"thăm dò ý kiến, thử nghiệm trước","example":"We should test the waters before committing to the new project.","exampleTranslation":"Chúng ta nên thăm dò trước khi cam kết với dự án mới.","partOfSpeech":"idiom"},"that is to say":{"definition":"có nghĩa là, nói cách khác","example":"The project failed, that is to say, it didn’t meet our expectations.","exampleTranslation":"Dự án đã thất bại, nói cách khác là nó không đáp ứng kỳ vọng của chúng tôi.","partOfSpeech":"idiom"},"that ship has sailed":{"definition":"cơ hội đã trôi qua, ván đã đóng thuyền","example":"We were considering buying that house last month, but now that ship has sailed.","exampleTranslation":"Tháng trước chúng tôi đã cân nhắc mua ngôi nhà đó, nhưng giờ thì cơ hội đã qua rồi.","partOfSpeech":"idiom"},"that's all she wrote":{"definition":"thế là hết, chấm hết","example":"After the team lost the final game, that’s all she wrote.","exampleTranslation":"Sau khi đội thua trận chung kết, mọi chuyện coi như kết thúc.","partOfSpeech":"idiom"},"the apple of someone's eye":{"definition":"người được yêu thương, trân trọng nhất","example":"My daughter is the apple of my eye.","exampleTranslation":"Con gái tôi là người tôi yêu thương nhất.","partOfSpeech":"idiom"},"the ball is in your court":{"definition":"quyết định giờ nằm ở bạn, đến lượt bạn","example":"I’ve given you all the information. Now the ball is in your court.","exampleTranslation":"Tôi đã cung cấp cho bạn tất cả thông tin. Giờ đến lượt bạn hành động.","partOfSpeech":"idiom"},"the bee's knees":{"definition":"xuất sắc, đỉnh của chóp","example":"Her homemade apple pie is the bee’s knees.","exampleTranslation":"Chiếc bánh táo tự làm của cô ấy ngon tuyệt cú mèo.","partOfSpeech":"idiom"},"the best of both worlds":{"definition":"vẹn cả đôi đường, được cả chì lẫn chài","example":"Working from home gives me the best of both worlds; I can be productive and spend more time with my family.","exampleTranslation":"Làm việc tại nhà cho tôi được cả đôi đường; tôi có thể làm việc hiệu quả và dành nhiều thời gian hơn cho gia đình.","partOfSpeech":"idiom"},"the best thing since sliced bread":{"definition":"phát minh vĩ đại nhất, một thứ tuyệt vời","example":"Everyone at the office says that the new coffee machine is the best thing since sliced bread.","exampleTranslation":"Mọi người ở văn phòng đều nói chiếc máy pha cà phê mới là phát minh tuyệt vời nhất.","partOfSpeech":"idiom"},"the Big Apple":{"definition":"Quả Táo Lớn (biệt danh của thành phố New York)","example":"They took a trip to The Big Apple to see a Broadway show.","exampleTranslation":"Họ đã có chuyến đi đến Thành phố New York để xem một vở nhạc kịch Broadway.","partOfSpeech":"idiom"},"the Big Easy":{"definition":"biệt danh của thành phố New Orleans","example":"We decided to take a vacation in The Big Easy to enjoy some jazz music.","exampleTranslation":"Chúng tôi quyết định đi nghỉ ở New Orleans để thưởng thức nhạc jazz.","partOfSpeech":"idiom"},"the bottom line":{"definition":"điểm mấu chốt, điểm quan trọng nhất","example":"You can offer all the excuses you want, but the bottom line is that the project is late.","exampleTranslation":"Bạn có thể đưa ra bao nhiêu lý do tùy thích, nhưng điều cốt yếu là dự án bị trễ.","partOfSpeech":"idiom"},"the boys in blue":{"definition":"cảnh sát","example":"When trouble started, we called the boys in blue immediately.","exampleTranslation":"Khi rắc rối bắt đầu, chúng tôi lập tức gọi cảnh sát.","partOfSpeech":"idiom"},"the burning question":{"definition":"câu hỏi cấp bách, vấn đề nóng hổi","example":"Everyone in the meeting had the same burning question: when will the new project start?","exampleTranslation":"Mọi người trong cuộc họp đều có cùng một câu hỏi nóng bỏng: khi nào dự án mới bắt đầu?","partOfSpeech":"idiom"},"the cat's meow":{"definition":"tuyệt cú mèo, hết sẩy","example":"The new restaurant in town is the cat’s meow; the food is amazing!","exampleTranslation":"Nhà hàng mới trong thị trấn là hạng nhất; đồ ăn tuyệt vời!","partOfSpeech":"idiom"},"the devil is in the details":{"definition":"mấu chốt nằm ở chi tiết, chi tiết nhỏ có thể gây rắc rối lớn","example":"The devil is in the details, so we need to review every part of the contract carefully.","exampleTranslation":"Ma quỷ nằm ở chi tiết, nên chúng ta cần xem xét cẩn thận từng phần của hợp đồng.","partOfSpeech":"idiom"},"the early bird gets the worm":{"definition":"trâu chậm uống nước đục, ai đến trước thì được","example":"If you want the best deals, remember that the early bird gets the worm.","exampleTranslation":"Nếu muốn có những ưu đãi tốt nhất, hãy nhớ rằng chim dậy sớm sẽ bắt được sâu.","partOfSpeech":"idiom"},"the elephant in the room":{"definition":"vấn đề rõ rành rành nhưng ai cũng né tránh","example":"We need to address the elephant in the room — why sales are declining.","exampleTranslation":"Chúng ta cần giải quyết vấn đề hiển nhiên mà ai cũng né tránh — tại sao doanh số đang giảm.","partOfSpeech":"idiom"},"the eleventh hour":{"definition":"vào phút chót, phút thứ 89","example":"They presented their project at the eleventh hour.","exampleTranslation":"Họ đã trình bày dự án vào phút chót.","partOfSpeech":"idiom"},"the gift of the gab":{"definition":"có tài ăn nói, khéo ăn nói","example":"John has the gift of the gab; he can persuade anyone to buy anything.","exampleTranslation":"John có tài ăn nói; anh ấy có thể thuyết phục bất kỳ ai mua bất cứ thứ gì.","partOfSpeech":"idiom"},"The hilt":{"definition":"Hết mình, triệt để, tới bến.","example":"He backed his friend's idea to the hilt.","exampleTranslation":"Anh ấy ủng hộ ý tưởng của bạn mình hết mình.","partOfSpeech":"idiom"},"The jury is still out":{"definition":"Chưa ngã ngũ, chưa có kết luận chính thức về việc gì.","example":"The jury is still out on whether the new policy will be effective.","exampleTranslation":"Vẫn chưa ngã ngũ liệu chính sách mới có hiệu quả hay không.","partOfSpeech":"idiom"},"the last minute":{"definition":"vào phút chót, ngay trước khi quá muộn","example":"He always does his homework at the last minute.","exampleTranslation":"Anh ấy luôn làm bài tập về nhà vào phút chót.","partOfSpeech":"idiom"},"The last straw":{"definition":"Giọt nước tràn ly.","example":"The broken vase was the last straw; she couldn't take the chaos anymore.","exampleTranslation":"Chiếc bình vỡ là giọt nước tràn ly; cô ấy không thể chịu nổi sự hỗn loạn nữa.","partOfSpeech":"idiom"},"The life of Riley":{"definition":"Cuộc sống sung túc, nhàn hạ.","example":"Ever since he won the lottery, he's been living the life of Riley.","exampleTranslation":"Kể từ khi trúng số, anh ấy sống cuộc sống sung sướng nhàn hạ.","partOfSpeech":"idiom"},"The light of my life":{"definition":"Nguồn sống, ánh sáng của đời ai đó.","example":"My daughter is the light of my life; she brings joy to every day.","exampleTranslation":"Con gái tôi là ánh sáng của đời tôi; con mang lại niềm vui cho mỗi ngày.","partOfSpeech":"idiom"},"the lion's share":{"definition":"phần lớn nhất, thị phần lớn nhất","example":"The manager took the lion’s share of the credit for the project’s success.","exampleTranslation":"Người quản lý đã giành phần lớn công lao cho thành công của dự án.","partOfSpeech":"idiom"},"the long and short of it":{"definition":"tóm lại là, tóm gọn lại","example":"She gave a long explanation, but the long and short of it is that she can’t come to the party.","exampleTranslation":"Cô ấy giải thích dài dòng, nhưng tóm lại là cô ấy không thể đến bữa tiệc.","partOfSpeech":"idiom"},"the munchies":{"definition":"cơn thèm ăn vặt","example":"After the party, everyone had the munchies and raided the fridge.","exampleTranslation":"Sau bữa tiệc, ai cũng thấy thèm ăn vặt và lục tung tủ lạnh.","partOfSpeech":"idiom"},"the other day":{"definition":"hôm nọ, mấy hôm trước","example":"I saw John at the grocery store the other day.","exampleTranslation":"Hôm trước tôi đã gặp John ở cửa hàng tạp hóa.","partOfSpeech":"idiom"},"the patience of Job":{"definition":"sự kiên nhẫn phi thường","example":"He must have the patience of Job to deal with all those difficult clients.","exampleTranslation":"Anh ấy chắc phải có sự kiên nhẫn như Job mới đối phó được với tất cả những khách hàng khó tính đó.","partOfSpeech":"idiom"},"the pits":{"definition":"cực kỳ tệ hại, tồi tệ nhất","example":"Missing the bus on a rainy day is just the pits.","exampleTranslation":"Lỡ xe buýt vào một ngày mưa thật là tệ hết sức.","partOfSpeech":"idiom"},"the pot calling the kettle black":{"definition":"chó chê mèo lắm lông, lươn ngắn chê chạch dài","example":"When John complained about Sarah being late, it was like the pot calling the kettle black - he’s always late himself.","exampleTranslation":"Khi John phàn nàn về việc Sarah đến muộn, thật chẳng khác nào nồi nào chê nồi nào đen — anh ấy cũng luôn đến muộn.","partOfSpeech":"idiom"},"the real McCoy":{"definition":"Đồ thật, hàng thật (không phải đồ giả)","example":"This vintage watch is the real McCoy, not a replica.","exampleTranslation":"Chiếc đồng hồ cổ này là hàng thật, không phải bản sao.","partOfSpeech":"idiom"},"The road less travelled":{"definition":"Con đường ít người đi; Lối đi riêng","example":"Choosing the road less travelled often means facing more challenges, but can also lead to greater rewards.","exampleTranslation":"Chọn con đường ít người đi thường có nghĩa là đối mặt với nhiều thử thách hơn, nhưng cũng có thể dẫn đến phần thưởng lớn hơn.","partOfSpeech":"idiom"},"The school of hard knocks":{"definition":"Trường đời","example":"She never went to college but learned everything she knows from the school of hard knocks.","exampleTranslation":"Cô ấy chưa bao giờ học đại học nhưng đã học mọi thứ cô biết từ trường đời.","partOfSpeech":"idiom"},"The shoe is on the other foot":{"definition":"Tình thế đảo ngược","example":"With the shoe on the other foot, she quickly changed her opinion about the policy.","exampleTranslation":"Khi vị trí đã đổi chiều, cô ấy nhanh chóng thay đổi quan điểm về chính sách.","partOfSpeech":"idiom"},"The short end of the stick":{"definition":"Chịu thiệt thòi; Nhận phần thiệt","example":"If you don’t ask for what you deserve, you’ll end up with the short end of the stick.","exampleTranslation":"Nếu bạn không đòi hỏi những gì mình xứng đáng, bạn sẽ chịu thiệt thòi.","partOfSpeech":"idiom"},"The squeaky wheel gets the grease":{"definition":"Con có khóc mẹ mới cho bú","example":"If you want your request to be prioritized, remember: The squeaky wheel gets the grease.","exampleTranslation":"Nếu muốn yêu cầu được ưu tiên, hãy nhớ: cứ lên tiếng thì mới được chú ý.","partOfSpeech":"idiom"},"The straight and narrow":{"definition":"Lối sống trung thực, ngay thẳng","example":"Parents hope their children will remain on the straight and narrow as they grow up.","exampleTranslation":"Cha mẹ hy vọng con cái sẽ sống đúng mực khi lớn lên.","partOfSpeech":"idiom"},"The tide has turned":{"definition":"Tình thế đã thay đổi; Đảo chiều","example":"I felt hopeless at first, but now it seems the tide has turned in my favor.","exampleTranslation":"Lúc đầu tôi cảm thấy tuyệt vọng, nhưng giờ dường như tình thế đã xoay chuyển có lợi cho tôi.","partOfSpeech":"idiom"},"The tip of the iceberg":{"definition":"Phần nổi của tảng băng chìm","example":"The recent scandal is just the tip of the iceberg; there’s a lot more we don’t know yet.","exampleTranslation":"Vụ bê bối gần đây chỉ là phần nổi của tảng băng chìm; còn nhiều điều chúng ta chưa biết.","partOfSpeech":"idiom"},"The whole ball of wax":{"definition":"Tất tần tật, toàn bộ mọi thứ","example":"When you buy this service, you get the whole ball of wax – technical support, free updates, and maintenance.","exampleTranslation":"Khi bạn mua dịch vụ này, bạn nhận được trọn gói — hỗ trợ kỹ thuật, cập nhật miễn phí và bảo trì.","partOfSpeech":"idiom"},"The whole nine yards":{"definition":"Tất tần tật; Mọi thứ có thể","example":"When preparing for the presentation, she went the whole nine yards to make sure everything was perfect.","exampleTranslation":"Khi chuẩn bị cho bài thuyết trình, cô ấy đã làm hết sức mình để đảm bảo mọi thứ đều hoàn hảo.","partOfSpeech":"idiom"},"There are plenty of other fish in the sea":{"definition":"Đời còn dài giai còn nhiều; Thiếu gì người khác","example":"After losing that job opportunity, remember that there are other fish in the sea.","exampleTranslation":"Sau khi mất cơ hội việc làm đó, hãy nhớ rằng còn nhiều cơ hội khác.","partOfSpeech":"idiom"},"There's a method to his madness":{"definition":"Làm chuyện điên rồ nhưng có tính toán","example":"At first, her strategy seemed random, but soon I realized there was a method to her madness.","exampleTranslation":"Lúc đầu, chiến lược của cô ấy có vẻ ngẫu nhiên, nhưng chẳng bao lâu tôi nhận ra có phương pháp trong sự điên rồ của cô ấy.","partOfSpeech":"idiom"},"There's no such thing as a free lunch":{"definition":"Không có bữa trưa nào là miễn phí; Không ai cho không ai cái gì","example":"When investing, always be cautious because there’s no such thing as a free lunch.","exampleTranslation":"Khi đầu tư, hãy luôn thận trọng vì không có bữa trưa nào miễn phí.","partOfSpeech":"idiom"},"Think outside the box":{"definition":"Suy nghĩ đột phá; Tư duy vượt giới hạn","example":"Sometimes, the best solutions come from thinking outside the box.","exampleTranslation":"Đôi khi, những giải pháp tốt nhất đến từ việc suy nghĩ sáng tạo ngoài khuôn khổ.","partOfSpeech":"idiom"},"Third time's a charm":{"definition":"Quá tam ba bận; Lần thứ ba sẽ thành công","example":"They lost their first two games, but they believe third time’s a charm for their next match.","exampleTranslation":"Họ đã thua hai trận đầu, nhưng tin rằng lần thứ ba sẽ may mắn trong trận đấu tiếp theo.","partOfSpeech":"idiom"},"This is the life":{"definition":"Đời là đây chứ đâu","example":"After a long week, finally having a day off feels like, “This is the life.","exampleTranslation":"Sau một tuần dài, cuối cùng có một ngày nghỉ, cảm giác như thốt lên: \"Đây mới là cuộc sống.\"","partOfSpeech":"idiom"},"Three sheets to the wind":{"definition":"Say bí tỉ; Say khướt","example":"You could tell he was three sheets to the wind just by looking at his stagger.","exampleTranslation":"Chỉ cần nhìn dáng đi loạng choạng là biết anh ta say khướt.","partOfSpeech":"idiom"},"thrilled to bits":{"definition":"Cực kỳ phấn khích, mừng rỡ vô cùng.","example":"She was thrilled to bits when her son got accepted into medical school.","exampleTranslation":"Cô ấy vui sướng vô cùng khi con trai được nhận vào trường y.","partOfSpeech":"idiom"},"Through thick and thin":{"definition":"Đồng cam cộng khổ; Vượt qua mọi thăng trầm","example":"Despite all the challenges, he remained loyal through thick and thin.","exampleTranslation":"Bất chấp mọi thử thách, anh ấy vẫn trung thành cùng nhau vượt qua mọi gian khó.","partOfSpeech":"idiom"},"Throw a curveball":{"definition":"Gây bất ngờ; Đưa ra một vấn đề hóc búa","example":"Just when we thought the meeting was over, he threw a curveball with a new proposal.","exampleTranslation":"Ngay khi chúng tôi nghĩ cuộc họp đã kết thúc, anh ấy lại tung ra một đề xuất mới bất ngờ.","partOfSpeech":"idiom"},"Throw a monkey wrench in the works":{"definition":"Thọc gậy bánh xe; Phá hoại kế hoạch","example":"The bad weather threw a monkey wrench into the works of our outdoor event schedules.","exampleTranslation":"Thời tiết xấu đã làm đảo lộn lịch trình sự kiện ngoài trời của chúng tôi.","partOfSpeech":"idiom"},"Throw caution to the wind":{"definition":"Liều mạng; Không màng hậu quả","example":"They decided to throw caution to the wind and invest all their savings in the new venture.","exampleTranslation":"Họ quyết định bất chấp rủi ro và đầu tư toàn bộ tiền tiết kiệm vào dự án mới.","partOfSpeech":"idiom"},"Throw someone for a loop":{"definition":"Làm ai đó bất ngờ; Gây sốc","example":"The sudden resignation of our manager threw me for a loop.","exampleTranslation":"Việc quản lý của chúng tôi đột ngột từ chức đã làm tôi choáng váng.","partOfSpeech":"idiom"},"Throw someone to the wolves":{"definition":"Bị bỏ mặc cho chết; Bị đẩy vào chỗ chết","example":"She felt like she was thrown to the wolves when she had to present in front of the entire board.","exampleTranslation":"Cô ấy cảm thấy như bị đẩy vào chỗ nguy hiểm khi phải thuyết trình trước toàn bộ hội đồng.","partOfSpeech":"idiom"},"Tickled pink":{"definition":"Vui như mở cờ trong bụng","example":"She was tickled pink when she found out she had won the contest.","exampleTranslation":"Cô ấy vui sướng khi biết mình đã thắng cuộc thi.","partOfSpeech":"idiom"},"tie the knot":{"definition":"Kết hôn, nên duyên vợ chồng, làm đám cưới.","example":"After dating for seven years, they finally decided to tie the knot this autumn.","exampleTranslation":"Sau bảy năm hẹn hò, cuối cùng họ quyết định kết hôn vào mùa thu này.","partOfSpeech":"idiom"},"tied to mother's apron strings":{"definition":"Bám váy mẹ, quá phụ thuộc vào mẹ.","example":"Even in his thirties, he is still tied to his mother's apron strings.","exampleTranslation":"Dù đã ngoài ba mươi, anh ấy vẫn còn phụ thuộc vào mẹ.","partOfSpeech":"idiom"},"Tighten your belt":{"definition":"Thắt lưng buộc bụng","example":"The company is going through a slow season, so there will be some belt-tightening measures.","exampleTranslation":"Công ty đang trải qua mùa ế ẩm, nên sẽ có một số biện pháp thắt lưng buộc bụng.","partOfSpeech":"idiom"},"Tilt at windmills":{"definition":"Đánh lộn với cối xay gió; Làm việc hão huyền","example":"Arguing with him about that old theory is just tilting at windmills.","exampleTranslation":"Tranh cãi với anh ta về lý thuyết cũ đó chỉ là đánh nhau với cối xay gió.","partOfSpeech":"idiom"},"time flies":{"definition":"Thời gian trôi nhanh như tên bắn, thoắt cái đã trôi qua.","example":"It feels like we just started the semester yesterday—how time flies!","exampleTranslation":"Cảm giác như chúng ta mới bắt đầu học kỳ hôm qua — thời gian trôi nhanh quá!","partOfSpeech":"idiom"},"Time flies when you're having fun":{"definition":"Thời gian thấm thoắt thoi đưa khi vui vẻ","example":"We were at the theme park all day, and it felt like minutes. Time flies when you’re having fun.","exampleTranslation":"Chúng tôi ở công viên giải trí cả ngày và cảm giác như chỉ mấy phút. Vui thì thời gian trôi nhanh.","partOfSpeech":"idiom"},"Time is money":{"definition":"Thời gian là vàng bạc","example":"Let’s not delay the project any longer. Remember, time is money.","exampleTranslation":"Chúng ta đừng trì hoãn dự án thêm nữa. Hãy nhớ, thời gian là vàng bạc.","partOfSpeech":"idiom"},"time will tell":{"definition":"Thời gian sẽ trả lời / Thời gian sẽ cho biết kết quả.","example":"Whether this new investment strategy succeeds, only time will tell.","exampleTranslation":"Chiến lược đầu tư mới này có thành công hay không, chỉ thời gian mới trả lời được.","partOfSpeech":"idiom"},"to make matters worse":{"definition":"Tệ hơn nữa là, lại làm cho tình hình thêm tồi tệ.","example":"Our car broke down in the middle of nowhere, and to make matters worse, it started to rain heavily.","exampleTranslation":"Xe của chúng tôi hỏng giữa nơi hoang vắng, và tệ hơn nữa là trời bắt đầu mưa lớn.","partOfSpeech":"idiom"},"Tongue-in-cheek":{"definition":"Nói đùa, châm biếm nhẹ nhàng.","example":"His comments about the new policy were clearly tongue-in-cheek.","exampleTranslation":"Những lời bình luận của anh ấy về chính sách mới rõ ràng là nói đùa.","partOfSpeech":"idiom"},"Too big for one's boots":{"definition":"Kiêu ngạo, hợm hĩnh, tự cao tự đại.","example":"Ever since his promotion, John has become too big for his boots.","exampleTranslation":"Kể từ khi được thăng chức, John trở nên tự cao tự đại.","partOfSpeech":"idiom"},"Too many irons in the fire":{"definition":"Ôm đồm quá nhiều việc cùng lúc.","example":"She has too many irons in the fire and can't focus on any single project.","exampleTranslation":"Cô ấy ôm đồm quá nhiều việc và không thể tập trung vào bất kỳ dự án nào.","partOfSpeech":"idiom"},"Top dog":{"definition":"Kẻ cầm đầu, người có quyền lực nhất, người dẫn đầu.","example":"In the tech industry, she is considered the top dog.","exampleTranslation":"Trong ngành công nghệ, cô ấy được coi là người đứng đầu.","partOfSpeech":"idiom"},"Top-notch":{"definition":"Xuất sắc, đỉnh cao, chất lượng tuyệt hảo","example":"The restaurant is known for its top-notch service.","exampleTranslation":"Nhà hàng nổi tiếng với dịch vụ hạng nhất.","partOfSpeech":"idiom"},"Touch and go":{"definition":"Tình huống bấp bênh, không chắc chắn","example":"It was touch and go for a while after the surgery.","exampleTranslation":"Có lúc tình hình rất nguy kịch sau ca phẫu thuật.","partOfSpeech":"idiom"},"Touch base":{"definition":"Liên lạc nhanh, trao đổi ngắn gọn","example":"Let's touch base next week to finalize the details.","exampleTranslation":"Tuần sau hãy liên lạc để chốt các chi tiết.","partOfSpeech":"idiom"},"Track record":{"definition":"Bề dày thành tích, lịch sử hoạt động","example":"She has an impressive track record in sales.","exampleTranslation":"Cô ấy có thành tích ấn tượng trong lĩnh vực bán hàng.","partOfSpeech":"idiom"},"Train of thought":{"definition":"Mạch suy nghĩ","example":"I lost my train of thought during the presentation.","exampleTranslation":"Tôi bị mất mạch suy nghĩ trong lúc thuyết trình.","partOfSpeech":"idiom"},"Train wreck":{"definition":"Thảm họa, tình trạng hỗn loạn","example":"The meeting was a complete train wreck; nothing got resolved.","exampleTranslation":"Cuộc họp là một thảm họa hoàn toàn; không có gì được giải quyết.","partOfSpeech":"idiom"},"Travel light":{"definition":"Đi du lịch gọn nhẹ, mang ít hành lý","example":"When we go camping, we always try to travel light.","exampleTranslation":"Khi đi cắm trại, chúng tôi luôn cố gắng mang theo hành lý gọn nhẹ.","partOfSpeech":"idiom"},"Treat someone to something":{"definition":"Thiết đãi, khao ai cái gì","example":"I'll treat you to dinner tonight.","exampleTranslation":"Tối nay tôi sẽ mời bạn đi ăn tối.","partOfSpeech":"idiom"},"Troubled waters":{"definition":"Tình cảnh khó khăn, rắc rối","example":"The company's financial issues have placed them in troubled waters.","exampleTranslation":"Các vấn đề tài chính của công ty đã đẩy họ vào tình thế khó khăn.","partOfSpeech":"idiom"},"True blue":{"definition":"Vô cùng trung thành, đáng tin cậy","example":"Jane is a true blue friend; you can always count on her.","exampleTranslation":"Jane là người bạn chân thành; bạn luôn có thể tin cậy cô ấy.","partOfSpeech":"idiom"},"Tuckered out":{"definition":"Kiệt sức, mệt lử","example":"After the hike, we were all tuckered out and went straight to bed.","exampleTranslation":"Sau chuyến đi bộ đường dài, tất cả chúng tôi đều kiệt sức và đi ngủ ngay.","partOfSpeech":"idiom"},"Turn a blind eye":{"definition":"Nhắm mắt làm ngơ, lờ đi","example":"The manager decided to turn a blind eye to the minor rule-breaking.","exampleTranslation":"Người quản lý quyết định làm ngơ trước những vi phạm quy tắc nhỏ.","partOfSpeech":"idiom"},"Turn a place upside down":{"definition":"Lục tung lên","example":"We had to turn the place upside down to find the missing keys.","exampleTranslation":"Chúng tôi phải lục tung cả nơi này để tìm chìa khóa bị mất.","partOfSpeech":"idiom"},"Turn over a new leaf":{"definition":"Cải tà quy chính, làm lại cuộc đời, bước sang trang mới","example":"After years of bad habits, he decided to turn over a new leaf and live healthier.","exampleTranslation":"Sau nhiều năm có thói quen xấu, anh ấy quyết định làm lại cuộc đời và sống lành mạnh hơn.","partOfSpeech":"idiom"},"Turn the other cheek":{"definition":"Chìa má kia ra (chấp nhận bị tổn thương mà không trả đũa), nhẫn nhịn","example":"When bullied in school, he chose to turn the other cheek rather than fight back.","exampleTranslation":"Khi bị bắt nạt ở trường, anh ấy chọn cách nhẫn nhịn thay vì đánh trả.","partOfSpeech":"idiom"},"Turn the tables":{"definition":"Lật ngược thế cờ","example":"He thought he could win, but she turned the tables on him.","exampleTranslation":"Anh ta nghĩ mình có thể thắng, nhưng cô ấy đã đảo ngược tình thế với anh ta.","partOfSpeech":"idiom"},"Turn up the heat":{"definition":"Gia tăng áp lực","example":"The manager turned up the heat on the sales team to reach their quarterly targets.","exampleTranslation":"Người quản lý gây áp lực lên đội bán hàng để đạt được chỉ tiêu quý.","partOfSpeech":"idiom"},"Twist someone's arm":{"definition":"Thuyết phục ai đó, ép buộc ai đó làm gì","example":"I had to twist his arm to get him to join the team.","exampleTranslation":"Tôi phải thuyết phục anh ta mãi mới khiến anh ta chịu tham gia đội.","partOfSpeech":"idiom"},"Two peas in a pod":{"definition":"Giống nhau như đúc","example":"They are two peas in a pod; they do everything together.","exampleTranslation":"Họ như hai hạt đậu trong cùng một quả; họ làm mọi việc cùng nhau.","partOfSpeech":"idiom"},"Under a cloud":{"definition":"Bị nghi ngờ, bị mang tiếng xấu","example":"Since the scandal, he's been under a cloud at work.","exampleTranslation":"Kể từ sau vụ bê bối, anh ấy bị nghi ngờ ở nơi làm việc.","partOfSpeech":"idiom"},"Under someone's thumb":{"definition":"Chịu sự sai khiến, bị ai đó kiểm soát","example":"He's completely under his boss's thumb and never makes a decision on his own.","exampleTranslation":"Anh ta hoàn toàn bị sếp kiểm soát và không bao giờ tự đưa ra quyết định.","partOfSpeech":"idiom"},"Under the table":{"definition":"Lén lút, bất hợp pháp (đặc biệt là giao dịch)","example":"He was fired for accepting money under the table.","exampleTranslation":"Anh ta bị sa thải vì nhận tiền lót tay một cách lén lút.","partOfSpeech":"idiom"},"under the weather":{"definition":"Cảm thấy mệt mỏi, khó ở, hơi ốm.","example":"I will stay home today because I am feeling a bit under the weather.","exampleTranslation":"Hôm nay tôi sẽ ở nhà vì cảm thấy hơi không khỏe.","partOfSpeech":"idiom"},"Under the wire":{"definition":"Vào phút chót, sát giờ","example":"She turned in her assignment just under the wire before the deadline.","exampleTranslation":"Cô ấy nộp bài tập vào phút chót ngay trước hạn chót.","partOfSpeech":"idiom"},"Until the cows come home":{"definition":"Rất lâu, vô tận","example":"You can wait until the cows come home, but she's not going to change her mind.","exampleTranslation":"Bạn có thể chờ mãi mãi, nhưng cô ấy sẽ không thay đổi ý định.","partOfSpeech":"idiom"},"Up a blind alley":{"definition":"Đi vào ngõ cụt, không mang lại kết quả","example":"We spent months on this project, but in the end, we realized we were up a blind alley.","exampleTranslation":"Chúng tôi đã dành nhiều tháng cho dự án này, nhưng cuối cùng nhận ra mình đã đi vào ngõ cụt.","partOfSpeech":"idiom"},"Up a gum tree":{"definition":"Gặp rắc rối lớn, tiến thoái lưỡng nan","example":"When the project lost its funding, the whole team felt up a gum tree.","exampleTranslation":"Khi dự án mất nguồn tài trợ, cả nhóm cảm thấy bế tắc.","partOfSpeech":"idiom"},"Up for grabs":{"definition":"Có sẵn để ai cũng có thể lấy/giành được","example":"The tickets to the concert are up for grabs, so act fast!","exampleTranslation":"Vé xem hòa nhạc đang sẵn có cho ai nhanh tay, nên hãy hành động nhanh!","partOfSpeech":"idiom"},"Up in arms":{"definition":"Rất tức giận, phản đối gay gắt","example":"The community is up in arms about the proposed development project.","exampleTranslation":"Cộng đồng đang phẫn nộ về dự án phát triển được đề xuất.","partOfSpeech":"idiom"},"Up in the air":{"definition":"Chưa được quyết định, còn dang dở","example":"Our vacation plans are still up in the air because we're waiting for confirmation from the hotel.","exampleTranslation":"Kế hoạch nghỉ mát của chúng tôi vẫn chưa chắc chắn vì đang chờ khách sạn xác nhận.","partOfSpeech":"idiom"},"Up the creek without a paddle":{"definition":"Lâm vào cảnh khốn cùng, bế tắc","example":"After losing his job, he felt he was up the creek without a paddle.","exampleTranslation":"Sau khi mất việc, anh ấy cảm thấy mình lâm vào tình thế khó khăn không lối thoát.","partOfSpeech":"idiom"},"Up to snuff":{"definition":"Đạt tiêu chuẩn, đủ tốt","example":"His work wasn't up to snuff, so he had to redo it.","exampleTranslation":"Công việc của anh ấy chưa đạt yêu cầu, nên anh phải làm lại.","partOfSpeech":"idiom"},"up to you":{"definition":"Tùy bạn, do bạn quyết định.","example":"We can eat Italian food or Japanese food tonight—it is completely up to you.","exampleTranslation":"Tối nay chúng ta có thể ăn món Ý hoặc món Nhật — hoàn toàn tùy bạn.","partOfSpeech":"idiom"},"Upset the apple cart":{"definition":"Làm hỏng chuyện, phá hỏng kế hoạch","example":"His unexpected resignation upset the apple cart at the company.","exampleTranslation":"Việc anh ấy đột ngột từ chức đã làm đảo lộn kế hoạch của công ty.","partOfSpeech":"idiom"},"Use your loaf":{"definition":"Động não đi, dùng cái đầu đi","example":"Come on, use your loaf! It's not that complicated.","exampleTranslation":"Thôi nào, hãy dùng đầu óc đi! Việc này không phức tạp đến vậy đâu.","partOfSpeech":"idiom"},"Veg out":{"definition":"Thư giãn hoàn toàn, không làm gì cả","example":"After a long week at work, I just want to veg out on the couch and watch movies.","exampleTranslation":"Sau một tuần làm việc dài, tôi chỉ muốn nằm dài trên ghế sô-pha xem phim.","partOfSpeech":"idiom"},"Walk in someone's shoes":{"definition":"Đặt mình vào vị trí của người khác","example":"Before criticizing her, try to walk in her shoes and understand her situation.","exampleTranslation":"Trước khi chỉ trích cô ấy, hãy thử đặt mình vào vị trí của cô ấy để hiểu hoàn cảnh của cô.","partOfSpeech":"idiom"},"Walk on air":{"definition":"Cực kỳ hạnh phúc, vui như ở trên mây","example":"After hearing the good news, she was literally walking on air.","exampleTranslation":"Sau khi nghe tin vui, cô ấy vui sướng như bay lên mây.","partOfSpeech":"idiom"},"Wallflower":{"definition":"Người nhút nhát, người ít giao tiếp (thường ở các bữa tiệc)","example":"At every party, she feels like a wallflower, afraid to dance or mingle.","exampleTranslation":"Ở bữa tiệc nào, cô ấy cũng cảm thấy như người đứng ngoài cuộc, sợ nhảy múa hay giao lưu.","partOfSpeech":"idiom"},"Wash one's hands of something":{"definition":"Rũ bỏ trách nhiệm, phủi tay","example":"After the project became too complicated, she finally said she was washing her hands of it.","exampleTranslation":"Khi dự án trở nên quá phức tạp, cuối cùng cô ấy nói rằng mình rút lui khỏi nó.","partOfSpeech":"idiom"},"Waste not, want not":{"definition":"Ăn tiêu chừng mực thì không lo túng thiếu","example":"By following the waste not, want not rule, we managed to save a lot of money over the years.","exampleTranslation":"Bằng cách tuân theo quy tắc không lãng phí thì không thiếu thốn, chúng tôi đã tiết kiệm được rất nhiều tiền qua nhiều năm.","partOfSpeech":"idiom"},"Watch out for":{"definition":"Cẩn thận, coi chừng","example":"Watch out for that car while crossing the street.","exampleTranslation":"Hãy cẩn thận chiếc xe đó khi bạn băng qua đường.","partOfSpeech":"idiom"},"Water under the bridge":{"definition":"Chuyện đã qua, không còn quan trọng nữa","example":"We had our differences in the past, but it's all water under the bridge now.","exampleTranslation":"Chúng ta từng có những bất đồng trong quá khứ, nhưng giờ tất cả đã qua rồi.","partOfSpeech":"idiom"},"Watering hole":{"definition":"Quán rượu, nơi tụ tập uống rượu","example":"The local pub has become my favorite watering hole.","exampleTranslation":"Quán rượu địa phương đã trở thành nơi yêu thích để tôi ghé đến.","partOfSpeech":"idiom"},"Wave of the future":{"definition":"Xu hướng của tương lai","example":"Electric cars are the wave of the future.","exampleTranslation":"Xe điện là làn sóng của tương lai.","partOfSpeech":"idiom"},"Wear many hats":{"definition":"Đảm nhiệm nhiều vai trò, kiêm nhiệm nhiều việc","example":"In a small company, employees often have to wear many different hats to get things done.","exampleTranslation":"Trong một công ty nhỏ, nhân viên thường phải đảm nhận nhiều vai trò khác nhau để hoàn thành công việc.","partOfSpeech":"idiom"},"Wear one's heart on one's sleeve":{"definition":"Ruột để ngoài da, bộc lộ rõ cảm xúc ra ngoài","example":"John always wears his heart on his sleeve, you can tell when he's upset.","exampleTranslation":"John luôn bộc lộ cảm xúc ra mặt, bạn có thể biết khi nào anh ấy buồn.","partOfSpeech":"idiom"},"wear the pants":{"definition":"Nắm quyền trong nhà, làm chủ mối quan hệ/gia đình.","example":"Everyone knows that his wife wears the pants in their household.","exampleTranslation":"Ai cũng biết vợ anh ấy là người làm chủ trong gia đình họ.","partOfSpeech":"idiom"},"wear your heart on your sleeve":{"definition":"Ruột để ngoài da, bộc lộ tình cảm một cách chân thật và rõ ràng.","example":"He always wears his heart on his sleeve, so you never have to guess what he is thinking.","exampleTranslation":"Anh ấy luôn để lộ cảm xúc, nên bạn không bao giờ phải đoán anh ấy đang nghĩ gì.","partOfSpeech":"idiom"},"Weasel out of something":{"definition":"Trốn tránh trách nhiệm một cách khôn lỏi","example":"She tried to weasel out of paying her share of the bill.","exampleTranslation":"Cô ấy cố trốn tránh việc trả phần của mình trong hóa đơn.","partOfSpeech":"idiom"},"Weather the storm":{"definition":"Vượt qua khó khăn, sóng gió","example":"She has weathered many storms in her career and emerged stronger each time.","exampleTranslation":"Cô ấy đã vượt qua nhiều sóng gió trong sự nghiệp và mỗi lần đều mạnh mẽ hơn.","partOfSpeech":"idiom"},"Well begun is half done":{"definition":"Đầu xuôi đuôi lọt, khởi đầu tốt là đã thành công một nửa","example":"Remember, well begun is half done, so take your time with initial preparations.","exampleTranslation":"Hãy nhớ, đầu xuôi đuôi lọt, nên hãy dành thời gian cho khâu chuẩn bị ban đầu.","partOfSpeech":"idiom"},"Well-heeled":{"definition":"Giàu có, rủng rỉnh tiền bạc","example":"The banquet was attended by many well-heeled guests.","exampleTranslation":"Bữa tiệc có nhiều vị khách giàu có tham dự.","partOfSpeech":"idiom"},"Wet behind the ears":{"definition":"Trẻ người non dạ, còn non nớt (thiếu kinh nghiệm)","example":"He may seem confident, but he's still wet behind the ears when it comes to finance.","exampleTranslation":"Anh ấy có vẻ tự tin, nhưng vẫn còn non nớt khi nói đến tài chính.","partOfSpeech":"idiom"},"Wet blanket":{"definition":"Kẻ phá đám, người làm mất vui","example":"Don't be a wet blanket; join us for the party!","exampleTranslation":"Đừng làm người phá đám; hãy tham gia bữa tiệc với chúng tôi!","partOfSpeech":"idiom"},"Wet one's whistle":{"definition":"Uống chút gì đó (thường là rượu bia) cho thấm giọng","example":"After a long day, he wanted to stop at the bar and wet his whistle.","exampleTranslation":"Sau một ngày dài, anh ấy muốn ghé quán bar uống chút gì cho đỡ khát.","partOfSpeech":"idiom"},"What are you up to?":{"definition":"Dạo này bạn thế nào? / Bạn đang làm gì đó?","example":"Hey John, what are you up to this weekend?","exampleTranslation":"Này John, cuối tuần này bạn định làm gì?","partOfSpeech":"idiom"},"When it rains, it pours":{"definition":"Họa vô đơn chí, họa không tới một mình","example":"First, I got a flat tire, and then my favorite coffee shop closed — when it rains, it pours.","exampleTranslation":"Đầu tiên tôi bị xẹp lốp xe, sau đó quán cà phê yêu thích của tôi đóng cửa — họa vô đơn chí.","partOfSpeech":"idiom"},"When pigs fly":{"definition":"Chuyện hoang đường, không bao giờ xảy ra (chuyện mặt trời mọc đằng tây)","example":"He said he'd tidy his room, but that will happen when pigs fly.","exampleTranslation":"Anh ấy nói sẽ dọn phòng, nhưng chuyện đó chỉ xảy ra khi heo biết bay.","partOfSpeech":"idiom"},"When push comes to shove":{"definition":"Khi đến bước đường cùng, trong tình huống khẩn cấp","example":"When push comes to shove, we can always count on Susan to take charge.","exampleTranslation":"Khi tình thế căng thẳng, chúng ta luôn có thể dựa vào Susan để đảm nhận trách nhiệm.","partOfSpeech":"idiom"},"When the chips are down":{"definition":"Trong những lúc khó khăn nhất, khi tình hình trở nên nghiêm trọng","example":"When the chips are down, true friends will be there for you.","exampleTranslation":"Khi gặp khó khăn, những người bạn thật sự sẽ ở bên bạn.","partOfSpeech":"idiom"},"Where the rubber meets the road":{"definition":"Nơi thử thách thực sự, lúc lý thuyết được đưa vào thực tiễn","example":"We can plan all we want, but this idea really shows its value where the rubber meets the road.","exampleTranslation":"Chúng ta có thể lập kế hoạch thoải mái, nhưng ý tưởng này chỉ thực sự thể hiện giá trị khi đưa vào thực tế.","partOfSpeech":"idiom"},"Where were we?":{"definition":"Chúng ta đang nói đến đâu rồi nhỉ?","example":"Sorry for the interruption. Where were we?","exampleTranslation":"Xin lỗi vì đã làm gián đoạn. Chúng ta đang nói đến đâu rồi nhỉ?","partOfSpeech":"idiom"},"White elephant":{"definition":"Sự vật đắt tiền nhưng vô dụng hoặc tốn kém để bảo trì","example":"The new stadium turned out to be a white elephant; nobody uses it, and the maintenance costs are skyrocketing.","exampleTranslation":"Sân vận động mới hóa ra là một món đồ vô dụng tốn kém; không ai dùng, và chi phí bảo trì đang tăng vọt.","partOfSpeech":"idiom"},"White lie":{"definition":"Lời nói dối vô hại, lời nói dối thiện ý","example":"She told a white lie to spare his feelings.","exampleTranslation":"Cô ấy nói dối vô hại để không làm anh ấy tổn thương.","partOfSpeech":"idiom"},"Whitewash":{"definition":"Che đậy sự thật, tẩy trắng (tội lỗi)","example":"The company tried to whitewash the environmental disaster it caused.","exampleTranslation":"Công ty đã cố gắng che đậy thảm họa môi trường mà họ gây ra.","partOfSpeech":"idiom"},"Who asked you?":{"definition":"Ai mướn bạn nói? / Ai hỏi bạn đâu?","example":"\"Who asked you?\" she replied angrily.","exampleTranslation":"\"Ai hỏi cô?\" cô ấy đáp lại một cách giận dữ.","partOfSpeech":"idiom"},"Who do you think you are?":{"definition":"Bạn nghĩ bạn là ai chứ?","example":"Who do you think you are?","exampleTranslation":"Bạn nghĩ mình là ai chứ?","partOfSpeech":"idiom"},"wicked":{"definition":"đỉnh thật, ngầu quá","example":"Wow, your skateboard tricks are wicked!","exampleTranslation":"Wow, mấy chiêu trượt ván của bạn tuyệt thật!","partOfSpeech":"idiom"},"Wild and woolly":{"definition":"Hỗn loạn, hoang dã và thiếu kiểm soát","example":"The party last night was wild and woolly; no one knew what would happen next.","exampleTranslation":"Bữa tiệc tối qua cực kỳ hỗn loạn; không ai biết điều gì sẽ xảy ra tiếp theo.","partOfSpeech":"idiom"},"window shopping":{"definition":"Đi ngắm đồ qua tủ kính (đi dạo xem đồ chứ không mua).","example":"We spent a relaxing Sunday afternoon window shopping along the boulevard.","exampleTranslation":"Chúng tôi đã dành một chiều Chủ nhật thư giãn ngắm đồ qua cửa kính dọc đại lộ.","partOfSpeech":"idiom"},"Wine and dine":{"definition":"Thiết đãi nồng hậu, chiêu đãi thịnh soạn","example":"He wined and dined his prospective clients at the fancy restaurant.","exampleTranslation":"Anh ấy đã chiêu đãi các khách hàng tiềm năng tại nhà hàng sang trọng.","partOfSpeech":"idiom"},"Wing it":{"definition":"Tùy cơ ứng biến, làm mà không có sự chuẩn bị trước","example":"I forgot my speech notes, so I had to wing it during the presentation.","exampleTranslation":"Tôi quên ghi chú bài phát biểu, nên phải ứng khẩu trong lúc thuyết trình.","partOfSpeech":"idiom"},"With bated breath":{"definition":"Nín thở chờ đợi, hồi hộp mong đợi","example":"Everyone in the room was listening with bated breath as the announcement was made.","exampleTranslation":"Mọi người trong phòng đều nín thở lắng nghe khi thông báo được đưa ra.","partOfSpeech":"idiom"},"With bells on":{"definition":"Với thái độ vô cùng háo hức và nhiệt tình","example":"Count me in for the trip; I'll be there with bells on.","exampleTranslation":"Hãy tính tôi vào chuyến đi; tôi sẽ có mặt với niềm vui lớn.","partOfSpeech":"idiom"},"With flying colors":{"definition":"Một cách xuất sắc, thành công mỹ mãn","example":"She passed the exam with flying colors.","exampleTranslation":"Cô ấy đã vượt qua kỳ thi với kết quả xuất sắc.","partOfSpeech":"idiom"},"Work against the clock":{"definition":"Chạy đua với thời gian, làm việc khẩn trương","example":"We're working against the clock to complete the project before the deadline.","exampleTranslation":"Chúng tôi đang chạy đua với thời gian để hoàn thành dự án trước hạn chót.","partOfSpeech":"idiom"},"Worth one's salt":{"definition":"Đáng đồng tiền bát gạo, có năng lực xứng đáng với vị trí","example":"Any chef worth their salt knows how to prepare a perfect steak.","exampleTranslation":"Bất kỳ đầu bếp giỏi nào cũng biết cách chế biến một miếng bít tết hoàn hảo.","partOfSpeech":"idiom"},"Wouldn't be caught dead":{"definition":"Thà chết còn hơn, nhất quyết không bao giờ làm","example":"He wouldn't be caught dead wearing those old-fashioned shoes.","exampleTranslation":"Anh ấy chết cũng không mặc đôi giày lỗi thời đó.","partOfSpeech":"idiom"},"Wouldn't hurt a fly":{"definition":"Rất hiền lành, hiền như cục đất (không dám làm hại một con ruồi)","example":"John is the sweetest person; he wouldn't hurt a fly.","exampleTranslation":"John là người hiền lành nhất; anh ấy không làm hại ai bao giờ.","partOfSpeech":"idiom"},"Wouldn't touch it with a ten-foot pole":{"definition":"Tránh xa ra, có cho thêm tiền cũng không dám đụng vào","example":"That investment seems too risky; I wouldn't touch it with a ten-foot pole.","exampleTranslation":"Khoản đầu tư đó có vẻ quá rủi ro; tôi sẽ không dính vào nó chút nào.","partOfSpeech":"idiom"},"Wrap one's head around something":{"definition":"Cố gắng hiểu hoặc chấp nhận một điều gì đó phức tạp","example":"It took him a while to wrap his head around the new software program.","exampleTranslation":"Anh ấy mất một lúc mới hiểu được chương trình phần mềm mới.","partOfSpeech":"idiom"},"wrap your head around":{"definition":"Hiểu thấu, tiêu hóa hay chấp nhận một khái niệm phức tạp.","example":"Quantum physics is a fascinating subject, but it takes time to wrap your head around its principles.","exampleTranslation":"Vật lý lượng tử là một chủ đề hấp dẫn, nhưng cần thời gian để hiểu được các nguyên lý của nó.","partOfSpeech":"idiom"},"X marks the spot":{"definition":"Chính là chỗ này, đúng ngay điểm này","example":"The treasure map shows that X marks the spot where the gold is buried.","exampleTranslation":"Bản đồ kho báu cho thấy dấu X đánh dấu nơi chôn vàng.","partOfSpeech":"idiom"},"You bet":{"definition":"Chắc chắn rồi, tất nhiên rồi","example":"Will you help me with this project? You bet!","exampleTranslation":"Bạn sẽ giúp tôi làm dự án này chứ? Chắc chắn rồi!","partOfSpeech":"idiom"},"You can bet your boots":{"definition":"Dám cá là, chắc chắn một trăm phần trăm","example":"When he says he'll finish the project by Friday, you can bet your boots he will.","exampleTranslation":"Khi anh ấy nói sẽ hoàn thành dự án vào thứ Sáu, bạn có thể tin chắc là anh ấy sẽ làm được.","partOfSpeech":"idiom"},"You can bet your bottom dollar":{"definition":"Đảm bảo luôn, dám cá bằng đồng xu cuối cùng","example":"You can bet your bottom dollar that she'll be at the party tonight.","exampleTranslation":"Bạn có thể tin chắc rằng cô ấy sẽ có mặt ở bữa tiệc tối nay.","partOfSpeech":"idiom"},"You can lead a horse to water, but you can't make him drink":{"definition":"Có thể mang lại cơ hội cho ai đó nhưng không thể ép họ đón nhận (không thể ép ai làm việc họ không muốn)","example":"I gave her all the tools to succeed, but she still failed. You can lead a horse to water, but you can't make him drink.","exampleTranslation":"Tôi đã đưa cho cô ấy mọi công cụ để thành công, nhưng cô ấy vẫn thất bại. Bạn có thể dẫn ngựa đến bên nước, nhưng không thể bắt nó uống.","partOfSpeech":"idiom"},"You can say that again":{"definition":"Bạn nói quá chuẩn, hoàn toàn đồng ý","example":"The weather is beautiful today; you can say that again.","exampleTranslation":"Hôm nay thời tiết đẹp; bạn nói đúng quá.","partOfSpeech":"idiom"},"You can't have your cake and eat it too":{"definition":"Được cái này mất cái kia, không thể bắt cá hai tay","example":"He wants the promotion without working hard. Well, you can't have your cake and eat it too.","exampleTranslation":"Anh ta muốn được thăng chức mà không phải làm việc chăm chỉ. Vâng, bạn không thể vừa có bánh vừa ăn bánh.","partOfSpeech":"idiom"},"You can't judge a book by its cover":{"definition":"Đừng trông mặt mà bắt hình dong","example":"The old house may look shabby, but you can't judge a book by its cover. It is beautifully decorated inside.","exampleTranslation":"Ngôi nhà cũ trông có vẻ tồi tàn, nhưng bạn không thể đánh giá qua bề ngoài. Bên trong được trang trí rất đẹp.","partOfSpeech":"idiom"},"You can't make an omelet without breaking some eggs":{"definition":"Muốn đạt được thành tựu thì phải chịu đánh đổi","example":"Implementing new policies will face some resistance, but you can't make an omelet without breaking some eggs.","exampleTranslation":"Việc thực hiện các chính sách mới sẽ gặp một số phản kháng, nhưng không thể làm món trứng tráng mà không đập vỡ vài quả trứng.","partOfSpeech":"idiom"},"You can't squeeze blood out of a turnip":{"definition":"Vắt cổ chày ra nước (không thể đòi hỏi thứ mà người ta không có)","example":"Trying to get a confession out of him is like trying to squeeze blood out of a turnip.","exampleTranslation":"Cố gắng lấy lời thú tội từ anh ta giống như cố vắt máu từ củ cải.","partOfSpeech":"idiom"},"You can't take it with you":{"definition":"Sống để dạ chết mang đi, của cải không thể mang theo khi chết","example":"He amassed a great fortune, but in the end, you can't take it with you.","exampleTranslation":"Anh ấy tích lũy được một khối tài sản lớn, nhưng cuối cùng bạn không thể mang theo nó được.","partOfSpeech":"idiom"},"You can't teach an old dog new tricks":{"definition":"Tre già khó uốn, khó mà thay đổi thói quen của người già","example":"My grandfather refuses to use a smartphone; you know what they say, you can't teach an old dog new tricks.","exampleTranslation":"Ông tôi từ chối dùng điện thoại thông minh; bạn biết người ta nói gì rồi đấy, người già khó học điều mới.","partOfSpeech":"idiom"},"You catch more flies with honey than with vinegar":{"definition":"Lời nói ngọt ngào dễ lọt tai hơn, lạt mềm buộc chặt","example":"Try to be nicer when asking for help. You catch more flies with honey than with vinegar.","exampleTranslation":"Hãy cố gắng nhẹ nhàng hơn khi nhờ giúp đỡ. Lời nói ngọt ngào dễ lọt tai hơn lời lẽ gay gắt.","partOfSpeech":"idiom"},"You get what you pay for":{"definition":"Tiền nào của nấy","example":"I bought those cheap shoes, and now they're falling apart. I guess you get what you pay for.","exampleTranslation":"Tôi đã mua đôi giày rẻ tiền đó, và giờ chúng đang rách ra. Tôi đoán tiền nào của nấy.","partOfSpeech":"idiom"},"You're telling me":{"definition":"Khỏi phải nói, tôi biết quá đi chứ","example":"He says he is busy, but you're telling me.","exampleTranslation":"Anh ấy nói mình bận, nhưng tôi hiểu mà.","partOfSpeech":"idiom"},"You've sold me":{"definition":"Thuyết phục được tôi rồi đấy","example":"Okay, you've sold me on the idea of taking a weekend trip.","exampleTranslation":"Được rồi, bạn đã thuyết phục tôi về ý tưởng đi chơi cuối tuần.","partOfSpeech":"idiom"},"your guess is as good as mine":{"definition":"Tôi cũng không biết; tôi cũng mờ mịt như bạn","example":"When will the project be finished? Your guess is as good as mine.","exampleTranslation":"Khi nào dự án sẽ hoàn thành? Tôi cũng không biết gì hơn bạn.","partOfSpeech":"idiom"},"zero tolerance":{"definition":"Không khoan nhượng; chính sách xử lý nghiêm ngặt mọi vi phạm","example":"The school has a zero tolerance policy for bullying.","exampleTranslation":"Trường có chính sách không khoan nhượng đối với nạn bắt nạt.","partOfSpeech":"idiom"},"zip it":{"definition":"Im đi; ngậm miệng lại; đừng nói nữa","example":"He was about to reveal the surprise, but she quickly told him to zip it.","exampleTranslation":"Anh ấy định tiết lộ điều bất ngờ, nhưng cô ấy nhanh chóng bảo anh im đi.","partOfSpeech":"idiom"}},"wordCount":1499},{"id":"phrasal-verbs-v1","title":"Cụm động từ thông dụng","description":"Học 1.952 cụm động từ đã lọc từ từ điển offline, có nghĩa và câu ví dụ; sắp xếp theo 16 nhóm chủ đề và động từ gốc.","lessons":[{"id":"phrasal-verbs-v1-lesson-001","title":"Bài 1: Sinh hoạt hằng ngày","focus":"Thức dậy, chuẩn bị và làm những việc thường nhật.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","questions":[{"term":"wake up","prompt":"I _____ before dawn but stay in bed until my alarm rings.","choices":["run out of","look for","drop off","wake up"]},{"term":"get up","prompt":"I _____ and make breakfast before anyone else wakes.","choices":["try on","put on","take off","get up"]},{"term":"lie down","prompt":"If you feel dizzy, _____ on the sofa.","choices":["try on","turn on","take off","lie down"]},{"term":"sit down","prompt":"There's a chair for you; please _____ while you wait for the doctor.","choices":["throw away","drop off","pick up","sit down"]},{"term":"stand up","prompt":"Everyone _____ when the judge entered the room.","choices":["stand up","drop off","throw away","put away"]},{"term":"get dressed","prompt":"The children _____ before breakfast.","choices":["look for","find out","get dressed","fill up"]},{"term":"put on","prompt":"_____ your coat before you go outside.","choices":["pick up","put on","throw away","clean up"]},{"term":"take off","prompt":"Please _____ your shoes at the door.","choices":["get dressed","take off","stand up","sit down"]},{"term":"try on","prompt":"She _____ the blue jacket before buying it.","choices":["try on","get dressed","stand up","sit down"]},{"term":"turn on","prompt":"The kitchen is dark, so could you _____ the light?","choices":["turn on","run out of","drop off","fill up"]},{"term":"turn off","prompt":"The oven timer has rung, so _____ the oven before you leave.","choices":["get up","turn off","wake up","find out"]},{"term":"clean up","prompt":"We _____ the kitchen after dinner.","choices":["turn on","clean up","take off","try on"]},{"term":"put away","prompt":"Please _____ your books before lunch.","choices":["put away","look for","run out of","fill up"]},{"term":"throw away","prompt":"Don't _____ the receipt; we may need it.","choices":["throw away","stand up","get dressed","sit down"]},{"term":"pick up","prompt":"I'll _____ the parcel from the front desk.","choices":["pick up","lie down","sit down","get dressed"]},{"term":"drop off","prompt":"I _____ my daughter at school before continuing to the office.","choices":["drop off","pick up","throw away","run out of"]},{"term":"run out of","prompt":"We've _____ milk, so I'll buy some.","choices":["run out of","get up","wake up","find out"]},{"term":"fill up","prompt":"Please _____ the water bottle before the hike.","choices":["look for","lie down","fill up","find out"]},{"term":"look for","prompt":"I'm _____ my glasses; have you seen them?","choices":["get up","look for","sit down","lie down"]},{"term":"find out","prompt":"We called the clinic to _____ its opening hours.","choices":["look for","wake up","find out","get up"]}]},{"id":"phrasal-verbs-v1-lesson-002","title":"Bài 2: Nhà cửa và việc vặt","focus":"Sắp xếp nhà cửa, sửa đồ và xử lý việc cá nhân.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","questions":[{"term":"look after","prompt":"Mina _____ her neighbor's cat on weekends.","choices":["put down","take out","look after","plug in"]},{"term":"let in","prompt":"Please _____ the delivery driver through the side door.","choices":["put down","put back","put out","let in"]},{"term":"lock up","prompt":"Remember to _____ before you leave the shop.","choices":["plug in","put back","turn down","lock up"]},{"term":"set up","prompt":"We _____ the new desk in the spare room.","choices":["look after","set up","take out","let in"]},{"term":"take out","prompt":"The kitchen bin is full; could you _____ the rubbish before the cleaners arrive?","choices":["put down","lock up","take out","set up"]},{"term":"put out","prompt":"The firefighters _____ the small kitchen fire quickly.","choices":["put out","plug in","set up","lock up"]},{"term":"put down","prompt":"Please _____ your bags by the door.","choices":["turn up","plug in","put down","move in"]},{"term":"plug in","prompt":"_____ the kettle after you fill it and before you switch it on.","choices":["put back","turn up","plug in","turn down"]},{"term":"put back","prompt":"Please _____ the screwdriver after using it.","choices":["turn up","put back","turn down","move in"]},{"term":"turn down","prompt":"The music is too loud; please _____ the volume.","choices":["plug in","put back","move in","turn down"]},{"term":"turn up","prompt":"I can't hear the radio; could you _____ the volume?","choices":["put together","turn up","pay back","bring in"]},{"term":"move in","prompt":"Our new neighbors _____ next Monday.","choices":["move in","turn up","turn down","put back"]},{"term":"move out","prompt":"He plans to _____ when his lease ends.","choices":["turn up","turn down","move out","put back"]},{"term":"fix up","prompt":"They _____ the old kitchen over the summer, repairing the cabinets instead of replacing them.","choices":["bring in","look after","give away","fix up"]},{"term":"take apart","prompt":"Dad _____ the broken lamp to find the loose wire.","choices":["pay back","give away","bring in","take apart"]},{"term":"put together","prompt":"We _____ the bookshelf using the instructions.","choices":["plug in","turn down","take out","put together"]},{"term":"pay back","prompt":"I'll _____ the money after I get paid on Friday.","choices":["take out","plug in","pay back","put down"]},{"term":"bring in","prompt":"_____ the cushions before it starts to rain.","choices":["set up","take out","bring in","lock up"]},{"term":"give away","prompt":"They _____ the old sofa to a neighbor.","choices":["give away","lock up","take out","set up"]},{"term":"get rid of","prompt":"We _____ the broken chair during the move.","choices":["set up","let in","get rid of","lock up"]}]},{"id":"phrasal-verbs-v1-lesson-003","title":"Bài 3: Học tập và công việc","focus":"Đọc, ghi chép, hoàn thành nhiệm vụ và phối hợp ở nơi làm việc.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","questions":[{"term":"look up","prompt":"I _____ the word in an online dictionary.","choices":["look up","hand out","fill in","go over"]},{"term":"write down","prompt":"_____ the room number before you forget it.","choices":["hand in","look up","write down","hand out"]},{"term":"hand in","prompt":"Please _____ your assignment by Thursday.","choices":["take over","take on","call off","hand in"]},{"term":"hand out","prompt":"The teacher _____ the worksheets at the start of class.","choices":["catch up","take on","take over","hand out"]},{"term":"fill in","prompt":"_____ your name at the top of the form.","choices":["fall behind","bring up","fill in","keep up"]},{"term":"go over","prompt":"Let's _____ the report before the meeting.","choices":["go over","carry out","figure out","point out"]},{"term":"work on","prompt":"I'm _____ the budget for next quarter.","choices":["bring up","work on","come up with","read over"]},{"term":"carry out","prompt":"The team _____ a safety check before opening.","choices":["take on","put off","call off","carry out"]},{"term":"figure out","prompt":"We _____ why the printer had stopped.","choices":["figure out","bring up","come up with","read over"]},{"term":"point out","prompt":"The editor _____ two errors in the final paragraph.","choices":["read over","come up with","look up","point out"]},{"term":"put off","prompt":"They _____ the interview until next week.","choices":["read over","write down","look up","put off"]},{"term":"call off","prompt":"The organizers _____ the outdoor event because of the storm.","choices":["come up with","call off","bring up","keep up"]},{"term":"take on","prompt":"Jules _____ a new project at work.","choices":["write down","read over","look up","take on"]},{"term":"take over","prompt":"Rosa will _____ the team while I'm away.","choices":["catch up","fall behind","bring up","take over"]},{"term":"catch up","prompt":"I stayed late to _____ on my emails.","choices":["come up with","take over","catch up","fall behind"]},{"term":"fall behind","prompt":"Without a study plan, it's easy to _____ in class.","choices":["take on","take over","fall behind","catch up"]},{"term":"keep up","prompt":"The course is fast, but she can _____ with the lessons.","choices":["come up with","fall behind","keep up","take over"]},{"term":"bring up","prompt":"I _____ the delivery delay during the meeting.","choices":["work on","go over","fill in","bring up"]},{"term":"come up with","prompt":"The students _____ a simple way to test the idea.","choices":["carry out","figure out","come up with","work on"]},{"term":"read over","prompt":"_____ your application before you send it.","choices":["figure out","carry out","read over","work on"]}]},{"id":"phrasal-verbs-v1-lesson-004","title":"Bài 4: Giao tiếp và các mối quan hệ","focus":"Trao đổi, giữ liên lạc và ứng xử với người khác.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","questions":[{"term":"speak up","prompt":"Please _____; the microphone isn't working.","choices":["get over","fall out","ask out","speak up"]},{"term":"talk over","prompt":"Let's _____ the options before we choose.","choices":["ask out","back down","stand up for","talk over"]},{"term":"call back","prompt":"I missed your call, so I'll _____ after lunch.","choices":["hang up","get through","call back","hold on"]},{"term":"get back to","prompt":"I'll _____ you with an answer this afternoon.","choices":["get back to","back down","ask out","stand up for"]},{"term":"hang up","prompt":"She _____ after saying goodbye.","choices":["call back","get back to","hang up","hold on"]},{"term":"hold on","prompt":"_____ a moment while I check your booking.","choices":["hold on","get over","make up","fall out"]},{"term":"get through","prompt":"I couldn't _____ to the clinic this morning.","choices":["get through","cut off","turn away","show up"]},{"term":"cut off","prompt":"We were _____ when the train entered the tunnel.","choices":["cut off","speak up","get along","stand up for"]},{"term":"show up","prompt":"Nina _____ ten minutes early for the interview.","choices":["show up","turn away","fall out","calm down"]},{"term":"turn away","prompt":"The venue _____ visitors without tickets.","choices":["fall out","turn away","open up","make up"]},{"term":"cheer up","prompt":"A funny message can _____ a friend after a difficult day.","choices":["back down","get over","cheer up","ask out"]},{"term":"calm down","prompt":"Take a deep breath and _____ before you reply.","choices":["get back to","call back","hang up","calm down"]},{"term":"open up","prompt":"After a few weeks, he _____ about his worries.","choices":["get back to","call back","open up","hold on"]},{"term":"make up","prompt":"The child _____ a story about a friendly dragon.","choices":["calm down","turn away","make up","fall out"]},{"term":"fall out","prompt":"The two friends _____ over a misunderstanding.","choices":["fall out","call back","talk over","speak up"]},{"term":"get over","prompt":"It took him a week to _____ the flu.","choices":["speak up","get over","hang up","call back"]},{"term":"ask out","prompt":"Kai plans to _____ a classmate for coffee after class.","choices":["stand up for","speak up","get along","ask out"]},{"term":"back down","prompt":"Neither side _____ during the negotiations.","choices":["get along","stand up for","back down","speak up"]},{"term":"stand up for","prompt":"Maya _____ her colleague when the criticism was unfair.","choices":["cut off","turn away","show up","stand up for"]},{"term":"get along","prompt":"Our new neighbors _____ well with everyone on the floor.","choices":["get along","speak up","stand up for","talk over"]}]},{"id":"phrasal-verbs-v1-lesson-005","title":"Bài 5: Di chuyển và thay đổi","focus":"Đi lại, khởi hành, quay về và thích nghi với thay đổi.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","questions":[{"term":"set off","prompt":"We _____ for the airport before sunrise to avoid traffic.","choices":["grow up","slow down","set off","speed up"]},{"term":"drive off","prompt":"The driver _____ before I could ask for directions.","choices":["speed up","slow down","drive off","turn around"]},{"term":"get in","prompt":"_____ the car quickly; it's starting to rain.","choices":["pull up","get in","pull over","check out"]},{"term":"get out","prompt":"We _____ of the taxi in front of the hotel.","choices":["pull up","pull over","get out","check in"]},{"term":"get on","prompt":"The bus has just arrived at our stop, so we _____.","choices":["check in","check out","get on","pull over"]},{"term":"get off","prompt":"Please _____ the train at Central Station.","choices":["get off","speed up","slow down","grow up"]},{"term":"check in","prompt":"We _____ at the hotel shortly after noon.","choices":["head back","speed up","check in","turn around"]},{"term":"check out","prompt":"Guests must _____ by eleven in the morning.","choices":["check out","pull over","get on","get off"]},{"term":"pull over","prompt":"The driver _____ to let the ambulance pass.","choices":["turn around","speed up","pull over","go back"]},{"term":"pull up","prompt":"A taxi _____ outside the station.","choices":["head back","pull up","check out","turn around"]},{"term":"head back","prompt":"We _____ to the hotel before it got dark.","choices":["speed up","head back","slow down","turn around"]},{"term":"come back","prompt":"I'll wait here, so _____ when you have the signed form.","choices":["slow down","turn around","speed up","come back"]},{"term":"go back","prompt":"I need to _____ to the shop for my umbrella.","choices":["speed up","slow down","grow up","go back"]},{"term":"turn around","prompt":"_____ at the next street and follow the signs.","choices":["get off","get out","turn around","get on"]},{"term":"speed up","prompt":"The train began to _____ after leaving the station.","choices":["head back","slow down","turn around","speed up"]},{"term":"slow down","prompt":"_____ near the school crossing.","choices":["speed up","go back","turn around","slow down"]},{"term":"grow up","prompt":"She _____ in a small town near the coast.","choices":["grow up","come back","turn around","slow down"]},{"term":"give up","prompt":"Don't _____ when the first attempt fails.","choices":["get in","drive off","give up","get out"]},{"term":"take up","prompt":"He _____ swimming to improve his fitness.","choices":["turn around","slow down","take up","come back"]},{"term":"start over","prompt":"I deleted the wrong file, so I had to _____.","choices":["start over","set off","get in","drive off"]}]},{"id":"phrasal-verbs-v1-lesson-006","title":"Bài 6: Giải quyết tình huống","focus":"Đối phó với vấn đề, thay đổi hướng và tìm cách xử lý.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","questions":[{"term":"carry on","prompt":"The power went out, but the class _____ by candlelight.","choices":["rule out","narrow down","carry on","look into"]},{"term":"move on","prompt":"After discussing the budget, we _____ to the schedule.","choices":["break down","end up","turn out","move on"]},{"term":"end up","prompt":"We took the wrong road and _____ at the lake.","choices":["get by","end up","narrow down","sort out"]},{"term":"turn out","prompt":"The repair _____ to be cheaper than we expected.","choices":["turn out","break up","come across","run into"]},{"term":"break down","prompt":"Our washing machine _____ during the night.","choices":["break down","come across","run into","wear out"]},{"term":"wear out","prompt":"These running shoes _____ after about a year.","choices":["get away","deal with","get by","wear out"]},{"term":"break up","prompt":"They _____ after realizing they wanted different things.","choices":["run into","break up","wear out","come across"]},{"term":"run into","prompt":"I _____ my former teacher at the bookshop.","choices":["run into","break down","wear out","break up"]},{"term":"come across","prompt":"She _____ an old photo while clearing the drawer.","choices":["hold up","move on","come across","carry on"]},{"term":"look into","prompt":"The manager promised to _____ the billing error.","choices":["come across","look into","rule out","narrow down"]},{"term":"rule out","prompt":"The doctor _____ an allergy after reviewing the test results.","choices":["get away","put up with","rule out","get by"]},{"term":"narrow down","prompt":"We _____ the search to three apartments.","choices":["deal with","get by","get away","narrow down"]},{"term":"sort out","prompt":"The support team _____ the account problem by noon.","choices":["sort out","get away","get by","put up with"]},{"term":"work out","prompt":"We _____ a way to share the room fairly.","choices":["get away","deal with","work out","get by"]},{"term":"deal with","prompt":"I _____ customer complaints each morning.","choices":["deal with","end up","move on","turn out"]},{"term":"get by","prompt":"They can _____ on one income for a few months.","choices":["come apart","put up with","get by","sort out"]},{"term":"get away","prompt":"We hope to _____ for a few days in June.","choices":["get away","wear out","turn out","break down"]},{"term":"put up with","prompt":"I can't _____ the constant noise from the construction site.","choices":["put up with","come apart","carry on","hold up"]},{"term":"come apart","prompt":"The handle _____ when I tried to open the jar.","choices":["get by","narrow down","come apart","sort out"]},{"term":"hold up","prompt":"Roadworks _____ the bus for nearly twenty minutes.","choices":["narrow down","look into","hold up","rule out"]}]},{"id":"phrasal-verbs-v1-lesson-007","title":"Bài 7: Sinh hoạt và gia đình · ask–call","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (ask–call).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"ask in","prompt":"You should _____ the guest waiting outside.","choices":["bed down","belt out","blare out","ask in"]},{"term":"ask over","prompt":"They have _____ for drinks on Friday.","choices":["ask over","be off","bang out","be in"]},{"term":"bang about","prompt":"He's _____ in the kitchen.","choices":["bang about","bring around","brick up","brick in"]},{"term":"bang out","prompt":"She _____ on the piano.","choices":["bolt down","brick in","bang out","brick up"]},{"term":"be in","prompt":"They _____; I always get their answerphone.","choices":["bolt down","board out","be in","blow out"]},{"term":"be off","prompt":"This yoghurt must _____; it smells foul.","choices":["brick up","bring around","be off","bucket down"]},{"term":"be up","prompt":"I will _____ early tomorrow morning.","choices":["ask in","call after","bucket down","be up"]},{"term":"bed down","prompt":"The new government has found it hard to _____ and become accepted.","choices":["be up","belt out","bed down","be off"]},{"term":"belt out","prompt":"They _____ the national anthems before the game.","choices":["bed down","be up","belt out","be off"]},{"term":"blare out","prompt":"The music was _____ and I couldn't get to sleep.","choices":["brick in","brick up","blare out","bolt down"]},{"term":"blow out","prompt":"She _____ on her birthday cake.","choices":["blow out","brick in","bolt down","brick up"]},{"term":"board out","prompt":"We _____ with friends when we go abroad.","choices":["board out","be in","be off","bang about"]},{"term":"bolt down","prompt":"He _____ his breakfast because he was running late for work.","choices":["bang about","be in","bang out","bolt down"]},{"term":"brick in","prompt":"We _____ the side window.","choices":["blow out","blare out","brick in","belt out"]},{"term":"brick up","prompt":"We _____.","choices":["brick up","bucket down","ask in","call after"]},{"term":"bring around","prompt":"He _____ when he came last night.","choices":["ask over","bring around","ask in","bang about"]},{"term":"bucket down","prompt":"Take an umbrella; it's _____.","choices":["ask in","ask over","bucket down","call after"]},{"term":"bundle up","prompt":"I _____ my newspapers and dropped them in the recycling bin.","choices":["bed down","blare out","belt out","bundle up"]},{"term":"call after","prompt":"She was _____ her late grandmother.","choices":["bolt down","brick in","brick up","call after"]}]},{"id":"phrasal-verbs-v1-lesson-008","title":"Bài 8: Sinh hoạt và gia đình · carry–cut","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (carry–cut).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"carry on with","prompt":"He's been _____ someone at work for years.","choices":["close up","carry on with","clear out","clear up"]},{"term":"cast aside","prompt":"She decided to _____ her old, broken chair.","choices":["clown about","cast aside","cloud over","close up"]},{"term":"cater for","prompt":"The college _____ students of all ages.","choices":["carry on with","cater for","crumb down","cut down"]},{"term":"chow down","prompt":"Let's _____ on some delicious pizza tonight.","choices":["clown around","clown about","chow down","cloud over"]},{"term":"chow down on","prompt":"We're going to _____ that barbecued pork.","choices":["clean off","chow down on","chuck away","chuck out"]},{"term":"chuck away","prompt":"I _____ all my old records years ago when CDs came out.","choices":["clear out","clean off","clear up","chuck away"]},{"term":"chuck out","prompt":"I _____ some stuff I found in the fridge that had gone bad.","choices":["coop up","clown around","chuck out","clown about"]},{"term":"clean off","prompt":"After dinner, I _____ the table.","choices":["clean off","clear up","close up","cloud over"]},{"term":"clear out","prompt":"I spent the whole weekend _____ the attic as it was full of papers and other junk.","choices":["clear out","clown about","coop up","clown around"]},{"term":"clear up","prompt":"The skies _____ and the sun came out.","choices":["carry on with","cast aside","cater for","clear up"]},{"term":"close up","prompt":"They _____ the building after everyone has left.","choices":["close up","crash out","count down","clown around"]},{"term":"cloud over","prompt":"Dark _____ the bright sun.","choices":["clown about","clown around","cloud over","coop up"]},{"term":"clown about","prompt":"The students were _____ all lesson.","choices":["chow down on","clown about","chow down","chuck away"]},{"term":"clown around","prompt":"I couldn't concentrate because they were _____ all afternoon.","choices":["close up","clown around","coop up","cloud over"]},{"term":"coop up","prompt":"They _____ in a tiny room.","choices":["clear out","coop up","clean off","cloud over"]},{"term":"count down","prompt":"I'm _____ the days till they leave.","choices":["clean off","count down","chuck out","chuck away"]},{"term":"crash out","prompt":"Dave _____ at a friend's flat after the end-of-term party.","choices":["carry on with","crash out","cut down","crumb down"]},{"term":"crumb down","prompt":"The waiter _____ before the coffee was served.","choices":["crumb down","clear up","close up","clear out"]},{"term":"cut down","prompt":"After Christmas he didn't carefully detach all the decorations, he just _____.","choices":["cater for","cast aside","cut down","carry on with"]}]},{"id":"phrasal-verbs-v1-lesson-009","title":"Bài 9: Sinh hoạt và gia đình · cut–dry","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (cut–dry).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"cut out","prompt":"I _____ to use as visual aids.","choices":["drift off","dress down","cut out","dress up"]},{"term":"damp off","prompt":"The seedlings _____ in the spring if it's very wet.","choices":["dress down","dress up","damp off","drink up"]},{"term":"die back","prompt":"The plant _____ in the winter.","choices":["drink up","drown in","die back","drift off"]},{"term":"die out","prompt":"Some scientists say that the dinosaurs _____ when a comet hit the earth and caused a nuclear winter.","choices":["drift off","drown in","drink up","die out"]},{"term":"dig out","prompt":"I _____ my old university essays.","choices":["drown in","dig out","dry off","drink up"]},{"term":"dine out","prompt":"We _____ because we couldn't be bothered to cook.","choices":["dine out","dish up","do up","do with"]},{"term":"dish up","prompt":"He _____ a great dinner when we got back.","choices":["doss down","dress down","doze off","dish up"]},{"term":"do up","prompt":"You must _____ your safety belt in the back of cars and taxis now.","choices":["doss down","dine out","dig out","do up"]},{"term":"do with","prompt":"I could _____ a cold beer about now.","choices":["do with","cut out","dry off","damp off"]},{"term":"do without","prompt":"There's no sugar, so you'll have to _____.","choices":["drink up","drown in","do without","drift off"]},{"term":"doss down","prompt":"I was feeling really tired, so I _____ on his sofa for the night.","choices":["doss down","cut out","die back","damp off"]},{"term":"double up","prompt":"We had to _____ because we hadn't booked enough rooms.","choices":["dress down","double up","drift off","drown in"]},{"term":"doze off","prompt":"The movie was a bit boring and I _____ halfway through.","choices":["dig out","dine out","die out","doze off"]},{"term":"dress down","prompt":"The staff are allowed to _____ on Fridays.","choices":["dress down","doze off","double up","do without"]},{"term":"dress up","prompt":"It's an informal party so there's no need to _____.","choices":["drown in","doze off","dress up","drift off"]},{"term":"drift off","prompt":"I was _____ when the noise disturbed me.","choices":["die out","die back","cut out","drift off"]},{"term":"drink up","prompt":"_____, please; it's closing time.","choices":["drown in","dry off","cut out","drink up"]},{"term":"drown in","prompt":"They _____ sauce.","choices":["dish up","drown in","dine out","dig out"]},{"term":"dry off","prompt":"I had a shower and _____.","choices":["do up","dry off","dine out","dish up"]}]},{"id":"phrasal-verbs-v1-lesson-010","title":"Bài 10: Sinh hoạt và gia đình · dry–fool","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (dry–fool).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"dry out","prompt":"They _____ in the sun.","choices":["eat in","fart around","fart about","dry out"]},{"term":"eat in","prompt":"We didn't feel like going to a restaurant so we _____.","choices":["fold up","eat in","fluff out","fluff up"]},{"term":"eat out","prompt":"We couldn't be bothered to cook so we _____ last night.","choices":["fasten down","eat out","fart around","fart about"]},{"term":"empty out","prompt":"I must _____ the rubbish before I leave for work.","choices":["fluff up","fool about","fold up","empty out"]},{"term":"fart about","prompt":"The manager was angry because the staff were _____.","choices":["fasten down","empty out","fasten up","fart about"]},{"term":"fart around","prompt":"We were really bored in the lecture so we started _____.","choices":["fart around","fasten down","fatten up","fasten up"]},{"term":"fasten down","prompt":"We _____ to keep the wind from blowing it away.","choices":["fasten down","dry out","eat in","eat out"]},{"term":"fasten up","prompt":"Please _____ your seatbelt before we depart.","choices":["fluff out","fool about","fasten up","dry out"]},{"term":"fatten up","prompt":"They _____ before slaughtering them.","choices":["fiddle away","fish out","finish with","fatten up"]},{"term":"feed on","prompt":"He _____ dry food.","choices":["eat in","dry out","feed on","eat out"]},{"term":"fend for","prompt":"The children had to _____ themselves after their parents died.","choices":["fend for","fiddle around","fatten up","feed on"]},{"term":"fiddle around","prompt":"He _____ for something in his pockets.","choices":["fluff out","fiddle around","fish out","finish with"]},{"term":"fiddle away","prompt":"He _____ the afternoon.","choices":["fool about","fiddle away","dry out","eat in"]},{"term":"finish with","prompt":"Can I read the paper when you've _____ it.","choices":["finish with","eat in","fool about","dry out"]},{"term":"fish out","prompt":"She reached into her handbag and _____.","choices":["fend for","fish out","feed on","fiddle around"]},{"term":"fluff out","prompt":"She _____ the sofa cushions.","choices":["eat in","fold up","fluff out","fool about"]},{"term":"fluff up","prompt":"He _____ the pillow before going to bed.","choices":["fish out","dry out","fool about","fluff up"]},{"term":"fold up","prompt":"Darren _____ the letter and put it in an envelope.","choices":["fend for","fiddle around","feed on","fold up"]},{"term":"fool about","prompt":"They were _____ and wouldn't settle down.","choices":["empty out","fasten down","fool about","fart around"]}]},{"id":"phrasal-verbs-v1-lesson-011","title":"Bài 11: Sinh hoạt và gia đình · freshen–have","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (freshen–have).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"freshen up","prompt":"The magazine gives you tips on how to _____ your home cheaply.","choices":["freshen up","get away from","get back into","get into"]},{"term":"get away from","prompt":"Work's getting on top of me; I need to _____ it.","choices":["gulp down","get away from","gussy up","hack around"]},{"term":"get back into","prompt":"I am _____ my Khmer lessons after the summer break.","choices":["go around","go without","get back into","goof around"]},{"term":"get into","prompt":"It took me ages to _____ driving on the left.","choices":["go around","get into","goof around","go without"]},{"term":"get used to","prompt":"It took him several months to _____ driving on the left side of the road.","choices":["go without","goof around","get used to","go around"]},{"term":"go around","prompt":"There aren't enough jobs to _____ for the numbers of people graduating nowadays.","choices":["go around","have it away","have it off","have in"]},{"term":"go without","prompt":"They're not coming, so we'll have to _____ their help.","choices":["go without","goof around","grow out","grow up on"]},{"term":"goof around","prompt":"We spent the weekend _____.","choices":["grow out","go without","goof around","get used to"]},{"term":"grow out","prompt":"I'm letting the perm _____.","choices":["gulp down","grow out","gussy up","hack around"]},{"term":"grow up on","prompt":"We _____ cartoons.","choices":["hack around","gussy up","gulp down","grow up on"]},{"term":"gulp down","prompt":"After the long run in the hot sun, he _____ a whole bottle of cold water.","choices":["hang out","have around","gulp down","have in"]},{"term":"gussy up","prompt":"They spent a fortune _____ the house.","choices":["grow out","grow up on","gussy up","goof around"]},{"term":"hack around","prompt":"Stop wasting your time and don't _____ anymore.","choices":["hack around","get away from","get into","get back into"]},{"term":"hang out","prompt":"He _____ in the pub The Monarch; he's there most nights.","choices":["hang out","have over","have it off","freshen up"]},{"term":"have around","prompt":"I _____ for dinner last night.","choices":["freshen up","get away from","have around","get back into"]},{"term":"have in","prompt":"We _____ last night for dinner.","choices":["have in","get back into","freshen up","get away from"]},{"term":"have it away","prompt":"She _____ with him last Friday.","choices":["hang out","hack around","gussy up","have it away"]},{"term":"have it off","prompt":"They _____ after the party.","choices":["go without","goof around","have it off","go around"]},{"term":"have over","prompt":"Shall we _____ for dinner?","choices":["freshen up","have over","hack around","hang out"]}]},{"id":"phrasal-verbs-v1-lesson-012","title":"Bài 12: Sinh hoạt và gia đình · heat–live","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (heat–live).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"heat up","prompt":"He _____ in the microwave.","choices":["kip down on","knock back","knock together","heat up"]},{"term":"hold on to","prompt":"I _____ my luggage while I was waiting fr the taxi so that it didn't get stolen.","choices":["light up","lark about","hold on to","lie around"]},{"term":"hold onto","prompt":"It tried to _____ my cash during the holiday so I could buy some duty free stuff on the way back.","choices":["light up","listen out for","live by","hold onto"]},{"term":"hunker down","prompt":"The troops _____ in the building.","choices":["knock back","knock together","kip down on","hunker down"]},{"term":"keep around","prompt":"I _____ when I'm doing my homework.","choices":["live for","live it up","keep around","live in"]},{"term":"kip down","prompt":"It's too late to get the train, so can I _____ here tonight?","choices":["keep around","hold onto","knock back","kip down"]},{"term":"kip down on","prompt":"There were so many of us that we had to _____ the floor.","choices":["kip down on","heat up","live it up","hold on to"]},{"term":"knock back","prompt":"The pub was closing so we _____ and left.","choices":["live it up","knock back","live on","live in"]},{"term":"knock together","prompt":"They _____ two outbuilding and turned them into a home.","choices":["knock together","live on","live in","live it up"]},{"term":"large it up","prompt":"They were _____ in the rave.","choices":["large it up","listen out for","lie around","live by"]},{"term":"lark about","prompt":"The children made me angry because they were _____.","choices":["live for","lark about","live by","live in"]},{"term":"lie around","prompt":"Most days he would usually just _____ the house.","choices":["lie around","kip down","knock back","kip down on"]},{"term":"light up","prompt":"They _____ the streets at Christmas time.","choices":["light up","knock together","lie around","lark about"]},{"term":"listen out for","prompt":"They put their coats on and _____ the minicab.","choices":["keep around","listen out for","hunker down","kip down"]},{"term":"live by","prompt":"He tries hard to _____ the Bible.","choices":["live by","hold onto","heat up","hold on to"]},{"term":"live for","prompt":"She seems to _____ her new job.","choices":["lark about","live for","knock together","large it up"]},{"term":"live in","prompt":"The university has a residential halls where students can _____.","choices":["lark about","live in","large it up","lie around"]},{"term":"live it up","prompt":"She's been _____ like crazy since she won the lottery.","choices":["live it up","hunker down","hold onto","hold on to"]},{"term":"live on","prompt":"He's been dead for many years, but his name _____.","choices":["large it up","knock together","lark about","live on"]}]},{"id":"phrasal-verbs-v1-lesson-013","title":"Bài 13: Sinh hoạt và gia đình · live–mooch","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (live–mooch).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"live out","prompt":"Many parents try to _____ their dreams through their children.","choices":["mooch around","live out","mooch about","monkey around"]},{"term":"live together","prompt":"We _____ for a few years before we got married.","choices":["live together","look in","look in on","look back on"]},{"term":"load down","prompt":"I was _____ with all the stuff I had to take there.","choices":["look in on","luck out","look on","load down"]},{"term":"load up on","prompt":"The athletes _____ carbohydrates before the race.","choices":["marry out","marry in","mess around","load up on"]},{"term":"look back","prompt":"Old people often _____ on over their lives.","choices":["monkey around","miss out on","look back","mooch about"]},{"term":"look back on","prompt":"When I _____ my college years, I remember them with great fondness.","choices":["load down","look back on","luck out","make room for"]},{"term":"look in","prompt":"I'll _____ on my way home.","choices":["monkey around","look in","miss out","miss out on"]},{"term":"look in on","prompt":"I'm going to _____ grannie on the way home tonight as she's been a bit unwell recently.","choices":["marry in","make room for","look in on","luck out"]},{"term":"look on","prompt":"The crowd just _____ as the old lady was mugged.","choices":["look on","marry in","marry out","make room for"]},{"term":"luck out","prompt":"I really _____ when I met my partner.","choices":["mooch about","luck out","mooch around","live together"]},{"term":"make room for","prompt":"We moved the table to _____ the extra chairs.","choices":["luck out","look in on","make room for","look on"]},{"term":"marry in","prompt":"Many religions encourage their followers to _____.","choices":["look in on","marry in","luck out","look on"]},{"term":"marry out","prompt":"Her parents disowned her and refused to speak to her when she _____.","choices":["marry out","mooch about","mooch around","live together"]},{"term":"mess around","prompt":"He is just _____ instead of doing his homework.","choices":["mess around","live together","load down","live out"]},{"term":"miss out","prompt":"It'll be great; you'll be _____ if you don't come.","choices":["load up on","load down","live together","miss out"]},{"term":"miss out on","prompt":"Trudy _____ the promotion.","choices":["mooch about","miss out on","mooch around","monkey around"]},{"term":"monkey around","prompt":"The police officer told the drunks to stop _____ and go home quietly.","choices":["mooch about","miss out on","monkey around","miss out"]},{"term":"mooch about","prompt":"I just _____ in my room all day.","choices":["mooch about","load down","live together","live out"]},{"term":"mooch around","prompt":"I _____ the house all day.","choices":["look in","look on","look in on","mooch around"]}]},{"id":"phrasal-verbs-v1-lesson-014","title":"Bài 14: Sinh hoạt và gia đình · move–plough","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (move–plough).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"move into","prompt":"They _____ the house as soon as it was ready.","choices":["pack up","pad down","move into","pass down"]},{"term":"name after","prompt":"I was _____ my uncle who died in the war.","choices":["pad down","name after","pass down","pack up"]},{"term":"nerd out","prompt":"I had to _____ when they asked about conditionals and deontic modality.","choices":["nerd out","pack up","pad down","pass down"]},{"term":"order in","prompt":"I am too tired to cook tonight, so let us _____ some pizza.","choices":["order in","pad down","pass down","pack up"]},{"term":"pack away","prompt":"I _____ the suitcases in the loft after we had emptied them.","choices":["pass down","pack away","peck at","pick at"]},{"term":"pack out","prompt":"The stadium was _____.","choices":["plough up","pack out","play with","play away"]},{"term":"pack up","prompt":"At the end of the presentation, I _____ my laptop.","choices":["move into","pack up","play with","name after"]},{"term":"pad down","prompt":"I'm too tired to come home; can I _____ here tonight?","choices":["peck at","pad down","pick up after","pick at"]},{"term":"pass down","prompt":"The tales were _____ for centuries without changing ay of the words.","choices":["pass down","pick up after","pin up","pile up"]},{"term":"peck at","prompt":"The food wasn't very nice, so I _____ it to look polite.","choices":["pad down","pack out","pack up","peck at"]},{"term":"pick at","prompt":"I wasn't very hungry so I just _____ my food.","choices":["play with","play away","plate up","pick at"]},{"term":"pick up after","prompt":"I always have to _____ him because he leaves things all over the office.","choices":["pick up after","pass down","pad down","pack up"]},{"term":"pile up","prompt":"The ironing's _____ as I hate doing it.","choices":["pile up","pick up after","pick at","plant out"]},{"term":"pin up","prompt":"Please _____ your new photos on the wall.","choices":["play with","play away","pin up","move into"]},{"term":"plant out","prompt":"They need to be _____ in the spring.","choices":["pack away","pad down","plant out","pack up"]},{"term":"plate up","prompt":"_____ and drizzle with salsa verde.","choices":["pack out","order in","pack away","plate up"]},{"term":"play away","prompt":"He travels abroad a lot and his wife thinks he _____.","choices":["pick up after","peck at","pick at","play away"]},{"term":"play with","prompt":"He can't stop _____ his beard.","choices":["pass down","pick at","peck at","play with"]},{"term":"plough up","prompt":"The tractor _____ the field so they could sow the seed.","choices":["plough up","nerd out","order in","pack away"]}]},{"id":"phrasal-verbs-v1-lesson-015","title":"Bài 15: Sinh hoạt và gia đình · plow–root","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (plow–root).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"plow up","prompt":"They need to _____ the field for planting.","choices":["polish off","plow up","poke around","potter about"]},{"term":"plump down","prompt":"He _____ and kicked his shoes off.","choices":["roll by","roll up","root about","plump down"]},{"term":"plump up","prompt":"I _____ the pillow and lay down.","choices":["poke around","plump up","potter about","polish off"]},{"term":"plump yourself down","prompt":"She will _____ on the soft sofa.","choices":["rack out","ring with","ride up","plump yourself down"]},{"term":"poke about","prompt":"I _____ in my CD collection to see if I could find it.","choices":["pull on","poke about","polish off","potter around"]},{"term":"poke around","prompt":"I _____ in my desk to see if the letter was there.","choices":["poke around","roll up","root up","root about"]},{"term":"polish off","prompt":"She _____ half a bottle of gin every night.","choices":["polish off","pull on","potter around","potter about"]},{"term":"potter about","prompt":"On Saturday mornings, I _____ the garden if the weather's fine.","choices":["potter about","pull to","pull on","rack out"]},{"term":"potter around","prompt":"I _____, sorting out my cds and a few other things.","choices":["plump yourself down","plump up","potter around","plump down"]},{"term":"pull on","prompt":"I _____ a jumper when the sun went in.","choices":["plump yourself down","pull on","plump up","poke about"]},{"term":"pull to","prompt":"Could you _____, please?","choices":["ring with","pull to","rack out","ride up"]},{"term":"rack out","prompt":"I'm tired- I'm going to _____.","choices":["root up","root around","plow up","rack out"]},{"term":"ride up","prompt":"Her skirt _____ when she sat down.","choices":["root around","root about","roll by","ride up"]},{"term":"ring with","prompt":"The room _____ their laughter.","choices":["poke about","ring with","poke around","polish off"]},{"term":"roll by","prompt":"The summer days _____ so very quickly.","choices":["pull on","pull to","roll by","potter around"]},{"term":"roll up","prompt":"Thousands _____ to see the stars at the film premiere.","choices":["roll up","ring with","root around","root about"]},{"term":"root about","prompt":"He _____ in his briefcase, trying to find a pen.","choices":["ring with","roll by","root about","ride up"]},{"term":"root around","prompt":"I _____ my flat trying to find the letter.","choices":["plump up","root around","plump down","plow up"]},{"term":"root up","prompt":"He _____ the plants and replanted them.","choices":["rack out","ring with","pull to","root up"]}]},{"id":"phrasal-verbs-v1-lesson-016","title":"Bài 16: Sinh hoạt và gia đình · run–sit","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (run–sit).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"run across","prompt":"I _____ an old friend in the library.","choices":["set in","settle down","send out for","run across"]},{"term":"run around","prompt":"I'm exhausted- I've been _____ all day.","choices":["rustle up","run around","saw up","sit back"]},{"term":"run away","prompt":"She _____ to avoid a forced marriage.","choices":["sing along","show off","shake out","run away"]},{"term":"rustle up","prompt":"Can you _____ a quick snack for us?","choices":["send out for","screen off","rustle up","screw around"]},{"term":"saw up","prompt":"We _____ to make the shelves.","choices":["run around","sit back","run across","saw up"]},{"term":"screen off","prompt":"We _____ the area where we had the discussion from the rest of the meeting.","choices":["rustle up","run away","screen off","saw up"]},{"term":"screw around","prompt":"He _____ a lot at university.","choices":["run away","run across","screw around","rustle up"]},{"term":"send out for","prompt":"We couldn't be bothered to cook, so we _____ a pizza.","choices":["sit back","send out for","run across","sit around"]},{"term":"set in","prompt":"Winter has _____; it's started snowing.","choices":["shake out","settle down","shack up","set in"]},{"term":"settle down","prompt":"After years of partying and drinking, she finally got married and _____.","choices":["settle down","sit around","sit back","run across"]},{"term":"settle in","prompt":"It took him a while to _____ when he moved to Japan.","choices":["sing along","settle in","sit about","show off"]},{"term":"shack up","prompt":"We had to _____ with friends while our house was being decorated.","choices":["screw around","run away","shack up","screen off"]},{"term":"shake out","prompt":"He took the tablecloth outside and _____ after dinner.","choices":["send out for","settle down","shake out","set in"]},{"term":"show off","prompt":"The shirt really _____ his new tie.","choices":["screw around","show off","set in","send out for"]},{"term":"sing along","prompt":"I _____ when they played it on the radio.","choices":["sit about","sit around","sing along","show off"]},{"term":"sit about","prompt":"We spent the afternoon _____ chatting instead of doing any work.","choices":["run across","run around","sit about","sing along"]},{"term":"sit around","prompt":"They just _____ while the others did all the work.","choices":["sit around","rustle up","saw up","run away"]},{"term":"sit back","prompt":"We _____ and waited for them to make the first mistake.","choices":["show off","sit back","shake out","sing along"]}]},{"id":"phrasal-verbs-v1-lesson-017","title":"Bài 17: Sinh hoạt và gia đình · sit–stay","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (sit–stay).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"sit over","prompt":"We _____ dinner discussing the plans.","choices":["stand about","sit over","sponge down","spruce up"]},{"term":"sit through","prompt":"I was bored and wanted to leave halfway through, but we _____ the film.","choices":["slob around","spark up","sit through","snack on"]},{"term":"skin up","prompt":"Who's going to _____?","choices":["sleep over","sleep in","skin up","sleep through"]},{"term":"sleep in","prompt":"Let’s _____ tomorrow morning- we won’t have another chance for weeks.","choices":["spark up","snack on","sleep in","sponge down"]},{"term":"sleep over","prompt":"The au pair made tea for the friends who were _____.","choices":["slob around","slice up","slip by","sleep over"]},{"term":"sleep through","prompt":"I managed to _____ the loud construction noise tonight.","choices":["stay out","start on","sleep through","stay in"]},{"term":"slice up","prompt":"I _____ and handed it round to the people there.","choices":["snack on","sponge down","slice up","slob around"]},{"term":"slip by","prompt":"The years _____ as you get older.","choices":["slob around","slip by","snack on","slice up"]},{"term":"slob around","prompt":"I spent the day _____ at home.","choices":["slip by","slob around","snack on","slice up"]},{"term":"snack on","prompt":"She likes to _____ fresh fruits and roasted nuts while studying.","choices":["spark up","snack on","slob around","sponge down"]},{"term":"spark up","prompt":"They _____ in a no smoking area.","choices":["sleep over","sleep through","sleep in","spark up"]},{"term":"sponge down","prompt":"I'll _____ before putting it away.","choices":["sponge down","sleep in","sit through","skin up"]},{"term":"spruce up","prompt":"We _____ before we put it on the market.","choices":["spruce up","sleep over","sleep in","sleep through"]},{"term":"stand about","prompt":"We _____ drinking coffee before the lecture.","choices":["slice up","slob around","slip by","stand about"]},{"term":"stand around","prompt":"We _____ for an hour waiting for them to turn up.","choices":["sleep through","stand around","slice up","sleep over"]},{"term":"start on","prompt":"It's time to _____ that bottle of wine.","choices":["spruce up","start on","sponge down","spark up"]},{"term":"stay in","prompt":"I'm going to _____ and chill tonight; I can't be bothered to go out.","choices":["slice up","slip by","stay in","sleep through"]},{"term":"stay out","prompt":"We _____ all night.","choices":["sleep over","slice up","sleep through","stay out"]}]},{"id":"phrasal-verbs-v1-lesson-018","title":"Bài 18: Sinh hoạt và gia đình · stay–throw","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (stay–throw).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"stay over","prompt":"I _____ at a friend's house last night because of the train strike.","choices":["take in","take to","stay over","take after"]},{"term":"stay up","prompt":"The children _____ until way past their bedtime.","choices":["stop back","stick around","stop around","stay up"]},{"term":"stick around","prompt":"He's late, but I'll _____ for another few minutes before I leave.","choices":["tear off","tee off","tee up","stick around"]},{"term":"stiffen up","prompt":"They used starch to _____.","choices":["stiffen up","take in","take to","take after"]},{"term":"stop around","prompt":"Why don't you _____ my place on your way back?","choices":["take after","stop around","take in","take to"]},{"term":"stop back","prompt":"I'll _____ this afternoon when you're free.","choices":["stay over","throw together","stop back","throw on"]},{"term":"straighten up","prompt":"She _____ when her boss walked in.","choices":["straighten up","take in","take to","take after"]},{"term":"suit up","prompt":"You should _____ before the big game.","choices":["take after","take in","suit up","stop back"]},{"term":"take after","prompt":"He _____ his mother.","choices":["tear away","tee off","tear off","take after"]},{"term":"take in","prompt":"The jacket was far too big around the shoulders, so I had it _____ so that I could wear it.","choices":["stop back","suit up","take in","straighten up"]},{"term":"take to","prompt":"He's _____ wearing a baseball cap since his hair started thinning more noticeably.","choices":["tee up","thaw out","tee off","take to"]},{"term":"tear away","prompt":"I had to _____ from the office for dinner.","choices":["stick around","stay up","tear away","stiffen up"]},{"term":"tear off","prompt":"She _____ the bottom of the form and sent it with her cheque.","choices":["throw on","tear off","thaw out","tee up"]},{"term":"tee off","prompt":"He _____ at the first hole.","choices":["throw together","tee off","thaw out","throw on"]},{"term":"tee up","prompt":"She _____ two strokes ahead at the last hole.","choices":["tee up","take after","take to","take in"]},{"term":"thaw out","prompt":"Take the frozen chicken out of the freezer to let it _____ before dinner.","choices":["thaw out","stop around","stop back","stiffen up"]},{"term":"throw on","prompt":"I _____ a jacket and rushed outside.","choices":["tear away","tear off","take to","throw on"]},{"term":"throw together","prompt":"I _____ before we left.","choices":["stay up","stick around","throw together","stiffen up"]}]},{"id":"phrasal-verbs-v1-lesson-019","title":"Bài 19: Sinh hoạt và gia đình · tidy–while","focus":"Việc thường ngày, nhà cửa và chăm sóc bản thân. Các cụm được xếp theo động từ gốc (tidy–while).","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","questions":[{"term":"tidy up","prompt":"I _____ my bedroom because it was a complete mess.","choices":["tie back","toss back","while away","tidy up"]},{"term":"tie back","prompt":"She _____ before playing tennis.","choices":["tuck in","tuck up","tuck into","tie back"]},{"term":"toss back","prompt":"I _____ my beer and left.","choices":["toss back","wait up","veg out","wait in"]},{"term":"toss down","prompt":"I _____ before they arrived.","choices":["tuck away","tuck in","touch up","toss down"]},{"term":"touch up","prompt":"I couldn't be bothered to redecorate, so I just _____ the bits that needed painting the most.","choices":["wait in","veg out","touch up","tuck into"]},{"term":"tuck away","prompt":"I _____ in my drawer.","choices":["tuck away","walk out on","walk out","wash up"]},{"term":"tuck in","prompt":"He _____ and read her a story.","choices":["veg out","vacuum up","use up","tuck in"]},{"term":"tuck into","prompt":"I was starving and _____ the food.","choices":["tuck into","vacuum up","use up","touch up"]},{"term":"tuck up","prompt":"She _____ in bed and switched the lights off.","choices":["tie back","tuck up","walk out on","while away"]},{"term":"use up","prompt":"We _____ all the olive oil.","choices":["use up","walk out","veg out","wait in"]},{"term":"vacuum up","prompt":"He _____ all of the food.","choices":["vacuum up","walk out on","walk out","while away"]},{"term":"veg out","prompt":"I'm going to _____ in front of the TV tonight.","choices":["tuck into","use up","tuck up","veg out"]},{"term":"wait in","prompt":"I _____ for the guy to fix the TV.","choices":["tie back","wait in","while away","tidy up"]},{"term":"wait up","prompt":"I was worried and _____ until they got home safe and sound.","choices":["while away","wait up","walk out","walk out on"]},{"term":"walk out","prompt":"The film was a bore so I _____ halfway through.","choices":["wait in","vacuum up","walk out","wait up"]},{"term":"walk out on","prompt":"He _____ his wife last year.","choices":["tidy up","walk out on","while away","wash up"]},{"term":"wash up","prompt":"The children _____ after lunch.","choices":["tuck away","toss down","tuck in","wash up"]},{"term":"while away","prompt":"We _____ playing computer games.","choices":["tuck into","tuck in","touch up","while away"]}]},{"id":"phrasal-verbs-v1-lesson-020","title":"Bài 20: Học tập và công việc · aim–bunk","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (aim–bunk).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"aim at","prompt":"They're _____ reducing costs by ten percent.","choices":["bone up","aim at","block in","blow off"]},{"term":"bash out","prompt":"I _____ the night before I had to hand it in.","choices":["bash out","blow off","beaver away at","block in"]},{"term":"beat out","prompt":"The marathon runner barely _____ his rival at the tape.","choices":["bunk off","beaver away","aim at","beat out"]},{"term":"beaver away","prompt":"She's _____ before her exams.","choices":["breeze through","beaver away","brush up","brush up on"]},{"term":"beaver away at","prompt":"I have to _____ it or else I will fail the course.","choices":["beaver away at","beat out","block in","bash out"]},{"term":"block in","prompt":"He _____ the events in his calendar.","choices":["buff up on","block in","buckle down","buff up"]},{"term":"blow off","prompt":"I _____ and did badly.","choices":["blow off","bash out","bulk out","aim at"]},{"term":"bone up","prompt":"I will have to _____ to get a good result.","choices":["breeze through","bowl out","blow off","bone up"]},{"term":"bone up on","prompt":"I need to _____ my French grammar for the test.","choices":["beat out","bone up on","aim at","bash out"]},{"term":"bowl out","prompt":"He _____ first ball.","choices":["breeze through","bowl out","brush up","bone up on"]},{"term":"breeze through","prompt":"She _____ her exams.","choices":["block in","beaver away at","beaver away","breeze through"]},{"term":"brush up","prompt":"She took a two-week course to _____ her Spanish before she went travelling around South and Central America.","choices":["brush up","block in","beaver away at","blow off"]},{"term":"brush up on","prompt":"I need to _____ my French before traveling to Paris next month.","choices":["bunk off","bash out","aim at","brush up on"]},{"term":"buckle down","prompt":"We had to _____ and study for the exam.","choices":["buckle down","bone up on","bone up","blow off"]},{"term":"buff up","prompt":"After the scandal, the politician tried to _____ his public image.","choices":["brush up on","breeze through","buff up","buckle down"]},{"term":"buff up on","prompt":"I _____ my grammar before the test.","choices":["aim at","bunk off","buff up on","bash out"]},{"term":"build up","prompt":"She _____ from nothing into a market leader in less than a decade.","choices":["build up","breeze through","bone up on","bowl out"]},{"term":"bulk out","prompt":"I _____ with a few quotes to reach the number of word required.","choices":["buckle down","bulk out","brush up","brush up on"]},{"term":"bunk off","prompt":"I used to _____ school and go into town.","choices":["bowl out","bone up","bunk off","bone up on"]}]},{"id":"phrasal-verbs-v1-lesson-021","title":"Bài 21: Học tập và công việc · call–coast","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (call–coast).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"call in","prompt":"I had to _____ a mechanic for help.","choices":["check over","check off","call in","choose up"]},{"term":"carry off","prompt":"She _____ the first prize in the competition.","choices":["carry off","close out","churn out","chuck up"]},{"term":"carry over","prompt":"The meeting _____ into the afternoon because there was so much to talk about.","choices":["carry over","churn out","chuck up","chuck in"]},{"term":"carry through","prompt":"They _____ despite the opposition.","choices":["catch on","catch up on","carry through","carve out"]},{"term":"carve out","prompt":"She's _____ a career in photojournalism.","choices":["carry over","carve out","catch on","carry through"]},{"term":"catch on","prompt":"Everyone else realised what was happening, but it took Henry ages to _____.","choices":["chuck in","check over","catch on","choose up"]},{"term":"catch up on","prompt":"I hadn't seen her for years, so we spent the afternoon _____ old times.","choices":["carve out","catch up on","carry through","carry over"]},{"term":"chalk out","prompt":"He tried to _____ a plan on paper.","choices":["check by","chase up","chalk out","change over"]},{"term":"change over","prompt":"The Irish _____ to using kilometres in 2005.","choices":["change over","choose up","check by","check off"]},{"term":"chase up","prompt":"The librarian is _____ about my overdue books.","choices":["chalk out","check by","change over","chase up"]},{"term":"check by","prompt":"We _____ the office to see if the stuff was ready.","choices":["check by","chuck in","choose up","chase up"]},{"term":"check off","prompt":"She _____ the candidates' names as they arrived.","choices":["coast along","call in","check off","carry over"]},{"term":"check over","prompt":"We _____ before signing it.","choices":["chuck in","check over","choose up","chase up"]},{"term":"choose up","prompt":"We _____ to play the game.","choices":["check over","check off","check by","choose up"]},{"term":"chuck in","prompt":"I _____ to go travelling.","choices":["chase up","chuck in","change over","check by"]},{"term":"chuck up","prompt":"She didn't like the course, so she _____ after a few weeks.","choices":["chuck up","close out","churn out","coast along"]},{"term":"churn out","prompt":"The government _____ educational policies every few months.","choices":["catch on","carry over","carry through","churn out"]},{"term":"close out","prompt":"We _____ the meeting early and went home.","choices":["catch on","close out","carry over","carry through"]},{"term":"coast along","prompt":"She's been _____ all year and hasn't made a lot of progress.","choices":["churn out","coast along","chuck up","close out"]}]},{"id":"phrasal-verbs-v1-lesson-022","title":"Bài 22: Học tập và công việc · cobble–doss","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (cobble–doss).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"cobble together","prompt":"They _____ and submitted it.","choices":["dig into","dip into","cobble together","dive in"]},{"term":"come in","prompt":"I did my best but _____ last but one in the race.","choices":["crank out","cover for","crack on","come in"]},{"term":"contract in","prompt":"Since it started, many companies have _____ to lend their support.","choices":["cover for","crank out","contract in","crack on"]},{"term":"count against","prompt":"Not having a university degree will _____ her.","choices":["cover for","crack on","crank out","count against"]},{"term":"count for","prompt":"Experience _____ a lot in decision making.","choices":["cross off","crack on","crank out","count for"]},{"term":"count off","prompt":"They _____ as they arrived.","choices":["doss about","dive into","dive in","count off"]},{"term":"cover for","prompt":"I _____ her while she was off sick.","choices":["cross out","dash off","cruise through","cover for"]},{"term":"crack on","prompt":"We had to _____ to get everything finished on time.","choices":["crack on","come in","contract in","count against"]},{"term":"crank out","prompt":"My boss keeps _____ stupid memos.","choices":["dash off","dig into","crank out","cruise through"]},{"term":"cross off","prompt":"She _____ her Christmas card list after they argued.","choices":["dive into","doss about","doss around","cross off"]},{"term":"cross out","prompt":"She _____ her mistakes and wrote the correct answers above them.","choices":["dive into","dive in","dip into","cross out"]},{"term":"cruise through","prompt":"He _____ the exam.","choices":["cruise through","cross out","cross off","crank out"]},{"term":"dash off","prompt":"He _____ the report in a couple of hours.","choices":["crack on","crank out","cross out","dash off"]},{"term":"dig into","prompt":"She _____ her handbag and pulled out a bunch of keys.","choices":["count for","cover for","count off","dig into"]},{"term":"dip into","prompt":"I've been _____ the book, but haven't read it properly.","choices":["dash off","dip into","cruise through","dive in"]},{"term":"dive in","prompt":"When we saw what was happening, we all _____ to help.","choices":["doss about","cobble together","doss around","dive in"]},{"term":"dive into","prompt":"She _____ her bag and pulled out a lighter.","choices":["dive into","crank out","cross off","crack on"]},{"term":"doss about","prompt":"I couldn't get down to my work and _____ all night.","choices":["cruise through","doss about","cross out","dash off"]},{"term":"doss around","prompt":"I spent the afternoon _____.","choices":["dash off","dip into","dig into","doss around"]}]},{"id":"phrasal-verbs-v1-lesson-023","title":"Bài 23: Học tập và công việc · draw–finish","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (draw–finish).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"draw out","prompt":"The director _____ with a lengthy speech.","choices":["embark upon","draw out","enter for","embark on"]},{"term":"draw up","prompt":"The contract was _____ by our solicitor.","choices":["drum into","draw up","drill down through","drill into"]},{"term":"drill down through","prompt":"They _____ the information to find the truth.","choices":["drill down through","fiddle about","farm out","figure on"]},{"term":"drill into","prompt":"The teacher _____ the students.","choices":["drum out","embark on","edge out","drill into"]},{"term":"drum into","prompt":"They _____ you before the test, so you can't go wrong.","choices":["drum into","figure on","fiddle about","farm out"]},{"term":"drum out","prompt":"The company decided to _____ the lazy worker.","choices":["fill in for","figure on","drum out","fiddle about"]},{"term":"edge out","prompt":"The shareholders _____ because results were getting worse.","choices":["embark on","drum into","drill into","edge out"]},{"term":"embark on","prompt":"Piere _____ an mba at Insead last autumn.","choices":["embark on","fill in for","farm out","fiddle about"]},{"term":"embark upon","prompt":"Fernanda has just _____ a new professional challenge.","choices":["enter for","embark upon","faff about","edge out"]},{"term":"enter for","prompt":"They _____ the national championship but weren't good enough.","choices":["fiddle about","figure on","farm out","enter for"]},{"term":"faff about","prompt":"He told her to stop _____ and make her mind up.","choices":["faff about","figure on","fill in for","fill out"]},{"term":"faff around","prompt":"She told him to stop _____ and make his mind up.","choices":["fiddle about","farm out","fall into","faff around"]},{"term":"fall into","prompt":"I just _____ my job when an opportunity came up.","choices":["embark on","fall into","edge out","drum out"]},{"term":"farm out","prompt":"The company wants to _____ their maintenance.","choices":["farm out","draw up","drill down through","drill into"]},{"term":"fiddle about","prompt":"He likes to _____ instead of actually working hard.","choices":["enter for","fall into","faff around","fiddle about"]},{"term":"figure on","prompt":"What job do you _____ doing when you graduate?","choices":["finish up with","figure on","draw up","draw out"]},{"term":"fill in for","prompt":"I was away for a few days, so they had to get someone to _____ me.","choices":["fill in for","faff around","fall into","faff about"]},{"term":"fill out","prompt":"I _____ the application form and mailed it.","choices":["fiddle about","fill out","figure on","fall into"]},{"term":"finish up with","prompt":"We attended some workshops and _____ the keynote speaker.","choices":["fill in for","draw out","fill out","finish up with"]}]},{"id":"phrasal-verbs-v1-lesson-024","title":"Bài 24: Học tập và công việc · firm–go","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (firm–go).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"firm up","prompt":"We need to _____ some aspects of the contract before we sign it.","choices":["gear to","get around to","firm up","get along in"]},{"term":"fit in","prompt":"I didn't have time to _____ another appointment.","choices":["fit in","gear up","gear to","get around to"]},{"term":"flame out","prompt":"The company _____ in the recession.","choices":["free up","fool around","gear to","flame out"]},{"term":"flesh out","prompt":"The recent government report _____ the draft proposals.","choices":["flesh out","follow on from","focus on","follow on"]},{"term":"focus on","prompt":"The report _____ the company's weak points.","choices":["focus on","follow up","follow through","fool around"]},{"term":"follow on","prompt":"They were over 200 runs behind and had to _____.","choices":["get on with","firm up","go ahead with","follow on"]},{"term":"follow on from","prompt":"The film _____ the original.","choices":["follow on from","go ahead with","get on with","firm up"]},{"term":"follow through","prompt":"The project went wrong when the staff failed to _____.","choices":["go ahead with","firm up","follow through","get on with"]},{"term":"follow up","prompt":"He _____ the meeting with a report.","choices":["get along in","get around to","follow up","get down to"]},{"term":"fool around","prompt":"The teacher was angry because the class were _____.","choices":["fool around","free up","follow up","follow through"]},{"term":"free up","prompt":"If you proofread this text, it will _____ to get on with the next part.","choices":["get in on","free up","get on with","get down to"]},{"term":"gear to","prompt":"It's not _____ non-specialists.","choices":["firm up","fit in","gear to","flame out"]},{"term":"gear up","prompt":"The shops are _____ for the New Year sales.","choices":["gear up","follow on","flesh out","focus on"]},{"term":"get along in","prompt":"How are you _____ the company.","choices":["get along in","go ahead with","firm up","flame out"]},{"term":"get around to","prompt":"It always takes me ages to _____ replying to letters.","choices":["gear up","go ahead with","get around to","firm up"]},{"term":"get down to","prompt":"I find it extremely difficult to _____ doing any revision for examinations.","choices":["firm up","get down to","go ahead with","fit in"]},{"term":"get in on","prompt":"The company tried to _____ our market.","choices":["get in on","fit in","flesh out","flame out"]},{"term":"get on with","prompt":"She told us to _____ our work.","choices":["get on with","fit in","firm up","gear up"]},{"term":"go ahead with","prompt":"We now intend to _____ the final stage of the project despite the protests from environmentalists.","choices":["flame out","go ahead with","fit in","flesh out"]}]},{"id":"phrasal-verbs-v1-lesson-025","title":"Bài 25: Học tập và công việc · go–has","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (go–has).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"go down to","prompt":"Chelsea _____ Arsenal in a thrilling game.","choices":["gun for","goof off","go down to","grind out"]},{"term":"go in for","prompt":"He _____ the photography prize, but didn't win.","choices":["grind out","goof off","hammer away at","go in for"]},{"term":"go in with","prompt":"They're going to _____ the Social Democrats.","choices":["grind out","go in with","goof off","gun for"]},{"term":"go into","prompt":"She _____ banking after she'd finished university.","choices":["gun for","grind out","goof off","go into"]},{"term":"go on with","prompt":"Please _____ your work.","choices":["goof off","gun for","grind out","go on with"]},{"term":"go out","prompt":"England _____ in the second round.","choices":["gun for","hammer away at","goof off","go out"]},{"term":"go out for","prompt":"She _____ a place on the team.","choices":["go out for","hammer into","hand back","hammer away at"]},{"term":"go up to","prompt":"She _____ Cambridge after she finished secondary school.","choices":["grind out","go up to","goof off","gun for"]},{"term":"goof off","prompt":"We _____ for the afternoon to watch the match.","choices":["grind out","gun for","goof off","hammer away at"]},{"term":"grind out","prompt":"I find it very hard to _____ an original essay every week.","choices":["grind out","go up to","go on with","go out for"]},{"term":"gun for","prompt":"He's _____ his rivals at work.","choices":["go in with","go into","gun for","go on with"]},{"term":"hammer away at","prompt":"She _____ her PC all night and finished the project.","choices":["hand back","hand over","hand down","hammer away at"]},{"term":"hammer into","prompt":"He _____ me.","choices":["hammer into","hand down","hand over","hand back"]},{"term":"hand back","prompt":"The police officer checked my licence, then _____.","choices":["hang it up","has to","hang together","hand back"]},{"term":"hand down","prompt":"The court _____ its ruling yesterday.","choices":["go out for","go up to","hand down","go out"]},{"term":"hand over","prompt":"The robbers told the clerk to _____ all the money.","choices":["hand over","gun for","hammer away at","hammer into"]},{"term":"hang it up","prompt":"I’m getting too old for this- I’m going to _____ starting next month.","choices":["gun for","hang it up","goof off","grind out"]},{"term":"hang together","prompt":"We have to _____ if we're going to finish this project.","choices":["hang together","go in for","has to","go down to"]},{"term":"has to","prompt":"She _____ finish her homework tonight.","choices":["hammer into","hand down","hand back","has to"]}]},{"id":"phrasal-verbs-v1-lesson-026","title":"Bài 26: Học tập và công việc · have–lay","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (have–lay).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"have off","prompt":"I _____ last week to relax.","choices":["hold back","have off","horse around","hold over"]},{"term":"head up","prompt":"He's _____ the steering committee.","choices":["knuckle down","head up","knuckle under","lark around"]},{"term":"hold back","prompt":"Lack of funding _____.","choices":["hold back","keep on","keep up at","keep in"]},{"term":"hold over","prompt":"It has been so successful that they have _____ for another fortnight.","choices":["horse around","hold over","head up","have off"]},{"term":"horse around","prompt":"The class were _____ when the teacher came in and told them to sit down.","choices":["jerk off","keep at","jack in","horse around"]},{"term":"hound out","prompt":"The press _____ after the scandal broke.","choices":["keep on","hound out","keep up with","keep up at"]},{"term":"jack in","prompt":"I _____ because my boss refused to give me a raise.","choices":["jack in","knuckle under","knock up","knuckle down"]},{"term":"jerk off","prompt":"You should get your work done and stop _____.","choices":["keep up with","keep up at","jerk off","knock up"]},{"term":"keep at","prompt":"She found the course hard but she _____ it and completed it successfully.","choices":["keep at","knuckle down","knock off","knock up"]},{"term":"keep in","prompt":"The teacher _____ after school because they had misbehaved.","choices":["keep in","lay off","lark around","knuckle under"]},{"term":"keep on","prompt":"He _____ trying and succeeded in the end.","choices":["hold over","hold back","keep on","horse around"]},{"term":"keep up at","prompt":"Learning a language is difficult, but if you _____ it, you'll succeed in the end.","choices":["knock off","knuckle down","knock up","keep up at"]},{"term":"keep up with","prompt":"He walks too fast and it's really hard to _____ him.","choices":["knock off","keep up with","knock up","jerk off"]},{"term":"knock off","prompt":"I _____ in an hour.","choices":["lark around","knuckle under","knuckle down","knock off"]},{"term":"knock up","prompt":"The teams _____ for a few minutes before the final.","choices":["lark around","knuckle under","knock up","knuckle down"]},{"term":"knuckle down","prompt":"I've got my exams next week and I haven't done much work, so I'd better _____.","choices":["knuckle down","hold back","head up","have off"]},{"term":"knuckle under","prompt":"The teacher made the students _____ and hand their projects in on time.","choices":["keep in","keep at","keep on","knuckle under"]},{"term":"lark around","prompt":"The students wouldn't stop _____.","choices":["lark around","lay off","have off","head up"]},{"term":"lay off","prompt":"The hotel _____ twenty staff because tourist numbers were down.","choices":["keep up with","knock up","keep up at","lay off"]}]},{"id":"phrasal-verbs-v1-lesson-027","title":"Bài 27: Học tập và công việc · lay–nose","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (lay–nose).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"lay on","prompt":"They _____ a buffet lunch at the conference.","choices":["nail down","lay on","leave out","nose around"]},{"term":"leave out","prompt":"He was _____ of the side because he hasn't been playing too well lately.","choices":["look through","look over","leave out","mark down"]},{"term":"limber up for","prompt":"They are _____ the end of the financial year.","choices":["limber up for","line up","look through","look over"]},{"term":"line up","prompt":"We have _____ a lot of meetings for them.","choices":["measure against","line up","measure out","measure off"]},{"term":"look over","prompt":"They came to _____ with a view to buying it.","choices":["mug up","look over","mug up on","nail down"]},{"term":"look through","prompt":"I _____ the article.","choices":["nail down","look through","lay on","nose around"]},{"term":"mark down","prompt":"Students who gave obviously rehearsed answers were _____, while those who spoke naturally were rewarded accordingly.","choices":["nose around","mug up on","mug up","mark down"]},{"term":"mark off","prompt":"I _____ the items on the list as I finished them.","choices":["move up","mug up","mug up on","mark off"]},{"term":"mark out","prompt":"They _____ the pitch.","choices":["mark out","lay on","line up","limber up for"]},{"term":"measure against","prompt":"The work doesn't look good if you _____ what our competitors have done.","choices":["mock up","measure against","mark off","mark out"]},{"term":"measure off","prompt":"The tailor _____ the material for my suit.","choices":["mug up on","nail down","measure off","nose around"]},{"term":"measure out","prompt":"She _____ a hundred grammes of the powder.","choices":["mug up","measure out","move down","move up"]},{"term":"mock up","prompt":"They _____ an example to show us what they would look like.","choices":["mock up","mark down","look through","look over"]},{"term":"move down","prompt":"He was finding the course too difficult so they _____.","choices":["lay on","leave out","limber up for","move down"]},{"term":"move up","prompt":"They _____ to senior management.","choices":["nose around","move up","mug up on","nail down"]},{"term":"mug up","prompt":"I have to _____ before the exam.","choices":["nose around","nail down","move down","mug up"]},{"term":"mug up on","prompt":"I need to _____ my history for the test.","choices":["mark down","look through","look over","mug up on"]},{"term":"nail down","prompt":"I can't _____ about when they're going to finish the project.","choices":["measure out","measure off","mock up","nail down"]},{"term":"nose around","prompt":"The boss keeps _____ our office when we are out at lunch.","choices":["nose around","measure off","measure against","mark out"]}]},{"id":"phrasal-verbs-v1-lesson-028","title":"Bài 28: Học tập và công việc · nose–pull","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (nose–pull).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"nose out","prompt":"The other candidate _____ by a few votes.","choices":["pencil in","nose out","phase in","pass over"]},{"term":"note down","prompt":"She _____ my fax number so that she could send me the documents when she got to the office.","choices":["note down","polish up","press for","pore over"]},{"term":"pair up","prompt":"We should _____ to finish this project faster.","choices":["press forward with","press for","pair up","pore over"]},{"term":"pass back","prompt":"I felt awful when the teacher started to _____ the exam papers.","choices":["press on","press into","pass back","pull together"]},{"term":"pass over","prompt":"They _____ and made his assistant the new director.","choices":["pitch in","phase out","pass over","pitch for"]},{"term":"pencil in","prompt":"I'll _____, but if anything comes up, give me a ring.","choices":["pencil in","plough on","phase out","pitch for"]},{"term":"phase in","prompt":"They are _____ the reforms over the next two years.","choices":["plow through","plough on","phase in","pitch for"]},{"term":"phase out","prompt":"They have introduced a compact edition of the newspaper and are _____ the broadsheet edition over the next few months.","choices":["pass over","phase out","pass back","pair up"]},{"term":"pitch for","prompt":"He _____ the job, but they gave it to someone else.","choices":["nose out","pull together","press on","pitch for"]},{"term":"pitch in","prompt":"We were behind schedule, but the others _____ and we got it done in time.","choices":["pitch in","plough on","plow through","phase out"]},{"term":"plough on","prompt":"It was really boring, but we _____.","choices":["polish up","plow through","plough on","pore over"]},{"term":"plow through","prompt":"It takes me ages to _____ any of Henry James' novels.","choices":["note down","plow through","nose out","pair up"]},{"term":"polish up","prompt":"I need to _____ my French before I go to Paris.","choices":["polish up","pull together","note down","nose out"]},{"term":"pore over","prompt":"She _____ the report looking for mistakes.","choices":["pore over","plow through","polish up","press for"]},{"term":"press for","prompt":"The workers are _____ better pay and conditions.","choices":["note down","press for","nose out","pull together"]},{"term":"press forward with","prompt":"The government are _____ the new law.","choices":["pair up","note down","pass back","press forward with"]},{"term":"press into","prompt":"When the line was breached, reserve troops were _____ service.","choices":["pitch in","phase out","pitch for","press into"]},{"term":"press on","prompt":"We _____ to get to our destination before night fell.","choices":["note down","pair up","press on","nose out"]},{"term":"pull together","prompt":"If we all _____, we'll have it finished in no time.","choices":["pull together","phase out","pencil in","phase in"]}]},{"id":"phrasal-verbs-v1-lesson-029","title":"Bài 29: Học tập và công việc · put–sail","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (put–sail).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"put in for","prompt":"He _____ a transfer to the new branch.","choices":["rub up on","put in for","run off","run against"]},{"term":"put up","prompt":"They _____ a great fight but lost.","choices":["read up on","sail through","reach out for","put up"]},{"term":"reach out for","prompt":"They are _____ major economic reforms.","choices":["run over","run off","run against","reach out for"]},{"term":"read up on","prompt":"I've been _____ Japan as I'm going to live there next year.","choices":["run for","round off","run against","read up on"]},{"term":"report to","prompt":"In my new role, I _____ the marketing director.","choices":["read up on","reach out for","report to","ride on"]},{"term":"ride on","prompt":"His reputation is _____ this deal working out.","choices":["run off","run for","ride on","run against"]},{"term":"romp through","prompt":"We _____ the tasks because they were so simple.","choices":["saddle with","run over","put in for","romp through"]},{"term":"rope in","prompt":"The teacher _____ to carry her stuff when she had to change classroom.","choices":["report to","ride on","romp through","rope in"]},{"term":"rope into","prompt":"I got _____ helping them set the stall up.","choices":["run against","rub up on","round off","rope into"]},{"term":"round off","prompt":"Winning the fa Cup _____ a wonderful season for Arsenal.","choices":["run over","saddle with","run through","round off"]},{"term":"rub up on","prompt":"I need to _____ my Portuguese before I go to Brazil.","choices":["put up","reach out for","rub up on","put in for"]},{"term":"run against","prompt":"Opinion is _____ his policies and he has very little support.","choices":["saddle with","run against","round off","rub up on"]},{"term":"run for","prompt":"She's thinking about _____ the presidency.","choices":["rub up on","run for","round off","saddle with"]},{"term":"run off","prompt":"Could you _____ two hundred copies of this report, please.","choices":["sail through","put in for","run off","saddle with"]},{"term":"run over","prompt":"The meeting _____ by twenty minutes.","choices":["put in for","run over","sail through","saddle with"]},{"term":"run through","prompt":"The cast _____ the play the day before it opened to the public.","choices":["run through","saddle with","put in for","put up"]},{"term":"saddle with","prompt":"They _____ preparing the visit.","choices":["romp through","saddle with","rope into","rope in"]},{"term":"sail through","prompt":"He _____ the final test.","choices":["run off","saddle with","sail through","run over"]}]},{"id":"phrasal-verbs-v1-lesson-030","title":"Bài 30: Học tập và công việc · scout–sign","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (scout–sign).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"scout about","prompt":"The company is _____ for new staff.","choices":["shape up","shake up","scout about","shoot for"]},{"term":"scout up","prompt":"We'd better _____ a replacement for her.","choices":["set about","set back","set to","scout up"]},{"term":"scrape in","prompt":"The government _____ with 51% of the votes cast.","choices":["set back","send off","scrape in","set about"]},{"term":"scrape into","prompt":"She got mediocre grades and just _____ university.","choices":["send off","set about","scrape into","set back"]},{"term":"scrape through","prompt":"I did no revision and only just _____ the final exams.","choices":["scout up","send off","scrape through","scout about"]},{"term":"send off","prompt":"The football striker was _____ for arguing with the referee's decision.","choices":["set to","set about","send off","set back"]},{"term":"set about","prompt":"We _____ the cleaning and got it done before lunchtime.","choices":["scrape through","shade in","set about","send off"]},{"term":"set back","prompt":"The accident _____ several months.","choices":["scrape in","scrape through","set back","scrape into"]},{"term":"set to","prompt":"If we all _____, we should be able to finish this in a few hours.","choices":["set to","sign off on","scout about","sign on"]},{"term":"shade in","prompt":"She _____ the area under the tree.","choices":["shade in","scout up","sign on","scout about"]},{"term":"shake up","prompt":"The management are _____ and getting rid of a lot of workers.","choices":["scrape in","scout about","shake up","scrape into"]},{"term":"shape up","prompt":"If they don't start _____, they're going to lose their jobs.","choices":["sign off","sign off on","sign on","shape up"]},{"term":"shoot for","prompt":"I’m _____ nothing less than the presidency.","choices":["shoot for","send off","set back","set about"]},{"term":"show in","prompt":"The secretary _____ to speak to the manager.","choices":["sign on","show in","sign off on","sign off"]},{"term":"shut out","prompt":"The Dodgers _____ the Giants 3-0.","choices":["shape up","shoot for","show in","shut out"]},{"term":"sign off","prompt":"My doctor _____ for a month with back problems.","choices":["shut out","show in","sign off","scout about"]},{"term":"sign off on","prompt":"The director _____ the plans to increase sales.","choices":["set about","set back","sign off on","set to"]},{"term":"sign on","prompt":"I had to _____ when I lost my job.","choices":["shoot for","show in","shape up","sign on"]}]},{"id":"phrasal-verbs-v1-lesson-031","title":"Bài 31: Học tập và công việc · sign–stand","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (sign–stand).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"sign on with","prompt":"He's _____ Manchester United for the next three years.","choices":["sit in on","sign on with","sit out","skive off"]},{"term":"sign up","prompt":"I've _____ as a volunteer.","choices":["sign up","sniff around","soldier on","stand aside"]},{"term":"sign with","prompt":"She's _____ emi for the next few years.","choices":["stand in for","stand down","sign with","stand aside"]},{"term":"sit for","prompt":"The Queen _____ another official portrait.","choices":["skive off","sign with","sit for","slack off"]},{"term":"sit in for","prompt":"Can you _____ me at the meeting?","choices":["sit in for","sign with","sign up","skive off"]},{"term":"sit in on","prompt":"She _____ the meeting and took notes but said nothing.","choices":["sniff around","sit in on","slope off","slacken off"]},{"term":"sit out","prompt":"I had to _____ because I was ill.","choices":["staff up","soldier on","sniff around","sit out"]},{"term":"skive off","prompt":"I pretended I was ill and _____ on Monday.","choices":["sit in for","skive off","sign with","sit for"]},{"term":"slack off","prompt":"Students usually begin the term well, then _____ near the end of the semester.","choices":["slack off","stand down","stand in for","stand aside"]},{"term":"slacken off","prompt":"Work _____ during the holiday period.","choices":["sniff around","staff up","soldier on","slacken off"]},{"term":"slope off","prompt":"The lecture sounded really boring, so I _____ and went to the pub.","choices":["sign with","sit for","sign up","slope off"]},{"term":"sniff around","prompt":"I _____ to see if I could find a better deal.","choices":["sniff around","sit out","sit in for","sit in on"]},{"term":"soldier on","prompt":"Life got hard for my dog when he went blind, but he just _____ and never complained.","choices":["stand down","stand aside","stand in for","soldier on"]},{"term":"staff up","prompt":"They haven't _____ yet.","choices":["staff up","stand out","stand in for","sign on with"]},{"term":"stand aside","prompt":"The prime minister should _____ and let a new leader head the party.","choices":["stand aside","staff up","sign up","sign on with"]},{"term":"stand down","prompt":"The minister announced her intention to _____ at the next election.","choices":["sign up","staff up","stand down","sign on with"]},{"term":"stand in for","prompt":"She had to _____ the editor while he was on holiday.","choices":["sign with","sign up","stand in for","sign on with"]},{"term":"stand out","prompt":"She _____ from the crowd in selection and was offered the job.","choices":["stand out","sign up","sit for","sign with"]}]},{"id":"phrasal-verbs-v1-lesson-032","title":"Bài 32: Học tập và công việc · start–tap","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (start–tap).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"start off","prompt":"They _____ the meeting with an attack on our performance.","choices":["step aside","stick at","start off","stay on"]},{"term":"start out to","prompt":"I didn't _____ become the boss- it just happened.","choices":["stay on","stick at","start out to","step aside"]},{"term":"stay on","prompt":"She _____ after she graduated to do a Master's degree.","choices":["take part in","stay on","take down","take through"]},{"term":"step aside","prompt":"Everyone thinks that the prime minister should _____ so that someone new can lead the party into the election.","choices":["stick with","step aside","strike off","stick to"]},{"term":"stick at","prompt":"She found the course very tough but she _____ it and did well in the end.","choices":["stick at","sweep through","take part in","take down"]},{"term":"stick down","prompt":"I couldn't answer the test so I just _____ that I could remember.","choices":["stick down","step aside","strike off","strike out"]},{"term":"stick out","prompt":"I _____ even though I hated every minute of it.","choices":["take through","talk through","tap up","stick out"]},{"term":"stick to","prompt":"I _____ the path and didn't take the shortcut.","choices":["stick to","stay on","step aside","start off"]},{"term":"stick with","prompt":"I _____ the job though I found it very stressful.","choices":["string together","strike out","strike off","stick with"]},{"term":"strike off","prompt":"The Medical Council _____ for malpractice.","choices":["strike off","start out to","tap up","talk through"]},{"term":"strike out","prompt":"After doing the same job for five years, I decided to _____ and change careers.","choices":["stick down","stick with","stick to","strike out"]},{"term":"string together","prompt":"I was so nervous in the interview that I could hardly _____.","choices":["take through","string together","take part in","talk through"]},{"term":"sweep through","prompt":"She _____ the exams.","choices":["stick with","stick to","stick out","sweep through"]},{"term":"take down","prompt":"The police _____ his answers to their questions.","choices":["string together","sweep through","take down","strike out"]},{"term":"take part in","prompt":"Hundreds of enthusiastic runners _____ the charity marathon.","choices":["start off","talk through","tap up","take part in"]},{"term":"take through","prompt":"He _____ the procedures before we started.","choices":["stick down","step aside","stick at","take through"]},{"term":"talk through","prompt":"The teacher _____ the test so I knew what to expect.","choices":["tap up","take part in","talk through","take down"]},{"term":"tap up","prompt":"Chelsea were accused of _____ even though he was under contract.","choices":["strike off","string together","tap up","strike out"]}]},{"id":"phrasal-verbs-v1-lesson-033","title":"Bài 33: Học tập và công việc · team–zone","focus":"Học tập, công việc, cuộc họp và hoàn thành nhiệm vụ. Các cụm được xếp theo động từ gốc (team–zone).","topicId":"work-study","topicTitle":"Học tập và công việc","questions":[{"term":"team up","prompt":"They _____ to publicise the issue.","choices":["team up","turn in","wade through","try out for"]},{"term":"tick along","prompt":"Things are _____ at work while the director's away.","choices":["waltz through","tick along","walk through","wade through"]},{"term":"tick off","prompt":"She _____ our names when we arrived.","choices":["zone in","write up","tick off","zone in on"]},{"term":"tick over","prompt":"The company _____ while she was away on holiday.","choices":["try out for","turn in","tick over","try for"]},{"term":"toss off","prompt":"I _____ the essay the night before I had to hand it in.","choices":["toss off","walk through","waltz through","wade through"]},{"term":"train up","prompt":"I have been _____.","choices":["tick off","tick along","train up","tick over"]},{"term":"try for","prompt":"I'm going to _____ the job.","choices":["tick along","tick over","try for","tick off"]},{"term":"try out for","prompt":"He _____ the baseball team.","choices":["toss off","tick over","try out for","train up"]},{"term":"turn in","prompt":"She _____ her paper.","choices":["wise up","wrap up","waltz through","turn in"]},{"term":"wade through","prompt":"It took me ages to _____ the book.","choices":["write out","wrap up","wise up","wade through"]},{"term":"walk through","prompt":"He _____ the procedures.","choices":["write up","walk through","zone in on","zone in"]},{"term":"waltz through","prompt":"She _____ the tests and got the highest score.","choices":["waltz through","turn in","try out for","try for"]},{"term":"wise up","prompt":"His supervisor told him to _____ and start following the rules or else he'd lose his job.","choices":["tick off","tick along","wise up","tick over"]},{"term":"wrap up","prompt":"That _____, so we'll end this meeting.","choices":["zone in on","write out","wrap up","zone in"]},{"term":"write out","prompt":"I _____ my notes in full to help me remember them.","choices":["train up","toss off","write out","try for"]},{"term":"write up","prompt":"I _____ the report and submitted it.","choices":["write up","tick off","tick over","tick along"]},{"term":"zone in","prompt":"I was distracted but then I finally managed to _____.","choices":["team up","zone in","write up","write out"]},{"term":"zone in on","prompt":"I _____ what they were saying when they started gossiping.","choices":["write out","write up","wrap up","zone in on"]}]},{"id":"phrasal-verbs-v1-lesson-034","title":"Bài 34: Giao tiếp và quan hệ · angle–blurt","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (angle–blurt).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"angle for","prompt":"He's been _____ an invitation, but I don't want him to come.","choices":["bail up","angle for","bang on","bang on about"]},{"term":"answer back","prompt":"It is rude to _____ to parents.","choices":["answer back","blurt out","bear with","angle for"]},{"term":"answer for","prompt":"I can _____ my partner because I know her position on this issue.","choices":["argue out","ask about","answer for","ask around"]},{"term":"argue down","prompt":"The teacher tried to _____, but she couldn't.","choices":["argue down","angle for","answer back","blurt out"]},{"term":"argue out","prompt":"If we can't _____, we'll have to take them to court.","choices":["argue out","bail up","bang on","bail out on"]},{"term":"ask about","prompt":"He _____ my father.","choices":["ask about","argue out","back off","argue down"]},{"term":"ask around","prompt":"I have no idea, but I'll _____ at work and see if anyone can help.","choices":["back off","ask around","argue down","argue out"]},{"term":"back off","prompt":"The police told the protesters to _____.","choices":["blurt out","angle for","back off","answer back"]},{"term":"back out","prompt":"He decided to _____ of the deal.","choices":["angle for","back out","answer back","bear with"]},{"term":"bag out","prompt":"Don't _____ Australian English.","choices":["be on about","bag out","angle for","bear with"]},{"term":"bail out on","prompt":"Everybody _____ him when the scandal broke.","choices":["bail out on","blurt out","angle for","bear with"]},{"term":"bail up","prompt":"I was late because he _____ on the phone and wouldn't shut up.","choices":["argue out","answer for","bail up","argue down"]},{"term":"bang on","prompt":"He _____ for half an hour but no one was listening.","choices":["bang on","blurt out","be on about","bear with"]},{"term":"bang on about","prompt":"He's always _____ football.","choices":["bear with","angle for","bang on about","blurt out"]},{"term":"bawl out","prompt":"He _____ our names at the top of his voice.","choices":["bawl out","back off","bail up","bail out on"]},{"term":"be down on","prompt":"After the argument, James _____ his boss.","choices":["bear with","be down on","blurt out","angle for"]},{"term":"be in on","prompt":"Do you want to _____ this secret?","choices":["bear with","blurt out","angle for","be in on"]},{"term":"be on about","prompt":"I couldn't understand what he _____- it made no sense.","choices":["bawl out","bang on","bear with","be on about"]},{"term":"bear with","prompt":"Please _____ me a moment while I finish this email.","choices":["answer back","bear with","argue down","answer for"]},{"term":"blurt out","prompt":"I was really angry when he _____ the secret.","choices":["back off","ask around","ask about","blurt out"]}]},{"id":"phrasal-verbs-v1-lesson-035","title":"Bài 35: Giao tiếp và quan hệ · boss–cheer","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (boss–cheer).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"boss about","prompt":"He likes to _____ his younger siblings.","choices":["boss about","butter up","butt in","butt out"]},{"term":"boss around","prompt":"Stop trying to _____ your coworkers all day.","choices":["call up","boss around","catch up with","call out"]},{"term":"bounce into","prompt":"They have _____ calling an early election.","choices":["bounce into","cheer on","chat up","cheat on"]},{"term":"bounce off","prompt":"They _____ each other in a brainstorming session.","choices":["bounce off","boss around","boss about","bring forth"]},{"term":"bring forth","prompt":"The prosecution _____ a lot of evidence against him.","choices":["cater to","cheat on","bring forth","chat up"]},{"term":"bring out","prompt":"Suzie _____ the best in him.","choices":["bounce off","bump into","bring out","brush off"]},{"term":"brush off","prompt":"The minister _____ the criticism.","choices":["butt in","bust up","brush off","bump into"]},{"term":"bump into","prompt":"I _____ Helen on the underground the other day.","choices":["bump into","cheat on","cheer on","chat up"]},{"term":"bust up","prompt":"They _____ after a row last night.","choices":["call on","bust up","butt out","butt in"]},{"term":"butt in","prompt":"I hope you don't mind me _____ on your conversation, but I couldn't help hearing what you said...","choices":["bust up","butter up","bump into","butt in"]},{"term":"butt out","prompt":"This is none of your business, so just _____!","choices":["butter up","bust up","butt out","call on"]},{"term":"butter up","prompt":"I tried _____ but she still wouldn't let me hand it in late.","choices":["butt out","butter up","butt in","call on"]},{"term":"call on","prompt":"I now _____ the other party to give their account of what happened.","choices":["bust up","bump into","call on","brush off"]},{"term":"call out","prompt":"He _____ over awarding contracts to family members.","choices":["brush off","call out","bump into","bust up"]},{"term":"call up","prompt":"I _____ as soon as I got to a phone to tell him the news.","choices":["bump into","brush off","butt in","call up"]},{"term":"catch up with","prompt":"The tax authorities _____ me for not submitting my tax returns.","choices":["bump into","butt in","bust up","catch up with"]},{"term":"cater to","prompt":"The film _____ the audience's worst instincts.","choices":["cater to","chat up","cheat on","cheer on"]},{"term":"chat up","prompt":"He spent the whole night _____.","choices":["cater to","cheer on","chat up","cheat on"]},{"term":"cheat on","prompt":"She felt sad because he chose to _____ her.","choices":["butt in","cheat on","butt out","butter up"]},{"term":"cheer on","prompt":"They _____ throughout the match.","choices":["boss around","cheer on","bounce into","boss about"]}]},{"id":"phrasal-verbs-v1-lesson-036","title":"Bài 36: Giao tiếp và quan hệ · chew–dish","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (chew–dish).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"chew out","prompt":"They _____ for being late.","choices":["chew out","come in for","come down upon","come forth with"]},{"term":"chime in","prompt":"If it's OK, I'd like to _____ because I think it's a good idea.","choices":["dine out on","chime in","chew out","dish out"]},{"term":"chip in","prompt":"If I could _____, there are a couple of issues I'd like to raise.","choices":["come around to","climb down","chip in","come down on"]},{"term":"climb down","prompt":"The Prime Minister had to _____ over his tax proposals because there was so much opposition from the members of his own party.","choices":["climb down","cut out on","cry off","cut it out"]},{"term":"come around to","prompt":"They have started _____ our way of thinking and are less hostile.","choices":["come around to","chew out","chime in","dish out"]},{"term":"come down on","prompt":"The management really _____ him for losing the contract.","choices":["come down on","count in","cozy up to","cry off"]},{"term":"come down upon","prompt":"They will _____ us if we are late.","choices":["come down upon","cry off","cozy up to","cut it out"]},{"term":"come forth with","prompt":"Did anyone _____ any new evidence?","choices":["cut out on","come forth with","cry off","cut it out"]},{"term":"come in for","prompt":"Jack's _____ quite a lot of criticism of late.","choices":["count in","cozy up to","cry off","come in for"]},{"term":"come out","prompt":"He decided to _____ to his parents.","choices":["chime in","come out","climb down","chip in"]},{"term":"come out with","prompt":"She _____ the answer when everyone was expecting it to remain unsolved.","choices":["climb down","cozy up to","count in","come out with"]},{"term":"come through","prompt":"The news will _____ on the radio soon.","choices":["come through","cry off","count in","cozy up to"]},{"term":"count in","prompt":"If you're going on that skiing holiday, you can _____; I'd love to go.","choices":["count in","cry off","come through","cozy up to"]},{"term":"cozy up to","prompt":"He's been _____ our boss because he wants a pay rise.","choices":["cozy up to","come down upon","come forth with","come down on"]},{"term":"cry off","prompt":"I've got to work tonight; can I _____ going out for dinner?","choices":["cry off","cut it out","dash down","cut out on"]},{"term":"cut it out","prompt":"Will you two idiots _____ and keep quiet.","choices":["dash down","cut it out","dine out on","chime in"]},{"term":"cut out on","prompt":"Although he'd promised to help, the star _____ the charity when offered more money.","choices":["chew out","cut out on","chip in","chime in"]},{"term":"dash down","prompt":"He _____ a memo and sent it to everybody.","choices":["come out","dash down","come in for","come forth with"]},{"term":"dine out on","prompt":"I've _____ the story of his accident.","choices":["dash down","chew out","dine out on","dish out"]},{"term":"dish out","prompt":"He _____, but gets all hurt when anyone responds.","choices":["cozy up to","cry off","cut out on","dish out"]}]},{"id":"phrasal-verbs-v1-lesson-037","title":"Bài 37: Giao tiếp và quan hệ · draw–fink","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (draw–fink).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"draw into","prompt":"I didn't want to take sides because I didn't want to get _____ their arguments.","choices":["egg on","draw into","eye up","face off"]},{"term":"dredge up","prompt":"The newspapers _____ the details of his affair with his research assistant.","choices":["fink on","fawn on","fawn over","dredge up"]},{"term":"drift apart","prompt":"We were great friends at school but _____ when we went to different universities.","choices":["enter into","drift apart","egg on","dump on"]},{"term":"drone on","prompt":"The minister _____ for an hour and the audience looked increasingly bored.","choices":["fess up","drone on","fasten onto","fawn over"]},{"term":"drown out","prompt":"The music _____ the sound of the phone ringing.","choices":["fawn on","fasten on","fasten onto","drown out"]},{"term":"dumb down","prompt":"Television has been _____ the news for years.","choices":["dumb down","fawn on","fawn over","fess up"]},{"term":"dump on","prompt":"When he';s depressed, he needs someone to _____.","choices":["drown out","enter into","dumb down","dump on"]},{"term":"egg on","prompt":"The other students _____ when he started arguing with the teacher.","choices":["face off","egg on","eye up","enter into"]},{"term":"enter into","prompt":"They _____ an agreement with their rivals.","choices":["fess up","fink on","fink out","enter into"]},{"term":"eye up","prompt":"The guy _____ because he was behaving suspiciously.","choices":["drift apart","draw into","fink out","eye up"]},{"term":"face off","prompt":"The company _____ against its competitors.","choices":["dredge up","drift apart","drone on","face off"]},{"term":"fall for","prompt":"He _____ my story and allowed me yet another extension for the submission of my thesis.","choices":["fall for","fawn on","fawn over","fess up"]},{"term":"fall in with","prompt":"He quickly _____ the local cycling club and joined their weekly rides.","choices":["face off","fasten on","eye up","fall in with"]},{"term":"fasten on","prompt":"They have _____ the speech as a source of inspiration.","choices":["fasten on","eye up","dumb down","enter into"]},{"term":"fasten onto","prompt":"He _____ the minister on his visit and asked him repeatedly about the scandal.","choices":["drift apart","fasten onto","draw into","dredge up"]},{"term":"fawn on","prompt":"He's always _____ his boss to try to get promoted.","choices":["fink out","fawn on","fasten onto","fess up"]},{"term":"fawn over","prompt":"She _____ the inspectors in the hope that they would give her a good grade.","choices":["fink out","fink on","fawn over","fess up"]},{"term":"fess up","prompt":"The company _____ after they were exposed in the newspapers.","choices":["enter into","egg on","fess up","face off"]},{"term":"fink on","prompt":"He _____ her to the authorities.","choices":["dumb down","drown out","enter into","fink on"]},{"term":"fink out","prompt":"He said he'd come with us then _____ at the last minute.","choices":["eye up","enter into","fink out","egg on"]}]},{"id":"phrasal-verbs-v1-lesson-038","title":"Bài 38: Giao tiếp và quan hệ · fire–get","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (fire–get).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"fire away","prompt":"What do you want to know? _____ and I'll tell you.","choices":["fit in with","flag up","fire away","fish for"]},{"term":"fire off","prompt":"He _____ an email complaining about the report.","choices":["gang up on","fire off","get across to","get about"]},{"term":"fish for","prompt":"He's always _____ compliments.","choices":["flounce out","flounce off","flag up","fish for"]},{"term":"fit in with","prompt":"His rudeness yesterday _____ what I have always thought of his behaviour.","choices":["fit in with","fire off","fish for","flag up"]},{"term":"flag up","prompt":"We should _____ working conditions at the meeting.","choices":["gang up against","front out","gang up on","flag up"]},{"term":"flounce off","prompt":"He _____ when they laughed at him.","choices":["fish for","flounce off","fit in with","flag up"]},{"term":"flounce out","prompt":"He _____ when the press started criticising him.","choices":["front up","gang up","flounce out","front off"]},{"term":"fly about","prompt":"The rumour has been _____ for the past week, but no one has confirmed it.","choices":["front out","fly about","front off","freeze out"]},{"term":"fly around","prompt":"There are a lot of stories _____ about her past.","choices":["gang up against","get about","fly around","gang up on"]},{"term":"fly at","prompt":"He _____ them for not trying hard enough.","choices":["gang up against","gang up on","get about","fly at"]},{"term":"freeze out","prompt":"They tried to _____ of the conversation.","choices":["freeze out","fly around","fly about","fly at"]},{"term":"front off","prompt":"The two guys _____, but someone managed to calm them down before it got out of hand.","choices":["gang up on","gang up","gang up against","front off"]},{"term":"front out","prompt":"He had to _____ against the critics.","choices":["gang up","gang up against","front out","gang up on"]},{"term":"front up","prompt":"I hate these occasions, but I'll _____ for the first half.","choices":["fire off","front up","fish for","fit in with"]},{"term":"gang up","prompt":"They _____ to try to stop the new system.","choices":["front out","front off","gang up","get about"]},{"term":"gang up against","prompt":"They _____ me because I wouldn't accept their ideas.","choices":["front up","gang up against","get about","front out"]},{"term":"gang up on","prompt":"They _____ him because of the way he spoke.","choices":["get after","get across to","gang up on","get about"]},{"term":"get about","prompt":"It didn't take long for the news to _____- everyone's talking about it.","choices":["fish for","fire away","fire off","get about"]},{"term":"get across to","prompt":"How can I _____ my audience?","choices":["front off","fly at","freeze out","get across to"]},{"term":"get after","prompt":"You should _____ them to finish the work.","choices":["get after","fire off","fish for","fire away"]}]},{"id":"phrasal-verbs-v1-lesson-039","title":"Bài 39: Giao tiếp và quan hệ · get–go","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (get–go).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"get along with","prompt":"I don't _____ my sister- we have nothing in common.","choices":["give it to","get along with","gin up","give it up for"]},{"term":"get around","prompt":"He _____ a bit; he's always with some new girlfriend.","choices":["get around","go back on","go along with","gloss over"]},{"term":"get back at","prompt":"I'll _____ her for landing me in trouble.","choices":["gin up","give it up for","get back at","give it to"]},{"term":"get back together","prompt":"We split up a few months ago but _____ last week.","choices":["gin up","give it to","give it up for","get back together"]},{"term":"get down on","prompt":"My mother used to _____ us for not doing enough homework.","choices":["get down on","give it to","give it up for","gin up"]},{"term":"get in with","prompt":"I tried to _____ them as I thought it would help me at work.","choices":["give it to","give it up for","gin up","get in with"]},{"term":"get on at","prompt":"He's always _____ me when I haven't done anything wrong.","choices":["gin up","get on at","give it to","give it up for"]},{"term":"get onto","prompt":"We'd better _____ someone to fix this.","choices":["give it up for","get onto","give over","give it up to"]},{"term":"get through to","prompt":"I rang but couldn't _____ her.","choices":["go down with","gin up","give it up for","get through to"]},{"term":"get to","prompt":"We asked him to _____ the point, but he just waffled away.","choices":["give over","give it up for","get to","gin up"]},{"term":"get together","prompt":"We _____ in the pub for a drink.","choices":["gin up","give it up for","give it to","get together"]},{"term":"gin up","prompt":"The candidates tried to _____ support at the straw poll by transporting their supporters for free.","choices":["get together","give it to","gin up","give it up for"]},{"term":"give it to","prompt":"They really _____ me for forgetting to turn up.","choices":["get back at","get down on","get back together","give it to"]},{"term":"give it up for","prompt":"Please _____ our next guest.","choices":["get in with","get on at","get onto","give it up for"]},{"term":"give it up to","prompt":"Please _____ our next guest.","choices":["give it up to","gloss over","gin up","go along with"]},{"term":"give over","prompt":"They were making a lot of noise so I told them to _____.","choices":["gin up","give over","go along with","get together"]},{"term":"gloss over","prompt":"The Minister tried to _____ the report that was critical of her department.","choices":["get on at","get onto","gloss over","get in with"]},{"term":"go along with","prompt":"I will _____ your plan for today.","choices":["get down on","go along with","get back at","get back together"]},{"term":"go back on","prompt":"The government have _____ their promise not to raise taxes.","choices":["go back on","gin up","give it to","give it up for"]},{"term":"go down with","prompt":"Do you think the scheme will _____ the farmers in the area?","choices":["gin up","give it to","give it up for","go down with"]}]},{"id":"phrasal-verbs-v1-lesson-040","title":"Bài 40: Giao tiếp và quan hệ · go–hit","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (go–hit).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"go on about","prompt":"He's always _____ his kids.","choices":["hear out","hit it off","hit back","go on about"]},{"term":"go on at","prompt":"He _____ his parents until they bought him the game.","choices":["go on at","grow together","grow apart","grow away from"]},{"term":"go out to","prompt":"Our condolences _____ all the families who have lost people in this tragic accident.","choices":["have it out with","harp on","go out to","have on"]},{"term":"go out with","prompt":"He's been _____ his girlfriend for around six months now.","choices":["grow away from","go out with","grow together","grow apart"]},{"term":"grind on","prompt":"He was still _____ about football when we left.","choices":["hang with","grind on","grow together","grow away from"]},{"term":"grow apart","prompt":"We used to be good friends at school but have since _____.","choices":["hang on","hand on","grind on","grow apart"]},{"term":"grow away from","prompt":"I have _____ many of the people I grew up with.","choices":["grow away from","hit back","hear out","hit it off"]},{"term":"grow together","prompt":"We _____ while we were working on the same project.","choices":["hang up on","grow together","hand on","hang on"]},{"term":"hand on","prompt":"The secrets have been _____ from generation to generation.","choices":["grow away from","grow apart","grow together","hand on"]},{"term":"hang on","prompt":"Please _____ for a minute while I check.","choices":["hit back","hit it off","go on about","hang on"]},{"term":"hang up on","prompt":"A telesales person called, so I said something rude and _____ them.","choices":["grow away from","go out with","grow apart","hang up on"]},{"term":"hang with","prompt":"He has been _____ them for a few months.","choices":["grow away from","hang with","grind on","grow apart"]},{"term":"harp on","prompt":"I was late twice last week and my boss keeps _____ about it.","choices":["go out to","harp on","go on at","go out with"]},{"term":"have it out with","prompt":"I'd been worried for ages, so I decided to _____ them.","choices":["hit back","have it out with","hear from","hear out"]},{"term":"have on","prompt":"I _____ him because we used to work together.","choices":["have on","hear from","hear out","hear about"]},{"term":"hear about","prompt":"Have you _____ the company takeover?","choices":["harp on","hear about","have on","have it out with"]},{"term":"hear from","prompt":"I haven't _____ them since we left university.","choices":["hear from","go on about","hit it off","hit back"]},{"term":"hear out","prompt":"I _____ before I commented.","choices":["grow away from","grow apart","hear out","grow together"]},{"term":"hit back","prompt":"The president _____ at her critics in a speech last night.","choices":["hit back","go out with","go on at","go out to"]},{"term":"hit it off","prompt":"We _____ immediately and became firm friends.","choices":["hand on","hit it off","grow together","grow away from"]}]},{"id":"phrasal-verbs-v1-lesson-041","title":"Bài 41: Giao tiếp và quan hệ · hit–kick","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (hit–kick).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"hit it off with","prompt":"I _____ her immediately.","choices":["hold out on","hit it off with","hold forth","kick off"]},{"term":"hit on","prompt":"She _____ him at the party and they went back to her house.","choices":["hit on","hook into","hold with","hold forth"]},{"term":"hit out at","prompt":"The government _____ the media for their negativity.","choices":["hit out at","hook into","hook up","hold with"]},{"term":"hit upon","prompt":"He tried to _____ her at the pub.","choices":["hold with","hit upon","hold forth","hold out on"]},{"term":"hit with","prompt":"He _____ the details of their demands.","choices":["hold out on","hit with","kick off","hold forth"]},{"term":"hold forth","prompt":"The manager _____ on the topic for about twenty minutes.","choices":["hook up","jabber away","hold forth","hook into"]},{"term":"hold out on","prompt":"He's been _____ me for weeks and I really need the money.","choices":["hook up","jaw away","jabber away","hold out on"]},{"term":"hold with","prompt":"I don't _____ their plans.","choices":["jabber away","hook up","hook into","hold with"]},{"term":"hook into","prompt":"She _____ coming after all.","choices":["kick about","kick around","kick around with","hook into"]},{"term":"hook up","prompt":"We _____ at the conference.","choices":["jaw away","hook up","joke around","jump in"]},{"term":"jabber away","prompt":"They started _____ about file systems and lost me completely.","choices":["jabber away","joke around","jump on","jump in"]},{"term":"jaw away","prompt":"That shows that your interest is not in helping the student, but in _____.","choices":["hit out at","hit upon","hit on","jaw away"]},{"term":"joke around","prompt":"He's always _____ in class.","choices":["kick off","hit it off with","joke around","hit on"]},{"term":"jump in","prompt":"He _____ and told them exactly what he thought.","choices":["hook up","jump in","jabber away","hook into"]},{"term":"jump on","prompt":"Everyone _____ me when I raised the issue.","choices":["kick around with","kick off","jump on","hit it off with"]},{"term":"keep off","prompt":"Please _____ the topic during this meeting.","choices":["kick around","keep off","hit it off with","kick around with"]},{"term":"kick about","prompt":"We _____ at the meeting.","choices":["kick about","hit upon","hit out at","hit with"]},{"term":"kick around","prompt":"We _____.","choices":["kick around","hold out on","hold forth","hit with"]},{"term":"kick around with","prompt":"I used to _____ them, but haven't seen them for a while.","choices":["kick around with","hook up","hook into","jabber away"]},{"term":"kick off","prompt":"He started _____ big time when the police tried to arrest him.","choices":["hit on","hit out at","hit it off with","kick off"]}]},{"id":"phrasal-verbs-v1-lesson-042","title":"Bài 42: Giao tiếp và quan hệ · kiss–make","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (kiss–make).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"kiss off","prompt":"He _____ the criticism.","choices":["lead on","lay into","kiss off","leak out"]},{"term":"kiss up to","prompt":"He's a creep and is always _____ the director.","choices":["knock around","make peace with","kiss up to","make out"]},{"term":"knock around","prompt":"We _____ a bit, but decided not to bother.","choices":["lash out at","knock around","lash out against","lay into"]},{"term":"lash into","prompt":"He _____ them for messing thins up.","choices":["listen up","lash into","look down on","look up to"]},{"term":"lash out against","prompt":"The press has _____ the policy.","choices":["lash out against","make out","make peace with","kiss off"]},{"term":"lash out at","prompt":"He _____ me when I laughed at him.","choices":["lash out at","make out","kiss off","make peace with"]},{"term":"lay into","prompt":"His partner _____ him when he arrived two hours late.","choices":["lash out at","leak out","lay into","lead on"]},{"term":"lead on","prompt":"She _____ about her desire to get married.","choices":["leak out","lead on","let down","link up with"]},{"term":"leak out","prompt":"The company's plans to close the factory _____ and they were very embarrassed.","choices":["let on","link up with","let down","leak out"]},{"term":"lean on","prompt":"The government has denied _____ the Attorney General to get his approval of the war.","choices":["lean on","let down","listen up","link up with"]},{"term":"let down","prompt":"She failed to turn up and I felt badly _____.","choices":["link up with","listen up","look down on","let down"]},{"term":"let on","prompt":"I didn't mean to _____ about the party; I just said it without thinking.","choices":["make it up to","let on","look up to","lord it over"]},{"term":"link up with","prompt":"We _____ the firm over the web.","choices":["link up with","make out","kiss up to","kiss off"]},{"term":"listen up","prompt":"_____, men! Here are your new assignments.","choices":["lash out against","lash out at","listen up","lash into"]},{"term":"look down on","prompt":"You should not _____ people who struggle.","choices":["leak out","let down","link up with","look down on"]},{"term":"look up to","prompt":"She _____ her mother.","choices":["link up with","lord it over","look up to","listen up"]},{"term":"lord it over","prompt":"She loves to _____ her employees.","choices":["leak out","lean on","lead on","lord it over"]},{"term":"make it up to","prompt":"He tried to _____ her, but she wouldn't speak to him.","choices":["lay into","make it up to","lead on","leak out"]},{"term":"make out","prompt":"He's strange; I can't _____.","choices":["kiss up to","kiss off","make out","knock around"]},{"term":"make peace with","prompt":"After years of dispute, the two neighbors finally _____ each other.","choices":["make peace with","let on","look down on","listen up"]}]},{"id":"phrasal-verbs-v1-lesson-043","title":"Bài 43: Giao tiếp và quan hệ · make–pipe","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (make–pipe).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"make with","prompt":"_____ the money you owe me.","choices":["own up","pack in","nag at","make with"]},{"term":"mess about","prompt":"He is always _____ and never does what he promises.","choices":["naff off","mess about","make with","mouth off"]},{"term":"mess over","prompt":"They _____ when she applied for the job.","choices":["pack in","mess over","nag at","own up"]},{"term":"mouth off","prompt":"I always get angry and start _____ when the news is on TV.","choices":["mouth off","make with","pick up on","pipe down"]},{"term":"naff off","prompt":"He was making a fuss, so I told him to _____.","choices":["naff off","nag at","mess about","mess over"]},{"term":"nag at","prompt":"My boss is always _____ me about my arriving a few minutes late for work.","choices":["pass on to","nag at","pick on","pass on"]},{"term":"own up","prompt":"Nobody _____ to breaking the window.","choices":["own up","naff off","nag at","pack in"]},{"term":"pack in","prompt":"She _____.","choices":["pass on to","pack in","pick up on","pick on"]},{"term":"pack it in","prompt":"The kids were making a fuss, so I told them to _____.","choices":["pack it in","pass around","pass on","pass off"]},{"term":"pair off","prompt":"I tried to _____ with my sister.","choices":["pick on","pair off","pipe down","pick up on"]},{"term":"pair off with","prompt":"I _____ Trish for the test.","choices":["pick on","pig off","pick up on","pair off with"]},{"term":"pal about","prompt":"We used to _____ when we were at school.","choices":["pal about","pipe down","make with","mess over"]},{"term":"pass around","prompt":"Please _____ the snacks to everyone in class.","choices":["pick up on","pick on","pass around","pig off"]},{"term":"pass off","prompt":"The demonstration _____ peacefully.","choices":["pack in","nag at","pass off","own up"]},{"term":"pass on","prompt":"I'll _____ when she gets here.","choices":["mouth off","mess over","pass on","mess about"]},{"term":"pass on to","prompt":"Let's _____ the next item on the agenda.","choices":["pick on","pair off with","pal about","pass on to"]},{"term":"pick on","prompt":"My friends always _____ me because I don't sing well.","choices":["nag at","pick on","own up","pack in"]},{"term":"pick up on","prompt":"I'd like to _____ the point that Jill made.","choices":["pass around","pal about","pick up on","pair off with"]},{"term":"pig off","prompt":"He told them to _____ and leave him in peace.","choices":["nag at","own up","mess over","pig off"]},{"term":"pipe down","prompt":"The lecturer asked the students to _____ and pay attention.","choices":["mouth off","pipe down","naff off","nag at"]}]},{"id":"phrasal-verbs-v1-lesson-044","title":"Bài 44: Giao tiếp và quan hệ · pipe–rake","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (pipe–rake).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"pipe up","prompt":"At first, no one answered, then finally someone _____.","choices":["pop off","pipe up","pour forth","poop out on"]},{"term":"pitch into","prompt":"The shareholders _____ the management about their pay rises at the meeting.","choices":["put over","quarrel out","pitch into","quarrel with"]},{"term":"play along","prompt":"I disagreed with the idea but I had to _____ because everyone else liked it.","choices":["play along","rake up","pipe up","rake over"]},{"term":"play around","prompt":"I _____ a lot at college.","choices":["poop out on","play around","pitch into","pipe up"]},{"term":"play down","prompt":"The Government has tried to _____ the importance of the minister's resignation.","choices":["pop off","play down","poop out on","pitch into"]},{"term":"play off","prompt":"He _____ against each other to get the best deal.","choices":["quarrel out","play off","quit on","quarrel with"]},{"term":"poop out on","prompt":"We were supposed to meet yesterday, but she _____ me at the last minute.","choices":["poop out on","quarrel out","put over","put across"]},{"term":"pop off","prompt":"He's always _____ when things don't suit him.","choices":["prattle on","pop off","press upon","pull for"]},{"term":"pour forth","prompt":"Useless statistics _____ from him.","choices":["rake over","quit on","rack off","pour forth"]},{"term":"prattle on","prompt":"Geoff just _____ instead of giving a straight answer.","choices":["rack off","quarrel out","quarrel with","prattle on"]},{"term":"press upon","prompt":"The invitations were _____ us and it was hard to say no.","choices":["rack off","rake over","press upon","quit on"]},{"term":"pull for","prompt":"Who will you be _____ in the final?","choices":["pull for","pitch into","play along","play around"]},{"term":"put across","prompt":"He found it difficult to _____ what he wanted to say at the meeting.","choices":["pitch into","rake up","pipe up","put across"]},{"term":"put over","prompt":"They _____ a clever practical joke on us.","choices":["pipe up","pitch into","put over","play along"]},{"term":"quarrel out","prompt":"The girl's mother was _____ with her daughter about the party.","choices":["quarrel out","pop off","prattle on","pour forth"]},{"term":"quarrel with","prompt":"I do not want to _____ your decision.","choices":["put over","quit on","rack off","quarrel with"]},{"term":"quit on","prompt":"They _____ me just when things got rough.","choices":["quit on","rake up","pitch into","pipe up"]},{"term":"rack off","prompt":"He told her to _____.","choices":["rack off","pipe up","pitch into","rake up"]},{"term":"rake over","prompt":"They keep _____ the rows we had last year.","choices":["rake over","quarrel out","quit on","quarrel with"]},{"term":"rake up","prompt":"The press have _____ some scandals from her past.","choices":["play along","rake up","pitch into","rack off"]}]},{"id":"phrasal-verbs-v1-lesson-045","title":"Bài 45: Giao tiếp và quan hệ · ramble–sail","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (ramble–sail).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"ramble on","prompt":"Quit _____- I’m tired of listening to you.","choices":["ring back","ramble on","ring off","ring in"]},{"term":"rat on","prompt":"He always _____ his promises.","choices":["ring off","ring out","rat on","ring in"]},{"term":"rattle off","prompt":"She _____ loads of statistics which nobody could understand.","choices":["read out","ring back","rattle off","ring in"]},{"term":"reach out","prompt":"I _____ and caught the ball.","choices":["reach out","ring back","reel off","read off"]},{"term":"reach out to","prompt":"The candidates are _____ the poor to get their votes.","choices":["rattle off","read out","read off","reach out to"]},{"term":"read off","prompt":"I _____ the figures and she wrote them down in her notebook.","choices":["ring back","reach out to","ring in","read off"]},{"term":"read out","prompt":"The teacher _____ the names of the students who'd passed.","choices":["rattle off","reach out to","read out","reel off"]},{"term":"reel off","prompt":"They _____ five victories and became the champions.","choices":["ring in","ring out","row back","reel off"]},{"term":"ring back","prompt":"I phoned and left a message this morning but she still hasn't _____.","choices":["rat on","ring back","rattle off","reach out"]},{"term":"ring in","prompt":"I _____ and told them I would be late.","choices":["read off","reel off","ring in","read out"]},{"term":"ring off","prompt":"Dave _____ guiltily when he saw his boss coming.","choices":["run with","ring off","sail into","ramble on"]},{"term":"ring out","prompt":"Two shots _____ and then we heard a scream.","choices":["read off","ring out","row back","reel off"]},{"term":"row back","prompt":"The prime minister refused to _____ and lost the vote.","choices":["rub along","run after","rub off on","row back"]},{"term":"rub along","prompt":"They're not friends, but we _____.","choices":["rub along","reach out to","reach out","read off"]},{"term":"rub off on","prompt":"His enthusiasm _____ everyone around him.","choices":["rattle off","reach out","rub off on","reach out to"]},{"term":"run after","prompt":"He was _____ her for ages never managed to get a date.","choices":["ring off","ring back","ring in","run after"]},{"term":"run along","prompt":"They kept disturbing him, so he told them to _____ and leave him in peace.","choices":["ramble on","sail into","run along","rub off on"]},{"term":"run with","prompt":"She _____ some dodgy characters.","choices":["rat on","rattle off","reach out","run with"]},{"term":"sail into","prompt":"He _____ me for turning up an hour late.","choices":["run with","sail into","ramble on","run along"]}]},{"id":"phrasal-verbs-v1-lesson-046","title":"Bài 46: Giao tiếp và quan hệ · see–spell","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (see–spell).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"see out","prompt":"Are you sure you're going? I'll get your coats and _____.","choices":["sidle up to","sing up","side with","see out"]},{"term":"send for","prompt":"I had to _____ a plumber because the radiator was leaking.","choices":["send for","speak out","sound out","sound off"]},{"term":"send out","prompt":"They _____ a mailshot to all their existing customers.","choices":["send out","set forth","shout down","sex up"]},{"term":"send up","prompt":"The mischievous schoolboy was standing at the front of the class, _____, when the teacher opened the door behind him.","choices":["sound off","snitch on","sing out","send up"]},{"term":"set forth","prompt":"He _____ his ideas in his autobiography.","choices":["shout down","sex up","shout out","set forth"]},{"term":"sex up","prompt":"They tried to _____ the news with extra details.","choices":["sex up","speak out","sound off","sound out"]},{"term":"shout down","prompt":"His efforts to raise the issue were _____.","choices":["shout down","side with","sex up","show out"]},{"term":"shout out","prompt":"She _____ my name.","choices":["shout out","sidle up to","sing up","side with"]},{"term":"show out","prompt":"Her secretary _____ after the interview.","choices":["side with","sing up","show out","sidle up to"]},{"term":"side with","prompt":"The lecturer _____ her students and got sacked for her pains.","choices":["soften up","snitch on","side with","sound off"]},{"term":"sidle up to","prompt":"He _____ me and whispered his name.","choices":["shout out","sex up","sidle up to","shout down"]},{"term":"sing out","prompt":"When you hear your name, _____!","choices":["snitch on","sing out","side with","sidle up to"]},{"term":"sing up","prompt":"We can't hear you- _____.","choices":["show out","sing up","shout out","shout down"]},{"term":"snitch on","prompt":"Reggie was caught after someone _____ him to the teacher.","choices":["side with","sidle up to","sing out","snitch on"]},{"term":"soften up","prompt":"I paid for everything to _____ before they made the decision.","choices":["soften up","set forth","shout down","send out"]},{"term":"sound off","prompt":"He _____ about the quality of the food.","choices":["speak out","spell out","sound off","see out"]},{"term":"sound out","prompt":"You should _____ to get her opinion before you go ahead with the plan.","choices":["sex up","send up","sound out","set forth"]},{"term":"speak out","prompt":"People are afraid to _____ in oppressive political regimes.","choices":["sound off","soften up","snitch on","speak out"]},{"term":"spell out","prompt":"I had to _____ to him as he didn't know how to spell it.","choices":["spell out","sidle up to","sing up","snitch on"]}]},{"id":"phrasal-verbs-v1-lesson-047","title":"Bài 47: Giao tiếp và quan hệ · spit–take","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (spit–take).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"spit it out","prompt":"Hurry up, _____! I can't wait all day for the truth.","choices":["spit it out","string along","stick up for","strike up"]},{"term":"split up","prompt":"They are always _____ and then getting back together again.","choices":["split up","tail away","swear by","suck up to"]},{"term":"stand for","prompt":"I'm not going to _____ their rudeness any longer.","choices":["stick together","stick by","storm out","stand for"]},{"term":"stand up to","prompt":"She _____ the police when they tried to corrupt her.","choices":["stick by","stick up for","stand up to","stick together"]},{"term":"stare down","prompt":"He was angry but I _____ and he left without saying much.","choices":["suck up","strike up","string along","stare down"]},{"term":"start on at","prompt":"He _____ me for being late.","choices":["stand for","start on at","stare down","stand up to"]},{"term":"step to","prompt":"He tried to _____ her in the bar.","choices":["strike up","step to","stick up for","storm out"]},{"term":"stick by","prompt":"They are _____ their claims.","choices":["strike up","string along","storm out","stick by"]},{"term":"stick together","prompt":"If we don't _____, things will be much worse for all of us- we need some unity.","choices":["step to","storm out","stick together","strike up"]},{"term":"stick up for","prompt":"You have to _____ yourself here, because no one will back you.","choices":["stick up for","stare down","step to","start on at"]},{"term":"storm out","prompt":"She was so angry that she decided to _____.","choices":["tail off","take aside","tail away","storm out"]},{"term":"strike up","prompt":"He _____ a conversation with me in the bar.","choices":["tail off","strike up","spit it out","take aside"]},{"term":"string along","prompt":"Is it alright if I _____ with you tonight?","choices":["stick up for","stick together","string along","stick by"]},{"term":"suck up","prompt":"He is always _____ to try to get the boss's approval.","choices":["tail off","suck up","tail away","swear by"]},{"term":"suck up to","prompt":"He's always _____ our boss.","choices":["stand for","stare down","suck up to","split up"]},{"term":"swear by","prompt":"I _____ their products- they're the best on the market.","choices":["swear by","storm out","stick together","stick up for"]},{"term":"tail away","prompt":"His voice _____ when he was speaking about what he'd done wrong.","choices":["stick together","stick by","tail away","step to"]},{"term":"tail off","prompt":"The voices _____ when she entered.","choices":["tail off","storm out","string along","strike up"]},{"term":"take aside","prompt":"The teacher _____ and said that she'd failed the exam.","choices":["take aside","spit it out","tail off","tail away"]}]},{"id":"phrasal-verbs-v1-lesson-048","title":"Bài 48: Giao tiếp và quan hệ · take–touch","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (take–touch).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"take back","prompt":"I had to _____ everything bad I'd said about them when I learned how they'd helped out.","choices":["talk around","talk down","talk at","take back"]},{"term":"take for","prompt":"What do you _____? I would never betray my friends.","choices":["toss about","tone down","throw over","take for"]},{"term":"talk around","prompt":"They _____ the issue without reaching a conclusion.","choices":["take for","tee off on","take back","talk around"]},{"term":"talk at","prompt":"There's no point trying to convince them- they'll just _____ you until you give up.","choices":["touch on","take back","talk at","toss around"]},{"term":"talk back","prompt":"The teacher was cross because the pupil _____ to her.","choices":["tell off","text out","talk back","tell on"]},{"term":"talk down","prompt":"The police tried to _____ the man.","choices":["toss about","text out","talk down","throw over"]},{"term":"talk down to","prompt":"She's a dreadful teacher and _____ her students instead of teaching them.","choices":["toss about","tone down","talk down to","throw over"]},{"term":"talk into","prompt":"She didn't want to let me go, but I finally managed to _____ it.","choices":["talk into","tell on","text out","throw over"]},{"term":"talk out","prompt":"They had a meeting to _____ how people felt.","choices":["tell on","talk out","tee off on","tell off"]},{"term":"talk up","prompt":"The government are trying to _____ the effect of their policies.","choices":["tell on","tell off","talk up","tee off on"]},{"term":"tee off on","prompt":"She _____ me about the work I gave her.","choices":["talk at","talk back","tee off on","talk down"]},{"term":"tell off","prompt":"His fiancée _____ for arriving nearly an hour late.","choices":["text out","throw over","tell off","tone down"]},{"term":"tell on","prompt":"The pupil _____ the others for cheating and the teacher failed them.","choices":["talk around","take back","tell on","take for"]},{"term":"text out","prompt":"I was feeling too tired to go and _____.","choices":["tone down","tell on","throw over","text out"]},{"term":"throw over","prompt":"She _____ last year.","choices":["touch on","toss about","throw over","toss around"]},{"term":"tone down","prompt":"The Minister tried to _____ what she had said when the press started attacking her.","choices":["talk into","talk down to","talk out","tone down"]},{"term":"toss about","prompt":"We _____ before the negotiations.","choices":["tell off","text out","toss about","tell on"]},{"term":"toss around","prompt":"We _____ a bit and then rejected it.","choices":["take for","touch on","take back","toss around"]},{"term":"touch on","prompt":"The talk _____ the issue, but didn't give any new information.","choices":["tell off","text out","talk up","touch on"]}]},{"id":"phrasal-verbs-v1-lesson-049","title":"Bài 49: Giao tiếp và quan hệ · touch–zip","focus":"Trao đổi thông tin, giữ liên lạc và ứng xử. Các cụm được xếp theo động từ gốc (touch–zip).","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","questions":[{"term":"touch upon","prompt":"They didn't _____ the subject because of the controversy.","choices":["wave off","wave aside","weigh in","touch upon"]},{"term":"try back","prompt":"I called but they weren't in, so I'll _____ later.","choices":["wave aside","try back","want out","walk back from"]},{"term":"tune out","prompt":"I _____ because he was talking such rubbish.","choices":["touch upon","zip up","try back","tune out"]},{"term":"turn to","prompt":"She had nobody to _____ when her husband died.","choices":["write in","yack on","yammer on","turn to"]},{"term":"urge on","prompt":"They _____ the company.","choices":["try back","urge on","touch upon","zip up"]},{"term":"urge upon","prompt":"They _____ us.","choices":["tune out","try back","urge upon","turn to"]},{"term":"walk back from","prompt":"They declined to _____ their comments despite the controversy.","choices":["walk back from","wheel out","weigh in on","whip up"]},{"term":"want out","prompt":"Jackie wasn't happy with her marriage and _____.","choices":["wave off","want out","wave aside","weigh in"]},{"term":"wave aside","prompt":"They _____ our objections and carried on with the plan.","choices":["touch upon","try back","zip up","wave aside"]},{"term":"wave off","prompt":"We _____ at the station.","choices":["wheel out","weigh in on","whip up","wave off"]},{"term":"weigh in","prompt":"He disliked the plan and _____ with some heavy criticism.","choices":["urge upon","weigh in","walk back from","want out"]},{"term":"weigh in on","prompt":"She _____ their immigration policies.","choices":["whip up","write in","weigh in on","word up"]},{"term":"wheel out","prompt":"They _____ the same old excuses last time this happened.","choices":["walk back from","wheel out","urge upon","urge on"]},{"term":"whip up","prompt":"The boss tried to _____ some support for her new policies.","choices":["whip up","yammer on","write in","yack on"]},{"term":"word up","prompt":"The solicitor _____ client before the police interview, so they go very little out of him.","choices":["want out","walk back from","word up","wave aside"]},{"term":"write in","prompt":"They asked viewers to _____ with their opinions and suggestions.","choices":["wheel out","write in","weigh in on","whip up"]},{"term":"yack on","prompt":"He _____ for an hour.","choices":["whip up","write in","yack on","word up"]},{"term":"yammer on","prompt":"She _____ for ages.","choices":["wave aside","yammer on","wave off","want out"]},{"term":"zip up","prompt":"He was being stupid in the meeting, so we told him to _____.","choices":["zip up","wave off","weigh in","wave aside"]}]},{"id":"phrasal-verbs-v1-lesson-050","title":"Bài 50: Di chuyển và du lịch · back–break","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (back–break).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"back away","prompt":"The crowd _____ when the man pulled a knife.","choices":["box in","back away","border on","box up"]},{"term":"back into","prompt":"He prefers to _____ the garage.","choices":["be along","be out","beat down","back into"]},{"term":"barge into","prompt":"They _____ my office without knocking and started talking even though I was on the phone.","choices":["border on","barge into","box in","box up"]},{"term":"be along","prompt":"The next bus should _____ in the next quarter of an hour or so.","choices":["beat down","barge into","be along","back into"]},{"term":"be out","prompt":"She _____ on a visit for the day.","choices":["bend down","be out","bend over","beat down"]},{"term":"beat down","prompt":"The sun was really _____ and we couldn't stay outdoors.","choices":["be along","be out","bend over","beat down"]},{"term":"bend down","prompt":"I _____ to pick it up off the floor.","choices":["barge into","bend down","be out","be along"]},{"term":"bend over","prompt":"I _____ to do my shoes up.","choices":["be out","beat down","blast off","bend over"]},{"term":"blast off","prompt":"The space shuttle _____ on schedule yesterday.","choices":["be out","beat down","blast off","bend down"]},{"term":"block off","prompt":"The police _____ the road after the murder.","choices":["blow in","blow down","block off","bend over"]},{"term":"blow down","prompt":"A tree was _____ in the storm.","choices":["book out","book into","book in","blow down"]},{"term":"blow in","prompt":"He _____ from Toronto early this morning.","choices":["book out","book up","blow in","book into"]},{"term":"book in","prompt":"We took a taxi from the airport to the hotel and _____.","choices":["block off","blast off","bend over","book in"]},{"term":"book into","prompt":"We _____ the first hotel we could find.","choices":["be along","beat down","be out","book into"]},{"term":"book out","prompt":"I don't like the look of the people arriving- let's _____.","choices":["box in","box up","book out","border on"]},{"term":"book up","prompt":"The flight's fully _____; I'll have to go the following day.","choices":["barge into","book up","back into","be along"]},{"term":"border on","prompt":"Does Portugal _____ the country of Spain?","choices":["blow down","block off","border on","blast off"]},{"term":"box in","prompt":"I was _____ by the bus and couldn't change lane.","choices":["back away","back into","box in","break away"]},{"term":"box up","prompt":"At the end of term, I _____ and sent them home.","choices":["blast off","bend over","box up","block off"]},{"term":"break away","prompt":"The sdp _____ from the Labour Party.","choices":["border on","book out","break away","book up"]}]},{"id":"phrasal-verbs-v1-lesson-051","title":"Bài 51: Di chuyển và du lịch · break–clear","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (break–clear).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"break in","prompt":"I must watch my speed until I _____ my new Volvo.","choices":["break in","cast off","cast up","catch at"]},{"term":"breeze along","prompt":"The film _____ for the first hour, then becomes rather dull and slow.","choices":["buzz around","bundle out","burst into","breeze along"]},{"term":"breeze in","prompt":"He _____ and started shouting at us.","choices":["breeze in","clear away","check into","catch at"]},{"term":"breeze into","prompt":"He _____ the room and switched the TV on.","choices":["cast up","catch at","breeze into","clear away"]},{"term":"bring along","prompt":"You can _____ if you like.","choices":["breeze in","bring along","budge up","breeze into"]},{"term":"budge up","prompt":"We had to _____ to let the fourth person in the back of the car.","choices":["breeze in","breeze along","budge up","breeze into"]},{"term":"bundle off","prompt":"He _____ to bed.","choices":["bundle off","breeze in","break in","breeze along"]},{"term":"bundle out","prompt":"The barman _____ because he was annoying the other customers.","choices":["check into","catch at","bundle out","clear away"]},{"term":"burst into","prompt":"The dry wood will _____ flames quickly.","choices":["buzz off","burst into","buzz around","call around"]},{"term":"buzz around","prompt":"Reporters were _____ the scene of the accident.","choices":["carve up","call for","cart off","buzz around"]},{"term":"buzz off","prompt":"I'm _____ now- I have to meet some people.","choices":["burst into","bundle out","buzz off","budge up"]},{"term":"call around","prompt":"I _____ but she wasn't in.","choices":["bundle out","bundle off","call around","burst into"]},{"term":"call for","prompt":"I'll _____ a cab right away.","choices":["burst into","bundle off","bundle out","call for"]},{"term":"cart off","prompt":"The thieves _____ all the ticket receipts.","choices":["cart off","carve up","cast up","catch at"]},{"term":"carve up","prompt":"The idiot _____ and forced me to brake hard.","choices":["check into","clear away","catch at","carve up"]},{"term":"cast off","prompt":"They _____ and headed out to sea.","choices":["buzz around","bundle out","cast off","burst into"]},{"term":"cast up","prompt":"The rubbish was _____ by the tide.","choices":["check into","catch at","clear away","cast up"]},{"term":"catch at","prompt":"She _____ my sleeve as I was leaving and said she needed to talk to me.","choices":["call around","buzz off","catch at","buzz around"]},{"term":"check into","prompt":"They _____ the Ritz yesterday.","choices":["break in","breeze along","check into","clear away"]},{"term":"clear away","prompt":"We were told to _____ from the scene of the accident.","choices":["bring along","bundle off","budge up","clear away"]}]},{"id":"phrasal-verbs-v1-lesson-052","title":"Bài 52: Di chuyển và du lịch · clear–drive","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (clear–drive).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"clear off","prompt":"As soon as the trouble started, we _____.","choices":["close in","drive back","cling on","clear off"]},{"term":"cling on","prompt":"He told me to _____ as the motorbike accelerated.","choices":["draw back","drive away","cling on","draw in"]},{"term":"close in","prompt":"The police were _____ so they decided to try to make a break.","choices":["come down","close in","come from","come along"]},{"term":"close in on","prompt":"The police were _____ the gang.","choices":["cut up","double back","dig in","close in on"]},{"term":"close in upon","prompt":"The police were _____ the gang.","choices":["drive back","clear off","drive away","close in upon"]},{"term":"close off","prompt":"The police _____ after the explosion.","choices":["come from","come along","close off","come down"]},{"term":"close on","prompt":"She is _____ the leader of the race.","choices":["come down","close on","come from","come along"]},{"term":"come along","prompt":"_____, we’ll never get there if you don’t keep up with us.","choices":["close off","close in upon","close on","come along"]},{"term":"come down","prompt":"When you're next in London, _____ and see us.","choices":["close in on","close in upon","close off","come down"]},{"term":"come from","prompt":"She _____ Somalia.","choices":["close in upon","come from","close in on","close off"]},{"term":"come up","prompt":"The sun _____ just as we reached the outskirts of the town.","choices":["close in upon","close in on","come up","close in"]},{"term":"creep up on","prompt":"They _____ their rivals and overtook them.","choices":["come from","creep up on","come up","come down"]},{"term":"cut up","prompt":"A fast car tried to _____ in front of me.","choices":["cut up","close off","close in upon","close on"]},{"term":"dig in","prompt":"Anticipating an artillery barrage, we quickly _____.","choices":["come down","close on","dig in","come along"]},{"term":"double back","prompt":"When he saw the police, he _____ and went home.","choices":["come along","come down","come from","double back"]},{"term":"draw back","prompt":"He _____ when the dog barked.","choices":["come down","draw back","close on","come along"]},{"term":"draw in","prompt":"The train _____ and we got off.","choices":["drive away","clear off","drive back","draw in"]},{"term":"draw on","prompt":"As the lesson _____, the students started to get bored.","choices":["draw on","close in upon","close off","come along"]},{"term":"drive away","prompt":"Their unfriendliness _____.","choices":["close in on","drive away","close off","close in upon"]},{"term":"drive back","prompt":"The police _____ to give the rescue workers more space.","choices":["creep up on","come up","cut up","drive back"]}]},{"id":"phrasal-verbs-v1-lesson-053","title":"Bài 53: Di chuyển và du lịch · drive–give","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (drive–give).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"drive out","prompt":"The soldiers _____ of their homes.","choices":["fall in","fall over","fall down","drive out"]},{"term":"drop away","prompt":"The numbers of people attending began the _____ after a few months.","choices":["filter in","fall over","fall in","drop away"]},{"term":"drop over","prompt":"I'll _____ on my way back.","choices":["drop over","filter in","finish up","fall in"]},{"term":"edge up","prompt":"She _____ behind the bus at the red light.","choices":["fall in","edge up","fall back","fall down"]},{"term":"fall back","prompt":"The army _____ after losing the battle.","choices":["fall back","drive out","give onto","ghost away"]},{"term":"fall down","prompt":"I slipped on the ice and _____.","choices":["give onto","fall down","ghost away","drive out"]},{"term":"fall in","prompt":"The ceiling _____ hurting a lot of people.","choices":["fall in","front onto","freeze over","finish up"]},{"term":"fall over","prompt":"I slipped on the ice and _____.","choices":["get across","fall over","gad around","get on for"]},{"term":"filter in","prompt":"The slip lane allows traffic to _____ at the junction.","choices":["fall back","drop over","edge up","filter in"]},{"term":"finish up","prompt":"We went out for diner and _____ in a club.","choices":["get across","gad about","finish up","gad around"]},{"term":"freeze over","prompt":"The winter was very severe and the lake _____.","choices":["get on for","freeze over","ghost away","give onto"]},{"term":"front onto","prompt":"My house _____ the main square.","choices":["front onto","fall down","fall over","fall in"]},{"term":"fuel up","prompt":"We stopped to _____ before the car ran out.","choices":["fall over","filter in","fall in","fuel up"]},{"term":"gad about","prompt":"I spent the afternoon _____ in the West End.","choices":["give onto","ghost away","gad about","drive out"]},{"term":"gad around","prompt":"I spent the afternoon _____ looking for some books.","choices":["fuel up","freeze over","gad around","front onto"]},{"term":"get across","prompt":"How are we going to _____ the river?","choices":["give onto","get across","drive out","ghost away"]},{"term":"get on for","prompt":"It's _____ midnight.","choices":["get on for","fall down","fall in","fall back"]},{"term":"ghost away","prompt":"They _____ to a secret location before he could be arrested.","choices":["drop over","fall back","edge up","ghost away"]},{"term":"give onto","prompt":"The French windows _____ the lawn.","choices":["get across","get on for","ghost away","give onto"]}]},{"id":"phrasal-verbs-v1-lesson-054","title":"Bài 54: Di chuyển và du lịch · give–hoon","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (give–hoon).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"give way to","prompt":"Cottage industries _____ the big companies.","choices":["go across","give way to","hoon around","go away"]},{"term":"go across","prompt":"He _____ to the opposition.","choices":["go across","hoon around","give way to","hole up"]},{"term":"go away","prompt":"This drug should make the pain _____.","choices":["give way to","go away","hoon around","hang about"]},{"term":"go forth","prompt":"They _____ to spread the word of the new religion.","choices":["hang back","go forth","hang about","hang around"]},{"term":"go on to","prompt":"We had dinner and _____ a few bars.","choices":["hole up","hide out","go on to","hold out"]},{"term":"go past","prompt":"She _____ me without saying hello.","choices":["hang back","hang about","hang around","go past"]},{"term":"go up","prompt":"We _____ and asked them for some information about the courses.","choices":["hide out","hold out","hoon around","go up"]},{"term":"hang about","prompt":"They _____ the station most of the day.","choices":["hide out","head out","hide away","hang about"]},{"term":"hang around","prompt":"They _____ the station most of the day.","choices":["go forth","go away","go on to","hang around"]},{"term":"hang back","prompt":"When they raced towards the entrance, I _____ till it was less crowded.","choices":["go up","head for","head off","hang back"]},{"term":"hang back from","prompt":"They were _____ making the final decision.","choices":["hang back from","head for","head off","head out"]},{"term":"head for","prompt":"It's getting late- I'm _____ home.","choices":["hang back","hang around","hang back from","head for"]},{"term":"head off","prompt":"The sheriff and his men _____ at the pass.","choices":["hole up","give way to","hoon around","head off"]},{"term":"head out","prompt":"We're _____ at seven, so don't be late.","choices":["go forth","go away","go on to","head out"]},{"term":"hide away","prompt":"I'm renting a cottage where I can _____ for the summer.","choices":["go on to","go across","go forth","hide away"]},{"term":"hide out","prompt":"The police think he's _____ in the woods.","choices":["hang back from","hang around","hide out","hang back"]},{"term":"hold out","prompt":"I _____ my hand when she walked in.","choices":["hang back from","hang back","hang around","hold out"]},{"term":"hole up","prompt":"They _____ in a remote cottage while the police were searching for them.","choices":["hide out","hole up","hold out","hoon around"]},{"term":"hoon around","prompt":"He was _____ in his new car last night and the police pulled him.","choices":["go away","give way to","go across","hoon around"]}]},{"id":"phrasal-verbs-v1-lesson-055","title":"Bài 55: Di chuyển và du lịch · hover–pass","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (hover–pass).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"hover around","prompt":"She was _____ to see what we were talking about.","choices":["move along","move away","hover around","nip off"]},{"term":"hurry up","prompt":"_____, or we will miss the beginning of the movie!","choices":["hurry up","land up in","level out","level off"]},{"term":"issue forth","prompt":"New initiatives _____ from the government on a daily basis.","choices":["make way for","mill around","make off","issue forth"]},{"term":"jack up","prompt":"We _____ and changed the tyre.","choices":["move along","nip off","jack up","move away"]},{"term":"keep to","prompt":"Please _____ the path.","choices":["land up in","level out","level off","keep to"]},{"term":"land up in","prompt":"We set out for Manchester, but _____ Liverpool.","choices":["land up in","make after","level out","lift off"]},{"term":"level off","prompt":"The pilot _____ at 5,000 meters.","choices":["jack up","keep to","level off","land up in"]},{"term":"level out","prompt":"The pilot _____ at 5,000 meters.","choices":["issue forth","hover around","level out","hurry up"]},{"term":"lift off","prompt":"We watched the rocket _____ into space today.","choices":["make after","mill around","lift off","make way for"]},{"term":"make after","prompt":"The police _____ the stolen car.","choices":["jack up","make after","issue forth","keep to"]},{"term":"make off","prompt":"They _____ when they heard the police siren.","choices":["move along","mill around","make off","move away"]},{"term":"make way for","prompt":"The old houses were demolished to _____ a modern public park.","choices":["mill around","move along","make way for","moggy off"]},{"term":"mill around","prompt":"There were a lot of people _____ waiting for the bus.","choices":["mill around","keep to","level off","land up in"]},{"term":"moggy off","prompt":"The cat _____ into the dark garden quickly.","choices":["level out","make after","land up in","moggy off"]},{"term":"move along","prompt":"The police told the people watching to _____.","choices":["keep to","land up in","jack up","move along"]},{"term":"move away","prompt":"I _____ when the factory shut down.","choices":["move away","hover around","hurry up","pass by"]},{"term":"nip off","prompt":"I'm _____ to get some milk.","choices":["make way for","mill around","nip off","move along"]},{"term":"pack off","prompt":"His boss _____ to a regional office.","choices":["move along","pass by","pack off","move away"]},{"term":"pass by","prompt":"I was just _____ when I saw the accident.","choices":["pass by","issue forth","hover around","hurry up"]}]},{"id":"phrasal-verbs-v1-lesson-056","title":"Bài 56: Di chuyển và du lịch · pass–roll","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (pass–roll).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"pass through","prompt":"I didn't see much as I was only _____ the town.","choices":["ride off","race off","pull out","pass through"]},{"term":"peel away","prompt":"Some of the crowd _____ to get out of the crush.","choices":["peel away","roll in","pile in","pass through"]},{"term":"peel away from","prompt":"They _____ the crowd and went down a side road.","choices":["pass through","pile in","peel away from","pile into"]},{"term":"peel off","prompt":"When the police blocked the road, a few protesters _____ and left the march.","choices":["pass through","roll in","peel off","pile in"]},{"term":"peel off from","prompt":"They _____ the demonstration when the police arrived.","choices":["pile into","pile out","peel off from","pile in"]},{"term":"peel out","prompt":"Fearing the police, he _____ in a cloud of tire smoke.","choices":["pile in","peel out","pile into","plough into"]},{"term":"pile in","prompt":"The coach stopped and we all _____.","choices":["peel out","plough through","pile in","plough into"]},{"term":"pile into","prompt":"We _____ the shop when it opened.","choices":["pull away","pootle along","pile into","pop out"]},{"term":"pile out","prompt":"The train eventually arrived and we all _____.","choices":["plough into","plough through","plow into","pile out"]},{"term":"plough into","prompt":"The bus skidded and _____ the bus stop.","choices":["plough into","peel off from","peel out","peel off"]},{"term":"plough through","prompt":"The boat had to _____ the ice.","choices":["pile in","pile out","plough through","pile into"]},{"term":"plow into","prompt":"The bus skidded and _____ the bus stop.","choices":["pop out","plough through","plow into","pootle along"]},{"term":"pootle along","prompt":"We were _____ at thirty miles an hour.","choices":["peel out","pile into","pile in","pootle along"]},{"term":"pop out","prompt":"I'm just _____ to the shops. Do you need anything while I'm out?","choices":["pop out","pull away","pootle along","race off"]},{"term":"pull away","prompt":"The car _____ from the traffic lights at high speed.","choices":["plough through","plough into","pull away","plow into"]},{"term":"pull out","prompt":"The traffic was so bad that it took me ages to _____.","choices":["peel off from","pull out","pile in","pile into"]},{"term":"race off","prompt":"They _____ when the police arrived.","choices":["pass through","race off","pull out","roll in"]},{"term":"ride off","prompt":"She got on her motorbike and _____.","choices":["pile in","peel out","ride off","peel off from"]},{"term":"roll in","prompt":"The tanks _____ and took control of the capital city.","choices":["plow into","pootle along","plough through","roll in"]}]},{"id":"phrasal-verbs-v1-lesson-057","title":"Bài 57: Di chuyển và du lịch · run–slow","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (run–slow).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"run in","prompt":"She _____ for a thousand miles.","choices":["set out","run in","ship out","ship off"]},{"term":"rush away","prompt":"They _____ when the police arrived.","choices":["sally out","rush away","see into","scout out"]},{"term":"rush off","prompt":"Zac _____ to get to his medical appointment.","choices":["ship out","see into","rush off","set out"]},{"term":"saddle up","prompt":"She _____ the horse and rode off.","choices":["scout out","saddle up","see into","see off"]},{"term":"sally forth","prompt":"The townspeople _____ to fight the invading army.","choices":["show over","show around","slow up","sally forth"]},{"term":"sally out","prompt":"Though it was pouring with rain, we _____ to meet her.","choices":["slow up","show over","sally out","run in"]},{"term":"scout out","prompt":"The researcher spent months _____ the answer.","choices":["slow up","scout out","show around","show over"]},{"term":"see into","prompt":"Her secretary _____ her office.","choices":["run in","slow up","show over","see into"]},{"term":"see off","prompt":"I went to the station to _____.","choices":["rush away","saddle up","run in","see off"]},{"term":"set out","prompt":"The explorers _____ for the South Pole yesterday morning.","choices":["set out","show over","slow up","run in"]},{"term":"ship off","prompt":"They had to _____ the old furniture today.","choices":["sally out","ship off","sally forth","scout out"]},{"term":"ship out","prompt":"If you've finished your work, I'm ready to _____.","choices":["ship out","see off","see into","shoot away"]},{"term":"shoot away","prompt":"He _____ as soon as the bell rang for the end of the lesson.","choices":["scout out","sally forth","shoot away","sally out"]},{"term":"shoot back","prompt":"I'm _____ home to pick up some things I forgot to bring with me.","choices":["show over","run in","shoot back","slow up"]},{"term":"shoot off","prompt":"I'll have to _____ as soon as the lesson finishes, otherwise I'll miss my train.","choices":["shoot off","sally out","see into","scout out"]},{"term":"shoot out","prompt":"I will _____ to the store for milk.","choices":["rush away","slow up","shoot out","run in"]},{"term":"show around","prompt":"The estate agent _____ the house but we didn't like it much.","choices":["run in","slow up","rush away","show around"]},{"term":"show over","prompt":"He will _____ the garden to his guests.","choices":["sally forth","sally out","show over","scout out"]},{"term":"slow up","prompt":"The negotiations were _____ by the arguments.","choices":["scout out","sally forth","slow up","sally out"]}]},{"id":"phrasal-verbs-v1-lesson-058","title":"Bài 58: Di chuyển và du lịch · sneak–tag","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (sneak–tag).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"sneak out","prompt":"Although the thieves tried to _____ after dark, we were ready for them.","choices":["sneak out","steal up","steal away","stack up"]},{"term":"sneak up on","prompt":"Dave tried to _____ the guard, but was seen anyway.","choices":["sneak up on","steal out","steal up","steal away"]},{"term":"spill out","prompt":"The crowd _____ onto the streets after the match had ended.","choices":["steal away","squeeze up","stack up","spill out"]},{"term":"spirit off","prompt":"They _____ before any trouble started.","choices":["splash down","spirit off","sneak up on","spill out"]},{"term":"splash down","prompt":"Apollo 13 _____ after a harrowing flight.","choices":["splash down","steal up on","stop by","stomp off"]},{"term":"spring up","prompt":"Charity shops are _____ in the recession.","choices":["spring up","spill out","sneak out","sneak up on"]},{"term":"squeeze up","prompt":"Four of us had to _____ in the back of the car.","choices":["squeeze up","tag along","swing by","sneak out"]},{"term":"stack up","prompt":"Planes were _____ while the airport was closed after the bomb threat.","choices":["stack up","stop by","stomp off","storm off"]},{"term":"start out","prompt":"We _____ early in the morning.","choices":["steal away","stack up","squeeze up","start out"]},{"term":"steal away","prompt":"We didn't want to wake them, so we _____ in the middle of the night.","choices":["stomp off","steal away","storm off","stop by"]},{"term":"steal out","prompt":"Not wanting to attract attention, she _____ early.","choices":["steal out","stack up","stomp off","squeeze up"]},{"term":"steal up","prompt":"The lights were off and everything was quiet so we _____ as quietly as we could.","choices":["stomp off","splash down","start out","steal up"]},{"term":"steal up on","prompt":"We _____ them so that they couldn't sound the alarm.","choices":["storm off","stop by","steal up on","stomp off"]},{"term":"stomp off","prompt":"He lost his temper and _____ home.","choices":["sneak up on","sneak out","spill out","stomp off"]},{"term":"stop by","prompt":"I must _____ the supermarket and pick up some things for dinner.","choices":["stop by","stow away","tag along","sneak out"]},{"term":"storm off","prompt":"They had a row and he _____.","choices":["stop by","storm off","stow away","steal up on"]},{"term":"stow away","prompt":"She _____ on the plane but was caught when it landed.","choices":["spring up","stack up","squeeze up","stow away"]},{"term":"swing by","prompt":"I will _____ this afternoon and pick you up.","choices":["spring up","splash down","spirit off","swing by"]},{"term":"tag along","prompt":"You're off to the cinema; can we _____?","choices":["squeeze up","spring up","splash down","tag along"]}]},{"id":"phrasal-verbs-v1-lesson-059","title":"Bài 59: Di chuyển và du lịch · tail–zoom","focus":"Đi lại, phương tiện, khởi hành và quay về. Các cụm được xếp theo động từ gốc (tail–zoom).","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","questions":[{"term":"tail back","prompt":"The traffic _____ for several miles after the accident.","choices":["walk on","wander off","tail back","walk up"]},{"term":"tear out","prompt":"The sheriff _____ after the escaping criminals.","choices":["venture forth","tear out","wait around","wait about"]},{"term":"toddle off","prompt":"It's geting late, so I'm going to _____ home.","choices":["venture forth","turn back","toddle off","wait about"]},{"term":"tootle off","prompt":"It's getting late, so we're going to _____ home.","choices":["wheel around","whisk away","tootle off","wave on"]},{"term":"touch down","prompt":"The plane _____ at Narita airport an hour late.","choices":["tootle off","turn back","tow away","touch down"]},{"term":"tow away","prompt":"I parked in a no-parking zone and they _____.","choices":["tow away","wait around","walk on","wait about"]},{"term":"turn back","prompt":"Severe snowstorms forced the mountain climbing expedition to _____.","choices":["wheel around","wave on","turn back","whisk away"]},{"term":"venture forth","prompt":"If the storm has finished, we could _____.","choices":["touch down","venture forth","tow away","tootle off"]},{"term":"wait about","prompt":"I _____ for an hour, but they didn't come.","choices":["wave on","wave down","wheel around","wait about"]},{"term":"wait around","prompt":"They were just _____ to see if anything was going to happen.","choices":["toddle off","tail back","wait around","tear out"]},{"term":"walk on","prompt":"I saw the accident but just _____ as I didn't want to have to give a statement.","choices":["walk on","zoom off","tear out","tail back"]},{"term":"walk up","prompt":"A man _____ and asked me the time.","choices":["walk up","wait around","wait about","wander off"]},{"term":"wander off","prompt":"She _____ and got lost in the crowd.","choices":["wait around","wait about","venture forth","wander off"]},{"term":"wash away","prompt":"The ice cream stall on the beach was _____ in the storm last night.","choices":["wash away","wait about","walk on","wait around"]},{"term":"wave down","prompt":"They _____ and got a lift after the accident.","choices":["wave down","toddle off","tail back","tear out"]},{"term":"wave on","prompt":"The accident was bad, but the police _____.","choices":["wash away","walk up","wave on","wander off"]},{"term":"wheel around","prompt":"When he heard the whistle, he _____ to see what was happening.","choices":["toddle off","tootle off","tear out","wheel around"]},{"term":"whisk away","prompt":"The police _____ when the trouble started.","choices":["touch down","whisk away","toddle off","tootle off"]},{"term":"zoom off","prompt":"He rushed out of the building and _____ in his car.","choices":["venture forth","zoom off","wait about","turn back"]}]},{"id":"phrasal-verbs-v1-lesson-060","title":"Bài 60: Tiền bạc và mua sắm · add–clean","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (add–clean).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"add on","prompt":"You have to _____ to the price they give.","choices":["auction off","bargain down","add on","bargain for"]},{"term":"auction off","prompt":"They _____ their property as they were heavily in debt.","choices":["cash in","buy out","buy up","auction off"]},{"term":"bargain down","prompt":"I _____ to half what she originally wanted.","choices":["buy in","bargain down","buy into","bump up"]},{"term":"bargain for","prompt":"I did not _____ such a difficult task.","choices":["bargain for","cash in on","cash up","cash out"]},{"term":"bargain on","prompt":"I hadn't _____ him coming.","choices":["clean out","bargain on","auction off","claw back"]},{"term":"bottom out","prompt":"The recession _____ and the economy is recovering well.","choices":["bargain down","bargain on","bargain for","bottom out"]},{"term":"branch out","prompt":"The supermarkets have _____ into banking.","choices":["claw back","branch out","chalk up","add on"]},{"term":"bump up","prompt":"They _____ the prices in the high season.","choices":["bump up","cash in","buy out","buy off"]},{"term":"buy in","prompt":"Joe Meek's last hit, 'Singin' the Blues', was probably _____ at number 40, but failed to go any higher.","choices":["branch out","cash in on","buy in","bump up"]},{"term":"buy into","prompt":"I never _____ the idea of a federalist Euopean Union.","choices":["bottom out","bargain on","buy into","bargain for"]},{"term":"buy off","prompt":"He _____ by placing a lot of adverts.","choices":["cash out","buy off","cash in","cash in on"]},{"term":"buy out","prompt":"His business partners _____ to get rid of him.","choices":["buy out","bump up","cash in","cash in on"]},{"term":"buy up","prompt":"We _____ all the shop had before the price went up.","choices":["cash in","cash in on","cash out","buy up"]},{"term":"cash in","prompt":"They _____ their bonds and spent the money on a holiday.","choices":["buy into","buy out","cash in","buy off"]},{"term":"cash in on","prompt":"The opposition party are _____ the government's unpopularity.","choices":["cash in on","branch out","buy in","bump up"]},{"term":"cash out","prompt":"After winning, she _____ her chips.","choices":["buy in","cash out","bump up","buy into"]},{"term":"cash up","prompt":"After the shop closed, they have to _____ before they can go home.","choices":["buy into","buy in","buy off","cash up"]},{"term":"chalk up","prompt":"The company has _____ its highest ever profits.","choices":["chalk up","buy out","buy off","buy into"]},{"term":"claw back","prompt":"They are _____ their market share from their competitors.","choices":["cash in on","claw back","cash out","cash in"]},{"term":"clean out","prompt":"The holiday _____- I'm broke till the end of the month.","choices":["bargain for","bargain on","bargain down","clean out"]}]},{"id":"phrasal-verbs-v1-lesson-061","title":"Bài 61: Tiền bạc và mua sắm · close–eke","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (close–eke).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"close down","prompt":"The banks have _____ a lot of branches in villages over the last few years.","choices":["close down","cream off","count up","count out"]},{"term":"come by","prompt":"How did you _____ that Rolex?","choices":["come by","eke out","close down","eat into"]},{"term":"contract out","prompt":"They have _____ their catering services to save money.","choices":["cream off","cut back on","cut back","contract out"]},{"term":"cost up","prompt":"The decorators are going to _____ the work tomorrow.","choices":["dole out","divvy out","cut back on","cost up"]},{"term":"cough up","prompt":"He was checked so hard he _____ the puck in front of his own goal.","choices":["close down","eke out","eat into","cough up"]},{"term":"count out","prompt":"He _____ £250 and paid me.","choices":["count out","close down","cost up","come by"]},{"term":"count up","prompt":"_____ the number of tickets sold, please.","choices":["eat into","count up","draw down","dole out"]},{"term":"cream off","prompt":"The private schools _____ many of the best pupils.","choices":["eat into","dry up","drum up","cream off"]},{"term":"cut back","prompt":"The firm _____ production because sales were sluggish.","choices":["contract out","cut back","cost up","cough up"]},{"term":"cut back on","prompt":"The government has decided to _____ spending on the armed forces.","choices":["cough up","cut back on","cost up","count out"]},{"term":"divide up","prompt":"They _____ the profits.","choices":["count out","cream off","divide up","cut back"]},{"term":"divvy out","prompt":"The waiters and waitresses _____ the tips at the end of the night.","choices":["draw down","drive up","drum up","divvy out"]},{"term":"divvy up","prompt":"We _____ the money equally.","choices":["cut back on","cut back","cream off","divvy up"]},{"term":"dole out","prompt":"They were _____ leaflets in front of the station.","choices":["drive up","dole out","dry up","drum up"]},{"term":"draw down","prompt":"Gas reserves were _____ in the recent cold spell.","choices":["cream off","count up","count out","draw down"]},{"term":"drive up","prompt":"The market uncertainty has _____.","choices":["eat into","drive up","draw down","dole out"]},{"term":"drum up","prompt":"They are trying to _____ support for the referendum.","choices":["drum up","cream off","cut back","cut back on"]},{"term":"dry up","prompt":"His income _____ when cheaper options became available.","choices":["eke out","close down","dry up","come by"]},{"term":"eat into","prompt":"We've had to _____ our savings since I lost my job.","choices":["count up","eat into","cream off","count out"]},{"term":"eke out","prompt":"Most students have to _____ their income because they have so little money to live on.","choices":["drum up","dry up","eke out","eat into"]}]},{"id":"phrasal-verbs-v1-lesson-062","title":"Bài 62: Tiền bạc và mua sắm · fall–latch","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (fall–latch).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"fall off","prompt":"The membership _____ dramatically when the chairperson resigned.","choices":["lash out","knock out","latch onto","fall off"]},{"term":"fork out","prompt":"I had to _____ over $500 to repair my broken laptop screen.","choices":["hold out for","hose down","jump off","fork out"]},{"term":"get back","prompt":"Don't lend him any money; you'll never _____.","choices":["get back","go to","go off with","hang onto"]},{"term":"get behind with","prompt":"If you _____ mortgage payments, you might lose your home.","choices":["hang onto","get behind with","give back","go to"]},{"term":"get by on","prompt":"It's hard to _____ my salary.","choices":["hold out for","hose down","jump off","get by on"]},{"term":"give back","prompt":"Nothing could _____ the way I felt before the scandal.","choices":["hive off","hold out for","hit up","give back"]},{"term":"go off with","prompt":"She _____ her friend's husband.","choices":["jump off","hose down","go off with","kick back"]},{"term":"go to","prompt":"About half of my income _____ pay the mortgage.","choices":["go to","hold out for","hive off","hose down"]},{"term":"hang onto","prompt":"I _____ my old records even though I never played them.","choices":["knock out","kick back","jump off","hang onto"]},{"term":"hang out for","prompt":"She's _____ a big raise.","choices":["hang out for","hose down","hit up","hive off"]},{"term":"hit for","prompt":"They _____ a lot of money.","choices":["jump off","hit for","hose down","hive off"]},{"term":"hit up","prompt":"He always tries to _____ for money when we meet.","choices":["hit up","jump off","kick back","knock out"]},{"term":"hive off","prompt":"They _____ the retail operations.","choices":["fork out","hive off","latch onto","lash out"]},{"term":"hold out for","prompt":"We are _____ a much better deal than the one offered.","choices":["jump off","knock out","kick back","hold out for"]},{"term":"hose down","prompt":"They have _____ with capital.","choices":["go off with","give back","get by on","hose down"]},{"term":"jump off","prompt":"The ipo _____ on the first day.","choices":["give back","get by on","jump off","go off with"]},{"term":"kick back","prompt":"I had to _____ to the government official to get the contract.","choices":["go to","go off with","hang onto","kick back"]},{"term":"knock out","prompt":"They're _____ a day in the sales.","choices":["go to","hang onto","hang out for","knock out"]},{"term":"lash out","prompt":"I _____ in the sales last week.","choices":["lash out","hit up","hang out for","hit for"]},{"term":"latch onto","prompt":"Oil companies have _____ environmental ideas.","choices":["kick back","jump off","knock out","latch onto"]}]},{"id":"phrasal-verbs-v1-lesson-063","title":"Bài 63: Tiền bạc và mua sắm · lay–pay","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (lay–pay).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"lay out","prompt":"They _____ thousands of pounds on their wedding reception.","choices":["pay for","pay into","pay down","lay out"]},{"term":"live off","prompt":"They find it hard to _____ the money they make.","choices":["pare back","mount up","live off","pare down"]},{"term":"lock out","prompt":"The management _____ because they had turned down the pay offer.","choices":["lose out to","lose out on","make over","lock out"]},{"term":"lose out","prompt":"Many people _____ when the new regulations were enforced.","choices":["pay for","lose out","pay down","pass up"]},{"term":"lose out on","prompt":"Because I left the company, I _____ my bonus.","choices":["mark up","make over","make up to","lose out on"]},{"term":"lose out to","prompt":"People without IT skills often _____ those with the skills.","choices":["live off","make over","lose out to","lock out"]},{"term":"make over","prompt":"She _____ her property to her children.","choices":["make over","pay down","pass to","pass up"]},{"term":"make up to","prompt":"She wanted to _____ her friend for missing the wedding.","choices":["max out","mount up","make up to","mark up"]},{"term":"mark up","prompt":"They _____ by 25% before they sell them.","choices":["pass to","part with","mark up","pare down"]},{"term":"max out","prompt":"She _____ her credit cards.","choices":["live off","max out","lose out to","lose out on"]},{"term":"mount up","prompt":"My debts _____ while I was at university.","choices":["palm off","mount up","pare down","pare back"]},{"term":"palm off","prompt":"He tried to _____ with a pathetic excuse.","choices":["part with","pare back","palm off","pare down"]},{"term":"pare back","prompt":"They have had to _____ the services they offer as their funding was reduced.","choices":["lay out","pay into","pay for","pare back"]},{"term":"pare down","prompt":"They have _____ the number of employees as they haven't been doing well.","choices":["mount up","palm off","max out","pare down"]},{"term":"part with","prompt":"I found it very hard to _____ my old CDs when I digitized my collection.","choices":["lock out","live off","part with","lay out"]},{"term":"pass to","prompt":"The property will _____ her when they die.","choices":["pass to","make over","max out","mark up"]},{"term":"pass up","prompt":"She _____ the opportunity to go to university because she'd been offered a job.","choices":["pass up","pay for","pay into","pay down"]},{"term":"pay down","prompt":"The British government can't _____ the national debt.","choices":["part with","pare back","palm off","pay down"]},{"term":"pay for","prompt":"I _____ the book.","choices":["pare back","pay for","palm off","mount up"]},{"term":"pay into","prompt":"I _____ my account.","choices":["lay out","live off","lock out","pay into"]}]},{"id":"phrasal-verbs-v1-lesson-064","title":"Bài 64: Tiền bạc và mua sắm · pay–run","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (pay–run).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"pay off","prompt":"Their patience _____ when he finally showed up and signed the contract.","choices":["plow back","plough back","pony up","pay off"]},{"term":"pay up","prompt":"After weeks of reminders, he finally agreed to _____ his debt.","choices":["plow back","price in","plough back","pay up"]},{"term":"plough back","prompt":"We _____ all the profits to grow the company.","choices":["price in","pony up","plough back","pay up"]},{"term":"plow back","prompt":"We _____ all the profits to grow the company.","choices":["pony up","plow back","price in","price up"]},{"term":"pony up","prompt":"I had to _____ for the meal.","choices":["price in","pony up","plow back","plough back"]},{"term":"price in","prompt":"Speculators have _____ the risk of a war breaking out.","choices":["ramp up","rake off","price in","rent out"]},{"term":"price up","prompt":"In rural areas where they have a monopoly, some garages _____ fuel because there's nowhere else to buy it.","choices":["price up","rake it in","rake in","put by"]},{"term":"put by","prompt":"I try to _____ every month towards our summer holiday.","choices":["rake in","rake it in","rack up","put by"]},{"term":"rack up","prompt":"He's _____ a number of convictions for speeding.","choices":["put by","rake in","rack up","rake it in"]},{"term":"rake in","prompt":"She's _____ thousands a day.","choices":["run up","pay off","pay up","rake in"]},{"term":"rake it in","prompt":"It's the only shop in the area and they're _____.","choices":["ramp up","ring up","rent out","rake it in"]},{"term":"rake off","prompt":"They _____ all the time.","choices":["roll out","run to","run up","rake off"]},{"term":"ramp up","prompt":"The company has _____ because of higher oil prices.","choices":["rake off","reel in","ramp up","rake it in"]},{"term":"reel in","prompt":"The new ad will _____ many more customers.","choices":["ramp up","reel in","ring up","rent out"]},{"term":"rent out","prompt":"They _____ while the were abroad.","choices":["rake it in","rent out","ramp up","rake off"]},{"term":"ring up","prompt":"They _____ the bill for the groceries.","choices":["pay off","plow back","plough back","ring up"]},{"term":"roll back","prompt":"The government want to _____ the freedom of the press.","choices":["roll back","rake in","rake off","rake it in"]},{"term":"roll out","prompt":"The company _____ its takeover plans last week.","choices":["pony up","plow back","plough back","roll out"]},{"term":"run to","prompt":"Things are a bit tight and won't _____ going abroad for a holiday.","choices":["pay off","pay up","run to","plough back"]},{"term":"run up","prompt":"He _____ a few examples for them to look at.","choices":["rake off","run up","reel in","rent out"]}]},{"id":"phrasal-verbs-v1-lesson-065","title":"Bài 65: Tiền bạc và mua sắm · rush–shave","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (rush–shave).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"rush out","prompt":"They _____ after it started getting airplay.","choices":["sell up","send back","rush out","send off for"]},{"term":"salt away","prompt":"She's making a lot of money, but _____ rather than spending it.","choices":["salt away","scale back","save up","save on"]},{"term":"save on","prompt":"I use Skype to _____ my phone bills.","choices":["save on","scrape along","scale down","scale up"]},{"term":"save up","prompt":"I'm _____ the receipts to claim on them all at once.","choices":["save up","scrape by","scrape along","scale down"]},{"term":"scale back","prompt":"They had to _____ the project because of the costs.","choices":["scale back","settle up","shave off","send off for"]},{"term":"scale down","prompt":"They have had to _____ the project because of the costs.","choices":["send off for","send back","scale down","sell up"]},{"term":"scale up","prompt":"They are _____ the programme because it has been so successful.","choices":["scale up","send off for","sell out","send back"]},{"term":"scrape along","prompt":"I've been _____ on temporary work since I lost my job.","choices":["settle up","send off for","scrape along","send back"]},{"term":"scrape by","prompt":"I thought I was going to fail, but _____ with 51%.","choices":["screw over","sell off","sell on","scrape by"]},{"term":"scrape together","prompt":"I had to search my flat for money to _____ what I needed.","choices":["save up","scrape together","save on","salt away"]},{"term":"scrape up","prompt":"It took me ages to _____ the money for the tickets.","choices":["scrape up","shave off","salt away","rush out"]},{"term":"screw over","prompt":"The irs really _____.","choices":["scale down","scale back","save up","screw over"]},{"term":"sell off","prompt":"She _____ her furniture before she emigrated.","choices":["send off for","send back","settle up","sell off"]},{"term":"sell on","prompt":"We buy them wholesale and _____ to the public.","choices":["settle up","send back","sell on","send off for"]},{"term":"sell out","prompt":"Most bands _____ when they sign to a major record label, and forget all their principles when pursuing chart success.","choices":["sell out","send off for","settle up","shave off"]},{"term":"sell up","prompt":"We want to _____ and move to the country.","choices":["send off for","sell up","screw over","send back"]},{"term":"send back","prompt":"I _____ because it was overcooked.","choices":["scale down","save on","save up","send back"]},{"term":"send off for","prompt":"I _____ some jeans that I liked in the catalogue.","choices":["send off for","save up","save on","salt away"]},{"term":"settle up","prompt":"Let's _____ for the dinner the other night.","choices":["screw over","sell on","settle up","sell off"]},{"term":"shave off","prompt":"He _____ the budget for the year.","choices":["sell out","sell on","sell up","shave off"]}]},{"id":"phrasal-verbs-v1-lesson-066","title":"Bài 66: Tiền bạc và mua sắm · shell–syphon","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (shell–syphon).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"shell out","prompt":"I had to _____ a hundred pounds on the dinner.","choices":["spring for","shell out","squirrel away","stash away"]},{"term":"shop around","prompt":"If you _____, you can find some real bargains for air tickets.","choices":["shop around","shell out","stump up","syphon off"]},{"term":"shut down","prompt":"The shop _____ when the out-of- town supermarket opened.","choices":["squirrel away","stash away","spring for","shut down"]},{"term":"shut up","prompt":"They _____ for a fortnight while they were on holiday.","choices":["splash out","spin off","splash out on","shut up"]},{"term":"sign away","prompt":"He _____ his rights to compensation when he signed the contract.","choices":["syphon off","sign away","shell out","stump up"]},{"term":"sign for","prompt":"My boss was out for the day, so I _____ her.","choices":["stock up","stash away","sign for","stump up"]},{"term":"snaffle up","prompt":"They _____ all the food before we got there.","choices":["spin off","snaffle up","sign for","spaff away"]},{"term":"spaff away","prompt":"The council is _____ our taxes on bonuses and consultants.","choices":["spaff away","sponge off","splash out","splash out on"]},{"term":"spin off","prompt":"The studio decided to _____ a new series.","choices":["spin off","splash out","splash out on","sponge on"]},{"term":"splash out","prompt":"They like to _____ on luxury vacations.","choices":["sponge on","splash out","sponge off","spring for"]},{"term":"splash out on","prompt":"I _____ a new camera.","choices":["stash away","stock up","stick out for","splash out on"]},{"term":"sponge off","prompt":"Let’s go to New York, we can always _____ my brother there.","choices":["shell out","shop around","sponge off","stump up"]},{"term":"sponge on","prompt":"A lot of people are _____ the state by claiming benefits they're not entitled to.","choices":["sponge on","stick out for","stump up","stock up"]},{"term":"spring for","prompt":"She is going to _____ all their medical bills.","choices":["snaffle up","sign away","shut up","spring for"]},{"term":"squirrel away","prompt":"She has been _____ part of her salary every month for a house deposit.","choices":["stock up","stump up","squirrel away","stick out for"]},{"term":"stash away","prompt":"I _____ behind some books.","choices":["snaffle up","spin off","sign for","stash away"]},{"term":"stick out for","prompt":"We're _____ a 5% increase.","choices":["shut down","stick out for","shop around","shell out"]},{"term":"stock up","prompt":"People rushed to the supermarket to _____ on food before the storm hit.","choices":["spin off","splash out","stock up","spaff away"]},{"term":"stump up","prompt":"He didn't want to pay me back, but I got him to _____ in the end.","choices":["syphon off","shell out","stump up","shop around"]},{"term":"syphon off","prompt":"The candidate _____ a lot of votes because of his anti-war stance.","choices":["shell out","stump up","stock up","syphon off"]}]},{"id":"phrasal-verbs-v1-lesson-067","title":"Bài 67: Tiền bạc và mua sắm · tap–zero","focus":"Mua bán, giá cả, thanh toán và quản lý tiền. Các cụm được xếp theo động từ gốc (tap–zero).","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","questions":[{"term":"tap into","prompt":"The company is hoping to _____ the Chinese market.","choices":["top up","throw in","tide over","tap into"]},{"term":"tap out","prompt":"How can we buy a new house without _____ our savings account.","choices":["turn over","tap out","walk away with","walk off with"]},{"term":"throw in","prompt":"They _____ a printer so I bought it from them.","choices":["walk away with","throw in","walk off with","turn over"]},{"term":"tide over","prompt":"This £50 will have to _____ until I get paid.","choices":["walk off with","tide over","write off","weigh out"]},{"term":"top up","prompt":"Shall I _____ your drink while I'm pouring myself one?","choices":["weigh out","top up","walk off with","write off"]},{"term":"touch for","prompt":"I _____ some cash as I'd forgotten my cards.","choices":["turn over","touch for","walk away with","walk off with"]},{"term":"trade down","prompt":"Their house it too large now that their children have left home, so they're going to _____ to something smaller.","choices":["walk away with","try out","turn over","trade down"]},{"term":"trade in","prompt":"She _____ her old car for the new model.","choices":["try out","turn over","trade in","trickle down"]},{"term":"trade on","prompt":"He _____ their insecurity to get his way.","choices":["try out","walk away with","turn over","trade on"]},{"term":"trade up","prompt":"She supported him for years while he was struggling, but when he hit the big time he left her and _____.","choices":["trade up","trickle down","try out","touch for"]},{"term":"trade upon","prompt":"They _____ their reputation to scare rivals.","choices":["trade upon","tap into","tap out","throw in"]},{"term":"trickle down","prompt":"Despite the economic boom, few benefits have _____ to the poor.","choices":["trickle down","throw in","tap into","tap out"]},{"term":"try out","prompt":"I _____ the program before I bought it.","choices":["trade down","top up","try out","touch for"]},{"term":"turn over","prompt":"The court ordered the company to _____ their financial records.","choices":["turn over","try out","walk away with","trickle down"]},{"term":"walk away with","prompt":"She managed to _____ the prize.","choices":["tap out","zero out","tap into","walk away with"]},{"term":"walk off with","prompt":"Someone _____ my umbrella so I got soaked.","choices":["walk off with","try out","turn over","trickle down"]},{"term":"weigh out","prompt":"Could you _____ 200 grammes of that for me?","choices":["trade on","trade up","trade upon","weigh out"]},{"term":"write off","prompt":"He _____ in an accident on the motorway.","choices":["top up","throw in","write off","tide over"]},{"term":"zero out","prompt":"The debt was _____ by the department.","choices":["throw in","top up","zero out","tide over"]}]},{"id":"phrasal-verbs-v1-lesson-068","title":"Bài 68: Công nghệ và thiết bị · act–freeze","focus":"Máy móc, thiết bị, máy tính và dữ liệu. Các cụm được xếp theo động từ gốc (act–freeze).","topicId":"technology","topicTitle":"Công nghệ và thiết bị","questions":[{"term":"act up","prompt":"My computer's _____; I think I might have a virus.","choices":["conk out","act up","click through","come on"]},{"term":"back up","prompt":"You should _____ your files every week.","choices":["come on","back up","click through","conk out"]},{"term":"boot up","prompt":"He _____ the computer and started work.","choices":["conk out","come on","creep out on","boot up"]},{"term":"charge up","prompt":"I need to _____- the battery's dead.","choices":["come on","conk out","charge up","click through"]},{"term":"chew up","prompt":"The video _____.","choices":["conk out","come on","click through","chew up"]},{"term":"click through","prompt":"Only a tiny fraction of users ever bother _____ the banner adverts.","choices":["back up","click through","act up","freeze up"]},{"term":"come on","prompt":"The central heating _____ automatically an hour before I have to get up.","choices":["drill down","flick over","eat up","come on"]},{"term":"conk out","prompt":"The printer _____ so I couldn't get a hard copy.","choices":["click through","conk out","come on","chew up"]},{"term":"crack up","prompt":"You'll have to talk louder- you're _____.","choices":["conk out","crack up","click through","come on"]},{"term":"crank up","prompt":"I _____ as high as it would go.","choices":["creep out on","drill down","flick over","crank up"]},{"term":"creep out on","prompt":"He's been _____ that computer game all day.","choices":["creep out on","charge up","chew up","click through"]},{"term":"drill down","prompt":"I really had to _____ to get the answers from the database.","choices":["drill down","freeze up","flick through","act up"]},{"term":"eat up","prompt":"The heavy software will _____ your memory.","choices":["come on","conk out","creep out on","eat up"]},{"term":"flick over","prompt":"She _____ to see if the news had started.","choices":["back up","flick over","freeze up","act up"]},{"term":"flick through","prompt":"I _____ the channels to see if there was anything worth watching.","choices":["drill down","flick through","crank up","creep out on"]},{"term":"freeze up","prompt":"The gears had _____.","choices":["conk out","come on","click through","freeze up"]}]},{"id":"phrasal-verbs-v1-lesson-069","title":"Bài 69: Công nghệ và thiết bị · geek–mix","focus":"Máy móc, thiết bị, máy tính và dữ liệu. Các cụm được xếp theo động từ gốc (geek–mix).","topicId":"technology","topicTitle":"Công nghệ và thiết bị","questions":[{"term":"geek out","prompt":"Henry always _____ at parties and bores all the people who don't know much about computers.","choices":["geek out","hack into","go on","go off"]},{"term":"give out","prompt":"I'd been having trouble with my laptop and it finally _____ at the weekend.","choices":["key in","leave on","give out","link up"]},{"term":"go off","prompt":"The lights _____ automatically when the office is empty.","choices":["hook up to","go off","grey out","hack into"]},{"term":"go on","prompt":"The alarm _____ when you close the front door.","choices":["mash up","go on","lock onto","log in"]},{"term":"grey out","prompt":"They decided to _____ the inactive buttons.","choices":["grey out","go on","hack into","go off"]},{"term":"hack into","prompt":"He _____ the government database and stole a lot of data.","choices":["geek out","mash up","hack into","mix up"]},{"term":"hook up to","prompt":"He's _____ a ventilator in the hospital.","choices":["leave on","hook up to","key in","link up"]},{"term":"juice up","prompt":"I need to buy some memory to _____.","choices":["key in","juice up","leave on","lock down"]},{"term":"key in","prompt":"It took me ages to _____ all the information into the database.","choices":["give out","geek out","mix up","key in"]},{"term":"leave on","prompt":"_____; I want to hear the football results.","choices":["go off","grey out","leave on","give out"]},{"term":"link up","prompt":"The train _____ the cities.","choices":["lock onto","link up","log in","lock down"]},{"term":"lock down","prompt":"If you _____ your computer properly, it is very difficult for people to access it.","choices":["mash up","link up","lock down","log in"]},{"term":"lock onto","prompt":"The missile _____ the plane and blew it out of the sky.","choices":["hook up to","key in","juice up","lock onto"]},{"term":"log in","prompt":"I had forgotten my password and couldn't _____.","choices":["give out","log in","geek out","go off"]},{"term":"mash up","prompt":"She _____ the songs into a single track.","choices":["hook up to","mash up","key in","hack into"]},{"term":"mix up","prompt":"The dj _____ the night with some hard techno.","choices":["grey out","go off","mix up","go on"]}]},{"id":"phrasal-verbs-v1-lesson-070","title":"Bài 70: Công nghệ và thiết bị · move–sign","focus":"Máy móc, thiết bị, máy tính và dữ liệu. Các cụm được xếp theo động từ gốc (move–sign).","topicId":"technology","topicTitle":"Công nghệ và thiết bị","questions":[{"term":"move away from","prompt":"They're _____ Windows and are using Linux.","choices":["move away from","put through","run on","scroll down"]},{"term":"opt in","prompt":"If you want them to notify you of updates, you have to _____.","choices":["scroll down","run on","opt in","put through"]},{"term":"opt into","prompt":"I _____ the scheme.","choices":["move away from","opt into","play out","play back"]},{"term":"play back","prompt":"We _____ to see if it was OK.","choices":["power off","opt into","power down","play back"]},{"term":"play out","prompt":"Computer games allow people to _____ their violent urges.","choices":["power up","put in","play out","put through"]},{"term":"power down","prompt":"I _____ my computer and went for lunch.","choices":["power down","print out","put through","put in"]},{"term":"power off","prompt":"You mustn't _____ while it is updating.","choices":["play back","play out","power off","print out"]},{"term":"power up","prompt":"I _____ my laptop and started work.","choices":["print out","play back","play out","power up"]},{"term":"print out","prompt":"He _____ the letter and checked through it carefully.","choices":["sign in","scroll down","shut in","print out"]},{"term":"put in","prompt":"They had to _____ a whole new central heating system because the house was so cold.","choices":["short out","opt into","move away from","put in"]},{"term":"put through","prompt":"Could you _____ to extension 259 please.","choices":["print out","power up","put through","run on"]},{"term":"run on","prompt":"The van _____ diesel.","choices":["scroll down","run on","shut in","short out"]},{"term":"scroll down","prompt":"_____ to the bottom of the webpage to see the contact details.","choices":["opt in","move away from","scroll down","opt into"]},{"term":"short out","prompt":"The battery _____ when it got wet.","choices":["run on","put in","short out","put through"]},{"term":"shut in","prompt":"I _____ until it was time to go to the vet.","choices":["opt into","play back","play out","shut in"]},{"term":"sign in","prompt":"You have to _____ before you can enter the club.","choices":["put through","power up","print out","sign in"]}]},{"id":"phrasal-verbs-v1-lesson-071","title":"Bài 71: Công nghệ và thiết bị · sign–zoom","focus":"Máy móc, thiết bị, máy tính và dữ liệu. Các cụm được xếp theo động từ gốc (sign–zoom).","topicId":"technology","topicTitle":"Công nghệ và thiết bị","questions":[{"term":"sign into","prompt":"I _____ msn Messenger automatically when I boot up.","choices":["wire up","sign into","white out","type up"]},{"term":"sign out","prompt":"Could you _____, please?","choices":["tune in","switch on","switch off","sign out"]},{"term":"switch off","prompt":"Remember to _____ your computer before leaving the office.","choices":["sign out","sign into","switch off","time out"]},{"term":"switch on","prompt":"Please _____ the light; it is getting dark in here.","choices":["wire up","type up","switch on","white out"]},{"term":"time out","prompt":"The program _____ after twenty minutes.","choices":["switch on","time out","sign into","switch off"]},{"term":"tune in","prompt":"Be sure to _____ next week for the next episode.","choices":["tune in","white out","type up","type out"]},{"term":"tune in to","prompt":"Make sure you _____ next week's show.","choices":["tune in to","type up","type in","type out"]},{"term":"tune up","prompt":"He's _____ for the race.","choices":["tune up","zoom in on","zoom in","zoom out"]},{"term":"type in","prompt":"He _____ and printed it off.","choices":["zoom in on","wire up","type in","zoom out"]},{"term":"type out","prompt":"She _____ and handed it in a the last minute.","choices":["switch off","tune in","type out","switch on"]},{"term":"type up","prompt":"She _____ her lecture notes and printed them out.","choices":["zoom out","zoom in on","type up","sign into"]},{"term":"white out","prompt":"Could you pass the Tippex? I need to _____.","choices":["tune in","white out","switch off","switch on"]},{"term":"wire up","prompt":"She _____ as soon as she got home.","choices":["zoom in on","zoom out","wire up","zoom in"]},{"term":"zoom in","prompt":"The camera _____ to show people's faces.","choices":["zoom in","switch on","sign out","switch off"]},{"term":"zoom in on","prompt":"The camera _____ his face.","choices":["tune in","time out","zoom in on","switch off"]},{"term":"zoom out","prompt":"The camera _____ to show all the crowd.","choices":["type in","zoom out","tune up","tune in to"]}]},{"id":"phrasal-verbs-v1-lesson-072","title":"Bài 72: Sức khỏe và cảm xúc · ache–boil","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (ache–boil).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"ache for","prompt":"My partner's been away for a fortnight- I am _____ her.","choices":["ache for","black out","bear up under","big up"]},{"term":"act out","prompt":"Their anger is _____ in their antisocial behaviour.","choices":["be fed up","be on","act out","be down with"]},{"term":"agree with","prompt":"I feel terrible- that food didn't _____ my stomach.","choices":["agree with","blank out","bleed out","black out"]},{"term":"ask after","prompt":"Jenny rang earlier and _____ you, so I told her you were fine.","choices":["big up","bear up","ask after","bear up under"]},{"term":"be down","prompt":"He's _____ since his partner left him.","choices":["act out","be down","ache for","boil up"]},{"term":"be down with","prompt":"Gul _____ some bug and is off work today.","choices":["ask after","bear up","be down with","bear up under"]},{"term":"be fed up","prompt":"I _____ of his complaints.","choices":["act out","agree with","ache for","be fed up"]},{"term":"be on","prompt":"He _____ right now- three goals in five minutes!","choices":["be on","big up","bear up under","bear up"]},{"term":"bear up","prompt":"How are you _____ under the strain?","choices":["bear up","be down with","be down","be on"]},{"term":"bear up under","prompt":"He's _____ the pressure.","choices":["blank out","big up","bear up under","black out"]},{"term":"big up","prompt":"They work out a lot to _____.","choices":["big up","block out","boil over","blow away"]},{"term":"black out","prompt":"He _____ and collapsed on the floor.","choices":["bear up","be on","bear up under","black out"]},{"term":"blank out","prompt":"I was so nervous in the interview that I just _____ and couldn't answer their questions properly.","choices":["bear up under","be on","bear up","blank out"]},{"term":"bleed out","prompt":"They _____ their calves.","choices":["bleed out","boil over","blow away","big up"]},{"term":"bliss out","prompt":"I _____ on the beach all week.","choices":["blow away","bliss out","big up","bear up under"]},{"term":"block out","prompt":"It was so unpleasant that I try to _____- otherwise, I'd just be angry all the time.","choices":["boil over","boil up","block out","blow away"]},{"term":"blow away","prompt":"Her first novel _____.","choices":["black out","blow away","big up","blank out"]},{"term":"boil over","prompt":"The tension had been building up and it _____ in the meeting.","choices":["blow away","boil over","ache for","block out"]},{"term":"boil up","prompt":"The anger _____ in me when I saw what they had done.","choices":["bear up under","black out","boil up","be on"]}]},{"id":"phrasal-verbs-v1-lesson-073","title":"Bài 73: Sức khỏe và cảm xúc · bottle–chicken","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (bottle–chicken).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"bottle away","prompt":"He kept his feelings _____.","choices":["check up","care for","bottle away","chew off"]},{"term":"bottle out","prompt":"She was going to tell her boss exactly what she thought, but _____ in the end.","choices":["bring back","bubble over","bottle out","bring on"]},{"term":"bottle up","prompt":"She _____ her feelings even though she was furious with them and kept quiet.","choices":["bubble over","bottle up","bring on","burn off"]},{"term":"bowl over","prompt":"I was _____ by the news.","choices":["carried away","bowl over","care for","burn off"]},{"term":"brace up","prompt":"You should _____ and stop worrying.","choices":["brace up","care for","carried away","chew off"]},{"term":"break out in","prompt":"The measles caused me to _____ a rash.","choices":["buoy up","break out in","bulk up","burn off"]},{"term":"brighten up","prompt":"We tried to _____ by painting it.","choices":["break out in","brighten up","bring back","bring on"]},{"term":"bring back","prompt":"Visiting my old school _____ memories of when I was a pupil there.","choices":["bring back","bottle away","bottle out","chicken out"]},{"term":"bring on","prompt":"Stress can often _____ a bad headache.","choices":["bubble over","buck up","bring on","brighten up"]},{"term":"bubble over","prompt":"She _____ with joy when she heard her exam results.","choices":["bubble over","break out in","bottle up","brace up"]},{"term":"buck up","prompt":"You had better _____, or you'll fail the course.","choices":["bottle away","chicken out","buck up","chew off"]},{"term":"bulk up","prompt":"He's _____ a lot since he got those steroids.","choices":["bubble over","care for","burn off","bulk up"]},{"term":"buoy up","prompt":"After so much criticism, the positive review _____.","choices":["carried away","buoy up","care for","burn off"]},{"term":"burn off","prompt":"I _____ a lot of calories in the gym.","choices":["carried away","care for","burn off","check up"]},{"term":"care for","prompt":"I don't _____ fizzy drinks; I prefer water.","choices":["burn off","bulk up","buoy up","care for"]},{"term":"carried away","prompt":"The crowd got _____ by the loud music.","choices":["carried away","chicken out","check up","chew off"]},{"term":"check up","prompt":"The doctor asked me to come back next month for a quick _____.","choices":["bring back","check up","bring on","break out in"]},{"term":"chew off","prompt":"The dog _____ the man's face.","choices":["check up","bottle away","chicken out","chew off"]},{"term":"chicken out","prompt":"I _____ of the bungee jumping when I saw how high it was.","choices":["bubble over","chicken out","bring on","bring back"]}]},{"id":"phrasal-verbs-v1-lesson-074","title":"Bài 74: Sức khỏe và cảm xúc · chill–damp","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (chill–damp).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"chill out","prompt":"I'm staying at home and _____ this evening.","choices":["chill out","come around","cling to","choke up"]},{"term":"choke up","prompt":"He _____ on the bat and hit the ball better.","choices":["come to","cool down","choke up","come over"]},{"term":"cling to","prompt":"They _____ their old way of thinking.","choices":["cut down on","damp down","chill out","cling to"]},{"term":"come around","prompt":"It took several hours after the operation before he _____.","choices":["cool off","come around","conjure up","cool down"]},{"term":"come down with","prompt":"She _____ a virus.","choices":["come down with","cry out","cut down on","creep over"]},{"term":"come out in","prompt":"She _____ a nasty rash after touching the poisonous plant by mistake.","choices":["cool off","cool down","conjure up","come out in"]},{"term":"come over","prompt":"I'm sorry about last night - I don't know what _____ me.","choices":["come over","creep into","creep out","cozy up"]},{"term":"come to","prompt":"She _____ an hour after the operation.","choices":["cool off","conjure up","cool down","come to"]},{"term":"conjure up","prompt":"It _____ memories of my school days.","choices":["cope with","creep into","conjure up","cool off"]},{"term":"cool down","prompt":"It took me ages to _____ after the argument.","choices":["come over","come out in","cool down","come down with"]},{"term":"cool off","prompt":"We’ll talk to Fred once he _____ and can talk rationally.","choices":["cut down on","chill out","cool off","damp down"]},{"term":"cope with","prompt":"She found it hard to _____ the high stress of exam season.","choices":["come to","cope with","come over","conjure up"]},{"term":"cozy up","prompt":"It was cold and I _____ by the fire.","choices":["come around","come down with","cling to","cozy up"]},{"term":"creep into","prompt":"An angry tone _____ her voice.","choices":["cling to","creep into","come around","come down with"]},{"term":"creep out","prompt":"He _____ when he gets drunk.","choices":["creep out","cozy up","cope with","cut down on"]},{"term":"creep over","prompt":"Fear _____ me as I walked through the graveyard.","choices":["cry out","creep over","cut down on","damp down"]},{"term":"cry out","prompt":"He _____ when he dropped the box on his toes.","choices":["cool down","cry out","come to","conjure up"]},{"term":"cut down on","prompt":"Doctors advised her to _____ the amount of saturated fats in her diet.","choices":["creep into","creep over","cut down on","creep out"]},{"term":"damp down","prompt":"They tried to _____ the anger over the announcement.","choices":["damp down","come around","choke up","cling to"]}]},{"id":"phrasal-verbs-v1-lesson-075","title":"Bài 75: Sức khỏe và cảm xúc · die–fire","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (die–fire).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"die away","prompt":"The last notes _____ and the audience burst into applause.","choices":["face up to","die away","ease up","ease off"]},{"term":"die down","prompt":"It was on the front pages of all the papers for a few days, but the interest gradually _____.","choices":["eat away","ease off","ease up","die down"]},{"term":"die for","prompt":"I'm _____ the weekend- this week's been so hard.","choices":["ease up","die for","ease off","dwell on"]},{"term":"disagree with","prompt":"I feel dreadful; the prawns I had for lunch are _____ me.","choices":["disagree with","die down","die away","fire up"]},{"term":"do in","prompt":"After he reported the gang, he feared they would _____.","choices":["fall about","do in","fall apart","face up to"]},{"term":"double over","prompt":"She _____ in pain after being hit in the stomach.","choices":["double over","feed up","fight back","feel up to"]},{"term":"dwell on","prompt":"The programme _____ little other than the scandal.","choices":["ease up","ebb away","dwell on","eat away"]},{"term":"ease off","prompt":"She _____ the accelerator to let the car slow down.","choices":["ease off","face up to","ebb away","eat away"]},{"term":"ease up","prompt":"She asked her teacher to _____ because she was feeling very stressed.","choices":["ebb away","eat away","ease up","dwell on"]},{"term":"eat away","prompt":"The disease _____.","choices":["fire up","die down","eat away","die for"]},{"term":"ebb away","prompt":"His life slowly _____ as the illness progressed.","choices":["die down","die for","ebb away","disagree with"]},{"term":"face up to","prompt":"Many people find it hard to _____ the fact that they are getting old.","choices":["die down","face up to","die for","die away"]},{"term":"fall about","prompt":"We _____ when we heard what she'd done.","choices":["eat away","fall about","ease up","ease off"]},{"term":"fall apart","prompt":"He _____ when they sacked him.","choices":["dwell on","ease off","ease up","fall apart"]},{"term":"feed up","prompt":"She's been ill for a fortnight so we're _____.","choices":["fall about","fall apart","feed up","feel up to"]},{"term":"feel up to","prompt":"I'm so tired. I don't think I _____ going out tonight.","choices":["die down","die for","disagree with","feel up to"]},{"term":"fight back","prompt":"She tried to _____ her anger during the meeting.","choices":["face up to","ebb away","fall about","fight back"]},{"term":"fire up","prompt":"Everyone was _____ and desperate to get it finished in time.","choices":["die away","fire up","die for","die down"]}]},{"id":"phrasal-verbs-v1-lesson-076","title":"Bài 76: Sức khỏe và cảm xúc · flake–gnaw","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (flake–gnaw).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"flake out","prompt":"I worked till midnight then _____.","choices":["flake out","get down","gag for","get it off"]},{"term":"flame up","prompt":"The wood _____ in the fire.","choices":["flake out","flare out","flame up","gnaw at"]},{"term":"flare out","prompt":"He _____ when he saw the dreadful report.","choices":["get it off","flare out","get down","get it off with"]},{"term":"flare up","prompt":"The argument _____ when he was rude to them.","choices":["fly into","freak out","flare up","gag for"]},{"term":"fly into","prompt":"He _____ a rage.","choices":["fly into","flare out","flame up","flake out"]},{"term":"freak out","prompt":"She _____ completely when she didn't get the grades to get into university.","choices":["freak out","ginger up","get off with","give up on"]},{"term":"gag for","prompt":"I'm _____ a drink.","choices":["flame up","flare out","flare up","gag for"]},{"term":"get down","prompt":"The miserable weather in winter really _____.","choices":["give up on","gnaw at","ginger up","get down"]},{"term":"get it off","prompt":"They _____ at the party.","choices":["get it off","give up on","gnaw at","ginger up"]},{"term":"get it off with","prompt":"She _____ her friend's husband.","choices":["get it off with","give up on","gnaw at","ginger up"]},{"term":"get it on","prompt":"The talk was dull and nobody _____.","choices":["flake out","ginger up","get it on","gnaw at"]},{"term":"get it on with","prompt":"Did you _____ him?","choices":["give up on","gnaw at","get it on with","ginger up"]},{"term":"get it up","prompt":"He couldn't _____ and felt very embarrassed.","choices":["give up on","get it up","flake out","gnaw at"]},{"term":"get off on","prompt":"He _____ crystal meth every night.","choices":["get off on","ginger up","freak out","gag for"]},{"term":"get off with","prompt":"He _____ her at the party.","choices":["flare out","flame up","flake out","get off with"]},{"term":"ginger up","prompt":"They tried to _____ the party to stop people leaving.","choices":["flake out","fly into","flare out","ginger up"]},{"term":"give up on","prompt":"I _____ them when I heard what they were saying about me behind my back.","choices":["get off with","give up on","gnaw at","ginger up"]},{"term":"gnaw at","prompt":"I know it was wrong and guilt has _____ me ever since I did it.","choices":["get it off with","gnaw at","get it on","get it on with"]}]},{"id":"phrasal-verbs-v1-lesson-077","title":"Bài 77: Sức khỏe và cảm xúc · gnaw–hold","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (gnaw–hold).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"gnaw away at","prompt":"Their behaviour _____ our trust in them.","choices":["hate on","have it in for","gnaw away at","have against"]},{"term":"go down on","prompt":"He _____ her.","choices":["hold against","grind down","gnaw away at","go down on"]},{"term":"go in","prompt":"He _____ for a triple bypass operation two days ago.","choices":["hold against","hit up on","gnaw away at","go in"]},{"term":"go under","prompt":"She _____ a few minutes after they administered the anaesthetic.","choices":["hold against","grind down","gnaw away at","go under"]},{"term":"grind down","prompt":"The long work hours _____ his energy.","choices":["hold against","have it in for","grind down","hit up on"]},{"term":"grow back","prompt":"Nails _____ quickly after you cut them.","choices":["grow back","hate on","hanker after","hanker for"]},{"term":"grow on","prompt":"The plans sounded strange at first, but they have _____ me.","choices":["go under","hack off","grind down","grow on"]},{"term":"grow to","prompt":"We _____ like the neighbourhood.","choices":["hanker for","hate on","grow to","hanker after"]},{"term":"grow upon","prompt":"As we got nearer the date of the meeting, their idea _____ me.","choices":["hang over","hack off","hanker after","grow upon"]},{"term":"hack off","prompt":"He _____ with his endless complaining.","choices":["go down on","gnaw away at","hold against","hack off"]},{"term":"hang over","prompt":"I have a lot of financial problem _____ my head.","choices":["hang over","hold against","go down on","gnaw away at"]},{"term":"hanker after","prompt":"I'm supposed to be on a diet and I can't stop _____ some chocolate.","choices":["hanker after","hit up on","have it in for","have against"]},{"term":"hanker for","prompt":"I have always _____ a soft- top car.","choices":["grow to","hanker for","grow back","grow on"]},{"term":"hate on","prompt":"She _____ people who disagree with her ideas.","choices":["grow to","hate on","grow back","grind down"]},{"term":"have against","prompt":"I _____ their proposals.","choices":["have against","hit up on","gnaw away at","go down on"]},{"term":"have it in for","prompt":"He has _____ me since I beat him last year.","choices":["have it in for","hit up on","hold against","hate on"]},{"term":"hit up on","prompt":"He's been _____ heroin for years.","choices":["grind down","grow to","grow back","hit up on"]},{"term":"hold against","prompt":"He was very rude, but I won't _____ him.","choices":["hack off","grow to","hold against","grow upon"]}]},{"id":"phrasal-verbs-v1-lesson-078","title":"Bài 78: Sức khỏe và cảm xúc · hold–load","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (hold–load).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"hold back from","prompt":"I had to _____ losing my temper with them.","choices":["key up","key down","hold back from","kick in"]},{"term":"jump at","prompt":"I'd _____ the chance to go and live in Japan.","choices":["live down","jump at","limber up","lighten up"]},{"term":"keel over","prompt":"He was going to confront his boss, but _____ and didn't mention the matter.","choices":["hold back from","jump at","keep down","keel over"]},{"term":"keep down","prompt":"The food was so horrible that I struggled to _____.","choices":["keep down","load up","live through","live with"]},{"term":"keep from","prompt":"I couldn't _____ arguing with her.","choices":["key down","keel over","jump at","keep from"]},{"term":"key down","prompt":"I need to _____ before I go to bed.","choices":["jump at","hold back from","key down","keel over"]},{"term":"key up","prompt":"The noise got us _____.","choices":["kick in","keep down","keep from","key up"]},{"term":"kick in","prompt":"Wait a few minutes for the medicine to _____.","choices":["kick in","keep down","keel over","keep from"]},{"term":"kick up","prompt":"My back _____ when it gets cold.","choices":["live with","hold back from","kick up","jump at"]},{"term":"laugh off","prompt":"He _____ the sprained finger but it obviously affected his golf game.","choices":["laugh off","limber up","lighten up","leap out at"]},{"term":"leap at","prompt":"He _____ the chance to visit.","choices":["leap at","key up","kick up","kick in"]},{"term":"leap out at","prompt":"The bright red sign will _____ you.","choices":["key down","keep from","leap out at","key up"]},{"term":"lighten up","prompt":"I told them to _____ but they continued complaining about it.","choices":["laugh off","kick in","lighten up","key down"]},{"term":"limber up","prompt":"The team _____ for a few minutes before the game started.","choices":["kick in","laugh off","key down","limber up"]},{"term":"live down","prompt":"If I fail the test and everyone else passes, I'll never be able to _____.","choices":["leap out at","leap at","laugh off","live down"]},{"term":"live through","prompt":"It was hard to _____ the recession, but we managed it.","choices":["key up","live through","kick in","kick up"]},{"term":"live with","prompt":"It's hard to _____ the pain of a serious illness.","choices":["leap at","laugh off","leap out at","live with"]},{"term":"load up","prompt":"He's been _____ for years.","choices":["hold back from","load up","jump at","live with"]}]},{"id":"phrasal-verbs-v1-lesson-079","title":"Bài 79: Sức khỏe và cảm xúc · look–play","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (look–play).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"look forward to","prompt":"I'm _____ meeting you.","choices":["pine away","pile on","look forward to","perk up"]},{"term":"loosen up","prompt":"He was very shy at first but has _____ and is more talkative now.","choices":["play up to","loosen up","play upon","pine away"]},{"term":"lust after","prompt":"He secretly _____ his friend’s wife.","choices":["play upon","look forward to","loosen up","lust after"]},{"term":"man up","prompt":"She told her anonymous critics to _____ and speak publicly.","choices":["mope about","lust after","man up","look forward to"]},{"term":"mess up","prompt":"He took a lot of lsd and it really _____.","choices":["lust after","look forward to","mess up","mope about"]},{"term":"mope about","prompt":"She didn't get the job and has been _____ all afternoon.","choices":["mope about","play upon","play up","play up to"]},{"term":"mope around","prompt":"He's been _____ since his girlfriend left him.","choices":["pile on","mope around","play up","pine away"]},{"term":"operate on","prompt":"She was _____ for eight hours.","choices":["operate on","pass out","pass away","patch up"]},{"term":"pass away","prompt":"Sadly, Georgia's uncle _____ yesterday after a short illness.","choices":["lust after","look forward to","pass away","loosen up"]},{"term":"pass out","prompt":"He got so drunk that he _____.","choices":["mope around","operate on","pass out","patch up"]},{"term":"patch up","prompt":"After the accident, they _____ and sent her to hospital.","choices":["lust after","patch up","mope about","look forward to"]},{"term":"pep up","prompt":"You need to _____.","choices":["pep up","pass out","operate on","pass away"]},{"term":"perk up","prompt":"She was ill in bed with flu, but she _____ a bit when some friends dropped by.","choices":["pass away","operate on","mope around","perk up"]},{"term":"pile on","prompt":"It wasn't very serious, but they _____ the guilt.","choices":["pile on","loosen up","lust after","look forward to"]},{"term":"pine away","prompt":"He's been _____ since his wife died and is a shadow of his former self.","choices":["man up","pine away","mess up","mope about"]},{"term":"play up","prompt":"The children _____ all evening and drove the babysitter mad.","choices":["pile on","play up","pine away","look forward to"]},{"term":"play up to","prompt":"He's got a reputation for being trouble and _____ it.","choices":["play up to","pass away","pass out","operate on"]},{"term":"play upon","prompt":"They are _____ people's concerns to get their way.","choices":["play upon","man up","mope about","mess up"]}]},{"id":"phrasal-verbs-v1-lesson-080","title":"Bài 80: Sức khỏe và cảm xúc · pluck–slough","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (pluck–slough).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"pluck at","prompt":"He was _____ his cuffs during the interview.","choices":["pucker up","pluck at","psych up","poop out"]},{"term":"pluck up","prompt":"They _____ the courage to complain.","choices":["root for","room in","pluck up","quieten down"]},{"term":"poop out","prompt":"I was going to write my essay, but I _____ and went to bed instead.","choices":["slough off","sleep off","sink in","poop out"]},{"term":"psych up","prompt":"I _____ for the exam.","choices":["psych up","pull through","pull down","poop out"]},{"term":"pucker up","prompt":"She _____ when he leant forwards to kiss her.","choices":["pucker up","root for","room in","shake off"]},{"term":"pull down","prompt":"Losing her job _____.","choices":["slough off","sleep off","pluck at","pull down"]},{"term":"pull through","prompt":"At one stage it looked as if she was going to die, but she _____ in the end.","choices":["pluck up","poop out","psych up","pull through"]},{"term":"quieten down","prompt":"The audience _____ when the lights were switched off in the auditorium and the play was ready to begin.","choices":["quieten down","shake off","room in","root for"]},{"term":"room in","prompt":"Nowadays, most hospitals have a policy of _____ mothers and their babies.","choices":["sleep off","room in","slough off","pluck at"]},{"term":"root for","prompt":"Everyone was _____ Arsenal to win the Champions League.","choices":["poop out","pucker up","psych up","root for"]},{"term":"shake off","prompt":"It took me ages to _____ the cough.","choices":["shake off","pucker up","pull through","pull down"]},{"term":"shoot up","prompt":"The heroin-user would _____ in shop doorways.","choices":["shoot up","sink in","shy away from","simmer down"]},{"term":"show through","prompt":"His anger _____ despite his smile.","choices":["quieten down","room in","show through","pull down"]},{"term":"shy away from","prompt":"Many learners _____ using phrasal verbs.","choices":["pluck up","pluck at","slough off","shy away from"]},{"term":"simmer down","prompt":"He told them to _____ because they were disturbing the class next door.","choices":["root for","simmer down","pull through","room in"]},{"term":"sink in","prompt":"The truth finally _____ about her death when it was broadcast on TV.","choices":["psych up","pull down","pucker up","sink in"]},{"term":"sleep off","prompt":"She went to bed to _____ the effects of the tequila.","choices":["shoot up","sleep off","shy away from","show through"]},{"term":"slough off","prompt":"He _____ the pain and continued running.","choices":["slough off","psych up","poop out","pucker up"]}]},{"id":"phrasal-verbs-v1-lesson-081","title":"Bài 81: Sức khỏe và cảm xúc · sniff–walk","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (sniff–walk).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"sniff at","prompt":"A job opportunity like that is not to be _____.","choices":["sniff at","tear into","turn against","tire out"]},{"term":"sober up","prompt":"Keith _____ a bit when we left the pub and walked home.","choices":["turn against","tire out","walk off","sober up"]},{"term":"spew up","prompt":"He _____ when he was drunk.","choices":["stick it to","spew up","take it out on","stomp on"]},{"term":"spoil for","prompt":"He's been _____ an argument all day.","choices":["tire out","tear into","spoil for","tear at"]},{"term":"start up","prompt":"He _____ when I entered the room and tried to hide what he was doing.","choices":["tear apart","take it out on","stomp on","start up"]},{"term":"stave off","prompt":"The medicine _____ the worst of the disease.","choices":["turn against","sniff at","stave off","tire out"]},{"term":"steal over","prompt":"A feeling of pride _____ me as I watched.","choices":["take it out on","swell up","tear apart","steal over"]},{"term":"stick it to","prompt":"My boss always _____ me when she's in a bad mood.","choices":["swell up","summon up","stick it to","stomp on"]},{"term":"stomp on","prompt":"They _____ their competitors.","choices":["tear into","tear at","tear apart","stomp on"]},{"term":"summon up","prompt":"Andrea couldn't _____ the enthusiasm to apply for the position.","choices":["spoil for","walk off","sniff at","summon up"]},{"term":"swell up","prompt":"His ankle _____ immediately after he twisted it during soccer.","choices":["stave off","swell up","steal over","spoil for"]},{"term":"take it out on","prompt":"Do not _____ your sister.","choices":["start up","spew up","take it out on","spoil for"]},{"term":"tear apart","prompt":"People were _____ when news of the train crash came through.","choices":["take it out on","summon up","tear apart","swell up"]},{"term":"tear at","prompt":"The fighters _____ each other.","choices":["tear at","steal over","stick it to","stomp on"]},{"term":"tear into","prompt":"She _____ me for losing it.","choices":["walk off","tire out","tear into","turn against"]},{"term":"tire out","prompt":"Working so much _____.","choices":["tire out","walk off","sniff at","sober up"]},{"term":"turn against","prompt":"The public _____ the government when they became arrogant and ceased to listen.","choices":["swell up","take it out on","summon up","turn against"]},{"term":"walk off","prompt":"I tried to _____ my hangover.","choices":["start up","walk off","steal over","spoil for"]}]},{"id":"phrasal-verbs-v1-lesson-082","title":"Bài 82: Sức khỏe và cảm xúc · warm–zonk","focus":"Sức khỏe, cảm xúc và cách phản ứng. Các cụm được xếp theo động từ gốc (warm–zonk).","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","questions":[{"term":"warm up","prompt":"The team _____ half an hour before the volleyball match.","choices":["warm up","zone out","work through","zonk out"]},{"term":"wash down","prompt":"I _____ with a glass of water.","choices":["work off","work through","wash down","zone out"]},{"term":"wash over","prompt":"He felt numb as grief _____ him.","choices":["warm up","waste away","wean off","wash over"]},{"term":"waste away","prompt":"He _____ as the cancer got worse.","choices":["wimp out","well up","waste away","weird out"]},{"term":"wean off","prompt":"We will have to _____ his obsession.","choices":["wean off","weigh down on","weigh on","weird out"]},{"term":"wear down","prompt":"The stress of my job is _____.","choices":["wind up","wimp out","wear down","well up"]},{"term":"wear off","prompt":"The anaesthetic _____ and my tooth started hurting.","choices":["wind down","wear off","wimp out","wind up"]},{"term":"weigh down on","prompt":"The requirements of her new job _____ her.","choices":["weigh down on","wear off","well up","weird out"]},{"term":"weigh on","prompt":"The issues raised _____ her mind.","choices":["well up","weigh on","wind down","wimp out"]},{"term":"weird out","prompt":"The way he spoke was _____.","choices":["weird out","work off","wind up","wind down"]},{"term":"well up","prompt":"Tears _____ when I heard they had died.","choices":["zone out","well up","work off","work through"]},{"term":"wimp out","prompt":"I was going to have the hottest curry on the menu, but I _____ and had a mild lamb Korma instead.","choices":["wash down","warm up","wimp out","wash over"]},{"term":"wind down","prompt":"I'm going to _____ in the country this weekend and do nothing.","choices":["wean off","wear off","wind down","waste away"]},{"term":"wind up","prompt":"Stop trying to _____ your older brother.","choices":["waste away","wind up","wean off","wash over"]},{"term":"work off","prompt":"She goes to the gym to _____ her anger.","choices":["weigh on","work off","weigh down on","wear down"]},{"term":"work through","prompt":"It took him a long time to _____ his anger after he lost his job.","choices":["zonk out","wash down","work through","warm up"]},{"term":"zone out","prompt":"I put some ambient music on and _____.","choices":["work through","wind up","work off","zone out"]},{"term":"zonk out","prompt":"I _____ during the film and missed most of it.","choices":["warm up","wash down","work through","zonk out"]}]},{"id":"phrasal-verbs-v1-lesson-083","title":"Bài 83: Quy tắc và an toàn · abide–charge","focus":"Quy định, pháp luật, nguy hiểm và bảo vệ. Các cụm được xếp theo động từ gốc (abide–charge).","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","questions":[{"term":"abide by","prompt":"We have to _____ what the court says.","choices":["blaze away","belt up","abide by","board up"]},{"term":"barge in","prompt":"He keeps _____ and asking stupid questions when I'm trying to work.","choices":["cast out","burn up","barge in","charge with"]},{"term":"bash in","prompt":"The burglars _____ to enter the house.","choices":["bump off","burn down","buckle up","bash in"]},{"term":"bash up","prompt":"They _____ in the fight in the pub last week and he had to go to hospital.","choices":["cast out","bash up","charge with","burn down"]},{"term":"be after","prompt":"The police _____ him because of the theft.","choices":["bump off","be after","buckle up","burn down"]},{"term":"beat up","prompt":"The mugger _____ and stole his wallet.","choices":["break out","blaze away","break into","beat up"]},{"term":"beef up","prompt":"They need to _____ their security system now.","choices":["bring down","bump off","beef up","break through"]},{"term":"belt up","prompt":"I told the kids to _____ before I started the car.","choices":["bring down","burn down","belt up","bump off"]},{"term":"blaze away","prompt":"The shooters _____ at the pheasants.","choices":["bump off","burn up","blaze away","burn down"]},{"term":"board up","prompt":"They _____ all the windows to stop people getting into the empty houses.","choices":["break into","be after","board up","blaze away"]},{"term":"break into","prompt":"Burglar alarms sounded immediately when intruders tried to _____ the gallery.","choices":["charge with","cast out","break into","abide by"]},{"term":"break out","prompt":"They're worried that war will _____.","choices":["bump off","bring down","break out","buckle up"]},{"term":"break through","prompt":"The crowd _____ the police barriers and attacked the hunters.","choices":["buckle up","break through","bring down","board up"]},{"term":"bring down","prompt":"The vote of no-confidence _____.","choices":["bring down","bump off","burn up","buckle up"]},{"term":"buckle up","prompt":"We were told to _____ before take-off.","choices":["break out","break into","buckle up","blaze away"]},{"term":"bump off","prompt":"The drug dealer was _____ by a rival gang.","choices":["barge in","abide by","bash in","bump off"]},{"term":"burn down","prompt":"They had to completely rebuild the museum after the old one _____.","choices":["bump off","burn down","buckle up","break through"]},{"term":"burn up","prompt":"All his possessions were _____ in the fire.","choices":["barge in","burn up","bash in","be after"]},{"term":"cast out","prompt":"They will _____ anyone who breaks the rules.","choices":["beef up","belt up","cast out","blaze away"]},{"term":"charge with","prompt":"She was arrested in customs last night and has been _____ smuggling.","choices":["bump off","burn up","burn down","charge with"]}]},{"id":"phrasal-verbs-v1-lesson-084","title":"Bài 84: Quy tắc và an toàn · chase–frown","focus":"Quy định, pháp luật, nguy hiểm và bảo vệ. Các cụm được xếp theo động từ gốc (chase–frown).","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","questions":[{"term":"chase off","prompt":"The dog _____.","choices":["fess up to","chase off","fence in","feel up"]},{"term":"clamp down on","prompt":"The government are _____ antisocial behaviour.","choices":["front for","chase off","frighten off","clamp down on"]},{"term":"cover up","prompt":"They tried to _____ the incident but it got into the newspapers.","choices":["fight off","file for","cover up","fool with"]},{"term":"crack down on","prompt":"The police always _____ drink-driving offences over the Christmas period.","choices":["frighten off","front for","frighten away","crack down on"]},{"term":"cut in","prompt":"We had to _____ on the deal to avoid trouble.","choices":["feel up","duff up","fall under","cut in"]},{"term":"do away with","prompt":"The United Kingdom _____ the death penalty in 1965.","choices":["do away with","front for","frown on","chase off"]},{"term":"duff up","prompt":"He was _____ in a night club last night.","choices":["cut in","duff up","crack down on","do away with"]},{"term":"fall under","prompt":"At first he was independent, but then he _____ their influence.","choices":["duff up","fence in","feel up","fall under"]},{"term":"feel up","prompt":"Someone _____ in the club as I was trying to get to the bar.","choices":["do away with","feel up","cut in","crack down on"]},{"term":"fence in","prompt":"They _____.","choices":["cover up","fence in","clamp down on","crack down on"]},{"term":"fence off","prompt":"They _____ one side of the park to keep dogs out.","choices":["do away with","crack down on","cut in","fence off"]},{"term":"fend off","prompt":"He managed to _____ the criticism in the press.","choices":["front for","fool with","frighten away","fend off"]},{"term":"fess up to","prompt":"They _____ the crime.","choices":["fess up to","clamp down on","chase off","cover up"]},{"term":"fight off","prompt":"The old lady managed to _____ and they didn't get her purse.","choices":["fight off","fess up to","fence in","feel up"]},{"term":"file for","prompt":"They _____ divorce after two years of marriage.","choices":["duff up","do away with","file for","cut in"]},{"term":"fool with","prompt":"Don't _____ that—it could explode.","choices":["front for","frighten away","frighten off","fool with"]},{"term":"frighten away","prompt":"The strikes _____.","choices":["frighten away","front for","frown on","chase off"]},{"term":"frighten off","prompt":"The crash in share prices _____.","choices":["cover up","clamp down on","frighten off","frown on"]},{"term":"front for","prompt":"The solicitor _____ a number of criminal gangs.","choices":["frighten away","fool with","front for","frighten off"]},{"term":"frown on","prompt":"He _____ people making personal calls at work.","choices":["frighten away","frown on","frighten off","front for"]}]},{"id":"phrasal-verbs-v1-lesson-085","title":"Bài 85: Quy tắc và an toàn · get–kill","focus":"Quy định, pháp luật, nguy hiểm và bảo vệ. Các cụm được xếp theo động từ gốc (get–kill).","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","questions":[{"term":"get at","prompt":"The gangsters _____ the jury, who found them not guilty of all charges despite the evidence presented in court.","choices":["get at","go through","give in","give off"]},{"term":"get away with","prompt":"Do you think we could _____ using the cheaper product?","choices":["keep away","get away with","hush up","hunt down"]},{"term":"get up to","prompt":"The children are always _____ some trouble or other.","choices":["keep away","get up to","hunt down","hush up"]},{"term":"give in","prompt":"They _____ their complaint to the court.","choices":["give in","grass up","grass on","go through"]},{"term":"give off","prompt":"The police stopped the van because it was _____ a lot of black smoke.","choices":["keep out","get at","give off","kick out"]},{"term":"go through","prompt":"My divorce _____ last week.","choices":["go through","keep away","hush up","keep back"]},{"term":"grass on","prompt":"He _____ us and got us into a lot of trouble.","choices":["get up to","give in","grass on","give off"]},{"term":"grass up","prompt":"She didn't to _____, even though they'd been bullying her badly.","choices":["hold off","hold down","hold out against","grass up"]},{"term":"have to","prompt":"We _____ leave for the airport soon.","choices":["hold out against","hold off","have to","hold down"]},{"term":"have up","prompt":"They _____ for armed robbery.","choices":["get at","get away with","have up","get up to"]},{"term":"hold down","prompt":"It took four of us to _____ and stop the fight.","choices":["have up","have to","hold down","hush up"]},{"term":"hold off","prompt":"Chelsea couldn't _____ and lost the game.","choices":["hush up","keep away","hunt down","hold off"]},{"term":"hold out against","prompt":"The staff are _____ the plans to reduce the workforce.","choices":["have up","have to","hold out against","grass up"]},{"term":"hunt down","prompt":"The police _____.","choices":["give off","grass on","hunt down","go through"]},{"term":"hush up","prompt":"The company tried to _____ the scandal, but it still got into the newspapers.","choices":["kick out","hush up","get at","kill off"]},{"term":"keep away","prompt":"Medicines should always be _____ from children.","choices":["give off","give in","get up to","keep away"]},{"term":"keep back","prompt":"The police told the crowd to _____ from the fire.","choices":["kill off","get away with","keep back","get at"]},{"term":"keep out","prompt":"The police _____ of the building.","choices":["hold out against","hush up","hunt down","keep out"]},{"term":"kick out","prompt":"They had to _____ the rude guest immediately.","choices":["get at","kick out","kill off","get away with"]},{"term":"kill off","prompt":"There used to be a lot of wolves around here, but most of them have been _____.","choices":["hold out against","hunt down","hush up","kill off"]}]},{"id":"phrasal-verbs-v1-lesson-086","title":"Bài 86: Quy tắc và an toàn · knock–push","focus":"Quy định, pháp luật, nguy hiểm và bảo vệ. Các cụm được xếp theo động từ gốc (knock–push).","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","questions":[{"term":"knock about","prompt":"He _____ after they argued.","choices":["push in","pull in","lash down","knock about"]},{"term":"knock down","prompt":"The car _____ and she broke her arm.","choices":["knock down","push in","plead out","pull in"]},{"term":"lash down","prompt":"We _____ to stop the wind blowing it away.","choices":["mop up","mete out","make off with","lash down"]},{"term":"lay down","prompt":"The rules of the sport were _____ early in the nineteenth century.","choices":["lock in","lay down","look out","look out for"]},{"term":"let off","prompt":"The judge _____ with a fine rather than a prison sentence since it was his first offence.","choices":["make off with","mop up","let off","mete out"]},{"term":"let out","prompt":"The convict was _____ of prison after serving five years of an eight-year sentence.","choices":["push in","let out","knock about","pull in"]},{"term":"lock away","prompt":"He _____ in a drawer.","choices":["lock away","look out for","look out","make away with"]},{"term":"lock in","prompt":"They _____ the room until he had calmed down.","choices":["lock in","let out","look out","look out for"]},{"term":"look out","prompt":"_____; you're going to drop that!","choices":["lock in","lock away","look out","make away with"]},{"term":"look out for","prompt":"She _____ her sister when she started school.","choices":["make away with","look out for","mete out","make off with"]},{"term":"make away with","prompt":"The thieves _____ the painting.","choices":["make away with","lash down","lay down","knock down"]},{"term":"make off with","prompt":"Thieves _____ over a million dollars in the robbery.","choices":["pull in","make off with","knock about","push in"]},{"term":"mete out","prompt":"They _____ savage penalties to anyone who broke the law.","choices":["push in","pull in","mete out","pin on"]},{"term":"mop up","prompt":"After the battle, it took them a couple of weeks to _____ the remaining rebels.","choices":["mop up","lock away","let out","let off"]},{"term":"opt out","prompt":"The UK _____ of a lot of EU legislation on working hours and conditions.","choices":["lock away","opt out","look out for","lock in"]},{"term":"pick off","prompt":"There were many rebels against the policy, but the government _____ the leaders.","choices":["let out","pick off","lock away","lock in"]},{"term":"pin on","prompt":"The police tried to _____ him.","choices":["opt out","pin on","mop up","pick off"]},{"term":"plead out","prompt":"The CEO _____ and blamed the cfo for the fraud.","choices":["lock in","lock away","plead out","look out for"]},{"term":"pull in","prompt":"The police _____ after the trouble.","choices":["lock away","let out","look out","pull in"]},{"term":"push in","prompt":"She just _____ the queue in front of me at the supermarket checkout.","choices":["push in","look out for","look out","make away with"]}]},{"id":"phrasal-verbs-v1-lesson-087","title":"Bài 87: Quy tắc và an toàn · rope–stamp","focus":"Quy định, pháp luật, nguy hiểm và bảo vệ. Các cụm được xếp theo động từ gốc (rope–stamp).","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","questions":[{"term":"rope off","prompt":"The celebrity entrance was _____ from the general public.","choices":["set aside","send in","rope off","set on"]},{"term":"rough up","prompt":"The mugger _____ when he refused to hand his wallet over.","choices":["set upon","shake down","rough up","shut away"]},{"term":"run up on","prompt":"Robert was sitting in his car and a guy _____ him and shot through the car but missed.","choices":["square off against","square up","square off","run up on"]},{"term":"scare away","prompt":"The cat _____.","choices":["send in","set on","scare away","set aside"]},{"term":"send in","prompt":"The police were _____ to quell the riot as the protesters had started burning cars and wrecking shops.","choices":["shake down","set upon","send in","set on"]},{"term":"set aside","prompt":"The Appeal Court _____ the guilty verdict because the evidence was unsatisfactory and declared her not guilty.","choices":["set aside","shake down","shut off","shut away"]},{"term":"set on","prompt":"He was _____ when he left the bar.","choices":["set on","shut away","shut off","shake down"]},{"term":"set upon","prompt":"They _____ her when she was in the car park.","choices":["scare away","run up on","set upon","rough up"]},{"term":"shake down","prompt":"He _____ with some story about needing the money for an operation.","choices":["set upon","shut off","shake down","shut away"]},{"term":"shut away","prompt":"Many people have been _____ in psychiatric hospitals for disagreeing with the government.","choices":["shut away","set on","send in","set aside"]},{"term":"shut off","prompt":"They _____ while they did the repairs.","choices":["sit in","shut off","smoke out","smash down"]},{"term":"sit in","prompt":"The students _____ the Library as a protest against the increase in tuition fees.","choices":["smash down","smoke out","shut off","sit in"]},{"term":"smash down","prompt":"The police _____ to get into the house.","choices":["stamp out","smash down","square off against","square up"]},{"term":"smoke out","prompt":"The police _____ and arrested them.","choices":["shut off","smoke out","smash down","sit in"]},{"term":"snuff out","prompt":"I _____ the candles before I went to bed.","choices":["square off","spirit away","snuff out","square off against"]},{"term":"spirit away","prompt":"They _____ before the police arrived.","choices":["set aside","send in","spirit away","run up on"]},{"term":"square off","prompt":"The two drunks _____ and the barman had to intervene before a fight broke out.","choices":["scare away","send in","square off","set aside"]},{"term":"square off against","prompt":"They _____ the police when they arrived.","choices":["square off against","shut away","shut off","shake down"]},{"term":"square up","prompt":"The companies are _____ for a fight.","choices":["send in","scare away","square up","set aside"]},{"term":"stamp out","prompt":"The government has started a campaign to _____ drugs in schools.","choices":["set aside","set on","send in","stamp out"]}]},{"id":"phrasal-verbs-v1-lesson-088","title":"Bài 88: Quy tắc và an toàn · stand–work","focus":"Quy định, pháp luật, nguy hiểm và bảo vệ. Các cụm được xếp theo động từ gốc (stand–work).","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","questions":[{"term":"stand by","prompt":"Please _____ until the doctor arrives soon.","choices":["stand by","stay away from","stick up","stay away"]},{"term":"stay away","prompt":"He said he didn't like them coming and wanted them to _____.","choices":["trump up","tool up","stay away","tighten up"]},{"term":"stay away from","prompt":"He told them to _____ him.","choices":["stick up","stitch up","stay away from","strike back"]},{"term":"stick up","prompt":"They _____ and stole tens of thousands.","choices":["wipe out","watch out for","watch over","stick up"]},{"term":"stitch up","prompt":"The police _____ because they couldn't find any evidence against them.","choices":["strike back","stay away","stitch up","stay away from"]},{"term":"strike back","prompt":"At first, he ignored them, but when things got very serious, he _____.","choices":["watch out","walk into","strike back","watch out for"]},{"term":"strike down","prompt":"The Appeal Court _____ the lower court's ruling.","choices":["tie up","tool up","tighten up","strike down"]},{"term":"take away","prompt":"The police _____.","choices":["tie down","tighten up","tie up","take away"]},{"term":"tie down","prompt":"The army were _____ with the rebellion and couldn't help.","choices":["tie down","stand by","work over","stay away"]},{"term":"tie up","prompt":"They _____ the hostages so that they couldn't escape.","choices":["strike down","walk in on","tie up","take away"]},{"term":"tighten up","prompt":"They're _____ security for the president's visit.","choices":["strike down","take away","tighten up","strike back"]},{"term":"tool up","prompt":"The gangsters got _____ before they went into the club.","choices":["stay away from","stay away","tool up","stand by"]},{"term":"trump up","prompt":"The police _____ the charges against him and he ended up in prison though he hadn't done it.","choices":["trump up","walk into","walk in on","watch out"]},{"term":"walk in on","prompt":"He _____ them planning to sack him.","choices":["walk in on","tie up","tie down","tighten up"]},{"term":"walk into","prompt":"You _____ that one [You became victim to a trap I set]orI _____ a door and broke my nose.","choices":["stand by","work over","walk into","wipe out"]},{"term":"watch out","prompt":"_____- there's ice on the road.","choices":["walk in on","watch out","walk into","trump up"]},{"term":"watch out for","prompt":"_____ bats in the caves; many have rabies.","choices":["take away","watch out for","tie down","tie up"]},{"term":"watch over","prompt":"The lecturer _____ the students as they did the experiment.","choices":["tool up","trump up","watch over","tighten up"]},{"term":"wipe out","prompt":"A meteor crashing into the planet _____.","choices":["stick up","stitch up","wipe out","stay away from"]},{"term":"work over","prompt":"They _____ and robbed him.","choices":["stitch up","stick up","work over","stay away from"]}]},{"id":"phrasal-verbs-v1-lesson-089","title":"Bài 89: Giải quyết vấn đề · account–boil","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (account–boil).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"account for","prompt":"They had to _____ all the money that had gone missing.","choices":["add up","add up to","bail out","account for"]},{"term":"act on","prompt":"The police were _____ a tip from an informer and caught the gang red- handed.","choices":["act on","ask for","allow for","add up to"]},{"term":"act upon","prompt":"The police were _____ a tip- off.","choices":["add up to","act upon","add up","allow for"]},{"term":"add up","prompt":"She explained why the work wasn't ready, but her story doesn't _____.","choices":["be onto","bank on","add up","bash about"]},{"term":"add up to","prompt":"Trains delays are getting worse and with the high fares, it all _____ misery for the commuters.","choices":["bear on","bitch up","bear out","add up to"]},{"term":"allow for","prompt":"You should _____ delays when planning a journey.","choices":["be onto","allow for","be out to","bear on"]},{"term":"ask for","prompt":"You will _____ trouble if you go there alone.","choices":["bank on","ask for","bang up","balls up"]},{"term":"bail out","prompt":"The boat was leaking so they had to _____.","choices":["block up","bitch up","boil down","bail out"]},{"term":"ball up","prompt":"The new project has _____- I have no idea what to do.","choices":["ball up","bail out","ask for","allow for"]},{"term":"balls up","prompt":"He _____.","choices":["bail out","balls up","ask for","bank on"]},{"term":"bang up","prompt":"He _____ last night.","choices":["act upon","account for","bang up","act on"]},{"term":"bank on","prompt":"I'm _____ your help; I can't do it alone.","choices":["balls up","bang up","ball up","bank on"]},{"term":"bash about","prompt":"If you _____ like that, it won't last long.","choices":["be onto","bang up","bank on","bash about"]},{"term":"be onto","prompt":"He's being very careful because he thinks the police _____ him.","choices":["bear on","bear out","be onto","bash about"]},{"term":"be out to","prompt":"She _____ get him sacked because she hates him.","choices":["bitch up","be out to","boil down","block up"]},{"term":"bear on","prompt":"The judge's character may well _____ the final decision.","choices":["be out to","bash about","bear on","be onto"]},{"term":"bear out","prompt":"Statistics _____ the government's positions on the issue.","choices":["bear out","boil down","bitch up","block up"]},{"term":"bitch up","prompt":"I _____ the interview.","choices":["bank on","bitch up","bash about","be onto"]},{"term":"block up","prompt":"The pipe's _____ and no water gets through.","choices":["bank on","block up","bail out","bash about"]},{"term":"boil down","prompt":"The report's so long, I _____ into a two-page summary.","choices":["ask for","boil down","bail out","allow for"]}]},{"id":"phrasal-verbs-v1-lesson-090","title":"Bài 90: Giải quyết vấn đề · boil–choke","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (boil–choke).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"boil down to","prompt":"It all _____ money at the end of the day.","choices":["chew on","chase down","chew over","boil down to"]},{"term":"bolster up","prompt":"We were all scared but she _____ our courage.","choices":["bolster up","choke out","boil down to","bounce back"]},{"term":"botch up","prompt":"I _____ the whole project and it had to be cancelled.","choices":["bring about","botch up","bounce back","break off"]},{"term":"bounce back","prompt":"The economy is _____ from the recession.","choices":["bounce back","call forth","cast around for","cast about for"]},{"term":"break off","prompt":"She _____ a square of chocolate and gave it to her dog.","choices":["chip away at","boil down to","choke out","break off"]},{"term":"bring about","prompt":"The changes to the law were _____ by the government because so many people were ignoring the old one.","choices":["chew over","chew on","bring about","chase down"]},{"term":"bring off","prompt":"No one thought she'd manage to do it, but she _____ in the end.","choices":["chase down","bring off","chew over","chew on"]},{"term":"buckle under","prompt":"They didn't like the ideas, but had to _____ or face the sack.","choices":["bolster up","buckle under","boil down to","choke out"]},{"term":"call forth","prompt":"The protests _____ a strong reaction from the police.","choices":["break off","botch up","bounce back","call forth"]},{"term":"cast about for","prompt":"They're _____ support.","choices":["cast about for","catch out","call forth","cave in"]},{"term":"cast around for","prompt":"She was _____ people to help her.","choices":["choke off","chip away at","cast around for","chew over"]},{"term":"cast round for","prompt":"He _____ any sign of his things.","choices":["cave in","chase down","chew on","cast round for"]},{"term":"catch out","prompt":"We were _____ in the storm.","choices":["bolster up","botch up","catch out","boil down to"]},{"term":"cave in","prompt":"The government has refused to _____ despite the protests and demonstrations.","choices":["bounce back","cave in","break off","bring about"]},{"term":"chase down","prompt":"The press _____ when the story broke.","choices":["catch out","chase down","cast round for","cave in"]},{"term":"chew on","prompt":"I'll _____ it for a day or two and let you know what I think.","choices":["chew on","break off","bounce back","bring about"]},{"term":"chew over","prompt":"He asked for a few days to _____ before he made a final decision.","choices":["chew over","catch out","chase down","cave in"]},{"term":"chip away at","prompt":"They have been _____ his reputation ever since he took office.","choices":["botch up","boil down to","bolster up","chip away at"]},{"term":"choke off","prompt":"These guerilla attacks are _____ our food shipments.","choices":["choke off","call forth","buckle under","cast about for"]},{"term":"choke out","prompt":"Water hyacinth is _____ the native vegetation in our rivers.","choices":["chip away at","choke out","chew over","chew on"]}]},{"id":"phrasal-verbs-v1-lesson-091","title":"Bài 91: Giải quyết vấn đề · cock–fall","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (cock–fall).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"cock up","prompt":"It was so easy, but he managed to _____.","choices":["count upon","cotton on","count on","cock up"]},{"term":"come into","prompt":"Money doesn't _____ it; I simply will not do it under any circumstances.","choices":["fall back on","fall through","come into","end up with"]},{"term":"come off","prompt":"I picked it up and the handle _____ in my hand.","choices":["creep in","come off","count upon","cross up"]},{"term":"come through with","prompt":"He didn't _____ the money and they went bust.","choices":["come through with","cotton on","count on","count upon"]},{"term":"come up against","prompt":"They will _____ many problems soon.","choices":["decide upon","dig up","come up against","dream up"]},{"term":"come upon","prompt":"I _____ the book in a little second-hand bookshop in Dorset.","choices":["fall through","cock up","come upon","cotton on"]},{"term":"cotton on","prompt":"It took me ages to _____ to what they were planning.","choices":["decide upon","dig up","cotton on","dream up"]},{"term":"count on","prompt":"I was _____ the payment arriving last week and was really angry when it didn't arrive as I didn't have enough money to pay for everything.","choices":["come into","come through with","come off","count on"]},{"term":"count upon","prompt":"I was _____ their support and lost because they didn't vote my way.","choices":["decide on","dream up","dig up","count upon"]},{"term":"creep in","prompt":"Errors _____ as the text got longer.","choices":["come through with","come into","come off","creep in"]},{"term":"cross up","prompt":"The treasure map was deliberately drawn to _____.","choices":["cross up","come up against","come upon","cotton on"]},{"term":"dawn on","prompt":"The truth only _____ me much later.","choices":["count upon","dawn on","come upon","come up against"]},{"term":"decide on","prompt":"Trevor spent a long time looking at flats before he bought one, but eventually _____ one near his work.","choices":["dream up","dig up","decide on","end in"]},{"term":"decide upon","prompt":"Jane spent a long time looking at houses before she bought one, but eventually _____ one near her office.","choices":["end in","end up with","decide upon","dream up"]},{"term":"dig up","prompt":"The police _____ a body.","choices":["creep in","dawn on","dig up","count upon"]},{"term":"dream up","prompt":"They _____ the scheme for the improvements and it was accepted by the board.","choices":["end up with","decide upon","end in","dream up"]},{"term":"end in","prompt":"Their long argument will _____ a stalemate.","choices":["end in","decide upon","dig up","dream up"]},{"term":"end up with","prompt":"He tried hard but _____ a poor grade.","choices":["cotton on","end up with","count on","come upon"]},{"term":"fall back on","prompt":"It was good to have some money in the bank to _____ when I lost my job.","choices":["end in","cock up","end up with","fall back on"]},{"term":"fall through","prompt":"The plans _____ when planning permission was refused.","choices":["come into","come through with","fall through","come off"]}]},{"id":"phrasal-verbs-v1-lesson-092","title":"Bài 92: Giải quyết vấn đề · fathom–goof","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (fathom–goof).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"fathom out","prompt":"I couldn't _____ what she wanted from me.","choices":["get it together","fathom out","fit into","get by with"]},{"term":"ferret out","prompt":"The investigation finally managed to _____ the truth.","choices":["get it together","get by with","get on to","ferret out"]},{"term":"fight it out","prompt":"They are _____ to see who will become the next CEO.","choices":["fit into","goof up","fight it out","go with"]},{"term":"filter out","prompt":"It _____ all the impurities and chemicals in tap water so that it tastes better.","choices":["get it together","fit into","get by with","filter out"]},{"term":"fit into","prompt":"Their ideas didn't _____ our plans.","choices":["go for","fit into","go by","go at"]},{"term":"fizzle out","prompt":"The campaign started well, but _____ when they ran out of money.","choices":["fizzle out","go against","go about","go after"]},{"term":"get by with","prompt":"We should be able to _____ three PCs, but four would be better.","choices":["ferret out","fathom out","fight it out","get by with"]},{"term":"get it together","prompt":"If I don't _____, I will never reach my targets.","choices":["give rise to","get it together","go after","go about"]},{"term":"get on to","prompt":"It took the authorities a long time to _____ the gang.","choices":["get on to","go after","go about","go against"]},{"term":"give in to","prompt":"The government says it will not _____ terrorists.","choices":["ferret out","fathom out","give in to","fight it out"]},{"term":"give rise to","prompt":"Unclear communication can easily _____ serious misunderstandings.","choices":["get by with","get it together","give rise to","go about"]},{"term":"go about","prompt":"How should I _____ telling her the bad news?","choices":["fathom out","ferret out","goof up","go about"]},{"term":"go after","prompt":"The cat _____ the pigeon, but it flew away.","choices":["fizzle out","go after","get it together","get by with"]},{"term":"go against","prompt":"If the decision _____ me, I'll go bankrupt.","choices":["goof up","fathom out","go against","ferret out"]},{"term":"go at","prompt":"She _____ her dinner like she hadn't eaten for days.","choices":["go at","ferret out","goof up","fathom out"]},{"term":"go by","prompt":"Don't _____ my watch; it's usually a bit slow.","choices":["get on to","give in to","give rise to","go by"]},{"term":"go for","prompt":"The player _____ the ball but missed.","choices":["ferret out","go for","goof up","fathom out"]},{"term":"go through with","prompt":"He did promise, but I doubt that he'll _____ it.","choices":["goof up","go through with","fathom out","ferret out"]},{"term":"go with","prompt":"We're _____ our original plan in the end.","choices":["fizzle out","go with","get on to","get it together"]},{"term":"goof up","prompt":"They _____ our plans.","choices":["goof up","go about","go after","go against"]}]},{"id":"phrasal-verbs-v1-lesson-093","title":"Bài 93: Giải quyết vấn đề · grasp–latch","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (grasp–latch).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"grasp at","prompt":"He _____ the rail when he fell.","choices":["land in","land with","latch on","grasp at"]},{"term":"hack up","prompt":"They _____ and burnt it.","choices":["hold together","hack up","home in on","hinge upon"]},{"term":"hammer out","prompt":"They _____ their differences and got the contract signed.","choices":["key on","kick down","land in","hammer out"]},{"term":"help out","prompt":"She really _____ when I was going through my divorce.","choices":["help out","hold together","home in on","hone in on"]},{"term":"hinge on","prompt":"Our future plans _____ this final test.","choices":["hunt up","hinge on","iron out","hunt out"]},{"term":"hinge upon","prompt":"Everything _____ the results of the negotiations; if they go badly, we'll be in real trouble.","choices":["grasp at","hammer out","hinge upon","hack up"]},{"term":"hold together","prompt":"The society managed to _____ despite the crisis.","choices":["hold together","jack around","hunt up","iron out"]},{"term":"home in on","prompt":"The government is _____ benefit fraud.","choices":["hunt up","home in on","hold together","hunt out"]},{"term":"hone in on","prompt":"The team will _____ the main target.","choices":["land with","grasp at","hone in on","land in"]},{"term":"hunt out","prompt":"It took me ages to _____ the photos.","choices":["jerk around","jack around","hunt out","key in on"]},{"term":"hunt up","prompt":"He _____ a copy the book in the British library.","choices":["land with","land in","latch on","hunt up"]},{"term":"iron out","prompt":"The management team _____ the tax problems before they gave the project the OK.","choices":["iron out","latch on","hack up","grasp at"]},{"term":"jack around","prompt":"Don't listen to him- he always _____.","choices":["jack around","help out","hinge on","hinge upon"]},{"term":"jerk around","prompt":"He was _____ and wouldn't give us the facts.","choices":["jerk around","kick down","land with","land in"]},{"term":"key in on","prompt":"They _____ the person they believed had done it.","choices":["jerk around","jack around","key in on","kick down"]},{"term":"key on","prompt":"We will _____ the opposing team's lack of skills on defense.","choices":["kick down","land in","key on","jerk around"]},{"term":"kick down","prompt":"The police _____.","choices":["kick down","land in","latch on","land with"]},{"term":"land in","prompt":"He _____ it when he told them what I had done wrong.","choices":["hinge on","land in","hinge upon","help out"]},{"term":"land with","prompt":"He _____ the job of proofreading the whole thing.","choices":["hinge on","hinge upon","hold together","land with"]},{"term":"latch on","prompt":"They were lying, but it took her ages to _____.","choices":["latch on","hunt out","hold together","hunt up"]}]},{"id":"phrasal-verbs-v1-lesson-094","title":"Bài 94: Giải quyết vấn đề · latch–muscle","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (latch–muscle).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"latch on to","prompt":"The police didn't _____ what the crooks were doing for years.","choices":["make do with","muscle in","latch on to","lie with"]},{"term":"lie with","prompt":"The decision about the contract _____ the courts.","choices":["muddle through","muddle up","lie with","muddle along"]},{"term":"live up to","prompt":"The concert didn't _____ my expectations.","choices":["muddle up","mull over","live up to","muscle in"]},{"term":"look to","prompt":"The company is _____ increase its sales in Asia.","choices":["make into","make up for","measure up","look to"]},{"term":"make do with","prompt":"There's no coffee, so we'll have to _____ tea.","choices":["move in on","muddle through","make do with","muddle along"]},{"term":"make for","prompt":"The low quality of the service _____ a lot of dissatisfaction.","choices":["measure up","measure up to","make for","meet with"]},{"term":"make good on","prompt":"He _____ his promise to take his family on a vacation.","choices":["make good on","measure up to","measure up","meet with"]},{"term":"make into","prompt":"Many churches have been _____ flats in recent years.","choices":["measure up","make into","look to","measure up to"]},{"term":"make up for","prompt":"I sent her a present to try to _____ my appalling behaviour.","choices":["meet with","make up for","mess with","mess about with"]},{"term":"measure up","prompt":"They _____ the room.","choices":["latch on to","measure up","lie with","live up to"]},{"term":"measure up to","prompt":"I hope to _____ the confidence you have in me.","choices":["make for","lie with","measure up to","make do with"]},{"term":"meet with","prompt":"They _____ some problems they hadn't anticipated.","choices":["muddle along","measure up to","meet with","move in on"]},{"term":"mess about with","prompt":"The computer was working fine until he started _____ it.","choices":["measure up to","measure up","mess about with","make up for"]},{"term":"mess with","prompt":"She's been _____ it for hours and it still doesn't work.","choices":["muddle along","muddle through","move in on","mess with"]},{"term":"move in on","prompt":"As he watched, the hyenas began to _____ the hapless wildebeest.","choices":["move in on","mess about with","mess with","muddle along"]},{"term":"muddle along","prompt":"If you're ambitious, you cannot _____.","choices":["latch on to","muscle in","muddle along","mull over"]},{"term":"muddle through","prompt":"We didn't know what to expect and just _____.","choices":["meet with","measure up to","muddle through","measure up"]},{"term":"muddle up","prompt":"I _____.","choices":["muddle up","look to","live up to","lie with"]},{"term":"mull over","prompt":"I need some time to _____ your interesting offer.","choices":["mull over","make for","make do with","look to"]},{"term":"muscle in","prompt":"We tried to exclude him of the committee, but he _____.","choices":["muddle along","mess with","muscle in","move in on"]}]},{"id":"phrasal-verbs-v1-lesson-095","title":"Bài 95: Giải quyết vấn đề · muscle–put","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (muscle–put).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"muscle in on","prompt":"She _____ the deal even though we wanted to do it without her.","choices":["muscle in on","peter out","pick out","pick through"]},{"term":"muscle into","prompt":"They are _____ our market and there is very little we can do to stop them.","choices":["occur to","nose about","muscle into","nut out"]},{"term":"muscle out","prompt":"They used their contacts in local government to _____.","choices":["muscle out","paper over","opt for","occur to"]},{"term":"nose about","prompt":"The police are _____ to see if they can find anything against the gang.","choices":["peter out","patch together","nose about","pick out"]},{"term":"nut out","prompt":"The management and unions had a meeting to _____.","choices":["pull off","muscle in on","put an end to","nut out"]},{"term":"occur to","prompt":"Didn't it _____ you to help me when you saw how much trouble I was in?","choices":["paper over","occur to","pan out","opt for"]},{"term":"opt for","prompt":"I _____ an endowment mortgage and lost a lot of money.","choices":["opt for","paper over","peter out","patch together"]},{"term":"pan out","prompt":"I don't know how things will _____ now the company's been taken over.","choices":["patch together","paper over","pan out","pick through"]},{"term":"paper over","prompt":"The government tried to _____ the problems in the proposal, but the press were very critical.","choices":["muscle into","muscle in on","paper over","put an end to"]},{"term":"patch together","prompt":"They _____ a coalition after the election.","choices":["psych out","plump for","patch together","pull apart"]},{"term":"peter out","prompt":"Everyone was keen at first, but the enthusiasm _____ when they saw how long it would take.","choices":["pull apart","peter out","plump for","pull off"]},{"term":"pick out","prompt":"The victim couldn't _____ her attacker from the photos the police showed her.","choices":["pick out","plump for","patch together","pin down"]},{"term":"pick through","prompt":"The police have been _____ the wreckage for clues.","choices":["pick through","nose about","nut out","muscle out"]},{"term":"pin down","prompt":"I've asked him to set a date, but he's a hard man to _____ and won't give a definite answer.","choices":["put an end to","pin down","muscle in on","muscle into"]},{"term":"plump for","prompt":"I _____ the steak frites.","choices":["plump for","pick out","peter out","pick through"]},{"term":"psych out","prompt":"We have to try to _____ our rivals.","choices":["pick through","pin down","plump for","psych out"]},{"term":"pull apart","prompt":"My tutor _____.","choices":["pan out","pull apart","occur to","opt for"]},{"term":"pull off","prompt":"No-one thought that she would be able to do it, but she _____ in the end.","choices":["paper over","opt for","pan out","pull off"]},{"term":"put an end to","prompt":"The peace treaty finally _____ decades of regional conflict.","choices":["peter out","put an end to","pick out","pick through"]}]},{"id":"phrasal-verbs-v1-lesson-096","title":"Bài 96: Giải quyết vấn đề · put–see","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (put–see).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"put down to","prompt":"We can _____ the heavy rain for the delay.","choices":["scout around","saw off","rush into","put down to"]},{"term":"queer up","prompt":"I _____.","choices":["queer up","reason out","rein in","reckon on"]},{"term":"ratchet up","prompt":"The media are trying to _____ the pressure on the president.","choices":["scout around","saw off","screen out","ratchet up"]},{"term":"reason out","prompt":"He _____ the answer to the math problem.","choices":["result in","rein in","reckon on","reason out"]},{"term":"reckon on","prompt":"Jeff says we can _____ there being at least fifty people there tonight.","choices":["saw off","screen out","reckon on","scout around"]},{"term":"rein in","prompt":"They had to _____ after her dreadful performance on TV.","choices":["run down","rein in","root out","run up against"]},{"term":"result in","prompt":"Careless driving can easily _____ serious accidents.","choices":["queer up","put down to","see through","result in"]},{"term":"ride out","prompt":"They managed to _____ the recession.","choices":["run down","ride out","run up against","rush into"]},{"term":"romp in","prompt":"In the first race, the favourite _____.","choices":["queer up","put down to","romp in","ratchet up"]},{"term":"root out","prompt":"They are trying to _____ the troublemakers.","choices":["ratchet up","rein in","reckon on","root out"]},{"term":"run down","prompt":"The police _____ all the leads they had and caught them.","choices":["rush into","root out","run down","saw off"]},{"term":"run up against","prompt":"They _____ a lot of opposition to the construction.","choices":["screw up","screen out","run up against","scout around"]},{"term":"rush into","prompt":"They don't want to be _____ giving an answer and have asked for more time.","choices":["rush into","rein in","reckon on","reason out"]},{"term":"saw off","prompt":"He _____ the legs of the chair.","choices":["ride out","result in","rein in","saw off"]},{"term":"scout around","prompt":"We _____ to find the best price.","choices":["scout around","ratchet up","put down to","queer up"]},{"term":"screen out","prompt":"There are so many notices and signs that I have started _____.","choices":["romp in","run down","result in","screen out"]},{"term":"screw up","prompt":"David _____ his oral exam but still managed to scrape a pass.","choices":["screw up","run up against","run down","root out"]},{"term":"see about","prompt":"I'll _____ whether we can manage it.","choices":["queer up","screw up","see about","put down to"]},{"term":"see through","prompt":"They had a lot of difficulties in implementing the project, but the team _____ successfully.","choices":["ratchet up","see through","queer up","put down to"]}]},{"id":"phrasal-verbs-v1-lesson-097","title":"Bài 97: Giải quyết vấn đề · see–stack","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (see–stack).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"see to","prompt":"He _____ the arrangements and everything ran smoothly and efficiently.","choices":["see to","sleep on","smash in","smash up"]},{"term":"settle for","prompt":"We were upset not to win and had to _____ the second prize.","choices":["stack up against","see to","settle for","sift through"]},{"term":"settle on","prompt":"They couldn't agree at first on a name for their daughter, but finally _____ Alice.","choices":["settle on","single out","sit by","sift through"]},{"term":"sift through","prompt":"We had to _____ thousands of files before we found what we were looking for.","choices":["square up to","spark off","sift through","square away"]},{"term":"single out","prompt":"Many people applied for the job but we will _____ the best one.","choices":["see to","stack up against","single out","square with"]},{"term":"sit by","prompt":"I can't _____ while they are punished wrongly.","choices":["sit by","spark off","snarl up","sniff out"]},{"term":"sit on","prompt":"If his girlfriend finds out, she'll get mad and _____ him.","choices":["snarl up","sit on","smash in","smash up"]},{"term":"sit with","prompt":"It's hard to see how their new plan _____ the promises they made.","choices":["smash in","smash up","sit with","sleep on"]},{"term":"size up","prompt":"The doorstaff _____ everyone entering the club.","choices":["sit by","sift through","single out","size up"]},{"term":"sleep on","prompt":"My boss said she'd have to _____ it when I asked her for a raise.","choices":["sit with","sit by","single out","sleep on"]},{"term":"smash in","prompt":"He _____.","choices":["sleep on","sniff out","smash in","snarl up"]},{"term":"smash up","prompt":"The burglars _____ the office as there was no money to steal.","choices":["square away","spark off","smash up","sniff out"]},{"term":"snarl up","prompt":"My line was all _____ after I caught that last fish.","choices":["sit with","snarl up","sit by","sit on"]},{"term":"sniff out","prompt":"Our rivals are trying to _____ our plans for expansion.","choices":["sniff out","sleep on","sit with","size up"]},{"term":"spark off","prompt":"The riot was _____ by the police raid on the club.","choices":["spark off","settle for","see to","stack up against"]},{"term":"square away","prompt":"There are few things I have to _____ before I can leave.","choices":["square away","snarl up","smash up","smash in"]},{"term":"square up to","prompt":"They need to _____ what they did wrong if we are to make any progress.","choices":["settle on","square up to","stack up against","settle for"]},{"term":"square with","prompt":"What he said doesn't _____ what the others said.","choices":["settle for","sift through","square with","settle on"]},{"term":"stack up against","prompt":"The new model doesn't _____ the old one.","choices":["stack up against","spark off","snarl up","sniff out"]}]},{"id":"phrasal-verbs-v1-lesson-098","title":"Bài 98: Giải quyết vấn đề · stand–touch","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (stand–touch).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"stand back","prompt":"We need to _____ and look at the problem differently.","choices":["tie in","think up","think through","stand back"]},{"term":"step back","prompt":"We should _____ and try to see how our customers will view the scheme.","choices":["step back","strike on","touch off","straighten out"]},{"term":"step in","prompt":"I had to _____ when they started fighting.","choices":["toss for","think up","step in","think through"]},{"term":"straighten out","prompt":"Please _____ the messy cables here.","choices":["stuff up","straighten out","stumble upon","strike upon"]},{"term":"strike on","prompt":"I _____ the solution when I was out with my dog.","choices":["think through","strike on","think over","think up"]},{"term":"strike upon","prompt":"It took us a long time to _____ a solution.","choices":["strike upon","think up","think over","think through"]},{"term":"stuff up","prompt":"I _____.","choices":["tear down","stumble upon","stuff up","suss out"]},{"term":"stumble upon","prompt":"I _____ these photos when I was clearing my room up.","choices":["straighten out","step in","stumble upon","strike on"]},{"term":"suss out","prompt":"It took her ages to _____ what was going on.","choices":["touch off","stand back","suss out","step back"]},{"term":"tear down","prompt":"The estate was _____ so that they could develop the land into luxury flats.","choices":["think over","tear down","think through","think up"]},{"term":"tear up","prompt":"He _____ and threw the bits of paper in the bin.","choices":["think through","think over","tear up","tie in"]},{"term":"tell apart","prompt":"They're identical twins so I cannot _____.","choices":["tie in","think up","tell apart","toss for"]},{"term":"think over","prompt":"I've _____ and have made up my mind; I'm going to take the job in Leeds.","choices":["tell apart","toss for","think over","tie in"]},{"term":"think through","prompt":"The plan fell through because they hadn't _____ properly.","choices":["stuff up","strike upon","strike on","think through"]},{"term":"think up","prompt":"I'd better _____ a good reason for handing the work in late.","choices":["think up","step in","stand back","step back"]},{"term":"tie in","prompt":"The theory _____ with what the police have been saying.","choices":["touch off","toss up","tie in","stand back"]},{"term":"toss for","prompt":"We _____ who would start.","choices":["step in","step back","toss for","straighten out"]},{"term":"toss up","prompt":"We _____ to see who would kick off.","choices":["toss up","stand back","tie in","touch off"]},{"term":"touch off","prompt":"The government's decision _____ riots in the capital.","choices":["toss for","toss up","stand back","touch off"]}]},{"id":"phrasal-verbs-v1-lesson-099","title":"Bài 99: Giải quyết vấn đề · toy–zero","focus":"Xử lý khó khăn, sửa chữa và tìm giải pháp. Các cụm được xếp theo động từ gốc (toy–zero).","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","questions":[{"term":"toy at","prompt":"She _____ getting them to help her but then did it alone.","choices":["track down","trade off","try it on","toy at"]},{"term":"toy over","prompt":"I _____ the idea for a while, but decided not to go ahead with it.","choices":["wait upon","toy over","water down","walk away from"]},{"term":"toy with","prompt":"We should _____ the idea of traveling.","choices":["trade off","try it on","track down","toy with"]},{"term":"track down","prompt":"It took me ages to _____ in the crowd at the football game.","choices":["wade in","try it on","trade off","track down"]},{"term":"trade off","prompt":"We had to _____ space for the location when buying the apartment.","choices":["track down","toy with","toy over","trade off"]},{"term":"try it on","prompt":"He knew I wasn't got to let him do it- he was just _____.","choices":["toy at","yield to","try it on","toy over"]},{"term":"wade in","prompt":"He just _____ without listening to what anyone had to say.","choices":["wade in","toy at","toy over","toy with"]},{"term":"wade into","prompt":"They _____ the negotiations and the deal collapsed.","choices":["wait upon","walk away from","wait out","wade into"]},{"term":"wait on","prompt":"They're _____ the results of the vote before taking a final decision.","choices":["weed out","weigh up","water down","wait on"]},{"term":"wait out","prompt":"We'll have to _____ this uncertainty.","choices":["wait out","wade into","wade in","walk away from"]},{"term":"wait upon","prompt":"They must _____ the outcome of the match before they know who they'll be playing.","choices":["water down","weed out","walk away from","wait upon"]},{"term":"walk away from","prompt":"You can't just _____ your problems.","choices":["wait out","walk away from","wait upon","wait on"]},{"term":"water down","prompt":"Do not _____ the original plan now.","choices":["weed out","water down","wiggle out","weigh up"]},{"term":"weed out","prompt":"The company _____ the unsuccessful sales reps.","choices":["wade into","wait upon","weed out","wait on"]},{"term":"weigh up","prompt":"They _____ carefully before deciding.","choices":["weigh up","wait out","wait upon","wait on"]},{"term":"wiggle out","prompt":"He was supposed to be in charge but tried to _____.","choices":["toy at","zero in on","wiggle out","yield to"]},{"term":"winkle out","prompt":"It took me a while to _____ of him.","choices":["wait upon","winkle out","wait on","walk away from"]},{"term":"yield to","prompt":"I tried hard to resist, but in the end I _____ temptation and ate it all.","choices":["yield to","try it on","wade in","trade off"]},{"term":"zero in on","prompt":"The police have _____ the man they believe to be responsible for the murder.","choices":["wait out","wade in","zero in on","wade into"]}]},{"id":"phrasal-verbs-v1-lesson-100","title":"Bài 100: Tình huống khác · belong–go","focus":"Các cụm động từ dùng trong nhiều tình huống khác nhau. Các cụm được xếp theo động từ gốc (belong–go).","topicId":"other-situations","topicTitle":"Tình huống khác","questions":[{"term":"belong to","prompt":"Their ideas _____ the nineteenth century and seem old-fashioned now.","choices":["blow up","catch up in","chance upon","belong to"]},{"term":"belong with","prompt":"Does this disc _____ those on the shelf?","choices":["blow up","blow over","catch up in","belong with"]},{"term":"blow over","prompt":"The scandal _____ within a fortnight when the press found someone else to attack.","choices":["feed off","die off","cut across","blow over"]},{"term":"blow up","prompt":"A storm _____ while we were out walking.","choices":["come about","blow up","catch up in","chance upon"]},{"term":"catch up in","prompt":"The tourists were _____ the violence of the revolution.","choices":["die off","contribute to","cut across","catch up in"]},{"term":"chance upon","prompt":"I _____ a very rare book in car boot sale and bought it for 65p.","choices":["chance upon","come about","blow up","catch up in"]},{"term":"come about","prompt":"The yacht _____ to a heading of 240 degrees.","choices":["blow over","come about","belong with","belong to"]},{"term":"come forth","prompt":"The draft proposal _____ in April.","choices":["cut across","contribute to","come forth","die off"]},{"term":"contribute to","prompt":"Regular exercise _____ better cardiovascular health.","choices":["cut across","come forth","die off","contribute to"]},{"term":"cut across","prompt":"The issue _____ social backgrounds as it affects us all equally.","choices":["blow over","cut across","belong to","belong with"]},{"term":"die off","prompt":"Most of the elm trees in the UK _____ when Dutch elm disease arrived.","choices":["belong with","blow over","belong to","die off"]},{"term":"feed off","prompt":"He _____ people's fear of crime to get them to support his proposals.","choices":["feed off","go over to","fly by","go down"]},{"term":"finish off","prompt":"The animal was badly hurt, so they _____ to end its suffering.","choices":["come forth","contribute to","finish off","cut across"]},{"term":"fly by","prompt":"As I get older, the years just _____.","choices":["catch up in","blow up","fly by","chance upon"]},{"term":"go down","prompt":"It _____ as the worst day in the history of the company.","choices":["cut across","go down","die off","feed off"]},{"term":"go over to","prompt":"I used to drink beer but I have _____ wine.","choices":["cut across","feed off","die off","go over to"]}]},{"id":"phrasal-verbs-v1-lesson-101","title":"Bài 101: Tình huống khác · go–prey","focus":"Các cụm động từ dùng trong nhiều tình huống khác nhau. Các cụm được xếp theo động từ gốc (go–prey).","topicId":"other-situations","topicTitle":"Tình huống khác","questions":[{"term":"go together","prompt":"Drinking and driving don't _____.","choices":["go together","play on","play at","pass for"]},{"term":"grow from","prompt":"A lot _____ the peace talks.","choices":["pour down","grow from","play at","play on"]},{"term":"grow into","prompt":"She's has _____ a lovely person.","choices":["pass for","owe to","grow into","melt down"]},{"term":"jazz up","prompt":"The show was getting stale so they _____ with some new scenes.","choices":["key to","lead to","jazz up","grow into"]},{"term":"key to","prompt":"Promotions are _____ people's abilities.","choices":["key to","luck into","jazz up","melt down"]},{"term":"lead to","prompt":"The investigation _____ the arrest of a number of suspects.","choices":["play on","pour down","prey on","lead to"]},{"term":"luck into","prompt":"We _____ getting the answer.","choices":["play on","pour down","prey on","luck into"]},{"term":"melt down","prompt":"They _____ and turned it into gold bars.","choices":["melt down","lead to","key to","luck into"]},{"term":"owe to","prompt":"She _____ hard work and determination.","choices":["owe to","grow from","grow into","jazz up"]},{"term":"pass for","prompt":"You'd be surprised at what _____ good cooking in many restaurants.","choices":["play on","play at","pass for","owe to"]},{"term":"play at","prompt":"He just _____ being a lawyer- he never wins a case.","choices":["owe to","play at","pass for","pour down"]},{"term":"play on","prompt":"It looked like a foul, but the referee told them to _____.","choices":["go together","pour down","play on","prey upon"]},{"term":"pour down","prompt":"It _____ all day so we had to remain indoors.","choices":["play at","owe to","pour down","pass for"]},{"term":"prey on","prompt":"Large birds of _____ small rodents.","choices":["prey on","owe to","pass for","play at"]},{"term":"prey upon","prompt":"Cats _____ birds and mice.","choices":["lead to","prey upon","jazz up","key to"]}]},{"id":"phrasal-verbs-v1-lesson-102","title":"Bài 102: Tình huống khác · pull–suck","focus":"Các cụm động từ dùng trong nhiều tình huống khác nhau. Các cụm được xếp theo động từ gốc (pull–suck).","topicId":"other-situations","topicTitle":"Tình huống khác","questions":[{"term":"pull back","prompt":"They were two-nil down until five minutes before the end, when they _____ a goal.","choices":["spill over","pull back","spring from","spew out"]},{"term":"rain down on","prompt":"Bombs _____ the city all night.","choices":["pull back","reel out","rain down on","set apart"]},{"term":"rain off","prompt":"The match was _____.","choices":["rain off","roll on","rely on","reel out"]},{"term":"rain out","prompt":"The game was _____.","choices":["stem from","spring from","stumble across","rain out"]},{"term":"reel out","prompt":"I _____ the hose and watered the lawn.","choices":["reel out","spring from","spill over","spring back"]},{"term":"rely on","prompt":"You can always _____ her to finish the report on time.","choices":["reel out","spew out","set apart","rely on"]},{"term":"roll on","prompt":"The competition _____ despite the administrative problems.","choices":["set apart","spill over","roll on","spew out"]},{"term":"set apart","prompt":"The quality of their work _____ from their rivals.","choices":["set apart","reel out","rain out","rain off"]},{"term":"spew out","prompt":"The volcano is _____ lava and hot gases.","choices":["set apart","rely on","spew out","roll on"]},{"term":"spill over","prompt":"The protests and demonstrations have _____ into neighbouring states.","choices":["pull back","rain down on","rain off","spill over"]},{"term":"spring back","prompt":"The lock _____ when the key is turned.","choices":["stumble across","suck in","stem from","spring back"]},{"term":"spring from","prompt":"His anger _____ his feelings of insecurity.","choices":["reel out","spring from","roll on","rely on"]},{"term":"stem from","prompt":"The trouble _____ their refusal to discuss the matter.","choices":["rain out","stem from","reel out","rain off"]},{"term":"stumble across","prompt":"You'll never guess what I _____ when I was packing my stuff.","choices":["rain out","rely on","reel out","stumble across"]},{"term":"suck in","prompt":"Everyone around her was taking drugs and she got _____.","choices":["pull back","stem from","suck in","stumble across"]}]},{"id":"phrasal-verbs-v1-lesson-103","title":"Bài 103: Tình huống khác · suck–wear","focus":"Các cụm động từ dùng trong nhiều tình huống khác nhau. Các cụm được xếp theo động từ gốc (suck–wear).","topicId":"other-situations","topicTitle":"Tình huống khác","questions":[{"term":"suck into","prompt":"The country got _____ the war.","choices":["suck into","throw off","throw out","throw up"]},{"term":"tack on","prompt":"They _____ a new ending to the film when they found that test audiences didn't like the original.","choices":["throw out","throw up","tick away","tack on"]},{"term":"tack onto","prompt":"I _____ the end of the letter after I'd printed it.","choices":["tack onto","tick away","tick by","throw up"]},{"term":"throw off","prompt":"The lamp _____ a lot of heat.","choices":["tack on","throw off","tack onto","tick away"]},{"term":"throw out","prompt":"The car _____ a lot of smoke.","choices":["tick by","throw out","tack onto","tick away"]},{"term":"throw up","prompt":"The dry wind started to _____ a lot of dust.","choices":["tie in with","tick by","top off","throw up"]},{"term":"tick away","prompt":"The last few seconds _____ and the team couldn't come back.","choices":["throw up","tick away","throw out","throw off"]},{"term":"tick by","prompt":"The seconds _____ and the team failed to score.","choices":["tick by","top off","turn into","tie in with"]},{"term":"tie in with","prompt":"The publication _____ the twentieth anniversary of the incident.","choices":["wash out","tie in with","wear away","suck into"]},{"term":"top off","prompt":"He complained for an hour and to _____ started shouting his head off.","choices":["wear away","wash out","suck into","top off"]},{"term":"turn into","prompt":"The small caterpillar will _____ a butterfly.","choices":["tick away","throw out","throw up","turn into"]},{"term":"usher in","prompt":"We always give a party _____ the new year.","choices":["tie in with","tick by","usher in","top off"]},{"term":"vamp up","prompt":"The place is dull and you need to _____.","choices":["suck into","tack on","wear away","vamp up"]},{"term":"wash out","prompt":"The rain _____ the championship final.","choices":["wash out","top off","tick by","tie in with"]},{"term":"wear away","prompt":"The lawn has been _____ by people walking across it and it's just bare soil now with hardly a blade of grass.","choices":["wear away","suck into","tack on","wash out"]}]}],"entriesByTerm":{"angle for":{"definition":"dò hỏi ngầm; tìm cách gợi ý","example":"He's been angling for an invitation, but I don't want him to come.","exampleTranslation":"Anh ấy đã và đang dò hỏi ngầm để có được lời mời, nhưng tôi không muốn anh ấy đến.","rootVerb":"angle","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"answer back":{"definition":"cãi lại","example":"It is rude to answer back to parents.","exampleTranslation":"Cãi lại cha mẹ là hành động bất lịch sự.","rootVerb":"answer","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"answer for":{"definition":"nói thay cho; bảo đảm cho","example":"I can answer for my partner because I know her position on this issue.","exampleTranslation":"Tôi có thể nói thay cho đối tác của mình vì tôi biết quan điểm của cô ấy về vấn đề này.","rootVerb":"answer","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"argue down":{"definition":"tranh luận để đánh bại","example":"The teacher tried to argue the girl down, but she couldn't.","exampleTranslation":"Giáo viên đã cố gắng tranh luận để đánh bại cô gái đó, nhưng bà ấy không làm được.","rootVerb":"argue","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"argue out":{"definition":"thảo luận để giải quyết","example":"If we can't argue our differences out, we'll have to take them to court.","exampleTranslation":"Nếu chúng ta không thể thảo luận để giải quyết những bất đồng, chúng ta sẽ phải đưa chúng ra tòa.","rootVerb":"argue","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ask about":{"definition":"hỏi thăm (tình hình/sức khỏe)","example":"He asked about my father.","exampleTranslation":"Anh ấy đã hỏi thăm về cha tôi.","rootVerb":"ask","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ask around":{"definition":"hỏi thăm nhiều người","example":"I have no idea, but I'll ask around at work and see if anyone can help.","exampleTranslation":"Tôi không biết nữa, nhưng tôi sẽ hỏi thăm nhiều người ở chỗ làm xem có ai giúp được không.","rootVerb":"ask","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"back off":{"definition":"lùi lại; ngừng gây áp lực","example":"The police told the protesters to back off.","exampleTranslation":"Cảnh sát bảo những người biểu tình hãy lùi lại.","rootVerb":"back","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"back out":{"definition":"rút lời; không giữ lời hứa","example":"He decided to back out of the deal.","exampleTranslation":"Anh ấy đã quyết định rút khỏi thỏa thuận.","rootVerb":"back","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bag out":{"definition":"chỉ trích","example":"Don't bag out Australian English.","exampleTranslation":"Đừng chỉ trích tiếng Anh Úc.","rootVerb":"bag","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bail out on":{"definition":"bỏ rơi; không ủng hộ nữa","example":"Everybody bailed out on him when the scandal broke.","exampleTranslation":"Mọi người đều bỏ rơi anh ấy khi vụ bê bối nổ ra.","rootVerb":"bail","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bail up":{"definition":"giữ chân (bằng cách nói chuyện)","example":"I was late because he bailed me up on the phone and wouldn't shut up.","exampleTranslation":"Tôi đã bị trễ vì anh ta giữ chân tôi trên điện thoại và cứ nói mãi không thôi.","rootVerb":"bail","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bang on":{"definition":"nói lải nhải","example":"He banged on for half an hour but no one was listening.","exampleTranslation":"Anh ta đã nói lải nhải suốt nửa tiếng đồng hồ nhưng chẳng có ai lắng nghe cả.","rootVerb":"bang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bang on about":{"definition":"lải nhải về","example":"He's always banging on about football.","exampleTranslation":"Anh ta lúc nào cũng lải nhải về bóng đá.","rootVerb":"bang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bawl out":{"definition":"hát hoặc la hét lớn tiếng","example":"He bawled out our names at the top of his voice.","exampleTranslation":"Anh ấy đã hét lớn tên chúng tôi với hết sức bình sinh.","rootVerb":"bawl","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"be down on":{"definition":"có ác cảm với","example":"After the argument, James is down on his boss.","exampleTranslation":"Sau cuộc tranh cãi, James đang có ác cảm với sếp của mình.","rootVerb":"be","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"be in on":{"definition":"tham gia vào; có liên quan","example":"Do you want to be in on this secret?","exampleTranslation":"Bạn có muốn tham gia vào bí mật này không?","rootVerb":"be","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"be on about":{"definition":"có ý nói; muốn nói gì","example":"I couldn't understand what he was on about- it made no sense.","exampleTranslation":"Tôi không thể hiểu anh ấy đang có ý nói gì - điều đó hoàn toàn vô nghĩa.","rootVerb":"be","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bear with":{"definition":"kiên nhẫn","example":"Please bear with me a moment while I finish this email.","exampleTranslation":"Xin hãy kiên nhẫn với tôi một lát trong khi tôi hoàn thành email này.","rootVerb":"bear","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"blurt out":{"definition":"Buột miệng nói ra điều gì đó mà không suy nghĩ.","example":"I was really angry when he blurted out the secret.","exampleTranslation":"Tôi đã thực sự rất giận dữ khi anh ta buột miệng nói ra bí mật đó.","rootVerb":"blurt","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"boss about":{"definition":"Ra lệnh, sai bảo.","example":"He likes to boss about his younger siblings.","exampleTranslation":"Anh ấy thích ra lệnh cho các em của mình.","rootVerb":"boss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"boss around":{"definition":"Ra lệnh, sai bảo.","example":"Stop trying to boss around your coworkers all day.","exampleTranslation":"Đừng cố ra lệnh cho các đồng nghiệp của bạn suốt cả ngày nữa.","rootVerb":"boss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bounce into":{"definition":"Ép buộc ai đó.","example":"They have bounced the government into calling an early election.","exampleTranslation":"Họ đã ép buộc chính phủ phải kêu gọi một cuộc bầu cử sớm.","rootVerb":"bounce","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bounce off":{"definition":"Trao đổi ý tưởng để thăm dò phản ứng.","example":"They bounced ideas off each other in a brainstorming session.","exampleTranslation":"Họ đã trao đổi ý tưởng để thăm dò phản ứng của nhau trong một phiên họp thảo luận nhóm.","rootVerb":"bounce","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bring forth":{"definition":"Đưa ra, làm cho cái gì đó được biết đến.","example":"The prosecution brought forth a lot of evidence against him.","exampleTranslation":"Bên công tố đã đưa ra rất nhiều bằng chứng chống lại anh ta.","rootVerb":"bring","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bring out":{"definition":"Khơi gợi, làm bộc lộ.","example":"Suzie brings out the best in him.","exampleTranslation":"Suzie khơi gợi những điều tốt đẹp nhất ở anh ấy.","rootVerb":"bring","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"brush off":{"definition":"Phớt lờ, không thèm để ý.","example":"The minister brushed off the criticism.","exampleTranslation":"Bộ trưởng đã phớt lờ những lời chỉ trích đó.","rootVerb":"brush","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bump into":{"definition":"Tình cờ gặp.","example":"I bumped into Helen on the underground the other day.","exampleTranslation":"Tôi tình cờ gặp Helen trên tàu điện ngầm vào hôm trước.","rootVerb":"bump","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"bust up":{"definition":"Chia tay, cắt đứt quan hệ.","example":"They bust up after a row last night.","exampleTranslation":"Họ đã chia tay sau một cuộc cãi vã vào tối qua.","rootVerb":"bust","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"butt in":{"definition":"Xen vào, ngắt lời.","example":"I hope you don't mind me butting in on your conversation, but I couldn't help hearing what you said...","exampleTranslation":"Tôi hy vọng bạn không phiền khi tôi xen vào cuộc trò chuyện của các bạn, nhưng tôi không thể không nghe thấy những gì bạn đã nói...","rootVerb":"butt","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"butt out":{"definition":"Đừng xen vào việc của người khác.","example":"This is none of your business, so just butt out!","exampleTranslation":"Đây không phải là chuyện của bạn, vì vậy hãy đừng xen vào việc của người khác!","rootVerb":"butt","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"butter up":{"definition":"Nịnh nọt.","example":"I tried buttering my tutor up but she still wouldn't let me hand it in late.","exampleTranslation":"Tôi đã cố nịnh nọt giảng viên nhưng cô ấy vẫn không cho phép tôi nộp bài trễ.","rootVerb":"butter","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"call on":{"definition":"Yêu cầu ai đó làm gì (đặc biệt là phát biểu trước đám đông).","example":"I now call on the other party to give their account of what happened.","exampleTranslation":"Bây giờ tôi yêu cầu phía bên kia hãy đưa ra lời giải thích của họ về những gì đã xảy ra.","rootVerb":"call","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"call out":{"definition":"Phơi bày hoặc buộc tội ai đó làm sai hoặc kém cỏi.","example":"He called them out over awarding contracts to family members.","exampleTranslation":"Anh ta đã phơi bày việc họ trao hợp đồng cho các thành viên trong gia đình.","rootVerb":"call","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"call up":{"definition":"Gọi điện thoại.","example":"I called him up as soon as I got to a phone to tell him the news.","exampleTranslation":"Tôi đã gọi điện thoại cho anh ấy ngay khi đến chỗ có điện thoại để báo tin.","rootVerb":"call","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"catch up with":{"definition":"Trừng phạt ai đó sau thời gian dài phạm lỗi.","example":"The tax authorities caught up with me for not submitting my tax returns.","exampleTranslation":"Cơ quan thuế đã trừng phạt tôi vì không nộp tờ khai thuế.","rootVerb":"catch","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cater to":{"definition":"Phục vụ (thường mang ý nghĩa tiêu cực).","example":"The film caters to the audience's worst instincts.","exampleTranslation":"Bộ phim phục vụ cho những bản năng tồi tệ nhất của khán giả.","rootVerb":"cater","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"chat up":{"definition":"Tán tỉnh.","example":"He spent the whole night chatting her up.","exampleTranslation":"Anh ấy đã dành cả đêm để tán tỉnh cô ấy.","rootVerb":"chat","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cheat on":{"definition":"Ngoại tình.","example":"She felt sad because he chose to cheat on her.","exampleTranslation":"Cô ấy cảm thấy buồn vì anh ta chọn cách ngoại tình với cô.","rootVerb":"cheat","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cheer on":{"definition":"Cổ vũ.","example":"They cheered their team on throughout the match.","exampleTranslation":"Họ đã cổ vũ cho đội của mình trong suốt trận đấu.","rootVerb":"cheer","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"chew out":{"definition":"Chỉ trích gay gắt.","example":"They chewed him out for being late.","exampleTranslation":"Họ đã chỉ trích anh ấy gay gắt vì đến muộn.","rootVerb":"chew","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"chime in":{"definition":"Nói chen vào.","example":"If it's OK, I'd like to chime in because I think it's a good idea.","exampleTranslation":"Nếu không sao cả, tôi muốn nói chen vào một chút vì tôi nghĩ đó là một ý hay.","rootVerb":"chime","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"chip in":{"definition":"Nói chen vào.","example":"If I could chip in, there are a couple of issues I'd like to raise.","exampleTranslation":"Nếu tôi có thể nói chen vào, có vài vấn đề tôi muốn nêu ra.","rootVerb":"chip","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"climb down":{"definition":"Nhượng bộ, nhận sai.","example":"The Prime Minister had to climb down over his tax proposals because there was so much opposition from the members of his own party.","exampleTranslation":"Thủ tướng đã phải nhượng bộ về các đề xuất thuế của mình vì vấp phải sự phản đối lớn từ các thành viên trong đảng của chính ông.","rootVerb":"climb","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come around to":{"definition":"Đồng ý hoặc chấp nhận điều gì đó mà trước đây bạn không tán thành hoặc không thích.","example":"They have started coming around to our way of thinking and are less hostile.","exampleTranslation":"Họ đã bắt đầu đồng ý với lối suy nghĩ của chúng ta và bớt thù địch hơn.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come down on":{"definition":"Chỉ trích nặng nề.","example":"The management really came down on him for losing the contract.","exampleTranslation":"Ban quản lý thực sự đã chỉ trích nặng nề anh ấy vì làm mất hợp đồng.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come down upon":{"definition":"Chỉ trích, khiển trách nghiêm khắc.","example":"They will come down upon us if we are late.","exampleTranslation":"Họ sẽ chỉ trích chúng ta nghiêm khắc nếu chúng ta đến muộn.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come forth with":{"definition":"Cung cấp thông tin.","example":"Did anyone come forth with any new evidence?","exampleTranslation":"Có ai cung cấp thông tin gì về bằng chứng mới không?","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come in for":{"definition":"Nhận (chỉ trích hoặc khen ngợi).","example":"Jack's come in for quite a lot of criticism of late.","exampleTranslation":"Jack gần đây đã phải nhận rất nhiều lời chỉ trích.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come out":{"definition":"Công khai giới tính (đồng tính).","example":"He decided to come out to his parents.","exampleTranslation":"Anh ấy đã quyết định công khai giới tính thật của mình với cha mẹ.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come out with":{"definition":"Nói điều gì đó một cách công khai và bất ngờ.","example":"She came out with the answer when everyone was expecting it to remain unsolved.","exampleTranslation":"Cô ấy đã bất ngờ đưa ra câu trả lời khi mọi người đều nghĩ rằng vấn đề đó sẽ vẫn chưa được giải quyết.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"come through":{"definition":"Đến (tin nhắn và thông tin).","example":"The news will come through on the radio soon.","exampleTranslation":"Tin tức sẽ sớm được phát trên đài phát thanh.","rootVerb":"come","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"count in":{"definition":"Bao gồm hoặc liên quan.","example":"If you're going on that skiing holiday, you can count me in; I'd love to go.","exampleTranslation":"Nếu bạn định đi chuyến nghỉ mát trượt tuyết đó, bạn có thể tính cả tôi vào; tôi rất muốn đi.","rootVerb":"count","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cozy up to":{"definition":"Lấy lòng ai đó.","example":"He's been cozying up to our boss because he wants a pay rise.","exampleTranslation":"Anh ta đang cố lấy lòng sếp của chúng tôi vì anh ta muốn được tăng lương.","rootVerb":"cozy","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cry off":{"definition":"Hủy bỏ một cuộc hẹn.","example":"I've got to work tonight; can I cry off going out for dinner?","exampleTranslation":"Tôi phải làm việc tối nay; tôi có thể hủy cuộc hẹn đi ăn tối không?","rootVerb":"cry","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cut it out":{"definition":"Dừng lại đi (hành vi vô lý).","example":"Will you two idiots cut IT out and keep quiet.","exampleTranslation":"Hai tên ngốc các người dừng ngay hành vi vô lý đó lại và im lặng đi.","rootVerb":"cut","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"cut out on":{"definition":"Làm thất vọng, hắt hủi.","example":"Although he'd promised to help, the star cut out on the charity when offered more money.","exampleTranslation":"Mặc dù đã hứa giúp đỡ, ngôi sao đó đã hắt hủi tổ chức từ thiện khi được mời chào nhiều tiền hơn.","rootVerb":"cut","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"dash down":{"definition":"Viết nhanh thứ gì đó.","example":"He dashed down a memo and sent it to everybody.","exampleTranslation":"Anh ấy đã viết nhanh một bản ghi nhớ và gửi cho tất cả mọi người.","rootVerb":"dash","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"dine out on":{"definition":"Kể đi kể lại một câu chuyện được mọi người tán thưởng.","example":"I've dined out on the story of his accident.","exampleTranslation":"Tôi đã kể đi kể lại câu chuyện về tai nạn của anh ấy để được mọi người tán thưởng.","rootVerb":"dine","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"dish out":{"definition":"Chỉ trích người khác (nhưng không chịu được khi bị chỉ trích lại).","example":"He dishes it out, but gets all hurt when anyone responds.","exampleTranslation":"Anh ta chỉ trích người khác, nhưng lại tỏ ra bị tổn thương khi có ai đó phản ứng lại.","rootVerb":"dish","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"draw into":{"definition":"Bị lôi kéo vào chuyện rắc rối.","example":"I didn't want to take sides because I didn't want to get drawn into their arguments.","exampleTranslation":"Tôi không muốn đứng về phe nào vì tôi không muốn bị lôi kéo vào các cuộc tranh cãi của họ.","rootVerb":"draw","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"dredge up":{"definition":"Đào bới quá khứ của ai đó.","example":"The newspapers dredged up the details of his affair with his research assistant.","exampleTranslation":"Các tờ báo đã đào bới chi tiết về vụ ngoại tình của anh ta với trợ lý nghiên cứu của mình.","rootVerb":"dredge","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"drift apart":{"definition":"Dần xa cách nhau.","example":"We were great friends at school but drifted apart when we went to different universities.","exampleTranslation":"Chúng tôi từng là những người bạn tuyệt vời ở trường nhưng đã dần xa cách nhau khi học ở các trường đại học khác nhau.","rootVerb":"drift","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"drone on":{"definition":"Thao thao bất tuyệt một cách nhàm chán.","example":"The minister droned on for an hour and the audience looked increasingly bored.","exampleTranslation":"Vị bộ trưởng đã thao thao bất tuyệt suốt một giờ đồng hồ và khán giả trông ngày càng chán nản.","rootVerb":"drone","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"drown out":{"definition":"Át tiếng (âm thanh khác).","example":"The music drowned out the sound of the phone ringing.","exampleTranslation":"Âm nhạc đã át tiếng chuông điện thoại đang reo.","rootVerb":"drown","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"dumb down":{"definition":"Bình dân hóa, làm đơn giản đi.","example":"Television has been dumbing down the news for years.","exampleTranslation":"Truyền hình đã bình dân hóa tin tức trong nhiều năm qua.","rootVerb":"dumb","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"dump on":{"definition":"Xả rác/trút bầu tâm sự vào ai đó.","example":"When he';s depressed, he needs someone to dump on.","exampleTranslation":"Khi chán nản, anh ấy cần ai đó để trút bầu tâm sự.","rootVerb":"dump","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"egg on":{"definition":"Xúi giục.","example":"The other students egged him on when he started arguing with the teacher.","exampleTranslation":"Những sinh viên khác đã xúi giục anh ta khi anh ta bắt đầu tranh cãi với giáo viên.","rootVerb":"egg","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"enter into":{"definition":"Tham gia vào hoặc chấp nhận.","example":"They entered into an agreement with their rivals.","exampleTranslation":"Họ đã tham gia vào một thỏa thuận với các đối thủ của mình.","rootVerb":"enter","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"eye up":{"definition":"Nhìn ai đó chằm chằm một cách cẩn thận.","example":"The guy eyed the other man up because he was behaving suspiciously.","exampleTranslation":"Gã đó nhìn chằm chằm vào người đàn ông kia một cách cẩn thận vì anh ta đang cư xử một cách đáng ngờ.","rootVerb":"eye","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"face off":{"definition":"Đối đầu.","example":"The company faced off against its competitors.","exampleTranslation":"Công ty đã đối đầu với đối thủ cạnh tranh.","rootVerb":"face","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fall for":{"definition":"Tin vào một lời nói dối hoặc sự lừa gạt.","example":"He fell for my story and allowed me yet another extension for the submission of my thesis.","exampleTranslation":"Anh ta đã tin vào lời nói dối của tôi và cho phép tôi gia hạn thêm thời gian để nộp luận văn.","rootVerb":"fall","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fall in with":{"definition":"Đồng tình với kế hoạch; hoặc kết giao, nhập bọn với nhóm bạn bè.","example":"He quickly fell in with the local cycling club and joined their weekly rides.","exampleTranslation":"Anh ấy đã nhanh chóng nhập bọn với câu lạc bộ đạp xe địa phương và tham gia các chuyến đi hàng tuần của họ.","rootVerb":"fall","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fasten on":{"definition":"Chú ý đến điều gì đó xác nhận niềm tin của bạn.","example":"They have fastened on the speech as a source of inspiration.","exampleTranslation":"Họ đã chú ý đến bài phát biểu đó như một nguồn cảm hứng.","rootVerb":"fasten","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fasten onto":{"definition":"Bám sát ai đó, thường là khi họ không muốn bạn ở cùng.","example":"He fastened onto the minister on his visit and asked him repeatedly about the scandal.","exampleTranslation":"Anh ấy đã bám sát vị bộ trưởng trong chuyến thăm và hỏi ông ấy liên tục về vụ bê bối.","rootVerb":"fasten","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fawn on":{"definition":"Khen ngợi ai đó một cách thái quá để nhận được ân huệ.","example":"He's always fawning on his boss to try to get promoted.","exampleTranslation":"Anh ta luôn nịnh nọt sếp của mình để cố gắng được thăng chức.","rootVerb":"fawn","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fawn over":{"definition":"Khen ngợi ai đó một cách thái quá để nhận được ân huệ.","example":"She fawned over the inspectors in the hope that they would give her a good grade.","exampleTranslation":"Cô ấy đã nịnh nọt các giám khảo với hy vọng rằng họ sẽ cho cô ấy điểm cao.","rootVerb":"fawn","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fess up":{"definition":"Thú nhận, thừa nhận điều gì đó miễn cưỡng.","example":"The company fessed up after they were exposed in the newspapers.","exampleTranslation":"Công ty đã miễn cưỡng thú nhận sau khi bị các tờ báo phơi bày sự thật.","rootVerb":"fess","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fink on":{"definition":"Tiết lộ bí mật về ai đó.","example":"He finked on her to the authorities.","exampleTranslation":"Anh ấy đã tiết lộ bí mật của cô ấy cho chính quyền.","rootVerb":"fink","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fink out":{"definition":"Không giữ lời hứa, thỏa thuận, v.v.","example":"He said he'd come with us then finked out at the last minute.","exampleTranslation":"Anh ấy đã nói sẽ đi cùng chúng tôi nhưng rồi lại nuốt lời vào phút chót.","rootVerb":"fink","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fire away":{"definition":"Bắt đầu đặt câu hỏi.","example":"What do you want to know? Fire away and I'll tell you.","exampleTranslation":"Bạn muốn biết gì? Cứ hỏi đi rồi tôi sẽ nói cho.","rootVerb":"fire","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fire off":{"definition":"Gửi một cách nhanh chóng, tức giận hoặc nhiều thư (thư, email, v.v.).","example":"He fired off an email complaining about the report.","exampleTranslation":"Anh ta đã gửi đi một email phàn nàn về bản báo cáo.","rootVerb":"fire","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fish for":{"definition":"Cố gắng lấy thông tin hoặc khiến ai đó nói điều gì.","example":"He's always fishing for compliments.","exampleTranslation":"Anh ấy lúc nào cũng tìm cách để được khen ngợi.","rootVerb":"fish","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fit in with":{"definition":"Xảy ra theo cách cho thấy các kế hoạch hoặc ý tưởng không thay đổi.","example":"His rudeness yesterday fits in with what I have always thought of his behaviour.","exampleTranslation":"Sự thô lỗ của anh ta ngày hôm qua hoàn toàn khớp với những gì tôi luôn nghĩ về cách cư xử của anh ta.","rootVerb":"fit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"flag up":{"definition":"Nêu lên một vấn đề, hoặc nhấn mạnh tầm quan trọng của nó.","example":"We should flag up working conditions at the meeting.","exampleTranslation":"Chúng ta nên nêu lên vấn đề điều kiện làm việc tại cuộc họp.","rootVerb":"flag","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"flounce off":{"definition":"Bỏ đi khỏi một nơi hoặc bỏ mặc ai đó một cách tức giận.","example":"He flounced off when they laughed at him.","exampleTranslation":"Anh ta hậm hực bỏ đi khi họ cười nhạo anh ta.","rootVerb":"flounce","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"flounce out":{"definition":"Rời khỏi một nơi một cách tức giận.","example":"He flounced out when the press started criticising him.","exampleTranslation":"Anh ta giận dữ bỏ ra ngoài khi báo chí bắt đầu chỉ trích mình.","rootVerb":"flounce","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fly about":{"definition":"Lưu truyền (tin đồn, v.v.).","example":"The rumour has been flying about for the past week, but no one has confirmed it.","exampleTranslation":"Tin đồn đã lưu truyền suốt tuần qua, nhưng chưa có ai xác nhận nó.","rootVerb":"fly","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fly around":{"definition":"Lưu truyền (tin đồn, v.v.).","example":"There are a lot of stories flying around about her past.","exampleTranslation":"Có rất nhiều câu chuyện đang được lan truyền về quá khứ của cô ấy.","rootVerb":"fly","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"fly at":{"definition":"Chỉ trích hoặc la mắng tức giận.","example":"He flew at them for not trying hard enough.","exampleTranslation":"Anh ta đã mắng nhiếc họ vì đã không cố gắng đủ sức.","rootVerb":"fly","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"freeze out":{"definition":"Ngăn cản hoặc loại trừ bằng cách đối xử không thân thiện.","example":"They tried to freeze me out of the conversation.","exampleTranslation":"Họ đã cố gắng gạt tôi ra khỏi cuộc trò chuyện bằng thái độ không thân thiện.","rootVerb":"freeze","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"front off":{"definition":"Đối đầu và cho ai đó biết bạn sẵn sàng chiến đấu.","example":"The two guys fronted each other off, but someone managed to calm them down before it got out of hand.","exampleTranslation":"Hai gã đó đã đối đầu nhau, nhưng có người đã xoay xở để làm dịu họ trước khi sự việc trở nên mất kiểm soát.","rootVerb":"front","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"front out":{"definition":"Đương đầu, đối mặt với sự chỉ trích mà không lùi bước.","example":"He had to front out against the critics.","exampleTranslation":"Anh ấy đã phải đương đầu với những lời chỉ trích mà không lùi bước.","rootVerb":"front","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"front up":{"definition":"Xuất hiện ở đâu đó trong thời gian ngắn.","example":"I hate these occasions, but I'll front up for the first half.","exampleTranslation":"Tôi ghét mấy dịp này, nhưng tôi sẽ có mặt ở đó trong nửa phần đầu.","rootVerb":"front","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"gang up":{"definition":"Hùa nhau chống lại ai đó hoặc điều gì đó.","example":"They ganged up to try to stop the new system.","exampleTranslation":"Họ đã hùa nhau vào để cố gắng ngăn chặn hệ thống mới.","rootVerb":"gang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"gang up against":{"definition":"Hùa nhau ức hiếp, bắt nạt.","example":"They ganged up against me because I wouldn't accept their ideas.","exampleTranslation":"Họ hùa nhau chống lại tôi vì tôi không chịu chấp nhận ý kiến của họ.","rootVerb":"gang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"gang up on":{"definition":"Hùa nhau ăn hiếp, bắt nạt.","example":"They ganged up on him because of the way he spoke.","exampleTranslation":"Họ hùa nhau bắt nạt anh ta vì cách anh ta nói chuyện.","rootVerb":"gang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get about":{"definition":"Được lan truyền, truyền tai nhau.","example":"It didn't take long for the news to get about- everyone's talking about it.","exampleTranslation":"Chẳng mất bao lâu để tin tức được truyền tai nhau - mọi người đều đang bàn tán về nó.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get across to":{"definition":"Gây ấn tượng tốt, thuyết phục được ai đó.","example":"How can I get across to my audience?","exampleTranslation":"Làm sao tôi có thể gây ấn tượng và thuyết phục được khán giả của mình?","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get after":{"definition":"Cằn nhằn hoặc thúc giục ai đó.","example":"You should get after them to finish the work.","exampleTranslation":"Bạn nên thúc giục họ hoàn thành công việc đi.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get along with":{"definition":"Hòa thuận, thân thiện với ai đó.","example":"I don't get along with my sister- we have nothing in common.","exampleTranslation":"Tôi không hòa thuận với chị gái mình - chúng tôi chẳng có điểm gì chung cả.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get around":{"definition":"Có quan hệ tình ái lăng nhăng.","example":"He gets around a bit; he's always with some new girlfriend.","exampleTranslation":"Anh ta có quan hệ lăng nhăng một chút; anh ta lúc nào cũng cặp kè với cô bạn gái mới nào đó.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get back at":{"definition":"Trả thù, trả đũa.","example":"I'll get back at her for landing me in trouble.","exampleTranslation":"Tôi sẽ trả đũa cô ta vì đã đẩy tôi vào rắc rối.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get back together":{"definition":"Quay lại với nhau (nối lại tình xưa).","example":"We split up a few months ago but got back together last week.","exampleTranslation":"Chúng tôi đã chia tay vài tháng trước nhưng đã quay lại với nhau vào tuần trước.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get down on":{"definition":"Chỉ trích, trách mắng.","example":"My mother used to get down on us for not doing enough homework.","exampleTranslation":"Mẹ tôi thường hay chỉ trích chúng tôi vì không làm đủ bài tập về nhà.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get in with":{"definition":"Trở nên thân thiết, lấy lòng.","example":"I tried to get in with them as I thought it would help me at work.","exampleTranslation":"Tôi đã cố gắng trở nên thân thiết với họ vì nghĩ rằng điều đó sẽ giúp ích cho công việc của mình.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get on at":{"definition":"Chỉ trích vô cớ, mắng mỏ.","example":"He's always getting on at me when I haven't done anything wrong.","exampleTranslation":"Anh ta luôn cằn nhằn mắng mỏ tôi dù tôi chẳng làm gì sai cả.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get onto":{"definition":"Liên lạc với ai đó để nhờ họ làm việc gì.","example":"We'd better get onto someone to fix this.","exampleTranslation":"Tốt hơn là chúng ta nên liên lạc với ai đó để sửa thứ này đi.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get through to":{"definition":"Liên lạc được với ai (đặc biệt qua điện thoại).","example":"I rang but couldn't get through to her.","exampleTranslation":"Tôi đã gọi nhưng không thể liên lạc được với cô ấy.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get to":{"definition":"Bắt đầu thảo luận một chủ đề.","example":"We asked him to get to the point, but he just waffled away.","exampleTranslation":"Chúng tôi đã yêu cầu anh ta đi thẳng vào vấn đề, nhưng anh ta cứ nói lan man.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"get together":{"definition":"Tụ tập, gặp gỡ.","example":"We got together in the pub for a drink.","exampleTranslation":"Chúng tôi đã tụ tập ở quán rượu để uống nước.","rootVerb":"get","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"gin up":{"definition":"Tăng cường, phóng đại.","example":"The candidates tried to gin up support at the straw poll by transporting their supporters for free.","exampleTranslation":"Các ứng cử viên đã cố gắng tăng cường sự ủng hộ tại cuộc thăm dò thử bằng cách vận chuyển người ủng hộ của họ miễn phí.","rootVerb":"gin","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"give it to":{"definition":"Chỉ trích thậm tệ hoặc trừng phạt.","example":"They really gave IT to me for forgetting to turn up.","exampleTranslation":"Họ đã chỉ trích tôi thậm tệ vì quên không đến.","rootVerb":"give","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"give it up for":{"definition":"Vỗ tay hoan hô.","example":"Please give IT up for our next guest.","exampleTranslation":"Xin hãy vỗ tay hoan hô vị khách tiếp theo của chúng ta.","rootVerb":"give","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"give it up to":{"definition":"Vỗ tay hoan hô.","example":"Please give IT up to our next guest.","exampleTranslation":"Xin hãy vỗ tay hoan hô vị khách tiếp theo của chúng ta.","rootVerb":"give","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"give over":{"definition":"Ngừng làm việc phiền phức.","example":"They were making a lot of noise so I told them to give over.","exampleTranslation":"Họ đang làm ồn quá mức nên tôi bảo họ hãy ngừng lại.","rootVerb":"give","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"gloss over":{"definition":"Che đậy, lấp liếm.","example":"The Minister tried to gloss over the report that was critical of her department.","exampleTranslation":"Bộ trưởng đã cố gắng lấp liếm bản báo cáo chỉ trích bộ của bà ấy.","rootVerb":"gloss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go along with":{"definition":"Chấp nhận một quyết định/gợi ý.","example":"I will go along with your plan for today.","exampleTranslation":"Tôi sẽ chấp nhận kế hoạch của bạn cho ngày hôm nay.","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go back on":{"definition":"Thất hứa.","example":"The government have gone back on their promise not to raise taxes.","exampleTranslation":"Chính phủ đã thất hứa về việc không tăng thuế.","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go down with":{"definition":"Được chấp nhận.","example":"Do you think the scheme will go down with the farmers in the area?","exampleTranslation":"Bạn có nghĩ là kế hoạch này sẽ được người nông dân trong vùng chấp nhận không?","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go on about":{"definition":"Nói quá nhiều.","example":"He's always going on about his kids.","exampleTranslation":"Anh ấy lúc nào cũng nói luyên thuyên về mấy đứa con của mình.","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go on at":{"definition":"Quấy rầy, cố gắng thuyết phục ai đó làm gì bằng cách liên tục yêu cầu.","example":"He went on at his parents until they bought him the game.","exampleTranslation":"Nó cứ cằn nhằn bố mẹ cho đến khi họ mua cho nó trò chơi đó.","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go out to":{"definition":"Cảm thấy cảm thông với ai đó.","example":"Our condolences go out to all the families who have lost people in this tragic accident.","exampleTranslation":"Chúng tôi xin gửi lời chia buồn sâu sắc tới tất cả các gia đình đã mất đi người thân trong vụ tai nạn thương tâm này.","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"go out with":{"definition":"Hẹn hò với.","example":"He's been going out with his girlfriend for around six months now.","exampleTranslation":"Anh ấy đã hẹn hò với bạn gái của mình được khoảng sáu tháng rồi.","rootVerb":"go","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"grind on":{"definition":"Nói lải nhải không ngừng.","example":"He was still grinding on about football when we left.","exampleTranslation":"Khi chúng tôi rời đi, anh ta vẫn còn đang lải nhải không ngừng về bóng đá.","rootVerb":"grind","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"grow apart":{"definition":"Trở nên xa cách do thời gian, khoảng cách, sở thích...","example":"We used to be good friends at school but have since grown apart.","exampleTranslation":"Chúng tôi từng là bạn tốt ở trường nhưng từ đó đến nay đã trở nên xa cách.","rootVerb":"grow","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"grow away from":{"definition":"Trở nên ít thân thiện hơn.","example":"I have grown away from many of the people I grew up with.","exampleTranslation":"Tôi đã dần trở nên ít thân thiết hơn với nhiều người mà tôi từng lớn lên cùng.","rootVerb":"grow","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"grow together":{"definition":"Dần trở nên gắn bó, đoàn kết hoặc thân thiết.","example":"We grew together while we were working on the same project.","exampleTranslation":"Chúng tôi đã dần trở nên gắn bó hơn trong thời gian cùng làm việc trong một dự án.","rootVerb":"grow","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hand on":{"definition":"Truyền tải kiến thức cho thế hệ tiếp theo.","example":"The secrets have been handed on from generation to generation.","exampleTranslation":"Những bí mật đó đã được truyền lại từ thế hệ này sang thế hệ khác.","rootVerb":"hand","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hang on":{"definition":"Chờ đợi.","example":"Please hang on for a minute while I check.","exampleTranslation":"Làm ơn hãy đợi một chút trong khi tôi kiểm tra.","rootVerb":"hang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hang up on":{"definition":"Dập máy với ai đó.","example":"A telesales person called, so I said something rude and hung up on them.","exampleTranslation":"Một nhân viên bán hàng qua điện thoại gọi tới, nên tôi đã nói vài câu khiếm nhã rồi dập máy với họ.","rootVerb":"hang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hang with":{"definition":"Dành thời gian cho.","example":"He has been hanging with them for a few months.","exampleTranslation":"Anh ấy đã dành thời gian chơi với họ được vài tháng rồi.","rootVerb":"hang","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"harp on":{"definition":"Nói đi nói lại về một vấn đề.","example":"I was late twice last week and my boss keeps harping on about it.","exampleTranslation":"Tôi đã đi trễ hai lần vào tuần trước và sếp tôi cứ nói đi nói lại về chuyện đó.","rootVerb":"harp","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"have it out with":{"definition":"Thảo luận hoặc tranh luận một vấn đề để cải thiện tình hình.","example":"I'd been worried for ages, so I decided to have IT out with them.","exampleTranslation":"Tôi đã lo lắng từ lâu, nên tôi quyết định sẽ nói chuyện thẳng thắn với họ để giải quyết vấn đề.","rootVerb":"have","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"have on":{"definition":"Biết điều gì đó về ai đó có thể làm hại họ.","example":"I have a lot on him because we used to work together.","exampleTranslation":"Tôi nắm giữ nhiều thông tin bất lợi về anh ta vì chúng tôi từng làm việc cùng nhau.","rootVerb":"have","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hear about":{"definition":"Lấy thông tin.","example":"Have you heard about the company takeover?","exampleTranslation":"Bạn đã nghe tin về vụ mua lại công ty chưa?","rootVerb":"hear","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hear from":{"definition":"Nhận cuộc gọi, email, thư hoặc phương tiện liên lạc khác từ ai đó.","example":"I haven't heard from them since we left university.","exampleTranslation":"Tôi đã không nhận được tin tức gì từ họ kể từ khi chúng tôi rời đại học.","rootVerb":"hear","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hear out":{"definition":"Lắng nghe mọi điều ai đó phải nói.","example":"I heard them out before I commented.","exampleTranslation":"Tôi đã lắng nghe hết mọi điều họ nói trước khi tôi đưa ra bình luận.","rootVerb":"hear","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit back":{"definition":"Tấn công hoặc chỉ trích.","example":"The president hit back at her critics in a speech last night.","exampleTranslation":"Tổng thống đã chỉ trích lại những người phản đối mình trong một bài phát biểu tối qua.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit it off":{"definition":"Có mối quan hệ tốt ngay từ lần đầu gặp mặt.","example":"We hit IT off immediately and became firm friends.","exampleTranslation":"Chúng tôi đã nhanh chóng thân thiết ngay từ lần đầu gặp mặt và trở thành bạn thân.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit it off with":{"definition":"Thích ai đó ngay từ lần đầu gặp mặt.","example":"I hit IT off with her immediately.","exampleTranslation":"Tôi đã có cảm tình với cô ấy ngay từ lần đầu gặp mặt.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit on":{"definition":"Nói chuyện với ai đó để cố gắng thu hút họ về mặt tình dục.","example":"She hit on him at the party and they went back to her house.","exampleTranslation":"Cô ấy đã tán tỉnh anh ta tại bữa tiệc và họ đã cùng nhau về nhà cô ấy.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit out at":{"definition":"Đáp trả lại lời chỉ trích một cách tức giận.","example":"The government hit out at the media for their negativity.","exampleTranslation":"Chính phủ đã phản đối lại giới truyền thông vì thái độ tiêu cực của họ.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit upon":{"definition":"Cố gắng thu hút ai đó về mặt tình dục.","example":"He tried to hit upon her at the pub.","exampleTranslation":"Anh ta đã cố gắng tán tỉnh cô ấy tại quán rượu.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hit with":{"definition":"Làm ai đó ngạc nhiên với thông tin hoặc tin tức nào đó.","example":"He hit me with the details of their demands.","exampleTranslation":"Anh ấy làm tôi ngạc nhiên khi đưa ra các chi tiết về yêu cầu của họ.","rootVerb":"hit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hold forth":{"definition":"Trình bày ý kiến của bạn về điều gì đó, đặc biệt là khi nói trong một thời gian dài và nhàm chán.","example":"The manager held forth on the topic for about twenty minutes.","exampleTranslation":"Người quản lý đã trình bày ý kiến về chủ đề đó trong khoảng hai mươi phút.","rootVerb":"hold","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hold out on":{"definition":"Không trả tiền cho ai đó hoặc cung cấp cho họ thông tin.","example":"He's been holding out on me for weeks and I really need the money.","exampleTranslation":"Anh ta đã giấu tôi chuyện tiền bạc suốt mấy tuần rồi mà tôi thì thực sự cần số tiền đó.","rootVerb":"hold","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hold with":{"definition":"Chấp nhận (thường ở dạng phủ định).","example":"I don't hold with their plans.","exampleTranslation":"Tôi không tán thành với kế hoạch của họ.","rootVerb":"hold","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hook into":{"definition":"Thuyết phục ai đó làm điều gì đó họ không muốn làm.","example":"She hooked them into coming after all.","exampleTranslation":"Cuối cùng thì cô ấy cũng thuyết phục được họ tham gia.","rootVerb":"hook","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"hook up":{"definition":"Gặp ai đó.","example":"We hooked up at the conference.","exampleTranslation":"Chúng tôi đã gặp nhau tại hội nghị.","rootVerb":"hook","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"jabber away":{"definition":"Nói nhanh hoặc không thể hiểu được.","example":"They started jabbering away about file systems and lost me completely.","exampleTranslation":"Họ bắt đầu nói luyên thuyên về các hệ thống tệp tin và tôi hoàn toàn không hiểu gì cả.","rootVerb":"jabber","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"jaw away":{"definition":"Nói chuyện chỉ vì mục đích nói chuyện chứ không phải để nói bất cứ điều gì.","example":"That shows that your interest is not in helping the student, but in jawing away.","exampleTranslation":"Điều đó cho thấy bạn không có ý định giúp đỡ sinh viên mà chỉ đang nói chuyện phiếm vô bổ.","rootVerb":"jaw","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"joke around":{"definition":"Hài hước, hoặc cố gắng để được như vậy.","example":"He's always joking around in class.","exampleTranslation":"Anh ấy lúc nào cũng hay đùa giỡn trong lớp.","rootVerb":"joke","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"jump in":{"definition":"Tham gia vào một cuộc trò chuyện.","example":"He jumped in and told them exactly what he thought.","exampleTranslation":"Anh ấy đã chen ngang vào cuộc trò chuyện và nói thẳng cho họ biết suy nghĩ của mình.","rootVerb":"jump","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"jump on":{"definition":"Chỉ trích, tấn công.","example":"Everyone jumped on me when I raised the issue.","exampleTranslation":"Mọi người đã chỉ trích tôi ngay khi tôi nêu vấn đề đó ra.","rootVerb":"jump","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"keep off":{"definition":"Không nói về.","example":"Please keep off the topic during this meeting.","exampleTranslation":"Xin đừng thảo luận về chủ đề đó trong cuộc họp này.","rootVerb":"keep","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"kick about":{"definition":"Thảo luận.","example":"We kicked the idea about at the meeting.","exampleTranslation":"Chúng tôi đã thảo luận ý tưởng đó trong cuộc họp.","rootVerb":"kick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"kick around":{"definition":"Thảo luận.","example":"We kicked the idea around.","exampleTranslation":"Chúng tôi đã thảo luận về ý tưởng đó.","rootVerb":"kick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"kick around with":{"definition":"Dành thời gian cho.","example":"I used to kick around with them, but haven't seen them for a while.","exampleTranslation":"Tôi từng dành thời gian đi chơi với họ, nhưng đã lâu rồi không gặp.","rootVerb":"kick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"kick off":{"definition":"Tranh cãi, phản đối và từ chối hợp tác.","example":"He started kicking off big time when the police tried to arrest him.","exampleTranslation":"Anh ta đã bắt đầu tranh cãi dữ dội khi cảnh sát cố gắng bắt giữ anh ta.","rootVerb":"kick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"kiss off":{"definition":"Coi điều gì đó là không quan trọng hoặc kém cỏi.","example":"He kissed off the criticism.","exampleTranslation":"Anh ấy coi thường những lời chỉ trích đó.","rootVerb":"kiss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"kiss up to":{"definition":"Cố gắng lấy lòng ai đó.","example":"He's a creep and is always kissing up to the director.","exampleTranslation":"Hắn ta là một kẻ thấp hèn và luôn tìm cách lấy lòng vị giám đốc.","rootVerb":"kiss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"knock around":{"definition":"Thảo luận một cách thoải mái.","example":"We knocked the idea around a bit, but decided not to bother.","exampleTranslation":"Chúng tôi đã thảo luận qua loa về ý tưởng đó, nhưng quyết định không bận tâm đến nó nữa.","rootVerb":"knock","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lash into":{"definition":"Chỉ trích ai đó mạnh mẽ.","example":"He lashed into them for messing thins up.","exampleTranslation":"Anh ấy đã chỉ trích họ thậm tệ vì làm mọi thứ rối tung lên.","rootVerb":"lash","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lash out against":{"definition":"Chỉ trích điều gì đó mạnh mẽ.","example":"The press has lashed out against the policy.","exampleTranslation":"Báo chí đã chỉ trích mạnh mẽ chính sách này.","rootVerb":"lash","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lash out at":{"definition":"Bất ngờ đánh ai đó hoặc cố gắng đánh họ.","example":"He lashed out at me when I laughed at him.","exampleTranslation":"Anh ta đã bất ngờ tấn công tôi khi tôi cười nhạo anh ta.","rootVerb":"lash","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lay into":{"definition":"Chỉ trích một cách tức giận.","example":"His partner laid into him when he arrived two hours late.","exampleTranslation":"Đối tác của anh ấy đã chỉ trích anh ấy một cách giận dữ khi anh ấy đến trễ hai tiếng.","rootVerb":"lay","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lead on":{"definition":"Gieo rắc hy vọng hão huyền.","example":"She LED him on about her desire to get married.","exampleTranslation":"Cô ấy đã gieo cho anh ta hy vọng hão huyền về ý muốn kết hôn của cô.","rootVerb":"lead","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"leak out":{"definition":"Bị lộ ra ngoài.","example":"The company's plans to close the factory leaked out and they were very embarrassed.","exampleTranslation":"Kế hoạch đóng cửa nhà máy của công ty đã bị lộ ra ngoài và họ cảm thấy vô cùng xấu hổ.","rootVerb":"leak","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lean on":{"definition":"Gây áp lực lên ai đó để họ làm theo ý mình.","example":"The government has denied leaning on the Attorney General to get his approval of the war.","exampleTranslation":"Chính phủ đã phủ nhận việc gây áp lực lên Bộ trưởng Tư pháp để đạt được sự chấp thuận của ông ta về cuộc chiến.","rootVerb":"lean","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"let down":{"definition":"Làm thất vọng, không giữ đúng hẹn.","example":"She failed to turn up and I felt badly let down.","exampleTranslation":"Cô ấy đã không đến như đã hứa và tôi cảm thấy rất thất vọng.","rootVerb":"let","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"let on":{"definition":"Tiết lộ bí mật.","example":"I didn't mean to let on about the party; I just said it without thinking.","exampleTranslation":"Tôi không cố ý tiết lộ về bữa tiệc; tôi chỉ lỡ lời nói ra mà không suy nghĩ.","rootVerb":"let","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"link up with":{"definition":"Liên lạc hoặc kết nối với ai đó.","example":"We linked up with the firm over the web.","exampleTranslation":"Chúng tôi đã liên lạc với công ty đó qua mạng.","rootVerb":"link","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"listen up":{"definition":"Lắng nghe đây (thường dùng như một mệnh lệnh).","example":"Listen up, men! Here are your new assignments.","exampleTranslation":"Nghe đây, các anh! Đây là những nhiệm vụ mới của các anh.","rootVerb":"listen","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"look down on":{"definition":"Khinh thường.","example":"You should not look down on people who struggle.","exampleTranslation":"Bạn không nên khinh thường những người đang gặp khó khăn.","rootVerb":"look","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"look up to":{"definition":"Tôn trọng, ngưỡng mộ.","example":"She looks up to her mother.","exampleTranslation":"Cô ấy rất ngưỡng mộ mẹ mình.","rootVerb":"look","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"lord it over":{"definition":"Cư xử bề trên.","example":"She loves to lord IT over her employees.","exampleTranslation":"Cô ấy thích cư xử bề trên với nhân viên của mình.","rootVerb":"lord","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"make it up to":{"definition":"Cố gắng đền bù vì đã làm sai điều gì.","example":"He tried to make IT up to her, but she wouldn't speak to him.","exampleTranslation":"Anh ấy đã cố gắng đền bù cho cô ấy, nhưng cô ấy không chịu nói chuyện với anh.","rootVerb":"make","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"make out":{"definition":"Hiểu bản chất hoặc tính cách của ai đó.","example":"He's strange; I can't make him out.","exampleTranslation":"Anh ta thật kỳ lạ; tôi không thể hiểu nổi bản chất của anh ta.","rootVerb":"make","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"make peace with":{"definition":"Làm hòa với ai; chấp nhận thanh thản một thực tế khó khăn.","example":"After years of dispute, the two neighbors finally made peace with each other.","exampleTranslation":"Sau nhiều năm tranh chấp, hai người hàng xóm cuối cùng đã làm hòa với nhau.","rootVerb":"make","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"make with":{"definition":"Đưa ra (thường dùng làm mệnh lệnh).","example":"Make with the money you owe me.","exampleTranslation":"Hãy đưa số tiền mà bạn nợ tôi đây.","rootVerb":"make","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"mess about":{"definition":"Đối xử tệ với ai đó.","example":"He is always messing me about and never does what he promises.","exampleTranslation":"Hắn luôn đối xử tệ với tôi và chẳng bao giờ làm đúng những gì hắn hứa.","rootVerb":"mess","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"mess over":{"definition":"Đối xử tệ.","example":"They messed her over when she applied for the job.","exampleTranslation":"Họ đã đối xử tệ với cô ấy khi cô ấy nộp đơn xin việc.","rootVerb":"mess","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"mouth off":{"definition":"Nói to hoặc giận dữ về điều gì.","example":"I always get angry and start mouthing off when the news is on TV.","exampleTranslation":"Tôi luôn nổi nóng và bắt đầu nói to, giận dữ mỗi khi có tin tức trên TV.","rootVerb":"mouth","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"naff off":{"definition":"Biến đi.","example":"He was making a fuss, so I told him to naff off.","exampleTranslation":"Anh ta cứ làm ầm ĩ, nên tôi bảo anh ta hãy biến đi.","rootVerb":"naff","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"nag at":{"definition":"Cằn nhằn ai đó liên tục.","example":"My boss is always nagging at me about my arriving a few minutes late for work.","exampleTranslation":"Sếp tôi luôn cằn nhằn về việc tôi đi làm muộn vài phút.","rootVerb":"nag","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"own up":{"definition":"Thú nhận.","example":"Nobody owned up to breaking the window.","exampleTranslation":"Không ai thú nhận việc làm vỡ cửa sổ cả.","rootVerb":"own","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pack in":{"definition":"Chấm dứt một mối quan hệ.","example":"She packed her boyfriend in.","exampleTranslation":"Cô ấy đã chấm dứt mối quan hệ với bạn trai.","rootVerb":"pack","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pack it in":{"definition":"Dừng làm việc gì đó (dùng như một mệnh lệnh).","example":"The kids were making a fuss, so I told them to pack IT in.","exampleTranslation":"Lũ trẻ cứ làm ầm ĩ, nên tôi bảo chúng hãy dừng lại ngay.","rootVerb":"pack","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pair off":{"definition":"Giới thiệu mọi người với hy vọng họ sẽ bắt đầu một mối quan hệ.","example":"I tried to pair him off with my sister.","exampleTranslation":"Tôi đã cố gắng giới thiệu anh ấy với em gái mình.","rootVerb":"pair","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pair off with":{"definition":"Ghép cặp với ai đó.","example":"I paired off with Trish for the test.","exampleTranslation":"Tôi đã ghép cặp với Trish để làm bài kiểm tra.","rootVerb":"pair","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pal about":{"definition":"Thân thiện và dành thời gian với ai đó.","example":"We used to pal about when we were at school.","exampleTranslation":"Chúng tôi từng rất thân và dành thời gian cho nhau khi còn đi học.","rootVerb":"pal","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pass around":{"definition":"Phát cho mọi người ở đó.","example":"Please pass around the snacks to everyone in class.","exampleTranslation":"Làm ơn hãy phát đồ ăn nhẹ cho mọi người trong lớp.","rootVerb":"pass","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pass off":{"definition":"Diễn ra theo một cách nhất định.","example":"The demonstration passed off peacefully.","exampleTranslation":"Cuộc biểu tình đã diễn ra một cách hòa bình.","rootVerb":"pass","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pass on":{"definition":"Truyền đạt một tin nhắn cho ai đó.","example":"I'll pass the message on when she gets here.","exampleTranslation":"Tôi sẽ truyền đạt lại tin nhắn đó khi cô ấy đến đây.","rootVerb":"pass","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pass on to":{"definition":"Chuyển sang chủ đề khác.","example":"Let's pass on to the next item on the agenda.","exampleTranslation":"Hãy chuyển sang mục tiếp theo trong chương trình nghị sự.","rootVerb":"pass","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pick on":{"definition":"Làm phiền, chọc tức, chỉ trích hoặc chế nhạo ai đó.","example":"My friends always pick on me because I don't sing well.","exampleTranslation":"Bạn bè luôn chọc tức tôi vì tôi hát không hay.","rootVerb":"pick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pick up on":{"definition":"Bình luận về một điều gì đó đã nói trước đó trong một cuộc trò chuyện.","example":"I'd like to pick up on the point that Jill made.","exampleTranslation":"Tôi muốn bình luận thêm về điểm mà Jill đã nêu ra.","rootVerb":"pick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pig off":{"definition":"Được sử dụng để bảo ai đó cút đi hoặc để bạn yên.","example":"He told them to pig off and leave him in peace.","exampleTranslation":"Anh ta bảo bọn họ hãy cút đi và để anh ta được yên.","rootVerb":"pig","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pipe down":{"definition":"Im lặng (thường dùng như mệnh lệnh).","example":"The lecturer asked the students to pipe down and pay attention.","exampleTranslation":"Giảng viên yêu cầu sinh viên hãy im lặng và chú ý.","rootVerb":"pipe","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pipe up":{"definition":"Lên tiếng, nói to.","example":"At first, no one answered, then finally someone piped up.","exampleTranslation":"Lúc đầu, không ai trả lời, rồi cuối cùng ai đó cũng lên tiếng.","rootVerb":"pipe","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pitch into":{"definition":"Chỉ trích gay gắt hoặc tấn công ai đó.","example":"The shareholders pitched into the management about their pay rises at the meeting.","exampleTranslation":"Các cổ đông đã chỉ trích gay gắt ban quản lý về việc tăng lương của họ tại cuộc họp.","rootVerb":"pitch","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"play along":{"definition":"Giả vờ đồng ý hoặc chấp nhận điều gì đó để làm ai đó vui hoặc để lấy thêm thông tin.","example":"I disagreed with the idea but I had to play along because everyone else liked it.","exampleTranslation":"Tôi không đồng ý với ý kiến đó nhưng tôi phải giả vờ đồng ý vì mọi người khác đều thích nó.","rootVerb":"play","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"play around":{"definition":"Lăng nhăng hoặc không chung thủy.","example":"I played around a lot at college.","exampleTranslation":"Tôi đã lăng nhăng rất nhiều hồi học đại học.","rootVerb":"play","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"play down":{"definition":"Cố gắng làm cho một cái gì đó có vẻ ít quan trọng hơn.","example":"The Government has tried to play down the importance of the minister's resignation.","exampleTranslation":"Chính phủ đã cố gắng làm cho tầm quan trọng của việc từ chức của bộ trưởng có vẻ ít quan trọng hơn.","rootVerb":"play","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"play off":{"definition":"Khiến mọi người cạnh tranh với nhau để bạn được hưởng lợi.","example":"He played them off against each other to get the best deal.","exampleTranslation":"Anh ta khiến họ cạnh tranh lẫn nhau để có được thỏa thuận tốt nhất.","rootVerb":"play","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"poop out on":{"definition":"Không đến chỗ hẹn.","example":"We were supposed to meet yesterday, but she pooped out on me at the last minute.","exampleTranslation":"Chúng tôi đã định gặp nhau ngày hôm qua, nhưng cô ấy đã không đến chỗ hẹn vào phút chót.","rootVerb":"poop","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pop off":{"definition":"Nói to, phàn nàn.","example":"He's always popping off when things don't suit him.","exampleTranslation":"Anh ta luôn miệng phàn nàn khi mọi việc không theo ý mình.","rootVerb":"pop","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pour forth":{"definition":"Tuôn ra","example":"Useless statistics pour forth from him.","exampleTranslation":"Những số liệu thống kê vô ích tuôn ra từ miệng anh ta.","rootVerb":"pour","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"prattle on":{"definition":"Nói quá nhiều","example":"Geoff just prattled on instead of giving a straight answer.","exampleTranslation":"Geoff cứ nói dông dài thay vì đưa ra một câu trả lời trực tiếp.","rootVerb":"prattle","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"press upon":{"definition":"Gây áp lực buộc ai đó chấp nhận điều gì được đề nghị.","example":"The invitations were pressed upon us and it was hard to say no.","exampleTranslation":"Những lời mời đã được ép buộc chúng tôi chấp nhận và thật khó để nói lời từ chối.","rootVerb":"press","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"pull for":{"definition":"Ủng hộ.","example":"Who will you be pulling for in the final?","exampleTranslation":"Bạn sẽ ủng hộ ai trong trận chung kết?","rootVerb":"pull","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"put across":{"definition":"Truyền đạt, giao tiếp một thông điệp.","example":"He found it difficult to put across what he wanted to say at the meeting.","exampleTranslation":"Anh ấy thấy khó khăn trong việc truyền đạt những gì mình muốn nói tại cuộc họp.","rootVerb":"put","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"put over":{"definition":"Thực hiện thành công (một mánh khóe, trò lừa, v.v.).","example":"They put over a clever practical joke on us.","exampleTranslation":"Họ đã thực hiện thành công một trò đùa tinh quái với chúng tôi.","rootVerb":"put","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"quarrel out":{"definition":"Cãi nhau với ai về một chủ đề cụ thể.","example":"The girl's mother was quarreling out with her daughter about the party.","exampleTranslation":"Mẹ cô gái đã cãi nhau với con gái về bữa tiệc.","rootVerb":"quarrel","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"quarrel with":{"definition":"Tranh chấp hoặc không đồng ý với cái gì.","example":"I do not want to quarrel with your decision.","exampleTranslation":"Tôi không muốn tranh chấp với quyết định của bạn.","rootVerb":"quarrel","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"quit on":{"definition":"Bỏ rơi ai đó khi họ cần hỗ trợ.","example":"They quit on me just when things got rough.","exampleTranslation":"Họ bỏ rơi tôi ngay khi mọi việc trở nên khó khăn.","rootVerb":"quit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rack off":{"definition":"Dùng để bảo ai đó biến đi vì họ đang làm phiền bạn.","example":"He told her to rack off.","exampleTranslation":"Anh ta bảo cô ấy biến đi.","rootVerb":"rack","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rake over":{"definition":"Nhắc lại, khơi lại những chuyện tiêu cực trong quá khứ.","example":"They keep raking over the rows we had last year.","exampleTranslation":"Họ cứ nhắc lại những cuộc tranh cãi mà chúng tôi đã có năm ngoái.","rootVerb":"rake","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rake up":{"definition":"Gợi lại sự chú ý vào việc gì đó.","example":"The press have raked up some scandals from her past.","exampleTranslation":"Báo chí đã khơi lại một số vụ bê bối từ quá khứ của cô ấy.","rootVerb":"rake","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ramble on":{"definition":"Nói dông dài không đi vào trọng tâm.","example":"Quit rambling on- I’m tired of listening to you.","exampleTranslation":"Đừng nói dông dài nữa - tôi mệt mỏi khi phải nghe bạn rồi.","rootVerb":"ramble","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rat on":{"definition":"Thất hứa.","example":"He always rats on his promises.","exampleTranslation":"Anh ta luôn thất hứa.","rootVerb":"rat","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rattle off":{"definition":"Trích dẫn số liệu một cách nhanh chóng.","example":"She rattled off loads of statistics which nobody could understand.","exampleTranslation":"Cô ấy đã trích dẫn một loạt các số liệu mà không ai có thể hiểu được.","rootVerb":"rattle","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"reach out":{"definition":"Chìa tay ra để lấy cái gì.","example":"I reached out and caught the ball.","exampleTranslation":"Tôi đã chìa tay ra và bắt được quả bóng.","rootVerb":"reach","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"reach out to":{"definition":"Cố gắng giao tiếp và thiết lập mối quan hệ tốt.","example":"The candidates are reaching out to the poor to get their votes.","exampleTranslation":"Các ứng cử viên đang cố gắng tiếp cận những người nghèo để giành lấy phiếu bầu của họ.","rootVerb":"reach","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"read off":{"definition":"Đọc to một danh sách để ai đó viết lại.","example":"I read off the figures and she wrote them down in her notebook.","exampleTranslation":"Tôi đọc to các số liệu và cô ấy viết chúng xuống cuốn sổ của mình.","rootVerb":"read","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"read out":{"definition":"Đọc to thay vì đọc nhẩm.","example":"The teacher read out the names of the students who'd passed.","exampleTranslation":"Giáo viên đã đọc to tên của những học sinh đã đỗ.","rootVerb":"read","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"reel off":{"definition":"Ghi nhiều điểm hoặc thắng nhiều ván liên tiếp.","example":"They reeled off five victories and became the champions.","exampleTranslation":"Họ đã giành năm chiến thắng liên tiếp và trở thành nhà vô địch.","rootVerb":"reel","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ring back":{"definition":"Gọi điện thoại lại.","example":"I phoned and left a message this morning but she still hasn't rung me back.","exampleTranslation":"Tôi đã gọi điện và để lại tin nhắn sáng nay nhưng cô ấy vẫn chưa gọi lại cho tôi.","rootVerb":"ring","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ring in":{"definition":"Gọi điện để báo hoặc xác nhận.","example":"I rang in and told them I would be late.","exampleTranslation":"Tôi đã gọi điện vào để báo rằng tôi sẽ đến muộn.","rootVerb":"ring","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ring off":{"definition":"Kết thúc cuộc điện thoại.","example":"Dave rang off guiltily when he saw his boss coming.","exampleTranslation":"Dave kết thúc cuộc điện thoại một cách tội lỗi khi anh ta thấy sếp mình đến.","rootVerb":"ring","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ring out":{"definition":"Tạo ra âm thanh lớn đột ngột.","example":"Two shots rang out and then we heard a scream.","exampleTranslation":"Hai tiếng súng vang lên đột ngột và sau đó chúng tôi nghe thấy một tiếng hét.","rootVerb":"ring","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"row back":{"definition":"Rút lui khỏi một vị trí.","example":"The prime minister refused to row back and lost the vote.","exampleTranslation":"Thủ tướng đã từ chối rút lui khỏi vị trí của mình và đã thua trong cuộc bỏ phiếu.","rootVerb":"row","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rub along":{"definition":"Có một mối quan hệ khá tốt.","example":"They're not friends, but we rub along.","exampleTranslation":"Họ không phải là bạn, nhưng chúng tôi vẫn có mối quan hệ khá tốt.","rootVerb":"rub","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"rub off on":{"definition":"Truyền một phẩm chất hoặc đặc điểm cho mọi người.","example":"His enthusiasm rubs off on everyone around him.","exampleTranslation":"Sự nhiệt tình của anh ấy truyền sang cho mọi người xung quanh.","rootVerb":"rub","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"run after":{"definition":"Cố gắng gắn bó lãng mạn với ai đó.","example":"He was running after her for ages never managed to get a date.","exampleTranslation":"Anh ta đã cố gắng tán tỉnh cô ấy suốt một thời gian dài nhưng không bao giờ có được một buổi hẹn hò.","rootVerb":"run","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"run along":{"definition":"Đi đi, rời đi (thường được dùng như một câu mệnh lệnh).","example":"They kept disturbing him, so he told them to run along and leave him in peace.","exampleTranslation":"Họ cứ làm phiền anh ấy, nên anh ấy bảo họ hãy đi đi và để anh ấy được yên tĩnh.","rootVerb":"run","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"run with":{"definition":"Giữ mối quan hệ, thường là xấu.","example":"She runs with some dodgy characters.","exampleTranslation":"Cô ấy có mối quan hệ với một vài kẻ đáng nghi.","rootVerb":"run","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sail into":{"definition":"Chỉ trích một cách tức giận.","example":"He sailed into me for turning up an hour late.","exampleTranslation":"Anh ta chỉ trích tôi một cách giận dữ vì đã đến muộn một tiếng.","rootVerb":"sail","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"see out":{"definition":"Tiễn khách ra đến cửa trước khi họ rời khỏi nhà bạn.","example":"Are you sure you're going? I'll get your coats and see you out.","exampleTranslation":"Bạn chắc chắn là mình sẽ đi sao? Tôi sẽ lấy áo khoác của bạn và tiễn bạn ra cửa.","rootVerb":"see","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"send for":{"definition":"Yêu cầu ai đó đến giúp đỡ.","example":"I had to send for a plumber because the radiator was leaking.","exampleTranslation":"Tôi phải gọi thợ sửa ống nước đến vì bộ tản nhiệt bị rò rỉ.","rootVerb":"send","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"send out":{"definition":"Gửi một cái gì đó cho nhiều người.","example":"They sent out a mailshot to all their existing customers.","exampleTranslation":"Họ đã gửi thư quảng cáo cho tất cả khách hàng hiện tại của họ.","rootVerb":"send","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"send up":{"definition":"Bắt chước/đóng giả vì mục đích gây cười.","example":"The mischievous schoolboy was standing at the front of the class, sending the teacher up, when the teacher opened the door behind him.","exampleTranslation":"Cậu nam sinh tinh nghịch đang đứng trước lớp, chế giễu giáo viên, thì giáo viên mở cửa ngay sau lưng cậu ta.","rootVerb":"send","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"set forth":{"definition":"Nêu ra hoặc phác thảo một ý kiến.","example":"He set forth his ideas in his autobiography.","exampleTranslation":"Ông ấy đã trình bày các ý tưởng của mình trong cuốn tự truyện của ông.","rootVerb":"set","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sex up":{"definition":"Thêm thắt thông tin để làm cho nó hấp dẫn hơn với người đọc hoặc người nghe.","example":"They tried to sex up the news with extra details.","exampleTranslation":"Họ đã cố gắng làm cho tin tức trở nên hấp dẫn hơn bằng những chi tiết bổ sung.","rootVerb":"sex","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"shout down":{"definition":"Gây nhiều tiếng ồn để át tiếng ai đó.","example":"His efforts to raise the issue were shouted down.","exampleTranslation":"Những nỗ lực của anh ấy nhằm nêu ra vấn đề đã bị át đi bởi tiếng la ó.","rootVerb":"shout","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"shout out":{"definition":"Nói to điều gì đó, thường là để thu hút sự chú ý của ai đó.","example":"She shouted out my name.","exampleTranslation":"Cô ấy đã gọi to tên tôi.","rootVerb":"shout","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"show out":{"definition":"Tiễn ai đó ra khỏi phòng hoặc tòa nhà.","example":"Her secretary showed me out after the interview.","exampleTranslation":"Thư ký của cô ấy đã tiễn tôi ra ngoài sau buổi phỏng vấn.","rootVerb":"show","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"side with":{"definition":"Ủng hộ ai đó.","example":"The lecturer sided with her students and got sacked for her pains.","exampleTranslation":"Giảng viên đã đứng về phía sinh viên của mình và bị sa thải vì những nỗ lực đó.","rootVerb":"side","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sidle up to":{"definition":"Lén lút tiến tới gần ai đó.","example":"He sidled up to me and whispered his name.","exampleTranslation":"Anh ta lén lút tiến lại gần tôi và thì thầm tên mình.","rootVerb":"sidle","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sing out":{"definition":"Trả lời to.","example":"When you hear your name, sing out!","exampleTranslation":"Khi bạn nghe thấy tên mình, hãy trả lời thật to!","rootVerb":"sing","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sing up":{"definition":"Hát to hơn.","example":"We can't hear you- sing up.","exampleTranslation":"Chúng tôi không thể nghe thấy bạn - hãy hát to lên.","rootVerb":"sing","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"snitch on":{"definition":"Tiết lộ bí mật, tố giác ai đó với nhà chức trách.","example":"Reggie was caught after someone snitched on him to the teacher.","exampleTranslation":"Reggie đã bị bắt sau khi có ai đó mách lẻo với giáo viên về cậu ta.","rootVerb":"snitch","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"soften up":{"definition":"Làm những việc để làm hài lòng ai đó với hy vọng họ sẽ làm điều bạn muốn.","example":"I paid for everything to soften them up before they made the decision.","exampleTranslation":"Tôi đã chi trả cho mọi thứ để lấy lòng họ trước khi họ đưa ra quyết định.","rootVerb":"soften","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sound off":{"definition":"Bày tỏ ý kiến của mình một cách mạnh mẽ.","example":"He sounded off about the quality of the food.","exampleTranslation":"Anh ấy đã bày tỏ ý kiến một cách mạnh mẽ về chất lượng đồ ăn.","rootVerb":"sound","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"sound out":{"definition":"Kiểm tra xem ai đó nghĩ gì về một vấn đề, ý tưởng, v.v.","example":"You should sound her out to get her opinion before you go ahead with the plan.","exampleTranslation":"Bạn nên thăm dò ý kiến cô ấy để biết cô ấy nghĩ gì trước khi bạn tiếp tục thực hiện kế hoạch.","rootVerb":"sound","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"speak out":{"definition":"Nói chuyện cởi mở và tự do.","example":"People are afraid to speak out in oppressive political regimes.","exampleTranslation":"Mọi người e sợ việc lên tiếng trong các chế độ chính trị áp bức.","rootVerb":"speak","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"spell out":{"definition":"Viết hoặc đọc từng chữ cái tạo thành một từ.","example":"I had to spell my surname out to him as he didn't know how to spell it.","exampleTranslation":"Tôi phải đánh vần từng chữ họ tên cho anh ta vì anh ta không biết cách viết.","rootVerb":"spell","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"spit it out":{"definition":"Một cách không chính thức để bảo ai đó nói điều họ không muốn nói.","example":"Hurry up, spit IT out! I can't wait all day for the truth.","exampleTranslation":"Nhanh lên, nói ra đi! Tôi không thể đợi cả ngày để biết sự thật.","rootVerb":"spit","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"split up":{"definition":"Kết thúc một mối quan hệ.","example":"They are always splitting up and then getting back together again.","exampleTranslation":"Họ luôn chia tay rồi sau đó lại quay lại với nhau.","rootVerb":"split","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"stand for":{"definition":"Chấp nhận hoặc tha thứ cho hành vi.","example":"I'm not going to stand for their rudeness any longer.","exampleTranslation":"Tôi sẽ không chịu đựng sự thô lỗ của họ thêm nữa.","rootVerb":"stand","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"stand up to":{"definition":"Giữ vững các nguyên tắc của mình khi bị thách thức bởi một cơ quan có thẩm quyền.","example":"She stood up to the police when they tried to corrupt her.","exampleTranslation":"Cô ấy đã giữ vững lập trường trước cảnh sát khi họ cố gắng lôi kéo cô tham gia vào hành vi tham nhũng.","rootVerb":"stand","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"stare down":{"definition":"Nhìn chằm chằm ai đó cho đến khi họ không thể nhìn bạn.","example":"He was angry but I stared him down and he left without saying much.","exampleTranslation":"Anh ấy đã rất giận dữ nhưng tôi nhìn chằm chằm lại khiến anh ta phải bỏ đi mà không nói được gì nhiều.","rootVerb":"stare","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"start on at":{"definition":"Chỉ trích hoặc cằn nhằn.","example":"He started on at me for being late.","exampleTranslation":"Anh ấy bắt đầu cằn nhằn tôi vì tội đi muộn.","rootVerb":"start","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"step to":{"definition":"Trò chuyện, nói chuyện với.","example":"He tried to step to her in the bar.","exampleTranslation":"Anh ta đã cố gắng tiếp cận để nói chuyện với cô ấy trong quán bar.","rootVerb":"step","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"stick by":{"definition":"Ủng hộ một kế hoạch, quan điểm hoặc quyết định.","example":"They are sticking by their claims.","exampleTranslation":"Họ vẫn đang kiên quyết bảo vệ những khẳng định của mình.","rootVerb":"stick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"stick together":{"definition":"Hỗ trợ lẫn nhau.","example":"If we don't stick together, things will be much worse for all of us- we need some unity.","exampleTranslation":"Nếu chúng ta không sát cánh bên nhau, mọi thứ sẽ tồi tệ hơn nhiều đối với tất cả chúng ta - chúng ta cần sự đoàn kết.","rootVerb":"stick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"stick up for":{"definition":"Ủng hộ hoặc bảo vệ.","example":"You have to stick up for yourself here, because no one will back you.","exampleTranslation":"Bạn phải tự bảo vệ chính mình ở đây, vì sẽ chẳng có ai ủng hộ bạn đâu.","rootVerb":"stick","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"storm out":{"definition":"Rời khỏi một nơi một cách tức giận.","example":"She was so angry that she decided to storm out.","exampleTranslation":"Cô ấy giận dữ đến mức quyết định bỏ đi thật nhanh.","rootVerb":"storm","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"strike up":{"definition":"Bắt đầu (cuộc trò chuyện, mối quan hệ).","example":"He struck up a conversation with me in the bar.","exampleTranslation":"Anh ấy đã bắt chuyện với tôi trong quán bar.","rootVerb":"strike","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"string along":{"definition":"Đi cùng ai đó vì bạn không có việc gì tốt hơn để làm.","example":"Is it alright if I string along with you tonight?","exampleTranslation":"Đi cùng với cậu tối nay có được không?","rootVerb":"string","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"suck up":{"definition":"Cố gắng xu nịnh.","example":"He is always sucking up to try to get the boss's approval.","exampleTranslation":"Anh ta luôn nịnh hót để cố gắng đạt được sự chấp thuận của sếp.","rootVerb":"suck","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"suck up to":{"definition":"Lấy lòng ai đó.","example":"He's always sucking up to our boss.","exampleTranslation":"Anh ta lúc nào cũng nịnh hót sếp của chúng tôi.","rootVerb":"suck","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"swear by":{"definition":"Có niềm tin lớn vào.","example":"I swear by their products- they're the best on the market.","exampleTranslation":"Tôi tin tưởng tuyệt đối vào các sản phẩm của họ - chúng là những sản phẩm tốt nhất trên thị trường.","rootVerb":"swear","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tail away":{"definition":"Trở nên im lặng hoặc không thể nghe thấy.","example":"His voice tailed away when he was speaking about what he'd done wrong.","exampleTranslation":"Giọng anh ấy nhỏ dần khi anh ấy đang nói về những điều sai trái mình đã làm.","rootVerb":"tail","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tail off":{"definition":"Trở nên im lặng hoặc không thể nghe thấy.","example":"The voices tailed off when she entered.","exampleTranslation":"Những tiếng nói nhỏ dần khi cô ấy bước vào.","rootVerb":"tail","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"take aside":{"definition":"Kéo ai đó ra chỗ khác để nói chuyện với họ.","example":"The teacher took her aside and said that she'd failed the exam.","exampleTranslation":"Giáo viên đã kéo cô ấy ra một chỗ và nói rằng cô ấy đã trượt kỳ thi.","rootVerb":"take","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"take back":{"definition":"Rút lại một lời tuyên bố, thừa nhận rằng điều gì đó là sai.","example":"I had to take back everything bad I'd said about them when I learned how they'd helped out.","exampleTranslation":"Tôi đã phải rút lại mọi điều tồi tệ mình từng nói về họ khi tôi biết họ đã giúp đỡ như thế nào.","rootVerb":"take","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"take for":{"definition":"Coi ai là người như thế nào, tưởng nhầm ai là.","example":"What do you take me for? I would never betray my friends.","exampleTranslation":"Bạn coi tôi là người như thế nào vậy? Tôi sẽ không bao giờ phản bội bạn bè của mình.","rootVerb":"take","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk around":{"definition":"Nói vòng vo về một vấn đề mà không thực sự giải quyết nó.","example":"They talked around the issue without reaching a conclusion.","exampleTranslation":"Họ đã nói vòng vo về vấn đề đó mà không đi đến kết luận nào.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk at":{"definition":"Nói với ai đó mà không cho họ cơ hội trả lời hoặc không lắng nghe họ.","example":"There's no point trying to convince them- they'll just talk at you until you give up.","exampleTranslation":"Chẳng có ích gì khi cố gắng thuyết phục họ - họ sẽ chỉ nói lấn át bạn cho đến khi bạn bỏ cuộc.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk back":{"definition":"Cãi lại người có thẩm quyền.","example":"The teacher was cross because the pupil talked back to her.","exampleTranslation":"Giáo viên đã rất giận vì học sinh cãi lại cô ấy.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk down":{"definition":"Thuyết phục ai đó đừng nhảy từ trên cao xuống tự tử.","example":"The police tried to talk down the man.","exampleTranslation":"Cảnh sát đã cố gắng thuyết phục người đàn ông đó từ bỏ ý định tự tử.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk down to":{"definition":"Nói theo cách tỏ ra bề trên chứ không phải giao tiếp.","example":"She's a dreadful teacher and talks down to her students instead of teaching them.","exampleTranslation":"Cô ấy là một giáo viên tồi và luôn nói chuyện kiểu bề trên với học sinh thay vì giảng dạy cho họ.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk into":{"definition":"Thuyết phục ai đó làm gì.","example":"She didn't want to let me go, but I finally managed to talk her into it.","exampleTranslation":"Cô ấy không muốn để tôi đi, nhưng cuối cùng tôi đã thuyết phục được cô ấy đồng ý.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk out":{"definition":"Thảo luận về một vấn đề để tìm ra giải pháp.","example":"They had a meeting to talk out how people felt.","exampleTranslation":"Họ đã có một buổi họp để thảo luận về cảm nhận của mọi người nhằm tìm ra giải pháp.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"talk up":{"definition":"Làm cho một cái gì đó có vẻ quan trọng hoặc có ý nghĩa hơn thực tế.","example":"The government are trying to talk up the effect of their policies.","exampleTranslation":"Chính phủ đang cố gắng thổi phồng tác động từ các chính sách của họ.","rootVerb":"talk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tee off on":{"definition":"Chỉ trích.","example":"She teed off on me about the work I gave her.","exampleTranslation":"Cô ấy đã chỉ trích tôi dữ dội về công việc mà tôi đã giao cho cô ấy.","rootVerb":"tee","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tell off":{"definition":"Trách mắng; nói chuyện một cách tức giận với ai đó về việc họ đã làm sai.","example":"His fiancée told him off for arriving nearly an hour late.","exampleTranslation":"Vị hôn phu của anh ấy đã mắng anh vì đến trễ gần một tiếng đồng hồ.","rootVerb":"tell","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tell on":{"definition":"Tố cáo ai đó với nhà chức trách.","example":"The pupil told on the others for cheating and the teacher failed them.","exampleTranslation":"Học sinh đã tố cáo những người khác vì gian lận và giáo viên đã cho họ điểm liệt.","rootVerb":"tell","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"text out":{"definition":"Hủy một cuộc hẹn bằng cách gửi tin nhắn văn bản.","example":"I was feeling too tired to go and texted out.","exampleTranslation":"Tôi cảm thấy quá mệt để đi nên đã nhắn tin xin hủy.","rootVerb":"text","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"throw over":{"definition":"Chấm dứt mối quan hệ với ai đó.","example":"She threw me over last year.","exampleTranslation":"Cô ấy đã đá tôi vào năm ngoái.","rootVerb":"throw","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tone down":{"definition":"Làm cho một cái gì đó nghe có vẻ ôn hòa hơn.","example":"The Minister tried to tone down what she had said when the press started attacking her.","exampleTranslation":"Bộ trưởng đã cố gắng làm cho những gì bà ấy nói nghe ôn hòa hơn khi báo chí bắt đầu tấn công bà.","rootVerb":"tone","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"toss about":{"definition":"Thảo luận một vấn đề một cách tự do và cởi mở, nhưng không quá nghiêm túc.","example":"We tossed ideas about before the negotiations.","exampleTranslation":"Chúng tôi đã thảo luận các ý tưởng một cách tự do trước khi đàm phán.","rootVerb":"toss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"toss around":{"definition":"Thảo luận một vấn đề một cách tự do và cởi mở, nhưng không quá nghiêm túc.","example":"We tossed their plan around a bit and then rejected it.","exampleTranslation":"Chúng tôi đã thảo luận về kế hoạch của họ một chút rồi sau đó bác bỏ nó.","rootVerb":"toss","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"touch on":{"definition":"Đề cập.","example":"The talk touched on the issue, but didn't give any new information.","exampleTranslation":"Bài nói chuyện đã đề cập đến vấn đề này, nhưng không đưa ra thông tin mới nào.","rootVerb":"touch","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"touch upon":{"definition":"Đề cập.","example":"They didn't touch upon the subject because of the controversy.","exampleTranslation":"Họ đã không đề cập đến vấn đề đó vì sự tranh cãi.","rootVerb":"touch","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"try back":{"definition":"Gọi lại.","example":"I called but they weren't in, so I'll try back later.","exampleTranslation":"Tôi đã gọi nhưng họ không có ở đó, nên tôi sẽ gọi lại sau.","rootVerb":"try","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"tune out":{"definition":"Bỏ qua, không chú ý.","example":"I tuned him out because he was talking such rubbish.","exampleTranslation":"Tôi đã lờ đi không nghe anh ta vì anh ta nói toàn những điều nhảm nhí.","rootVerb":"tune","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"turn to":{"definition":"Cố gắng tìm kiếm sự giúp đỡ.","example":"She had nobody to turn to when her husband died.","exampleTranslation":"Cô ấy không có ai để tìm đến nhờ giúp đỡ khi chồng cô ấy qua đời.","rootVerb":"turn","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"urge on":{"definition":"Thuyết phục hoặc gây áp lực để chấp nhận điều gì đó.","example":"They urged the deal on the company.","exampleTranslation":"Họ đã gây áp lực buộc công ty phải chấp nhận thỏa thuận đó.","rootVerb":"urge","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"urge upon":{"definition":"Thuyết phục hoặc gây áp lực để chấp nhận điều gì đó.","example":"They urged the contract upon us.","exampleTranslation":"Họ đã gây áp lực buộc chúng tôi phải chấp nhận hợp đồng đó.","rootVerb":"urge","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"walk back from":{"definition":"Rút lại một lời tuyên bố.","example":"They declined to walk back from their comments despite the controversy.","exampleTranslation":"Họ đã từ chối rút lại những bình luận của mình bất chấp tranh cãi.","rootVerb":"walk","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"want out":{"definition":"Muốn thoát khỏi một mối quan hệ hoặc sự sắp xếp.","example":"Jackie wasn't happy with her marriage and wanted out.","exampleTranslation":"Jackie không hạnh phúc với cuộc hôn nhân của mình và muốn rút lui khỏi nó.","rootVerb":"want","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"wave aside":{"definition":"Phớt lờ hoặc từ chối xem xét những gì ai đó nói.","example":"They waved aside our objections and carried on with the plan.","exampleTranslation":"Họ phớt lờ những phản đối của chúng tôi và tiếp tục thực hiện kế hoạch.","rootVerb":"wave","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"wave off":{"definition":"Tiễn ai đó, vẫy tay chào tạm biệt.","example":"We waved her off at the station.","exampleTranslation":"Chúng tôi đã vẫy tay chào tiễn cô ấy tại nhà ga.","rootVerb":"wave","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"weigh in":{"definition":"Bước vào một cuộc tranh cãi một cách mạnh mẽ.","example":"He disliked the plan and weighed in with some heavy criticism.","exampleTranslation":"Anh ấy không thích kế hoạch đó và đã tham gia vào cuộc tranh luận với một vài chỉ trích nặng nề.","rootVerb":"weigh","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"weigh in on":{"definition":"Tham gia vào một cuộc tranh cãi hoặc thảo luận để bày tỏ một ý tưởng mạnh mẽ.","example":"She weighed in on their immigration policies.","exampleTranslation":"Cô ấy đã tham gia thảo luận về các chính sách nhập cư của họ để bày tỏ ý kiến mạnh mẽ.","rootVerb":"weigh","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"wheel out":{"definition":"Dùng đi dùng lại một thứ gì đó như lời giải thích đến mức mất tác dụng.","example":"They wheeled out the same old excuses last time this happened.","exampleTranslation":"Họ lại dùng những lý do cũ rích đó lần nữa khi chuyện này xảy ra.","rootVerb":"wheel","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"whip up":{"definition":"Kích động mọi người.","example":"The boss tried to whip up some support for her new policies.","exampleTranslation":"Sếp đã cố gắng kích động sự ủng hộ cho các chính sách mới của bà ấy.","rootVerb":"whip","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"word up":{"definition":"Cho ai đó thông tin, lời khuyên.","example":"The solicitor worded her up client before the police interview, so they go very little out of him.","exampleTranslation":"Luật sư đã dặn dò khách hàng của mình trước buổi thẩm vấn của cảnh sát, vì vậy họ chẳng khai thác được gì nhiều từ anh ta.","rootVerb":"word","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"write in":{"definition":"Gửi một lá thư cho một đài truyền hình, v.v.","example":"They asked viewers to write in with their opinions and suggestions.","exampleTranslation":"Họ đã yêu cầu khán giả gửi thư phản hồi kèm theo ý kiến và đề xuất của mình.","rootVerb":"write","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"yack on":{"definition":"Nói liên tục, đặc biệt là nếu nó làm phiền.","example":"He yacked on for an hour.","exampleTranslation":"Anh ta đã nói liên tục suốt một tiếng đồng hồ.","rootVerb":"yack","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"yammer on":{"definition":"Nói liên tục, đặc biệt là nếu nó làm phiền.","example":"She yammered on for ages.","exampleTranslation":"Cô ấy đã nói nhảm liên tục trong một thời gian dài.","rootVerb":"yammer","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"zip up":{"definition":"Giữ im lặng.","example":"He was being stupid in the meeting, so we told him to zip up.","exampleTranslation":"Anh ta đã hành xử ngu ngốc trong cuộc họp, vì vậy chúng tôi đã bảo anh ta hãy im lặng.","rootVerb":"zip","topicId":"communication","topicTitle":"Giao tiếp và quan hệ","partOfSpeech":"V","dictionarySource":"offline"},"ask in":{"definition":"mời vào nhà","example":"You should ask in the guest waiting outside.","exampleTranslation":"Bạn nên mời vị khách đang chờ ngoài cửa vào nhà.","rootVerb":"ask","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"ask over":{"definition":"mời đến nhà chơi","example":"They have asked us over for drinks on Friday.","exampleTranslation":"Họ đã mời chúng tôi đến nhà chơi và uống nước vào thứ Sáu.","rootVerb":"ask","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bang about":{"definition":"đi lại gây tiếng ồn lớn","example":"He's banging about in the kitchen.","exampleTranslation":"Anh ấy đang đi lại gây tiếng ồn ầm ĩ trong bếp.","rootVerb":"bang","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bang out":{"definition":"chơi đàn ầm ĩ","example":"She banged the tune out on the piano.","exampleTranslation":"Cô ấy đã chơi bản nhạc đó trên đàn piano một cách ầm ĩ.","rootVerb":"bang","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"be in":{"definition":"có nhà; ở cơ quan","example":"They are never in; I always get their answerphone.","exampleTranslation":"Họ không bao giờ có nhà; tôi luôn gặp hộp thư thoại của họ.","rootVerb":"be","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"be off":{"definition":"bị hỏng (thức ăn)","example":"This yoghurt must be off; it smells foul.","exampleTranslation":"Hộp sữa chua này chắc là bị hỏng rồi; nó bốc mùi khó chịu.","rootVerb":"be","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"be up":{"definition":"đã dậy (khỏi giường)","example":"I will be up early tomorrow morning.","exampleTranslation":"Tôi sẽ dậy sớm vào sáng mai.","rootVerb":"be","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bed down":{"definition":"trở nên ổn định (qua thời gian)","example":"The new government has found it hard to bed down and become accepted.","exampleTranslation":"Chính phủ mới cảm thấy khó khăn để ổn định và được chấp nhận.","rootVerb":"bed","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"belt out":{"definition":"hát to","example":"They belted out the national anthems before the game.","exampleTranslation":"Họ hát vang quốc ca trước khi trận đấu bắt đầu.","rootVerb":"belt","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"blare out":{"definition":"vang lên inh ỏi","example":"The music was blaring out and I couldn't get to sleep.","exampleTranslation":"Nhạc vang lên inh ỏi và tôi không thể nào chợp mắt được.","rootVerb":"blare","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"blow out":{"definition":"Thổi tắt nến, diêm...","example":"She blew the candles out on her birthday cake.","exampleTranslation":"Cô ấy thổi tắt nến trên chiếc bánh sinh nhật của mình.","rootVerb":"blow","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"board out":{"definition":"Gửi thú cưng ở đâu đó khi bạn đi vắng.","example":"We board our dog out with friends when we go abroad.","exampleTranslation":"Chúng tôi gửi chú chó của mình cho bạn bè chăm sóc khi chúng tôi đi nước ngoài.","rootVerb":"board","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bolt down":{"definition":"Ăn vội ăn vàng, nuốt chửng nhanh chóng.","example":"He bolted down his breakfast because he was running late for work.","exampleTranslation":"Anh ấy ăn vội bữa sáng vì anh ấy đang trễ giờ làm.","rootVerb":"bolt","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"brick in":{"definition":"Xây gạch bịt kín.","example":"We bricked in the side window.","exampleTranslation":"Chúng tôi đã xây gạch bịt kín cửa sổ bên hông.","rootVerb":"brick","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"brick up":{"definition":"Xây gạch bịt kín.","example":"We bricked the back entrance up.","exampleTranslation":"Chúng tôi đã xây gạch bịt kín lối vào phía sau.","rootVerb":"brick","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bring around":{"definition":"Mang theo thứ gì đó khi đến thăm.","example":"He brought some books around when he came last night.","exampleTranslation":"Anh ấy đã mang theo vài cuốn sách khi đến thăm vào tối qua.","rootVerb":"bring","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bucket down":{"definition":"Mưa tầm tã.","example":"Take an umbrella; it's bucketing down.","exampleTranslation":"Hãy mang theo ô; trời đang mưa tầm tã.","rootVerb":"bucket","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"bundle up":{"definition":"Bó lại, gói lại.","example":"I bundled up my newspapers and dropped them in the recycling bin.","exampleTranslation":"Tôi bó các tờ báo lại và bỏ chúng vào thùng tái chế.","rootVerb":"bundle","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"call after":{"definition":"Đặt tên theo tên ai đó.","example":"She was called Rose after her late grandmother.","exampleTranslation":"Cô ấy được đặt tên là Rose theo tên người bà quá cố của mình.","rootVerb":"call","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"carry on with":{"definition":"Ngoại tình.","example":"He's been carrying on with someone at work for years.","exampleTranslation":"Anh ta đã ngoại tình với một người ở chỗ làm nhiều năm nay rồi.","rootVerb":"carry","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"cast aside":{"definition":"Loại bỏ, vứt bỏ.","example":"She decided to cast aside her old, broken chair.","exampleTranslation":"Cô ấy quyết định vứt bỏ chiếc ghế cũ nát của mình.","rootVerb":"cast","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"cater for":{"definition":"Cung cấp những gì cần thiết.","example":"The college caters for students of all ages.","exampleTranslation":"Trường đại học cung cấp đầy đủ các dịch vụ cần thiết cho sinh viên ở mọi lứa tuổi.","rootVerb":"cater","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"chow down":{"definition":"Ăn.","example":"Let's chow down on some delicious pizza tonight.","exampleTranslation":"Tối nay chúng ta hãy cùng ăn một bữa pizza ngon tuyệt nhé.","rootVerb":"chow","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"chow down on":{"definition":"Ăn gì đó.","example":"We're going to chow down on that barbecued pork.","exampleTranslation":"Chúng ta sẽ ăn món thịt heo nướng đó.","rootVerb":"chow","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"chuck away":{"definition":"Vứt đi.","example":"I chucked away all my old records years ago when CDs came out.","exampleTranslation":"Tôi đã vứt bỏ tất cả các đĩa hát cũ của mình từ nhiều năm trước khi đĩa CD ra đời.","rootVerb":"chuck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"chuck out":{"definition":"Vứt đi.","example":"I chucked out some stuff I found in the fridge that had gone bad.","exampleTranslation":"Tôi đã vứt bỏ một số thứ tìm thấy trong tủ lạnh bị hỏng.","rootVerb":"chuck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"clean off":{"definition":"Lau sạch.","example":"After dinner, I cleaned off the table.","exampleTranslation":"Sau bữa tối, tôi đã lau sạch bàn ăn.","rootVerb":"clean","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"clear out":{"definition":"Dọn dẹp sạch sẽ.","example":"I spent the whole weekend clearing out the attic as it was full of papers and other junk.","exampleTranslation":"Tôi đã dành trọn cuối tuần để dọn dẹp sạch sẽ gác mái vì nó chứa đầy giấy tờ và những đồ đạc bỏ đi khác.","rootVerb":"clear","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"clear up":{"definition":"Trời quang mây tạnh.","example":"The skies cleared up and the sun came out.","exampleTranslation":"Bầu trời quang đãng trở lại và mặt trời ló dạng.","rootVerb":"clear","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"close up":{"definition":"Đóng hoàn toàn một cái gì đó.","example":"They close up the building after everyone has left.","exampleTranslation":"Họ đóng hoàn toàn tòa nhà sau khi mọi người đã rời đi.","rootVerb":"close","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"cloud over":{"definition":"Trở nên nhiều mây.","example":"Dark clouds began to cloud over the bright sun.","exampleTranslation":"Những đám mây đen bắt đầu kéo đến che khuất mặt trời chói chang.","rootVerb":"cloud","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"clown about":{"definition":"Cư xử ngốc nghếch hoặc lãng phí thời gian.","example":"The students were clowning about all lesson.","exampleTranslation":"Các học sinh đã cư xử ngốc nghếch suốt cả tiết học.","rootVerb":"clown","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"clown around":{"definition":"Cư xử ngốc nghếch hoặc lãng phí thời gian.","example":"I couldn't concentrate because they were clowning around all afternoon.","exampleTranslation":"Tôi không thể tập trung được vì họ cứ cư xử ngốc nghếch suốt cả buổi chiều.","rootVerb":"clown","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"coop up":{"definition":"Giam trong một khu vực nhỏ.","example":"They cooped the dog up in a tiny room.","exampleTranslation":"Họ giam chú chó trong một căn phòng nhỏ xíu.","rootVerb":"coop","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"count down":{"definition":"Đếm ngược (đợi chờ một cách nóng lòng).","example":"I'm counting down the days till they leave.","exampleTranslation":"Tôi đang đếm ngược từng ngày cho đến khi họ rời đi.","rootVerb":"count","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"crash out":{"definition":"Ngủ lại nhà ai đó vì quá mệt hoặc say.","example":"Dave crashed out at a friend's flat after the end-of-term party.","exampleTranslation":"Dave đã ngủ lại nhà bạn sau bữa tiệc cuối kỳ.","rootVerb":"crash","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"crumb down":{"definition":"Dọn dẹp bàn ăn trong nhà hàng.","example":"The waiter crumbed down before the coffee was served.","exampleTranslation":"Người phục vụ đã dọn sạch vụn bánh trên bàn trước khi cà phê được mang ra.","rootVerb":"crumb","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"cut down":{"definition":"Cắt xuống từ vị trí cao.","example":"After Christmas he didn't carefully detach all the decorations, he just cut them all down.","exampleTranslation":"Sau lễ Giáng sinh, anh ấy không cẩn thận tháo dỡ các món đồ trang trí mà cứ thế cắt chúng xuống.","rootVerb":"cut","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"cut out":{"definition":"Cắt một bức tranh hoặc tương tự từ tạp chí, v.v.","example":"I cut some pictures out to use as visual aids.","exampleTranslation":"Tôi đã cắt vài bức tranh ra để sử dụng làm tài liệu trực quan.","rootVerb":"cut","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"damp off":{"definition":"Bị nấm ký sinh (khi quá ẩm ướt).","example":"The seedlings damp off in the spring if it's very wet.","exampleTranslation":"Các cây con dễ bị nấm ký sinh vào mùa xuân nếu trời quá ẩm ướt.","rootVerb":"damp","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"die back":{"definition":"Lụi tàn phần trên mặt đất (nhưng rễ vẫn sống).","example":"The plant dies back in the winter.","exampleTranslation":"Cây cối lụi tàn phần trên mặt đất vào mùa đông.","rootVerb":"die","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"die out":{"definition":"Tuyệt chủng hoặc biến mất.","example":"Some scientists say that the dinosaurs died out when a comet hit the earth and caused a nuclear winter.","exampleTranslation":"Một số nhà khoa học cho rằng loài khủng long đã tuyệt chủng khi một sao chổi va vào trái đất và gây ra mùa đông hạt nhân.","rootVerb":"die","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dig out":{"definition":"Tìm lại thứ gì đó lâu ngày không dùng/nhìn thấy.","example":"I dug out my old university essays.","exampleTranslation":"Tôi đã tìm lại được những bài luận đại học cũ của mình.","rootVerb":"dig","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dine out":{"definition":"Ăn tối ở ngoài.","example":"We dined out because we couldn't be bothered to cook.","exampleTranslation":"Chúng tôi đã ra ngoài ăn tối vì ngại nấu nướng.","rootVerb":"dine","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dish up":{"definition":"Dọn thức ăn.","example":"He dished up a great dinner when we got back.","exampleTranslation":"Anh ấy đã dọn một bữa tối tuyệt vời khi chúng tôi quay về.","rootVerb":"dish","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"do up":{"definition":"Cài, thắt (quần áo, v.v.).","example":"You must do up your safety belt in the back of cars and taxis now.","exampleTranslation":"Giờ đây bạn phải cài dây an toàn ở ghế sau xe hơi và xe taxi.","rootVerb":"do","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"do with":{"definition":"Muốn hoặc cần (thường dùng sau can/could).","example":"I could do with a cold beer about now.","exampleTranslation":"Lúc này tôi rất muốn có một ly bia lạnh.","rootVerb":"do","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"do without":{"definition":"Xoay xở mà không có cái gì đó.","example":"There's no sugar, so you'll have to do without.","exampleTranslation":"Không còn đường nữa đâu, nên bạn sẽ phải xoay xở mà không có nó thôi.","rootVerb":"do","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"doss down":{"definition":"Ngủ tạm ở đâu đó (do không về nhà).","example":"I was feeling really tired, so I dossed down on his sofa for the night.","exampleTranslation":"Tôi cảm thấy rất mệt nên đã ngủ tạm trên ghế sô pha của anh ấy qua đêm.","rootVerb":"doss","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"double up":{"definition":"Dùng chung phòng/chỗ ở (do quá đông).","example":"We had to double up because we hadn't booked enough rooms.","exampleTranslation":"Chúng tôi đã phải ở chung phòng vì chúng tôi đã không đặt đủ phòng.","rootVerb":"double","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"doze off":{"definition":"Ngủ gật.","example":"The movie was a bit boring and I dozed off halfway through.","exampleTranslation":"Bộ phim hơi chán nên tôi đã ngủ gật giữa chừng.","rootVerb":"doze","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dress down":{"definition":"Ăn mặc thường phục.","example":"The staff are allowed to dress down on Fridays.","exampleTranslation":"Các nhân viên được phép ăn mặc thường phục vào các ngày thứ Sáu.","rootVerb":"dress","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dress up":{"definition":"Ăn mặc diện.","example":"It's an informal party so there's no need to dress up.","exampleTranslation":"Đó là một bữa tiệc thân mật nên không cần phải ăn mặc diện.","rootVerb":"dress","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"drift off":{"definition":"Thiu thiu ngủ.","example":"I was drifting off when the noise disturbed me.","exampleTranslation":"Tôi đang thiu thiu ngủ thì tiếng ồn làm tôi thức giấc.","rootVerb":"drift","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"drink up":{"definition":"Uống cạn.","example":"Drink up, please; it's closing time.","exampleTranslation":"Làm ơn uống cạn đi; đã đến giờ đóng cửa rồi.","rootVerb":"drink","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"drown in":{"definition":"Nhúng ngập, bao phủ quá mức.","example":"They drown the food in sauce.","exampleTranslation":"Họ nhúng ngập thức ăn trong nước sốt.","rootVerb":"drown","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dry off":{"definition":"Lau khô nhanh, hoặc làm khô bề mặt.","example":"I had a shower and dried myself off.","exampleTranslation":"Tôi đã tắm và lau khô người.","rootVerb":"dry","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"dry out":{"definition":"Làm khô hoàn toàn.","example":"They dried the fruit out in the sun.","exampleTranslation":"Họ đã phơi trái cây dưới ánh nắng cho khô hoàn toàn.","rootVerb":"dry","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"eat in":{"definition":"Ăn ở nhà.","example":"We didn't feel like going to a restaurant so we ate in.","exampleTranslation":"Chúng tôi không có hứng ra nhà hàng nên chúng tôi đã ăn ở nhà.","rootVerb":"eat","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"eat out":{"definition":"Đi ăn hàng.","example":"We couldn't be bothered to cook so we ate out last night.","exampleTranslation":"Chúng tôi không muốn nấu nướng nên tối qua chúng tôi đã đi ăn hàng.","rootVerb":"eat","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"empty out":{"definition":"Trút sạch, dọn sạch.","example":"I must empty out the rubbish before I leave for work.","exampleTranslation":"Tôi phải trút sạch rác trước khi đi làm.","rootVerb":"empty","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fart about":{"definition":"Lãng phí thời gian làm những việc ngớ ngẩn.","example":"The manager was angry because the staff were farting about.","exampleTranslation":"Người quản lý đã tức giận vì các nhân viên cứ lãng phí thời gian làm những việc ngớ ngẩn.","rootVerb":"fart","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fart around":{"definition":"Lãng phí thời gian làm những việc vô nghĩa.","example":"We were really bored in the lecture so we started farting around.","exampleTranslation":"Chúng tôi rất chán trong buổi giảng nên chúng tôi bắt đầu lãng phí thời gian làm những việc vô nghĩa.","rootVerb":"fart","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fasten down":{"definition":"Buộc chặt thứ gì đó để nó không di chuyển.","example":"We fastened it down to keep the wind from blowing it away.","exampleTranslation":"Chúng tôi đã buộc chặt nó xuống để tránh gió thổi bay.","rootVerb":"fasten","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fasten up":{"definition":"Đóng, cài.","example":"Please fasten up your seatbelt before we depart.","exampleTranslation":"Làm ơn hãy cài dây an toàn trước khi chúng ta khởi hành.","rootVerb":"fasten","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fatten up":{"definition":"Cho động vật ăn nhiều để nó béo lên.","example":"They fatten the cows up before slaughtering them.","exampleTranslation":"Họ vỗ béo đàn bò trước khi giết thịt chúng.","rootVerb":"fatten","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"feed on":{"definition":"Cho ai đó ăn một loại thức ăn cụ thể.","example":"He feeds his cat on dry food.","exampleTranslation":"Anh ấy cho con mèo của mình ăn thức ăn khô.","rootVerb":"feed","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fend for":{"definition":"Tự lo liệu hoặc tự chăm sóc bản thân.","example":"The children had to fend for themselves after their parents died.","exampleTranslation":"Những đứa trẻ phải tự lo liệu sau khi cha mẹ chúng qua đời.","rootVerb":"fend","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fiddle around":{"definition":"Thực hiện các chuyển động nhỏ bằng tay.","example":"He fiddled around for something in his pockets.","exampleTranslation":"Anh ấy thực hiện các chuyển động nhỏ bằng tay để tìm thứ gì đó trong túi của mình.","rootVerb":"fiddle","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fiddle away":{"definition":"Lãng phí thời gian.","example":"He fiddled away the afternoon.","exampleTranslation":"Anh ấy đã lãng phí cả buổi chiều.","rootVerb":"fiddle","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"finish with":{"definition":"Dùng xong hoặc không cần nữa.","example":"Can I read the paper when you've finished with it.","exampleTranslation":"Tôi có thể đọc tờ báo khi bạn dùng xong không?","rootVerb":"finish","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fish out":{"definition":"Lấy thứ gì đó ra khỏi túi, túi xách, v.v.","example":"She reached into her handbag and fished some coins out.","exampleTranslation":"Cô ấy đưa tay vào túi xách và lấy vài đồng xu ra.","rootVerb":"fish","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fluff out":{"definition":"Lắc hoặc vỗ một chiếc gối để nó phồng lên.","example":"She fluffed out the sofa cushions.","exampleTranslation":"Cô ấy đã lắc cho mấy chiếc đệm ghế sô pha phồng lên.","rootVerb":"fluff","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fluff up":{"definition":"Lắc hoặc vỗ một chiếc gối để nó phồng lên.","example":"He fluffed up the pillow before going to bed.","exampleTranslation":"Anh ấy đã vỗ cho chiếc gối phồng lên trước khi đi ngủ.","rootVerb":"fluff","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fold up":{"definition":"Gấp một tờ giấy nhỏ lại.","example":"Darren folded up the letter and put it in an envelope.","exampleTranslation":"Darren đã gấp lá thư lại và bỏ nó vào một phong bì.","rootVerb":"fold","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"fool about":{"definition":"Không nghiêm túc.","example":"They were fooling about and wouldn't settle down.","exampleTranslation":"Họ đã đùa giỡn không nghiêm túc và không chịu ổn định chỗ ngồi.","rootVerb":"fool","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"freshen up":{"definition":"Làm mới lại diện mạo của thứ gì đó một cách nhanh chóng.","example":"The magazine gives you tips on how to freshen up your home cheaply.","exampleTranslation":"Tạp chí đó đưa ra cho bạn các mẹo về cách làm mới diện mạo ngôi nhà của bạn với chi phí thấp.","rootVerb":"freshen","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"get away from":{"definition":"Tránh xa, thoát khỏi (công việc, thói quen).","example":"Work's getting on top of me; I need to get away from it.","exampleTranslation":"Công việc đang đè nặng lên tôi; tôi cần phải tránh xa nó ra.","rootVerb":"get","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"get back into":{"definition":"Bắt đầu làm lại việc gì đó sau một thời gian dừng lại.","example":"I am getting back into my Khmer lessons after the summer break.","exampleTranslation":"Tôi đang bắt đầu làm lại việc học tiếng Khmer sau kỳ nghỉ hè.","rootVerb":"get","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"get into":{"definition":"Bắt đầu một thói quen hoặc cách cư xử.","example":"It took me ages to get into driving on the left.","exampleTranslation":"Tôi mất khá nhiều thời gian để bắt đầu quen với việc lái xe bên trái.","rootVerb":"get","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"get used to":{"definition":"Dần quen với cái gì, thích nghi với điều kiện mới.","example":"It took him several months to get used to driving on the left side of the road.","exampleTranslation":"Anh ấy đã mất vài tháng để dần quen với việc lái xe ở phía bên trái đường.","rootVerb":"get","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"go around":{"definition":"Đủ để chia cho mọi người.","example":"There aren't enough jobs to go around for the numbers of people graduating nowadays.","exampleTranslation":"Hiện nay không có đủ việc làm để chia cho số lượng người tốt nghiệp.","rootVerb":"go","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"go without":{"definition":"Đối phó khi không có thứ gì đó.","example":"They're not coming, so we'll have to go without their help.","exampleTranslation":"Họ sẽ không đến, nên chúng ta sẽ phải đối phó khi không có sự giúp đỡ của họ.","rootVerb":"go","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"goof around":{"definition":"Đùa giỡn, không nghiêm túc.","example":"We spent the weekend goofing around.","exampleTranslation":"Chúng tôi đã dành cả cuối tuần để đùa giỡn không nghiêm túc.","rootVerb":"goof","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"grow out":{"definition":"Để tóc tự nhiên mọc lại để loại bỏ kiểu cũ.","example":"I'm letting the perm grow out.","exampleTranslation":"Tôi đang để tóc tự nhiên mọc lại để loại bỏ kiểu uốn cũ.","rootVerb":"grow","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"grow up on":{"definition":"Có hoặc làm gì đó khi còn nhỏ.","example":"We grew up on cartoons.","exampleTranslation":"Chúng tôi lớn lên bằng những bộ phim hoạt hình.","rootVerb":"grow","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"gulp down":{"definition":"Uống ừng ực, nuốt ừng ực.","example":"After the long run in the hot sun, he gulped down a whole bottle of cold water.","exampleTranslation":"Sau khi chạy đường dài dưới nắng nóng, anh ấy đã uống cạn một chai nước lạnh.","rootVerb":"gulp","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"gussy up":{"definition":"Ăn mặc bảnh bao hoặc cải thiện vẻ ngoài của cái gì đó.","example":"They spent a fortune gussying up the house.","exampleTranslation":"Họ đã tiêu tốn cả một gia tài để trang hoàng lại ngôi nhà.","rootVerb":"gussy","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"hack around":{"definition":"Lãng phí thời gian.","example":"Stop wasting your time and don't hack around anymore.","exampleTranslation":"Đừng lãng phí thời gian nữa và đừng có lông bông nữa.","rootVerb":"hack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"hang out":{"definition":"Dành thời gian giao lưu xã hội.","example":"He hangs out in the pub The Monarch; he's there most nights.","exampleTranslation":"Anh ấy hay tụ tập ở quán rượu The Monarch; hầu như tối nào anh ấy cũng ở đó.","rootVerb":"hang","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"have around":{"definition":"Tiếp đãi ai đó ở nhà của bạn.","example":"I had the neighbours around for dinner last night.","exampleTranslation":"Tối qua tôi đã mời hàng xóm đến dùng bữa tối.","rootVerb":"have","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"have in":{"definition":"Tiếp đãi mọi người tại nhà.","example":"We had them in last night for dinner.","exampleTranslation":"Chúng tôi đã mời họ đến ăn tối tối qua.","rootVerb":"have","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"have it away":{"definition":"Quan hệ tình dục với ai đó, đặc biệt là quan hệ tình dục thông thường.","example":"She had IT away with him last Friday.","exampleTranslation":"Cô ấy đã quan hệ với anh ta vào thứ Sáu tuần trước.","rootVerb":"have","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"have it off":{"definition":"Quan hệ tình dục.","example":"They had IT off after the party.","exampleTranslation":"Họ đã quan hệ tình dục sau bữa tiệc.","rootVerb":"have","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"have over":{"definition":"Nhận khách.","example":"Shall we have them over for dinner?","exampleTranslation":"Chúng ta có nên mời họ đến ăn tối không?","rootVerb":"have","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"heat up":{"definition":"Làm nóng thức ăn.","example":"He heated the soup up in the microwave.","exampleTranslation":"Anh ấy đã hâm nóng món súp trong lò vi sóng.","rootVerb":"heat","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"hold on to":{"definition":"Giữ chặt.","example":"I held on to my luggage while I was waiting fr the taxi so that it didn't get stolen.","exampleTranslation":"Tôi đã giữ chặt hành lý của mình trong lúc chờ taxi để nó không bị mất cắp.","rootVerb":"hold","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"hold onto":{"definition":"Giữ càng lâu càng tốt.","example":"It tried to hold onto my cash during the holiday so I could buy some duty free stuff on the way back.","exampleTranslation":"Tôi đã cố giữ lại tiền mặt trong suốt kỳ nghỉ để có thể mua vài món hàng miễn thuế trên đường về.","rootVerb":"hold","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"hunker down":{"definition":"Định cư ở một nơi thoải mái nhất có thể để ở lại đó.","example":"The troops hunkered down in the building.","exampleTranslation":"Quân đội đã cố thủ trong tòa nhà.","rootVerb":"hunker","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"keep around":{"definition":"Giữ một cái gì đó gần bạn.","example":"I keep a dictionary around when I'm doing my homework.","exampleTranslation":"Tôi luôn để một cuốn từ điển ở gần khi làm bài tập về nhà.","rootVerb":"keep","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"kip down":{"definition":"Ngủ ở một nơi khác ngoài nhà, thường là không có kế hoạch trước.","example":"It's too late to get the train, so can I kip down here tonight?","exampleTranslation":"Muộn quá rồi không bắt được tàu nữa, cho tôi ngủ nhờ ở đây đêm nay được không?","rootVerb":"kip","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"kip down on":{"definition":"Ngủ trên một thứ gì đó không phải là giường.","example":"There were so many of us that we had to kip down on the floor.","exampleTranslation":"Chúng tôi đông người quá nên phải nằm ngủ dưới sàn nhà.","rootVerb":"kip","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"knock back":{"definition":"Uống cạn nhanh chóng, uống nhiều rượu.","example":"The pub was closing so we knocked our drinks back and left.","exampleTranslation":"Quán rượu sắp đóng cửa nên chúng tôi uống cạn đồ uống của mình rồi rời đi.","rootVerb":"knock","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"knock together":{"definition":"Nối hai căn nhà vốn riêng biệt.","example":"They knocked together two outbuilding and turned them into a home.","exampleTranslation":"Họ đã đập thông hai căn nhà phụ và biến chúng thành một ngôi nhà.","rootVerb":"knock","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"large it up":{"definition":"Vui chơi hết mình khi say xỉn.","example":"They were larging IT up in the rave.","exampleTranslation":"Họ đã vui chơi hết mình trong bữa tiệc nhạc rave.","rootVerb":"large","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"lark about":{"definition":"Cư xử ngớ ngẩn, đùa giỡn.","example":"The children made me angry because they were larking about.","exampleTranslation":"Lũ trẻ làm tôi tức giận vì chúng cứ đùa nghịch ngớ ngẩn.","rootVerb":"lark","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"lie around":{"definition":"Nằm ườn, lười biếng.","example":"Most days he would usually just lie around the house.","exampleTranslation":"Hầu như ngày nào anh ấy cũng chỉ nằm ườn ở nhà.","rootVerb":"lie","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"light up":{"definition":"Thắp sáng.","example":"They light up the streets at Christmas time.","exampleTranslation":"Họ thắp sáng các con phố vào dịp Giáng sinh.","rootVerb":"light","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"listen out for":{"definition":"Lắng nghe một âm thanh cụ thể.","example":"They put their coats on and listened out for the minicab.","exampleTranslation":"Họ mặc áo khoác vào và lắng nghe xem xe taxi đã đến chưa.","rootVerb":"listen","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live by":{"definition":"Sống theo (một hệ thống niềm tin).","example":"He tries hard to live by the Bible.","exampleTranslation":"Anh ấy cố gắng sống theo Kinh Thánh.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live for":{"definition":"Sống vì điều gì đó.","example":"She seems to live for her new job.","exampleTranslation":"Cô ấy dường như sống vì công việc mới của mình.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live in":{"definition":"Sống tại nơi làm việc hoặc học tập.","example":"The university has a residential halls where students can live in.","exampleTranslation":"Trường đại học có ký túc xá nơi sinh viên có thể sống tại đó.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live it up":{"definition":"Sống xả láng.","example":"She's been living IT up like crazy since she won the lottery.","exampleTranslation":"Cô ấy đã sống xả láng điên cuồng kể từ khi trúng số.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live on":{"definition":"Sống mãi, không bị lãng quên.","example":"He's been dead for many years, but his name lives on.","exampleTranslation":"Ông ấy đã mất nhiều năm rồi, nhưng tên tuổi của ông vẫn sống mãi.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live out":{"definition":"Thực hiện hoài bão hay giấc mơ.","example":"Many parents try to live out their dreams through their children.","exampleTranslation":"Nhiều bậc cha mẹ cố gắng thực hiện giấc mơ của mình thông qua con cái.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"live together":{"definition":"Sống thử, chung sống.","example":"We lived together for a few years before we got married.","exampleTranslation":"Chúng tôi đã sống thử vài năm trước khi kết hôn.","rootVerb":"live","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"load down":{"definition":"Chất nặng, làm gánh nặng.","example":"I was loaded down with all the stuff I had to take there.","exampleTranslation":"Tôi phải mang vác nặng nề tất cả những thứ cần đem đến đó.","rootVerb":"load","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"load up on":{"definition":"Tiêu thụ rất nhiều cái gì đó.","example":"The athletes loaded up on carbohydrates before the race.","exampleTranslation":"Các vận động viên đã nạp thật nhiều carbohydrate trước cuộc đua.","rootVerb":"load","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"look back":{"definition":"Nhìn lại quá khứ.","example":"Old people often look back on over their lives.","exampleTranslation":"Người già thường nhìn lại cuộc đời của họ.","rootVerb":"look","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"look back on":{"definition":"Nhìn lại, hồi tưởng về quá khứ.","example":"When I look back on my college years, I remember them with great fondness.","exampleTranslation":"Khi nhìn lại những năm tháng đại học, tôi nhớ về chúng với sự trìu mến sâu sắc.","rootVerb":"look","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"look in":{"definition":"Ghé thăm nhanh.","example":"I'll look in on my way home.","exampleTranslation":"Tôi sẽ ghé qua nhanh trên đường về nhà.","rootVerb":"look","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"look in on":{"definition":"Tạt qua thăm.","example":"I'm going to look in on grannie on the way home tonight as she's been a bit unwell recently.","exampleTranslation":"Tối nay tôi định tạt qua thăm bà trên đường về nhà vì dạo này bà không được khỏe.","rootVerb":"look","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"look on":{"definition":"Đứng nhìn.","example":"The crowd just looked on as the old lady was mugged.","exampleTranslation":"Đám đông chỉ đứng nhìn khi bà lão bị cướp.","rootVerb":"look","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"luck out":{"definition":"Rất may mắn.","example":"I really lucked out when I met my partner.","exampleTranslation":"Tôi đã thực sự rất may mắn khi gặp được người bạn đời của mình.","rootVerb":"luck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"make room for":{"definition":"Nhường chỗ, tạo không gian cho ai hoặc cái gì.","example":"We moved the table to make room for the extra chairs.","exampleTranslation":"Chúng tôi đã di chuyển cái bàn để nhường chỗ cho những chiếc ghế thêm vào.","rootVerb":"make","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"marry in":{"definition":"Kết hôn với người cùng dân tộc, tôn giáo.","example":"Many religions encourage their followers to marry in.","exampleTranslation":"Nhiều tôn giáo khuyến khích tín đồ của họ kết hôn với người cùng tôn giáo.","rootVerb":"marry","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"marry out":{"definition":"Kết hôn với người khác dân tộc, tôn giáo.","example":"Her parents disowned her and refused to speak to her when she married out.","exampleTranslation":"Cha mẹ cô đã từ mặt và không thèm nói chuyện với cô khi cô kết hôn với người khác tôn giáo.","rootVerb":"marry","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"mess around":{"definition":"Không nghiêm túc.","example":"He is just mess around instead of doing his homework.","exampleTranslation":"Nó chỉ toàn làm việc không đâu vào đâu thay vì làm bài tập về nhà.","rootVerb":"mess","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"miss out":{"definition":"Bỏ lỡ điều gì thú vị.","example":"It'll be great; you'll be missing out if you don't come.","exampleTranslation":"Sẽ rất tuyệt đấy; bạn sẽ bỏ lỡ điều thú vị nếu không đến.","rootVerb":"miss","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"miss out on":{"definition":"Đánh mất cơ hội.","example":"Trudy missed out on the promotion.","exampleTranslation":"Trudy đã bỏ lỡ mất cơ hội thăng tiến.","rootVerb":"miss","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"monkey around":{"definition":"Không nghiêm túc.","example":"The police officer told the drunks to stop monkeying around and go home quietly.","exampleTranslation":"Viên cảnh sát bảo đám say rượu ngừng làm trò nghịch ngợm và lặng lẽ đi về nhà.","rootVerb":"monkey","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"mooch about":{"definition":"Dành thời gian không làm gì.","example":"I just mooch about in my room all day.","exampleTranslation":"Tôi chỉ quanh quẩn không làm gì trong phòng mình suốt cả ngày.","rootVerb":"mooch","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"mooch around":{"definition":"Dành thời gian không làm gì.","example":"I mooched around the house all day.","exampleTranslation":"Tôi đã quanh quẩn ở nhà cả ngày mà không làm gì.","rootVerb":"mooch","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"move into":{"definition":"Bắt đầu sống ở một nơi.","example":"They moved into the house as soon as it was ready.","exampleTranslation":"Họ chuyển vào căn nhà đó ngay khi nó sẵn sàng.","rootVerb":"move","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"name after":{"definition":"Đặt tên theo.","example":"I was named after my uncle who died in the war.","exampleTranslation":"Tôi được đặt tên theo người chú đã hy sinh trong chiến tranh của mình.","rootVerb":"name","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"nerd out":{"definition":"Thảo luận chi tiết về một chủ đề mình am hiểu.","example":"I had to nerd out when they asked about conditionals and deontic modality.","exampleTranslation":"Tôi phải trao đổi thật chuyên sâu khi họ hỏi về câu điều kiện và tình thái nghĩa vụ.","rootVerb":"nerd","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"order in":{"definition":"Đặt đồ ăn mang về nhà / giao tận nơi.","example":"I am too tired to cook tonight, so let us order in some pizza.","exampleTranslation":"Tối nay tôi quá mệt để nấu ăn, nên hãy gọi pizza về nhà đi.","rootVerb":"order","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pack away":{"definition":"Cất đi vào đúng chỗ.","example":"I packed away the suitcases in the loft after we had emptied them.","exampleTranslation":"Tôi đã cất gọn những chiếc vali vào kho sau khi chúng tôi lấy hết đồ bên trong ra.","rootVerb":"pack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pack out":{"definition":"Lấp đầy một địa điểm.","example":"The stadium was packed out.","exampleTranslation":"Sân vận động đã chật kín người.","rootVerb":"pack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pack up":{"definition":"Thu dọn đồ đạc và cất vào nơi bảo quản.","example":"At the end of the presentation, I packed up my laptop.","exampleTranslation":"Cuối buổi thuyết trình, tôi thu dọn máy tính xách tay của mình.","rootVerb":"pack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pad down":{"definition":"Ngủ lại đâu đó qua đêm.","example":"I'm too tired to come home; can I pad down here tonight?","exampleTranslation":"Tôi quá mệt để về nhà; tôi có thể ngủ lại đây đêm nay không?","rootVerb":"pad","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pass down":{"definition":"Truyền lại thông tin hoặc tài sản cho các thế hệ trẻ hơn.","example":"The tales were passed down for centuries without changing ay of the words.","exampleTranslation":"Những câu chuyện này đã được truyền lại qua nhiều thế kỷ mà không thay đổi bất kỳ từ ngữ nào.","rootVerb":"pass","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"peck at":{"definition":"Ăn một lượng rất nhỏ.","example":"The food wasn't very nice, so I pecked at it to look polite.","exampleTranslation":"Đồ ăn không ngon lắm, nên tôi chỉ nhấm nháp một chút cho phải phép.","rootVerb":"peck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pick at":{"definition":"Ăn một cách miễn cưỡng.","example":"I wasn't very hungry so I just picked at my food.","exampleTranslation":"Tôi không đói lắm nên tôi chỉ ăn một cách miễn cưỡng.","rootVerb":"pick","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pick up after":{"definition":"Dọn dẹp mớ hỗn độn do người khác bày ra.","example":"I always have to pick up after him because he leaves things all over the office.","exampleTranslation":"Tôi luôn phải dọn dẹp đống hỗn độn do anh ta gây ra vì anh ta để đồ đạc bừa bãi khắp văn phòng.","rootVerb":"pick","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pile up":{"definition":"Tích lũy thành một đống.","example":"The ironing's piling up as I hate doing it.","exampleTranslation":"Đống quần áo cần ủi đang chất đống vì tôi ghét phải làm việc đó.","rootVerb":"pile","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pin up":{"definition":"Gắn thứ gì đó lên tường hoặc bề mặt thẳng đứng khác bằng ghim.","example":"Please pin up your new photos on the wall.","exampleTranslation":"Làm ơn hãy ghim những bức ảnh mới của bạn lên tường.","rootVerb":"pin","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plant out":{"definition":"Đưa một cây non đã được trồng trong chậu hoặc nhà kính ra đất.","example":"They need to be planted out in the spring.","exampleTranslation":"Chúng cần được đưa ra đất trồng vào mùa xuân.","rootVerb":"plant","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plate up":{"definition":"Dọn thức ăn ra đĩa để phục vụ.","example":"Plate up and drizzle with salsa verde.","exampleTranslation":"Hãy bày thức ăn ra đĩa và rưới thêm nước sốt salsa verde.","rootVerb":"plate","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"play away":{"definition":"Không chung thủy về tình dục khi vắng nhà.","example":"He travels abroad a lot and his wife thinks he plays away.","exampleTranslation":"Anh ta thường xuyên đi nước ngoài và vợ anh ta nghĩ rằng anh ta không chung thủy.","rootVerb":"play","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"play with":{"definition":"Chạm và di chuyển thứ gì đó để tay luôn bận rộn.","example":"He can't stop playing with his beard.","exampleTranslation":"Anh ấy không thể ngừng việc chạm tay vào râu của mình.","rootVerb":"play","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plough up":{"definition":"Cày xới bề mặt đất.","example":"The tractor ploughed up the field so they could sow the seed.","exampleTranslation":"Máy cày đã xới bề mặt cánh đồng để họ có thể gieo hạt.","rootVerb":"plough","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plow up":{"definition":"Xới tung mặt đất.","example":"They need to plow up the field for planting.","exampleTranslation":"Họ cần phải xới tung cánh đồng để gieo trồng.","rootVerb":"plow","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plump down":{"definition":"Đặt hoặc ném cái gì xuống mà không cẩn thận.","example":"He plumped his bag down and kicked his shoes off.","exampleTranslation":"Anh ta đặt phịch chiếc túi xuống và đá văng giày ra.","rootVerb":"plump","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plump up":{"definition":"Làm cho cái gì đó (như gối) phồng lên và mềm hơn bằng cách lắc nhẹ.","example":"I plumped up the pillow and lay down.","exampleTranslation":"Tôi vỗ nhẹ cho chiếc gối phồng lên rồi nằm xuống.","rootVerb":"plump","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"plump yourself down":{"definition":"Ngồi phịch xuống.","example":"She will plump yourself down on the soft sofa.","exampleTranslation":"Cô ấy sẽ ngồi phịch xuống chiếc ghế sofa êm ái.","rootVerb":"plump","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"poke about":{"definition":"Lục lọi","example":"I poked about in my CD collection to see if I could find it.","exampleTranslation":"Tôi lục lọi bộ sưu tập đĩa CD của mình để xem liệu có tìm thấy nó không.","rootVerb":"poke","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"poke around":{"definition":"Lục lọi","example":"I poked around in my desk to see if the letter was there.","exampleTranslation":"Tôi đã lục lọi trong bàn làm việc để xem lá thư có ở đó không.","rootVerb":"poke","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"polish off":{"definition":"Ăn sạch, tiêu thụ hết.","example":"She polishes off half a bottle of gin every night.","exampleTranslation":"Mỗi đêm cô ta đều uống sạch nửa chai rượu gin.","rootVerb":"polish","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"potter about":{"definition":"Dành thời gian làm những việc vặt vãnh cho vui.","example":"On Saturday mornings, I potter about the garden if the weather's fine.","exampleTranslation":"Vào các sáng thứ Bảy, nếu thời tiết đẹp, tôi thường quanh quẩn làm vài việc lặt vặt trong vườn.","rootVerb":"potter","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"potter around":{"definition":"Dành một chút thời gian làm những việc vặt vãnh cho vui.","example":"I pottered around, sorting out my cds and a few other things.","exampleTranslation":"Tôi đã quanh quẩn làm mấy việc lặt vặt, phân loại đĩa CD và một vài thứ khác.","rootVerb":"potter","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pull on":{"definition":"Mặc quần áo vào.","example":"I pulled on a jumper when the sun went in.","exampleTranslation":"Tôi mặc vội chiếc áo len khi mặt trời lặn.","rootVerb":"pull","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"pull to":{"definition":"Kéo hoặc đóng cửa/cửa sổ đang mở.","example":"Could you pull the door to, please?","exampleTranslation":"Bạn có thể khép cửa lại giúp tôi được không?","rootVerb":"pull","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"rack out":{"definition":"Ngủ, chợp mắt.","example":"I'm tired- I'm going to rack out.","exampleTranslation":"Tôi mệt quá - tôi sẽ đi ngủ đây.","rootVerb":"rack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"ride up":{"definition":"Tuột lên cao (quần áo).","example":"Her skirt rode up when she sat down.","exampleTranslation":"Chiếc váy của cô ấy bị co tuột lên trên khi cô ấy ngồi xuống.","rootVerb":"ride","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"ring with":{"definition":"(Nơi nào đó) Đầy những âm thanh lớn.","example":"The room rang with their laughter.","exampleTranslation":"Căn phòng vang dội tiếng cười của họ.","rootVerb":"ring","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"roll by":{"definition":"(Thời gian) Trôi qua.","example":"The summer days roll by so very quickly.","exampleTranslation":"Những ngày hè trôi qua thật nhanh.","rootVerb":"roll","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"roll up":{"definition":"Xuất hiện với số lượng lớn tại một sự kiện.","example":"Thousands rolled up to see the stars at the film premiere.","exampleTranslation":"Hàng ngàn người đã kéo đến xem các ngôi sao tại buổi công chiếu phim.","rootVerb":"roll","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"root about":{"definition":"Tìm kiếm trong một nơi nào đó để cố gắng tìm một thứ gì đó.","example":"He rooted about in his briefcase, trying to find a pen.","exampleTranslation":"Anh ấy lục lọi trong cặp tài liệu của mình, cố gắng tìm một chiếc bút.","rootVerb":"root","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"root around":{"definition":"Tìm kiếm trong một nơi nào đó để cố gắng tìm một thứ gì đó.","example":"I rooted around my flat trying to find the letter.","exampleTranslation":"Tôi đã lục lọi khắp căn hộ của mình để cố tìm lá thư đó.","rootVerb":"root","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"root up":{"definition":"Đào một cái cây ra khỏi mặt đất.","example":"He rooted up the plants and replanted them.","exampleTranslation":"Anh ấy đào những cái cây lên và trồng lại chúng.","rootVerb":"root","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"run across":{"definition":"Gặp hoặc tìm thấy một cách tình cờ.","example":"I ran across an old friend in the library.","exampleTranslation":"Tôi tình cờ gặp một người bạn cũ trong thư viện.","rootVerb":"run","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"run around":{"definition":"Rất bận rộn làm nhiều việc.","example":"I'm exhausted- I've been running around all day.","exampleTranslation":"Tôi kiệt sức rồi - tôi đã chạy đôn chạy đáo cả ngày nay.","rootVerb":"run","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"run away":{"definition":"Bỏ nhà đi vì có vấn đề với các thành viên khác trong gia đình hoặc để bỏ trốn theo người yêu.","example":"She ran away to avoid a forced marriage.","exampleTranslation":"Cô ấy đã bỏ nhà đi để tránh cuộc hôn nhân bị ép buộc.","rootVerb":"run","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"rustle up":{"definition":"Làm gì đó nhanh chóng mà không cần chuẩn bị nhiều.","example":"Can you rustle up a quick snack for us?","exampleTranslation":"Bạn có thể chuẩn bị nhanh một bữa ăn nhẹ cho chúng ta không?","rootVerb":"rustle","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"saw up":{"definition":"Cắt thành các mảnh bằng cưa.","example":"We sawed the plank up to make the shelves.","exampleTranslation":"Chúng tôi đã cưa tấm ván thành từng mảnh để đóng kệ.","rootVerb":"saw","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"screen off":{"definition":"Tách biệt một phần căn phòng bằng thứ gì đó như rèm, bình phong, v.v..","example":"We screened off the area where we had the discussion from the rest of the meeting.","exampleTranslation":"Chúng tôi đã dùng bình phong ngăn cách khu vực thảo luận với phần còn lại của cuộc họp.","rootVerb":"screen","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"screw around":{"definition":"Lăng nhăng trong chuyện tình dục.","example":"He screwed around a lot at university.","exampleTranslation":"Anh ta đã lăng nhăng rất nhiều khi còn học đại học.","rootVerb":"screw","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"send out for":{"definition":"Đặt đồ ăn mang về bằng điện thoại.","example":"We couldn't be bothered to cook, so we sent out for a pizza.","exampleTranslation":"Chúng tôi không muốn nấu nướng, nên chúng tôi đã gọi pizza mang đến.","rootVerb":"send","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"set in":{"definition":"Thay đổi mùa một cách rõ rệt.","example":"Winter has set in; it's started snowing.","exampleTranslation":"Mùa đông đã bắt đầu; tuyết đã rơi rồi.","rootVerb":"set","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"settle down":{"definition":"Bắt đầu cuộc sống ổn định và nề nếp.","example":"After years of partying and drinking, she finally got married and settled down.","exampleTranslation":"Sau nhiều năm tiệc tùng và nhậu nhẹt, cuối cùng cô ấy cũng kết hôn và ổn định cuộc sống.","rootVerb":"settle","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"settle in":{"definition":"Làm quen, thích nghi.","example":"It took him a while to settle in when he moved to Japan.","exampleTranslation":"Anh ấy mất một thời gian để làm quen khi chuyển đến Nhật Bản.","rootVerb":"settle","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"shack up":{"definition":"Sống tạm ở đâu đó.","example":"We had to shack up with friends while our house was being decorated.","exampleTranslation":"Chúng tôi đã phải ở nhờ nhà bạn bè trong khi nhà mình đang được trang trí lại.","rootVerb":"shack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"shake out":{"definition":"Giũ quần áo, vải vóc, v.v. để loại bỏ bụi bẩn hoặc nếp nhăn.","example":"He took the tablecloth outside and shook it out after dinner.","exampleTranslation":"Anh ấy đã mang khăn trải bàn ra ngoài và giũ sạch nó sau bữa tối.","rootVerb":"shake","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"show off":{"definition":"Làm cho những phẩm chất của một thứ khác trở nên rõ ràng hơn.","example":"The shirt really showed off his new tie.","exampleTranslation":"Chiếc áo thực sự làm nổi bật chiếc cà vạt mới của anh ấy.","rootVerb":"show","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sing along":{"definition":"Hát theo.","example":"I sang along when they played it on the radio.","exampleTranslation":"Tôi đã hát theo khi họ phát bài đó trên đài.","rootVerb":"sing","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sit about":{"definition":"Ngồi không, không làm gì cả.","example":"We spent the afternoon sitting about chatting instead of doing any work.","exampleTranslation":"Chúng tôi đã dành cả buổi chiều ngồi không tán gẫu thay vì làm việc.","rootVerb":"sit","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sit around":{"definition":"Ngồi không làm gì cả.","example":"They just sat around while the others did all the work.","exampleTranslation":"Họ chỉ ngồi không trong khi những người khác làm hết công việc.","rootVerb":"sit","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sit back":{"definition":"Chờ đợi điều gì đó xảy ra mà không cần nỗ lực.","example":"We sat back and waited for them to make the first mistake.","exampleTranslation":"Chúng tôi ngồi khoanh tay chờ đợi họ mắc sai lầm đầu tiên.","rootVerb":"sit","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sit over":{"definition":"Ăn uống chậm rãi.","example":"We sat over dinner discussing the plans.","exampleTranslation":"Chúng tôi vừa ngồi nhâm nhi bữa tối vừa thảo luận về các kế hoạch.","rootVerb":"sit","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sit through":{"definition":"Ngồi nán lại đến cuối dù nhàm chán.","example":"I was bored and wanted to leave halfway through, but we sat through the film.","exampleTranslation":"Tôi thấy chán và muốn bỏ về giữa chừng, nhưng chúng tôi vẫn ngồi lại xem cho hết bộ phim.","rootVerb":"sit","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"skin up":{"definition":"Cuốn cần sa.","example":"Who's going to skin up?","exampleTranslation":"Ai sẽ cuốn cần sa đây?","rootVerb":"skin","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sleep in":{"definition":"Ngủ nướng.","example":"Let’s sleep in tomorrow morning- we won’t have another chance for weeks.","exampleTranslation":"Hãy ngủ nướng vào sáng mai đi - chúng ta sẽ không có cơ hội khác trong nhiều tuần nữa đâu.","rootVerb":"sleep","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sleep over":{"definition":"Ngủ lại qua đêm ở nhà người khác.","example":"The au pair made tea for the friends who were sleeping over.","exampleTranslation":"Người giúp việc đã pha trà cho những người bạn đến ngủ lại qua đêm.","rootVerb":"sleep","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sleep through":{"definition":"Ngủ say không biết gì.","example":"I managed to sleep through the loud construction noise tonight.","exampleTranslation":"Tôi đã xoay sở ngủ say mà không hề hay biết gì về tiếng ồn xây dựng lớn đêm nay.","rootVerb":"sleep","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"slice up":{"definition":"Cắt thành từng miếng.","example":"I sliced the cake up and handed it round to the people there.","exampleTranslation":"Tôi đã cắt bánh thành từng miếng và mời mọi người ở đó.","rootVerb":"slice","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"slip by":{"definition":"Trôi qua nhanh (thời gian).","example":"The years slip by as you get older.","exampleTranslation":"Thời gian trôi đi nhanh chóng khi bạn già đi.","rootVerb":"slip","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"slob around":{"definition":"Lười biếng, không làm gì cả.","example":"I spent the day slobbing around at home.","exampleTranslation":"Tôi đã dành cả ngày lười biếng ở nhà.","rootVerb":"slob","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"snack on":{"definition":"Ăn vặt (món gì đó giữa các bữa chính).","example":"She likes to snack on fresh fruits and roasted nuts while studying.","exampleTranslation":"Cô ấy thích ăn vặt bằng trái cây tươi và các loại hạt rang khi đang học bài.","rootVerb":"snack","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"spark up":{"definition":"Châm điếu thuốc hoặc cần sa.","example":"They sparked up in a no smoking area.","exampleTranslation":"Họ đã châm thuốc trong khu vực cấm hút thuốc.","rootVerb":"spark","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"sponge down":{"definition":"Làm sạch bằng bọt biển.","example":"I'll sponge it down before putting it away.","exampleTranslation":"Tôi sẽ dùng bọt biển lau sạch nó trước khi cất đi.","rootVerb":"sponge","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"spruce up":{"definition":"Làm cho gọn gàng, ngăn nắp và sạch sẽ.","example":"We spruced the flat up before we put it on the market.","exampleTranslation":"Chúng tôi đã dọn dẹp căn hộ cho gọn gàng, sạch đẹp trước khi rao bán.","rootVerb":"spruce","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stand about":{"definition":"Dành thời gian ở một nơi để chờ đợi hoặc không làm gì hoặc làm rất ít.","example":"We stood about drinking coffee before the lecture.","exampleTranslation":"Chúng tôi đã đứng chôn chân uống cà phê trước buổi thuyết trình.","rootVerb":"stand","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stand around":{"definition":"Dành thời gian ở một nơi để chờ đợi hoặc không làm gì hoặc làm rất ít.","example":"We stood around for an hour waiting for them to turn up.","exampleTranslation":"Chúng tôi đã đứng chờ cả tiếng đồng hồ để đợi họ xuất hiện.","rootVerb":"stand","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"start on":{"definition":"Bắt đầu sử dụng hoặc tiêu thụ.","example":"It's time to start on that bottle of wine.","exampleTranslation":"Đã đến lúc bắt đầu khui chai rượu vang đó rồi.","rootVerb":"start","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stay in":{"definition":"Không đi ra ngoài.","example":"I'm going to stay in and chill tonight; I can't be bothered to go out.","exampleTranslation":"Tối nay tôi sẽ ở nhà và thư giãn; tôi không muốn đi ra ngoài.","rootVerb":"stay","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stay out":{"definition":"Không về nhà.","example":"We stayed out all night.","exampleTranslation":"Chúng tôi đã không về nhà cả đêm.","rootVerb":"stay","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stay over":{"definition":"Ở lại qua đêm.","example":"I stayed over at a friend's house last night because of the train strike.","exampleTranslation":"Tối qua tôi đã ở lại qua đêm nhà một người bạn vì cuộc đình công của tàu hỏa.","rootVerb":"stay","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stay up":{"definition":"Không đi ngủ.","example":"The children stayed up until way past their bedtime.","exampleTranslation":"Lũ trẻ đã không đi ngủ cho đến tận quá giờ đi ngủ của chúng.","rootVerb":"stay","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stick around":{"definition":"Ở lại một nơi trong một thời gian.","example":"He's late, but I'll stick around for another few minutes before I leave.","exampleTranslation":"Anh ấy đến muộn, nhưng tôi sẽ ở lại đây thêm vài phút nữa trước khi rời đi.","rootVerb":"stick","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stiffen up":{"definition":"Làm cho một cái gì đó cứng nhắc.","example":"They used starch to stiffen the collars up.","exampleTranslation":"Họ đã dùng hồ để làm cho cổ áo cứng lại.","rootVerb":"stiffen","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stop around":{"definition":"Ghé thăm ai đó trong một thời gian ngắn.","example":"Why don't you stop around my place on your way back?","exampleTranslation":"Tại sao bạn không ghé qua chỗ tôi trên đường quay về?","rootVerb":"stop","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"stop back":{"definition":"Quay lại đâu đó.","example":"I'll stop back this afternoon when you're free.","exampleTranslation":"Chiều nay khi nào bạn rảnh tôi sẽ quay lại.","rootVerb":"stop","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"straighten up":{"definition":"Đứng thẳng.","example":"She straightened up when her boss walked in.","exampleTranslation":"Cô ấy đứng thẳng dậy khi sếp cô ấy bước vào.","rootVerb":"straighten","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"suit up":{"definition":"Mặc quần áo hoặc mặc đồng phục cho một hoạt động hoặc nhiệm vụ.","example":"You should suit up before the big game.","exampleTranslation":"Bạn nên mặc đồ thi đấu trước khi trận đấu lớn bắt đầu.","rootVerb":"suit","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"take after":{"definition":"Trông giống.","example":"He takes after his mother.","exampleTranslation":"Nó trông giống mẹ nó.","rootVerb":"take","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"take in":{"definition":"Làm cho quần áo nhỏ lại.","example":"The jacket was far too big around the shoulders, so I had it taken in so that I could wear it.","exampleTranslation":"Chiếc áo khoác quá rộng ở phần vai, vì vậy tôi đã mang đi bóp lại để có thể mặc vừa.","rootVerb":"take","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"take to":{"definition":"Tập thói quen làm việc gì đó.","example":"He's taken to wearing a baseball cap since his hair started thinning more noticeably.","exampleTranslation":"Anh ấy đã tập thói quen đội mũ lưỡi trai kể từ khi tóc anh ấy bắt đầu thưa dần rõ rệt hơn.","rootVerb":"take","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tear away":{"definition":"Miễn cưỡng kéo ai đó rời khỏi nơi họ đang tập trung.","example":"I had to tear him away from the office for dinner.","exampleTranslation":"Tôi phải kéo anh ấy rời khỏi văn phòng để đi ăn tối.","rootVerb":"tear","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tear off":{"definition":"Xé một phần của mẫu đơn hoặc lá thư bằng tay, không dùng kéo.","example":"She tore the slip off the bottom of the form and sent it with her cheque.","exampleTranslation":"Cô ấy xé phần phiếu ở dưới cùng của tờ đơn và gửi nó kèm với tấm séc của mình.","rootVerb":"tear","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tee off":{"definition":"Đặt quả bóng gôn lên một chiếc gậy nhựa hoặc gỗ ngắn trước khi đánh vào đầu lỗ.","example":"He teed off at the first hole.","exampleTranslation":"Anh ấy đã đặt bóng lên cọc gỗ ở lỗ gôn đầu tiên trước khi đánh.","rootVerb":"tee","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tee up":{"definition":"Đặt quả bóng gôn lên một chiếc gậy nhựa hoặc gỗ ngắn trước khi đánh vào đầu lỗ.","example":"She teed up two strokes ahead at the last hole.","exampleTranslation":"Cô ấy đã đặt bóng vào vị trí sẵn sàng với lợi thế dẫn trước hai gậy ở lỗ gôn cuối cùng.","rootVerb":"tee","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"thaw out":{"definition":"Rã đông (thực phẩm); làm ấm người sau khi bị lạnh cóng.","example":"Take the frozen chicken out of the freezer to let it thaw out before dinner.","exampleTranslation":"Hãy lấy con gà đông lạnh ra khỏi tủ đông để rã đông trước bữa tối.","rootVerb":"thaw","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"throw on":{"definition":"Mặc quần áo nhanh chóng.","example":"I threw on a jacket and rushed outside.","exampleTranslation":"Tôi mặc vội chiếc áo khoác rồi chạy ra ngoài.","rootVerb":"throw","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"throw together":{"definition":"Làm hoặc sắp xếp nhanh chóng.","example":"I threw a quick dinner together before we left.","exampleTranslation":"Tôi đã làm nhanh một bữa tối trước khi chúng tôi rời đi.","rootVerb":"throw","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tidy up":{"definition":"Đặt mọi thứ vào đúng vị trí trong phòng.","example":"I tidied up my bedroom because it was a complete mess.","exampleTranslation":"Tôi đã dọn dẹp phòng ngủ của mình vì nó bừa bộn quá mức.","rootVerb":"tidy","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tie back":{"definition":"Buộc hoặc cố định lại để không gây cản trở.","example":"She tied her hair back before playing tennis.","exampleTranslation":"Cô ấy buộc tóc lại trước khi chơi quần vợt.","rootVerb":"tie","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"toss back":{"definition":"Uống nhanh.","example":"I tossed back my beer and left.","exampleTranslation":"Tôi uống cạn bia rồi rời đi.","rootVerb":"toss","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"toss down":{"definition":"Uống nhanh.","example":"I tossed a couple of drinks down before they arrived.","exampleTranslation":"Tôi đã uống nhanh vài ly trước khi họ đến.","rootVerb":"toss","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"touch up":{"definition":"Cải thiện vẻ ngoài của một cái gì đó.","example":"I couldn't be bothered to redecorate, so I just touched up the bits that needed painting the most.","exampleTranslation":"Tôi không muốn phải trang trí lại, vì vậy tôi chỉ sơn dặm lại những chỗ cần sơn nhất.","rootVerb":"touch","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tuck away":{"definition":"Đặt một cái gì đó ở một nơi an toàn.","example":"I tucked the money away in my drawer.","exampleTranslation":"Tôi đã cất số tiền đó vào ngăn kéo của mình một cách an toàn.","rootVerb":"tuck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tuck in":{"definition":"Sắp xếp chăn ga gối đệm để làm cho ai đó, thường là một đứa trẻ, thoải mái trên giường.","example":"He tucked her in and read her a story.","exampleTranslation":"Anh ấy đắp chăn cho cô bé và đọc cho cô bé nghe một câu chuyện.","rootVerb":"tuck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tuck into":{"definition":"Bắt đầu ăn một cái gì đó.","example":"I was starving and tucked into the food.","exampleTranslation":"Tôi đã rất đói và bắt đầu ăn ngấu nghiến.","rootVerb":"tuck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"tuck up":{"definition":"Sắp xếp chăn ga gối đệm để làm cho ai đó, thường là một đứa trẻ, thoải mái trên giường.","example":"She tucked her children up in bed and switched the lights off.","exampleTranslation":"Cô ấy đắp chăn ấm áp cho các con trên giường rồi tắt đèn.","rootVerb":"tuck","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"use up":{"definition":"Dùng hết hoặc tiêu thụ hết thứ gì đó.","example":"We used up all the olive oil.","exampleTranslation":"Chúng tôi đã dùng hết sạch dầu ô liu.","rootVerb":"use","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"vacuum up":{"definition":"Tiêu thụ, ăn hết.","example":"He vacuumed up all of the food.","exampleTranslation":"Anh ấy đã ăn sạch hết chỗ thức ăn đó.","rootVerb":"vacuum","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"veg out":{"definition":"Thư giãn, không làm gì cả.","example":"I'm going to veg out in front of the TV tonight.","exampleTranslation":"Tối nay tôi sẽ thư giãn và không làm gì cả trước TV.","rootVerb":"veg","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"wait in":{"definition":"Ở nhà vì ai đó sẽ đến thăm.","example":"I waited in for the guy to fix the TV.","exampleTranslation":"Tôi đã ở nhà để đợi người thợ đến sửa TV.","rootVerb":"wait","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"wait up":{"definition":"Không đi ngủ vì bạn đang đợi.","example":"I was worried and waited up until they got home safe and sound.","exampleTranslation":"Tôi đã lo lắng và không đi ngủ cho đến khi họ về nhà an toàn.","rootVerb":"wait","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"walk out":{"definition":"Rời khỏi một nơi trong sự tức giận hoặc vì bạn không hài lòng.","example":"The film was a bore so I walked out halfway through.","exampleTranslation":"Bộ phim thật chán ngắt nên tôi đã bỏ về giữa chừng.","rootVerb":"walk","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"walk out on":{"definition":"Rời bỏ ai đó trong sự tức giận.","example":"He walked out on his wife last year.","exampleTranslation":"Anh ấy đã bỏ vợ mình vào năm ngoái.","rootVerb":"walk","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"wash up":{"definition":"Dọn dẹp, rửa bát đĩa sau khi ăn.","example":"The children washed up after lunch.","exampleTranslation":"Lũ trẻ đã rửa bát đĩa sau bữa trưa.","rootVerb":"wash","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"while away":{"definition":"Giết thời gian làm việc gì đó vì bạn không có việc gì tốt hơn để làm.","example":"We whiled a couple of hours away playing computer games.","exampleTranslation":"Chúng tôi đã giết thời gian suốt vài giờ đồng hồ bằng việc chơi trò chơi điện tử.","rootVerb":"while","topicId":"daily-life","topicTitle":"Sinh hoạt và gia đình","partOfSpeech":"V","dictionarySource":"offline"},"ache for":{"definition":"khao khát; mong mỏi","example":"My partner's been away for a fortnight- I am aching for her.","exampleTranslation":"Người yêu tôi đã đi xa hai tuần rồi; tôi nhớ cô ấy vô cùng.","rootVerb":"ache","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"act out":{"definition":"bộc lộ (cảm xúc) qua hành vi","example":"Their anger is acted out in their antisocial behaviour.","exampleTranslation":"Sự giận dữ của họ được bộc lộ qua hành vi chống đối xã hội của họ.","rootVerb":"act","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"agree with":{"definition":"hợp (với dạ dày/sức khỏe)","example":"I feel terrible- that food didn't agree with my stomach.","exampleTranslation":"Tôi cảm thấy tệ quá - món đó không hợp với dạ dày của tôi.","rootVerb":"agree","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"ask after":{"definition":"hỏi thăm sức khỏe","example":"Jenny rang earlier and asked after you, so I told her you were fine.","exampleTranslation":"Jenny đã gọi điện lúc trước và hỏi thăm bạn, nên tôi nói với cô ấy là bạn vẫn khỏe.","rootVerb":"ask","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"be down":{"definition":"chán nản; buồn bã","example":"He's been down since his partner left him.","exampleTranslation":"Anh ấy đã buồn bã kể từ khi bạn đời rời bỏ anh ấy.","rootVerb":"be","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"be down with":{"definition":"bị ốm","example":"Gul is down with some bug and is off work today.","exampleTranslation":"Gul bị ốm vì nhiễm virus nào đó và hôm nay nghỉ làm.","rootVerb":"be","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"be fed up":{"definition":"chán ngấy","example":"I AM fed up of his complaints.","exampleTranslation":"Tôi đã chán ngấy những lời than phiền của anh ta rồi.","rootVerb":"be","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"be on":{"definition":"phong độ tốt; thể hiện xuất sắc","example":"He is really on right now- three goals in five minutes!","exampleTranslation":"Anh ấy thực sự đang có phong độ rất tốt - ghi ba bàn trong năm phút!","rootVerb":"be","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bear up":{"definition":"chịu đựng áp lực","example":"How are you bearing up under the strain?","exampleTranslation":"Bạn vẫn đang chịu đựng áp lực ổn chứ?","rootVerb":"bear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bear up under":{"definition":"chống chọi với (khó khăn)","example":"He's bearing up under the pressure.","exampleTranslation":"Anh ấy vẫn đang chống chọi với áp lực.","rootVerb":"bear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"big up":{"definition":"làm to cơ bắp (bằng tập luyện)","example":"They work out a lot to big themselves up.","exampleTranslation":"Họ tập luyện rất nhiều để làm cơ bắp to lên.","rootVerb":"big","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"black out":{"definition":"ngất xỉu","example":"He blacked out and collapsed on the floor.","exampleTranslation":"Anh ấy bị ngất xỉu và đổ gục xuống sàn.","rootVerb":"black","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"blank out":{"definition":"quên khuấy; trí nhớ trống rỗng","example":"I was so nervous in the interview that I just blanked out and couldn't answer their questions properly.","exampleTranslation":"Tôi đã rất lo lắng trong buổi phỏng vấn đến mức tôi bị trống rỗng và không thể trả lời các câu hỏi của họ một cách tử tế.","rootVerb":"blank","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bleed out":{"definition":"chảy máu đến chết","example":"They bled out their calves.","exampleTranslation":"Họ làm chảy máu đến chết bắp chân của chúng.","rootVerb":"bleed","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bliss out":{"definition":"cực kỳ thư giãn và hạnh phúc","example":"I blissed out on the beach all week.","exampleTranslation":"Tôi đã tận hưởng cảm giác cực kỳ thư giãn và hạnh phúc trên bãi biển suốt cả tuần.","rootVerb":"bliss","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"block out":{"definition":"cố quên đi (những thứ đau buồn)","example":"It was so unpleasant that I try to block it out- otherwise, I'd just be angry all the time.","exampleTranslation":"Điều đó thật khó chịu đến mức tôi cố quên đi - nếu không, tôi sẽ cứ tức giận suốt thôi.","rootVerb":"block","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"blow away":{"definition":"gây ấn tượng mạnh","example":"Her first novel blew me away.","exampleTranslation":"Cuốn tiểu thuyết đầu tay của cô ấy đã gây ấn tượng mạnh với tôi.","rootVerb":"blow","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"boil over":{"definition":"Mất bình tĩnh và trở nên tồi tệ (tình hình).","example":"The tension had been building up and it boiled over in the meeting.","exampleTranslation":"Sự căng thẳng đã tích tụ và bùng phát trong buổi họp.","rootVerb":"boil","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"boil up":{"definition":"Cảm thấy một cảm xúc tiêu cực một cách mạnh mẽ.","example":"The anger boiled up in me when I saw what they had done.","exampleTranslation":"Cơn giận dữ bùng lên trong tôi khi tôi nhìn thấy những gì họ đã làm.","rootVerb":"boil","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bottle away":{"definition":"Kìm nén (cảm xúc).","example":"He kept his feelings bottled away.","exampleTranslation":"Anh ấy kìm nén cảm xúc của mình.","rootVerb":"bottle","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bottle out":{"definition":"Thiếu can đảm để làm việc gì đó.","example":"She was going to tell her boss exactly what she thought, but bottled out in the end.","exampleTranslation":"Cô ấy đã định nói thẳng với sếp suy nghĩ của mình, nhưng cuối cùng lại thiếu can đảm để làm.","rootVerb":"bottle","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bottle up":{"definition":"Kìm nén (cảm xúc).","example":"She bottled up her feelings even though she was furious with them and kept quiet.","exampleTranslation":"Cô ấy kìm nén cảm xúc của mình mặc dù cô ấy đang rất giận dữ với họ và giữ im lặng.","rootVerb":"bottle","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bowl over":{"definition":"Gây ngạc nhiên lớn.","example":"I was bowled over by the news.","exampleTranslation":"Tôi đã rất ngạc nhiên trước tin tức đó.","rootVerb":"bowl","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"brace up":{"definition":"Tự tin hoặc lạc quan hơn.","example":"You should brace up and stop worrying.","exampleTranslation":"Bạn nên tự tin và lạc quan lên, đừng lo lắng nữa.","rootVerb":"brace","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"break out in":{"definition":"Nổi mẩn, phát ban.","example":"The measles caused me to break out in a rash.","exampleTranslation":"Bệnh sởi đã làm tôi bị nổi mẩn đỏ khắp người.","rootVerb":"break","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"brighten up":{"definition":"Làm cho thứ gì đó đẹp đẽ, tươi sáng hơn.","example":"We tried to brighten the place up by painting it.","exampleTranslation":"Chúng tôi đã cố gắng làm nơi này đẹp đẽ và tươi sáng hơn bằng cách sơn lại nó.","rootVerb":"brighten","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bring back":{"definition":"Gợi nhớ lại.","example":"Visiting my old school brought back memories of when I was a pupil there.","exampleTranslation":"Việc ghé thăm ngôi trường cũ gợi nhớ lại những kỷ niệm khi tôi còn là một học sinh ở đó.","rootVerb":"bring","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bring on":{"definition":"Gây ra hoặc đẩy nhanh quá trình.","example":"Stress can often bring on a bad headache.","exampleTranslation":"Căng thẳng thường có thể gây ra một cơn đau đầu dữ dội.","rootVerb":"bring","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bubble over":{"definition":"Quá phấn khích.","example":"She bubbled over with joy when she heard her exam results.","exampleTranslation":"Cô ấy đã quá phấn khích khi nghe kết quả thi của mình.","rootVerb":"bubble","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"buck up":{"definition":"Chỉnh đốn lại, làm tốt hơn.","example":"You had better buck your ideas up, or you'll fail the course.","exampleTranslation":"Bạn tốt nhất là nên chỉnh đốn lại tư tưởng đi, nếu không bạn sẽ trượt khóa học đấy.","rootVerb":"buck","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"bulk up":{"definition":"Tăng cân, phát triển cơ bắp.","example":"He's bulked up a lot since he got those steroids.","exampleTranslation":"Anh ấy đã tăng cân và phát triển cơ bắp lên nhiều kể từ khi dùng mấy loại thuốc kích thích đó.","rootVerb":"bulk","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"buoy up":{"definition":"Làm ai đó cảm thấy tích cực hơn.","example":"After so much criticism, the positive review buoyed him up.","exampleTranslation":"Sau rất nhiều lời chỉ trích, bài đánh giá tích cực đã giúp anh ấy cảm thấy tích cực hơn.","rootVerb":"buoy","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"burn off":{"definition":"Đốt cháy (calo, năng lượng).","example":"I burn off a lot of calories in the gym.","exampleTranslation":"Tôi đốt cháy rất nhiều calo tại phòng tập.","rootVerb":"burn","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"care for":{"definition":"Thích.","example":"I don't care for fizzy drinks; I prefer water.","exampleTranslation":"Tôi không thích đồ uống có ga; tôi thích uống nước lọc hơn.","rootVerb":"care","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"carried away":{"definition":"Mất kiểm soát vì quá xúc động.","example":"The crowd got carried away by the loud music.","exampleTranslation":"Đám đông đã mất kiểm soát vì âm nhạc quá ồn ào.","rootVerb":"carried","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"check up":{"definition":"Kiểm tra, thăm khám, kiểm tra tình hình.","example":"The doctor asked me to come back next month for a quick check up.","exampleTranslation":"Bác sĩ yêu cầu tôi quay lại vào tháng sau để kiểm tra sức khỏe nhanh.","rootVerb":"check","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"chew off":{"definition":"Cắn đứt.","example":"The dog chewed off the man's face.","exampleTranslation":"Con chó đã cắn đứt mặt của người đàn ông.","rootVerb":"chew","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"chicken out":{"definition":"Sợ hãi không dám làm.","example":"I chickened out of the bungee jumping when I saw how high it was.","exampleTranslation":"Tôi đã sợ hãi không dám nhảy bungee khi nhìn thấy độ cao của nó.","rootVerb":"chicken","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"chill out":{"definition":"Thư giãn.","example":"I'm staying at home and chilling out this evening.","exampleTranslation":"Tôi sẽ ở nhà và thư giãn vào tối nay.","rootVerb":"chill","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"choke up":{"definition":"Cầm cao lên (cán gậy).","example":"He choked up on the bat and hit the ball better.","exampleTranslation":"Anh ấy cầm cao gậy lên và đánh bóng tốt hơn.","rootVerb":"choke","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cling to":{"definition":"Bám víu vào (niềm tin, hy vọng).","example":"They cling to their old way of thinking.","exampleTranslation":"Họ cứ bám víu vào lối suy nghĩ cũ kỹ của mình.","rootVerb":"cling","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"come around":{"definition":"Tỉnh lại.","example":"It took several hours after the operation before he came around.","exampleTranslation":"Phải mất vài giờ sau ca phẫu thuật anh ấy mới tỉnh lại.","rootVerb":"come","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"come down with":{"definition":"Bị ốm.","example":"She came down with a virus.","exampleTranslation":"Cô ấy bị mắc một loại virus.","rootVerb":"come","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"come out in":{"definition":"Nổi ban hoặc vấn đề da liễu tương tự.","example":"She came out in a nasty rash after touching the poisonous plant by mistake.","exampleTranslation":"Cô ấy bị nổi mẩn đỏ khó chịu sau khi lỡ chạm vào cây độc đó.","rootVerb":"come","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"come over":{"definition":"Ảnh hưởng tinh thần theo cách làm thay đổi hành vi.","example":"I'm sorry about last night - I don't know what came over me.","exampleTranslation":"Tôi xin lỗi về chuyện tối qua - tôi không biết điều gì đã khiến tôi cư xử như vậy nữa.","rootVerb":"come","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"come to":{"definition":"Tỉnh lại, tỉnh dậy sau khi gây mê.","example":"She came to an hour after the operation.","exampleTranslation":"Cô ấy tỉnh lại một giờ sau ca phẫu thuật.","rootVerb":"come","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"conjure up":{"definition":"Gợi lên hình ảnh hoặc ký ức trong tâm trí ai đó.","example":"It conjures up memories of my school days.","exampleTranslation":"Nó gợi lại những ký ức về thời đi học của tôi.","rootVerb":"conjure","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cool down":{"definition":"Bình tĩnh lại.","example":"It took me ages to cool down after the argument.","exampleTranslation":"Tôi đã mất rất lâu mới bình tĩnh lại được sau cuộc tranh cãi.","rootVerb":"cool","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cool off":{"definition":"Bình tĩnh lại hơn.","example":"We’ll talk to Fred once he cools off and can talk rationally.","exampleTranslation":"Chúng ta sẽ nói chuyện với Fred khi cậu ấy bình tĩnh lại và có thể nói chuyện một cách lý trí.","rootVerb":"cool","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cope with":{"definition":"Đối phó, đương đầu, xử lý tốt.","example":"She found it hard to cope with the high stress of exam season.","exampleTranslation":"Cô ấy thấy khó mà đương đầu với áp lực lớn của mùa thi cử.","rootVerb":"cope","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cozy up":{"definition":"Làm cho bản thân thoải mái.","example":"It was cold and I cozied up by the fire.","exampleTranslation":"Trời lạnh nên tôi đã ngồi sát vào bên lò sưởi cho ấm áp.","rootVerb":"cozy","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"creep into":{"definition":"Bắt đầu dễ nhận thấy trong cái gì đó.","example":"An angry tone crept into her voice.","exampleTranslation":"Một giọng điệu giận dữ đã len lỏi vào giọng nói của cô ấy.","rootVerb":"creep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"creep out":{"definition":"Làm ai đó lo lắng hoặc bất an.","example":"He creeps me out when he gets drunk.","exampleTranslation":"Anh ta làm tôi thấy ghê người khi say rượu.","rootVerb":"creep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"creep over":{"definition":"Bắt đầu có cảm giác tiêu cực.","example":"Fear crept over me as I walked through the graveyard.","exampleTranslation":"Nỗi sợ hãi dần bao trùm lấy tôi khi tôi đi xuyên qua nghĩa địa.","rootVerb":"creep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cry out":{"definition":"Hét lên vì đau đớn.","example":"He cried out when he dropped the box on his toes.","exampleTranslation":"Anh ấy hét lên vì đau khi làm rơi chiếc hộp vào ngón chân.","rootVerb":"cry","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"cut down on":{"definition":"Giảm bớt.","example":"Doctors advised her to cut down on the amount of saturated fats in her diet.","exampleTranslation":"Các bác sĩ khuyên cô ấy nên cắt giảm lượng chất béo bão hòa trong chế độ ăn uống của mình.","rootVerb":"cut","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"damp down":{"definition":"Làm dịu hoặc giảm bớt cảm xúc.","example":"They tried to damp down the anger over the announcement.","exampleTranslation":"Họ đã cố gắng làm dịu bớt sự phẫn nộ về thông báo đó.","rootVerb":"damp","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"die away":{"definition":"Nhỏ dần hoặc tắt hẳn (âm thanh).","example":"The last notes died away and the audience burst into applause.","exampleTranslation":"Những nốt nhạc cuối cùng nhỏ dần và khán giả vỗ tay tán thưởng.","rootVerb":"die","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"die down":{"definition":"Giảm xuống hoặc dịu đi.","example":"It was on the front pages of all the papers for a few days, but the interest gradually died down.","exampleTranslation":"Tin tức đó đã lên trang nhất của tất cả các tờ báo trong vài ngày, nhưng sự quan tâm dần dần cũng lắng xuống.","rootVerb":"die","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"die for":{"definition":"Rất thèm muốn thứ gì đó.","example":"I'm dying for the weekend- this week's been so hard.","exampleTranslation":"Tôi đang rất thèm được nghỉ cuối tuần - tuần này thật quá vất vả.","rootVerb":"die","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"disagree with":{"definition":"Làm ai đó thấy buồn nôn hoặc ốm (đồ ăn).","example":"I feel dreadful; the prawns I had for lunch are disagreeing with me.","exampleTranslation":"Tôi cảm thấy rất khó chịu; món tôm tôi ăn trưa nay không hợp với bụng tôi.","rootVerb":"disagree","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"do in":{"definition":"Giết.","example":"After he reported the gang, he feared they would do him in.","exampleTranslation":"Sau khi tố cáo băng đảng, anh ấy sợ rằng chúng sẽ giết mình.","rootVerb":"do","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"double over":{"definition":"Cúi gập người.","example":"She doubled over in pain after being hit in the stomach.","exampleTranslation":"Cô ấy gập người vì đau sau khi bị đấm vào bụng.","rootVerb":"double","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"dwell on":{"definition":"Nhai đi nhai lại một vấn đề.","example":"The programme dwelled on little other than the scandal.","exampleTranslation":"Chương trình đó không đề cập gì nhiều ngoài vụ bê bối.","rootVerb":"dwell","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"ease off":{"definition":"Giảm áp lực, dịu bớt.","example":"She eased off the accelerator to let the car slow down.","exampleTranslation":"Cô ấy giảm áp lực lên chân ga để xe chạy chậm lại.","rootVerb":"ease","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"ease up":{"definition":"Bình tĩnh lại, thư giãn.","example":"She asked her teacher to ease up because she was feeling very stressed.","exampleTranslation":"Cô ấy nhờ giáo viên nương tay vì cô ấy đang cảm thấy rất căng thẳng.","rootVerb":"ease","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"eat away":{"definition":"Ăn mòn, tàn phá từ từ.","example":"The disease eats the liver away.","exampleTranslation":"Căn bệnh ăn mòn lá gan.","rootVerb":"eat","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"ebb away":{"definition":"tiêu tốn. Dần biến mất.","example":"His life slowly ebbed away as the illness progressed.","exampleTranslation":"Sự sống của ông ấy dần cạn kiệt khi bệnh tình tiến triển.","rootVerb":"ebb","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"face up to":{"definition":"Chấp nhận một sự thật không mấy tốt đẹp.","example":"Many people find it hard to face up to the fact that they are getting old.","exampleTranslation":"Nhiều người thấy khó mà đối diện với sự thật rằng họ đang già đi.","rootVerb":"face","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"fall about":{"definition":"Cười rất nhiều.","example":"We fell about when we heard what she'd done.","exampleTranslation":"Chúng tôi cười nghiêng ngả khi nghe những gì cô ấy đã làm.","rootVerb":"fall","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"fall apart":{"definition":"Suy sụp tinh thần và không thể cư xử bình thường.","example":"He fell apart when they sacked him.","exampleTranslation":"Anh ấy suy sụp hoàn toàn khi họ sa thải anh ấy.","rootVerb":"fall","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"feed up":{"definition":"Cho ai đó nhiều thức ăn để phục hồi sức khỏe.","example":"She's been ill for a fortnight so we're feeding her up.","exampleTranslation":"Cô ấy đã bị ốm hai tuần rồi nên chúng tôi đang tẩm bổ cho cô ấy.","rootVerb":"feed","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"feel up to":{"definition":"Cảm thấy có khả năng làm điều gì đó.","example":"I'm so tired. I don't think I feel up to going out tonight.","exampleTranslation":"Tôi mệt quá. Tôi không nghĩ mình đủ sức để đi chơi tối nay.","rootVerb":"feel","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"fight back":{"definition":"Cố gắng kìm nén cảm xúc và giấu kín nó.","example":"She tried to fight back her anger during the meeting.","exampleTranslation":"Cô ấy đã cố gắng kìm nén cơn giận trong suốt cuộc họp.","rootVerb":"fight","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"fire up":{"definition":"Làm cho phấn khích, trở nên phấn khích.","example":"Everyone was fired up and desperate to get it finished in time.","exampleTranslation":"Mọi người đều rất phấn khích và quyết tâm hoàn thành nó đúng hạn.","rootVerb":"fire","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"flake out":{"definition":"Ngủ thiếp đi vì kiệt sức.","example":"I worked till midnight then flaked out.","exampleTranslation":"Tôi đã làm việc đến nửa đêm rồi ngủ thiếp đi vì kiệt sức.","rootVerb":"flake","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"flame up":{"definition":"Cháy sáng lên.","example":"The wood flamed up in the fire.","exampleTranslation":"Cây củi bốc cháy dữ dội trong lò lửa.","rootVerb":"flame","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"flare out":{"definition":"Đột nhiên nổi giận.","example":"He flared out when he saw the dreadful report.","exampleTranslation":"Anh ấy đột nhiên nổi giận khi nhìn thấy bản báo cáo tồi tệ đó.","rootVerb":"flare","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"flare up":{"definition":"Khi rắc rối đột nhiên xuất hiện.","example":"The argument flared up when he was rude to them.","exampleTranslation":"Cuộc tranh cãi bùng phát khi anh ấy thô lỗ với họ.","rootVerb":"flare","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"fly into":{"definition":"Thay đổi cảm xúc nhanh chóng.","example":"He flew into a rage.","exampleTranslation":"Anh ấy nổi cơn thịnh nộ.","rootVerb":"fly","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"freak out":{"definition":"Trở nên rất hoảng loạn hoặc tức giận.","example":"She freaked out completely when she didn't get the grades to get into university.","exampleTranslation":"Cô ấy đã hoàn toàn hoảng loạn khi không đạt đủ điểm để vào đại học.","rootVerb":"freak","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"gag for":{"definition":"Rất thèm muốn thứ gì đó.","example":"I'm gagging for a drink.","exampleTranslation":"Tôi đang rất thèm một ly nước.","rootVerb":"gag","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get down":{"definition":"Làm ai đó buồn bã, chán nản, kiệt sức.","example":"The miserable weather in winter really gets me down.","exampleTranslation":"Thời tiết ảm đạm vào mùa đông thực sự làm tôi chán nản.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get it off":{"definition":"Quan hệ tình dục.","example":"They got IT off at the party.","exampleTranslation":"Họ đã quan hệ tình dục với nhau tại bữa tiệc.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get it off with":{"definition":"Quan hệ tình dục với ai.","example":"She got IT off with her friend's husband.","exampleTranslation":"Cô ấy đã quan hệ tình dục với chồng của bạn mình.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get it on":{"definition":"Trở nên hứng thú hoặc phấn khích.","example":"The talk was dull and nobody got IT on.","exampleTranslation":"Cuộc nói chuyện thật tẻ nhạt và chẳng ai thấy hứng thú cả.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get it on with":{"definition":"Quan hệ tình dục với ai.","example":"Did you get IT on with him?","exampleTranslation":"Bạn đã quan hệ với anh ta chưa?","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get it up":{"definition":"Bị kích thích (ở nam giới).","example":"He couldn't get IT up and felt very embarrassed.","exampleTranslation":"Anh ấy không thể cương cứng được và cảm thấy rất xấu hổ.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get off on":{"definition":"Thỏa mãn nhờ dùng thuốc/ma túy.","example":"He gets off on crystal meth every night.","exampleTranslation":"Đêm nào anh ta cũng thỏa mãn nhờ dùng ma túy đá.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"get off with":{"definition":"Quan hệ tình dục qua đường với ai.","example":"He got off with her at the party.","exampleTranslation":"Anh ấy đã quan hệ tình dục qua đường với cô ấy tại bữa tiệc.","rootVerb":"get","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"ginger up":{"definition":"Làm cho sôi nổi hơn.","example":"They tried to ginger up the party to stop people leaving.","exampleTranslation":"Họ đã cố gắng làm cho bữa tiệc sôi nổi hơn để ngăn mọi người ra về.","rootVerb":"ginger","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"give up on":{"definition":"Mất niềm tin vào ai/cái gì.","example":"I gave up on them when I heard what they were saying about me behind my back.","exampleTranslation":"Tôi đã mất niềm tin vào họ khi nghe những điều họ nói về tôi sau lưng mình.","rootVerb":"give","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"gnaw at":{"definition":"Làm ai dằn vặt, lo lắng.","example":"I know it was wrong and guilt has gnawed at me ever since I did it.","exampleTranslation":"Tôi biết điều đó là sai và cảm giác tội lỗi đã làm tôi dằn vặt kể từ khi tôi làm điều đó.","rootVerb":"gnaw","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"gnaw away at":{"definition":"Gặm nhấm, phá hoại dần.","example":"Their behaviour gnawed away at our trust in them.","exampleTranslation":"Hành vi của họ đã gặm nhấm dần niềm tin của chúng tôi dành cho họ.","rootVerb":"gnaw","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"go down on":{"definition":"Thực hiện tình dục bằng miệng.","example":"He went down on her.","exampleTranslation":"Anh ấy đã thực hiện tình dục bằng miệng với cô ấy.","rootVerb":"go","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"go in":{"definition":"Vào viện (để điều trị, phẫu thuật).","example":"He went in for a triple bypass operation two days ago.","exampleTranslation":"Anh ấy đã vào viện để làm phẫu thuật bắc cầu mạch vành ba nhánh hai ngày trước.","rootVerb":"go","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"go under":{"definition":"Mất đi ý thức (do thuốc mê).","example":"She went under a few minutes after they administered the anaesthetic.","exampleTranslation":"Cô ấy đã mất ý thức vài phút sau khi họ gây mê cho cô.","rootVerb":"go","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"grind down":{"definition":"Giảm bớt hoặc phá hủy sự nhiệt tình của ai đó.","example":"The long work hours grind down his energy.","exampleTranslation":"Thời gian làm việc dài ngày làm tiêu hao năng lượng của anh ấy.","rootVerb":"grind","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"grow back":{"definition":"Mọc lại.","example":"Nails grow back quickly after you cut them.","exampleTranslation":"Móng tay mọc lại nhanh chóng sau khi bạn cắt chúng.","rootVerb":"grow","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"grow on":{"definition":"Có sức ảnh hưởng lớn hơn hoặc được chấp nhận nhiều hơn.","example":"The plans sounded strange at first, but they have grown on me.","exampleTranslation":"Các kế hoạch nghe có vẻ lạ lẫm lúc đầu, nhưng chúng đã dần trở nên đáng chấp nhận hơn đối với tôi.","rootVerb":"grow","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"grow to":{"definition":"Dần dần làm việc gì đó.","example":"We grew to like the neighbourhood.","exampleTranslation":"Chúng tôi dần dần trở nên yêu thích khu phố đó.","rootVerb":"grow","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"grow upon":{"definition":"Có sức ảnh hưởng lớn hơn hoặc được chấp nhận nhiều hơn.","example":"As we got nearer the date of the meeting, their idea grew upon me.","exampleTranslation":"Khi chúng tôi đến gần ngày họp, ý tưởng của họ càng trở nên có sức ảnh hưởng hơn đối với tôi.","rootVerb":"grow","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hack off":{"definition":"Làm phiền, gây khó chịu.","example":"He hacks me off with his endless complaining.","exampleTranslation":"Anh ta làm tôi thấy khó chịu với việc than vãn không ngừng của mình.","rootVerb":"hack","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hang over":{"definition":"Lo lắng hoặc rắc rối.","example":"I have a lot of financial problem hanging over my head.","exampleTranslation":"Tôi có rất nhiều vấn đề tài chính đang đè nặng trong đầu mình.","rootVerb":"hang","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hanker after":{"definition":"Thèm muốn điều gì đó rất nhiều, đặc biệt là khi bạn không nên muốn hoặc không thể có được nó.","example":"I'm supposed to be on a diet and I can't stop hankering after some chocolate.","exampleTranslation":"Đáng lẽ tôi phải ăn kiêng nhưng tôi không thể ngừng thèm muốn chút sô cô la.","rootVerb":"hanker","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hanker for":{"definition":"Thèm muốn điều gì đó rất nhiều, đặc biệt là khi bạn không nên muốn hoặc không thể có được nó.","example":"I have always hankered for a soft- top car.","exampleTranslation":"Tôi luôn thèm muốn một chiếc xe mui trần.","rootVerb":"hanker","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hate on":{"definition":"Ghen tị, lạm dụng hoặc thù ghét ai đó.","example":"She hates on people who disagree with her ideas.","exampleTranslation":"Cô ấy ghen tị với những người không đồng ý với quan điểm của mình.","rootVerb":"hate","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"have against":{"definition":"Không thích, không đồng ý hoặc có ác cảm (Thường là tiêu cực).","example":"I have nothing against their proposals.","exampleTranslation":"Tôi không có ác cảm gì với các đề xuất của họ.","rootVerb":"have","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"have it in for":{"definition":"Giữ ác cảm.","example":"He has had IT in for me since I beat him last year.","exampleTranslation":"Anh ta đã giữ ác cảm với tôi kể từ khi tôi đánh bại anh ta năm ngoái.","rootVerb":"have","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hit up on":{"definition":"Tiêm ma túy.","example":"He's been hitting up on heroin for years.","exampleTranslation":"Anh ta đã tiêm ma túy heroin nhiều năm nay rồi.","rootVerb":"hit","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hold against":{"definition":"Có ác cảm với ai đó, hoặc thiếu tôn trọng.","example":"He was very rude, but I won't hold it against him.","exampleTranslation":"Anh ấy đã rất thô lỗ, nhưng tôi sẽ không để bụng chuyện đó với anh ấy.","rootVerb":"hold","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"hold back from":{"definition":"Không cho phép bản thân làm điều gì đó.","example":"I had to hold back from losing my temper with them.","exampleTranslation":"Tôi đã phải cố kiềm chế để không nổi nóng với họ.","rootVerb":"hold","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"jump at":{"definition":"Chấp nhận một cách háo hức.","example":"I'd jump at the chance to go and live in Japan.","exampleTranslation":"Tôi sẽ chớp lấy cơ hội để đến sống ở Nhật Bản.","rootVerb":"jump","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"keel over":{"definition":"Đầu hàng, nhượng bộ.","example":"He was going to confront his boss, but keeled over and didn't mention the matter.","exampleTranslation":"Anh ấy định đối mặt với sếp của mình, nhưng lại nhượng bộ và không hề đề cập đến vấn đề đó.","rootVerb":"keel","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"keep down":{"definition":"Không nôn.","example":"The food was so horrible that I struggled to keep it down.","exampleTranslation":"Đồ ăn tệ đến mức tôi đã phải rất vất vả mới không bị nôn ra.","rootVerb":"keep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"keep from":{"definition":"Kiểm soát bản thân, kiềm chế.","example":"I couldn't keep from arguing with her.","exampleTranslation":"Tôi đã không thể kiềm chế bản thân để không tranh cãi với cô ấy.","rootVerb":"keep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"key down":{"definition":"Thư giãn.","example":"I need to key down before I go to bed.","exampleTranslation":"Tôi cần thư giãn trước khi đi ngủ.","rootVerb":"key","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"key up":{"definition":"Làm ai đó phấn khích hoặc lo lắng.","example":"The noise got us keyed up.","exampleTranslation":"Tiếng ồn làm chúng tôi thấy phấn khích và lo lắng.","rootVerb":"key","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"kick in":{"definition":"Khi thuốc bắt đầu có tác dụng.","example":"Wait a few minutes for the medicine to kick in.","exampleTranslation":"Hãy đợi vài phút để thuốc bắt đầu có tác dụng.","rootVerb":"kick","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"kick up":{"definition":"Gây ra rắc rối hoặc đau đớn.","example":"My back kicks up when it gets cold.","exampleTranslation":"Lưng tôi lại đau khi trời trở lạnh.","rootVerb":"kick","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"laugh off":{"definition":"Cười xòa coi như không quan trọng.","example":"He laughed off the sprained finger but it obviously affected his golf game.","exampleTranslation":"Anh ấy cười xòa coi nhẹ ngón tay bị bong gân nhưng điều đó rõ ràng đã ảnh hưởng đến trận đánh gôn của anh ấy.","rootVerb":"laugh","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"leap at":{"definition":"Chớp lấy cơ hội một cách nhiệt tình.","example":"He leaped at the chance to visit.","exampleTranslation":"Anh ấy đã chớp lấy cơ hội để đi thăm một cách nhiệt tình.","rootVerb":"leap","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"leap out at":{"definition":"Rất dễ nhận thấy, đập vào mắt.","example":"The bright red sign will leap out at you.","exampleTranslation":"Bảng hiệu màu đỏ sáng rực sẽ đập ngay vào mắt bạn.","rootVerb":"leap","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"lighten up":{"definition":"Bớt nghiêm túc lại.","example":"I told them to lighten up but they continued complaining about it.","exampleTranslation":"Tôi bảo họ hãy bớt nghiêm túc lại nhưng họ vẫn tiếp tục than phiền về điều đó.","rootVerb":"lighten","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"limber up":{"definition":"Khởi động trước khi chơi thể thao.","example":"The team limbered up for a few minutes before the game started.","exampleTranslation":"Cả đội đã khởi động vài phút trước khi trận đấu bắt đầu.","rootVerb":"limber","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"live down":{"definition":"Quên đi sự xấu hổ về chuyện gì.","example":"If I fail the test and everyone else passes, I'll never be able to live it down.","exampleTranslation":"Nếu tôi trượt bài kiểm tra này trong khi những người khác đều đỗ, tôi sẽ không bao giờ quên được sự xấu hổ đó.","rootVerb":"live","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"live through":{"definition":"Trải qua.","example":"It was hard to live through the recession, but we managed it.","exampleTranslation":"Thật khó khăn để trải qua thời kỳ suy thoái kinh tế, nhưng chúng tôi đã xoay sở được.","rootVerb":"live","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"live with":{"definition":"Chấp nhận sống chung với điều gì đó khó chịu.","example":"It's hard to live with the pain of a serious illness.","exampleTranslation":"Thật khó để chấp nhận sống chung với nỗi đau của một căn bệnh hiểm nghèo.","rootVerb":"live","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"load up":{"definition":"Chơi ma túy.","example":"He's been loading up for years.","exampleTranslation":"Anh ta đã chơi ma túy nhiều năm nay rồi.","rootVerb":"load","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"look forward to":{"definition":"Mong đợi.","example":"I'm looking forward to meeting you.","exampleTranslation":"Tôi rất mong đợi được gặp bạn.","rootVerb":"look","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"loosen up":{"definition":"Trở nên thư giãn hơn.","example":"He was very shy at first but has loosened up and is more talkative now.","exampleTranslation":"Ban đầu anh ấy rất nhút nhát nhưng giờ đã trở nên thư giãn hơn và nói nhiều hơn rồi.","rootVerb":"loosen","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"lust after":{"definition":"Bị hấp dẫn về mặt tình dục.","example":"He secretly lusts after his friend’s wife.","exampleTranslation":"Anh ta lén lút bị vợ của bạn mình hấp dẫn.","rootVerb":"lust","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"man up":{"definition":"Cư xử dũng cảm hoặc có niềm tin.","example":"She told her anonymous critics to man up and speak publicly.","exampleTranslation":"Cô ấy bảo những kẻ chỉ trích ẩn danh của mình hãy cư xử dũng cảm lên và lên tiếng công khai.","rootVerb":"man","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"mess up":{"definition":"Gây ra vấn đề tâm lý, thể chất.","example":"He took a lot of lsd and it really messed him up.","exampleTranslation":"Anh ta đã dùng nhiều thuốc lắc và nó thực sự gây ra vấn đề tâm lý, thể chất nghiêm trọng cho anh ấy.","rootVerb":"mess","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"mope about":{"definition":"Đi lại với vẻ mặt buồn bã.","example":"She didn't get the job and has been moping about all afternoon.","exampleTranslation":"Cô ấy không nhận được công việc đó và cứ đi lại với vẻ mặt buồn bã suốt cả buổi chiều.","rootVerb":"mope","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"mope around":{"definition":"Đi lại với vẻ mặt buồn rầu.","example":"He's been moping around since his girlfriend left him.","exampleTranslation":"Anh ấy cứ đi lại với vẻ mặt buồn rầu kể từ khi bạn gái rời bỏ anh ấy.","rootVerb":"mope","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"operate on":{"definition":"Phẫu thuật.","example":"She was operated on for eight hours.","exampleTranslation":"Cô ấy đã được phẫu thuật trong tám giờ.","rootVerb":"operate","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pass away":{"definition":"Qua đời.","example":"Sadly, Georgia's uncle passed away yesterday after a short illness.","exampleTranslation":"Đáng buồn thay, chú của Georgia đã qua đời ngày hôm qua sau một cơn bạo bệnh.","rootVerb":"pass","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pass out":{"definition":"Ngất xỉu, mất ý thức.","example":"He got so drunk that he passed out.","exampleTranslation":"Anh ta đã uống say đến mức ngất xỉu.","rootVerb":"pass","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"patch up":{"definition":"Sơ cứu y tế cơ bản cho người bị thương.","example":"After the accident, they patched her up and sent her to hospital.","exampleTranslation":"Sau vụ tai nạn, họ đã sơ cứu vết thương cho cô ấy rồi đưa vào bệnh viện.","rootVerb":"patch","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pep up":{"definition":"Làm cho một cái gì đó thú vị hơn.","example":"You need to pep your writing up.","exampleTranslation":"Bạn cần làm cho bài viết của mình thú vị hơn.","rootVerb":"pep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"perk up":{"definition":"Cảm thấy khỏe hơn hoặc vui hơn, làm cho ai đó cảm thấy khỏe hơn hoặc vui hơn.","example":"She was ill in bed with flu, but she perked up a bit when some friends dropped by.","exampleTranslation":"Cô ấy đang ốm nằm liệt giường vì cúm, nhưng cô ấy đã cảm thấy khỏe hơn một chút khi vài người bạn ghé qua.","rootVerb":"perk","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pile on":{"definition":"Nói quá lên hoặc nói theo cách ảnh hưởng đến cảm xúc của ai đó.","example":"It wasn't very serious, but they piled on the guilt.","exampleTranslation":"Chuyện đó không nghiêm trọng lắm, nhưng họ lại cố tình nói quá lên để gây cảm giác tội lỗi.","rootVerb":"pile","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pine away":{"definition":"Chịu đựng về mặt thể chất vì đau buồn, căng thẳng, lo lắng, v.v.","example":"He's been pining away since his wife died and is a shadow of his former self.","exampleTranslation":"Anh ấy đã héo hon vì đau buồn kể từ khi vợ qua đời và giờ chỉ còn là cái bóng của chính mình trước đây.","rootVerb":"pine","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"play up":{"definition":"Cư xử tệ.","example":"The children played up all evening and drove the babysitter mad.","exampleTranslation":"Lũ trẻ đã cư xử tệ suốt cả buổi tối và làm người trông trẻ phát điên.","rootVerb":"play","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"play up to":{"definition":"Cư xử theo cách được mong đợi.","example":"He's got a reputation for being trouble and plays up to it.","exampleTranslation":"Anh ta mang tiếng là kẻ gây rối và luôn cư xử theo cách đó để mọi người mong đợi như vậy.","rootVerb":"play","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"play upon":{"definition":"Lợi dụng một điểm yếu.","example":"They are playing upon people's concerns to get their way.","exampleTranslation":"Họ đang lợi dụng sự lo ngại của mọi người để đạt được mục đích của mình.","rootVerb":"play","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pluck at":{"definition":"Kéo hoặc nghịch cái gì đó một cách lo lắng.","example":"He was plucking at his cuffs during the interview.","exampleTranslation":"Anh ấy cứ kéo ống tay áo một cách lo lắng trong suốt buổi phỏng vấn.","rootVerb":"pluck","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pluck up":{"definition":"Thu can đảm, lấy hết can đảm.","example":"They plucked up the courage to complain.","exampleTranslation":"Họ đã lấy hết can đảm để khiếu nại.","rootVerb":"pluck","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"poop out":{"definition":"Quá mệt mỏi không thể làm gì.","example":"I was going to write my essay, but I pooped out and went to bed instead.","exampleTranslation":"Tôi đã định viết bài luận nhưng tôi quá mệt mỏi nên đã đi ngủ thay vì làm nó.","rootVerb":"poop","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"psych up":{"definition":"Chuẩn bị tâm lý cho ai đó.","example":"I psyched myself up for the exam.","exampleTranslation":"Tôi đã chuẩn bị tâm lý cho kỳ thi.","rootVerb":"psych","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pucker up":{"definition":"Chu môi lại để chuẩn bị hôn.","example":"She puckered up when he leant forwards to kiss her.","exampleTranslation":"Cô ấy đã chu môi lại khi anh ta cúi người về phía trước để hôn cô ấy.","rootVerb":"pucker","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pull down":{"definition":"Làm ai đó chán nản.","example":"Losing her job pulled her down.","exampleTranslation":"Việc mất việc làm đã làm cô ấy chán nản.","rootVerb":"pull","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"pull through":{"definition":"Bình phục sau cơn bạo bệnh hoặc vượt qua khó khăn.","example":"At one stage it looked as if she was going to die, but she pulled through in the end.","exampleTranslation":"Đã có lúc tưởng chừng như cô ấy không qua khỏi, nhưng cuối cùng cô ấy cũng đã bình phục.","rootVerb":"pull","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"quieten down":{"definition":"Trở nên im lặng.","example":"The audience quietened down when the lights were switched off in the auditorium and the play was ready to begin.","exampleTranslation":"Khán giả trở nên im lặng khi đèn trong hội trường được tắt đi và vở kịch đã sẵn sàng bắt đầu.","rootVerb":"quieten","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"room in":{"definition":"Giữ cho mẹ và em bé ở cùng nhau sau khi sinh.","example":"Nowadays, most hospitals have a policy of rooming in mothers and their babies.","exampleTranslation":"Ngày nay, hầu hết các bệnh viện đều có chính sách giữ cho mẹ và em bé ở cùng nhau sau khi sinh.","rootVerb":"room","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"root for":{"definition":"Ủng hộ.","example":"Everyone was rooting for Arsenal to win the Champions League.","exampleTranslation":"Mọi người đều đang ủng hộ Arsenal vô địch Champions League.","rootVerb":"root","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"shake off":{"definition":"Khỏi bệnh.","example":"It took me ages to shake off the cough.","exampleTranslation":"Tôi đã mất rất lâu mới khỏi được cơn ho đó.","rootVerb":"shake","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"shoot up":{"definition":"Tiêm chích ma túy tĩnh mạch.","example":"The heroin-user would shoot up in shop doorways.","exampleTranslation":"Người nghiện heroin đó thường tiêm chích ma túy tĩnh mạch ở các cửa hiệu.","rootVerb":"shoot","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"show through":{"definition":"Lộ ra (cảm xúc) mặc dù đã cố gắng che giấu.","example":"His anger showed through despite his smile.","exampleTranslation":"Sự giận dữ của anh ấy lộ ra mặc dù anh ấy vẫn cố mỉm cười.","rootVerb":"show","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"shy away from":{"definition":"Tránh làm việc gì đó vì thiếu tự tin.","example":"Many learners shy away from using phrasal verbs.","exampleTranslation":"Nhiều người học thường tránh làm việc sử dụng các cụm động từ vì thiếu tự tin.","rootVerb":"shy","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"simmer down":{"definition":"Bình tĩnh lại, bớt ồn ào.","example":"He told them to simmer down because they were disturbing the class next door.","exampleTranslation":"Anh ấy bảo họ bình tĩnh lại vì họ đang làm ồn ảnh hưởng đến lớp học bên cạnh.","rootVerb":"simmer","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"sink in":{"definition":"Dần dần được hiểu ra.","example":"The truth finally sank in about her death when it was broadcast on TV.","exampleTranslation":"Sự thật về cái chết của cô ấy cuối cùng cũng dần dần được hiểu ra khi tin tức đó được phát trên truyền hình.","rootVerb":"sink","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"sleep off":{"definition":"Ngủ để giã rượu, thuốc, v.v.","example":"She went to bed to sleep off the effects of the tequila.","exampleTranslation":"Cô ấy đã đi ngủ để giã rượu tequila.","rootVerb":"sleep","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"slough off":{"definition":"Bỏ ngoài tai, phớt lờ.","example":"He sloughed off the pain and continued running.","exampleTranslation":"Anh ấy phớt lờ nỗi đau và tiếp tục chạy.","rootVerb":"slough","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"sniff at":{"definition":"Khinh thường hoặc chê bai.","example":"A job opportunity like that is not to be sniffed at.","exampleTranslation":"Một cơ hội việc làm như thế không nên bị khinh thường.","rootVerb":"sniff","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"sober up":{"definition":"Hết say rượu hoặc thuốc.","example":"Keith sobered up a bit when we left the pub and walked home.","exampleTranslation":"Keith đã tỉnh rượu hơn một chút khi chúng tôi rời quán rượu và đi bộ về nhà.","rootVerb":"sober","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"spew up":{"definition":"Nôn mửa.","example":"He spewed up when he was drunk.","exampleTranslation":"Anh ta đã nôn mửa khi say rượu.","rootVerb":"spew","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"spoil for":{"definition":"Thực sự muốn điều gì đó.","example":"He's been spoiling for an argument all day.","exampleTranslation":"Anh ấy đã muốn gây gổ cả ngày nay.","rootVerb":"spoil","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"start up":{"definition":"Ngồi hoặc đứng thẳng lên vì ai đó làm bạn ngạc nhiên.","example":"He started up when I entered the room and tried to hide what he was doing.","exampleTranslation":"Anh ấy bật dậy khi tôi bước vào phòng và cố gắng giấu những gì mình đang làm.","rootVerb":"start","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"stave off":{"definition":"Trì hoãn, ngăn điều gì đó xảy ra.","example":"The medicine staved off the worst of the disease.","exampleTranslation":"Loại thuốc đó đã giúp ngăn chặn tình trạng tồi tệ nhất của căn bệnh.","rootVerb":"stave","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"steal over":{"definition":"Bị khuất phục dần dần bởi một cảm xúc hoặc cảm giác.","example":"A feeling of pride stole over me as I watched.","exampleTranslation":"Một cảm giác tự hào dần dần bao trùm lấy tôi khi tôi theo dõi.","rootVerb":"steal","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"stick it to":{"definition":"Đối xử tồi tệ hoặc không công bằng với ai đó.","example":"My boss always sticks IT to me when she's in a bad mood.","exampleTranslation":"Sếp tôi luôn đối xử tệ với tôi mỗi khi bà ấy có tâm trạng không tốt.","rootVerb":"stick","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"stomp on":{"definition":"Đối xử tệ bạc hoặc đánh bại.","example":"They stomp on their competitors.","exampleTranslation":"Họ đối xử tệ bạc với các đối thủ cạnh tranh của mình.","rootVerb":"stomp","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"summon up":{"definition":"Tập trung năng lượng hoặc lòng can đảm để làm điều gì đó.","example":"Andrea couldn't summon up the enthusiasm to apply for the position.","exampleTranslation":"Andrea không thể tập trung đủ nhiệt huyết để nộp đơn ứng tuyển cho vị trí này.","rootVerb":"summon","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"swell up":{"definition":"Sưng phồng lên, tấy lên.","example":"His ankle swelled up immediately after he twisted it during soccer.","exampleTranslation":"Mắt cá chân của anh ấy sưng phồng lên ngay sau khi anh ấy bị trẹo trong trận bóng đá.","rootVerb":"swell","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"take it out on":{"definition":"Trút giận lên ai đó vì bạn đang tức giận.","example":"Do not take it out on your sister.","exampleTranslation":"Đừng trút giận lên em gái của bạn.","rootVerb":"take","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"tear apart":{"definition":"Làm phiền hoặc làm buồn rất nhiều.","example":"People were torn apart when news of the train crash came through.","exampleTranslation":"Mọi người đã rất đau khổ khi tin tức về vụ tai nạn tàu hỏa truyền đến.","rootVerb":"tear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"tear at":{"definition":"Kéo hoặc cố gắng kéo một cái gì đó thành từng mảnh.","example":"The fighters tore at each other.","exampleTranslation":"Những kẻ đánh nhau đã cố gắng cấu xé lẫn nhau.","rootVerb":"tear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"tear into":{"definition":"Chỉ trích mạnh mẽ hoặc tức giận.","example":"She tore into me for losing it.","exampleTranslation":"Cô ấy đã chỉ trích tôi dữ dội vì làm mất nó.","rootVerb":"tear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"tire out":{"definition":"Làm ai đó kiệt sức.","example":"Working so much tires me out.","exampleTranslation":"Làm việc quá nhiều khiến tôi kiệt sức.","rootVerb":"tire","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"turn against":{"definition":"Ngừng thích và bắt đầu ghét.","example":"The public turned against the government when they became arrogant and ceased to listen.","exampleTranslation":"Công chúng quay lưng lại với chính phủ khi họ trở nên kiêu ngạo và không còn lắng nghe nữa.","rootVerb":"turn","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"walk off":{"definition":"Đi dạo để giảm bớt ảnh hưởng của bệnh tật hoặc cảm giác tồi tệ.","example":"I tried to walk off my hangover.","exampleTranslation":"Tôi đã cố gắng đi dạo để giảm bớt cơn say rượu.","rootVerb":"walk","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"warm up":{"definition":"Khởi động trước khi chơi thể thao.","example":"The team warmed up half an hour before the volleyball match.","exampleTranslation":"Cả đội đã khởi động nửa giờ trước trận bóng chuyền.","rootVerb":"warm","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wash down":{"definition":"Uống nước để nuốt thứ gì đó đặc.","example":"I washed the antibiotics down with a glass of water.","exampleTranslation":"Tôi đã uống nước để nuốt trôi thuốc kháng sinh.","rootVerb":"wash","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wash over":{"definition":"Đột nhiên trải qua một cảm xúc mãnh liệt.","example":"He felt numb as grief washed over him.","exampleTranslation":"Anh ấy cảm thấy tê liệt khi nỗi đau buồn đột ngột ập đến.","rootVerb":"wash","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"waste away":{"definition":"Trở nên rất gầy và yếu, thường là do bệnh tật.","example":"He wasted away as the cancer got worse.","exampleTranslation":"Cơ thể anh ấy ngày càng gầy yếu khi căn bệnh ung thư trở nên tồi tệ hơn.","rootVerb":"waste","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wean off":{"definition":"Dần dần cai nghiện thứ gì đó.","example":"We will have to wean him off his obsession.","exampleTranslation":"Chúng tôi sẽ phải giúp anh ấy dần dần từ bỏ nỗi ám ảnh đó.","rootVerb":"wean","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wear down":{"definition":"Làm cho thứ gì đó yếu đi.","example":"The stress of my job is wearing me down.","exampleTranslation":"Áp lực công việc đang khiến tôi kiệt quệ.","rootVerb":"wear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wear off":{"definition":"Hết tác dụng.","example":"The anaesthetic wore off and my tooth started hurting.","exampleTranslation":"Thuốc gây mê hết tác dụng và răng tôi bắt đầu đau.","rootVerb":"wear","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"weigh down on":{"definition":"Đè nặng với trách nhiệm, nhiệm vụ, v.v.","example":"The requirements of her new job weighed down on her.","exampleTranslation":"Những yêu cầu của công việc mới đè nặng lên cô ấy.","rootVerb":"weigh","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"weigh on":{"definition":"Khiến ai đó phải suy nghĩ cẩn thận.","example":"The issues raised weighed on her mind.","exampleTranslation":"Những vấn đề được nêu ra khiến cô ấy phải bận tâm suy nghĩ.","rootVerb":"weigh","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"weird out":{"definition":"Làm phiền, gây lo lắng hoặc lo âu.","example":"The way he spoke was weirding me out.","exampleTranslation":"Cách anh ấy nói chuyện khiến tôi thấy khó chịu và lo lắng.","rootVerb":"weird","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"well up":{"definition":"Trải qua một cảm xúc hoặc cảm giác, bắt đầu khóc.","example":"Tears welled up when I heard they had died.","exampleTranslation":"Nước mắt trào dâng khi tôi nghe tin họ đã qua đời.","rootVerb":"well","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wimp out":{"definition":"Không đủ can đảm để làm điều gì đó.","example":"I was going to have the hottest curry on the menu, but I wimped out and had a mild lamb Korma instead.","exampleTranslation":"Tôi đã định gọi món cà ri cay nhất trong thực đơn, nhưng tôi đã nhát gan nên chọn món Korma cừu nhẹ nhàng hơn thay thế.","rootVerb":"wimp","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wind down":{"definition":"Thư giãn.","example":"I'm going to wind down in the country this weekend and do nothing.","exampleTranslation":"Tôi dự định sẽ đi về vùng nông thôn cuối tuần này để thư giãn và không làm gì cả.","rootVerb":"wind","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"wind up":{"definition":"Chọc giận ai đó hoặc làm tăng mức độ căng thẳng của họ, đặc biệt là nếu cố ý.","example":"Stop trying to wind up your older brother.","exampleTranslation":"Đừng cố chọc giận anh trai của bạn nữa.","rootVerb":"wind","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"work off":{"definition":"Tập thể dục để loại bỏ căng thẳng hoặc giảm cân.","example":"She goes to the gym to work off her anger.","exampleTranslation":"Cô ấy đến phòng tập thể dục để giải tỏa sự tức giận.","rootVerb":"work","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"work through":{"definition":"Giải quyết một vấn đề, thường là về mặt cảm xúc.","example":"It took him a long time to work through his anger after he lost his job.","exampleTranslation":"Anh ấy mất rất nhiều thời gian để giải quyết những cảm xúc giận dữ sau khi mất việc.","rootVerb":"work","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"zone out":{"definition":"Tách biệt bản thân khỏi một tình huống.","example":"I put some ambient music on and zoned out.","exampleTranslation":"Tôi đã bật nhạc ambient lên và tách biệt bản thân ra khỏi mọi thứ.","rootVerb":"zone","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"zonk out":{"definition":"Ngủ thiếp đi.","example":"I zonked out during the film and missed most of it.","exampleTranslation":"Tôi đã ngủ thiếp đi trong suốt bộ phim và bỏ lỡ hầu hết nội dung của nó.","rootVerb":"zonk","topicId":"health-emotions","topicTitle":"Sức khỏe và cảm xúc","partOfSpeech":"V","dictionarySource":"offline"},"add on":{"definition":"cộng thêm vào","example":"You have to add the VAT on to the price they give.","exampleTranslation":"Bạn phải cộng thêm thuế GTGT vào mức giá mà họ đưa ra.","rootVerb":"add","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"auction off":{"definition":"bán đấu giá","example":"They auctioned off their property as they were heavily in debt.","exampleTranslation":"Họ đã bán đấu giá tài sản của mình vì họ đang nợ nần chồng chất.","rootVerb":"auction","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"bargain down":{"definition":"mặc cả giảm giá","example":"I bargained her down to half what she originally wanted.","exampleTranslation":"Tôi đã mặc cả giảm giá cho cô ấy xuống còn một nửa số tiền mà cô ấy ban đầu mong muốn.","rootVerb":"bargain","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"bargain for":{"definition":"dự tính; mong đợi","example":"I did not bargain for such a difficult task.","exampleTranslation":"Tôi đã không dự tính cho một nhiệm vụ khó khăn như vậy.","rootVerb":"bargain","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"bargain on":{"definition":"lường trước; mong đợi","example":"I hadn't bargained on him coming.","exampleTranslation":"Tôi đã không lường trước việc anh ấy sẽ đến.","rootVerb":"bargain","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"bottom out":{"definition":"Chạm đáy và bắt đầu phục hồi.","example":"The recession bottomed out and the economy is recovering well.","exampleTranslation":"Suy thoái đã chạm đáy và nền kinh tế đang phục hồi tốt.","rootVerb":"bottom","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"branch out":{"definition":"Mở rộng sang lĩnh vực mới.","example":"The supermarkets have branched out into banking.","exampleTranslation":"Các siêu thị đã mở rộng sang lĩnh vực ngân hàng.","rootVerb":"branch","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"bump up":{"definition":"Tăng (giá...).","example":"They bump up the prices in the high season.","exampleTranslation":"Họ tăng giá vào mùa cao điểm.","rootVerb":"bump","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"buy in":{"definition":"Mua nhiều đĩa để đẩy lên bảng xếp hạng.","example":"Joe Meek's last hit, 'Singin' the Blues', was probably bought in at number 40, but failed to go any higher.","exampleTranslation":"Bản hit cuối cùng của Joe Meek, 'Singin' the Blues', có lẽ đã được mua nhiều đĩa để đẩy lên vị trí số 40, nhưng không thể lên cao hơn được nữa.","rootVerb":"buy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"buy into":{"definition":"Chấp nhận một ý tưởng.","example":"I never bought into the idea of a federalist Euopean Union.","exampleTranslation":"Tôi chưa bao giờ chấp nhận ý tưởng về một Liên minh châu Âu theo chủ nghĩa liên bang.","rootVerb":"buy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"buy off":{"definition":"Mua chuộc để khỏi gặp rắc rối.","example":"He bought the newspaper off by placing a lot of adverts.","exampleTranslation":"Anh ấy đã mua chuộc tờ báo bằng cách đặt rất nhiều quảng cáo.","rootVerb":"buy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"buy out":{"definition":"Mua lại cổ phần.","example":"His business partners bought him out to get rid of him.","exampleTranslation":"Các đối tác kinh doanh của anh ấy đã mua lại cổ phần của anh để loại bỏ anh.","rootVerb":"buy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"buy up":{"definition":"Mua toàn bộ.","example":"We bought up all the shop had before the price went up.","exampleTranslation":"Chúng tôi đã mua toàn bộ những gì cửa hàng có trước khi giá tăng lên.","rootVerb":"buy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cash in":{"definition":"Đổi thành tiền.","example":"They cashed in their bonds and spent the money on a holiday.","exampleTranslation":"Họ đã đổi trái phiếu thành tiền và tiêu số tiền đó vào một kỳ nghỉ.","rootVerb":"cash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cash in on":{"definition":"Trục lợi.","example":"The opposition party are cashing in on the government's unpopularity.","exampleTranslation":"Đảng đối lập đang trục lợi từ sự không phổ biến của chính phủ.","rootVerb":"cash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cash out":{"definition":"Rút tiền, nhận tiền thắng cược.","example":"After winning, she cashed out her chips.","exampleTranslation":"Sau khi thắng, cô ấy đã đổi phỉnh lấy tiền.","rootVerb":"cash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cash up":{"definition":"Tính tiền cuối ngày.","example":"After the shop closed, they have to cash up before they can go home.","exampleTranslation":"Sau khi cửa hàng đóng cửa, họ phải tính tiền cuối ngày trước khi có thể về nhà.","rootVerb":"cash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"chalk up":{"definition":"Đạt được điều gì đó tốt.","example":"The company has chalked up its highest ever profits.","exampleTranslation":"Công ty đã đạt mức lợi nhuận cao nhất từ trước đến nay.","rootVerb":"chalk","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"claw back":{"definition":"Giành lại khó khăn.","example":"They are clawing back their market share from their competitors.","exampleTranslation":"Họ đang giành lại thị phần từ các đối thủ cạnh tranh của mình.","rootVerb":"claw","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"clean out":{"definition":"Làm cho ai đó nhẵn túi.","example":"The holiday cleaned me out- I'm broke till the end of the month.","exampleTranslation":"Kỳ nghỉ đã làm tôi nhẵn túi - tôi không còn một xu dính túi cho đến cuối tháng.","rootVerb":"clean","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"close down":{"definition":"Đóng cửa vĩnh viễn.","example":"The banks have closed down a lot of branches in villages over the last few years.","exampleTranslation":"Các ngân hàng đã đóng cửa vĩnh viễn nhiều chi nhánh ở các ngôi làng trong vài năm qua.","rootVerb":"close","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"come by":{"definition":"Đạt được, kiếm được.","example":"How did you come by that Rolex?","exampleTranslation":"Làm thế nào bạn có được chiếc Rolex đó vậy?","rootVerb":"come","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"contract out":{"definition":"Thuê ngoài dịch vụ.","example":"They have contracted out their catering services to save money.","exampleTranslation":"Họ đã thuê ngoài dịch vụ ăn uống của mình để tiết kiệm tiền.","rootVerb":"contract","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cost up":{"definition":"Tính toán chi phí.","example":"The decorators are going to cost up the work tomorrow.","exampleTranslation":"Những người trang trí sẽ tính toán chi phí cho công việc vào ngày mai.","rootVerb":"cost","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cough up":{"definition":"Làm mất bóng trong môn thể thao đối kháng.","example":"He was checked so hard he coughed up the puck in front of his own goal.","exampleTranslation":"Anh ấy bị chặn mạnh đến mức làm mất bóng ngay trước khung thành của đội mình.","rootVerb":"cough","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"count out":{"definition":"Đếm (một số tiền cụ thể).","example":"He counted out £250 and paid me.","exampleTranslation":"Anh ấy đã đếm 250 bảng Anh và trả tiền cho tôi.","rootVerb":"count","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"count up":{"definition":"Cộng lại.","example":"Count up the number of tickets sold, please.","exampleTranslation":"Vui lòng cộng lại số lượng vé đã bán.","rootVerb":"count","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cream off":{"definition":"Chọn ra những người xuất sắc nhất.","example":"The private schools cream off many of the best pupils.","exampleTranslation":"Các trường tư thục chọn ra nhiều học sinh xuất sắc nhất.","rootVerb":"cream","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cut back":{"definition":"Giảm bớt.","example":"The firm cut back production because sales were sluggish.","exampleTranslation":"Công ty đã giảm bớt sản xuất vì doanh số bán hàng ảm đạm.","rootVerb":"cut","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"cut back on":{"definition":"Cắt giảm chi tiêu.","example":"The government has decided to cut back on spending on the armed forces.","exampleTranslation":"Chính phủ đã quyết định cắt giảm chi tiêu cho lực lượng vũ trang.","rootVerb":"cut","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"divide up":{"definition":"Chia sẻ.","example":"They divided up the profits.","exampleTranslation":"Họ đã chia sẻ lợi nhuận.","rootVerb":"divide","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"divvy out":{"definition":"Phân chia, chia sẻ.","example":"The waiters and waitresses divvy out the tips at the end of the night.","exampleTranslation":"Các nhân viên phục vụ chia sẻ tiền boa vào cuối đêm.","rootVerb":"divvy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"divvy up":{"definition":"Phân chia, chia sẻ.","example":"We divvied up the money equally.","exampleTranslation":"Chúng tôi đã phân chia số tiền một cách bình đẳng.","rootVerb":"divvy","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"dole out":{"definition":"Phân phát.","example":"They were doling out leaflets in front of the station.","exampleTranslation":"Họ đang phân phát tờ rơi ở phía trước nhà ga.","rootVerb":"dole","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"draw down":{"definition":"Rút bớt (do tiêu dùng hoặc chi tiêu nhiều).","example":"Gas reserves were drawn down in the recent cold spell.","exampleTranslation":"Dự trữ khí đốt đã bị rút bớt trong đợt lạnh gần đây.","rootVerb":"draw","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"drive up":{"definition":"Đẩy (giá cả) lên cao.","example":"The market uncertainty has driven prices up.","exampleTranslation":"Sự không chắc chắn của thị trường đã đẩy giá cả lên cao.","rootVerb":"drive","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"drum up":{"definition":"Kêu gọi sự ủng hộ/quan tâm.","example":"They are trying to drum up support for the referendum.","exampleTranslation":"Họ đang cố gắng kêu gọi sự ủng hộ cho cuộc trưng cầu dân ý.","rootVerb":"drum","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"dry up":{"definition":"Cạn kiệt nguồn cung.","example":"His income dried up when cheaper options became available.","exampleTranslation":"Thu nhập của anh ấy cạn kiệt khi các lựa chọn rẻ hơn xuất hiện.","rootVerb":"dry","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"eat into":{"definition":"Lẹm vào (tiền tiết kiệm).","example":"We've had to eat into our savings since I lost my job.","exampleTranslation":"Chúng tôi đã phải lẹm vào tiền tiết kiệm kể từ khi tôi mất việc.","rootVerb":"eat","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"eke out":{"definition":"Dùng dè sẻn để kéo dài (tiền bạc).","example":"Most students have to eke out their income because they have so little money to live on.","exampleTranslation":"Hầu hết sinh viên phải dùng dè sẻn thu nhập của mình vì họ có quá ít tiền để trang trải cuộc sống.","rootVerb":"eke","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"fall off":{"definition":"Giảm sút.","example":"The membership fell off dramatically when the chairperson resigned.","exampleTranslation":"Số lượng thành viên đã giảm sút đáng kể khi chủ tịch từ chức.","rootVerb":"fall","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"fork out":{"definition":"Bấm bụng chi tiền, bấm bụng trả một khoản tiền lớn.","example":"I had to fork out over $500 to repair my broken laptop screen.","exampleTranslation":"Tôi đã phải bấm bụng chi hơn 500 đô la để sửa màn hình máy tính xách tay bị hỏng của mình.","rootVerb":"fork","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"get back":{"definition":"Lấy lại được thứ gì đó.","example":"Don't lend him any money; you'll never get it back.","exampleTranslation":"Đừng cho anh ta vay tiền; cậu sẽ không bao giờ lấy lại được nó đâu.","rootVerb":"get","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"get behind with":{"definition":"Trễ hạn thanh toán.","example":"If you get behind with mortgage payments, you might lose your home.","exampleTranslation":"Nếu bạn trễ hạn thanh toán tiền thế chấp, bạn có thể bị mất nhà.","rootVerb":"get","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"get by on":{"definition":"Sống dựa vào một khoản tiền nhất định.","example":"It's hard to get by on my salary.","exampleTranslation":"Thật khó để sống dựa vào tiền lương của tôi.","rootVerb":"get","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"give back":{"definition":"Mang trở lại thứ gì đó đã mất.","example":"Nothing could give me back the way I felt before the scandal.","exampleTranslation":"Không gì có thể mang lại cho tôi cảm giác như trước vụ bê bối đó.","rootVerb":"give","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"go off with":{"definition":"Bỏ trốn với ai đó.","example":"She went off with her friend's husband.","exampleTranslation":"Cô ta đã bỏ trốn cùng với chồng của bạn mình.","rootVerb":"go","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"go to":{"definition":"Dành tiền cho việc gì.","example":"About half of my income goes to pay the mortgage.","exampleTranslation":"Khoảng một nửa thu nhập của tôi dành để trả tiền thế chấp.","rootVerb":"go","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hang onto":{"definition":"Giữ lại.","example":"I hung onto my old records even though I never played them.","exampleTranslation":"Tôi đã giữ lại những chiếc đĩa than cũ của mình mặc dù tôi không bao giờ chơi chúng.","rootVerb":"hang","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hang out for":{"definition":"Chờ đợi hoặc từ chối làm gì đó cho đến khi nhận được những gì mong muốn.","example":"She's hanging out for a big raise.","exampleTranslation":"Cô ấy đang chờ đợi một đợt tăng lương lớn.","rootVerb":"hang","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hit for":{"definition":"Yêu cầu ai đó trả tiền hoặc quyên góp tiền.","example":"They hit the sponsors for a lot of money.","exampleTranslation":"Họ đã yêu cầu các nhà tài trợ đóng góp rất nhiều tiền.","rootVerb":"hit","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hit up":{"definition":"Hỏi xin tiền ai đó.","example":"He always tries to hit me up for money when we meet.","exampleTranslation":"Anh ta luôn cố hỏi xin tôi tiền mỗi khi chúng tôi gặp nhau.","rootVerb":"hit","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hive off":{"definition":"Tách một phần của công ty hoặc dịch vụ, thường bằng cách bán nó.","example":"They hived off the retail operations.","exampleTranslation":"Họ đã tách các hoạt động bán lẻ của công ty ra.","rootVerb":"hive","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hold out for":{"definition":"Đợi chờ một điều gì đó tốt hơn hoặc từ chối một điều gì đó bây giờ vì một điều gì đó tốt hơn trong tương lai.","example":"We are holding out for a much better deal than the one offered.","exampleTranslation":"Chúng tôi đang chờ đợi một thỏa thuận tốt hơn nhiều so với thỏa thuận đã được đề nghị.","rootVerb":"hold","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"hose down":{"definition":"Đầu tư mạnh mẽ vào hoặc ném nhiều tiền vào một thứ gì đó.","example":"They have hosed an obscure start-up down with capital.","exampleTranslation":"Họ đã rót vốn mạnh tay vào một công ty khởi nghiệp ít người biết đến.","rootVerb":"hose","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"jump off":{"definition":"Bắt đầu nhanh chóng, thường là tốt.","example":"The ipo jumped off on the first day.","exampleTranslation":"Đợt phát hành cổ phiếu lần đầu ra công chúng (IPO) đã bắt đầu tăng trưởng nhanh chóng ngay trong ngày đầu tiên.","rootVerb":"jump","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"kick back":{"definition":"Trả tiền cho ai đó một cách bất hợp pháp như một phần của giá cả.","example":"I had to kick ten percent back to the government official to get the contract.","exampleTranslation":"Tôi đã phải trích lại mười phần trăm cho viên chức chính phủ để có được hợp đồng.","rootVerb":"kick","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"knock out":{"definition":"Bán, phân phối.","example":"They're knocking hundreds out a day in the sales.","exampleTranslation":"Họ đang bán và phân phối hàng trăm sản phẩm mỗi ngày trong đợt giảm giá.","rootVerb":"knock","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"lash out":{"definition":"Tiêu nhiều tiền vào đồ xa xỉ.","example":"I lashed out in the sales last week.","exampleTranslation":"Tôi đã tiêu rất nhiều tiền vào đồ xa xỉ trong đợt giảm giá tuần trước.","rootVerb":"lash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"latch onto":{"definition":"Nhận ra rằng điều gì đó là tốt hoặc có lợi.","example":"Oil companies have latched onto environmental ideas.","exampleTranslation":"Các công ty dầu mỏ đã nhận ra rằng các ý tưởng về môi trường là có lợi.","rootVerb":"latch","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"lay out":{"definition":"Tiêu tiền.","example":"They laid out thousands of pounds on their wedding reception.","exampleTranslation":"Họ đã tiêu hàng ngàn bảng Anh cho tiệc cưới của mình.","rootVerb":"lay","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"live off":{"definition":"Sống dựa vào tiền kiếm được.","example":"They find it hard to live off the money they make.","exampleTranslation":"Họ thấy khó mà sống dựa vào số tiền họ kiếm được.","rootVerb":"live","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"lock out":{"definition":"Khóa cửa không cho vào.","example":"The management locked the staff out because they had turned down the pay offer.","exampleTranslation":"Ban quản lý đã khóa cửa không cho nhân viên vào vì họ đã từ chối đề nghị tăng lương.","rootVerb":"lock","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"lose out":{"definition":"Bị thiệt thòi.","example":"Many people lost out when the new regulations were enforced.","exampleTranslation":"Nhiều người đã bị thiệt thòi khi các quy định mới được thực thi.","rootVerb":"lose","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"lose out on":{"definition":"Không nhận được hoặc không có điều gì có lợi.","example":"Because I left the company, I lost out on my bonus.","exampleTranslation":"Vì tôi đã rời công ty, tôi đã không nhận được tiền thưởng của mình.","rootVerb":"lose","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"lose out to":{"definition":"Ít thành công hơn.","example":"People without IT skills often lose out to those with the skills.","exampleTranslation":"Những người không có kỹ năng CNTT thường ít thành công hơn so với những người có kỹ năng này.","rootVerb":"lose","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"make over":{"definition":"Giao tiền hoặc tài sản hợp pháp cho ai đó.","example":"She made over her property to her children.","exampleTranslation":"Cô ấy đã giao tài sản của mình cho các con.","rootVerb":"make","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"make up to":{"definition":"Làm điều gì đó để đền bù cho ai về những rắc rối mình đã gây ra.","example":"She wanted to make up to her friend for missing the wedding.","exampleTranslation":"Cô ấy muốn bù đắp cho bạn mình vì đã lỡ đám cưới.","rootVerb":"make","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"mark up":{"definition":"Tăng giá một mặt hàng.","example":"They mark the goods up by 25% before they sell them.","exampleTranslation":"Họ tăng giá hàng hóa thêm 25% trước khi bán chúng.","rootVerb":"mark","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"max out":{"definition":"Đạt đến giới hạn.","example":"She maxed out her credit cards.","exampleTranslation":"Cô ấy đã dùng thẻ tín dụng đến giới hạn.","rootVerb":"max","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"mount up":{"definition":"Tăng dần theo thời gian.","example":"My debts mounted up while I was at university.","exampleTranslation":"Các khoản nợ của tôi đã tăng dần lên trong thời gian tôi học đại học.","rootVerb":"mount","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"palm off":{"definition":"Khiến ai đó chấp nhận điều gì đó không đúng sự thật.","example":"He tried to palm me off with a pathetic excuse.","exampleTranslation":"Anh ta đã cố khiến tôi chấp nhận một cái cớ thảm hại.","rootVerb":"palm","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pare back":{"definition":"Giảm kích thước hoặc số lượng.","example":"They have had to pare back the services they offer as their funding was reduced.","exampleTranslation":"Họ đã phải cắt giảm các dịch vụ mà họ cung cấp vì nguồn tài trợ bị giảm.","rootVerb":"pare","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pare down":{"definition":"Giảm bớt, làm giảm.","example":"They have pared down the number of employees as they haven't been doing well.","exampleTranslation":"Họ đã giảm bớt số lượng nhân viên vì tình hình kinh doanh không mấy suôn sẻ.","rootVerb":"pare","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"part with":{"definition":"Cho đi thứ gì đó, đặc biệt là khi bạn không muốn.","example":"I found it very hard to part with my old CDs when I digitized my collection.","exampleTranslation":"Tôi thấy rất khó để từ bỏ những chiếc đĩa CD cũ của mình khi tôi số hóa bộ sưu tập.","rootVerb":"part","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pass to":{"definition":"Trở thành chủ sở hữu hoặc chịu trách nhiệm về cái gì đó.","example":"The property will pass to her when they die.","exampleTranslation":"Tài sản sẽ thuộc quyền sở hữu của cô ấy khi họ qua đời.","rootVerb":"pass","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pass up":{"definition":"Từ chối một cơ hội.","example":"She passed up the opportunity to go to university because she'd been offered a job.","exampleTranslation":"Cô ấy đã từ chối cơ hội đi học đại học vì cô ấy đã được mời làm việc.","rootVerb":"pass","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pay down":{"definition":"Trả nợ theo thời gian.","example":"The British government can't pay down the national debt.","exampleTranslation":"Chính phủ Anh không thể trả dần nợ quốc gia.","rootVerb":"pay","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pay for":{"definition":"Mua.","example":"I paid twenty pounds for the book.","exampleTranslation":"Tôi đã trả hai mươi bảng cho cuốn sách đó.","rootVerb":"pay","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pay into":{"definition":"Gửi tiền vào.","example":"I paid the cash into my account.","exampleTranslation":"Tôi đã gửi tiền mặt vào tài khoản của mình.","rootVerb":"pay","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pay off":{"definition":"Tạo ra một kết quả có lợi hoặc thành công.","example":"Their patience paid off when he finally showed up and signed the contract.","exampleTranslation":"Sự kiên nhẫn của họ đã tạo ra kết quả thành công khi anh ta cuối cùng cũng xuất hiện và ký hợp đồng.","rootVerb":"pay","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pay up":{"definition":"Trả hết nợ, thanh toán sòng phẳng (sau khi bị nhắc nhở).","example":"After weeks of reminders, he finally agreed to pay up his debt.","exampleTranslation":"Sau nhiều tuần nhắc nhở, cuối cùng anh ta cũng đồng ý trả hết số nợ của mình.","rootVerb":"pay","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"plough back":{"definition":"Tái đầu tư tiền bạn kiếm được vào một doanh nghiệp.","example":"We ploughed back all the profits to grow the company.","exampleTranslation":"Chúng tôi đã tái đầu tư tất cả lợi nhuận để phát triển công ty.","rootVerb":"plough","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"plow back":{"definition":"Tái đầu tư lợi nhuận.","example":"We plowed back all the profits to grow the company.","exampleTranslation":"Chúng tôi đã tái đầu tư tất cả lợi nhuận để phát triển công ty.","rootVerb":"plow","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"pony up":{"definition":"Trả tiền cho cái gì đó.","example":"I had to pony fifty dollars up for the meal.","exampleTranslation":"Tôi đã phải trả năm mươi đô la cho bữa ăn đó.","rootVerb":"pony","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"price in":{"definition":"Tính đến ảnh hưởng của các sự kiện tương lai khi đánh giá giá trị.","example":"Speculators have priced in the risk of a war breaking out.","exampleTranslation":"Các nhà đầu cơ đã tính đến rủi ro chiến tranh bùng nổ khi đánh giá giá trị.","rootVerb":"price","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"price up":{"definition":"Tính giá cao hơn cho cái gì đó.","example":"In rural areas where they have a monopoly, some garages price up fuel because there's nowhere else to buy it.","exampleTranslation":"Ở những vùng nông thôn nơi họ có thế độc quyền, một số gara tăng giá nhiên liệu vì không còn nơi nào khác để mua.","rootVerb":"price","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"put by":{"definition":"Tiết kiệm cho tương lai.","example":"I try to put some money by every month towards our summer holiday.","exampleTranslation":"Tôi cố gắng tiết kiệm một ít tiền mỗi tháng cho kỳ nghỉ hè của chúng tôi.","rootVerb":"put","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"rack up":{"definition":"Đạt được hoặc thu được nhiều cái gì.","example":"He's racked up a number of convictions for speeding.","exampleTranslation":"Anh ta đã thu về hàng loạt bản án vì lỗi chạy quá tốc độ.","rootVerb":"rack","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"rake in":{"definition":"Kiếm tiền dễ dàng.","example":"She's raking in thousands a day.","exampleTranslation":"Cô ấy đang kiếm được hàng ngàn đô la mỗi ngày.","rootVerb":"rake","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"rake it in":{"definition":"Kiếm được rất nhiều tiền.","example":"It's the only shop in the area and they're raking IT in.","exampleTranslation":"Đó là cửa hàng duy nhất trong khu vực và họ đang kiếm được rất nhiều tiền.","rootVerb":"rake","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"rake off":{"definition":"Lừa tiền ai đó bằng cách tính giá quá cao.","example":"They rake tourists off all the time.","exampleTranslation":"Họ lừa tiền khách du lịch mọi lúc.","rootVerb":"rake","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"ramp up":{"definition":"Tăng (giá, tốc độ hoặc sức mạnh).","example":"The company has ramped its prices up because of higher oil prices.","exampleTranslation":"Công ty đã tăng giá các sản phẩm của mình vì giá dầu cao hơn.","rootVerb":"ramp","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"reel in":{"definition":"Thu hút mọi người, đặc biệt là khách hàng, đến.","example":"The new ad will reel in many more customers.","exampleTranslation":"Quảng cáo mới sẽ thu hút thêm nhiều khách hàng hơn nữa.","rootVerb":"reel","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"rent out":{"definition":"Cho thuê để lấy tiền.","example":"They rented their house out while the were abroad.","exampleTranslation":"Họ đã cho thuê ngôi nhà của mình khi họ ở nước ngoài.","rootVerb":"rent","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"ring up":{"definition":"Nhập số liệu vào máy tính tiền hoặc máy đếm tiền.","example":"They rang up the bill for the groceries.","exampleTranslation":"Họ đã nhập hóa đơn cho chỗ hàng tạp hóa vào máy tính tiền.","rootVerb":"ring","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"roll back":{"definition":"Giảm bớt hoặc loại bỏ.","example":"The government want to roll back the freedom of the press.","exampleTranslation":"Chính phủ muốn giảm bớt sự tự do của báo chí.","rootVerb":"roll","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"roll out":{"definition":"Ra mắt hoặc giới thiệu một sản phẩm, sáng kiến mới, v.v..","example":"The company rolled out its takeover plans last week.","exampleTranslation":"Công ty đã ra mắt các kế hoạch thâu tóm vào tuần trước.","rootVerb":"roll","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"run to":{"definition":"Có đủ tiền để mua một thứ gì đó, thường là ở thể phủ định.","example":"Things are a bit tight and won't run to going abroad for a holiday.","exampleTranslation":"Mọi thứ hơi eo hẹp và tôi không đủ tiền để đi du lịch nước ngoài vào kỳ nghỉ.","rootVerb":"run","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"run up":{"definition":"Làm hoặc tạo ra một cái gì đó rất nhanh chóng.","example":"He ran up a few examples for them to look at.","exampleTranslation":"Anh ấy đã nhanh chóng tạo ra một vài ví dụ để họ xem qua.","rootVerb":"run","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"rush out":{"definition":"Phát hành hoặc đưa một cái gì đó ra bán một cách nhanh chóng.","example":"They rushed the single out after it started getting airplay.","exampleTranslation":"Họ đã vội vàng phát hành đĩa đơn ngay sau khi nó bắt đầu được phát sóng.","rootVerb":"rush","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"salt away":{"definition":"Tiết kiệm tiền.","example":"She's making a lot of money, but salts it away rather than spending it.","exampleTranslation":"Cô ấy kiếm được rất nhiều tiền, nhưng lại cất đi thay vì tiêu xài chúng.","rootVerb":"salt","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"save on":{"definition":"Giảm hoặc tránh tiêu thụ để cắt giảm chi phí.","example":"I use Skype to save on my phone bills.","exampleTranslation":"Tôi dùng Skype để giảm bớt hóa đơn điện thoại của mình.","rootVerb":"save","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"save up":{"definition":"Thu thập hoặc lưu trữ một cái gì đó để sử dụng trong tương lai.","example":"I'm saving up the receipts to claim on them all at once.","exampleTranslation":"Tôi đang thu thập các biên lai để đòi thanh toán lại tất cả cùng một lúc.","rootVerb":"save","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scale back":{"definition":"Thu nhỏ một cái gì đó so với kế hoạch ban đầu.","example":"They had to scale back the project because of the costs.","exampleTranslation":"Họ đã phải thu nhỏ quy mô dự án vì chi phí.","rootVerb":"scale","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scale down":{"definition":"Thu nhỏ một cái gì đó so với kế hoạch ban đầu.","example":"They have had to scale down the project because of the costs.","exampleTranslation":"Họ đã phải thu nhỏ quy mô dự án vì chi phí.","rootVerb":"scale","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scale up":{"definition":"Tăng lên, làm cho lớn hơn.","example":"They are scaling up the programme because it has been so successful.","exampleTranslation":"Họ đang tăng quy mô chương trình vì nó đã rất thành công.","rootVerb":"scale","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scrape along":{"definition":"Quản lý với số tiền ít ỏi.","example":"I've been scraping along on temporary work since I lost my job.","exampleTranslation":"Tôi đã phải xoay sở với những công việc tạm thời kể từ khi mất việc.","rootVerb":"scrape","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scrape by":{"definition":"Vừa đủ xoay sở để vượt qua một cái gì đó.","example":"I thought I was going to fail, but scraped by with 51%.","exampleTranslation":"Tôi đã nghĩ mình sẽ trượt, nhưng vẫn xoay sở đủ điểm để vượt qua với 51%.","rootVerb":"scrape","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scrape together":{"definition":"Quản lý để thu thập đủ một cái gì đó bạn cần, thường là tiền.","example":"I had to search my flat for money to scrape together what I needed.","exampleTranslation":"Tôi đã phải lục lọi khắp căn hộ để gom góp đủ số tiền mình cần.","rootVerb":"scrape","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"scrape up":{"definition":"Quản lý để thu thập đủ một cái gì đó bạn cần, thường là tiền.","example":"It took me ages to scrape up the money for the tickets.","exampleTranslation":"Tôi mất cả đời mới gom góp đủ số tiền mua vé.","rootVerb":"scrape","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"screw over":{"definition":"Đối xử khắc nghiệt hoặc lừa gạt.","example":"The irs really screwed him over.","exampleTranslation":"Sở Thuế vụ (IRS) thực sự đã lừa gạt anh ta.","rootVerb":"screw","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sell off":{"definition":"Bán rẻ thứ gì đó vì bạn cần tiền hoặc không cần nó nữa.","example":"She sold off her furniture before she emigrated.","exampleTranslation":"Cô ấy đã bán tháo đồ đạc của mình trước khi di cư.","rootVerb":"sell","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sell on":{"definition":"Mua một cái gì đó rồi bán lại cho người khác.","example":"We buy them wholesale and sell them on to the public.","exampleTranslation":"Chúng tôi mua sỉ chúng rồi bán lại cho công chúng.","rootVerb":"sell","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sell out":{"definition":"Đánh mất tính toàn vẹn nghệ thuật để đổi lấy thành công thương mại.","example":"Most bands sell out when they sign to a major record label, and forget all their principles when pursuing chart success.","exampleTranslation":"Hầu hết các ban nhạc đều đánh mất chất nghệ thuật khi ký hợp đồng với một hãng thu âm lớn và quên đi mọi nguyên tắc của mình khi theo đuổi thành công trên bảng xếp hạng.","rootVerb":"sell","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sell up":{"definition":"Bán nhà hoặc doanh nghiệp để chuyển đến một nơi nào đó hoặc làm điều gì đó khác biệt.","example":"We want to sell up and move to the country.","exampleTranslation":"Chúng tôi muốn bán nhà và chuyển về vùng nông thôn.","rootVerb":"sell","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"send back":{"definition":"Trả lại cái gì đó.","example":"I sent my food back because it was overcooked.","exampleTranslation":"Tôi đã trả lại món ăn vì nó bị nấu quá chín.","rootVerb":"send","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"send off for":{"definition":"Đặt hàng một cái gì đó qua đường bưu điện.","example":"I sent off for some jeans that I liked in the catalogue.","exampleTranslation":"Tôi đã đặt hàng qua bưu điện một chiếc quần jeans mà tôi thích trong danh mục sản phẩm.","rootVerb":"send","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"settle up":{"definition":"Trả nợ, thanh toán.","example":"Let's settle up for the dinner the other night.","exampleTranslation":"Hãy cùng thanh toán sòng phẳng cho bữa tối hôm trước đi.","rootVerb":"settle","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"shave off":{"definition":"Cắt giảm một lượng nhỏ.","example":"He shaved a few thousand off the budget for the year.","exampleTranslation":"Anh ấy đã cắt giảm vài ngàn khỏi ngân sách trong năm.","rootVerb":"shave","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"shell out":{"definition":"Chi tiền cho việc gì đó, đặc biệt là khi bạn nghĩ nó quá đắt.","example":"I had to shell out a hundred pounds on the dinner.","exampleTranslation":"Tôi đã phải bỏ ra một trăm bảng cho bữa tối đó.","rootVerb":"shell","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"shop around":{"definition":"Khảo giá để tìm giá, chất lượng tốt nhất, v.v.","example":"If you shop around, you can find some real bargains for air tickets.","exampleTranslation":"Nếu bạn khảo giá, bạn có thể tìm thấy một vài món hời thực sự cho vé máy bay.","rootVerb":"shop","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"shut down":{"definition":"Đóng cửa doanh nghiệp, cửa hàng, v.v.","example":"The shop shut down when the out-of- town supermarket opened.","exampleTranslation":"Cửa hàng đã đóng cửa khi siêu thị ngoài thị trấn mở cửa.","rootVerb":"shut","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"shut up":{"definition":"Đóng cửa trong một khoảng thời gian.","example":"They shut the shop up for a fortnight while they were on holiday.","exampleTranslation":"Họ đóng cửa cửa hàng trong hai tuần khi họ đi nghỉ.","rootVerb":"shut","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sign away":{"definition":"Từ bỏ các quyền pháp lý hoặc tài sản.","example":"He signed away his rights to compensation when he signed the contract.","exampleTranslation":"Anh ấy đã từ bỏ các quyền bồi thường của mình khi ký hợp đồng.","rootVerb":"sign","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sign for":{"definition":"Ký thay ai đó.","example":"My boss was out for the day, so I signed her letters for her.","exampleTranslation":"Sếp tôi đi vắng cả ngày, nên tôi đã ký thay thư từ cho bà ấy.","rootVerb":"sign","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"snaffle up":{"definition":"Tiêu thụ, lấy, mua thứ mà người khác có thể muốn.","example":"They snaffled up all the food before we got there.","exampleTranslation":"Họ đã lấy hết sạch đồ ăn trước khi chúng tôi đến đó.","rootVerb":"snaffle","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"spaff away":{"definition":"Lãng phí (tiền bạc, thời gian, tài nguyên, v.v).","example":"The council is spaffing away our taxes on bonuses and consultants.","exampleTranslation":"Hội đồng đang lãng phí tiền thuế của chúng ta vào các khoản tiền thưởng và tư vấn.","rootVerb":"spaff","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"spin off":{"definition":"Tạo một chương trình truyền hình sử dụng các nhân vật từ một chương trình nổi tiếng.","example":"The studio decided to spin off a new series.","exampleTranslation":"Hãng phim đã quyết định tạo ra một loạt phim truyền hình mới từ một chương trình nổi tiếng.","rootVerb":"spin","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"splash out":{"definition":"Tiêu nhiều tiền vào thứ không cần thiết.","example":"They like to splash out on luxury vacations.","exampleTranslation":"Họ thích tiêu nhiều tiền vào những kỳ nghỉ sang trọng.","rootVerb":"splash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"splash out on":{"definition":"Tiêu nhiều tiền vào thứ gì đó.","example":"I splashed out on a new camera.","exampleTranslation":"Tôi đã tiêu nhiều tiền cho một chiếc máy ảnh mới.","rootVerb":"splash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sponge off":{"definition":"Chấp nhận thức ăn miễn phí và sự hỗ trợ mà không biết xấu hổ.","example":"Let’s go to New York, we can always sponge off my brother there.","exampleTranslation":"Hãy đi đến New York nhé, chúng ta luôn có thể dựa dẫm vào anh trai tôi ở đó.","rootVerb":"sponge","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"sponge on":{"definition":"Chấp nhận hoặc nhận tiền mà không làm việc.","example":"A lot of people are sponging on the state by claiming benefits they're not entitled to.","exampleTranslation":"Rất nhiều người đang dựa dẫm vào nhà nước bằng cách yêu cầu các khoản trợ cấp mà họ không được hưởng.","rootVerb":"sponge","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"spring for":{"definition":"Trả tiền cho cái gì đó, thường là hào phóng.","example":"She is going to spring for all their medical bills.","exampleTranslation":"Cô ấy sẽ trả tiền cho tất cả hóa đơn y tế của họ.","rootVerb":"spring","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"squirrel away":{"definition":"Tích cóp, dành dụm, cất giấu kín đáo để dành.","example":"She has been squirreling away part of her salary every month for a house deposit.","exampleTranslation":"Cô ấy đã dành dụm một phần lương của mình mỗi tháng để đặt cọc mua nhà.","rootVerb":"squirrel","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"stash away":{"definition":"Cất giữ hoặc giấu điều gì đó ở một nơi an toàn.","example":"I stashed some money away behind some books.","exampleTranslation":"Tôi đã giấu một số tiền phía sau vài cuốn sách.","rootVerb":"stash","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"stick out for":{"definition":"Yêu cầu tăng lương.","example":"We're sticking out for a 5% increase.","exampleTranslation":"Chúng tôi đang yêu cầu tăng 5% lương.","rootVerb":"stick","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"stock up":{"definition":"Mua tích trữ, dự trữ hàng hóa.","example":"People rushed to the supermarket to stock up on food before the storm hit.","exampleTranslation":"Mọi người đổ xô đến siêu thị để mua tích trữ thực phẩm trước khi cơn bão ập đến.","rootVerb":"stock","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"stump up":{"definition":"Trả tiền cho cái gì đó.","example":"He didn't want to pay me back, but I got him to stump up in the end.","exampleTranslation":"Anh ta không muốn trả lại tiền cho tôi, nhưng cuối cùng tôi đã bắt anh ta phải trả.","rootVerb":"stump","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"syphon off":{"definition":"Lấy đi công việc kinh doanh, sự ủng hộ hoặc phiếu bầu từ ai đó.","example":"The candidate syphoned off a lot of votes because of his anti-war stance.","exampleTranslation":"Ứng cử viên này đã lấy đi rất nhiều phiếu bầu vì lập trường phản chiến của ông ấy.","rootVerb":"syphon","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"tap into":{"definition":"Sử dụng hoặc khai thác một nguồn tài nguyên dồi dào vì lợi ích của bạn.","example":"The company is hoping to tap into the Chinese market.","exampleTranslation":"Công ty đang hy vọng khai thác thị trường Trung Quốc.","rootVerb":"tap","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"tap out":{"definition":"Dùng hết số tiền hiện có.","example":"How can we buy a new house without tapping out our savings account.","exampleTranslation":"Làm thế nào chúng ta có thể mua một ngôi nhà mới mà không tiêu hết sạch tài khoản tiết kiệm của mình.","rootVerb":"tap","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"throw in":{"definition":"Thêm một cái gì đó vào một thỏa thuận.","example":"They threw in a printer so I bought it from them.","exampleTranslation":"Họ đã tặng kèm thêm một máy in nên tôi đã mua nó từ họ.","rootVerb":"throw","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"tide over":{"definition":"Sử dụng một cái gì đó cẩn thận để không làm hết nó.","example":"This £50 will have to tide me over until I get paid.","exampleTranslation":"Số tiền 50 bảng này sẽ phải đủ để giúp tôi xoay xở cho đến khi nhận được lương.","rootVerb":"tide","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"top up":{"definition":"Đổ đầy lại thứ gì đó chưa trống rỗng.","example":"Shall I top up your drink while I'm pouring myself one?","exampleTranslation":"Tôi có nên rót thêm đồ uống cho bạn trong khi tôi đang rót cho mình không?","rootVerb":"top","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"touch for":{"definition":"Vay tiền.","example":"I touched him for some cash as I'd forgotten my cards.","exampleTranslation":"Tôi đã hỏi vay anh ấy một ít tiền mặt vì tôi quên mang theo thẻ.","rootVerb":"touch","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"trade down":{"definition":"Bán thứ gì đó và thay thế nó bằng một thứ gì đó rẻ hơn.","example":"Their house it too large now that their children have left home, so they're going to trade down to something smaller.","exampleTranslation":"Ngôi nhà của họ quá lớn bây giờ khi con cái đã rời đi, vì vậy họ sẽ bán và chuyển sang chỗ nhỏ hơn.","rootVerb":"trade","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"trade in":{"definition":"Trao đổi một thứ cũ như một phần giá của một thứ mới.","example":"She traded in her old car for the new model.","exampleTranslation":"Cô ấy đã đổi chiếc xe cũ của mình lấy mẫu xe mới.","rootVerb":"trade","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"trade on":{"definition":"Khai thác, sử dụng một cái gì đó để tạo lợi thế cho bạn.","example":"He trades on their insecurity to get his way.","exampleTranslation":"Anh ta khai thác sự thiếu tự tin của họ để đạt được mục đích của mình.","rootVerb":"trade","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"trade up":{"definition":"Rời bỏ vợ hoặc chồng và cưới một người có ngoại hình tốt hơn, giàu có hơn, v.v.","example":"She supported him for years while he was struggling, but when he hit the big time he left her and traded up.","exampleTranslation":"Cô ấy đã hỗ trợ anh ta trong nhiều năm khi anh ta đang gặp khó khăn, nhưng khi anh ta trở nên thành đạt, anh ta đã bỏ cô ấy để cưới một người tốt hơn.","rootVerb":"trade","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"trade upon":{"definition":"Lợi dụng, sử dụng vì lợi thế của bạn.","example":"They trade upon their reputation to scare rivals.","exampleTranslation":"Họ lợi dụng danh tiếng của mình để làm đối thủ sợ hãi.","rootVerb":"trade","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"trickle down":{"definition":"Chuyển lợi ích từ việc mở rộng kinh tế thông qua nền kinh tế cho những người kém may mắn hơn.","example":"Despite the economic boom, few benefits have trickled down to the poor.","exampleTranslation":"Bất chấp sự bùng nổ kinh tế, rất ít lợi ích lan tỏa đến những người nghèo khó.","rootVerb":"trickle","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"try out":{"definition":"Kiểm tra cái gì đó để xem bạn có thích hay muốn mua nó không.","example":"I tried out the program before I bought it.","exampleTranslation":"Tôi đã dùng thử chương trình trước khi mua nó.","rootVerb":"try","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"turn over":{"definition":"Giao nộp cho các cơ quan chức năng.","example":"The court ordered the company to turn over their financial records.","exampleTranslation":"Tòa án đã ra lệnh cho công ty phải giao nộp hồ sơ tài chính của họ.","rootVerb":"turn","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"walk away with":{"definition":"Chiến thắng dễ dàng.","example":"She managed to walk away with the prize.","exampleTranslation":"Cô ấy đã chiến thắng dễ dàng để giành giải thưởng.","rootVerb":"walk","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"walk off with":{"definition":"Lấy thứ gì đó mà không được phép hoặc đánh cắp.","example":"Someone walked off with my umbrella so I got soaked.","exampleTranslation":"Ai đó đã lấy đi cái ô của tôi nên tôi bị ướt sũng.","rootVerb":"walk","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"weigh out":{"definition":"Cân một lượng nhất định của thứ gì đó.","example":"Could you weigh out 200 grammes of that for me?","exampleTranslation":"Bạn có thể cân 200 gram món đó cho tôi được không?","rootVerb":"weigh","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"write off":{"definition":"Phá hủy một chiếc xe trong một vụ tai nạn.","example":"He wrote the car off in an accident on the motorway.","exampleTranslation":"Anh ấy đã làm hỏng hoàn toàn chiếc xe trong một vụ tai nạn trên đường cao tốc.","rootVerb":"write","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"zero out":{"definition":"Xóa bỏ hoặc đưa một khoản mục về mức 0.","example":"The debt was zeroed out by the department.","exampleTranslation":"Khoản nợ đã bị bộ phận đó xóa bỏ.","rootVerb":"zero","topicId":"money-shopping","topicTitle":"Tiền bạc và mua sắm","partOfSpeech":"V","dictionarySource":"offline"},"belong to":{"definition":"thuộc về (một thời đại/nhóm)","example":"Their ideas belong to the nineteenth century and seem old-fashioned now.","exampleTranslation":"Ý tưởng của họ thuộc về thế kỷ 19 và giờ có vẻ lỗi thời.","rootVerb":"belong","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"belong with":{"definition":"nằm cùng chỗ với","example":"Does this disc belong with those on the shelf?","exampleTranslation":"Cái đĩa này có nằm cùng chỗ với mấy cái trên kệ không?","rootVerb":"belong","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"blow over":{"definition":"Khi một vụ bê bối bị lãng quên.","example":"The scandal blew over within a fortnight when the press found someone else to attack.","exampleTranslation":"Vụ bê bối đã lắng xuống trong vòng hai tuần khi báo chí tìm thấy người khác để tấn công.","rootVerb":"blow","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"blow up":{"definition":"Sự bắt đầu của một cơn bão.","example":"A storm blew up while we were out walking.","exampleTranslation":"Một cơn bão đã nổi lên trong khi chúng tôi đang đi dạo.","rootVerb":"blow","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"catch up in":{"definition":"Bị cuốn vào.","example":"The tourists were caught up in the violence of the revolution.","exampleTranslation":"Những du khách đã bị cuốn vào cuộc bạo loạn của cuộc cách mạng.","rootVerb":"catch","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"chance upon":{"definition":"Tình cờ tìm thấy.","example":"I chanced upon a very rare book in car boot sale and bought it for 65p.","exampleTranslation":"Tôi tình cờ tìm thấy một cuốn sách rất hiếm tại một buổi bán đồ cũ từ cốp xe và đã mua nó với giá 65 xu.","rootVerb":"chance","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"come about":{"definition":"Đổi hướng (hàng hải).","example":"The yacht came about to a heading of 240 degrees.","exampleTranslation":"Chiếc du thuyền đã đổi hướng về phía 240 độ.","rootVerb":"come","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"come forth":{"definition":"Xuất hiện.","example":"The draft proposal came forth in April.","exampleTranslation":"Bản dự thảo đề xuất đã xuất hiện vào tháng Tư.","rootVerb":"come","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"contribute to":{"definition":"Đóng góp vào, góp phần gây ra.","example":"Regular exercise contributes to better cardiovascular health.","exampleTranslation":"Tập thể dục thường xuyên góp phần vào sức khỏe tim mạch tốt hơn.","rootVerb":"contribute","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"cut across":{"definition":"Ảnh hưởng đến mọi người thuộc các nhóm, giai cấp khác nhau, v.v.","example":"The issue cuts across social backgrounds as it affects us all equally.","exampleTranslation":"Vấn đề này ảnh hưởng đến mọi tầng lớp xã hội vì nó tác động đến tất cả chúng ta như nhau.","rootVerb":"cut","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"die off":{"definition":"Tuyệt chủng.","example":"Most of the elm trees in the UK died off when Dutch elm disease arrived.","exampleTranslation":"Hầu hết các cây du ở Anh đã tuyệt chủng khi bệnh cây du Hà Lan xuất hiện.","rootVerb":"die","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"feed off":{"definition":"Sử dụng điều gì đó để làm lợi thế cho bạn.","example":"He feeds off people's fear of crime to get them to support his proposals.","exampleTranslation":"Ông ta lợi dụng nỗi sợ tội phạm của mọi người để khiến họ ủng hộ các đề xuất của mình.","rootVerb":"feed","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"finish off":{"definition":"Giết một người hoặc động vật, thường là khi họ đã bị thương.","example":"The animal was badly hurt, so they finished it off to end its suffering.","exampleTranslation":"Con vật bị thương nặng, vì vậy họ đã kết liễu nó để chấm dứt sự đau đớn cho nó.","rootVerb":"finish","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"fly by":{"definition":"Khi thời gian dường như trôi nhanh.","example":"As I get older, the years just fly by.","exampleTranslation":"Khi tôi già đi, các năm tháng cứ trôi qua thật nhanh.","rootVerb":"fly","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"go down":{"definition":"Được ghi nhớ hoặc được biết đến như là.","example":"It went down as the worst day in the history of the company.","exampleTranslation":"Nó đã được ghi nhớ là ngày tồi tệ nhất trong lịch sử của công ty.","rootVerb":"go","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"go over to":{"definition":"Đổi sang một cái gì đó khác.","example":"I used to drink beer but I have gone over to wine.","exampleTranslation":"Tôi từng uống bia nhưng tôi đã chuyển sang uống rượu vang.","rootVerb":"go","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"go together":{"definition":"Hợp nhau hoặc tương thích.","example":"Drinking and driving don't go together.","exampleTranslation":"Uống rượu và lái xe không hợp nhau.","rootVerb":"go","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"grow from":{"definition":"Bắt nguồn từ, là kết quả từ.","example":"A lot grew from the peace talks.","exampleTranslation":"Rất nhiều điều đã bắt nguồn từ các cuộc đàm phán hòa bình.","rootVerb":"grow","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"grow into":{"definition":"Trưởng thành hoặc thay đổi thành.","example":"She's has grown into a lovely person.","exampleTranslation":"Cô ấy đã trưởng thành thành một người đáng mến.","rootVerb":"grow","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"jazz up":{"definition":"Làm cho một cái gì đó thú vị hoặc hấp dẫn hơn.","example":"The show was getting stale so they jazzed it up with some new scenes.","exampleTranslation":"Chương trình đã trở nên nhàm chán nên họ đã làm cho nó hấp dẫn hơn với một vài cảnh quay mới.","rootVerb":"jazz","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"key to":{"definition":"Lập kế hoạch để phù hợp hoặc thích nghi với mọi người hoặc các tình huống.","example":"Promotions are keyed to people's abilities.","exampleTranslation":"Việc thăng chức được lên kế hoạch để phù hợp với khả năng của mọi người.","rootVerb":"key","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"lead to":{"definition":"Dẫn đến.","example":"The investigation LED to the arrest of a number of suspects.","exampleTranslation":"Cuộc điều tra đã dẫn đến việc bắt giữ một số nghi phạm.","rootVerb":"lead","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"luck into":{"definition":"Đạt được điều gì do may mắn.","example":"We lucked into getting the answer.","exampleTranslation":"Chúng tôi đã đạt được câu trả lời nhờ vào may mắn.","rootVerb":"luck","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"melt down":{"definition":"Làm nóng chảy.","example":"They melted the gold statue down and turned it into gold bars.","exampleTranslation":"Họ đã nung chảy bức tượng vàng và biến nó thành các thỏi vàng.","rootVerb":"melt","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"owe to":{"definition":"Nhờ vào.","example":"She owes her success to hard work and determination.","exampleTranslation":"Cô ấy nhờ vào sự chăm chỉ và quyết tâm để có được thành công.","rootVerb":"owe","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"pass for":{"definition":"Được chấp nhận là một cái gì đó, thường là khi không phải.","example":"You'd be surprised at what passes for good cooking in many restaurants.","exampleTranslation":"Bạn sẽ ngạc nhiên về những gì được chấp nhận là món ăn ngon ở nhiều nhà hàng.","rootVerb":"pass","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"play at":{"definition":"Giả vờ làm gì đó.","example":"He just plays at being a lawyer- he never wins a case.","exampleTranslation":"Anh ta chỉ giả vờ làm luật sư - anh ta chưa bao giờ thắng một vụ kiện nào.","rootVerb":"play","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"play on":{"definition":"Tiếp tục chơi một môn thể thao dù có thể có lý do để dừng lại.","example":"It looked like a foul, but the referee told them to play on.","exampleTranslation":"Trông có vẻ là một lỗi phạm quy, nhưng trọng tài đã bảo họ tiếp tục chơi.","rootVerb":"play","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"pour down":{"definition":"Mưa to.","example":"It poured down all day so we had to remain indoors.","exampleTranslation":"Trời đã mưa to cả ngày nên chúng tôi phải ở trong nhà.","rootVerb":"pour","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"prey on":{"definition":"Săn bắt và giết động vật để làm thức ăn.","example":"Large birds of prey often prey on small rodents.","exampleTranslation":"Các loài chim săn mồi lớn thường săn bắt các loài gặm nhấm nhỏ.","rootVerb":"prey","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"prey upon":{"definition":"Săn bắt và giết động vật để làm thức ăn.","example":"Cats prey upon birds and mice.","exampleTranslation":"Mèo săn bắt chim và chuột.","rootVerb":"prey","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"pull back":{"definition":"Ghi bàn hoặc ghi điểm gỡ hòa khi đang bị dẫn trước.","example":"They were two-nil down until five minutes before the end, when they pulled back a goal.","exampleTranslation":"Họ bị dẫn trước hai-không cho đến năm phút trước khi kết thúc, khi họ ghi được một bàn gỡ hòa.","rootVerb":"pull","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"rain down on":{"definition":"Rơi xuống với số lượng lớn.","example":"Bombs rained down on the city all night.","exampleTranslation":"Bom đã dội xuống thành phố suốt cả đêm.","rootVerb":"rain","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"rain off":{"definition":"Bị hoãn hoặc hủy vì mưa.","example":"The match was rained off.","exampleTranslation":"Trận đấu đã bị hoãn vì mưa.","rootVerb":"rain","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"rain out":{"definition":"Bị hoãn hoặc hủy vì mưa.","example":"The game was rained out.","exampleTranslation":"Trận đấu đã bị hủy vì mưa.","rootVerb":"rain","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"reel out":{"definition":"Tháo ra","example":"I reeled out the hose and watered the lawn.","exampleTranslation":"Tôi đã tháo dây vòi ra và tưới cỏ.","rootVerb":"reel","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"rely on":{"definition":"Dựa vào, tin cậy vào, phụ thuộc vào.","example":"You can always rely on her to finish the report on time.","exampleTranslation":"Bạn luôn có thể tin cậy vào cô ấy để hoàn thành báo cáo đúng hạn.","rootVerb":"rely","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"roll on":{"definition":"Khi một điều gì đó tiếp tục xảy ra.","example":"The competition rolled on despite the administrative problems.","exampleTranslation":"Cuộc thi vẫn tiếp tục diễn ra bất chấp các vấn đề hành chính.","rootVerb":"roll","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"set apart":{"definition":"Phân biệt, tốt hơn hoặc khác biệt với những người khác.","example":"The quality of their work sets them apart from their rivals.","exampleTranslation":"Chất lượng công việc đã phân biệt họ với các đối thủ cạnh tranh.","rootVerb":"set","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"spew out":{"definition":"Trào ra, phun ra.","example":"The volcano is spewing out lava and hot gases.","exampleTranslation":"Núi lửa đang phun ra dung nham và khí nóng.","rootVerb":"spew","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"spill over":{"definition":"Khi một điều xấu có tác động rộng hơn đến những người hoặc tình huống khác.","example":"The protests and demonstrations have spilled over into neighbouring states.","exampleTranslation":"Các cuộc biểu tình và tuần hành đã lan sang các bang lân cận.","rootVerb":"spill","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"spring back":{"definition":"Trở về vị trí ban đầu sau khi bị uốn cong, bị ép hoặc khi áp lực được gỡ bỏ.","example":"The lock springs back when the key is turned.","exampleTranslation":"Ổ khóa bật trở lại vị trí ban đầu khi chìa khóa được vặn.","rootVerb":"spring","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"spring from":{"definition":"Là nguyên nhân của điều gì đó.","example":"His anger springs from his feelings of insecurity.","exampleTranslation":"Cơn giận của anh ấy bắt nguồn từ cảm giác bất an của chính mình.","rootVerb":"spring","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"stem from":{"definition":"Bắt nguồn, gây ra bởi.","example":"The trouble stems from their refusal to discuss the matter.","exampleTranslation":"Rắc rối bắt nguồn từ việc họ từ chối thảo luận về vấn đề này.","rootVerb":"stem","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"stumble across":{"definition":"Tình cờ tìm thấy một cái gì đó.","example":"You'll never guess what I stumbled across when I was packing my stuff.","exampleTranslation":"Bạn sẽ không bao giờ đoán được tôi đã tình cờ tìm thấy thứ gì khi tôi đang thu dọn đồ đạc đâu.","rootVerb":"stumble","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"suck in":{"definition":"Dính líu đến một điều gì đó khó chịu.","example":"Everyone around her was taking drugs and she got sucked in.","exampleTranslation":"Mọi người xung quanh cô ấy đều dùng ma túy và cô ấy đã bị kéo vào vòng xoáy đó.","rootVerb":"suck","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"suck into":{"definition":"Dính líu đến một điều gì đó khó chịu.","example":"The country got sucked into the war.","exampleTranslation":"Đất nước này đã bị kéo vào cuộc chiến tranh.","rootVerb":"suck","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"tack on":{"definition":"Thêm một cái gì đó không được lên kế hoạch.","example":"They tacked on a new ending to the film when they found that test audiences didn't like the original.","exampleTranslation":"Họ đã thêm một cái kết mới vào bộ phim khi nhận ra khán giả thử nghiệm không thích cái kết gốc.","rootVerb":"tack","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"tack onto":{"definition":"Thêm hoặc đính kèm một cái gì đó không có kế hoạch vào một cái gì đó.","example":"I tacked a quick message onto the end of the letter after I'd printed it.","exampleTranslation":"Tôi đã thêm một tin nhắn nhanh vào cuối lá thư sau khi tôi đã in nó ra.","rootVerb":"tack","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"throw off":{"definition":"Tỏa ra ánh sáng hoặc nhiệt.","example":"The lamp throws off a lot of heat.","exampleTranslation":"Chiếc đèn tỏa ra rất nhiều nhiệt.","rootVerb":"throw","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"throw out":{"definition":"Tỏa nhiệt, thải khói.","example":"The car throws out a lot of smoke.","exampleTranslation":"Chiếc xe thải ra rất nhiều khói.","rootVerb":"throw","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"throw up":{"definition":"Tạo ra những đám mây bụi hoặc làm bắn nước vào không trung.","example":"The dry wind started to throw up a lot of dust.","exampleTranslation":"Cơn gió khô bắt đầu thổi tung rất nhiều bụi lên không trung.","rootVerb":"throw","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"tick away":{"definition":"Trôi qua (thời gian).","example":"The last few seconds ticked away and the team couldn't come back.","exampleTranslation":"Vài giây cuối cùng trôi qua và đội bóng đã không thể lật ngược thế cờ.","rootVerb":"tick","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"tick by":{"definition":"Trôi qua (thời gian).","example":"The seconds ticked by and the team failed to score.","exampleTranslation":"Những giây đồng hồ trôi qua và đội bóng đã thất bại trong việc ghi bàn.","rootVerb":"tick","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"tie in with":{"definition":"Xảy ra cùng lúc.","example":"The publication ties in with the twentieth anniversary of the incident.","exampleTranslation":"Ấn phẩm này gắn liền với lễ kỷ niệm hai mươi năm ngày xảy ra vụ việc.","rootVerb":"tie","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"top off":{"definition":"Kết thúc một cái gì đó một cách đặc biệt.","example":"He complained for an hour and to top it off started shouting his head off.","exampleTranslation":"Anh ta đã phàn nàn suốt một tiếng đồng hồ và tệ hơn nữa là bắt đầu hét lên om sòm.","rootVerb":"top","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"turn into":{"definition":"Trở thành.","example":"The small caterpillar will turn into a butterfly.","exampleTranslation":"Chú sâu nhỏ sẽ biến thành một con bướm.","rootVerb":"turn","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"usher in":{"definition":"Đánh dấu hoặc kỷ niệm một thời điểm quan trọng.","example":"We always give a party usher in the new year.","exampleTranslation":"Chúng tôi luôn tổ chức tiệc để chào đón năm mới.","rootVerb":"usher","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"vamp up":{"definition":"Làm cho cái gì đó thú vị, hấp dẫn hơn, v.v.","example":"The place is dull and you need to vamp it up.","exampleTranslation":"Nơi này thật tẻ nhạt và bạn cần phải làm cho nó trở nên thú vị hơn.","rootVerb":"vamp","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"wash out":{"definition":"Mưa quá to khiến một sự kiện phải bị hủy bỏ.","example":"The rain washed out the championship final.","exampleTranslation":"Cơn mưa quá lớn đã khiến trận chung kết giải vô địch phải bị hủy bỏ.","rootVerb":"wash","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"wear away":{"definition":"Xói mòn, loại bỏ dần dần.","example":"The lawn has been worn away by people walking across it and it's just bare soil now with hardly a blade of grass.","exampleTranslation":"Bãi cỏ đã bị xói mòn do mọi người đi bộ ngang qua và giờ nó chỉ còn là đất trống với hầu như không còn cọng cỏ nào.","rootVerb":"wear","topicId":"other-situations","topicTitle":"Tình huống khác","partOfSpeech":"V","dictionarySource":"offline"},"account for":{"definition":"giải thích; giải trình","example":"They had to account for all the money that had gone missing.","exampleTranslation":"Họ phải giải trình về toàn bộ số tiền đã bị mất.","rootVerb":"account","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"act on":{"definition":"hành động dựa trên","example":"The police were acting on a tip from an informer and caught the gang red- handed.","exampleTranslation":"Cảnh sát đã hành động dựa trên tin báo từ một người mật báo và bắt quả tang băng nhóm đó.","rootVerb":"act","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"act upon":{"definition":"hành động dựa trên","example":"The police were acting upon a tip- off.","exampleTranslation":"Cảnh sát đã hành động dựa trên tin báo.","rootVerb":"act","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"add up":{"definition":"hợp lý; có ý nghĩa","example":"She explained why the work wasn't ready, but her story doesn't add up.","exampleTranslation":"Cô ấy đã giải thích tại sao công việc không sẵn sàng, nhưng câu chuyện của cô ấy không hợp lý chút nào.","rootVerb":"add","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"add up to":{"definition":"dẫn đến kết quả","example":"Trains delays are getting worse and with the high fares, it all adds up to misery for the commuters.","exampleTranslation":"Các chuyến tàu bị hoãn ngày càng nhiều và cùng với giá vé cao, tất cả những điều đó dẫn đến sự khốn khổ cho những người đi làm.","rootVerb":"add","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"allow for":{"definition":"tính đến; chú ý đến","example":"You should allow for delays when planning a journey.","exampleTranslation":"Bạn nên tính đến những sự chậm trễ khi lên kế hoạch cho một chuyến đi.","rootVerb":"allow","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"ask for":{"definition":"chuốc lấy rắc rối","example":"You will ask for trouble if you go there alone.","exampleTranslation":"Bạn sẽ chuốc lấy rắc rối nếu bạn đến đó một mình.","rootVerb":"ask","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bail out":{"definition":"tát nước ra (khỏi thuyền)","example":"The boat was leaking so they had to bail it out.","exampleTranslation":"Chiếc thuyền bị rò rỉ nên họ phải tát nước ra ngoài.","rootVerb":"bail","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"ball up":{"definition":"làm rối tung; làm phức tạp","example":"The new project has balled me up- I have no idea what to do.","exampleTranslation":"Dự án mới đã làm tôi rối tung cả lên - tôi không biết phải làm gì cả.","rootVerb":"ball","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"balls up":{"definition":"làm hỏng; phá hỏng","example":"He ballsed the presentation up.","exampleTranslation":"Anh ấy đã làm hỏng bài thuyết trình.","rootVerb":"balls","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bang up":{"definition":"làm hỏng nặng","example":"He banged his car up last night.","exampleTranslation":"Anh ấy đã làm hỏng nặng chiếc xe của mình tối qua.","rootVerb":"bang","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bank on":{"definition":"trông cậy vào","example":"I'm banking on your help; I can't do it alone.","exampleTranslation":"Tôi đang trông cậy vào sự giúp đỡ của bạn; tôi không thể làm việc đó một mình.","rootVerb":"bank","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bash about":{"definition":"hành hạ; đối xử thô bạo (với đồ vật)","example":"If you bash your monitor about like that, it won't last long.","exampleTranslation":"Nếu bạn cứ đối xử thô bạo với cái màn hình như thế, nó sẽ không dùng được lâu đâu.","rootVerb":"bash","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"be onto":{"definition":"phát hiện ra (sự thật/bản chất)","example":"He's being very careful because he thinks the police are onto him.","exampleTranslation":"Anh ta đang rất cẩn thận vì anh ta nghĩ cảnh sát đã phát hiện ra mình.","rootVerb":"be","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"be out to":{"definition":"cố ý; nhằm mục đích","example":"She is out to get him sacked because she hates him.","exampleTranslation":"Cô ta cố tình tìm cách khiến anh ấy bị sa thải vì cô ta ghét anh ta.","rootVerb":"be","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bear on":{"definition":"ảnh hưởng đến","example":"The judge's character may well bear on the final decision.","exampleTranslation":"Nhân cách của thẩm phán có thể ảnh hưởng đến quyết định cuối cùng.","rootVerb":"bear","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bear out":{"definition":"xác nhận là đúng","example":"Statistics bear out the government's positions on the issue.","exampleTranslation":"Các số liệu thống kê xác nhận là đúng lập trường của chính phủ về vấn đề này.","rootVerb":"bear","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bitch up":{"definition":"làm hỏng; làm hư","example":"I bitched up the interview.","exampleTranslation":"Tôi đã làm hỏng buổi phỏng vấn.","rootVerb":"bitch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"block up":{"definition":"làm tắc nghẽn","example":"The pipe's blocked up and no water gets through.","exampleTranslation":"Đường ống bị tắc nghẽn và không có nước chảy qua được.","rootVerb":"block","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"boil down":{"definition":"Đơn giản hóa, tóm tắt những điểm chính.","example":"The report's so long, I boiled it down into a two-page summary.","exampleTranslation":"Bản báo cáo quá dài, tôi đã tóm tắt lại nó thành một bản tóm tắt hai trang.","rootVerb":"boil","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"boil down to":{"definition":"Chung quy lại là, tóm lại là.","example":"It all boils down to money at the end of the day.","exampleTranslation":"Suy cho cùng thì mọi chuyện cũng chỉ vì tiền.","rootVerb":"boil","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bolster up":{"definition":"Củng cố, tăng cường.","example":"We were all scared but she bolstered up our courage.","exampleTranslation":"Tất cả chúng tôi đều sợ hãi nhưng cô ấy đã củng cố lòng can đảm của chúng tôi.","rootVerb":"bolster","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"botch up":{"definition":"Làm hỏng việc.","example":"I botched up the whole project and it had to be cancelled.","exampleTranslation":"Tôi đã làm hỏng cả dự án và nó đã phải bị hủy bỏ.","rootVerb":"botch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bounce back":{"definition":"Hồi phục.","example":"The economy is bouncing back from the recession.","exampleTranslation":"Nền kinh tế đang hồi phục sau suy thoái.","rootVerb":"bounce","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"break off":{"definition":"Bẻ gãy một mảnh.","example":"She broke off a square of chocolate and gave it to her dog.","exampleTranslation":"Cô ấy bẻ gãy một mảnh sô-cô-la và đưa cho con chó của mình.","rootVerb":"break","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bring about":{"definition":"Gây ra, mang lại.","example":"The changes to the law were brought about by the government because so many people were ignoring the old one.","exampleTranslation":"Những thay đổi đối với luật pháp đã được chính phủ mang lại vì rất nhiều người đã phớt lờ luật cũ.","rootVerb":"bring","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"bring off":{"definition":"Thành công trong việc khó khăn.","example":"No one thought she'd manage to do it, but she brought it off in the end.","exampleTranslation":"Không ai nghĩ cô ấy sẽ làm được, nhưng cuối cùng cô ấy đã thành công.","rootVerb":"bring","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"buckle under":{"definition":"Đầu hàng dưới áp lực.","example":"They didn't like the ideas, but had to buckle under or face the sack.","exampleTranslation":"Họ không thích các ý tưởng đó, nhưng phải đầu hàng nếu không muốn đối mặt với việc bị sa thải.","rootVerb":"buckle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"call forth":{"definition":"Làm cho điều gì đó xảy ra.","example":"The protests called forth a strong reaction from the police.","exampleTranslation":"Các cuộc biểu tình đã gây ra một phản ứng mạnh mẽ từ phía cảnh sát.","rootVerb":"call","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cast about for":{"definition":"Cố gắng tìm kiếm.","example":"They're casting about for support.","exampleTranslation":"Họ đang cố gắng tìm kiếm sự ủng hộ.","rootVerb":"cast","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cast around for":{"definition":"Cố gắng tìm kiếm.","example":"She was casting around for people to help her.","exampleTranslation":"Cô ấy đang cố gắng tìm kiếm những người giúp đỡ mình.","rootVerb":"cast","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cast round for":{"definition":"Cố gắng tìm kiếm.","example":"He cast round for any sign of his things.","exampleTranslation":"Anh ấy cố tìm bất kỳ dấu hiệu nào về đồ đạc của mình.","rootVerb":"cast","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"catch out":{"definition":"Đẩy vào tình thế khó khăn bất ngờ.","example":"We were caught out in the storm.","exampleTranslation":"Chúng tôi đã bị đẩy vào tình thế khó khăn bất ngờ trong cơn bão.","rootVerb":"catch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cave in":{"definition":"Chịu thua, nhượng bộ.","example":"The government has refused to cave in despite the protests and demonstrations.","exampleTranslation":"Chính phủ đã từ chối nhượng bộ bất chấp các cuộc biểu tình và tuần hành.","rootVerb":"cave","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"chase down":{"definition":"Cố gắng tìm kiếm.","example":"The press chased us down when the story broke.","exampleTranslation":"Giới báo chí đã cố gắng tìm kiếm chúng tôi khi câu chuyện được phanh phui.","rootVerb":"chase","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"chew on":{"definition":"Suy nghĩ kỹ.","example":"I'll chew on it for a day or two and let you know what I think.","exampleTranslation":"Tôi sẽ suy nghĩ kỹ về việc đó một hoặc hai ngày rồi sẽ cho bạn biết tôi nghĩ gì.","rootVerb":"chew","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"chew over":{"definition":"Suy nghĩ thấu đáo.","example":"He asked for a few days to chew the matter over before he made a final decision.","exampleTranslation":"Anh ấy xin vài ngày để suy nghĩ thấu đáo về vấn đề trước khi đưa ra quyết định cuối cùng.","rootVerb":"chew","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"chip away at":{"definition":"Dần dần làm suy giảm.","example":"They have been chipping away at his reputation ever since he took office.","exampleTranslation":"Họ đã dần dần làm suy giảm danh tiếng của ông ấy kể từ khi ông ấy nhậm chức.","rootVerb":"chip","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"choke off":{"definition":"Hạn chế, ngăn chặn.","example":"These guerilla attacks are choking off our food shipments.","exampleTranslation":"Các cuộc tấn công du kích này đang ngăn chặn các chuyến hàng thực phẩm của chúng tôi.","rootVerb":"choke","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"choke out":{"definition":"Lấp đầy, lấn át.","example":"Water hyacinth is choking out the native vegetation in our rivers.","exampleTranslation":"Lục bình đang lấn át thảm thực vật bản địa trên các con sông của chúng tôi.","rootVerb":"choke","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cock up":{"definition":"Làm hỏng hoặc phá hỏng cái gì đó.","example":"It was so easy, but he managed to cock everything up.","exampleTranslation":"Mọi chuyện rất dễ dàng, nhưng anh ta lại làm hỏng tất cả.","rootVerb":"cock","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"come into":{"definition":"Quan trọng hoặc có liên quan.","example":"Money doesn't come into it; I simply will not do it under any circumstances.","exampleTranslation":"Tiền bạc không quan trọng; tôi đơn giản sẽ không làm điều đó trong bất kỳ hoàn cảnh nào.","rootVerb":"come","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"come off":{"definition":"Khi cái gì đó bị gãy rời ra.","example":"I picked it up and the handle came off in my hand.","exampleTranslation":"Tôi nhặt nó lên và cái tay cầm gãy rời ra trong tay tôi.","rootVerb":"come","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"come through with":{"definition":"Cung cấp cái gì đó cần thiết.","example":"He didn't come through with the money and they went bust.","exampleTranslation":"Anh ta đã không cung cấp số tiền cần thiết và họ đã phá sản.","rootVerb":"come","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"come up against":{"definition":"Gặp phải các vấn đề hoặc khó khăn.","example":"They will come up against many problems soon.","exampleTranslation":"Họ sẽ sớm gặp phải nhiều vấn đề.","rootVerb":"come","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"come upon":{"definition":"Tình cờ tìm thấy.","example":"I came upon the book in a little second-hand bookshop in Dorset.","exampleTranslation":"Tôi tình cờ tìm thấy cuốn sách trong một hiệu sách cũ nhỏ ở Dorset.","rootVerb":"come","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cotton on":{"definition":"Hiểu ra sự thật.","example":"It took me ages to cotton on to what they were planning.","exampleTranslation":"Tôi mất rất nhiều thời gian để hiểu ra sự thật về những gì họ đang lên kế hoạch.","rootVerb":"cotton","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"count on":{"definition":"Mong đợi điều gì đó xảy ra và dựa vào đó để lên kế hoạch.","example":"I was counting on the payment arriving last week and was really angry when it didn't arrive as I didn't have enough money to pay for everything.","exampleTranslation":"Tôi đã mong đợi khoản thanh toán đến vào tuần trước và thực sự tức giận khi nó không đến vì tôi không có đủ tiền để chi trả cho mọi thứ.","rootVerb":"count","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"count upon":{"definition":"Mong đợi điều gì đó xảy ra và dựa vào đó để lên kế hoạch.","example":"I was counting upon their support and lost because they didn't vote my way.","exampleTranslation":"Tôi đã mong đợi sự ủng hộ của họ và thất bại vì họ không bỏ phiếu theo cách của tôi.","rootVerb":"count","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"creep in":{"definition":"Lọt vào bất chấp sự ngăn cản.","example":"Errors crept in as the text got longer.","exampleTranslation":"Các lỗi sai đã lọt vào khi văn bản ngày càng dài hơn.","rootVerb":"creep","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"cross up":{"definition":"Gây nhầm lẫn, lừa gạt.","example":"The treasure map was deliberately drawn to cross us up.","exampleTranslation":"Bản đồ kho báu đã được cố tình vẽ để gây nhầm lẫn cho chúng tôi.","rootVerb":"cross","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"dawn on":{"definition":"Cuối cùng cũng nhận ra hoặc hiểu ra điều gì đó.","example":"The truth only dawned on me much later.","exampleTranslation":"Sự thật chỉ mới làm tôi nhận ra sau đó rất lâu.","rootVerb":"dawn","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"decide on":{"definition":"Chọn, lựa chọn.","example":"Trevor spent a long time looking at flats before he bought one, but eventually decided on one near his work.","exampleTranslation":"Trevor đã dành nhiều thời gian để xem các căn hộ trước khi mua một căn, nhưng cuối cùng đã chọn một căn gần chỗ làm của anh ấy.","rootVerb":"decide","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"decide upon":{"definition":"Chọn, lựa chọn.","example":"Jane spent a long time looking at houses before she bought one, but eventually decided upon one near her office.","exampleTranslation":"Jane đã dành nhiều thời gian để xem các ngôi nhà trước khi mua một ngôi nhà, nhưng cuối cùng đã chọn một ngôi nhà gần văn phòng của cô ấy.","rootVerb":"decide","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"dig up":{"definition":"Đào lên khỏi mặt đất.","example":"The police dug up a body.","exampleTranslation":"Cảnh sát đã đào một cái xác lên khỏi mặt đất.","rootVerb":"dig","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"dream up":{"definition":"Nghĩ ra, bịa ra.","example":"They dreamed up the scheme for the improvements and it was accepted by the board.","exampleTranslation":"Họ đã nghĩ ra kế hoạch cho các cải tiến và nó đã được hội đồng chấp nhận.","rootVerb":"dream","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"end in":{"definition":"Kết thúc theo một cách nào đó.","example":"Their long argument will end in a stalemate.","exampleTranslation":"Cuộc tranh luận kéo dài của họ sẽ kết thúc trong bế tắc.","rootVerb":"end","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"end up with":{"definition":"Nhận được kết quả của việc gì đó.","example":"He tried hard but ended up with a poor grade.","exampleTranslation":"Anh ta đã cố gắng rất nhiều nhưng cuối cùng chỉ nhận được một điểm số thấp.","rootVerb":"end","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"fall back on":{"definition":"Có thể dùng đến trong trường hợp khẩn cấp.","example":"It was good to have some money in the bank to fall back on when I lost my job.","exampleTranslation":"Thật tốt khi có một ít tiền trong ngân hàng để dùng đến trong trường hợp khẩn cấp khi tôi mất việc.","rootVerb":"fall","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"fall through":{"definition":"Thất bại.","example":"The plans fell through when planning permission was refused.","exampleTranslation":"Các kế hoạch đã thất bại khi giấy phép quy hoạch bị từ chối.","rootVerb":"fall","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"fathom out":{"definition":"Hiểu điều gì đó.","example":"I couldn't fathom out what she wanted from me.","exampleTranslation":"Tôi không thể hiểu nổi cô ấy muốn gì ở tôi.","rootVerb":"fathom","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"ferret out":{"definition":"Tìm kiếm và khám phá ra điều gì đó.","example":"The investigation finally managed to ferret out the truth.","exampleTranslation":"Cuộc điều tra cuối cùng đã xoay xở tìm ra sự thật.","rootVerb":"ferret","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"fight it out":{"definition":"Đấu tranh để xem ai thắng, bằng cách tranh cãi hoặc chiến đấu.","example":"They are fighting it out to see who will become the next CEO.","exampleTranslation":"Họ đang tranh đấu để xem ai sẽ trở thành CEO tiếp theo.","rootVerb":"fight","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"filter out":{"definition":"Loại bỏ những thứ không mong muốn.","example":"It filters out all the impurities and chemicals in tap water so that it tastes better.","exampleTranslation":"Nó lọc bỏ tất cả tạp chất và hóa chất trong nước máy để nước có vị ngon hơn.","rootVerb":"filter","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"fit into":{"definition":"Trở thành một phần của.","example":"Their ideas didn't fit into our plans.","exampleTranslation":"Ý tưởng của họ không phù hợp với các kế hoạch của chúng tôi.","rootVerb":"fit","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"fizzle out":{"definition":"Kết thúc một cách không thành công.","example":"The campaign started well, but fizzled out when they ran out of money.","exampleTranslation":"Chiến dịch khởi đầu tốt đẹp, nhưng rồi lại kết thúc không thành công khi họ cạn kiệt ngân sách.","rootVerb":"fizzle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"get by with":{"definition":"Xoay xở được với những gì đang có.","example":"We should be able to get by with three PCs, but four would be better.","exampleTranslation":"Chúng ta đáng lẽ có thể xoay xở được với ba chiếc máy tính, nhưng có bốn chiếc thì tốt hơn.","rootVerb":"get","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"get it together":{"definition":"Sắp xếp cuộc sống vào guồng, chấn chỉnh lại bản thân.","example":"If I don't get IT together, I will never reach my targets.","exampleTranslation":"Nếu tôi không chấn chỉnh lại bản thân, tôi sẽ không bao giờ đạt được các mục tiêu của mình.","rootVerb":"get","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"get on to":{"definition":"Bắt đầu nghi ngờ.","example":"It took the authorities a long time to get on to the gang.","exampleTranslation":"Phải mất một thời gian dài chính quyền mới bắt đầu nghi ngờ băng nhóm đó.","rootVerb":"get","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"give in to":{"definition":"Chấp nhận điều gì đó mà mình không thích.","example":"The government says it will not give in to terrorists.","exampleTranslation":"Chính phủ tuyên bố sẽ không chấp nhận nhượng bộ trước những kẻ khủng bố.","rootVerb":"give","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"give rise to":{"definition":"Làm nảy sinh, gây ra, dẫn đến kết quả gì.","example":"Unclear communication can easily give rise to serious misunderstandings.","exampleTranslation":"Giao tiếp không rõ ràng có thể dễ dàng dẫn đến những hiểu lầm nghiêm trọng.","rootVerb":"give","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go about":{"definition":"Xử lý, giải quyết việc gì.","example":"How should I go about telling her the bad news?","exampleTranslation":"Tôi nên xử lý việc thông báo cho cô ấy tin buồn này như thế nào đây?","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go after":{"definition":"Đuổi theo, cố gắng đạt được.","example":"The cat went after the pigeon, but it flew away.","exampleTranslation":"Con mèo đã đuổi theo con chim bồ câu, nhưng nó đã bay mất.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go against":{"definition":"Bị phán quyết bất lợi.","example":"If the decision goes against me, I'll go bankrupt.","exampleTranslation":"Nếu quyết định đó bất lợi cho tôi, tôi sẽ phá sản.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go at":{"definition":"Tấn công hoặc lao vào làm việc một cách hăng hái.","example":"She went at her dinner like she hadn't eaten for days.","exampleTranslation":"Cô ấy lao vào bữa tối của mình như thể đã mấy ngày không được ăn.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go by":{"definition":"Dựa vào, tin tưởng vào để có thông tin đúng.","example":"Don't go by my watch; it's usually a bit slow.","exampleTranslation":"Đừng tin vào đồng hồ của tôi; nó thường chạy hơi chậm.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go for":{"definition":"Cố gắng lấy được.","example":"The player went for the ball but missed.","exampleTranslation":"Cầu thủ đó đã cố gắng lấy bóng nhưng lại hụt.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go through with":{"definition":"Hoàn thành việc đã đồng ý.","example":"He did promise, but I doubt that he'll go through with it.","exampleTranslation":"Anh ấy đã hứa rồi, nhưng tôi nghi ngờ rằng anh ấy sẽ hoàn thành việc đó.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"go with":{"definition":"Chấp nhận, đồng ý.","example":"We're going with our original plan in the end.","exampleTranslation":"Cuối cùng chúng tôi quyết định chấp nhận kế hoạch ban đầu.","rootVerb":"go","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"goof up":{"definition":"Làm hỏng.","example":"They goofed up our plans.","exampleTranslation":"Họ đã làm hỏng các kế hoạch của chúng tôi.","rootVerb":"goof","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"grasp at":{"definition":"Cố gắng nắm lấy thứ gì đó thật nhanh.","example":"He grasped at the rail when he fell.","exampleTranslation":"Anh ấy đã cố gắng nắm lấy tay vịn khi ngã xuống.","rootVerb":"grasp","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hack up":{"definition":"Chặt hoặc cắt thành những mảnh nhỏ.","example":"They hacked the table up and burnt it.","exampleTranslation":"Họ đã chặt cái bàn thành những mảnh nhỏ và đốt nó.","rootVerb":"hack","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hammer out":{"definition":"Đàm phán và đi đến một thỏa thuận.","example":"They hammered out their differences and got the contract signed.","exampleTranslation":"Họ đã đàm phán để đi đến thỏa thuận về những khác biệt và ký kết được hợp đồng.","rootVerb":"hammer","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"help out":{"definition":"Giúp đỡ.","example":"She really helped me out when I was going through my divorce.","exampleTranslation":"Cô ấy đã thực sự giúp đỡ tôi khi tôi đang trải qua cuộc ly hôn.","rootVerb":"help","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hinge on":{"definition":"Phụ thuộc rất nhiều hoặc hoàn toàn.","example":"Our future plans hinge on this final test.","exampleTranslation":"Các kế hoạch tương lai của chúng tôi phụ thuộc vào bài kiểm tra cuối cùng này.","rootVerb":"hinge","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hinge upon":{"definition":"Phụ thuộc rất nhiều hoặc hoàn toàn.","example":"Everything hinges upon the results of the negotiations; if they go badly, we'll be in real trouble.","exampleTranslation":"Mọi thứ phụ thuộc hoàn toàn vào kết quả của các cuộc đàm phán; nếu chúng diễn ra tồi tệ, chúng ta sẽ thực sự gặp rắc rối.","rootVerb":"hinge","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hold together":{"definition":"Không chia tay.","example":"The society managed to hold together despite the crisis.","exampleTranslation":"Cộng đồng đã cố gắng không chia tay bất chấp cuộc khủng hoảng.","rootVerb":"hold","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"home in on":{"definition":"Mục tiêu.","example":"The government is homing in on benefit fraud.","exampleTranslation":"Chính phủ đang nhắm đến mục tiêu gian lận phúc lợi.","rootVerb":"home","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hone in on":{"definition":"Mục tiêu, tập trung.","example":"The team will hone in on the main target.","exampleTranslation":"Đội bóng sẽ tập trung vào mục tiêu chính.","rootVerb":"hone","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hunt out":{"definition":"Tìm kiếm cho đến khi bạn tìm thấy một cái gì đó.","example":"It took me ages to hunt out the photos.","exampleTranslation":"Tôi đã mất rất nhiều thời gian để tìm cho bằng được những bức ảnh đó.","rootVerb":"hunt","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"hunt up":{"definition":"Tìm kiếm và cố gắng tìm ra một cái gì đó.","example":"He hunted up a copy the book in the British library.","exampleTranslation":"Anh ấy đã tìm kiếm và cố gắng tìm ra một bản sao của cuốn sách trong thư viện Anh.","rootVerb":"hunt","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"iron out":{"definition":"Loại bỏ các vấn đề nhỏ hoặc bất thường.","example":"The management team ironed out the tax problems before they gave the project the OK.","exampleTranslation":"Đội ngũ quản lý đã giải quyết ổn thỏa các vấn đề về thuế trước khi họ phê duyệt dự án.","rootVerb":"iron","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"jack around":{"definition":"Gây rắc rối cho ai đó, không giữ lời hứa.","example":"Don't listen to him- he always jacks people around.","exampleTranslation":"Đừng nghe lời hắn - hắn luôn gây rắc rối cho mọi người.","rootVerb":"jack","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"jerk around":{"definition":"Gây ra rắc rối cho ai đó, đối xử tệ với ai đó.","example":"He was jerking us around and wouldn't give us the facts.","exampleTranslation":"Hắn ta đã gây rắc rối cho chúng tôi và không chịu đưa ra sự thật.","rootVerb":"jerk","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"key in on":{"definition":"Tập trung sự chú ý vào, chọn ra.","example":"They keyed in on the person they believed had done it.","exampleTranslation":"Họ đã tập trung sự chú ý vào người mà họ tin rằng đã gây ra chuyện đó.","rootVerb":"key","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"key on":{"definition":"Mục tiêu, tập trung vào (thể thao).","example":"We will key on the opposing team's lack of skills on defense.","exampleTranslation":"Chúng tôi sẽ tập trung vào điểm yếu trong khả năng phòng ngự của đội đối phương.","rootVerb":"key","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"kick down":{"definition":"Làm vỡ vật gì đó bằng chân của bạn.","example":"The police kicked the door down.","exampleTranslation":"Cảnh sát đã phá cửa bằng cách đạp đổ nó.","rootVerb":"kick","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"land in":{"definition":"Khiến ai đó gặp rắc rối.","example":"He landed me in it when he told them what I had done wrong.","exampleTranslation":"Anh ấy khiến tôi gặp rắc rối khi nói với họ những việc sai trái mà tôi đã làm.","rootVerb":"land","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"land with":{"definition":"Gây rắc rối cho ai đó.","example":"He landed me with the job of proofreading the whole thing.","exampleTranslation":"Anh ấy đã gây rắc rối cho tôi bằng việc giao cho tôi công việc hiệu đính toàn bộ tài liệu.","rootVerb":"land","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"latch on":{"definition":"Hiểu ra, thường là sau một thời gian dài.","example":"They were lying, but it took her ages to latch on.","exampleTranslation":"Họ đã nói dối, nhưng phải mất rất lâu cô ấy mới hiểu ra.","rootVerb":"latch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"latch on to":{"definition":"Hiểu ra điều gì đó, thường là sau một thời gian dài.","example":"The police didn't latch on to what the crooks were doing for years.","exampleTranslation":"Cảnh sát đã không hiểu ra những gì bọn tội phạm đang làm trong nhiều năm.","rootVerb":"latch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"lie with":{"definition":"Có quyền đưa ra quyết định.","example":"The decision about the contract lies with the courts.","exampleTranslation":"Quyết định về hợp đồng này thuộc thẩm quyền của tòa án.","rootVerb":"lie","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"live up to":{"definition":"Đáp ứng kỳ vọng.","example":"The concert didn't live up to my expectations.","exampleTranslation":"Buổi hòa nhạc đã không đáp ứng được những kỳ vọng của tôi.","rootVerb":"live","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"look to":{"definition":"Kỳ vọng.","example":"The company is looking to increase its sales in Asia.","exampleTranslation":"Công ty đang kỳ vọng sẽ tăng doanh số bán hàng tại châu Á.","rootVerb":"look","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"make do with":{"definition":"Chấp nhận điều kém hơn vì không có lựa chọn khác.","example":"There's no coffee, so we'll have to make do with tea.","exampleTranslation":"Không có cà phê, nên chúng tôi sẽ phải dùng tạm trà.","rootVerb":"make","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"make for":{"definition":"Tạo ra một kết quả hoặc tình huống.","example":"The low quality of the service made for a lot of dissatisfaction.","exampleTranslation":"Chất lượng dịch vụ kém đã dẫn đến rất nhiều sự bất mãn.","rootVerb":"make","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"make good on":{"definition":"Thực hiện đúng lời hứa, hoàn thành nghĩa vụ.","example":"He made good on his promise to take his family on a vacation.","exampleTranslation":"Anh ấy đã thực hiện đúng lời hứa đưa gia đình đi nghỉ mát.","rootVerb":"make","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"make into":{"definition":"Thay đổi thứ gì thành một thứ khác.","example":"Many churches have been made into flats in recent years.","exampleTranslation":"Nhiều nhà thờ đã được chuyển đổi thành căn hộ trong những năm gần đây.","rootVerb":"make","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"make up for":{"definition":"Đền bù.","example":"I sent her a present to try to make up for my appalling behaviour.","exampleTranslation":"Tôi đã gửi cho cô ấy một món quà để cố gắng đền bù cho hành vi tồi tệ của mình.","rootVerb":"make","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"measure up":{"definition":"Tìm ra kích thước của một cái gì.","example":"They measured up the room.","exampleTranslation":"Họ đã đo đạc căn phòng.","rootVerb":"measure","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"measure up to":{"definition":"Đủ tốt hoặc xứng đáng với điều gì.","example":"I hope to measure up to the confidence you have in me.","exampleTranslation":"Tôi hy vọng mình đủ xứng đáng với sự tin tưởng mà bạn dành cho tôi.","rootVerb":"measure","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"meet with":{"definition":"Trải qua điều gì đó.","example":"They met with some problems they hadn't anticipated.","exampleTranslation":"Họ đã gặp phải một số vấn đề mà họ chưa từng dự đoán trước.","rootVerb":"meet","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"mess about with":{"definition":"Cố gắng cải thiện nhưng thường làm tệ hơn.","example":"The computer was working fine until he started messing about with it.","exampleTranslation":"Máy tính vẫn hoạt động tốt cho đến khi anh ấy bắt đầu táy máy vào nó.","rootVerb":"mess","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"mess with":{"definition":"Cố sửa hoặc cải thiện nhưng không thành.","example":"She's been messing with it for hours and it still doesn't work.","exampleTranslation":"Cô ấy đã loay hoay sửa nó hàng giờ liền mà nó vẫn không hoạt động.","rootVerb":"mess","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"move in on":{"definition":"Tiến lại gần, thường là lén lút.","example":"As he watched, the hyenas began to move in on the hapless wildebeest.","exampleTranslation":"Khi anh ấy quan sát, lũ linh cẩu bắt đầu tiến lại gần con linh dương đầu bò đáng thương.","rootVerb":"move","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muddle along":{"definition":"Tiếp tục mà không có mục tiêu rõ ràng.","example":"If you're ambitious, you cannot muddle along.","exampleTranslation":"Nếu bạn có tham vọng, bạn không thể cứ sống tiếp mà không có mục tiêu rõ ràng.","rootVerb":"muddle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muddle through":{"definition":"Hoàn thành điều gì mà không có kế hoạch.","example":"We didn't know what to expect and just muddled through.","exampleTranslation":"Chúng tôi không biết điều gì sẽ xảy ra và chỉ xoay xở hoàn thành mọi việc mà không có kế hoạch.","rootVerb":"muddle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muddle up":{"definition":"Nhầm lẫn một người với người khác.","example":"I muddle her and her sister up.","exampleTranslation":"Tôi nhầm lẫn giữa cô ấy và chị gái cô ấy.","rootVerb":"muddle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"mull over":{"definition":"Suy nghĩ kĩ về một vấn đề.","example":"I need some time to mull over your interesting offer.","exampleTranslation":"Tôi cần chút thời gian để suy nghĩ kĩ về lời đề nghị thú vị của bạn.","rootVerb":"mull","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muscle in":{"definition":"Can thiệp vào việc gì khi không được mời.","example":"We tried to exclude him of the committee, but he muscled in.","exampleTranslation":"Chúng tôi đã cố gắng loại anh ấy khỏi ủy ban, nhưng anh ấy vẫn chen vào.","rootVerb":"muscle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muscle in on":{"definition":"Can thiệp bất chấp sự phản đối.","example":"She muscled in on the deal even though we wanted to do it without her.","exampleTranslation":"Cô ấy đã can thiệp vào thương vụ này mặc dù chúng tôi muốn thực hiện nó mà không có cô ấy.","rootVerb":"muscle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muscle into":{"definition":"Dính líu vào mặc dù bị phản đối.","example":"They are muscling into our market and there is very little we can do to stop them.","exampleTranslation":"Họ đang chen chân vào thị trường của chúng tôi và chúng tôi hầu như không thể làm gì để ngăn họ lại.","rootVerb":"muscle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"muscle out":{"definition":"Sử dụng quyền lực để đẩy ai đó ra ngoài.","example":"They used their contacts in local government to muscle the competitors out.","exampleTranslation":"Họ đã sử dụng các mối quan hệ của mình trong chính quyền địa phương để đẩy các đối thủ cạnh tranh ra ngoài.","rootVerb":"muscle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"nose about":{"definition":"Tìm kiếm điều gì bí mật.","example":"The police are nosing about to see if they can find anything against the gang.","exampleTranslation":"Cảnh sát đang lén lút tìm kiếm xung quanh để xem liệu họ có thể tìm ra bất cứ bằng chứng gì chống lại băng nhóm đó không.","rootVerb":"nose","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"nut out":{"definition":"Tìm ra câu trả lời cho một vấn đề.","example":"The management and unions had a meeting to nut things out.","exampleTranslation":"Ban quản lý và các công đoàn đã có một cuộc họp để tìm ra giải pháp cho các vấn đề.","rootVerb":"nut","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"occur to":{"definition":"Nảy ra trong đầu.","example":"Didn't it occur to you to help me when you saw how much trouble I was in?","exampleTranslation":"Không nảy ra trong đầu bạn ý định giúp đỡ tôi khi bạn thấy tôi gặp khó khăn nhiều đến mức nào sao?","rootVerb":"occur","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"opt for":{"definition":"Lựa chọn.","example":"I opted for an endowment mortgage and lost a lot of money.","exampleTranslation":"Tôi đã lựa chọn một khoản vay thế chấp có kèm bảo hiểm nhân thọ và mất rất nhiều tiền.","rootVerb":"opt","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"pan out":{"definition":"Cách một tình huống phát triển.","example":"I don't know how things will pan out now the company's been taken over.","exampleTranslation":"Tôi không biết tình hình sẽ phát triển ra sao bây giờ khi công ty đã bị thâu tóm.","rootVerb":"pan","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"paper over":{"definition":"Cố gắng che giấu một vấn đề mà không thực sự giải quyết nó.","example":"The government tried to paper over the problems in the proposal, but the press were very critical.","exampleTranslation":"Chính phủ đã cố gắng che đậy các vấn đề trong bản đề xuất, nhưng giới báo chí lại rất chỉ trích.","rootVerb":"paper","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"patch together":{"definition":"Tạo ra hoặc lắp ráp một cái gì đó nhanh chóng mà không có nhiều kế hoạch.","example":"They patched together a coalition after the election.","exampleTranslation":"Họ đã nhanh chóng tạo ra một liên minh sau cuộc bầu cử.","rootVerb":"patch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"peter out":{"definition":"Mất đà và dừng lại.","example":"Everyone was keen at first, but the enthusiasm petered out when they saw how long it would take.","exampleTranslation":"Ban đầu ai cũng hào hứng, nhưng sự nhiệt tình đã dần mất đà và dừng lại khi họ thấy việc này sẽ tốn bao nhiêu thời gian.","rootVerb":"peter","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"pick out":{"definition":"Nhận dạng từ một bức ảnh.","example":"The victim couldn't pick out her attacker from the photos the police showed her.","exampleTranslation":"Nạn nhân đã không thể nhận diện được kẻ tấn công mình từ những bức ảnh cảnh sát đưa cho cô ấy.","rootVerb":"pick","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"pick through":{"definition":"Tìm kiếm một cái gì đó trong một đống lộn xộn.","example":"The police have been picking through the wreckage for clues.","exampleTranslation":"Cảnh sát đã lục lọi trong đống đổ nát để tìm các đầu mối.","rootVerb":"pick","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"pin down":{"definition":"Bắt ai đó đưa ra ý kiến, quyết định chắc chắn.","example":"I've asked him to set a date, but he's a hard man to PIN down and won't give a definite answer.","exampleTranslation":"Tôi đã yêu cầu anh ấy ấn định một ngày, nhưng anh ấy là người khó bắt ép đưa ra quyết định chắc chắn và sẽ không trả lời cụ thể.","rootVerb":"pin","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"plump for":{"definition":"Chọn lựa.","example":"I plumped for the steak frites.","exampleTranslation":"Tôi đã chọn món bít tết khoai tây chiên.","rootVerb":"plump","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"psych out":{"definition":"Tìm hiểu hoặc dự đoán ý định của ai đó.","example":"We have to try to psych out our rivals.","exampleTranslation":"Chúng ta phải cố gắng tìm hiểu và dự đoán ý định của các đối thủ cạnh tranh.","rootVerb":"psych","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"pull apart":{"definition":"Phá bỏ, chỉ trích mạnh mẽ một lập luận, lý thuyết, v.v.","example":"My tutor pulled my essay apart.","exampleTranslation":"Giảng viên của tôi đã chỉ trích mạnh mẽ bài luận của tôi.","rootVerb":"pull","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"pull off":{"definition":"Thành công trong việc làm điều gì đó khó khăn hoặc phức tạp.","example":"No-one thought that she would be able to do it, but she pulled it off in the end.","exampleTranslation":"Không ai nghĩ rằng cô ấy sẽ có thể làm được điều đó, nhưng cuối cùng cô ấy đã thành công.","rootVerb":"pull","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"put an end to":{"definition":"Chấm dứt, kết liễu, dẹp bỏ cái gì dứt điểm.","example":"The peace treaty finally put an end to decades of regional conflict.","exampleTranslation":"Hiệp ước hòa bình cuối cùng đã chấm dứt nhiều thập kỷ xung đột trong khu vực.","rootVerb":"put","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"put down to":{"definition":"Đưa ra như một lời giải thích.","example":"We can put down to the heavy rain for the delay.","exampleTranslation":"Chúng ta có thể đổ lỗi cho cơn mưa lớn vì sự chậm trễ này.","rootVerb":"put","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"queer up":{"definition":"Làm hỏng, phá hoại.","example":"I queered the exam up.","exampleTranslation":"Tôi đã làm hỏng kỳ thi.","rootVerb":"queer","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"ratchet up":{"definition":"Tăng lên.","example":"The media are trying to ratchet up the pressure on the president.","exampleTranslation":"Truyền thông đang cố gắng gia tăng áp lực lên tổng thống.","rootVerb":"ratchet","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"reason out":{"definition":"Suy luận ra","example":"He reasoned out the answer to the math problem.","exampleTranslation":"Anh ấy đã suy luận ra câu trả lời cho bài toán đó.","rootVerb":"reason","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"reckon on":{"definition":"Dự tính mức tối thiểu.","example":"Jeff says we can reckon on there being at least fifty people there tonight.","exampleTranslation":"Jeff nói rằng chúng ta có thể dự tính sẽ có ít nhất năm mươi người ở đó tối nay.","rootVerb":"reckon","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"rein in":{"definition":"Kiểm soát để ngăn gây thêm rắc rối.","example":"They had to rein the minister in after her dreadful performance on TV.","exampleTranslation":"Họ phải kiểm soát vị bộ trưởng sau màn thể hiện tồi tệ của bà ấy trên truyền hình.","rootVerb":"rein","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"result in":{"definition":"Dẫn đến, đưa đến kết quả là.","example":"Careless driving can easily result in serious accidents.","exampleTranslation":"Lái xe bất cẩn có thể dễ dàng dẫn đến những tai nạn nghiêm trọng.","rootVerb":"result","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"ride out":{"definition":"Vượt qua thời kỳ khó khăn.","example":"They managed to ride out the recession.","exampleTranslation":"Họ đã xoay xở để vượt qua thời kỳ suy thoái.","rootVerb":"ride","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"romp in":{"definition":"Chiến thắng một cách dễ dàng.","example":"In the first race, the favourite romped in.","exampleTranslation":"Trong cuộc đua đầu tiên, ứng cử viên được yêu thích đã chiến thắng một cách dễ dàng.","rootVerb":"romp","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"root out":{"definition":"Tìm ra nguồn gốc của một vấn đề và loại bỏ nó.","example":"They are trying to root out the troublemakers.","exampleTranslation":"Họ đang cố gắng tìm ra nguồn gốc và loại bỏ những kẻ gây rối.","rootVerb":"root","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"run down":{"definition":"Tìm ra nguồn gốc hoặc gốc rễ của một cái gì đó.","example":"The police ran down all the leads they had and caught them.","exampleTranslation":"Cảnh sát đã truy tìm mọi manh mối họ có và bắt được chúng.","rootVerb":"run","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"run up against":{"definition":"Gặp sự cố, thường là bất ngờ.","example":"They ran up against a lot of opposition to the construction.","exampleTranslation":"Họ đã gặp phải rất nhiều sự phản đối đối với công trình xây dựng.","rootVerb":"run","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"rush into":{"definition":"Làm điều gì đó quá nhanh chóng.","example":"They don't want to be rushed into giving an answer and have asked for more time.","exampleTranslation":"Họ không muốn bị thúc ép phải đưa ra câu trả lời và đã xin thêm thời gian.","rootVerb":"rush","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"saw off":{"definition":"Bỏ một cái gì đó bằng cách cắt nó bằng cưa.","example":"He sawed off the legs of the chair.","exampleTranslation":"Anh ấy đã cưa bỏ phần chân của chiếc ghế.","rootVerb":"saw","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"scout around":{"definition":"Tìm kiếm một cái gì đó ở những nơi khác nhau.","example":"We scouted around to find the best price.","exampleTranslation":"Chúng tôi đã tìm kiếm ở nhiều nơi khác nhau để tìm ra mức giá tốt nhất.","rootVerb":"scout","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"screen out":{"definition":"Ngừng chú ý đến một điều gì đó.","example":"There are so many notices and signs that I have started screening them out.","exampleTranslation":"Có quá nhiều thông báo và biển hiệu đến mức tôi đã bắt đầu ngừng chú ý đến chúng.","rootVerb":"screen","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"screw up":{"definition":"Làm tệ hoặc thất bại.","example":"David screwed up his oral exam but still managed to scrape a pass.","exampleTranslation":"David đã làm tệ bài thi nói của mình nhưng vẫn xoay xở để đạt điểm đỗ tối thiểu.","rootVerb":"screw","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"see about":{"definition":"Sắp xếp, cân nhắc.","example":"I'll see about whether we can manage it.","exampleTranslation":"Tôi sẽ cân nhắc xem liệu chúng ta có thể xoay xở việc đó không.","rootVerb":"see","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"see through":{"definition":"Tiếp tục với một điều gì đó cho đến khi kết thúc.","example":"They had a lot of difficulties in implementing the project, but the team saw it through successfully.","exampleTranslation":"Họ đã gặp nhiều khó khăn trong việc triển khai dự án, nhưng nhóm đã kiên trì thực hiện đến cùng thành công.","rootVerb":"see","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"see to":{"definition":"Giải quyết một việc gì đó.","example":"He saw to the arrangements and everything ran smoothly and efficiently.","exampleTranslation":"Anh ấy đã giải quyết các khâu chuẩn bị và mọi thứ đều diễn ra trôi chảy, hiệu quả.","rootVerb":"see","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"settle for":{"definition":"Chấp nhận bất cứ thứ gì có sẵn.","example":"We were upset not to win and had to settle for the second prize.","exampleTranslation":"Chúng tôi đã rất thất vọng vì không giành chiến thắng và đành phải chấp nhận giải nhì.","rootVerb":"settle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"settle on":{"definition":"Đồng ý, quyết định chọn.","example":"They couldn't agree at first on a name for their daughter, but finally settled on Alice.","exampleTranslation":"Ban đầu họ không thể đồng ý về một cái tên cho con gái mình, nhưng cuối cùng đã quyết định chọn Alice.","rootVerb":"settle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"sift through":{"definition":"Xem xét cẩn thận nhiều thứ.","example":"We had to sift through thousands of files before we found what we were looking for.","exampleTranslation":"Chúng tôi đã phải xem xét cẩn thận hàng ngàn tệp tin trước khi tìm thấy thứ mình đang tìm kiếm.","rootVerb":"sift","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"single out":{"definition":"Chọn ra một người từ một nhóm.","example":"Many people applied for the job but we will single out the best one.","exampleTranslation":"Nhiều người đã nộp đơn cho công việc này nhưng chúng tôi sẽ chọn ra người xuất sắc nhất.","rootVerb":"single","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"sit by":{"definition":"Khoanh tay đứng nhìn.","example":"I can't sit by while they are punished wrongly.","exampleTranslation":"Tôi không thể khoanh tay đứng nhìn trong khi họ bị trừng phạt một cách oan ức.","rootVerb":"sit","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"sit on":{"definition":"Răn đe ai đó một cách cương quyết.","example":"If his girlfriend finds out, she'll get mad and sit on him.","exampleTranslation":"Nếu bạn gái của anh ấy phát hiện ra, cô ấy sẽ nổi giận và răn đe anh ấy một cách cương quyết.","rootVerb":"sit","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"sit with":{"definition":"Phù hợp, hòa hợp.","example":"It's hard to see how their new plan sits with the promises they made.","exampleTranslation":"Thật khó để thấy kế hoạch mới của họ phù hợp như thế nào với những lời hứa mà họ đã đưa ra.","rootVerb":"sit","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"size up":{"definition":"Đánh giá cẩn thận.","example":"The doorstaff sized up everyone entering the club.","exampleTranslation":"Nhân viên bảo vệ cửa đã đánh giá cẩn thận mọi người đang đi vào câu lạc bộ.","rootVerb":"size","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"sleep on":{"definition":"Suy nghĩ về điều gì đó (thường qua đêm).","example":"My boss said she'd have to sleep on it when I asked her for a raise.","exampleTranslation":"Sếp của tôi nói rằng bà ấy sẽ phải suy nghĩ về điều đó qua đêm khi tôi xin bà ấy tăng lương.","rootVerb":"sleep","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"smash in":{"definition":"Đập vỡ cái gì đó bằng cách đánh nhiều lần.","example":"He smashed the windscreen in.","exampleTranslation":"Anh ấy đã đập vỡ kính chắn gió.","rootVerb":"smash","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"smash up":{"definition":"Phá hủy, đập thành nhiều mảnh.","example":"The burglars smashed up the office as there was no money to steal.","exampleTranslation":"Những kẻ trộm đã phá hủy văn phòng vì không có tiền để lấy cắp.","rootVerb":"smash","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"snarl up":{"definition":"Làm rối tung, làm ách tắc.","example":"My line was all snarled up after I caught that last fish.","exampleTranslation":"Dây câu của tôi đã bị rối tung lên sau khi tôi bắt được con cá cuối cùng đó.","rootVerb":"snarl","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"sniff out":{"definition":"Tìm hiểu thông tin, đặc biệt là khi người ta không muốn ai biết.","example":"Our rivals are trying to sniff out our plans for expansion.","exampleTranslation":"Các đối thủ của chúng ta đang cố gắng tìm hiểu thông tin về kế hoạch mở rộng của chúng ta.","rootVerb":"sniff","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"spark off":{"definition":"Gây ra cái gì đó, thường là không vui.","example":"The riot was sparked off by the police raid on the club.","exampleTranslation":"Vụ bạo loạn đã bị châm ngòi bởi cuộc đột kích của cảnh sát vào câu lạc bộ.","rootVerb":"spark","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"square away":{"definition":"Hoàn thành hoặc sắp xếp ổn thỏa điều gì đó.","example":"There are few things I have to square away before I can leave.","exampleTranslation":"Có vài việc tôi phải hoàn thành ổn thỏa trước khi có thể rời đi.","rootVerb":"square","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"square up to":{"definition":"Chấp nhận trách nhiệm hoặc lỗi lầm.","example":"They need to square up to what they did wrong if we are to make any progress.","exampleTranslation":"Họ cần phải chấp nhận trách nhiệm về những gì họ đã làm sai nếu chúng ta muốn đạt được bất kỳ tiến bộ nào.","rootVerb":"square","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"square with":{"definition":"Phù hợp, đồng nhất với.","example":"What he said doesn't square with what the others said.","exampleTranslation":"Những gì anh ta nói không khớp với những gì những người khác đã nói.","rootVerb":"square","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"stack up against":{"definition":"Tốt bằng cái gì đó.","example":"The new model doesn't stack up against the old one.","exampleTranslation":"Mẫu mới không tốt bằng mẫu cũ.","rootVerb":"stack","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"stand back":{"definition":"Cố gắng hiểu điều gì đó bằng cách nhìn từ một góc độ khác.","example":"We need to stand back and look at the problem differently.","exampleTranslation":"Chúng ta cần phải lùi lại và nhìn vấn đề theo một cách khác.","rootVerb":"stand","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"step back":{"definition":"Nhìn một vấn đề từ một góc độ khác.","example":"We should step back and try to see how our customers will view the scheme.","exampleTranslation":"Chúng ta nên lùi lại và cố gắng nhìn nhận xem khách hàng sẽ đánh giá kế hoạch của chúng ta như thế nào.","rootVerb":"step","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"step in":{"definition":"Can thiệp vào bằng cách làm gián đoạn điều gì đó.","example":"I had to step in when they started fighting.","exampleTranslation":"Tôi đã phải can thiệp khi họ bắt đầu đánh nhau.","rootVerb":"step","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"straighten out":{"definition":"Làm cho một cái gì đó thẳng.","example":"Please straighten out the messy cables here.","exampleTranslation":"Làm ơn hãy làm thẳng những sợi dây cáp lộn xộn ở đây.","rootVerb":"straighten","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"strike on":{"definition":"Nảy ra một ý tưởng hay.","example":"I struck on the solution when I was out with my dog.","exampleTranslation":"Tôi đã nảy ra giải pháp đó khi đang đi dạo với chú chó của mình.","rootVerb":"strike","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"strike upon":{"definition":"Nảy ra một ý tưởng hay.","example":"It took us a long time to strike upon a solution.","exampleTranslation":"Chúng tôi đã mất rất nhiều thời gian để nảy ra một giải pháp.","rootVerb":"strike","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"stuff up":{"definition":"Mắc lỗi, làm tệ, làm hỏng.","example":"I stuffed the exam up.","exampleTranslation":"Tôi đã làm hỏng bài kiểm tra.","rootVerb":"stuff","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"stumble upon":{"definition":"Tình cờ tìm thấy một cái gì đó.","example":"I stumbled upon these photos when I was clearing my room up.","exampleTranslation":"Tôi tình cờ tìm thấy những bức ảnh này khi đang dọn dẹp phòng của mình.","rootVerb":"stumble","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"suss out":{"definition":"Bắt đầu hiểu ra.","example":"It took her ages to suss out what was going on.","exampleTranslation":"Cô ấy phải mất rất lâu mới bắt đầu hiểu ra chuyện gì đang xảy ra.","rootVerb":"suss","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"tear down":{"definition":"Phá huỷ, dỡ bỏ.","example":"The estate was torn down so that they could develop the land into luxury flats.","exampleTranslation":"Khu bất động sản đó đã bị dỡ bỏ để họ có thể phát triển vùng đất thành các căn hộ cao cấp.","rootVerb":"tear","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"tear up":{"definition":"Xé thành từng mảnh.","example":"He tore the fax up and threw the bits of paper in the bin.","exampleTranslation":"Anh ấy đã xé nát bản fax và ném những mảnh giấy vào thùng rác.","rootVerb":"tear","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"tell apart":{"definition":"Nhận ra sự khác biệt giữa hai thứ.","example":"They're identical twins so I cannot tell them apart.","exampleTranslation":"Họ là cặp song sinh giống hệt nhau nên tôi không thể phân biệt được họ.","rootVerb":"tell","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"think over":{"definition":"Xem xét điều gì đó một cách cẩn thận.","example":"I've thought it over and have made up my mind; I'm going to take the job in Leeds.","exampleTranslation":"Tôi đã suy nghĩ cẩn thận về điều đó và đã quyết định; tôi sẽ nhận công việc ở Leeds.","rootVerb":"think","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"think through":{"definition":"Xem xét tất cả các khả năng và kết quả của một tình huống.","example":"The plan fell through because they hadn't thought it through properly.","exampleTranslation":"Kế hoạch đã thất bại vì họ đã không suy nghĩ thấu đáo về tất cả các khả năng và kết quả.","rootVerb":"think","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"think up":{"definition":"Tạo ra hoặc phát minh ra thứ gì đó, đặc biệt là khi nói dối.","example":"I'd better think up a good reason for handing the work in late.","exampleTranslation":"Tôi tốt hơn là nên nghĩ ra một lý do chính đáng cho việc nộp bài muộn.","rootVerb":"think","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"tie in":{"definition":"Đồng ý, được kết nối hoặc hỗ trợ.","example":"The theory ties in with what the police have been saying.","exampleTranslation":"Lý thuyết này khớp với những gì cảnh sát đã nói.","rootVerb":"tie","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"toss for":{"definition":"Đưa ra quyết định bằng cách tung đồng xu và xem mặt nào ngửa lên.","example":"We tossed for who would start.","exampleTranslation":"Chúng tôi đã tung đồng xu để quyết định xem ai sẽ bắt đầu.","rootVerb":"toss","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"toss up":{"definition":"Quyết định điều gì đó bằng cách tung đồng xu và xem mặt nào ngửa lên.","example":"We tossed up to see who would kick off.","exampleTranslation":"Chúng tôi đã tung đồng xu để quyết định xem ai sẽ là người giao bóng trước.","rootVerb":"toss","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"touch off":{"definition":"Gây ra một vấn đề.","example":"The government's decision touched off riots in the capital.","exampleTranslation":"Quyết định của chính phủ đã gây ra các cuộc bạo loạn ở thủ đô.","rootVerb":"touch","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"toy at":{"definition":"Giả vờ nghĩ về hoặc nghĩ về một cách tình cờ.","example":"She toyed at getting them to help her but then did it alone.","exampleTranslation":"Cô ấy đã giả vờ nghĩ đến việc nhờ họ giúp đỡ nhưng rồi lại tự mình làm.","rootVerb":"toy","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"toy over":{"definition":"Suy nghĩ về một cái gì đó.","example":"I toyed over the idea for a while, but decided not to go ahead with it.","exampleTranslation":"Tôi đã suy nghĩ về ý tưởng đó một thời gian, nhưng quyết định không thực hiện nó.","rootVerb":"toy","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"toy with":{"definition":"Cân nhắc một điều gì đó, nhưng không quá mức","example":"We should toy with the idea of traveling.","exampleTranslation":"Chúng ta nên cân nhắc ý tưởng đi du lịch.","rootVerb":"toy","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"track down":{"definition":"Tìm thấy sau một thời gian dài tìm kiếm.","example":"It took me ages to track them down in the crowd at the football game.","exampleTranslation":"Tôi đã mất rất nhiều thời gian để tìm ra họ trong đám đông tại trận bóng đá.","rootVerb":"track","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"trade off":{"definition":"Chấp nhận điều bạn không thực sự muốn để có được điều bạn muốn.","example":"We had to trade off space for the location when buying the apartment.","exampleTranslation":"Chúng tôi đã phải chấp nhận đánh đổi không gian lấy vị trí khi mua căn hộ.","rootVerb":"trade","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"try it on":{"definition":"Cố gắng để có được thứ gì đó, thường là bằng sự lừa dối, mà không có hy vọng thành công lớn.","example":"He knew I wasn't got to let him do it- he was just trying IT on.","exampleTranslation":"Anh ta biết tôi sẽ không để anh ta làm điều đó - anh ta chỉ đang cố gắng lừa tôi thôi.","rootVerb":"try","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"wade in":{"definition":"Bắt đầu hoặc can thiệp vào, thường là không suy nghĩ hoặc quá mạnh bạo.","example":"He just waded in without listening to what anyone had to say.","exampleTranslation":"Anh ta cứ thế xông vào mà không thèm lắng nghe những gì mọi người muốn nói.","rootVerb":"wade","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"wade into":{"definition":"Dính líu hoặc tham gia vào một tình huống, thường không suy nghĩ hoặc không có kế hoạch.","example":"They waded into the negotiations and the deal collapsed.","exampleTranslation":"Họ đã can thiệp vào các cuộc đàm phán và thỏa thuận đã đổ bể.","rootVerb":"wade","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"wait on":{"definition":"Chờ đợi một kết quả trước khi có thể đưa ra quyết định.","example":"They're waiting on the results of the vote before taking a final decision.","exampleTranslation":"Họ đang chờ đợi kết quả bỏ phiếu trước khi đưa ra quyết định cuối cùng.","rootVerb":"wait","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"wait out":{"definition":"Đợi cho đến khi điều gì đó kết thúc, thường là điều khó chịu.","example":"We'll have to wait out this uncertainty.","exampleTranslation":"Chúng ta sẽ phải đợi cho đến khi sự không chắc chắn này kết thúc.","rootVerb":"wait","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"wait upon":{"definition":"Chờ đợi một kết quả trước khi có thể đưa ra quyết định.","example":"They must wait upon the outcome of the match before they know who they'll be playing.","exampleTranslation":"Họ phải chờ đợi kết quả của trận đấu trước khi biết họ sẽ đấu với ai.","rootVerb":"wait","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"walk away from":{"definition":"Rời bỏ thứ mà bạn không thích.","example":"You can't just walk away from your problems.","exampleTranslation":"Bạn không thể cứ thế rời bỏ những vấn đề của mình.","rootVerb":"walk","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"water down":{"definition":"Làm cho điều gì đó yếu đi và bớt hiệu quả.","example":"Do not water down the original plan now.","exampleTranslation":"Đừng làm cho kế hoạch ban đầu trở nên yếu đi và bớt hiệu quả ngay lúc này.","rootVerb":"water","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"weed out":{"definition":"Loại bỏ, vứt bỏ.","example":"The company weeded out the unsuccessful sales reps.","exampleTranslation":"Công ty đã loại bỏ những đại diện bán hàng kém hiệu quả.","rootVerb":"weed","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"weigh up":{"definition":"Đánh giá.","example":"They weighed the pros and cons up carefully before deciding.","exampleTranslation":"Họ đã đánh giá cẩn thận những ưu và nhược điểm trước khi quyết định.","rootVerb":"weigh","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"wiggle out":{"definition":"Lẩn tránh việc gì.","example":"He was supposed to be in charge but tried to wiggle out.","exampleTranslation":"Anh ta đáng lẽ phải là người chịu trách nhiệm nhưng lại cố gắng lẩn tránh.","rootVerb":"wiggle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"winkle out":{"definition":"Cạy ra, lấy được thứ gì đó mất rất nhiều công sức.","example":"It took me a while to winkle the truth out of him.","exampleTranslation":"Tôi đã mất một lúc lâu mới có thể cạy được sự thật ra từ anh ta.","rootVerb":"winkle","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"yield to":{"definition":"Đầu hàng, nhượng bộ.","example":"I tried hard to resist, but in the end I yielded to temptation and ate it all.","exampleTranslation":"Tôi đã cố gắng chống cự, nhưng cuối cùng tôi đã đầu hàng sự cám dỗ và ăn hết sạch.","rootVerb":"yield","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"zero in on":{"definition":"Hướng hoặc tập trung sự chú ý vào.","example":"The police have zeroed in on the man they believe to be responsible for the murder.","exampleTranslation":"Cảnh sát đã tập trung sự chú ý vào người đàn ông mà họ tin là chịu trách nhiệm cho vụ giết người.","rootVerb":"zero","topicId":"problem-solving","topicTitle":"Giải quyết vấn đề","partOfSpeech":"V","dictionarySource":"offline"},"abide by":{"definition":"tuân theo; chấp hành","example":"We have to abide by what the court says.","exampleTranslation":"Chúng ta phải tuân theo những gì tòa án nói.","rootVerb":"abide","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"barge in":{"definition":"xông vào; ngắt lời","example":"He keeps barging in and asking stupid questions when I'm trying to work.","exampleTranslation":"Anh ta cứ liên tục xông vào và hỏi những câu hỏi ngu ngốc khi tôi đang cố gắng làm việc.","rootVerb":"barge","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"bash in":{"definition":"đập vỡ; phá hỏng","example":"The burglars bashed the door in to enter the house.","exampleTranslation":"Những tên trộm đã đập vỡ cửa để vào nhà.","rootVerb":"bash","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"bash up":{"definition":"đánh đập dã man","example":"They bashed him up in the fight in the pub last week and he had to go to hospital.","exampleTranslation":"Họ đã đánh đập anh ấy dã man trong một vụ ẩu đả tại quán rượu tuần trước và anh ấy phải vào bệnh viện.","rootVerb":"bash","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"be after":{"definition":"tìm kiếm; truy lùng","example":"The police are after him because of the theft.","exampleTranslation":"Cảnh sát đang truy lùng anh ta vì vụ trộm.","rootVerb":"be","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"beat up":{"definition":"đánh đập tàn nhẫn","example":"The mugger beat him up and stole his wallet.","exampleTranslation":"Tên cướp đã đánh đập anh ta tàn nhẫn và lấy mất ví.","rootVerb":"beat","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"beef up":{"definition":"củng cố; làm mạnh thêm","example":"They need to beef up their security system now.","exampleTranslation":"Họ cần phải củng cố hệ thống an ninh của mình ngay bây giờ.","rootVerb":"beef","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"belt up":{"definition":"thắt dây an toàn","example":"I told the kids to belt up before I started the car.","exampleTranslation":"Tôi đã bảo bọn trẻ thắt dây an toàn trước khi tôi khởi động xe.","rootVerb":"belt","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"blaze away":{"definition":"bắn liên tục","example":"The shooters blazed away at the pheasants.","exampleTranslation":"Những tay súng đã bắn liên tục vào lũ gà lôi.","rootVerb":"blaze","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"board up":{"definition":"Che kín cửa sổ hoặc cửa ra vào bằng gỗ, kim loại...","example":"They boarded up all the windows to stop people getting into the empty houses.","exampleTranslation":"Họ đã che kín tất cả các cửa sổ bằng gỗ để ngăn mọi người đột nhập vào những ngôi nhà trống.","rootVerb":"board","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"break into":{"definition":"Đột nhập vào; hoặc thâm nhập thành công vào một ngành nghề.","example":"Burglar alarms sounded immediately when intruders tried to break into the gallery.","exampleTranslation":"Chuông báo động trộm vang lên ngay lập tức khi những kẻ đột nhập cố gắng lẻn vào phòng tranh.","rootVerb":"break","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"break out":{"definition":"Bùng nổ (chiến tranh, xung đột).","example":"They're worried that war will break out.","exampleTranslation":"Họ lo lắng rằng chiến tranh sẽ bùng nổ.","rootVerb":"break","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"break through":{"definition":"Vượt qua một rào cản.","example":"The crowd broke through the police barriers and attacked the hunters.","exampleTranslation":"Đám đông đã vượt qua hàng rào cảnh sát và tấn công những người thợ săn.","rootVerb":"break","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"bring down":{"definition":"Làm sụp đổ (chính phủ).","example":"The vote of no-confidence brought the government down.","exampleTranslation":"Cuộc bỏ phiếu bất tín nhiệm đã làm sụp đổ chính phủ.","rootVerb":"bring","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"buckle up":{"definition":"Thắt dây an toàn.","example":"We were told to buckle up before take-off.","exampleTranslation":"Chúng tôi được yêu cầu thắt dây an toàn trước khi cất cánh.","rootVerb":"buckle","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"bump off":{"definition":"Giết, thủ tiêu.","example":"The drug dealer was bumped off by a rival gang.","exampleTranslation":"Tên buôn ma túy đã bị một băng nhóm đối thủ thủ tiêu.","rootVerb":"bump","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"burn down":{"definition":"Thiêu rụi hoàn toàn.","example":"They had to completely rebuild the museum after the old one burned down.","exampleTranslation":"Họ đã phải xây dựng lại hoàn toàn bảo tàng sau khi bảo tàng cũ bị thiêu rụi.","rootVerb":"burn","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"burn up":{"definition":"Bị thiêu rụi hoàn toàn.","example":"All his possessions were burned up in the fire.","exampleTranslation":"Tất cả tài sản của anh ấy đều bị thiêu rụi hoàn toàn trong vụ hỏa hoạn.","rootVerb":"burn","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"cast out":{"definition":"Đuổi đi, tống cổ.","example":"They will cast out anyone who breaks the rules.","exampleTranslation":"Họ sẽ tống cổ bất cứ ai vi phạm các quy tắc.","rootVerb":"cast","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"charge with":{"definition":"Buộc tội.","example":"She was arrested in customs last night and has been charged with smuggling.","exampleTranslation":"Cô ấy đã bị bắt tại hải quan tối qua và bị buộc tội buôn lậu.","rootVerb":"charge","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"chase off":{"definition":"Đuổi đi.","example":"The dog chased he postal worker off.","exampleTranslation":"Con chó đã đuổi người đưa thư đi.","rootVerb":"chase","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"clamp down on":{"definition":"Kiểm soát chặt chẽ.","example":"The government are clamping down on antisocial behaviour.","exampleTranslation":"Chính phủ đang kiểm soát chặt chẽ các hành vi chống đối xã hội.","rootVerb":"clamp","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"cover up":{"definition":"Che đậy, giấu giếm.","example":"They tried to cover up the incident but it got into the newspapers.","exampleTranslation":"Họ đã cố gắng che đậy vụ việc nhưng nó đã xuất hiện trên các tờ báo.","rootVerb":"cover","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"crack down on":{"definition":"Trấn áp, đàn áp.","example":"The police always crack down on drink-driving offences over the Christmas period.","exampleTranslation":"Cảnh sát luôn trấn áp các vi phạm lái xe khi say rượu trong dịp Giáng sinh.","rootVerb":"crack","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"cut in":{"definition":"Đưa ai đó vào thỏa thuận.","example":"We had to cut the police in on the deal to avoid trouble.","exampleTranslation":"Chúng tôi đã phải đưa cảnh sát vào thỏa thuận để tránh rắc rối.","rootVerb":"cut","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"do away with":{"definition":"Bãi bỏ, loại bỏ.","example":"The United Kingdom did away with the death penalty in 1965.","exampleTranslation":"Vương quốc Anh đã bãi bỏ án tử hình vào năm 1965.","rootVerb":"do","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"duff up":{"definition":"Đánh nhừ tử.","example":"He was duffed up in a night club last night.","exampleTranslation":"Anh ta đã bị đánh nhừ tử trong một hộp đêm tối qua.","rootVerb":"duff","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fall under":{"definition":"Bị kiểm soát.","example":"At first he was independent, but then he fell under their influence.","exampleTranslation":"Lúc đầu anh ấy độc lập, nhưng sau đó anh ấy đã bị kiểm soát bởi ảnh hưởng của họ.","rootVerb":"fall","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"feel up":{"definition":"Sờ soạng, sàm sỡ.","example":"Someone felt me up in the club as I was trying to get to the bar.","exampleTranslation":"Ai đó đã sàm sỡ tôi trong câu lạc bộ khi tôi đang cố gắng đi đến quầy bar.","rootVerb":"feel","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fence in":{"definition":"Bao quanh một khu vực.","example":"They fenced the whole garden in.","exampleTranslation":"Họ đã bao quanh cả khu vườn.","rootVerb":"fence","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fence off":{"definition":"Bao quanh một khu vực để ngăn động vật hoặc người vào.","example":"They fenced off one side of the park to keep dogs out.","exampleTranslation":"Họ đã bao quanh một bên của công viên để ngăn chó vào.","rootVerb":"fence","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fend off":{"definition":"Chống lại điều gì đó thành công.","example":"He managed to fend off the criticism in the press.","exampleTranslation":"Anh ấy đã xoay xở để chống lại những lời chỉ trích từ báo giới.","rootVerb":"fend","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fess up to":{"definition":"Thú nhận, thừa nhận miễn cưỡng về điều gì đó.","example":"They fessed up to the crime.","exampleTranslation":"Họ đã thú nhận tội ác của mình.","rootVerb":"fess","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fight off":{"definition":"Đánh trả kẻ tấn công và buộc chúng lùi lại.","example":"The old lady managed to fight the muggers off and they didn't get her purse.","exampleTranslation":"Bà cụ đã xoay xở để đánh trả những tên cướp và chúng đã không lấy được ví của bà.","rootVerb":"fight","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"file for":{"definition":"Nộp đơn yêu cầu pháp lý, như ly hôn hoặc phá sản.","example":"They filed for divorce after two years of marriage.","exampleTranslation":"Họ đã nộp đơn ly hôn sau hai năm kết hôn.","rootVerb":"file","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"fool with":{"definition":"Chơi với một thứ nguy hiểm.","example":"Don't fool with that—it could explode.","exampleTranslation":"Đừng nghịch với thứ đó—nó có thể phát nổ.","rootVerb":"fool","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"frighten away":{"definition":"Làm ai đó sợ hãi từ bỏ ý định.","example":"The strikes frightened many visitors away.","exampleTranslation":"Các cuộc đình công đã làm nhiều du khách sợ hãi từ bỏ ý định.","rootVerb":"frighten","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"frighten off":{"definition":"Làm ai đó sợ hãi từ bỏ ý định.","example":"The crash in share prices frightened investors off.","exampleTranslation":"Việc giá cổ phiếu sụt giảm đã làm các nhà đầu tư sợ hãi từ bỏ ý định.","rootVerb":"frighten","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"front for":{"definition":"Làm bình phong, đại diện cho ai đó (thường là bao che cho hoạt động phi pháp).","example":"The solicitor fronts for a number of criminal gangs.","exampleTranslation":"Luật sư đó đứng ra làm bình phong cho một số băng nhóm tội phạm.","rootVerb":"front","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"frown on":{"definition":"Không tán thành, phản đối.","example":"He frowns on people making personal calls at work.","exampleTranslation":"Ông ấy không tán thành việc mọi người thực hiện các cuộc gọi cá nhân tại nơi làm việc.","rootVerb":"frown","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"get at":{"definition":"Mua chuộc, hăm dọa để tác động đến lời khai hoặc quyết định của ai đó.","example":"The gangsters got at the jury, who found them not guilty of all charges despite the evidence presented in court.","exampleTranslation":"Bọn xã hội đen đã mua chuộc bồi thẩm đoàn, những người đã tuyên bố chúng không có tội cho mọi cáo buộc bất chấp bằng chứng được đưa ra tại tòa.","rootVerb":"get","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"get away with":{"definition":"Thành công hoặc làm trót lọt việc gì đó dù không làm đúng cách.","example":"Do you think we could get away with using the cheaper product?","exampleTranslation":"Bạn có nghĩ rằng chúng ta có thể làm trót lọt việc sử dụng sản phẩm rẻ tiền hơn không?","rootVerb":"get","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"get up to":{"definition":"Giở trò nghịch ngợm.","example":"The children are always getting up to some trouble or other.","exampleTranslation":"Bọn trẻ luôn giở trò nghịch ngợm này nọ.","rootVerb":"get","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"give in":{"definition":"Đệ trình để phán xét, phê duyệt.","example":"They gave in their complaint to the court.","exampleTranslation":"Họ đã đệ trình đơn khiếu nại của mình lên tòa án.","rootVerb":"give","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"give off":{"definition":"Thải ra chất ô nhiễm hoặc mùi khó chịu.","example":"The police stopped the van because it was giving off a lot of black smoke.","exampleTranslation":"Cảnh sát đã chặn chiếc xe tải vì nó đang thải ra rất nhiều khói đen.","rootVerb":"give","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"go through":{"definition":"Được chấp thuận chính thức hoặc phê duyệt.","example":"My divorce went through last week.","exampleTranslation":"Vụ ly hôn của tôi đã được chấp thuận chính thức vào tuần trước.","rootVerb":"go","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"grass on":{"definition":"Tố giác ai đó.","example":"He grassed on us and got us into a lot of trouble.","exampleTranslation":"Hắn đã tố giác chúng tôi và khiến chúng tôi gặp rất nhiều rắc rối.","rootVerb":"grass","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"grass up":{"definition":"Tố giác ai đó.","example":"She didn't to grass them up, even though they'd been bullying her badly.","exampleTranslation":"Cô ấy đã không tố giác chúng, mặc dù chúng bắt nạt cô ấy rất tệ.","rootVerb":"grass","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"have to":{"definition":"Phải, có bổn phận phải, bắt buộc phải.","example":"We have to leave for the airport soon.","exampleTranslation":"Chúng tôi phải sớm khởi hành đến sân bay.","rootVerb":"have","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"have up":{"definition":"Đưa ai đó ra tòa.","example":"They had him up for armed robbery.","exampleTranslation":"Họ đã đưa hắn ra tòa vì tội cướp có vũ trang.","rootVerb":"have","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"hold down":{"definition":"Ngăn ai đó hoặc cái gì đó di chuyển.","example":"It took four of us to hold him down and stop the fight.","exampleTranslation":"Cần tới bốn người chúng tôi mới giữ được hắn lại và ngăn chặn vụ ẩu đả.","rootVerb":"hold","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"hold off":{"definition":"Ngăn chặn ai đó tấn công hoặc đánh đập bạn.","example":"Chelsea couldn't hold their opponents off and lost the game.","exampleTranslation":"Chelsea không thể ngăn chặn đối thủ của họ và đã thua trận.","rootVerb":"hold","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"hold out against":{"definition":"Cố gắng từ chối.","example":"The staff are holding out against the plans to reduce the workforce.","exampleTranslation":"Các nhân viên đang cố gắng từ chối các kế hoạch cắt giảm lực lượng lao động.","rootVerb":"hold","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"hunt down":{"definition":"Tìm kiếm ai đó để trừng phạt hoặc giết họ.","example":"The police hunted the killer down.","exampleTranslation":"Cảnh sát đã truy lùng tên sát nhân.","rootVerb":"hunt","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"hush up":{"definition":"Cố gắng giữ một điều gì đó tồi tệ không được biết đến rộng rãi.","example":"The company tried to hush up the scandal, but it still got into the newspapers.","exampleTranslation":"Công ty đã cố gắng che giấu vụ bê bối, nhưng nó vẫn bị đăng lên báo.","rootVerb":"hush","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"keep away":{"definition":"Không cho phép ai đó gần một cái gì đó.","example":"Medicines should always be kept away from children.","exampleTranslation":"Thuốc men cần luôn phải được để xa tầm tay trẻ em.","rootVerb":"keep","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"keep back":{"definition":"Giữ khoảng cách an toàn.","example":"The police told the crowd to keep back from the fire.","exampleTranslation":"Cảnh sát yêu cầu đám đông giữ khoảng cách an toàn với đám cháy.","rootVerb":"keep","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"keep out":{"definition":"Không cho phép ai đó vào.","example":"The police kept the demonstrators out of the building.","exampleTranslation":"Cảnh sát đã ngăn không cho những người biểu tình vào tòa nhà.","rootVerb":"keep","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"kick out":{"definition":"Đuổi ra, trục xuất.","example":"They had to kick out the rude guest immediately.","exampleTranslation":"Họ phải đuổi vị khách thô lỗ đó ra ngoài ngay lập tức.","rootVerb":"kick","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"kill off":{"definition":"Giảm thiểu hoặc tiêu diệt một quần thể do săn bắt, ô nhiễm, phát triển, v.v..","example":"There used to be a lot of wolves around here, but most of them have been killed off.","exampleTranslation":"Trước đây từng có rất nhiều sói quanh đây, nhưng hầu hết chúng đã bị tiêu diệt sạch.","rootVerb":"kill","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"knock about":{"definition":"Đánh ai đó.","example":"He knocked his brother about after they argued.","exampleTranslation":"Anh ta đã đánh đập em trai mình sau khi họ tranh cãi.","rootVerb":"knock","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"knock down":{"definition":"Tông và làm ai đó bị thương.","example":"The car knocked her down and she broke her arm.","exampleTranslation":"Chiếc xe đã tông cô ấy bị thương và cô ấy bị gãy tay.","rootVerb":"knock","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"lash down":{"definition":"Buộc chặt cái gì đó bằng dây thừng.","example":"We lashed the tarpaulin down to stop the wind blowing it away.","exampleTranslation":"Chúng tôi buộc chặt tấm bạt xuống để ngăn gió thổi bay nó.","rootVerb":"lash","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"lay down":{"definition":"Thiết lập các quy tắc hoặc thủ tục.","example":"The rules of the sport were laid down early in the nineteenth century.","exampleTranslation":"Các quy tắc của môn thể thao này đã được thiết lập từ đầu thế kỷ mười chín.","rootVerb":"lay","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"let off":{"definition":"Không trừng phạt.","example":"The judge let him off with a fine rather than a prison sentence since it was his first offence.","exampleTranslation":"Thẩm phán đã không trừng phạt hắn mà chỉ cho nộp tiền phạt thay vì án tù vì đó là lần phạm tội đầu tiên của hắn.","rootVerb":"let","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"let out":{"definition":"Cho phép rời đi hoặc ra ngoài.","example":"The convict was let out of prison after serving five years of an eight-year sentence.","exampleTranslation":"Phạm nhân đã được cho phép rời khỏi nhà tù sau khi chấp hành xong năm năm của bản án tám năm.","rootVerb":"let","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"lock away":{"definition":"Cất kỹ vào nơi an toàn.","example":"He locked the gun away in a drawer.","exampleTranslation":"Anh ấy cất kỹ khẩu súng vào trong ngăn kéo.","rootVerb":"lock","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"lock in":{"definition":"Khóa nhốt bên trong.","example":"They locked him in the room until he had calmed down.","exampleTranslation":"Họ nhốt hắn trong phòng cho đến khi hắn bình tĩnh lại.","rootVerb":"lock","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"look out":{"definition":"Cẩn thận.","example":"Look out; you're going to drop that!","exampleTranslation":"Cẩn thận đấy; bạn sắp đánh rơi cái đó rồi!","rootVerb":"look","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"look out for":{"definition":"Chăm sóc, trông chừng cho.","example":"She looked out for her sister when she started school.","exampleTranslation":"Cô ấy đã chăm sóc, trông chừng em gái mình khi em ấy bắt đầu đi học.","rootVerb":"look","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"make away with":{"definition":"Đánh cắp.","example":"The thieves made away with the painting.","exampleTranslation":"Những tên trộm đã đánh cắp bức tranh.","rootVerb":"make","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"make off with":{"definition":"Đánh cắp.","example":"Thieves made off with over a million dollars in the robbery.","exampleTranslation":"Những tên trộm đã đánh cắp hơn một triệu đô la trong vụ cướp.","rootVerb":"make","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"mete out":{"definition":"Đưa ra hình phạt khắc nghiệt.","example":"They meted out savage penalties to anyone who broke the law.","exampleTranslation":"Họ đã đưa ra các hình phạt khắc nghiệt đối với bất kỳ ai vi phạm pháp luật.","rootVerb":"mete","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"mop up":{"definition":"Tiêu diệt nốt quân địch còn sót lại.","example":"After the battle, it took them a couple of weeks to mop up the remaining rebels.","exampleTranslation":"Sau trận chiến, họ mất vài tuần để tiêu diệt nốt những quân phiến loạn còn sót lại.","rootVerb":"mop","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"opt out":{"definition":"Chọn không tham gia.","example":"The UK opted out of a lot of EU legislation on working hours and conditions.","exampleTranslation":"Vương quốc Anh đã chọn không tham gia rất nhiều luật lệ của EU về giờ làm việc và điều kiện làm việc.","rootVerb":"opt","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"pick off":{"definition":"Nhắm mục tiêu vào các cá nhân để thay đổi một nhóm.","example":"There were many rebels against the policy, but the government picked off the leaders.","exampleTranslation":"Có rất nhiều người phản đối chính sách, nhưng chính phủ đã nhắm mục tiêu vào các thủ lĩnh.","rootVerb":"pick","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"pin on":{"definition":"Đổ lỗi cho ai đó.","example":"The police tried to PIN the crime on him.","exampleTranslation":"Cảnh sát đã cố gắng đổ lỗi vụ tội ác đó cho hắn.","rootVerb":"pin","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"plead out":{"definition":"Nhận tội để được giảm án hoặc giảm tiền phạt.","example":"The CEO pleaded out and blamed the cfo for the fraud.","exampleTranslation":"Vị CEO đã nhận tội để được giảm án và đổ lỗi cho CFO về vụ gian lận.","rootVerb":"plead","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"pull in":{"definition":"Bắt giữ hoặc đưa ai đó về đồn cảnh sát để thẩm vấn.","example":"The police pulled them in after the trouble.","exampleTranslation":"Cảnh sát đã bắt giữ họ về đồn sau vụ rắc rối.","rootVerb":"pull","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"push in":{"definition":"Chen ngang hàng mà không chờ đợi.","example":"She just pushed in the queue in front of me at the supermarket checkout.","exampleTranslation":"Cô ấy vừa chen ngang hàng trước mặt tôi tại quầy thanh toán siêu thị.","rootVerb":"push","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"rope off":{"definition":"Kéo dài những sợi dây hoặc rào chắn ngang qua hoặc xung quanh một khu vực.","example":"The celebrity entrance was roped off from the general public.","exampleTranslation":"Lối vào dành cho người nổi tiếng đã được kéo rào chắn ngăn cách với công chúng.","rootVerb":"rope","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"rough up":{"definition":"Tấn công.","example":"The mugger roughed him up when he refused to hand his wallet over.","exampleTranslation":"Tên cướp đã tấn công hắn khi hắn từ chối đưa ví tiền.","rootVerb":"rough","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"run up on":{"definition":"Tiếp cận ai đó mà họ không biết.","example":"Robert was sitting in his car and a guy ran up on him and shot through the car but missed.","exampleTranslation":"Robert đang ngồi trong xe thì một gã tiếp cận anh ấy mà không hay biết và bắn xuyên qua xe nhưng trượt.","rootVerb":"run","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"scare away":{"definition":"Làm ai đó sợ hãi đến mức họ phải bỏ đi.","example":"The cat scared the birds away.","exampleTranslation":"Con mèo đã làm lũ chim sợ hãi mà bay đi mất.","rootVerb":"scare","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"send in":{"definition":"Ra lệnh cho mọi người vào một nơi để xử lý sự cố.","example":"The police were sent in to quell the riot as the protesters had started burning cars and wrecking shops.","exampleTranslation":"Cảnh sát đã được điều đến để dập tắt cuộc bạo loạn vì những người biểu tình đã bắt đầu đốt xe và đập phá cửa hàng.","rootVerb":"send","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"set aside":{"definition":"Lật ngược một phán quyết hoặc quyết định của tòa án.","example":"The Appeal Court set aside the guilty verdict because the evidence was unsatisfactory and declared her not guilty.","exampleTranslation":"Tòa phúc thẩm đã lật ngược phán quyết có tội vì bằng chứng không thỏa đáng và tuyên bố cô ấy vô tội.","rootVerb":"set","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"set on":{"definition":"Tấn công.","example":"He was set on when he left the bar.","exampleTranslation":"Anh ấy đã bị tấn công khi anh ấy rời khỏi quán bar.","rootVerb":"set","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"set upon":{"definition":"Tấn công.","example":"They set upon her when she was in the car park.","exampleTranslation":"Họ đã tấn công cô ấy khi cô ấy đang ở trong bãi đỗ xe.","rootVerb":"set","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"shake down":{"definition":"Tống tiền hoặc lừa gạt tiền của ai đó.","example":"He shook the guy down with some story about needing the money for an operation.","exampleTranslation":"Hắn đã tống tiền gã đó bằng một câu chuyện nào đó về việc cần tiền để phẫu thuật.","rootVerb":"shake","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"shut away":{"definition":"Bỏ tù hoặc tước đi tự do của ai đó.","example":"Many people have been shut away in psychiatric hospitals for disagreeing with the government.","exampleTranslation":"Nhiều người đã bị tống giam trong các bệnh viện tâm thần vì bất đồng quan điểm với chính phủ.","rootVerb":"shut","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"shut off":{"definition":"Tắt, ngăn chặn truy cập.","example":"They shut the water off while they did the repairs.","exampleTranslation":"Họ đã ngắt nước trong khi họ tiến hành sửa chữa.","rootVerb":"shut","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"sit in":{"definition":"Chiếm giữ một tòa nhà để phản đối.","example":"The students sat in the Library as a protest against the increase in tuition fees.","exampleTranslation":"Các sinh viên đã chiếm giữ thư viện như một cuộc phản đối việc tăng học phí.","rootVerb":"sit","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"smash down":{"definition":"Phá hủy hoặc đập vỡ cái gì đó.","example":"The police smashed the door down to get into the house.","exampleTranslation":"Cảnh sát đã phá cửa để xông vào nhà.","rootVerb":"smash","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"smoke out":{"definition":"Buộc ai đó phải rời khỏi nơi họ đang trốn.","example":"The police smoked the gang out and arrested them.","exampleTranslation":"Cảnh sát đã buộc băng đảng phải lộ diện và bắt giữ chúng.","rootVerb":"smoke","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"snuff out":{"definition":"Dập tắt một ngọn lửa nhỏ bằng cách che nó lại.","example":"I snuffed out the candles before I went to bed.","exampleTranslation":"Tôi đã dập tắt những cây nến trước khi đi ngủ.","rootVerb":"snuff","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"spirit away":{"definition":"Bí mật đưa ai đó ra khỏi một nơi.","example":"They spirited her away before the police arrived.","exampleTranslation":"Họ đã bí mật đưa cô ấy ra khỏi nơi đó trước khi cảnh sát đến.","rootVerb":"spirit","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"square off":{"definition":"Đối đầu hoặc chuẩn bị đánh nhau.","example":"The two drunks squared off and the barman had to intervene before a fight broke out.","exampleTranslation":"Hai gã say rượu đã đối đầu nhau và nhân viên quán bar phải can thiệp trước khi một cuộc ẩu đả nổ ra.","rootVerb":"square","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"square off against":{"definition":"Đối đầu với ai đó hoặc chuẩn bị đánh nhau với họ.","example":"They squared off against the police when they arrived.","exampleTranslation":"Họ đã đối đầu với cảnh sát khi cảnh sát đến.","rootVerb":"square","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"square up":{"definition":"Đối đầu hoặc chuẩn bị đánh nhau.","example":"The companies are squaring up for a fight.","exampleTranslation":"Các công ty đang chuẩn bị đối đầu cho một cuộc chiến.","rootVerb":"square","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"stamp out":{"definition":"Loại bỏ điều gì đó.","example":"The government has started a campaign to stamp out drugs in schools.","exampleTranslation":"Chính phủ đã bắt đầu một chiến dịch nhằm loại bỏ ma túy trong trường học.","rootVerb":"stamp","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"stand by":{"definition":"Sẵn sàng và chờ đợi điều gì đó xảy ra.","example":"Please stand by until the doctor arrives soon.","exampleTranslation":"Xin hãy sẵn sàng chờ đợi cho đến khi bác sĩ đến sớm.","rootVerb":"stand","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"stay away":{"definition":"Không đến.","example":"He said he didn't like them coming and wanted them to stay away.","exampleTranslation":"Anh ấy nói rằng anh ấy không thích họ đến và muốn họ không nên lại gần.","rootVerb":"stay","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"stay away from":{"definition":"Tránh, không đến.","example":"He told them to stay away from him.","exampleTranslation":"Anh ấy bảo họ hãy tránh xa anh ấy ra.","rootVerb":"stay","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"stick up":{"definition":"Dùng vũ khí để cướp.","example":"They stuck the bank up and stole tens of thousands.","exampleTranslation":"Chúng đã dùng vũ khí cướp ngân hàng và lấy đi hàng chục ngàn.","rootVerb":"stick","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"stitch up":{"definition":"Lừa gạt ai đó hoặc làm cho họ có vẻ có tội khi họ không có.","example":"The police stitched them up because they couldn't find any evidence against them.","exampleTranslation":"Cảnh sát đã gài bẫy họ vì họ không thể tìm thấy bất kỳ bằng chứng nào buộc tội họ.","rootVerb":"stitch","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"strike back":{"definition":"Tấn công, hành động chống lại người đã làm tổn thương bạn.","example":"At first, he ignored them, but when things got very serious, he struck back.","exampleTranslation":"Lúc đầu, anh ấy phớt lờ họ, nhưng khi mọi thứ trở nên rất nghiêm trọng, anh ấy đã phản công.","rootVerb":"strike","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"strike down":{"definition":"Bác bỏ một đạo luật, quyết định, v.v.","example":"The Appeal Court struck down the lower court's ruling.","exampleTranslation":"Tòa phúc thẩm đã bác bỏ phán quyết của tòa cấp dưới.","rootVerb":"strike","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"take away":{"definition":"Đưa ai đó đi khỏi nơi đó.","example":"The police took the protestors away.","exampleTranslation":"Cảnh sát đã giải người biểu tình đi.","rootVerb":"take","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"tie down":{"definition":"Ngăn cản mọi người (thường là cảnh sát hoặc quân đội) đi đến nơi họ cần.","example":"The army were tied down with the rebellion and couldn't help.","exampleTranslation":"Quân đội đã bị cầm chân bởi cuộc nổi loạn và không thể giúp đỡ.","rootVerb":"tie","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"tie up":{"definition":"Buộc hoặc thắt chặt thứ gì đó.","example":"They tied up the hostages so that they couldn't escape.","exampleTranslation":"Họ đã trói các con tin lại để họ không thể trốn thoát.","rootVerb":"tie","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"tighten up":{"definition":"Làm cho một cái gì đó an toàn hơn hoặc hoạt động tốt hơn.","example":"They're tightening up security for the president's visit.","exampleTranslation":"Họ đang thắt chặt an ninh cho chuyến thăm của tổng thống.","rootVerb":"tighten","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"tool up":{"definition":"Trang bị vũ khí cho bản thân hoặc ai đó.","example":"The gangsters got tooled up before they went into the club.","exampleTranslation":"Bọn găng-xtơ đã trang bị vũ khí cho bản thân trước khi chúng đi vào câu lạc bộ.","rootVerb":"tool","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"trump up":{"definition":"Buộc tội hoặc kết án sai trái ai đó.","example":"The police trumped up the charges against him and he ended up in prison though he hadn't done it.","exampleTranslation":"Cảnh sát đã ngụy tạo các cáo buộc chống lại anh ấy và anh ấy đã phải ngồi tù mặc dù anh ấy không làm điều đó.","rootVerb":"trump","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"walk in on":{"definition":"Bước vào đâu đó một cách bất ngờ và nhìn thấy thứ gì đó.","example":"He walked in on them planning to sack him.","exampleTranslation":"Anh ấy đã vô tình bước vào đúng lúc họ đang lập kế hoạch sa thải anh ấy.","rootVerb":"walk","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"walk into":{"definition":"Không nhận thức được sự hiện diện của điều gì đó và rơi vào (cạm bẫy) hoặc đâm sầm vào (chướng ngại vật).","example":"You walked into that one [You became victim to a trap I set]orI walked into a door and broke my nose.","exampleTranslation":"Bạn đã dính bẫy rồi hoặc Tôi đã đâm sầm vào cửa và làm gãy mũi.","rootVerb":"walk","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"watch out":{"definition":"Cẩn thận.","example":"Watch out- there's ice on the road.","exampleTranslation":"Cẩn thận đấy- có băng trên đường.","rootVerb":"watch","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"watch out for":{"definition":"Cẩn thận với cái gì đó.","example":"Watch out for bats in the caves; many have rabies.","exampleTranslation":"Hãy cẩn thận với dơi trong các hang động; nhiều con bị dại đấy.","rootVerb":"watch","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"watch over":{"definition":"Trông coi, canh chừng cái gì đó hoặc ai đó.","example":"The lecturer watched over the students as they did the experiment.","exampleTranslation":"Giảng viên đã trông chừng các sinh viên khi họ làm thí nghiệm.","rootVerb":"watch","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"wipe out":{"definition":"Giết toàn bộ một quần thể, làm tuyệt chủng.","example":"A meteor crashing into the planet wiped the dinosaurs out.","exampleTranslation":"Một thiên thạch rơi xuống hành tinh đã làm tuyệt chủng loài khủng long.","rootVerb":"wipe","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"work over":{"definition":"Tấn công, đánh đập.","example":"They worked him over and robbed him.","exampleTranslation":"Chúng đã đánh đập anh ấy và cướp tài sản của anh ấy.","rootVerb":"work","topicId":"rules-safety","topicTitle":"Quy tắc và an toàn","partOfSpeech":"V","dictionarySource":"offline"},"act up":{"definition":"giở chứng; hoạt động không bình thường","example":"My computer's acting up; I think I might have a virus.","exampleTranslation":"Máy tính của tôi đang giở chứng; có lẽ nó bị nhiễm virus rồi.","rootVerb":"act","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"back up":{"definition":"sao lưu dữ liệu","example":"You should back up your files every week.","exampleTranslation":"Bạn nên sao lưu các tập tin của mình mỗi tuần.","rootVerb":"back","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"boot up":{"definition":"Khởi động máy tính.","example":"He booted up the computer and started work.","exampleTranslation":"Anh ấy khởi động máy tính và bắt đầu làm việc.","rootVerb":"boot","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"charge up":{"definition":"Sạc pin.","example":"I need to charge my phone up- the battery's dead.","exampleTranslation":"Tôi cần sạc điện thoại - pin chết rồi.","rootVerb":"charge","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"chew up":{"definition":"Làm hỏng (bên trong máy).","example":"The video chewed my tape up.","exampleTranslation":"Đầu đĩa đã làm hỏng băng của tôi.","rootVerb":"chew","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"click through":{"definition":"Nhấp vào quảng cáo trên mạng.","example":"Only a tiny fraction of users ever bother clicking through the banner adverts.","exampleTranslation":"Chỉ một phần rất nhỏ người dùng bận tâm nhấp vào các quảng cáo biểu ngữ.","rootVerb":"click","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"come on":{"definition":"Bắt đầu hoạt động (máy móc, v.v.).","example":"The central heating comes on automatically an hour before I have to get up.","exampleTranslation":"Hệ thống sưởi trung tâm tự động bật một giờ trước khi tôi phải thức dậy.","rootVerb":"come","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"conk out":{"definition":"Đột ngột hỏng hoặc ngừng hoạt động.","example":"The printer conked out so I couldn't get a hard copy.","exampleTranslation":"Máy in bị hỏng đột ngột nên tôi không thể lấy bản in cứng.","rootVerb":"conk","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"crack up":{"definition":"Bị mất sóng (điện thoại).","example":"You'll have to talk louder- you're cracking up.","exampleTranslation":"Bạn sẽ phải nói to hơn - điện thoại của bạn đang bị mất sóng đấy.","rootVerb":"crack","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"crank up":{"definition":"Tăng lên, làm to hơn.","example":"I cranked the volume up as high as it would go.","exampleTranslation":"Tôi đã vặn âm lượng to hết mức có thể.","rootVerb":"crank","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"creep out on":{"definition":"Làm cùng một việc trong một thời gian rất dài.","example":"He's been creeping out on that computer game all day.","exampleTranslation":"Anh ấy đã chơi trò chơi máy tính đó suốt cả ngày.","rootVerb":"creep","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"drill down":{"definition":"Đào sâu tìm kiếm thông tin (trên máy tính).","example":"I really had to drill down to get the answers from the database.","exampleTranslation":"Tôi thực sự phải đào sâu tìm kiếm để có được câu trả lời từ cơ sở dữ liệu.","rootVerb":"drill","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"eat up":{"definition":"Ngốn mất thứ bạn không muốn bị","example":"The heavy software will eat up your memory.","exampleTranslation":"Phần mềm nặng sẽ ngốn hết bộ nhớ của bạn.","rootVerb":"eat","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"flick over":{"definition":"Chuyển kênh truyền hình nhanh chóng.","example":"She flicked over to see if the news had started.","exampleTranslation":"Cô ấy chuyển kênh nhanh để xem bản tin đã bắt đầu chưa.","rootVerb":"flick","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"flick through":{"definition":"Chuyển kênh truyền hình liên tục.","example":"I flicked through the channels to see if there was anything worth watching.","exampleTranslation":"Tôi lướt nhanh các kênh để xem có gì đáng xem không.","rootVerb":"flick","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"freeze up":{"definition":"Ngừng hoạt động do các bộ phận máy móc bị kẹt.","example":"The gears had frozen up.","exampleTranslation":"Các bánh răng đã bị kẹt cứng.","rootVerb":"freeze","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"geek out":{"definition":"Nói say sưa về công nghệ, máy tính.","example":"Henry always geeks out at parties and bores all the people who don't know much about computers.","exampleTranslation":"Henry luôn nói say sưa về máy tính tại các bữa tiệc và làm những người không biết nhiều về máy tính thấy chán.","rootVerb":"geek","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"give out":{"definition":"Hỏng hóc (do cũ hoặc dùng nhiều).","example":"I'd been having trouble with my laptop and it finally gave out at the weekend.","exampleTranslation":"Tôi đã gặp trục trặc với chiếc máy tính xách tay của mình và cuối cùng nó cũng hỏng vào cuối tuần.","rootVerb":"give","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"go off":{"definition":"Ngừng hoạt động (thiết bị điện/điện tử).","example":"The lights go off automatically when the office is empty.","exampleTranslation":"Đèn tự động tắt khi văn phòng trống.","rootVerb":"go","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"go on":{"definition":"Bắt đầu hoạt động (thiết bị điện/điện tử).","example":"The alarm goes on when you close the front door.","exampleTranslation":"Chuông báo thức tự bật khi bạn đóng cửa trước.","rootVerb":"go","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"grey out":{"definition":"Làm mờ để vô hiệu hóa một chức năng trong chương trình máy tính.","example":"They decided to grey out the inactive buttons.","exampleTranslation":"Họ đã quyết định làm mờ các nút không hoạt động.","rootVerb":"grey","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"hack into":{"definition":"Xâm nhập vào hệ thống máy tính.","example":"He hacked into the government database and stole a lot of data.","exampleTranslation":"Anh ta đã xâm nhập vào cơ sở dữ liệu của chính phủ và đánh cắp rất nhiều dữ liệu.","rootVerb":"hack","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"hook up to":{"definition":"Kết nối với máy móc.","example":"He's hooked up to a ventilator in the hospital.","exampleTranslation":"Anh ấy đang được kết nối với máy thở trong bệnh viện.","rootVerb":"hook","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"juice up":{"definition":"Làm cho một cái gì đó thú vị hơn hoặc thực hiện tốt hơn.","example":"I need to buy some memory to juice my computer up.","exampleTranslation":"Tôi cần mua thêm bộ nhớ để nâng cấp máy tính của mình.","rootVerb":"juice","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"key in":{"definition":"Nhập số hoặc thông tin vào máy tính hoặc hệ thống điện tử.","example":"It took me ages to key in all the information into the database.","exampleTranslation":"Tôi mất rất nhiều thời gian để nhập tất cả thông tin vào cơ sở dữ liệu.","rootVerb":"key","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"leave on":{"definition":"Không tắt.","example":"Leave the TV on; I want to hear the football results.","exampleTranslation":"Cứ để ti vi bật đó; tôi muốn nghe kết quả bóng đá.","rootVerb":"leave","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"link up":{"definition":"Kết nối, nối lại.","example":"The train links up the cities.","exampleTranslation":"Tàu hỏa kết nối các thành phố lại với nhau.","rootVerb":"link","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"lock down":{"definition":"Khóa chặt, bảo mật.","example":"If you lock down your computer properly, it is very difficult for people to access it.","exampleTranslation":"Nếu bạn bảo mật máy tính của mình đúng cách, sẽ rất khó để người khác truy cập vào nó.","rootVerb":"lock","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"lock onto":{"definition":"Khóa mục tiêu.","example":"The missile locked onto the plane and blew it out of the sky.","exampleTranslation":"Tên lửa đã khóa mục tiêu vào chiếc máy bay và thổi bay nó khỏi bầu trời.","rootVerb":"lock","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"log in":{"definition":"Đăng nhập.","example":"I had forgotten my password and couldn't log in.","exampleTranslation":"Tôi đã quên mật khẩu của mình và không thể đăng nhập.","rootVerb":"log","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"mash up":{"definition":"Trộn các nguồn âm thanh, video.","example":"She mashed up the songs into a single track.","exampleTranslation":"Cô ấy đã trộn các bài hát lại thành một bản nhạc duy nhất.","rootVerb":"mash","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"mix up":{"definition":"Làm cho sống động.","example":"The dj mixed up the night with some hard techno.","exampleTranslation":"DJ đã làm đêm nhạc thêm sống động bằng một chút nhạc techno mạnh.","rootVerb":"mix","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"move away from":{"definition":"Ngừng làm việc gì để chuyển sang thứ khác.","example":"They're moving away from Windows and are using Linux.","exampleTranslation":"Họ đang dần từ bỏ Windows và chuyển sang sử dụng Linux.","rootVerb":"move","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"opt in":{"definition":"Chọn tham gia.","example":"If you want them to notify you of updates, you have to opt in.","exampleTranslation":"Nếu bạn muốn họ thông báo các bản cập nhật cho bạn, bạn phải chọn tham gia.","rootVerb":"opt","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"opt into":{"definition":"Chọn tham gia vào.","example":"I opted into the scheme.","exampleTranslation":"Tôi đã chọn tham gia vào chương trình đó.","rootVerb":"opt","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"play back":{"definition":"Nghe hoặc xem lại thứ bạn đã ghi âm/ghi hình.","example":"We played the recording back to see if it was OK.","exampleTranslation":"Chúng tôi đã phát lại bản ghi âm để xem nó có ổn không.","rootVerb":"play","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"play out":{"definition":"Giả vờ điều gì đó là thật và làm giảm tác động của nó.","example":"Computer games allow people to play out their violent urges.","exampleTranslation":"Trò chơi máy tính cho phép mọi người thể hiện các thôi thúc bạo lực của họ.","rootVerb":"play","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"power down":{"definition":"Ngắt nguồn điện của máy tính hoặc thiết bị điện tử.","example":"I powered down my computer and went for lunch.","exampleTranslation":"Tôi đã tắt máy tính của mình và đi ăn trưa.","rootVerb":"power","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"power off":{"definition":"Ngắt điện máy tính hoặc thiết bị để tắt nó.","example":"You mustn't power it off while it is updating.","exampleTranslation":"Bạn không được phép ngắt điện nó trong khi nó đang cập nhật.","rootVerb":"power","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"power up":{"definition":"Bật máy tính hoặc thiết bị điện tử lên để sẵn sàng sử dụng.","example":"I powered up my laptop and started work.","exampleTranslation":"Tôi đã bật máy tính xách tay của mình lên và bắt đầu làm việc.","rootVerb":"power","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"print out":{"definition":"In một bản sao từ tài liệu máy tính.","example":"He printed out the letter and checked through it carefully.","exampleTranslation":"Anh ấy đã in lá thư ra và kiểm tra kỹ lưỡng.","rootVerb":"print","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"put in":{"definition":"Cài đặt","example":"They had to put in a whole new central heating system because the house was so cold.","exampleTranslation":"Họ phải lắp đặt một hệ thống sưởi trung tâm hoàn toàn mới vì ngôi nhà quá lạnh.","rootVerb":"put","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"put through":{"definition":"Kết nối điện thoại cho ai.","example":"Could you put me through to extension 259 please.","exampleTranslation":"Bạn có thể nối máy cho tôi đến số máy lẻ 259 được không.","rootVerb":"put","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"run on":{"definition":"Được cung cấp năng lượng bởi.","example":"The van runs on diesel.","exampleTranslation":"Chiếc xe tải chạy bằng dầu diesel.","rootVerb":"run","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"scroll down":{"definition":"Cuộn trang xuống, lướt màn hình xuống dưới.","example":"Scroll down to the bottom of the webpage to see the contact details.","exampleTranslation":"Cuộn trang xuống cuối trang web để xem thông tin liên hệ.","rootVerb":"scroll","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"short out":{"definition":"Chập mạch.","example":"The battery shorted out when it got wet.","exampleTranslation":"Pin đã bị chập mạch khi nó bị ướt.","rootVerb":"short","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"shut in":{"definition":"Ngăn không cho ai đó rời đi.","example":"I shut the cat in until it was time to go to the vet.","exampleTranslation":"Tôi nhốt con mèo trong nhà cho đến lúc đưa nó đến bác sĩ thú y.","rootVerb":"shut","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"sign in":{"definition":"Ký tên khi vào một nơi nào đó.","example":"You have to sign in before you can enter the club.","exampleTranslation":"Bạn phải ký tên khi vào câu lạc bộ.","rootVerb":"sign","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"sign into":{"definition":"Đăng nhập vào một chương trình cụ thể.","example":"I sign into msn Messenger automatically when I boot up.","exampleTranslation":"Tôi tự động đăng nhập vào msn Messenger khi khởi động máy.","rootVerb":"sign","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"sign out":{"definition":"Ký tên xác nhận mượn.","example":"Could you sign those books out, please?","exampleTranslation":"Bạn vui lòng ký tên xác nhận mượn những cuốn sách đó được không?","rootVerb":"sign","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"switch off":{"definition":"Tắt (công tắc điện, thiết bị điện); buông bỏ lo âu để thư giãn.","example":"Remember to switch off your computer before leaving the office.","exampleTranslation":"Hãy nhớ tắt máy tính của bạn trước khi rời văn phòng.","rootVerb":"switch","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"switch on":{"definition":"Bật (công tắc điện, thiết bị điện).","example":"Please switch on the light; it is getting dark in here.","exampleTranslation":"Làm ơn bật đèn lên; trong này trời đang tối dần rồi.","rootVerb":"switch","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"time out":{"definition":"Kết thúc hoặc đóng một cái gì đó vì giới hạn thời gian.","example":"The program timed me out after twenty minutes.","exampleTranslation":"Chương trình đã tự động ngắt kết nối của tôi sau hai mươi phút.","rootVerb":"time","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"tune in":{"definition":"Xem hoặc nghe một chương trình truyền hình hoặc đài phát thanh.","example":"Be sure to tune in next week for the next episode.","exampleTranslation":"Hãy chắc chắn rằng bạn sẽ đón xem tập tiếp theo vào tuần tới.","rootVerb":"tune","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"tune in to":{"definition":"Xem hoặc nghe một chương trình truyền hình hoặc đài phát thanh.","example":"Make sure you tune in to next week's show.","exampleTranslation":"Hãy chắc chắn rằng bạn đón xem chương trình vào tuần tới.","rootVerb":"tune","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"tune up":{"definition":"Cải thiện hiệu suất của máy hoặc động cơ.","example":"He's tuned his car up for the race.","exampleTranslation":"Anh ấy đã cải thiện hiệu suất xe hơi của mình để chuẩn bị cho cuộc đua.","rootVerb":"tune","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"type in":{"definition":"Nhập dữ liệu hoặc văn bản vào máy tính.","example":"He typed the text in and printed it off.","exampleTranslation":"Anh ấy đã nhập văn bản vào máy rồi in nó ra.","rootVerb":"type","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"type out":{"definition":"Viết bản đầy đủ hoặc hoàn chỉnh của một văn bản trên máy tính.","example":"She typed her essay out and handed it in a the last minute.","exampleTranslation":"Cô ấy đã đánh máy hoàn chỉnh bài tiểu luận của mình và nộp nó vào phút cuối.","rootVerb":"type","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"type up":{"definition":"Đánh máy một bản hoàn chỉnh.","example":"She typed up her lecture notes and printed them out.","exampleTranslation":"Cô ấy đã đánh máy hoàn chỉnh các ghi chép bài giảng của mình rồi in chúng ra.","rootVerb":"type","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"white out":{"definition":"Sử dụng bút xóa để che một lỗi trong văn bản.","example":"Could you pass the Tippex? I need to white this mistake out.","exampleTranslation":"Bạn có thể đưa tôi bút xóa không? Tôi cần xóa lỗi này đi.","rootVerb":"white","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"wire up":{"definition":"Kết nối điện.","example":"She wired her new stereo system up as soon as she got home.","exampleTranslation":"Cô ấy đã đấu nối hệ thống dàn âm thanh nổi mới của mình ngay khi về đến nhà.","rootVerb":"wire","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"zoom in":{"definition":"Phóng to, tập trung gần hơn.","example":"The camera zoomed in to show people's faces.","exampleTranslation":"Máy ảnh đã phóng to để hiển thị khuôn mặt của mọi người.","rootVerb":"zoom","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"zoom in on":{"definition":"Phóng to, tập trung gần hơn.","example":"The camera zoomed in on his face.","exampleTranslation":"Máy ảnh đã phóng to vào khuôn mặt của anh ấy.","rootVerb":"zoom","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"zoom out":{"definition":"Thu nhỏ lại.","example":"The camera zoomed out to show all the crowd.","exampleTranslation":"Máy ảnh đã thu nhỏ lại để hiển thị toàn bộ đám đông.","rootVerb":"zoom","topicId":"technology","topicTitle":"Công nghệ và thiết bị","partOfSpeech":"V","dictionarySource":"offline"},"back away":{"definition":"lùi lại; lảng tránh","example":"The crowd backed away when the man pulled a knife.","exampleTranslation":"Đám đông lùi lại khi người đàn ông rút dao ra.","rootVerb":"back","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"back into":{"definition":"lùi xe vào","example":"He prefers to back his car into the garage.","exampleTranslation":"Anh ấy thích lùi xe vào trong gara hơn.","rootVerb":"back","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"barge into":{"definition":"xông vào (phòng); ngắt lời (một cách thô lỗ)","example":"They barged into my office without knocking and started talking even though I was on the phone.","exampleTranslation":"Họ xông vào văn phòng của tôi mà không gõ cửa và bắt đầu nói chuyện mặc dù tôi đang nghe điện thoại.","rootVerb":"barge","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"be along":{"definition":"đến; xuất hiện","example":"The next bus should be along in the next quarter of an hour or so.","exampleTranslation":"Chuyến xe buýt tiếp theo sẽ đến trong khoảng mười lăm phút tới.","rootVerb":"be","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"be out":{"definition":"đi vắng","example":"She is out on a visit for the day.","exampleTranslation":"Cô ấy đi vắng cả ngày nay.","rootVerb":"be","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"beat down":{"definition":"nắng chói chang","example":"The sun was really beating down and we couldn't stay outdoors.","exampleTranslation":"Mặt trời nắng chói chang đến mức chúng tôi không thể ở ngoài trời được.","rootVerb":"beat","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"bend down":{"definition":"cúi người xuống","example":"I bent down to pick it up off the floor.","exampleTranslation":"Tôi cúi người xuống để nhặt nó lên từ sàn nhà.","rootVerb":"bend","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"bend over":{"definition":"cúi gập người","example":"I bent over to do my shoes up.","exampleTranslation":"Tôi cúi gập người xuống để buộc dây giày.","rootVerb":"bend","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"blast off":{"definition":"phóng lên (tàu vũ trụ)","example":"The space shuttle blasted off on schedule yesterday.","exampleTranslation":"Tàu vũ trụ đã phóng lên đúng theo lịch trình ngày hôm qua.","rootVerb":"blast","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"block off":{"definition":"chặn lối ra","example":"The police blocked off the road after the murder.","exampleTranslation":"Cảnh sát đã chặn lối ra của con đường sau vụ giết người.","rootVerb":"block","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"blow down":{"definition":"Khi gió làm thứ gì đó đổ ngã.","example":"A tree was blown down in the storm.","exampleTranslation":"Một cái cây đã bị gió thổi đổ trong cơn bão.","rootVerb":"blow","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"blow in":{"definition":"Đến, thường là bất ngờ.","example":"He blew in from Toronto early this morning.","exampleTranslation":"Anh ấy đã đến từ Toronto vào sáng sớm nay.","rootVerb":"blow","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"book in":{"definition":"Nhận phòng khách sạn.","example":"We took a taxi from the airport to the hotel and booked in.","exampleTranslation":"Chúng tôi bắt taxi từ sân bay đến khách sạn và làm thủ tục nhận phòng.","rootVerb":"book","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"book into":{"definition":"Nhận phòng khách sạn.","example":"We booked into the first hotel we could find.","exampleTranslation":"Chúng tôi đã nhận phòng khách sạn đầu tiên mà chúng tôi tìm thấy.","rootVerb":"book","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"book out":{"definition":"Rời khỏi đâu đó một cách vội vã.","example":"I don't like the look of the people arriving- let's book out.","exampleTranslation":"Tôi không thích vẻ ngoài của những người đang đến - hãy cùng rời đi nhanh thôi.","rootVerb":"book","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"book up":{"definition":"Đặt hết chỗ.","example":"The flight's fully booked up; I'll have to go the following day.","exampleTranslation":"Chuyến bay đã kín chỗ; tôi sẽ phải đi vào ngày hôm sau.","rootVerb":"book","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"border on":{"definition":"Tiếp giáp với một nơi.","example":"Does Portugal border on the country of Spain?","exampleTranslation":"Bồ Đào Nha có tiếp giáp với Tây Ban Nha không?","rootVerb":"border","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"box in":{"definition":"Ngăn cản sự di chuyển (đặc biệt là xe cộ).","example":"I was boxed in by the bus and couldn't change lane.","exampleTranslation":"Tôi đã bị chiếc xe buýt chặn lối di chuyển và không thể chuyển làn.","rootVerb":"box","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"box up":{"definition":"Đóng gói đồ vào hộp để di chuyển.","example":"At the end of term, I boxed my books up and sent them home.","exampleTranslation":"Vào cuối học kỳ, tôi đã đóng gói những cuốn sách của mình vào hộp và gửi chúng về nhà.","rootVerb":"box","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"break away":{"definition":"Tách ra khỏi một tổ chức.","example":"The sdp broke away from the Labour Party.","exampleTranslation":"Đảng sdp đã tách ra khỏi Đảng Lao động.","rootVerb":"break","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"break in":{"definition":"Chạy rà (xe, đồ mới).","example":"I must watch my speed until I break in my new Volvo.","exampleTranslation":"Tôi phải chú ý tốc độ của mình cho đến khi chạy rà xong chiếc Volvo mới.","rootVerb":"break","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"breeze along":{"definition":"Di chuyển dễ dàng và nhanh chóng.","example":"The film breezes along for the first hour, then becomes rather dull and slow.","exampleTranslation":"Bộ phim diễn ra dễ dàng và nhanh chóng trong giờ đầu tiên, sau đó trở nên khá nhàm chán và chậm chạp.","rootVerb":"breeze","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"breeze in":{"definition":"Bước vào một cách nhanh chóng/tự tin.","example":"He breezed in and started shouting at us.","exampleTranslation":"Anh ấy bước vào một cách nhanh nhẹn và bắt đầu quát tháo chúng tôi.","rootVerb":"breeze","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"breeze into":{"definition":"Bước vào một nơi một cách nhanh chóng.","example":"He breezed into the room and switched the TV on.","exampleTranslation":"Anh ấy bước nhanh vào phòng và bật tivi lên.","rootVerb":"breeze","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"bring along":{"definition":"Mang theo (ai đó/vật gì đó).","example":"You can bring your friends along if you like.","exampleTranslation":"Bạn có thể mang theo bạn bè của mình nếu bạn muốn.","rootVerb":"bring","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"budge up":{"definition":"Nhích sang một bên để nhường chỗ.","example":"We had to budge up to let the fourth person in the back of the car.","exampleTranslation":"Chúng tôi đã phải nhích sang một bên để cho người thứ tư ngồi vào hàng ghế sau của xe hơi.","rootVerb":"budge","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"bundle off":{"definition":"Gửi ai đó đi đâu đó.","example":"He bundled the kids off to bed.","exampleTranslation":"Anh ấy giục lũ trẻ đi ngủ nhanh.","rootVerb":"bundle","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"bundle out":{"definition":"Đuổi ra ngoài.","example":"The barman bundled the drunk out because he was annoying the other customers.","exampleTranslation":"Người phục vụ quầy bar đã đuổi gã say rượu ra ngoài vì hắn làm phiền những khách hàng khác.","rootVerb":"bundle","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"burst into":{"definition":"Đột nhiên bốc cháy.","example":"The dry wood will burst into flames quickly.","exampleTranslation":"Đống gỗ khô sẽ nhanh chóng bốc cháy.","rootVerb":"burst","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"buzz around":{"definition":"Di chuyển nhanh quanh một nơi.","example":"Reporters were buzzing around the scene of the accident.","exampleTranslation":"Các phóng viên đang di chuyển nhanh quanh hiện trường vụ tai nạn.","rootVerb":"buzz","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"buzz off":{"definition":"Rời đi.","example":"I'm buzzing off now- I have to meet some people.","exampleTranslation":"Tôi phải đi ngay bây giờ đây - tôi có cuộc hẹn với vài người.","rootVerb":"buzz","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"call around":{"definition":"Ghé thăm.","example":"I called around but she wasn't in.","exampleTranslation":"Tôi đã ghé qua nhưng cô ấy không có nhà.","rootVerb":"call","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"call for":{"definition":"Gọi điện thoại yêu cầu.","example":"I'll call for a cab right away.","exampleTranslation":"Tôi sẽ gọi taxi ngay lập tức.","rootVerb":"call","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"cart off":{"definition":"Mang đi (đặc biệt là ăn cắp hoặc không được phép).","example":"The thieves carted off all the ticket receipts.","exampleTranslation":"Những tên trộm đã mang đi hết tất cả biên lai vé.","rootVerb":"cart","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"carve up":{"definition":"Vượt lên và tạt đầu xe khác.","example":"The idiot carved us up and forced me to brake hard.","exampleTranslation":"Gã ngốc đó đã vượt lên và tạt đầu xe chúng tôi khiến tôi phải phanh gấp.","rootVerb":"carve","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"cast off":{"definition":"Cởi dây buộc thuyền.","example":"They cast off and headed out to sea.","exampleTranslation":"Họ cởi dây buộc thuyền và hướng ra biển.","rootVerb":"cast","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"cast up":{"definition":"Bị sóng đánh dạt vào bờ.","example":"The rubbish was cast up by the tide.","exampleTranslation":"Đống rác đã bị sóng đánh dạt vào bờ.","rootVerb":"cast","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"catch at":{"definition":"Chộp lấy.","example":"She caught at my sleeve as I was leaving and said she needed to talk to me.","exampleTranslation":"Cô ấy chộp lấy tay áo tôi khi tôi đang rời đi và nói rằng cô ấy cần nói chuyện với tôi.","rootVerb":"catch","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"check into":{"definition":"Nhận phòng.","example":"They checked into the Ritz yesterday.","exampleTranslation":"Họ đã nhận phòng khách sạn Ritz vào ngày hôm qua.","rootVerb":"check","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"clear away":{"definition":"Tránh ra xa.","example":"We were told to clear away from the scene of the accident.","exampleTranslation":"Chúng tôi được yêu cầu tránh ra xa khỏi hiện trường vụ tai nạn.","rootVerb":"clear","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"clear off":{"definition":"Rời đi nhanh chóng.","example":"As soon as the trouble started, we cleared off.","exampleTranslation":"Ngay khi rắc rối bắt đầu, chúng tôi đã rời đi nhanh chóng.","rootVerb":"clear","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"cling on":{"definition":"Bám chặt.","example":"He told me to cling on as the motorbike accelerated.","exampleTranslation":"Anh ấy bảo tôi bám chặt khi chiếc xe máy tăng tốc.","rootVerb":"cling","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"close in":{"definition":"Tiến lại gần.","example":"The police were closing in so they decided to try to make a break.","exampleTranslation":"Cảnh sát đang tiến lại gần nên họ quyết định cố gắng bỏ chạy.","rootVerb":"close","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"close in on":{"definition":"Tiến lại gần ai đó.","example":"The police were closing in on the gang.","exampleTranslation":"Cảnh sát đang tiến lại gần băng nhóm đó.","rootVerb":"close","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"close in upon":{"definition":"Tiến lại gần ai đó.","example":"The police were closing in upon the gang.","exampleTranslation":"Cảnh sát đang tiến lại gần băng nhóm đó.","rootVerb":"close","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"close off":{"definition":"Chặn một nơi để ngăn người vào.","example":"The police closed the road off after the explosion.","exampleTranslation":"Cảnh sát đã chặn con đường đó sau vụ nổ.","rootVerb":"close","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"close on":{"definition":"Tiến lại gần hơn.","example":"She is closing on the leader of the race.","exampleTranslation":"Cô ấy đang tiến lại gần hơn với người dẫn đầu cuộc đua.","rootVerb":"close","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"come along":{"definition":"Di chuyển nhanh hơn hoặc bắt kịp.","example":"Come along, we’ll never get there if you don’t keep up with us.","exampleTranslation":"Đi nhanh lên nào, chúng ta sẽ không bao giờ đến đó nếu bạn không theo kịp chúng tôi.","rootVerb":"come","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"come down":{"definition":"Đi du lịch, đi xuống.","example":"When you're next in London, come down and see us.","exampleTranslation":"Khi nào bạn đến London lần tới, hãy ghé thăm chúng tôi nhé.","rootVerb":"come","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"come from":{"definition":"Quốc gia hoặc thị trấn nơi bạn sinh ra.","example":"She comes from Somalia.","exampleTranslation":"Cô ấy đến từ Somalia.","rootVerb":"come","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"come up":{"definition":"Mọc (mặt trời).","example":"The sun came up just as we reached the outskirts of the town.","exampleTranslation":"Mặt trời mọc ngay khi chúng tôi đến vùng ngoại ô của thị trấn.","rootVerb":"come","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"creep up on":{"definition":"Đến gần mà không ai nhận ra.","example":"They crept up on their rivals and overtook them.","exampleTranslation":"Họ tiến đến gần các đối thủ của mình mà không bị phát hiện và vượt qua họ.","rootVerb":"creep","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"cut up":{"definition":"Tạt đầu xe (lái vào làn bên cạnh, ngay trước mũi xe khác).","example":"A fast car tried to cut up in front of me.","exampleTranslation":"Một chiếc xe chạy nhanh đã cố gắng tạt đầu xe ngay trước mũi xe tôi.","rootVerb":"cut","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"dig in":{"definition":"Đào công sự, hầm trú ẩn (quân sự).","example":"Anticipating an artillery barrage, we quickly dug in.","exampleTranslation":"Dự đoán trước một đợt pháo kích, chúng tôi đã nhanh chóng đào công sự.","rootVerb":"dig","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"double back":{"definition":"Quay ngoắt lại đường cũ.","example":"When he saw the police, he doubled back and went home.","exampleTranslation":"Khi nhìn thấy cảnh sát, anh ta đã quay ngoắt lại đường cũ và đi về nhà.","rootVerb":"double","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"draw back":{"definition":"Lùi lại, rút lui.","example":"He drew back when the dog barked.","exampleTranslation":"Anh ấy lùi lại khi con chó sủa.","rootVerb":"draw","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"draw in":{"definition":"Chạy vào ga (tàu hỏa).","example":"The train drew in and we got off.","exampleTranslation":"Tàu hỏa chạy vào ga và chúng tôi bước xuống.","rootVerb":"draw","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"draw on":{"definition":"Trôi qua chầm chậm (thời gian).","example":"As the lesson drew on, the students started to get bored.","exampleTranslation":"Khi buổi học trôi qua chầm chậm, các sinh viên bắt đầu cảm thấy chán nản.","rootVerb":"draw","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"drive away":{"definition":"Xua đuổi (thú vật hoặc người).","example":"Their unfriendliness drives customers away.","exampleTranslation":"Sự thiếu thân thiện của họ xua đuổi khách hàng.","rootVerb":"drive","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"drive back":{"definition":"Đẩy lùi.","example":"The police drove the crowd back to give the rescue workers more space.","exampleTranslation":"Cảnh sát đã đẩy lùi đám đông để tạo thêm không gian cho các nhân viên cứu hộ.","rootVerb":"drive","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"drive out":{"definition":"Đuổi ai đó khỏi một nơi.","example":"The soldiers drove them out of their homes.","exampleTranslation":"Những người lính đã đuổi họ khỏi nhà của chính họ.","rootVerb":"drive","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"drop away":{"definition":"Giảm dần về số lượng.","example":"The numbers of people attending began the drop away after a few months.","exampleTranslation":"Số lượng người tham dự bắt đầu giảm dần sau một vài tháng.","rootVerb":"drop","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"drop over":{"definition":"Tạt qua chơi.","example":"I'll drop over on my way back.","exampleTranslation":"Tôi sẽ tạt qua chơi trên đường về.","rootVerb":"drop","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"edge up":{"definition":"Dần tiến lại gần.","example":"She edged up behind the bus at the red light.","exampleTranslation":"Cô ấy dần tiến lại gần phía sau chiếc xe buýt tại đèn đỏ.","rootVerb":"edge","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"fall back":{"definition":"Rút lui.","example":"The army fell back after losing the battle.","exampleTranslation":"Quân đội đã rút lui sau khi thua trận.","rootVerb":"fall","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"fall down":{"definition":"Ngã xuống đất.","example":"I slipped on the ice and fell down.","exampleTranslation":"Tôi trượt chân trên băng và ngã xuống đất.","rootVerb":"fall","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"fall in":{"definition":"Sụp xuống.","example":"The ceiling fell in hurting a lot of people.","exampleTranslation":"Trần nhà sụp xuống làm nhiều người bị thương.","rootVerb":"fall","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"fall over":{"definition":"Ngã xuống đất.","example":"I slipped on the ice and fell over.","exampleTranslation":"Tôi trượt chân trên băng và ngã xuống đất.","rootVerb":"fall","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"filter in":{"definition":"Di chuyển vào một làn xe cộ mà không làm các xe khác phải dừng lại.","example":"The slip lane allows traffic to filter in at the junction.","exampleTranslation":"Làn đường phụ cho phép xe cộ di chuyển vào làn xe chính tại điểm giao cắt.","rootVerb":"filter","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"finish up":{"definition":"Cuối cùng đến một nơi nào đó, thường là không có kế hoạch.","example":"We went out for diner and finished up in a club.","exampleTranslation":"Chúng tôi đã đi ăn tối và cuối cùng lại tới một câu lạc bộ.","rootVerb":"finish","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"freeze over":{"definition":"Đóng băng bao phủ trên bề mặt (hồ, sông, ao...).","example":"The winter was very severe and the lake froze over.","exampleTranslation":"Mùa đông rất khắc nghiệt và mặt hồ đã đóng băng.","rootVerb":"freeze","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"front onto":{"definition":"Hướng ra, quay mặt ra (mặt tiền của tòa nhà).","example":"My house fronts onto the main square.","exampleTranslation":"Nhà tôi quay mặt ra quảng trường chính.","rootVerb":"front","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"fuel up":{"definition":"Đổ nhiên liệu.","example":"We stopped to fuel up before the car ran out.","exampleTranslation":"Chúng tôi đã dừng lại để đổ nhiên liệu trước khi xe hết sạch.","rootVerb":"fuel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"gad about":{"definition":"Đi dạo chơi nhiều nơi.","example":"I spent the afternoon gadding about in the West End.","exampleTranslation":"Tôi đã dành cả buổi chiều đi dạo chơi nhiều nơi ở West End.","rootVerb":"gad","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"gad around":{"definition":"Đi dạo chơi đây đó.","example":"I spent the afternoon gadding around looking for some books.","exampleTranslation":"Tôi đã dành cả buổi chiều đi dạo chơi đây đó để tìm vài cuốn sách.","rootVerb":"gad","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"get across":{"definition":"Di chuyển cái gì đó từ bên này sang bên kia.","example":"How are we going to get these bags across the river?","exampleTranslation":"Làm sao chúng ta di chuyển những chiếc túi này từ bên này sang bên kia sông?","rootVerb":"get","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"get on for":{"definition":"Sắp đến giờ.","example":"It's getting on for midnight.","exampleTranslation":"Sắp đến giờ nửa đêm rồi.","rootVerb":"get","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"ghost away":{"definition":"Bí mật đưa ai đó đi.","example":"They ghosted him away to a secret location before he could be arrested.","exampleTranslation":"Họ bí mật đưa anh ta đi đến một địa điểm bí mật trước khi anh ta bị bắt.","rootVerb":"ghost","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"give onto":{"definition":"Mở ra hướng nào đó (cửa, cửa sổ).","example":"The French windows give onto the lawn.","exampleTranslation":"Những cửa sổ kiểu Pháp mở ra phía bãi cỏ.","rootVerb":"give","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"give way to":{"definition":"Bị thay thế bởi thứ tốt hơn/hiện đại hơn.","example":"Cottage industries gave way to the big companies.","exampleTranslation":"Các ngành nghề thủ công nhỏ lẻ đã bị thay thế bởi các công ty lớn.","rootVerb":"give","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"go across":{"definition":"Băng qua, đi qua một bên khác.","example":"He went across to the opposition.","exampleTranslation":"Anh ấy đã băng qua phía bên đối lập.","rootVerb":"go","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"go away":{"definition":"Rời đi hoặc biến mất.","example":"This drug should make the pain go away.","exampleTranslation":"Loại thuốc này sẽ giúp cơn đau biến mất.","rootVerb":"go","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"go forth":{"definition":"Ra nước ngoài, lên đường.","example":"They went forth to spread the word of the new religion.","exampleTranslation":"Họ đã lên đường để truyền bá giáo lý của tôn giáo mới.","rootVerb":"go","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"go on to":{"definition":"Chuyển sang, tiếp tục tới.","example":"We had dinner and went on to a few bars.","exampleTranslation":"Chúng tôi đã ăn tối và chuyển sang tới vài quán bar.","rootVerb":"go","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"go past":{"definition":"Đi ngang qua mà không dừng lại.","example":"She went past me without saying hello.","exampleTranslation":"Cô ấy đã đi ngang qua tôi mà không nói lời chào.","rootVerb":"go","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"go up":{"definition":"Lại gần, tiếp cận.","example":"We went up and asked them for some information about the courses.","exampleTranslation":"Chúng tôi đã lại gần và hỏi họ về thông tin các khóa học.","rootVerb":"go","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hang about":{"definition":"Dành thời gian ở một nơi nào đó mà không làm gì nhiều.","example":"They hang about the station most of the day.","exampleTranslation":"Họ dành cả ngày để ở lại nhà ga mà không làm gì nhiều.","rootVerb":"hang","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hang around":{"definition":"Nán lại ở một nơi.","example":"They hang around the station most of the day.","exampleTranslation":"Họ nán lại ở nhà ga hầu hết cả ngày.","rootVerb":"hang","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hang back":{"definition":"Không tiến lên để tránh làm gì đó, chần chừ.","example":"When they raced towards the entrance, I hung back till it was less crowded.","exampleTranslation":"Khi họ chạy đua về phía lối vào, tôi đã không tiến lên cho đến khi bớt đông đúc hơn.","rootVerb":"hang","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hang back from":{"definition":"Trì hoãn hoặc tránh làm gì đó.","example":"They were hanging back from making the final decision.","exampleTranslation":"Họ đã chần chừ trong việc đưa ra quyết định cuối cùng.","rootVerb":"hang","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"head for":{"definition":"Di chuyển hoặc đi về phía.","example":"It's getting late- I'm heading for home.","exampleTranslation":"Trời đang tối dần - tôi đang đi về nhà.","rootVerb":"head","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"head off":{"definition":"Ngăn chặn ai đó hoặc buộc họ phải chuyển hướng.","example":"The sheriff and his men headed the bandits off at the pass.","exampleTranslation":"Cảnh sát trưởng và người của ông ấy đã ngăn chặn những tên cướp tại con đèo.","rootVerb":"head","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"head out":{"definition":"Đi ra ngoài.","example":"We're heading out at seven, so don't be late.","exampleTranslation":"Chúng tôi sẽ đi ra ngoài lúc bảy giờ, vì vậy đừng đến muộn nhé.","rootVerb":"head","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hide away":{"definition":"Đi hoặc ở đâu đó nơi bạn sẽ không bị tìm thấy hoặc tránh xa mọi người.","example":"I'm renting a cottage where I can hide away for the summer.","exampleTranslation":"Tôi đang thuê một ngôi nhà nhỏ nơi tôi có thể ở ẩn trong suốt mùa hè.","rootVerb":"hide","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hide out":{"definition":"Đi hoặc ở đâu đó để tránh bị bắt hoặc tìm thấy.","example":"The police think he's hiding out in the woods.","exampleTranslation":"Cảnh sát nghĩ rằng anh ta đang ở ẩn trong rừng để tránh bị bắt.","rootVerb":"hide","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hold out":{"definition":"Đưa ra phía trước bạn.","example":"I held out my hand when she walked in.","exampleTranslation":"Tôi đã đưa tay ra phía trước khi cô ấy bước vào.","rootVerb":"hold","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hole up":{"definition":"Ẩn nấp để tránh bị phát hiện hoặc một tình huống khó chịu.","example":"They holed up in a remote cottage while the police were searching for them.","exampleTranslation":"Họ đã ẩn nấp trong một ngôi nhà nhỏ hẻo lánh trong khi cảnh sát đang tìm kiếm họ.","rootVerb":"hole","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hoon around":{"definition":"Hành động một cách nguy hiểm hoặc liều lĩnh, đặc biệt là khi lái xe nhanh.","example":"He was hooning around in his new car last night and the police pulled him.","exampleTranslation":"Anh ta đã lái xe một cách liều lĩnh bằng chiếc xe mới tối qua và cảnh sát đã chặn anh ta lại.","rootVerb":"hoon","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hover around":{"definition":"Di chuyển xung quanh một nơi.","example":"She was hovering around to see what we were talking about.","exampleTranslation":"Cô ấy cứ di chuyển xung quanh để xem chúng tôi đang nói về chuyện gì.","rootVerb":"hover","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"hurry up":{"definition":"Nhanh lên, khẩn trương lên.","example":"Hurry up, or we will miss the beginning of the movie!","exampleTranslation":"Nhanh lên, nếu không chúng ta sẽ bỏ lỡ phần đầu của bộ phim!","rootVerb":"hurry","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"issue forth":{"definition":"Đi ra khỏi một nơi.","example":"New initiatives issue forth from the government on a daily basis.","exampleTranslation":"Những sáng kiến mới được đưa ra từ chính phủ hàng ngày.","rootVerb":"issue","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"jack up":{"definition":"Nâng ô tô lên để có thể thực hiện công việc cơ khí.","example":"We jacked the car up and changed the tyre.","exampleTranslation":"Chúng tôi đã nâng ô tô lên và thay lốp.","rootVerb":"jack","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"keep to":{"definition":"Ở trong giới hạn.","example":"Please keep to the path.","exampleTranslation":"Vui lòng đi đúng đường.","rootVerb":"keep","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"land up in":{"definition":"Đến hoặc kết thúc chuyến đi ở một nơi thường không có kế hoạch trước.","example":"We set out for Manchester, but landed up in Liverpool.","exampleTranslation":"Chúng tôi lên đường tới Manchester, nhưng rốt cuộc lại đến Liverpool.","rootVerb":"land","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"level off":{"definition":"Giữ thăng bằng độ cao (máy bay).","example":"The pilot leveled off at 5,000 meters.","exampleTranslation":"Phi công đã giữ ổn định độ cao ở 5.000 mét.","rootVerb":"level","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"level out":{"definition":"Giữ thăng bằng độ cao (máy bay).","example":"The pilot leveled out at 5,000 meters.","exampleTranslation":"Phi công đã giữ ổn định độ cao ở 5.000 mét.","rootVerb":"level","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"lift off":{"definition":"Phóng lên (tên lửa hoặc tàu vũ trụ).","example":"We watched the rocket lift off into space today.","exampleTranslation":"Chúng tôi đã xem tên lửa phóng lên vào không gian ngày hôm nay.","rootVerb":"lift","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"make after":{"definition":"Đuổi theo.","example":"The police made after the stolen car.","exampleTranslation":"Cảnh sát đã đuổi theo chiếc xe bị đánh cắp.","rootVerb":"make","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"make off":{"definition":"Rời đi vội vã.","example":"They made off when they heard the police siren.","exampleTranslation":"Họ đã bỏ chạy khi nghe thấy tiếng còi cảnh sát.","rootVerb":"make","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"make way for":{"definition":"Mở đường cho, nhường lối cho, nhường chỗ cho cái mới.","example":"The old houses were demolished to make way for a modern public park.","exampleTranslation":"Những ngôi nhà cũ đã bị phá bỏ để nhường chỗ cho một công viên công cộng hiện đại.","rootVerb":"make","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"mill around":{"definition":"Đi loanh quanh không có mục đích.","example":"There were a lot of people milling around waiting for the bus.","exampleTranslation":"Có rất nhiều người đang đi loanh quanh chờ xe buýt.","rootVerb":"mill","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"moggy off":{"definition":"Rời đi.","example":"The cat moggy off into the dark garden quickly.","exampleTranslation":"Con mèo nhanh chóng rời đi vào khu vườn tối tăm.","rootVerb":"moggy","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"move along":{"definition":"Yêu cầu ai đó di chuyển khỏi một nơi.","example":"The police told the people watching to move along.","exampleTranslation":"Cảnh sát đã yêu cầu những người đang đứng xem di chuyển khỏi đó.","rootVerb":"move","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"move away":{"definition":"Chuyển đi nơi khác.","example":"I moved away when the factory shut down.","exampleTranslation":"Tôi đã chuyển đi nơi khác khi nhà máy đóng cửa.","rootVerb":"move","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"nip off":{"definition":"Đi đâu đó nhanh chóng.","example":"I'm nipping off to get some milk.","exampleTranslation":"Tôi sắp đi nhanh một lát để mua ít sữa.","rootVerb":"nip","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pack off":{"definition":"Gửi ai đó đi xa.","example":"His boss packed him off to a regional office.","exampleTranslation":"Sếp của anh ấy đã gửi anh ấy đi làm việc tại một văn phòng khu vực.","rootVerb":"pack","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pass by":{"definition":"Đi ngang qua mà không dừng lại.","example":"I was just passing by when I saw the accident.","exampleTranslation":"Tôi chỉ vừa đi ngang qua thì thấy vụ tai nạn.","rootVerb":"pass","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pass through":{"definition":"Thăm một nơi mà không dừng lại hoặc chỉ dừng lại trong một thời gian ngắn.","example":"I didn't see much as I was only passing through the town.","exampleTranslation":"Tôi không thấy nhiều điều vì tôi chỉ đi ngang qua thị trấn đó.","rootVerb":"pass","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"peel away":{"definition":"Rời khỏi một nhóm bằng cách di chuyển theo một hướng khác.","example":"Some of the crowd peeled away to get out of the crush.","exampleTranslation":"Một vài người trong đám đông đã tách ra để thoát khỏi sự chen lấn.","rootVerb":"peel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"peel away from":{"definition":"Rời khỏi một nhóm bằng cách di chuyển theo một hướng khác.","example":"They peeled away from the crowd and went down a side road.","exampleTranslation":"Họ đã tách ra khỏi đám đông và đi xuống một con đường phụ.","rootVerb":"peel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"peel off":{"definition":"Rời khỏi một nhóm bằng cách di chuyển theo một hướng khác.","example":"When the police blocked the road, a few protesters peeled off and left the march.","exampleTranslation":"Khi cảnh sát chặn đường, một vài người biểu tình đã tách ra và rời khỏi đoàn diễu hành.","rootVerb":"peel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"peel off from":{"definition":"Rời khỏi một nhóm bằng cách di chuyển theo một hướng khác.","example":"They peeled off from the demonstration when the police arrived.","exampleTranslation":"Họ đã tách ra khỏi cuộc biểu tình khi cảnh sát đến.","rootVerb":"peel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"peel out":{"definition":"Tăng tốc nhanh từ trạng thái đứng yên.","example":"Fearing the police, he peeled out in a cloud of tire smoke.","exampleTranslation":"Vì sợ cảnh sát, anh ta đã phóng xe đi nhanh trong làn khói lốp xe.","rootVerb":"peel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pile in":{"definition":"Vào một nơi một cách nhanh chóng, hỗn loạn.","example":"The coach stopped and we all piled in.","exampleTranslation":"Xe khách dừng lại và tất cả chúng tôi đều ùa vào.","rootVerb":"pile","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pile into":{"definition":"Vào một nơi một cách nhanh chóng, hỗn loạn.","example":"We piled into the shop when it opened.","exampleTranslation":"Chúng tôi đã ùa vào cửa hàng khi nó mở cửa.","rootVerb":"pile","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pile out":{"definition":"Rời khỏi một nơi một cách nhanh chóng, hỗn loạn.","example":"The train eventually arrived and we all piled out.","exampleTranslation":"Cuối cùng tàu hỏa cũng đến và tất cả chúng tôi đều ùa ra ngoài.","rootVerb":"pile","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"plough into":{"definition":"Tông vào với tốc độ cao.","example":"The bus skidded and ploughed into the bus stop.","exampleTranslation":"Chiếc xe buýt bị trượt và tông thẳng vào trạm dừng xe buýt.","rootVerb":"plough","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"plough through":{"definition":"Di chuyển qua một nơi có ít không gian hoặc có chướng ngại vật.","example":"The boat had to plough through the ice.","exampleTranslation":"Chiếc thuyền phải rẽ băng để đi qua.","rootVerb":"plough","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"plow into":{"definition":"Tông vào với tốc độ cao.","example":"The bus skidded and plowed into the bus stop.","exampleTranslation":"Chiếc xe buýt bị trượt và tông thẳng vào trạm dừng xe buýt.","rootVerb":"plow","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pootle along":{"definition":"Đi dạo","example":"We were pootling along at thirty miles an hour.","exampleTranslation":"Chúng tôi đang thong dong đi dạo với tốc độ ba mươi dặm một giờ.","rootVerb":"pootle","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pop out":{"definition":"Ra ngoài trong chốc lát.","example":"I'm just popping out to the shops. Do you need anything while I'm out?","exampleTranslation":"Tôi chỉ ra ngoài một lát đến cửa hàng thôi. Bạn có cần gì trong khi tôi ra ngoài không?","rootVerb":"pop","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pull away":{"definition":"Khi xe cộ lăn bánh khởi hành.","example":"The car pulled away from the traffic lights at high speed.","exampleTranslation":"Chiếc xe tăng tốc rời khỏi đèn giao thông.","rootVerb":"pull","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"pull out":{"definition":"Di chuyển vào luồng giao thông.","example":"The traffic was so bad that it took me ages to pull out.","exampleTranslation":"Giao thông tệ đến mức tôi mất rất lâu mới có thể di chuyển vào luồng xe.","rootVerb":"pull","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"race off":{"definition":"Rời đi một cách vội vã.","example":"They raced off when the police arrived.","exampleTranslation":"Họ đã phóng đi vội vã khi cảnh sát đến.","rootVerb":"race","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"ride off":{"definition":"Cưỡi xe, ngựa đi mất.","example":"She got on her motorbike and rode off.","exampleTranslation":"Cô ấy lên xe máy và phóng đi.","rootVerb":"ride","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"roll in":{"definition":"Đến với số lượng lớn, đối với các phương tiện quân sự.","example":"The tanks rolled in and took control of the capital city.","exampleTranslation":"Các xe tăng đã ồ ạt kéo đến và giành quyền kiểm soát thủ đô.","rootVerb":"roll","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"run in":{"definition":"Lái một chiếc xe mới một cách cẩn thận để không làm hỏng động cơ.","example":"She ran the car in for a thousand miles.","exampleTranslation":"Cô ấy đã chạy rốt-đa chiếc xe mới trong một nghìn dặm.","rootVerb":"run","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"rush away":{"definition":"Rời khỏi một nơi vội vã.","example":"They rushed away when the police arrived.","exampleTranslation":"Họ đã vội vã rời đi khi cảnh sát đến.","rootVerb":"rush","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"rush off":{"definition":"Khởi hành vội vã.","example":"Zac rushed off to get to his medical appointment.","exampleTranslation":"Zac vội vã khởi hành để đi đến cuộc hẹn khám bệnh của mình.","rootVerb":"rush","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"saddle up":{"definition":"Đặt yên ngựa lên và chuẩn bị cho một con vật để cưỡi.","example":"She saddled up the horse and rode off.","exampleTranslation":"Cô ấy đóng yên cho ngựa rồi cưỡi đi.","rootVerb":"saddle","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"sally forth":{"definition":"Rời khỏi một nơi an toàn hoặc thoải mái.","example":"The townspeople sallied forth to fight the invading army.","exampleTranslation":"Người dân thị trấn đã ra khỏi nơi an toàn để chiến đấu với quân đội xâm lược.","rootVerb":"sally","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"sally out":{"definition":"Rời khỏi một nơi an toàn hoặc thoải mái.","example":"Though it was pouring with rain, we sallied out to meet her.","exampleTranslation":"Mặc dù trời đang mưa như trút nước, chúng tôi vẫn rời đi để gặp cô ấy.","rootVerb":"sally","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"scout out":{"definition":"Tìm kiếm một cái gì đó.","example":"The researcher spent months scouting out the answer.","exampleTranslation":"Nhà nghiên cứu đã dành nhiều tháng để tìm kiếm câu trả lời.","rootVerb":"scout","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"see into":{"definition":"Đi cùng ai đó vào văn phòng.","example":"Her secretary saw me into her office.","exampleTranslation":"Thư ký của cô ấy đã đưa tôi vào văn phòng của cô ấy.","rootVerb":"see","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"see off":{"definition":"Đi đến sân bay, nhà ga, v.v., để nói lời tạm biệt với ai đó.","example":"I went to the station to see them off.","exampleTranslation":"Tôi đã đến nhà ga để tiễn họ.","rootVerb":"see","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"set out":{"definition":"Bắt đầu một cuộc hành trình.","example":"The explorers set out for the South Pole yesterday morning.","exampleTranslation":"Các nhà thám hiểm đã khởi hành đến Nam Cực vào sáng hôm qua.","rootVerb":"set","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"ship off":{"definition":"Gửi ai đó đi, thường là do một vấn đề.","example":"They had to ship off the old furniture today.","exampleTranslation":"Họ phải gửi đồ đạc cũ đi hôm nay.","rootVerb":"ship","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"ship out":{"definition":"Rời khỏi một nơi.","example":"If you've finished your work, I'm ready to ship out.","exampleTranslation":"Nếu bạn đã xong việc, tôi đã sẵn sàng để rời đi.","rootVerb":"ship","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"shoot away":{"definition":"Rời đi đâu đó thật nhanh.","example":"He shot away as soon as the bell rang for the end of the lesson.","exampleTranslation":"Anh ấy đã phóng đi ngay khi tiếng chuông báo kết thúc bài học vang lên.","rootVerb":"shoot","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"shoot back":{"definition":"Quay trở lại nhanh chóng.","example":"I'm shooting back home to pick up some things I forgot to bring with me.","exampleTranslation":"Tôi đang nhanh chóng quay trở về nhà để lấy vài thứ mà tôi quên mang theo.","rootVerb":"shoot","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"shoot off":{"definition":"Rời đi khẩn trương và nhanh chóng.","example":"I'll have to shoot off as soon as the lesson finishes, otherwise I'll miss my train.","exampleTranslation":"Tôi sẽ phải rời đi khẩn trương ngay khi bài học kết thúc, nếu không tôi sẽ lỡ chuyến tàu của mình.","rootVerb":"shoot","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"shoot out":{"definition":"Ra ngoài trong một thời gian ngắn.","example":"I will shoot out to the store for milk.","exampleTranslation":"Tôi sẽ ra ngoài cửa hàng một lát để mua sữa.","rootVerb":"shoot","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"show around":{"definition":"Đưa ai đó đi tham quan.","example":"The estate agent showed us around the house but we didn't like it much.","exampleTranslation":"Người môi giới bất động sản đã đưa chúng tôi đi tham quan ngôi nhà nhưng chúng tôi không thích nó lắm.","rootVerb":"show","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"show over":{"definition":"Dẫn ai đó đi xem quanh một địa điểm.","example":"He will show over the garden to his guests.","exampleTranslation":"Anh ấy sẽ dẫn khách của mình đi xem quanh khu vườn.","rootVerb":"show","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"slow up":{"definition":"Làm chậm tiến độ của cái gì đó.","example":"The negotiations were slowed up by the arguments.","exampleTranslation":"Tiến độ các cuộc đàm phán đã bị làm chậm lại bởi những cuộc tranh cãi.","rootVerb":"slow","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"sneak out":{"definition":"Lẻn ra ngoài.","example":"Although the thieves tried to sneak out after dark, we were ready for them.","exampleTranslation":"Mặc dù bọn trộm đã cố lẻn ra ngoài sau khi trời tối, chúng tôi đã sẵn sàng đón lõng chúng.","rootVerb":"sneak","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"sneak up on":{"definition":"Tiếp cận ai đó một cách lén lút.","example":"Dave tried to sneak up on the guard, but was seen anyway.","exampleTranslation":"Dave đã cố tiếp cận lén lút người bảo vệ, nhưng vẫn bị phát hiện.","rootVerb":"sneak","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"spill out":{"definition":"Khi một số lượng lớn người rời khỏi một nơi cùng một lúc.","example":"The crowd spilled out onto the streets after the match had ended.","exampleTranslation":"Đám đông đã tràn ra ngoài đường phố sau khi trận đấu kết thúc.","rootVerb":"spill","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"spirit off":{"definition":"Bí mật đưa ai đó ra khỏi một nơi.","example":"They spirited him off before any trouble started.","exampleTranslation":"Họ đã bí mật đưa anh ta đi trước khi bất kỳ rắc rối nào xảy ra.","rootVerb":"spirit","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"splash down":{"definition":"Hạ cánh xuống biển (khoang vũ trụ).","example":"Apollo 13 splashed down after a harrowing flight.","exampleTranslation":"Tàu Apollo 13 đã hạ cánh xuống biển sau một chuyến bay đầy kinh hoàng.","rootVerb":"splash","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"spring up":{"definition":"Xuất hiện đột ngột.","example":"Charity shops are springing up in the recession.","exampleTranslation":"Các cửa hàng từ thiện đang xuất hiện đột ngột trong thời kỳ suy thoái.","rootVerb":"spring","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"squeeze up":{"definition":"Nhét nhiều người vào một không gian hơn bình thường hoặc thoải mái.","example":"Four of us had to squeeze up in the back of the car.","exampleTranslation":"Bốn người chúng tôi đã phải chen chúc nhau ở ghế sau của xe hơi.","rootVerb":"squeeze","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"stack up":{"definition":"Gia tăng số lượng máy bay chờ hạ cánh tại sân bay.","example":"Planes were stacking up while the airport was closed after the bomb threat.","exampleTranslation":"Các máy bay đang phải xếp hàng chờ hạ cánh khi sân bay bị đóng cửa sau lời đe dọa đánh bom.","rootVerb":"stack","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"start out":{"definition":"Bắt đầu một chuyến đi.","example":"We started out early in the morning.","exampleTranslation":"Chúng tôi đã bắt đầu chuyến đi vào sáng sớm.","rootVerb":"start","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"steal away":{"definition":"Rời đi lặng lẽ hoặc bí mật.","example":"We didn't want to wake them, so we stole away in the middle of the night.","exampleTranslation":"Chúng tôi không muốn đánh thức họ, nên chúng tôi đã lặng lẽ rời đi vào giữa đêm.","rootVerb":"steal","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"steal out":{"definition":"Rời đi một cách lén lút hoặc lặng lẽ.","example":"Not wanting to attract attention, she stole out early.","exampleTranslation":"Vì không muốn gây chú ý, cô ấy đã lén lút rời đi từ sớm.","rootVerb":"steal","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"steal up":{"definition":"Đến gần một cách lặng lẽ hoặc bí mật.","example":"The lights were off and everything was quiet so we stole up as quietly as we could.","exampleTranslation":"Đèn đã tắt và mọi thứ đều yên tĩnh nên chúng tôi đã tiến lại gần một cách lặng lẽ nhất có thể.","rootVerb":"steal","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"steal up on":{"definition":"Tiếp cận một nơi hoặc ai đó một cách lặng lẽ hoặc bí mật.","example":"We stole up on them so that they couldn't sound the alarm.","exampleTranslation":"Chúng tôi đã bí mật tiếp cận họ để họ không thể phát tín hiệu báo động.","rootVerb":"steal","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"stomp off":{"definition":"Rời đi một cách tức giận.","example":"He lost his temper and stomped off home.","exampleTranslation":"Anh ấy đã nổi giận và dậm chân bỏ về nhà.","rootVerb":"stomp","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"stop by":{"definition":"Ghé thăm đâu đó một cách ngắn gọn hoặc nhanh chóng.","example":"I must stop by the supermarket and pick up some things for dinner.","exampleTranslation":"Tôi phải ghé qua siêu thị và mua vài thứ cho bữa tối.","rootVerb":"stop","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"storm off":{"definition":"Rời khỏi một nơi một cách tức giận.","example":"They had a row and he stormed off.","exampleTranslation":"Họ đã cãi nhau và anh ấy đã tức giận bỏ đi.","rootVerb":"storm","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"stow away":{"definition":"Trốn trong một phương tiện để đi du lịch mà không ai biết.","example":"She stowed away on the plane but was caught when it landed.","exampleTranslation":"Cô ấy đã trốn trên máy bay nhưng bị bắt giữ khi nó hạ cánh.","rootVerb":"stow","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"swing by":{"definition":"Ghé thăm một người hoặc một nơi nào đó trên đường đến đâu đó.","example":"I will swing by this afternoon and pick you up.","exampleTranslation":"Tôi sẽ ghé qua vào chiều nay và đón bạn.","rootVerb":"swing","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"tag along":{"definition":"Đi cùng ai đó, đặc biệt là khi họ không mời bạn.","example":"You're off to the cinema; can we tag along?","exampleTranslation":"Bạn đang chuẩn bị đến rạp chiếu phim; chúng tôi có thể đi cùng được không?","rootVerb":"tag","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"tail back":{"definition":"Gây tắc đường.","example":"The traffic tailed back for several miles after the accident.","exampleTranslation":"Giao thông đã bị tắc nghẽn kéo dài nhiều dặm sau vụ tai nạn.","rootVerb":"tail","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"tear out":{"definition":"Khởi hành nhanh chóng.","example":"The sheriff tore out after the escaping criminals.","exampleTranslation":"Cảnh sát trưởng đã nhanh chóng khởi hành để đuổi theo những tên tội phạm đang bỏ trốn.","rootVerb":"tear","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"toddle off":{"definition":"Rời đi, về nhà.","example":"It's geting late, so I'm going to toddle off home.","exampleTranslation":"Trời đã tối rồi, nên tôi chuẩn bị về nhà đây.","rootVerb":"toddle","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"tootle off":{"definition":"Rời đi, khởi hành.","example":"It's getting late, so we're going to tootle off home.","exampleTranslation":"Trời đang tối dần, nên chúng tôi chuẩn bị khởi hành về nhà.","rootVerb":"tootle","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"touch down":{"definition":"Hạ cánh (máy bay).","example":"The plane touched down at Narita airport an hour late.","exampleTranslation":"Máy bay đã hạ cánh xuống sân bay Narita trễ một giờ.","rootVerb":"touch","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"tow away":{"definition":"Di dời một phương tiện, đặc biệt là nếu đỗ xe trái phép.","example":"I parked in a no-parking zone and they towed my car away.","exampleTranslation":"Tôi đã đỗ xe vào khu vực cấm đỗ và họ đã cẩu xe của tôi đi.","rootVerb":"tow","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"turn back":{"definition":"Quay trở lại, quay đầu; đảo ngược tiến trình.","example":"Severe snowstorms forced the mountain climbing expedition to turn back.","exampleTranslation":"Những trận bão tuyết dữ dội đã buộc đoàn thám hiểm leo núi phải quay trở lại.","rootVerb":"turn","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"venture forth":{"definition":"Rời khỏi nơi an toàn hoặc thoải mái.","example":"If the storm has finished, we could venture forth.","exampleTranslation":"Nếu cơn bão đã tan, chúng ta có thể rời khỏi nơi trú ẩn.","rootVerb":"venture","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wait about":{"definition":"Chờ đợi ở đâu đó mà không làm gì.","example":"I waited about for an hour, but they didn't come.","exampleTranslation":"Tôi đã đợi ở đó khoảng một giờ nhưng họ không đến.","rootVerb":"wait","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wait around":{"definition":"Chờ đợi ở đâu đó mà không làm gì.","example":"They were just waiting around to see if anything was going to happen.","exampleTranslation":"Họ chỉ đứng đợi quanh đó để xem liệu có chuyện gì xảy ra hay không.","rootVerb":"wait","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"walk on":{"definition":"Tiếp tục đi bộ.","example":"I saw the accident but just walked on as I didn't want to have to give a statement.","exampleTranslation":"Tôi đã chứng kiến vụ tai nạn nhưng vẫn cứ đi tiếp vì tôi không muốn phải đưa ra lời khai.","rootVerb":"walk","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"walk up":{"definition":"Đi đến chỗ ai đó.","example":"A man walked up and asked me the time.","exampleTranslation":"Một người đàn ông đi đến chỗ tôi và hỏi giờ.","rootVerb":"walk","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wander off":{"definition":"Rời khỏi một nơi, thường là không nói với người khác.","example":"She wandered off and got lost in the crowd.","exampleTranslation":"Cô ấy đã đi đâu đó rồi lạc mất trong đám đông.","rootVerb":"wander","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wash away":{"definition":"Bị lũ lụt hoặc sóng cuốn trôi hoàn toàn một cấu trúc, tòa nhà, v.v.","example":"The ice cream stall on the beach was washed away in the storm last night.","exampleTranslation":"Quầy bán kem trên bãi biển đã bị cơn bão đêm qua cuốn trôi hoàn toàn.","rootVerb":"wash","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wave down":{"definition":"Vẫy tay ra hiệu để dừng xe.","example":"They waved the van down and got a lift after the accident.","exampleTranslation":"Họ đã vẫy tay ra hiệu cho chiếc xe tải dừng lại và đi nhờ sau vụ tai nạn.","rootVerb":"wave","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wave on":{"definition":"Vẫy tay ra hiệu cho ai đó tiếp tục di chuyển.","example":"The accident was bad, but the police waved us on.","exampleTranslation":"Vụ tai nạn rất nghiêm trọng, nhưng cảnh sát đã vẫy tay ra hiệu cho chúng tôi tiếp tục di chuyển.","rootVerb":"wave","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"wheel around":{"definition":"Quay người nhanh chóng và quay mặt về hướng ngược lại.","example":"When he heard the whistle, he wheeled around to see what was happening.","exampleTranslation":"Khi nghe thấy tiếng còi, anh ấy quay người lại thật nhanh để xem chuyện gì đang xảy ra.","rootVerb":"wheel","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"whisk away":{"definition":"Nhanh chóng đưa đến một nơi khác.","example":"The police whisked the minister away when the trouble started.","exampleTranslation":"Cảnh sát đã nhanh chóng đưa vị bộ trưởng rời khỏi nơi đó khi rắc rối bắt đầu.","rootVerb":"whisk","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"zoom off":{"definition":"Đi đâu đó nhanh chóng.","example":"He rushed out of the building and zoomed off in his car.","exampleTranslation":"Anh ấy lao ra khỏi tòa nhà và phóng xe đi mất.","rootVerb":"zoom","topicId":"travel-movement","topicTitle":"Di chuyển và du lịch","partOfSpeech":"V","dictionarySource":"offline"},"aim at":{"definition":"mục đích là; nhằm đạt được","example":"They're aiming at reducing costs by ten percent.","exampleTranslation":"Họ đang nhắm tới mục tiêu giảm chi phí xuống mười phần trăm.","rootVerb":"aim","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"bash out":{"definition":"viết vội vàng (không chuẩn bị kỹ)","example":"I bashed the essay out the night before I had to hand it in.","exampleTranslation":"Tôi đã viết vội bài luận đó vào đêm trước khi phải nộp.","rootVerb":"bash","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"beat out":{"definition":"đánh bại (trong cuộc thi)","example":"The marathon runner barely beat out his rival at the tape.","exampleTranslation":"Vận động viên marathon đó suýt chút nữa đã đánh bại đối thủ của mình ngay tại vạch đích.","rootVerb":"beat","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"beaver away":{"definition":"làm việc chăm chỉ","example":"She's beavering away before her exams.","exampleTranslation":"Cô ấy đang miệt mài làm việc trước kỳ thi.","rootVerb":"beaver","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"beaver away at":{"definition":"miệt mài làm","example":"I have to beaver away at it or else I will fail the course.","exampleTranslation":"Tôi phải miệt mài làm việc này nếu không tôi sẽ trượt khóa học.","rootVerb":"beaver","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"block in":{"definition":"Đánh dấu trước các sự kiện trong lịch.","example":"He blocked in the events in his calendar.","exampleTranslation":"Anh ấy đã đánh dấu các sự kiện vào lịch của mình.","rootVerb":"block","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"blow off":{"definition":"Phớt lờ, không làm việc gì đó.","example":"I blew the homework off and did badly.","exampleTranslation":"Tôi đã phớt lờ bài tập về nhà và làm không tốt.","rootVerb":"blow","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"bone up":{"definition":"Học hành chăm chỉ vì một lý do nào đó.","example":"I will have to bone up to get a good result.","exampleTranslation":"Tôi sẽ phải học hành chăm chỉ để đạt kết quả tốt.","rootVerb":"bone","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"bone up on":{"definition":"Học hành chăm chỉ cho một mục tiêu.","example":"I need to bone up on my French grammar for the test.","exampleTranslation":"Tôi cần phải học hành chăm chỉ ngữ pháp tiếng Pháp cho bài kiểm tra.","rootVerb":"bone","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"bowl out":{"definition":"Ném bóng trúng đích (trong môn cricket).","example":"He bowled the player out first ball.","exampleTranslation":"Anh ấy đã ném bóng loại người chơi đó ngay từ quả bóng đầu tiên.","rootVerb":"bowl","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"breeze through":{"definition":"Vượt qua dễ dàng, thành công.","example":"She breezed through her exams.","exampleTranslation":"Cô ấy đã vượt qua các bài thi của mình một cách dễ dàng.","rootVerb":"breeze","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"brush up":{"definition":"Ôn lại, cải thiện nhanh kỹ năng.","example":"She took a two-week course to brush up her Spanish before she went travelling around South and Central America.","exampleTranslation":"Cô ấy đã tham gia một khóa học hai tuần để ôn lại tiếng Tây Ban Nha trước khi đi du lịch khắp Nam và Trung Mỹ.","rootVerb":"brush","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"brush up on":{"definition":"Ôn tập lại, trau dồi lại (kiến thức/kỹ năng lâu không dùng).","example":"I need to brush up on my French before traveling to Paris next month.","exampleTranslation":"Tôi cần phải trau dồi lại tiếng Pháp của mình trước khi đi du lịch tới Paris vào tháng tới.","rootVerb":"brush","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"buckle down":{"definition":"Bắt đầu làm việc chăm chỉ.","example":"We had to buckle down and study for the exam.","exampleTranslation":"Chúng tôi đã phải bắt đầu tập trung học hành cho kỳ thi.","rootVerb":"buckle","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"buff up":{"definition":"Cải thiện (hình ảnh, kiến thức).","example":"After the scandal, the politician tried to buff up his public image.","exampleTranslation":"Sau vụ bê bối, vị chính trị gia đã cố gắng cải thiện hình ảnh công chúng của mình.","rootVerb":"buff","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"buff up on":{"definition":"Cải thiện kiến thức nhanh chóng.","example":"I buffed up on my grammar before the test.","exampleTranslation":"Tôi đã ôn tập nhanh kiến thức ngữ pháp của mình trước bài kiểm tra.","rootVerb":"buff","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"build up":{"definition":"Xây dựng, phát triển.","example":"She built the business up from nothing into a market leader in less than a decade.","exampleTranslation":"Cô ấy đã xây dựng doanh nghiệp đó từ con số không trở thành người dẫn đầu thị trường trong chưa đầy một thập kỷ.","rootVerb":"build","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"bulk out":{"definition":"Làm cho lớn hơn hoặc dày hơn.","example":"I bulked the essay out with a few quotes to reach the number of word required.","exampleTranslation":"Tôi đã làm cho bài luận dày hơn bằng một vài trích dẫn để đạt đủ số từ theo yêu cầu.","rootVerb":"bulk","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"bunk off":{"definition":"Cúp học/trốn việc.","example":"I used to bunk off school and go into town.","exampleTranslation":"Tôi từng hay cúp học để vào thị trấn.","rootVerb":"bunk","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"call in":{"definition":"Gọi người đến làm việc.","example":"I had to call in a mechanic for help.","exampleTranslation":"Tôi đã phải gọi thợ cơ khí đến để nhờ giúp đỡ.","rootVerb":"call","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"carry off":{"definition":"Giành chiến thắng, thành công.","example":"She carried off the first prize in the competition.","exampleTranslation":"Cô ấy đã giành giải nhất trong cuộc thi.","rootVerb":"carry","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"carry over":{"definition":"Kéo dài quá thời gian.","example":"The meeting carried over into the afternoon because there was so much to talk about.","exampleTranslation":"Cuộc họp đã kéo dài sang cả buổi chiều vì có quá nhiều vấn đề cần thảo luận.","rootVerb":"carry","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"carry through":{"definition":"Hoàn thành xuất sắc.","example":"They carried the reforms through despite the opposition.","exampleTranslation":"Họ đã hoàn thành xuất sắc các cải cách bất chấp sự phản đối.","rootVerb":"carry","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"carve out":{"definition":"Tạo dựng sự nghiệp, thành công.","example":"She's carved out a career in photojournalism.","exampleTranslation":"Cô ấy đã tự tạo dựng được một sự nghiệp trong ngành báo chí ảnh.","rootVerb":"carve","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"catch on":{"definition":"Cuối cùng cũng hiểu ra.","example":"Everyone else realised what was happening, but it took Henry ages to catch on.","exampleTranslation":"Mọi người đều nhận ra chuyện gì đang xảy ra, nhưng Henry phải mất rất lâu mới hiểu ra.","rootVerb":"catch","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"catch up on":{"definition":"Ôn lại chuyện cũ.","example":"I hadn't seen her for years, so we spent the afternoon catching up on old times.","exampleTranslation":"Tôi đã không gặp cô ấy nhiều năm rồi, nên chúng tôi đã dành cả buổi chiều để ôn lại chuyện cũ.","rootVerb":"catch","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"chalk out":{"definition":"Phác thảo, vạch ra.","example":"He tried to chalk out a plan on paper.","exampleTranslation":"Anh ấy đã cố gắng phác thảo một kế hoạch trên giấy.","rootVerb":"chalk","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"change over":{"definition":"Chuyển đổi hệ thống.","example":"The Irish changed over to using kilometres in 2005.","exampleTranslation":"Người Ireland đã chuyển đổi sang sử dụng kilômét vào năm 2005.","rootVerb":"change","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"chase up":{"definition":"Nhắc nhở ai đó làm việc.","example":"The librarian is chasing me up about my overdue books.","exampleTranslation":"Người thủ thư đang nhắc nhở tôi về những cuốn sách quá hạn.","rootVerb":"chase","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"check by":{"definition":"Ghé qua kiểm tra.","example":"We checked by the office to see if the stuff was ready.","exampleTranslation":"Chúng tôi đã ghé qua văn phòng để xem liệu mọi thứ đã sẵn sàng chưa.","rootVerb":"check","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"check off":{"definition":"Đánh dấu đã làm xong.","example":"She checked off the candidates' names as they arrived.","exampleTranslation":"Cô ấy đã đánh dấu tên các ứng viên khi họ đến.","rootVerb":"check","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"check over":{"definition":"Kiểm tra kỹ lưỡng.","example":"We checked the contract over before signing it.","exampleTranslation":"Chúng tôi đã kiểm tra kỹ lưỡng hợp đồng trước khi ký nó.","rootVerb":"check","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"choose up":{"definition":"Chia đội.","example":"We chose up to play the game.","exampleTranslation":"Chúng tôi đã chia đội để chơi trò chơi.","rootVerb":"choose","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"chuck in":{"definition":"Bỏ việc, từ bỏ.","example":"I chucked my job in to go travelling.","exampleTranslation":"Tôi đã bỏ việc để đi du lịch.","rootVerb":"chuck","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"chuck up":{"definition":"Bỏ việc, từ bỏ.","example":"She didn't like the course, so she chucked it up after a few weeks.","exampleTranslation":"Cô ấy không thích khóa học đó, vì vậy cô ấy đã bỏ nó sau vài tuần.","rootVerb":"chuck","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"churn out":{"definition":"Sản xuất hàng loạt (thường kém chất lượng).","example":"The government churns out educational policies every few months.","exampleTranslation":"Chính phủ sản xuất hàng loạt các chính sách giáo dục mỗi vài tháng.","rootVerb":"churn","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"close out":{"definition":"Kết thúc một việc gì đó.","example":"We closed out the meeting early and went home.","exampleTranslation":"Chúng tôi đã kết thúc cuộc họp sớm và đi về nhà.","rootVerb":"close","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"coast along":{"definition":"Làm việc gì đó mà không cần nhiều nỗ lực hay cố gắng cải thiện.","example":"She's been coasting along all year and hasn't made a lot of progress.","exampleTranslation":"Cô ấy đã làm việc cầm chừng suốt cả năm nay và không đạt được nhiều tiến bộ.","rootVerb":"coast","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"cobble together":{"definition":"Làm, lắp ráp hoặc sản xuất một cách nhanh chóng, cẩu thả.","example":"They cobbled a few pages together and submitted it.","exampleTranslation":"Họ đã lắp ráp vội vã vài trang tài liệu và nộp nó.","rootVerb":"cobble","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"come in":{"definition":"Vị trí hoặc thứ hạng trong một cuộc thi, v.v.","example":"I did my best but came in last but one in the race.","exampleTranslation":"Tôi đã cố gắng hết sức nhưng về đích ở vị trí áp chót trong cuộc đua.","rootVerb":"come","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"contract in":{"definition":"Tham gia hoặc cam kết với cái gì đó.","example":"Since it started, many companies have contracted in to lend their support.","exampleTranslation":"Kể từ khi nó bắt đầu, nhiều công ty đã cam kết tham gia để hỗ trợ.","rootVerb":"contract","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"count against":{"definition":"Có tác động tiêu cực, làm giảm khả năng thành công.","example":"Not having a university degree will count against her.","exampleTranslation":"Việc không có bằng đại học sẽ gây bất lợi cho cô ấy.","rootVerb":"count","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"count for":{"definition":"Được công nhận là quan trọng, đáng giá hoặc có giá trị.","example":"Experience counts for a lot in decision making.","exampleTranslation":"Kinh nghiệm đóng vai trò quan trọng trong việc ra quyết định.","rootVerb":"count","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"count off":{"definition":"Đếm số thứ tự.","example":"They counted the students off as they arrived.","exampleTranslation":"Họ đã đếm số thứ tự của các sinh viên khi họ đến.","rootVerb":"count","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"cover for":{"definition":"Làm thay công việc của ai đó khi họ vắng mặt tạm thời.","example":"I covered for her while she was off sick.","exampleTranslation":"Tôi đã làm thay công việc cho cô ấy khi cô ấy nghỉ ốm.","rootVerb":"cover","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"crack on":{"definition":"Tiếp tục làm việc gì đó một cách đầy năng lượng.","example":"We had to crack on to get everything finished on time.","exampleTranslation":"Chúng tôi đã phải tiếp tục làm việc một cách đầy năng lượng để hoàn thành mọi thứ đúng hạn.","rootVerb":"crack","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"crank out":{"definition":"Sản xuất nhanh số lượng lớn.","example":"My boss keeps cranking out stupid memos.","exampleTranslation":"Sếp tôi cứ liên tục sản xuất ra những bản ghi nhớ ngớ ngẩn.","rootVerb":"crank","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"cross off":{"definition":"Xóa khỏi danh sách.","example":"She crossed him off her Christmas card list after they argued.","exampleTranslation":"Cô ấy đã xóa tên anh ta khỏi danh sách gửi thiệp Giáng sinh của mình sau khi họ cãi nhau.","rootVerb":"cross","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"cross out":{"definition":"Gạch bỏ chữ viết.","example":"She crossed out her mistakes and wrote the correct answers above them.","exampleTranslation":"Cô ấy đã gạch bỏ những lỗi sai của mình và viết câu trả lời đúng lên phía trên chúng.","rootVerb":"cross","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"cruise through":{"definition":"Vượt qua dễ dàng.","example":"He cruised through the exam.","exampleTranslation":"Anh ấy đã vượt qua bài thi một cách dễ dàng.","rootVerb":"cruise","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"dash off":{"definition":"Làm gì đó nhanh chóng, đặc biệt là viết.","example":"He dashed off the report in a couple of hours.","exampleTranslation":"Anh ấy đã viết nhanh bản báo cáo trong vòng vài giờ.","rootVerb":"dash","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"dig into":{"definition":"Thò tay vào trong để lấy thứ gì đó.","example":"She dug into her handbag and pulled out a bunch of keys.","exampleTranslation":"Cô ấy đã thò tay vào túi xách của mình và lấy ra một chùm chìa khóa.","rootVerb":"dig","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"dip into":{"definition":"Đọc lướt một vài phần của cuốn sách.","example":"I've been dipping into the book, but haven't read it properly.","exampleTranslation":"Tôi đã đọc lướt một vài phần của cuốn sách, nhưng chưa đọc nó một cách cẩn thận.","rootVerb":"dip","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"dive in":{"definition":"Lao vào làm gì đó (thường không có kế hoạch).","example":"When we saw what was happening, we all dived in to help.","exampleTranslation":"Khi thấy chuyện gì đang xảy ra, tất cả chúng tôi đều lao vào để giúp đỡ.","rootVerb":"dive","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"dive into":{"definition":"Thò tay nhanh vào thứ gì đó.","example":"She dived into her bag and pulled out a lighter.","exampleTranslation":"Cô ấy thò tay nhanh vào túi của mình và lấy ra một chiếc bật lửa.","rootVerb":"dive","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"doss about":{"definition":"Làm việc vô bổ, lãng phí thời gian.","example":"I couldn't get down to my work and dossed about all night.","exampleTranslation":"Tôi đã không thể tập trung vào công việc và đã lãng phí thời gian cả đêm.","rootVerb":"doss","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"doss around":{"definition":"Làm việc vô bổ, lãng phí thời gian.","example":"I spent the afternoon dossing around.","exampleTranslation":"Tôi đã dành cả buổi chiều để làm những việc vô bổ.","rootVerb":"doss","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"draw out":{"definition":"Kéo dài cái gì đó một cách không cần thiết.","example":"The director drew the meeting out with a lengthy speech.","exampleTranslation":"Vị giám đốc đã kéo dài cuộc họp bằng một bài phát biểu dài dòng.","rootVerb":"draw","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"draw up":{"definition":"Soạn thảo hợp đồng.","example":"The contract was drawn up by our solicitor.","exampleTranslation":"Hợp đồng đã được soạn thảo bởi luật sư của chúng tôi.","rootVerb":"draw","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"drill down through":{"definition":"Đào sâu vào chi tiết, lấy dữ liệu cụ thể.","example":"They drilled down through the information to find the truth.","exampleTranslation":"Họ đã đào sâu vào dữ liệu thông tin để tìm ra sự thật.","rootVerb":"drill","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"drill into":{"definition":"Nhồi nhét, lặp đi lặp lại để ai đó nhớ.","example":"The teacher drilled the rules into the students.","exampleTranslation":"Giáo viên đã nhồi nhét, lặp đi lặp lại các quy tắc cho học sinh để các em ghi nhớ.","rootVerb":"drill","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"drum into":{"definition":"Nhồi nhét vào đầu ai đó.","example":"They drum all the traps into you before the test, so you can't go wrong.","exampleTranslation":"Họ nhồi nhét mọi bẫy vào đầu bạn trước bài kiểm tra, để bạn không thể làm sai.","rootVerb":"drum","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"drum out":{"definition":"Cách chức, đuổi việc.","example":"The company decided to drum out the lazy worker.","exampleTranslation":"Công ty đã quyết định đuổi việc người công nhân lười biếng đó.","rootVerb":"drum","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"edge out":{"definition":"Gạt ra rìa, đẩy ra khỏi vị trí.","example":"The shareholders edged the CEO out because results were getting worse.","exampleTranslation":"Các cổ đông đã gạt vị CEO ra vì kết quả kinh doanh ngày càng tệ đi.","rootVerb":"edge","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"embark on":{"definition":"Bắt tay vào một dự án.","example":"Piere embarked on an mba at Insead last autumn.","exampleTranslation":"Piere đã bắt tay vào học chương trình thạc sĩ quản trị kinh doanh tại Insead vào mùa thu năm ngoái.","rootVerb":"embark","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"embark upon":{"definition":"Bắt tay vào một dự án.","example":"Fernanda has just embarked upon a new professional challenge.","exampleTranslation":"Fernanda vừa mới bắt tay vào một thử thách nghề nghiệp mới.","rootVerb":"embark","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"enter for":{"definition":"Tham gia một cuộc thi.","example":"They entered for the national championship but weren't good enough.","exampleTranslation":"Họ đã đăng ký tham gia giải vô địch quốc gia nhưng không đủ trình độ.","rootVerb":"enter","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"faff about":{"definition":"Cư xử thiếu quyết đoán.","example":"He told her to stop faffing about and make her mind up.","exampleTranslation":"Anh ấy bảo cô ấy hãy ngừng cư xử thiếu quyết đoán và đưa ra quyết định đi.","rootVerb":"faff","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"faff around":{"definition":"Cư xử thiếu quyết đoán.","example":"She told him to stop faffing around and make his mind up.","exampleTranslation":"Cô ấy bảo anh ấy hãy ngừng cư xử thiếu quyết đoán và đưa ra quyết định đi.","rootVerb":"faff","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"fall into":{"definition":"Bắt đầu làm việc gì đó một cách tình cờ.","example":"I just fell into my job when an opportunity came up.","exampleTranslation":"Tôi tình cờ có được công việc đó khi có cơ hội đến.","rootVerb":"fall","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"farm out":{"definition":"Giao hoặc khoán công việc cho người khác.","example":"The company wants to farm out their maintenance.","exampleTranslation":"Công ty muốn thuê ngoài việc bảo trì của họ.","rootVerb":"farm","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"fiddle about":{"definition":"Lãng phí thời gian làm những việc ngớ ngẩn hoặc làm những việc không thành công.","example":"He likes to fiddle about instead of actually working hard.","exampleTranslation":"Anh ấy thích làm những việc vặt vãnh thay vì thực sự làm việc chăm chỉ.","rootVerb":"fiddle","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"figure on":{"definition":"Lên kế hoạch, mong đợi.","example":"What job do you figure on doing when you graduate?","exampleTranslation":"Bạn định làm công việc gì khi tốt nghiệp?","rootVerb":"figure","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"fill in for":{"definition":"Làm thay.","example":"I was away for a few days, so they had to get someone to fill in for me.","exampleTranslation":"Tôi đã đi vắng vài ngày, nên họ phải tìm người làm thay cho tôi.","rootVerb":"fill","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"fill out":{"definition":"Điền vào một mẫu đơn.","example":"I filled out the application form and mailed it.","exampleTranslation":"Tôi đã điền vào đơn đăng ký và gửi đi.","rootVerb":"fill","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"finish up with":{"definition":"Có hoặc làm điều gì đó vào cuối cùng.","example":"We attended some workshops and finished up with the keynote speaker.","exampleTranslation":"Chúng tôi đã tham dự một số hội thảo và kết thúc bằng bài phát biểu của diễn giả chính.","rootVerb":"finish","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"firm up":{"definition":"Làm cho mọi thứ rõ ràng hơn trong một cuộc đàm phán hoặc thảo luận.","example":"We need to firm up some aspects of the contract before we sign it.","exampleTranslation":"Chúng ta cần làm rõ một số khía cạnh của hợp đồng trước khi ký.","rootVerb":"firm","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"fit in":{"definition":"Có đủ thời gian hoặc không gian cho việc gì đó.","example":"I didn't have time to fit in another appointment.","exampleTranslation":"Tôi đã không có thời gian để sắp xếp thêm một cuộc hẹn nữa.","rootVerb":"fit","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"flame out":{"definition":"Thất bại.","example":"The company flamed out in the recession.","exampleTranslation":"Công ty đã thất bại trong thời kỳ suy thoái.","rootVerb":"flame","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"flesh out":{"definition":"Thêm chi tiết hoặc thông tin.","example":"The recent government report fleshed out the draft proposals.","exampleTranslation":"Báo cáo gần đây của chính phủ đã bổ sung chi tiết cho các đề xuất dự thảo.","rootVerb":"flesh","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"focus on":{"definition":"Tập trung.","example":"The report focuses on the company's weak points.","exampleTranslation":"Báo cáo tập trung vào các điểm yếu của công ty.","rootVerb":"focus","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"follow on":{"definition":"Trong môn cricket, nếu đội thứ hai đánh bóng không ghi đủ điểm, đội đó phải đánh bóng lại.","example":"They were over 200 runs behind and had to follow on.","exampleTranslation":"Họ bị dẫn trước hơn 200 điểm và phải đánh bóng lại.","rootVerb":"follow","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"follow on from":{"definition":"Là một phần tiếp theo của điều gì đó.","example":"The film follows on from the original.","exampleTranslation":"Bộ phim này là phần tiếp theo của bộ phim gốc.","rootVerb":"follow","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"follow through":{"definition":"Làm những gì cần thiết để hoàn thành hoặc làm cho một việc thành công.","example":"The project went wrong when the staff failed to follow through.","exampleTranslation":"Dự án đã gặp trục trặc khi nhân viên không thực hiện đến cùng công việc.","rootVerb":"follow","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"follow up":{"definition":"Làm điều gì đó để kiểm tra hoặc cải thiện một hành động trước đó.","example":"He followed up the meeting with a report.","exampleTranslation":"Anh ấy đã gửi một bản báo cáo sau buổi họp để kiểm tra tiến độ.","rootVerb":"follow","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"fool around":{"definition":"Không nghiêm túc.","example":"The teacher was angry because the class were fooling around.","exampleTranslation":"Giáo viên tức giận vì cả lớp đang nghịch ngợm thay vì học.","rootVerb":"fool","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"free up":{"definition":"Làm công việc hoặc nhiệm vụ cho ai đó để họ có thời gian rảnh rỗi làm việc khác.","example":"If you proofread this text, it will free me up to get on with the next part.","exampleTranslation":"Nếu bạn soát lỗi văn bản này, nó sẽ giúp tôi rảnh tay để tiếp tục phần tiếp theo.","rootVerb":"free","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"gear to":{"definition":"Sắp xếp, tổ chức cho một mục đích, đối tượng cụ thể.","example":"It's not geared to non-specialists.","exampleTranslation":"Nó không được thiết kế cho những người không chuyên.","rootVerb":"gear","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"gear up":{"definition":"Chuẩn bị sẵn sàng cho một thời kỳ bận rộn.","example":"The shops are gearing up for the New Year sales.","exampleTranslation":"Các cửa hàng đang chuẩn bị sẵn sàng cho đợt giảm giá Năm mới.","rootVerb":"gear","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"get along in":{"definition":"Tiến bộ, thăng tiến.","example":"How are you getting along in the company.","exampleTranslation":"Bạn đang tiến triển thế nào trong công ty?","rootVerb":"get","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"get around to":{"definition":"Cuối cùng cũng xoay xở làm được việc gì đó, dành thời gian cho việc gì đó.","example":"It always takes me ages to get around to replying to letters.","exampleTranslation":"Tôi luôn mất rất nhiều thời gian mới xoay xở trả lời được các bức thư.","rootVerb":"get","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"get down to":{"definition":"Bắt đầu làm việc nghiêm túc, bắt tay vào việc.","example":"I find it extremely difficult to get down to doing any revision for examinations.","exampleTranslation":"Tôi thấy cực kỳ khó khăn để bắt tay vào ôn tập cho các kỳ thi.","rootVerb":"get","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"get in on":{"definition":"Tham gia, dính líu vào.","example":"The company tried to get in on our market.","exampleTranslation":"Công ty đã cố gắng tham gia vào thị trường của chúng tôi.","rootVerb":"get","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"get on with":{"definition":"Tiếp tục hoặc bắt đầu làm việc gì.","example":"She told us to get on with our work.","exampleTranslation":"Cô ấy bảo chúng tôi tiếp tục làm việc của mình.","rootVerb":"get","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go ahead with":{"definition":"Tiếp tục tiến hành.","example":"We now intend to go ahead with the final stage of the project despite the protests from environmentalists.","exampleTranslation":"Bất chấp sự phản đối của các nhà môi trường, chúng tôi dự định tiếp tục tiến hành giai đoạn cuối của dự án.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go down to":{"definition":"Bị đánh bại bởi.","example":"Chelsea went down to Arsenal in a thrilling game.","exampleTranslation":"Chelsea đã thất bại trước Arsenal trong một trận đấu kịch tính.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go in for":{"definition":"Tham gia một cuộc thi hoặc kỳ thi.","example":"He went in for the photography prize, but didn't win.","exampleTranslation":"Anh ấy đã đăng ký tham gia cuộc thi nhiếp ảnh, nhưng không thắng.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go in with":{"definition":"Thành lập liên minh hoặc liên kết.","example":"They're going to go in with the Social Democrats.","exampleTranslation":"Họ định thành lập liên minh với Đảng Dân chủ Xã hội.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go into":{"definition":"Bước vào một nghề nghiệp, bệnh viện, thương mại, thị trường.","example":"She went into banking after she'd finished university.","exampleTranslation":"Cô ấy bước vào ngành ngân hàng sau khi tốt nghiệp đại học.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go on with":{"definition":"Tiếp tục làm.","example":"Please go on with your work.","exampleTranslation":"Xin hãy tiếp tục làm công việc của bạn.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go out":{"definition":"Bị loại trong một cuộc thi.","example":"England went out in the second round.","exampleTranslation":"Anh đã bị loại ở vòng hai.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go out for":{"definition":"Trở thành ứng cử viên, đăng ký tham gia.","example":"She went out for a place on the team.","exampleTranslation":"Cô ấy đã đăng ký để giành một vị trí trong đội.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"go up to":{"definition":"Bắt đầu học đại học.","example":"She went up to Cambridge after she finished secondary school.","exampleTranslation":"Cô ấy bắt đầu học đại học ở Cambridge sau khi học xong trung học.","rootVerb":"go","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"goof off":{"definition":"Trốn việc.","example":"We goofed off for the afternoon to watch the match.","exampleTranslation":"Chúng tôi đã trốn việc cả buổi chiều để xem trận đấu.","rootVerb":"goof","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"grind out":{"definition":"Sản xuất hoặc làm ra thứ gì đó một cách khó khăn.","example":"I find it very hard to grind out an original essay every week.","exampleTranslation":"Tôi thấy rất khó để vắt óc viết ra một bài luận mới lạ mỗi tuần.","rootVerb":"grind","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"gun for":{"definition":"Cố gắng tiêu diệt hoặc đánh bại một đối thủ.","example":"He's gunning for his rivals at work.","exampleTranslation":"Anh ta đang cố gắng đánh bại các đối thủ cạnh tranh tại nơi làm việc.","rootVerb":"gun","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hammer away at":{"definition":"Làm việc không ngừng nghỉ.","example":"She hammered away at her PC all night and finished the project.","exampleTranslation":"Cô ấy làm việc không ngừng nghỉ trên máy tính cả đêm và đã hoàn thành dự án.","rootVerb":"hammer","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hammer into":{"definition":"Lặp lại điều gì đó trong một khoảng thời gian để làm cho ai đó nhớ.","example":"He hammered the rules into me.","exampleTranslation":"Ông ấy đã lặp đi lặp lại các quy tắc để bắt tôi phải nhớ.","rootVerb":"hammer","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hand back":{"definition":"Trả lại.","example":"The police officer checked my licence, then handed it back.","exampleTranslation":"Viên cảnh sát kiểm tra giấy phép của tôi, sau đó trả lại nó.","rootVerb":"hand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hand down":{"definition":"Đưa ra một quyết định chính thức.","example":"The court handed down its ruling yesterday.","exampleTranslation":"Tòa án đã đưa ra phán quyết vào ngày hôm qua.","rootVerb":"hand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hand over":{"definition":"Giao nộp, đưa cho.","example":"The robbers told the clerk to hand over all the money.","exampleTranslation":"Những tên cướp bảo nhân viên giao nộp tất cả tiền.","rootVerb":"hand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hang it up":{"definition":"Nghỉ hưu, từ bỏ.","example":"I’m getting too old for this- I’m going to hang IT up starting next month.","exampleTranslation":"Tôi bắt đầu thấy mình quá già cho việc này rồi - tôi sẽ nghỉ hưu bắt đầu từ tháng tới.","rootVerb":"hang","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hang together":{"definition":"Cùng làm việc, gắn kết khi gặp khó khăn.","example":"We have to hang together if we're going to finish this project.","exampleTranslation":"Chúng ta phải cùng nhau làm việc nếu muốn hoàn thành dự án này.","rootVerb":"hang","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"has to":{"definition":"Phải, có bổn phận phải, bắt buộc phải.","example":"She has to finish her homework tonight.","exampleTranslation":"Cô ấy phải hoàn thành bài tập về nhà tối nay.","rootVerb":"has","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"have off":{"definition":"Nghỉ phép làm việc.","example":"I had a couple of days off last week to relax.","exampleTranslation":"Tôi đã được nghỉ phép một vài ngày vào tuần trước để thư giãn.","rootVerb":"have","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"head up":{"definition":"Phụ trách.","example":"He's heading up the steering committee.","exampleTranslation":"Anh ấy đang phụ trách ủy ban chỉ đạo.","rootVerb":"head","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hold back":{"definition":"Ngăn chặn điều gì đó tiến lên phía trước hoặc phát triển.","example":"Lack of funding held the project back.","exampleTranslation":"Việc thiếu kinh phí đã kìm hãm sự phát triển của dự án.","rootVerb":"hold","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hold over":{"definition":"Tiếp tục làm việc gì đó lâu hơn dự định.","example":"It has been so successful that they have held it over for another fortnight.","exampleTranslation":"Nó đã thành công đến mức họ đã giữ lại nó thêm hai tuần nữa.","rootVerb":"hold","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"horse around":{"definition":"Không nghiêm túc.","example":"The class were horsing around when the teacher came in and told them to sit down.","exampleTranslation":"Cả lớp đang đùa nghịch khi giáo viên bước vào và bảo họ ngồi xuống.","rootVerb":"horse","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"hound out":{"definition":"Buộc ai đó phải rời khỏi một nơi, một công việc, một vị trí, v.v..","example":"The press hounded the minister out after the scandal broke.","exampleTranslation":"Báo chí đã buộc vị bộ trưởng phải rời khỏi vị trí sau khi vụ bê bối bị vỡ lở.","rootVerb":"hound","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"jack in":{"definition":"Từ bỏ, bỏ cuộc.","example":"I jacked my job in because my boss refused to give me a raise.","exampleTranslation":"Tôi đã từ bỏ công việc của mình vì sếp từ chối tăng lương cho tôi.","rootVerb":"jack","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"jerk off":{"definition":"Lãng phí thời gian làm những việc không quan trọng.","example":"You should get your work done and stop jerking off.","exampleTranslation":"Bạn nên hoàn thành công việc của mình và đừng lãng phí thời gian nữa.","rootVerb":"jerk","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"keep at":{"definition":"Tiếp tục với một cái gì đó khó khăn.","example":"She found the course hard but she kept at it and completed it successfully.","exampleTranslation":"Cô ấy thấy khóa học rất khó nhưng cô ấy vẫn kiên trì và hoàn thành nó một cách thành công.","rootVerb":"keep","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"keep in":{"definition":"Không cho ai đó ra ngoài.","example":"The teacher kept the students in after school because they had misbehaved.","exampleTranslation":"Giáo viên đã giữ các học sinh lại sau giờ học vì các em đã cư xử không tốt.","rootVerb":"keep","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"keep on":{"definition":"Tiếp tục.","example":"He kept on trying and succeeded in the end.","exampleTranslation":"Anh ấy đã tiếp tục cố gắng và cuối cùng đã thành công.","rootVerb":"keep","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"keep up at":{"definition":"Tiếp tục, không bỏ cuộc.","example":"Learning a language is difficult, but if you keep up at it, you'll succeed in the end.","exampleTranslation":"Học một ngôn ngữ thật khó, nhưng nếu bạn tiếp tục kiên trì thì cuối cùng sẽ thành công.","rootVerb":"keep","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"keep up with":{"definition":"Di chuyển với cùng một tốc độ.","example":"He walks too fast and it's really hard to keep up with him.","exampleTranslation":"Anh ấy đi bộ quá nhanh và rất khó để theo kịp anh ấy.","rootVerb":"keep","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"knock off":{"definition":"Sản xuất hoặc tạo ra thứ gì đó nhanh chóng.","example":"I knocked the essay off in an hour.","exampleTranslation":"Tôi đã làm xong bài luận trong một giờ.","rootVerb":"knock","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"knock up":{"definition":"Chơi khởi động trước một trận đấu.","example":"The teams knocked up for a few minutes before the final.","exampleTranslation":"Các đội đã chơi khởi động trong vài phút trước trận chung kết.","rootVerb":"knock","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"knuckle down":{"definition":"Nỗ lực lớn.","example":"I've got my exams next week and I haven't done much work, so I'd better knuckle down.","exampleTranslation":"Tôi có kỳ thi vào tuần tới và tôi vẫn chưa làm được nhiều việc, vì vậy tốt hơn là tôi nên nỗ lực lớn thôi.","rootVerb":"knuckle","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"knuckle under":{"definition":"Tuân phục quyền lực.","example":"The teacher made the students knuckle under and hand their projects in on time.","exampleTranslation":"Giáo viên đã bắt các học sinh phải tuân phục và nộp dự án đúng hạn.","rootVerb":"knuckle","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"lark around":{"definition":"Cư xử ngớ ngẩn, đùa nghịch.","example":"The students wouldn't stop larking around.","exampleTranslation":"Các học sinh cứ không ngừng đùa nghịch.","rootVerb":"lark","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"lay off":{"definition":"Sa thải nhân viên.","example":"The hotel laid off twenty staff because tourist numbers were down.","exampleTranslation":"Khách sạn đã sa thải hai mươi nhân viên vì lượng khách du lịch giảm sút.","rootVerb":"lay","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"lay on":{"definition":"Tổ chức, cung cấp.","example":"They laid on a buffet lunch at the conference.","exampleTranslation":"Họ đã tổ chức một bữa trưa tự chọn tại hội nghị.","rootVerb":"lay","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"leave out":{"definition":"Bỏ sót, không đưa vào.","example":"He was left out of the side because he hasn't been playing too well lately.","exampleTranslation":"Anh ấy đã bị bỏ sót khỏi đội vì gần đây anh ấy chơi không tốt lắm.","rootVerb":"leave","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"limber up for":{"definition":"Chuẩn bị cho điều gì đó đòi hỏi nhiều nỗ lực.","example":"They are limbering up for the end of the financial year.","exampleTranslation":"Họ đang chuẩn bị cho thời điểm cuối năm tài chính đầy đòi hỏi.","rootVerb":"limber","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"line up":{"definition":"Sắp xếp sự kiện cho ai đó.","example":"We have lined up a lot of meetings for them.","exampleTranslation":"Chúng tôi đã sắp xếp rất nhiều cuộc họp cho họ.","rootVerb":"line","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"look over":{"definition":"Kiểm tra, xem xét.","example":"They came to look the house over with a view to buying it.","exampleTranslation":"Họ đã đến để kiểm tra ngôi nhà với ý định mua nó.","rootVerb":"look","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"look through":{"definition":"Đọc lướt qua.","example":"I looked through the article.","exampleTranslation":"Tôi đã đọc lướt qua bài báo.","rootVerb":"look","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"mark down":{"definition":"Cho điểm thấp vì lý do nào đó.","example":"Students who gave obviously rehearsed answers were marked down, while those who spoke naturally were rewarded accordingly.","exampleTranslation":"Những học sinh đưa ra câu trả lời được chuẩn bị sẵn rõ ràng đã bị cho điểm thấp, trong khi những người nói một cách tự nhiên thì được khen thưởng tương xứng.","rootVerb":"mark","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"mark off":{"definition":"Đánh dấu để cho thấy đã hoàn thành.","example":"I marked off the items on the list as I finished them.","exampleTranslation":"Tôi đã đánh dấu các mục trong danh sách khi tôi hoàn thành chúng.","rootVerb":"mark","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"mark out":{"definition":"Vẽ đường giới hạn khu vực.","example":"They marked out the pitch.","exampleTranslation":"Họ đã vẽ đường giới hạn cho sân bóng.","rootVerb":"mark","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"measure against":{"definition":"Đánh giá bằng cách so sánh.","example":"The work doesn't look good if you measure it against what our competitors have done.","exampleTranslation":"Công việc trông không tốt nếu bạn đánh giá nó bằng cách so sánh với những gì đối thủ cạnh tranh của chúng ta đã làm.","rootVerb":"measure","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"measure off":{"definition":"Đo và đánh dấu điểm kết thúc.","example":"The tailor measured off the material for my suit.","exampleTranslation":"Người thợ may đã đo và đánh dấu phần vải cho bộ đồ của tôi.","rootVerb":"measure","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"measure out":{"definition":"Cân hoặc đo chính xác.","example":"She measured out a hundred grammes of the powder.","exampleTranslation":"Cô ấy đã đong chính xác một trăm gram bột.","rootVerb":"measure","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"mock up":{"definition":"Làm mô hình thử nghiệm.","example":"They mocked up an example to show us what they would look like.","exampleTranslation":"Họ đã làm một mô hình thử nghiệm để cho chúng tôi thấy nó sẽ trông như thế nào.","rootVerb":"mock","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"move down":{"definition":"Chuyển học sinh xuống cấp độ thấp hơn.","example":"He was finding the course too difficult so they moved him down.","exampleTranslation":"Anh ấy thấy khóa học quá khó nên họ đã chuyển anh ấy xuống cấp độ thấp hơn.","rootVerb":"move","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"move up":{"definition":"Di chuyển lên vị trí cao hơn.","example":"They moved her up to senior management.","exampleTranslation":"Họ đã chuyển cô ấy lên vị trí quản lý cấp cao.","rootVerb":"move","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"mug up":{"definition":"Học nhồi nhét.","example":"I have to mug up before the exam.","exampleTranslation":"Tôi phải học nhồi nhét trước kỳ thi.","rootVerb":"mug","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"mug up on":{"definition":"Ôn tập nhanh điều gì.","example":"I need to mug up on my history for the test.","exampleTranslation":"Tôi cần ôn tập nhanh kiến thức lịch sử của mình cho bài kiểm tra.","rootVerb":"mug","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"nail down":{"definition":"Lấy thông tin đầy đủ.","example":"I can't nail them down about when they're going to finish the project.","exampleTranslation":"Tôi không thể ép họ đưa ra thông tin đầy đủ về thời điểm họ sẽ hoàn thành dự án.","rootVerb":"nail","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"nose around":{"definition":"Nhìn quanh tìm bằng chứng.","example":"The boss keeps nosing around our office when we are out at lunch.","exampleTranslation":"Sếp cứ lảng vảng quanh văn phòng chúng tôi khi chúng tôi đi ăn trưa.","rootVerb":"nose","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"nose out":{"definition":"Đánh bại trong gang tấc.","example":"The other candidate nosed him out by a few votes.","exampleTranslation":"Ứng viên kia đã đánh bại anh ấy trong gang tấc với vài phiếu bầu.","rootVerb":"nose","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"note down":{"definition":"Ghi chép lại.","example":"She noted down my fax number so that she could send me the documents when she got to the office.","exampleTranslation":"Cô ấy đã ghi chép lại số fax của tôi để có thể gửi tài liệu cho tôi khi cô ấy đến văn phòng.","rootVerb":"note","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pair up":{"definition":"Ghép thành một cặp.","example":"We should pair up to finish this project faster.","exampleTranslation":"Chúng ta nên ghép cặp với nhau để hoàn thành dự án này nhanh hơn.","rootVerb":"pair","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pass back":{"definition":"Trả lại.","example":"I felt awful when the teacher started to pass back the exam papers.","exampleTranslation":"Tôi cảm thấy thật tệ khi giáo viên bắt đầu trả lại các bài kiểm tra.","rootVerb":"pass","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pass over":{"definition":"Phớt lờ ai đó và trao một công việc, phần thưởng, v.v. cho một người cấp dưới hơn.","example":"They passed him over and made his assistant the new director.","exampleTranslation":"Họ đã phớt lờ anh ấy và bổ nhiệm trợ lý của anh ấy làm giám đốc mới.","rootVerb":"pass","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pencil in":{"definition":"Thực hiện một cuộc hẹn tạm thời.","example":"I'll pencil Thursday night in, but if anything comes up, give me a ring.","exampleTranslation":"Tôi sẽ tạm ghi lịch tối thứ Năm, nhưng nếu có chuyện gì phát sinh, hãy gọi cho tôi.","rootVerb":"pencil","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"phase in":{"definition":"Giới thiệu dần dần.","example":"They are phasing in the reforms over the next two years.","exampleTranslation":"Họ đang giới thiệu dần dần các cải cách trong vòng hai năm tới.","rootVerb":"phase","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"phase out":{"definition":"Loại bỏ dần dần.","example":"They have introduced a compact edition of the newspaper and are phasing out the broadsheet edition over the next few months.","exampleTranslation":"Họ đã giới thiệu một phiên bản nhỏ gọn của tờ báo và đang loại bỏ dần dần phiên bản khổ lớn trong vài tháng tới.","rootVerb":"phase","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pitch for":{"definition":"Cố gắng thuyết phục ai đó giao cho bạn công việc, dự án, v.v.","example":"He pitched for the job, but they gave it to someone else.","exampleTranslation":"Anh ấy đã cố gắng thuyết phục họ giao cho mình công việc, nhưng họ đã trao nó cho người khác.","rootVerb":"pitch","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pitch in":{"definition":"Cùng nhau làm việc để giúp đạt được mục tiêu.","example":"We were behind schedule, but the others pitched in and we got it done in time.","exampleTranslation":"Chúng tôi đã bị chậm tiến độ, nhưng những người khác đã cùng chung tay làm và chúng tôi đã hoàn thành kịp thời.","rootVerb":"pitch","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"plough on":{"definition":"Tiếp tục làm điều bạn không muốn.","example":"It was really boring, but we ploughed on.","exampleTranslation":"Việc đó thực sự rất nhàm chán, nhưng chúng tôi vẫn tiếp tục làm.","rootVerb":"plough","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"plow through":{"definition":"Đọc một cái gì đó khó hoặc mất nhiều thời gian.","example":"It takes me ages to plow through any of Henry James' novels.","exampleTranslation":"Tôi mất rất nhiều thời gian để đọc xong bất kỳ cuốn tiểu thuyết nào của Henry James.","rootVerb":"plow","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"polish up":{"definition":"Cải thiện","example":"I need to polish up my French before I go to Paris.","exampleTranslation":"Tôi cần cải thiện trình độ tiếng Pháp của mình trước khi đến Paris.","rootVerb":"polish","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pore over":{"definition":"Đọc, xem xét hoặc nghiên cứu kỹ lưỡng.","example":"She pored over the report looking for mistakes.","exampleTranslation":"Cô ấy đã đọc kỹ lưỡng bản báo cáo để tìm kiếm lỗi sai.","rootVerb":"pore","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"press for":{"definition":"Gây áp lực để được phép hoặc đạt được điều gì.","example":"The workers are pressing for better pay and conditions.","exampleTranslation":"Những người công nhân đang gây áp lực để được tăng lương và cải thiện điều kiện làm việc.","rootVerb":"press","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"press forward with":{"definition":"Tiếp tục hoặc tiến hành một dự án, quy trình, kế hoạch, v.v.","example":"The government are pressing forward with the new law.","exampleTranslation":"Chính phủ đang tiếp tục tiến hành với bộ luật mới.","rootVerb":"press","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"press into":{"definition":"Đưa vào sử dụng","example":"When the line was breached, reserve troops were pressed into service.","exampleTranslation":"Khi tuyến phòng thủ bị phá vỡ, quân dự bị đã được đưa vào sử dụng.","rootVerb":"press","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"press on":{"definition":"Tiếp tục với cái gì đó.","example":"We pressed on to get to our destination before night fell.","exampleTranslation":"Chúng tôi tiếp tục lên đường để đến đích trước khi trời tối.","rootVerb":"press","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"pull together":{"definition":"Làm việc cùng nhau","example":"If we all pull together, we'll have it finished in no time.","exampleTranslation":"Nếu tất cả chúng ta cùng làm việc với nhau, chúng ta sẽ hoàn thành nó trong thời gian ngắn.","rootVerb":"pull","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"put in for":{"definition":"Đưa ra yêu cầu.","example":"He put in for a transfer to the new branch.","exampleTranslation":"Anh ấy đã đưa ra yêu cầu chuyển công tác sang chi nhánh mới.","rootVerb":"put","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"put up":{"definition":"Thể hiện kỹ năng hoặc quyết tâm trong một cuộc thi, trận đấu, v.v.","example":"They put up a great fight but lost.","exampleTranslation":"Họ đã thể hiện một sự chiến đấu quyết liệt nhưng vẫn thua.","rootVerb":"put","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"reach out for":{"definition":"Cố gắng đạt được điều gì đó khó khăn.","example":"They are reaching out for major economic reforms.","exampleTranslation":"Họ đang cố gắng đạt được những cải cách kinh tế lớn.","rootVerb":"reach","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"read up on":{"definition":"Nghiên cứu.","example":"I've been reading up on Japan as I'm going to live there next year.","exampleTranslation":"Tôi đã và đang nghiên cứu về Nhật Bản vì tôi sẽ sống ở đó vào năm tới.","rootVerb":"read","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"report to":{"definition":"Báo cáo công việc cho (cấp trên trực tiếp).","example":"In my new role, I report directly to the marketing director.","exampleTranslation":"Trong vai trò mới của mình, tôi báo cáo trực tiếp cho giám đốc tiếp thị.","rootVerb":"report","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"ride on":{"definition":"Phụ thuộc vào.","example":"His reputation is riding on this deal working out.","exampleTranslation":"Danh tiếng của anh ấy phụ thuộc vào việc thỏa thuận này có thành công hay không.","rootVerb":"ride","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"romp through":{"definition":"Làm việc gì đó một cách dễ dàng hoặc nhanh chóng.","example":"We romped through the tasks because they were so simple.","exampleTranslation":"Chúng tôi đã hoàn thành các nhiệm vụ một cách dễ dàng vì chúng quá đơn giản.","rootVerb":"romp","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"rope in":{"definition":"Nhờ ai đó giúp đỡ.","example":"The teacher roped her students in to carry her stuff when she had to change classroom.","exampleTranslation":"Giáo viên đã nhờ học sinh giúp đỡ mang đồ đạc khi cô phải đổi phòng học.","rootVerb":"rope","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"rope into":{"definition":"Nhờ ai đó giúp đỡ hoặc tham gia, thường là khi họ không muốn.","example":"I got roped into helping them set the stall up.","exampleTranslation":"Tôi bị nhờ giúp họ dựng gian hàng, mặc dù tôi không muốn.","rootVerb":"rope","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"round off":{"definition":"Hoàn thành một việc gì đó một cách thỏa đáng.","example":"Winning the fa Cup rounded off a wonderful season for Arsenal.","exampleTranslation":"Việc giành chiến thắng tại FA Cup đã khép lại một mùa giải tuyệt vời cho Arsenal.","rootVerb":"round","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"rub up on":{"definition":"Ôn lại.","example":"I need to rub up on my Portuguese before I go to Brazil.","exampleTranslation":"Tôi cần ôn lại tiếng Bồ Đào Nha của mình trước khi đi Brazil.","rootVerb":"rub","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"run against":{"definition":"Phản đối, gây khó khăn.","example":"Opinion is running against his policies and he has very little support.","exampleTranslation":"Dư luận đang phản đối các chính sách của ông ấy và ông ấy có rất ít sự ủng hộ.","rootVerb":"run","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"run for":{"definition":"Tranh cử cho một chức vụ.","example":"She's thinking about running for the presidency.","exampleTranslation":"Cô ấy đang suy nghĩ về việc tranh cử chức tổng thống.","rootVerb":"run","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"run off":{"definition":"Tạo các bản photocopy.","example":"Could you run off two hundred copies of this report, please.","exampleTranslation":"Bạn có thể tạo cho tôi hai trăm bản sao của bản báo cáo này được không.","rootVerb":"run","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"run over":{"definition":"Vượt quá giới hạn thời gian.","example":"The meeting ran over by twenty minutes.","exampleTranslation":"Cuộc họp đã vượt quá thời gian dự kiến hai mươi phút.","rootVerb":"run","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"run through":{"definition":"Luyện tập một tác phẩm kịch như một vở kịch một cách nhanh chóng.","example":"The cast ran through the play the day before it opened to the public.","exampleTranslation":"Dàn diễn viên đã luyện tập vở kịch một cách nhanh chóng vào ngày trước khi nó ra mắt công chúng.","rootVerb":"run","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"saddle with":{"definition":"Giao cho ai đó một nhiệm vụ hoặc trách nhiệm khó khăn hoặc vất vả.","example":"They saddled me with preparing the visit.","exampleTranslation":"Họ đã giao cho tôi trách nhiệm khó khăn là chuẩn bị cho chuyến thăm.","rootVerb":"saddle","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sail through":{"definition":"Vượt qua một cách dễ dàng, thành công.","example":"He sailed through the final test.","exampleTranslation":"Anh ấy đã vượt qua bài kiểm tra cuối cùng một cách dễ dàng.","rootVerb":"sail","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"scout about":{"definition":"Tìm kiếm một cái gì đó ở những nơi khác nhau.","example":"The company is scouting about for new staff.","exampleTranslation":"Công ty đang tìm kiếm nhân viên mới.","rootVerb":"scout","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"scout up":{"definition":"Cố gắng tìm một người cho một nhiệm vụ hoặc yêu cầu.","example":"We'd better scout up a replacement for her.","exampleTranslation":"Chúng ta tốt hơn nên tìm người thay thế cho cô ấy.","rootVerb":"scout","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"scrape in":{"definition":"Vừa đủ để thành công, vượt qua hoặc được chấp nhận.","example":"The government scraped in with 51% of the votes cast.","exampleTranslation":"Chính phủ đã giành chiến thắng suýt soát với 51% số phiếu bầu.","rootVerb":"scrape","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"scrape into":{"definition":"Được chấp nhận ở một nơi nào đó, nhưng chỉ suýt soát.","example":"She got mediocre grades and just scraped into university.","exampleTranslation":"Cô ấy đạt điểm trung bình và chỉ vừa đủ điểm để vào đại học.","rootVerb":"scrape","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"scrape through":{"definition":"Vượt qua một bài kiểm tra nhưng chỉ suýt soát.","example":"I did no revision and only just scraped through the final exams.","exampleTranslation":"Tôi không ôn tập chút nào và chỉ vừa đủ điểm vượt qua các bài thi cuối kỳ.","rootVerb":"scrape","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"send off":{"definition":"Đuổi một cầu thủ thể thao khỏi trận đấu.","example":"The football striker was sent off for arguing with the referee's decision.","exampleTranslation":"Tiền đạo bóng đá đã bị đuổi khỏi sân vì tranh cãi với quyết định của trọng tài.","rootVerb":"send","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"set about":{"definition":"Bắt đầu làm một việc gì đó.","example":"We set about the cleaning and got it done before lunchtime.","exampleTranslation":"Chúng tôi bắt tay vào việc dọn dẹp và hoàn thành nó trước giờ ăn trưa.","rootVerb":"set","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"set back":{"definition":"Trì hoãn.","example":"The accident set the project back several months.","exampleTranslation":"Tai nạn đã làm trì hoãn dự án vài tháng.","rootVerb":"set","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"set to":{"definition":"Làm việc chăm chỉ hoặc nhiệt tình.","example":"If we all set to, we should be able to finish this in a few hours.","exampleTranslation":"Nếu tất cả chúng ta cùng bắt tay vào làm, chúng ta sẽ có thể hoàn thành việc này trong vài giờ.","rootVerb":"set","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"shade in":{"definition":"Làm cho một phần của bức tranh tối hơn.","example":"She shaded in the area under the tree.","exampleTranslation":"Cô ấy đã tô đậm vùng dưới cái cây.","rootVerb":"shade","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"shake up":{"definition":"Thực hiện những thay đổi lớn để cải thiện hoặc cứu một công ty, tổ chức, v.v.","example":"The management are shaking things up and getting rid of a lot of workers.","exampleTranslation":"Ban quản lý đang thực hiện những thay đổi lớn và loại bỏ rất nhiều công nhân.","rootVerb":"shake","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"shape up":{"definition":"Cải thiện để đạt được tiêu chuẩn có thể chấp nhận được.","example":"If they don't start shaping up, they're going to lose their jobs.","exampleTranslation":"Nếu họ không bắt đầu cải thiện, họ sẽ mất việc.","rootVerb":"shape","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"shoot for":{"definition":"Hướng tới mục tiêu.","example":"I’m shooting for nothing less than the presidency.","exampleTranslation":"Tôi không nhắm tới mục tiêu nào thấp hơn chức chủ tịch.","rootVerb":"shoot","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"show in":{"definition":"Dẫn ai đó vào phòng làm việc hoặc phòng khác.","example":"The secretary showed me in to speak to the manager.","exampleTranslation":"Thư ký đã dẫn tôi vào để nói chuyện với người quản lý.","rootVerb":"show","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"shut out":{"definition":"Không cho người chơi hoặc đội bóng ghi bàn.","example":"The Dodgers shut out the Giants 3-0.","exampleTranslation":"Đội Dodgers đã chặn không cho đội Giants ghi bàn với tỉ số 3-0.","rootVerb":"shut","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sign off":{"definition":"Cho phép ai đó nghỉ việc có giấy chứng nhận.","example":"My doctor signed me off for a month with back problems.","exampleTranslation":"Bác sĩ đã cho tôi nghỉ phép một tháng vì vấn đề đau lưng.","rootVerb":"sign","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sign off on":{"definition":"Chính thức phê duyệt.","example":"The director signed off on the plans to increase sales.","exampleTranslation":"Giám đốc đã chính thức phê duyệt các kế hoạch tăng doanh số.","rootVerb":"sign","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sign on":{"definition":"Mở yêu cầu nhận trợ cấp thất nghiệp.","example":"I had to sign on when I lost my job.","exampleTranslation":"Tôi đã phải đăng ký nhận trợ cấp thất nghiệp khi mất việc.","rootVerb":"sign","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sign on with":{"definition":"Ký hợp đồng tham gia.","example":"He's signed on with Manchester United for the next three years.","exampleTranslation":"Anh ấy đã ký hợp đồng với Manchester United trong ba năm tới.","rootVerb":"sign","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sign up":{"definition":"Ghi danh làm việc gì đó.","example":"I've signed up as a volunteer.","exampleTranslation":"Tôi đã đăng ký làm tình nguyện viên.","rootVerb":"sign","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sign with":{"definition":"Ký hợp đồng với.","example":"She's signed with emi for the next few years.","exampleTranslation":"Cô ấy đã ký hợp đồng với EMI cho vài năm tới.","rootVerb":"sign","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sit for":{"definition":"Làm mẫu chụp ảnh hoặc vẽ.","example":"The Queen sat for another official portrait.","exampleTranslation":"Nữ hoàng đã ngồi làm mẫu cho một bức chân dung chính thức khác.","rootVerb":"sit","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sit in for":{"definition":"Thay thế ai đó làm nhiệm vụ khi họ vắng mặt.","example":"Can you sit in for me at the meeting?","exampleTranslation":"Bạn có thể thay thế tôi tại cuộc họp được không?","rootVerb":"sit","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sit in on":{"definition":"Tham dự với tư cách là quan sát viên.","example":"She sat in on the meeting and took notes but said nothing.","exampleTranslation":"Cô ấy dự thính cuộc họp, ghi chép nhưng không nói gì.","rootVerb":"sit","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sit out":{"definition":"Không tham gia.","example":"I had to sit the game out because I was ill.","exampleTranslation":"Tôi đã phải không tham gia trận đấu vì bị ốm.","rootVerb":"sit","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"skive off":{"definition":"Trốn việc.","example":"I pretended I was ill and skived off on Monday.","exampleTranslation":"Tôi đã giả vờ bị ốm và trốn việc vào thứ Hai.","rootVerb":"skive","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"slack off":{"definition":"Chểnh mảng, làm việc kém nhiệt tình hơn.","example":"Students usually begin the term well, then slack off near the end of the semester.","exampleTranslation":"Sinh viên thường bắt đầu học kỳ tốt, sau đó chểnh mảng gần cuối học kỳ.","rootVerb":"slack","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"slacken off":{"definition":"Trở nên bớt bận rộn hoặc ít căng thẳng hơn.","example":"Work slackens off during the holiday period.","exampleTranslation":"Công việc bớt bận rộn trong thời gian nghỉ lễ.","rootVerb":"slacken","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"slope off":{"definition":"Chuồn đi.","example":"The lecture sounded really boring, so I sloped off and went to the pub.","exampleTranslation":"Bài giảng nghe thực sự nhàm chán, nên tôi đã chuồn đi và đến quán rượu.","rootVerb":"slope","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sniff around":{"definition":"Tìm kiếm xung quanh để xem cái gì đó tốt thế nào hoặc cố gắng tìm cái tốt hơn.","example":"I sniffed around to see if I could find a better deal.","exampleTranslation":"Tôi đã tìm kiếm xung quanh để xem liệu mình có thể tìm được một ưu đãi tốt hơn không.","rootVerb":"sniff","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"soldier on":{"definition":"Tiếp tục dù mọi thứ trở nên khó khăn.","example":"Life got hard for my dog when he went blind, but he just soldiered on and never complained.","exampleTranslation":"Cuộc sống trở nên khó khăn với chú chó của tôi khi nó bị mù, nhưng nó vẫn kiên trì tiếp tục và không bao giờ than vãn.","rootVerb":"soldier","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"staff up":{"definition":"Tuyển dụng nhân viên cho một việc cụ thể.","example":"They haven't staffed the project up yet.","exampleTranslation":"Họ vẫn chưa tuyển đủ nhân viên cho dự án.","rootVerb":"staff","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stand aside":{"definition":"Rời khỏi một vị trí để người khác có thể đảm nhận.","example":"The prime minister should stand aside and let a new leader head the party.","exampleTranslation":"Thủ tướng nên rời khỏi vị trí để một nhà lãnh đạo mới đứng đầu đảng.","rootVerb":"stand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stand down":{"definition":"Nghỉ việc hoặc vị trí để người khác có thể đảm nhận.","example":"The minister announced her intention to stand down at the next election.","exampleTranslation":"Bộ trưởng thông báo ý định từ chức tại cuộc bầu cử tiếp theo.","rootVerb":"stand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stand in for":{"definition":"Thay thế ai đó tạm thời.","example":"She had to stand in for the editor while he was on holiday.","exampleTranslation":"Cô ấy đã phải tạm thời thay thế biên tập viên trong khi ông ấy đi nghỉ.","rootVerb":"stand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stand out":{"definition":"Trở nên phi thường và khác biệt.","example":"She stood out from the crowd in selection and was offered the job.","exampleTranslation":"Cô ấy đã trở nên khác biệt trong buổi tuyển chọn và được mời làm công việc đó.","rootVerb":"stand","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"start off":{"definition":"Làm cho điều gì đó bắt đầu.","example":"They started off the meeting with an attack on our performance.","exampleTranslation":"Họ đã bắt đầu cuộc họp bằng một sự công kích vào hiệu suất của chúng tôi.","rootVerb":"start","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"start out to":{"definition":"Có ý định, lên kế hoạch.","example":"I didn't start out to become the boss- it just happened.","exampleTranslation":"Tôi không hề có ý định trở thành sếp - mọi chuyện chỉ tình cờ xảy ra.","rootVerb":"start","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stay on":{"definition":"Ở lại lâu hơn dự kiến.","example":"She stayed on after she graduated to do a Master's degree.","exampleTranslation":"Cô ấy đã ở lại sau khi tốt nghiệp để học thạc sĩ.","rootVerb":"stay","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"step aside":{"definition":"Rời khỏi một công việc hoặc vị trí để người khác có thể đảm nhận.","example":"Everyone thinks that the prime minister should step aside so that someone new can lead the party into the election.","exampleTranslation":"Mọi người đều nghĩ rằng thủ tướng nên từ chức để người mới có thể dẫn dắt đảng bước vào cuộc bầu cử.","rootVerb":"step","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stick at":{"definition":"Tiếp tục làm điều gì đó mặc dù có khó khăn.","example":"She found the course very tough but she stuck at it and did well in the end.","exampleTranslation":"Cô ấy thấy khóa học rất khó nhưng cô ấy vẫn kiên trì theo đuổi và cuối cùng đã làm tốt.","rootVerb":"stick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stick down":{"definition":"Viết điều gì đó một cách nhanh chóng hoặc không suy nghĩ về nó.","example":"I couldn't answer the test so I just stuck anything down that I could remember.","exampleTranslation":"Tôi không thể trả lời bài kiểm tra nên tôi chỉ viết vội bất cứ thứ gì mình nhớ được.","rootVerb":"stick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stick out":{"definition":"Tiếp tục làm việc khó khăn hoặc khó chịu.","example":"I stuck it out even though I hated every minute of it.","exampleTranslation":"Tôi đã kiên trì chịu đựng mặc dù tôi ghét từng phút giây của công việc đó.","rootVerb":"stick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stick to":{"definition":"Giữ nguyên, không thay đổi.","example":"I stuck to the path and didn't take the shortcut.","exampleTranslation":"Tôi đã đi đúng theo con đường đó và không đi đường tắt.","rootVerb":"stick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"stick with":{"definition":"Tiếp tục với một cái gì đó khó khăn hoặc khó chịu.","example":"I stuck with the job though I found it very stressful.","exampleTranslation":"Tôi đã tiếp tục bám trụ với công việc dù thấy nó rất áp lực.","rootVerb":"stick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"strike off":{"definition":"Tước giấy phép hành nghề của ai đó.","example":"The Medical Council struck him off for malpractice.","exampleTranslation":"Hội đồng Y khoa đã tước giấy phép hành nghề của anh ta vì sai phạm chuyên môn.","rootVerb":"strike","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"strike out":{"definition":"Bắt đầu làm điều gì đó mới mẻ và khác biệt.","example":"After doing the same job for five years, I decided to strike out and change careers.","exampleTranslation":"Sau năm năm làm cùng một công việc, tôi đã quyết định thử sức mình và thay đổi nghề nghiệp.","rootVerb":"strike","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"string together":{"definition":"Ghép các từ lại với nhau thành một văn bản mạch lạc.","example":"I was so nervous in the interview that I could hardly string a sentence together.","exampleTranslation":"Tôi quá lo lắng trong buổi phỏng vấn đến nỗi khó có thể ghép thành một câu hoàn chỉnh.","rootVerb":"string","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"sweep through":{"definition":"Vượt qua dễ dàng, thành công.","example":"She swept through the exams.","exampleTranslation":"Cô ấy đã vượt qua các kỳ thi một cách dễ dàng.","rootVerb":"sweep","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"take down":{"definition":"Ghi chú hoặc ghi chép đầy đủ.","example":"The police took down his answers to their questions.","exampleTranslation":"Cảnh sát đã ghi chép lại đầy đủ các câu trả lời của anh ta trước những câu hỏi của họ.","rootVerb":"take","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"take part in":{"definition":"Tham gia vào hoạt động, sự kiện gì.","example":"Hundreds of enthusiastic runners took part in the charity marathon.","exampleTranslation":"Hàng trăm vận động viên nhiệt tình đã tham gia vào cuộc chạy marathon từ thiện.","rootVerb":"take","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"take through":{"definition":"Giải thích điều gì đó cho ai đó.","example":"He took me through the procedures before we started.","exampleTranslation":"Anh ấy đã giải thích các quy trình cho tôi trước khi chúng tôi bắt đầu.","rootVerb":"take","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"talk through":{"definition":"Hướng dẫn ai đó qua một vấn đề.","example":"The teacher talked me through the test so I knew what to expect.","exampleTranslation":"Giáo viên đã hướng dẫn tôi qua bài kiểm tra để tôi biết điều gì sắp tới.","rootVerb":"talk","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"tap up":{"definition":"Tiếp cận một cầu thủ bóng đá một cách bất hợp pháp để khiến họ đổi đội.","example":"Chelsea were accused of tapping him up even though he was under contract.","exampleTranslation":"Chelsea bị cáo buộc đã tiếp cận trái phép cầu thủ này mặc dù anh ấy vẫn còn hợp đồng.","rootVerb":"tap","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"team up":{"definition":"Làm việc với ai đó hoặc một nhóm để đạt được điều gì đó.","example":"They teamed up to publicise the issue.","exampleTranslation":"Họ đã hợp tác với nhau để công khai vấn đề này.","rootVerb":"team","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"tick along":{"definition":"Tiến triển hợp lý mà không có bất kỳ vấn đề nghiêm trọng nào.","example":"Things are ticking along at work while the director's away.","exampleTranslation":"Mọi việc tại nơi làm việc vẫn tiến triển ổn thỏa trong khi giám đốc đi vắng.","rootVerb":"tick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"tick off":{"definition":"Đánh dấu vào một mục trong danh sách khi nó đã được giải quyết.","example":"She ticked off our names when we arrived.","exampleTranslation":"Cô ấy đã đánh dấu vào tên chúng tôi khi chúng tôi đến.","rootVerb":"tick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"tick over":{"definition":"Tiếp tục hoạt động, nhưng không có sự cải thiện.","example":"The company ticked over while she was away on holiday.","exampleTranslation":"Công ty vẫn tiếp tục hoạt động cầm chừng trong khi cô ấy đi nghỉ.","rootVerb":"tick","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"toss off":{"definition":"Viết thứ gì đó nhanh chóng và cẩu thả.","example":"I tossed off the essay the night before I had to hand it in.","exampleTranslation":"Tôi đã viết bài luận một cách vội vàng và cẩu thả vào đêm trước khi phải nộp.","rootVerb":"toss","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"train up":{"definition":"Dạy cho ai đó những kỹ năng cụ thể mà họ sẽ cần để thực hiện một công việc hoặc nhiệm vụ.","example":"I have been training my new assistant up.","exampleTranslation":"Tôi đang đào tạo cho trợ lý mới của mình.","rootVerb":"train","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"try for":{"definition":"Cố gắng để có được thứ gì đó.","example":"I'm going to try for the job.","exampleTranslation":"Tôi dự định sẽ nỗ lực để có được công việc đó.","rootVerb":"try","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"try out for":{"definition":"Được thử nghiệm cho một đội thể thao.","example":"He tried out for the baseball team.","exampleTranslation":"Anh ấy đã tham gia thi tuyển vào đội bóng chày.","rootVerb":"try","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"turn in":{"definition":"Nộp, giao.","example":"She turned in her paper.","exampleTranslation":"Cô ấy đã nộp bài làm của mình.","rootVerb":"turn","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"wade through":{"definition":"Đi đến cuối của một việc gì đó một cách khó khăn.","example":"It took me ages to wade through the book.","exampleTranslation":"Tôi đã mất rất nhiều thời gian mới đọc hết cuốn sách đó.","rootVerb":"wade","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"walk through":{"definition":"Giải thích hoặc hướng dẫn cẩn thận điều gì đó cho ai đó.","example":"He walked me through the procedures.","exampleTranslation":"Anh ấy đã hướng dẫn tỉ mỉ cho tôi các quy trình.","rootVerb":"walk","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"waltz through":{"definition":"Vượt qua hoặc thành công một cách dễ dàng.","example":"She waltzed through the tests and got the highest score.","exampleTranslation":"Cô ấy đã vượt qua các bài kiểm tra một cách dễ dàng và đạt điểm cao nhất.","rootVerb":"waltz","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"wise up":{"definition":"Khôn ngoan hơn.","example":"His supervisor told him to wise up and start following the rules or else he'd lose his job.","exampleTranslation":"Cấp trên bảo anh ta hãy tỉnh táo và bắt đầu tuân thủ các quy tắc nếu không muốn mất việc.","rootVerb":"wise","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"wrap up":{"definition":"Kết thúc.","example":"That wraps things up, so we'll end this meeting.","exampleTranslation":"Như vậy là xong xuôi mọi việc, chúng ta sẽ kết thúc cuộc họp tại đây.","rootVerb":"wrap","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"write out":{"definition":"Viết một cái gì đó một cách hoàn chỉnh.","example":"I wrote out my notes in full to help me remember them.","exampleTranslation":"Tôi đã chép lại các ghi chú của mình một cách đầy đủ để giúp ghi nhớ chúng.","rootVerb":"write","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"write up":{"definition":"Viết bản hoàn chỉnh.","example":"I wrote up the report and submitted it.","exampleTranslation":"Tôi đã hoàn thiện bản báo cáo và nộp nó.","rootVerb":"write","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"zone in":{"definition":"Chú ý lại sau khi không làm như vậy.","example":"I was distracted but then I finally managed to zone in.","exampleTranslation":"Tôi đã bị mất tập trung nhưng cuối cùng cũng xoay xở để tập trung chú ý trở lại.","rootVerb":"zone","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"zone in on":{"definition":"Chú ý lại sau khi không làm như vậy.","example":"I zoned in on what they were saying when they started gossiping.","exampleTranslation":"Tôi tập trung chú ý vào điều họ nói khi họ bắt đầu bàn tán.","rootVerb":"zone","topicId":"work-study","topicTitle":"Học tập và công việc","partOfSpeech":"V","dictionarySource":"offline"},"wake up":{"definition":"thức giấc, không còn ngủ","example":"I wake up before dawn but stay in bed until my alarm rings.","exampleTranslation":"Tôi thức giấc trước bình minh nhưng vẫn nằm trên giường cho đến khi chuông báo thức reo.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày"},"get up":{"definition":"ra khỏi giường để bắt đầu ngày mới","example":"I get up and make breakfast before anyone else wakes.","exampleTranslation":"Tôi ra khỏi giường và làm bữa sáng trước khi những người khác thức dậy.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày"},"lie down":{"definition":"nằm xuống để nghỉ","example":"If you feel dizzy, lie down on the sofa.","exampleTranslation":"Nếu thấy chóng mặt, hãy nằm xuống ghế sofa.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày"},"sit down":{"definition":"ngồi xuống","example":"There's a chair for you; please sit down while you wait for the doctor.","exampleTranslation":"Có ghế dành cho bạn; vui lòng ngồi xuống trong khi chờ bác sĩ.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày"},"stand up":{"definition":"đứng lên","example":"Everyone stood up when the judge entered the room.","exampleTranslation":"Mọi người đứng lên khi thẩm phán bước vào phòng.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày"},"get dressed":{"definition":"mặc quần áo","example":"The children get dressed before breakfast.","exampleTranslation":"Bọn trẻ mặc quần áo trước bữa sáng.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày"},"put on":{"definition":"mặc hoặc đeo một món đồ lên người","example":"Put on your coat before you go outside.","exampleTranslation":"Hãy mặc áo khoác trước khi ra ngoài.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: put your coat on; đại từ phải đứng giữa: put it on."},"take off":{"definition":"cởi bỏ quần áo hoặc giày dép","example":"Please take off your shoes at the door.","exampleTranslation":"Vui lòng cởi giày ở cửa.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: take your shoes off; đại từ phải đứng giữa: take them off."},"try on":{"definition":"mặc thử để xem có vừa hoặc hợp không","example":"She tried on the blue jacket before buying it.","exampleTranslation":"Cô ấy mặc thử chiếc áo khoác xanh trước khi mua.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: try the jacket on; đại từ phải đứng giữa: try it on."},"turn on":{"definition":"bật thiết bị hoặc nguồn điện","example":"The kitchen is dark, so could you turn on the light?","exampleTranslation":"Bếp tối rồi, bạn bật đèn lên giúp tôi được không?","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: turn the light on; đại từ phải đứng giữa: turn it on."},"turn off":{"definition":"tắt thiết bị hoặc nguồn điện","example":"The oven timer has rung, so turn off the oven before you leave.","exampleTranslation":"Chuông hẹn giờ lò đã reo, vậy hãy tắt lò trước khi bạn đi.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: turn the oven off; đại từ phải đứng giữa: turn it off."},"clean up":{"definition":"dọn dẹp cho sạch sẽ, gọn gàng","example":"We clean up the kitchen after dinner.","exampleTranslation":"Chúng tôi dọn bếp sau bữa tối.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: clean the kitchen up; đại từ phải đứng giữa: clean it up."},"put away":{"definition":"cất đồ về đúng chỗ","example":"Please put away your books before lunch.","exampleTranslation":"Hãy cất sách vào đúng chỗ trước bữa trưa.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: put your books away; đại từ phải đứng giữa: put them away."},"throw away":{"definition":"vứt bỏ thứ không còn cần","example":"Don't throw away the receipt; we may need it.","exampleTranslation":"Đừng vứt hóa đơn đi; có thể chúng ta sẽ cần nó.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: throw the receipt away; đại từ phải đứng giữa: throw it away."},"pick up":{"definition":"đón ai hoặc lấy một món đồ lên","example":"I'll pick up the parcel from the front desk.","exampleTranslation":"Tôi sẽ lấy bưu kiện ở quầy lễ tân.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: pick the parcel up; đại từ phải đứng giữa: pick it up."},"drop off":{"definition":"đưa ai hoặc vật đến một nơi rồi rời đi","example":"I drop off my daughter at school before continuing to the office.","exampleTranslation":"Tôi đưa con gái đến trường trước khi tiếp tục đến văn phòng.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: drop my daughter off; đại từ phải đứng giữa: drop her off."},"run out of":{"definition":"dùng hết, không còn thứ gì","example":"We've run out of milk, so I'll buy some.","exampleTranslation":"Nhà tôi hết sữa rồi, nên tôi sẽ đi mua.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Cụm ba từ; tân ngữ theo sau of, không tách."},"fill up":{"definition":"đổ đầy một vật chứa","example":"Please fill up the water bottle before the hike.","exampleTranslation":"Hãy đổ đầy bình nước trước chuyến đi bộ đường dài.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách: fill the bottle up; đại từ phải đứng giữa: fill it up."},"look for":{"definition":"tìm kiếm thứ đang thất lạc hoặc cần có","example":"I'm looking for my glasses; have you seen them?","exampleTranslation":"Tôi đang tìm kính; bạn có thấy chúng không?","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Tân ngữ đứng sau for; không tách."},"find out":{"definition":"tìm ra hoặc biết được thông tin","example":"We called the clinic to find out its opening hours.","exampleTranslation":"Chúng tôi gọi phòng khám để biết giờ mở cửa.","topicId":"curated-daily-life","topicTitle":"Sinh hoạt hằng ngày","spellingNote":"Cấu trúc: Có thể tách khi có tân ngữ: find the hours out; đại từ phải đứng giữa."},"look after":{"definition":"chăm sóc người hoặc vật","example":"Mina looks after her neighbor's cat on weekends.","exampleTranslation":"Mina chăm sóc mèo của hàng xóm vào cuối tuần.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Tân ngữ đứng sau after; không tách."},"let in":{"definition":"cho ai hoặc vật đi vào","example":"Please let in the delivery driver through the side door.","exampleTranslation":"Hãy cho nhân viên giao hàng vào bằng cửa bên.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: let the driver in; đại từ đứng giữa: let him in."},"lock up":{"definition":"khóa cửa để bảo vệ nhà hoặc nơi làm việc","example":"Remember to lock up before you leave the shop.","exampleTranslation":"Nhớ khóa cửa trước khi rời cửa hàng.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: lock the shop up; đại từ đứng giữa: lock it up."},"set up":{"definition":"lắp đặt hoặc chuẩn bị để sẵn sàng sử dụng","example":"We set up the new desk in the spare room.","exampleTranslation":"Chúng tôi lắp chiếc bàn mới trong phòng trống.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: set the desk up; đại từ đứng giữa: set it up."},"take out":{"definition":"mang thứ gì từ trong ra ngoài","example":"The kitchen bin is full; could you take out the rubbish before the cleaners arrive?","exampleTranslation":"Thùng rác trong bếp đã đầy; bạn mang rác ra ngoài trước khi nhân viên vệ sinh đến được không?","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: take the rubbish out; đại từ đứng giữa: take it out."},"put out":{"definition":"dập tắt lửa hoặc thuốc đang cháy","example":"The firefighters put out the small kitchen fire quickly.","exampleTranslation":"Lính cứu hỏa nhanh chóng dập tắt đám cháy nhỏ trong bếp.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: put the fire out; đại từ đứng giữa: put it out."},"put down":{"definition":"đặt một vật xuống bề mặt","example":"Please put down your bags by the door.","exampleTranslation":"Vui lòng đặt túi xuống cạnh cửa.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: put your bags down; đại từ phải đứng giữa: put them down."},"plug in":{"definition":"cắm phích điện vào ổ","example":"Plug in the kettle after you fill it and before you switch it on.","exampleTranslation":"Hãy cắm ấm điện sau khi đổ nước vào và trước khi bật.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: plug the kettle in; đại từ đứng giữa: plug it in."},"put back":{"definition":"đặt hoặc trả một vật về chỗ cũ","example":"Please put back the screwdriver after using it.","exampleTranslation":"Hãy cất tuốc nơ vít lại sau khi dùng.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: put the screwdriver back; đại từ phải đứng giữa: put it back."},"turn down":{"definition":"giảm âm lượng hoặc mức nhiệt","example":"The music is too loud; please turn down the volume.","exampleTranslation":"Nhạc to quá; vui lòng giảm âm lượng.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: turn the music down; đại từ phải đứng giữa: turn it down."},"turn up":{"definition":"tăng âm lượng hoặc mức nhiệt","example":"I can't hear the radio; could you turn up the volume?","exampleTranslation":"Tôi không nghe rõ đài; bạn tăng âm lượng lên được không?","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: turn the radio up; đại từ phải đứng giữa: turn it up."},"move in":{"definition":"chuyển đến và bắt đầu sống ở một nơi","example":"Our new neighbors move in next Monday.","exampleTranslation":"Những người hàng xóm mới sẽ chuyển đến vào thứ Hai tới.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"move out":{"definition":"rời khỏi nơi đang sống","example":"He plans to move out when his lease ends.","exampleTranslation":"Anh ấy dự định chuyển đi khi hợp đồng thuê nhà hết hạn.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"fix up":{"definition":"sửa sang để một vật hoặc căn nhà dùng tốt hơn","example":"They fixed up the old kitchen over the summer, repairing the cabinets instead of replacing them.","exampleTranslation":"Họ sửa sang căn bếp cũ trong suốt mùa hè, sửa tủ bếp thay vì thay mới.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: fix the kitchen up; đại từ đứng giữa: fix it up."},"take apart":{"definition":"tháo một vật thành các bộ phận","example":"Dad took apart the broken lamp to find the loose wire.","exampleTranslation":"Bố tháo chiếc đèn hỏng để tìm sợi dây bị lỏng.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: take the lamp apart; đại từ đứng giữa: take it apart."},"put together":{"definition":"lắp các bộ phận thành một vật hoàn chỉnh","example":"We put together the bookshelf using the instructions.","exampleTranslation":"Chúng tôi lắp giá sách theo hướng dẫn.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: put the bookshelf together; đại từ đứng giữa: put it together."},"pay back":{"definition":"trả lại số tiền đã vay","example":"I'll pay back the money after I get paid on Friday.","exampleTranslation":"Tôi sẽ trả lại tiền sau khi nhận lương vào thứ Sáu.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: pay the money back; đại từ đứng giữa: pay it back."},"bring in":{"definition":"mang thứ gì từ ngoài vào trong","example":"Bring in the cushions before it starts to rain.","exampleTranslation":"Hãy mang đệm vào nhà trước khi trời mưa.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: bring the cushions in; đại từ đứng giữa: bring them in."},"give away":{"definition":"cho hoặc tặng một vật mà không lấy tiền","example":"They gave away the old sofa to a neighbor.","exampleTranslation":"Họ tặng chiếc ghế sofa cũ cho một người hàng xóm.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Có thể tách: give the sofa away; đại từ đứng giữa: give it away."},"get rid of":{"definition":"loại bỏ thứ không còn muốn giữ","example":"We got rid of the broken chair during the move.","exampleTranslation":"Chúng tôi bỏ chiếc ghế hỏng khi chuyển nhà.","topicId":"curated-home","topicTitle":"Nhà cửa và việc vặt","spellingNote":"Cấu trúc: Cụm ba từ; tân ngữ đứng sau of, không tách."},"look up":{"definition":"tra cứu thông tin trong sách hoặc nguồn dữ liệu","example":"I looked up the word in an online dictionary.","exampleTranslation":"Tôi tra từ đó trong từ điển trực tuyến.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: look the word up; đại từ phải đứng giữa: look it up."},"write down":{"definition":"ghi lại thông tin bằng chữ viết","example":"Write down the room number before you forget it.","exampleTranslation":"Hãy ghi số phòng lại trước khi bạn quên.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: write the number down; đại từ phải đứng giữa: write it down."},"hand in":{"definition":"nộp bài hoặc tài liệu cho người phụ trách","example":"Please hand in your assignment by Thursday.","exampleTranslation":"Vui lòng nộp bài tập trước thứ Năm.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: hand your assignment in; đại từ đứng giữa: hand it in."},"hand out":{"definition":"phát tài liệu cho nhiều người","example":"The teacher handed out the worksheets at the start of class.","exampleTranslation":"Giáo viên phát phiếu bài tập vào đầu giờ.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: hand the worksheets out; đại từ đứng giữa: hand them out."},"fill in":{"definition":"điền thông tin vào chỗ trống hoặc biểu mẫu","example":"Fill in your name at the top of the form.","exampleTranslation":"Hãy điền tên bạn vào đầu biểu mẫu.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: fill the form in; đại từ đứng giữa: fill it in."},"go over":{"definition":"xem lại hoặc kiểm tra kỹ nội dung","example":"Let's go over the report before the meeting.","exampleTranslation":"Hãy cùng xem lại báo cáo trước cuộc họp.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Tân ngữ đứng sau over; không tách."},"work on":{"definition":"dành thời gian và công sức để làm hoặc cải thiện việc gì","example":"I'm working on the budget for next quarter.","exampleTranslation":"Tôi đang làm ngân sách cho quý tới.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Tân ngữ đứng sau on; không tách."},"carry out":{"definition":"thực hiện một kế hoạch, nhiệm vụ hoặc nghiên cứu","example":"The team carried out a safety check before opening.","exampleTranslation":"Nhóm đã tiến hành kiểm tra an toàn trước khi mở cửa.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: carry the check out; đại từ đứng giữa: carry it out."},"figure out":{"definition":"tìm ra câu trả lời hoặc cách giải quyết","example":"We figured out why the printer had stopped.","exampleTranslation":"Chúng tôi tìm ra lý do máy in ngừng hoạt động.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: figure the reason out; đại từ đứng giữa: figure it out."},"point out":{"definition":"chỉ ra một sự thật hoặc vấn đề","example":"The editor pointed out two errors in the final paragraph.","exampleTranslation":"Biên tập viên chỉ ra hai lỗi trong đoạn cuối.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: point the errors out; đại từ đứng giữa: point them out."},"put off":{"definition":"hoãn làm việc gì sang thời điểm muộn hơn","example":"They put off the interview until next week.","exampleTranslation":"Họ hoãn buổi phỏng vấn đến tuần sau.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: put the interview off; đại từ đứng giữa: put it off."},"call off":{"definition":"hủy một sự kiện hoặc kế hoạch","example":"The organizers called off the outdoor event because of the storm.","exampleTranslation":"Ban tổ chức hủy sự kiện ngoài trời vì bão.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: call the event off; đại từ đứng giữa: call it off."},"take on":{"definition":"nhận trách nhiệm hoặc đảm nhận công việc","example":"Jules took on a new project at work.","exampleTranslation":"Jules nhận một dự án mới ở chỗ làm.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: take a project on; đại từ đứng giữa: take it on."},"take over":{"definition":"tiếp quản công việc hoặc vai trò của người khác","example":"Rosa will take over the team while I'm away.","exampleTranslation":"Rosa sẽ tiếp quản nhóm khi tôi đi vắng.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Tân ngữ đứng sau over; không tách."},"catch up":{"definition":"làm phần việc còn chậm để theo kịp","example":"I stayed late to catch up on my emails.","exampleTranslation":"Tôi ở lại muộn để xử lý số email còn tồn.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Trong catch up on something, tân ngữ theo sau on."},"fall behind":{"definition":"chậm tiến độ hoặc không theo kịp người khác","example":"Without a study plan, it's easy to fall behind in class.","exampleTranslation":"Không có kế hoạch học, bạn rất dễ bị chậm bài trên lớp.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"keep up":{"definition":"duy trì tốc độ để không bị tụt lại","example":"The course is fast, but she can keep up with the lessons.","exampleTranslation":"Khóa học có nhịp độ nhanh, nhưng cô ấy vẫn theo kịp bài học.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Trong keep up with something, tân ngữ theo sau with."},"bring up":{"definition":"đề cập một chủ đề trong cuộc trò chuyện hoặc cuộc họp","example":"I brought up the delivery delay during the meeting.","exampleTranslation":"Tôi đề cập việc giao hàng chậm trong cuộc họp.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: bring the delay up; đại từ đứng giữa: bring it up."},"come up with":{"definition":"nghĩ ra một ý tưởng hoặc kế hoạch","example":"The students came up with a simple way to test the idea.","exampleTranslation":"Các học sinh nghĩ ra một cách đơn giản để thử ý tưởng.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Cụm ba từ; tân ngữ đứng sau with, không tách."},"read over":{"definition":"đọc lại để kiểm tra nội dung","example":"Read over your application before you send it.","exampleTranslation":"Hãy đọc lại đơn đăng ký trước khi gửi.","topicId":"curated-work-study","topicTitle":"Học tập và công việc","spellingNote":"Cấu trúc: Có thể tách: read your application over; đại từ đứng giữa: read it over."},"speak up":{"definition":"nói to hoặc rõ hơn để người khác nghe thấy","example":"Please speak up; the microphone isn't working.","exampleTranslation":"Vui lòng nói to hơn; micro không hoạt động.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"talk over":{"definition":"thảo luận kỹ một vấn đề trước khi quyết định","example":"Let's talk over the options before we choose.","exampleTranslation":"Hãy cùng bàn kỹ các lựa chọn trước khi quyết định.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Tân ngữ đứng sau over; không tách."},"call back":{"definition":"gọi điện lại cho người đã liên lạc","example":"I missed your call, so I'll call back after lunch.","exampleTranslation":"Tôi lỡ cuộc gọi của bạn, nên sẽ gọi lại sau bữa trưa.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể tách: call you back; đại từ đứng giữa: call them back."},"get back to":{"definition":"liên hệ lại với ai để trả lời hoặc tiếp tục trao đổi","example":"I'll get back to you with an answer this afternoon.","exampleTranslation":"Chiều nay tôi sẽ liên hệ lại với bạn để trả lời.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Cụm ba từ; tân ngữ đứng sau to, không tách."},"hang up":{"definition":"kết thúc cuộc gọi điện thoại","example":"She hung up after saying goodbye.","exampleTranslation":"Cô ấy kết thúc cuộc gọi sau khi nói lời tạm biệt.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"hold on":{"definition":"chờ trong chốc lát, thường khi đang gọi điện","example":"Hold on a moment while I check your booking.","exampleTranslation":"Vui lòng chờ một lát trong khi tôi kiểm tra đặt chỗ.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"get through":{"definition":"kết nối được qua điện thoại","example":"I couldn't get through to the clinic this morning.","exampleTranslation":"Sáng nay tôi không gọi kết nối được đến phòng khám.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Trong get through to someone, người nhận theo sau to."},"cut off":{"definition":"làm gián đoạn đột ngột cuộc gọi hoặc lời nói","example":"We were cut off when the train entered the tunnel.","exampleTranslation":"Cuộc gọi của chúng tôi bị ngắt khi tàu đi vào đường hầm.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể tách: cut the call off; đại từ đứng giữa: cut it off."},"show up":{"definition":"đến một nơi, nhất là khi đã hẹn hoặc dự kiến","example":"Nina showed up ten minutes early for the interview.","exampleTranslation":"Nina đến sớm mười phút cho buổi phỏng vấn.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"turn away":{"definition":"không cho ai vào một nơi","example":"The venue turned away visitors without tickets.","exampleTranslation":"Địa điểm đó không cho khách không có vé vào.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể tách: turn visitors away; đại từ đứng giữa: turn them away."},"cheer up":{"definition":"làm ai vui lên hoặc trở nên vui hơn","example":"A funny message can cheer up a friend after a difficult day.","exampleTranslation":"Một tin nhắn vui có thể làm bạn phấn chấn hơn sau ngày khó khăn.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể tách: cheer a friend up; đại từ đứng giữa."},"calm down":{"definition":"bình tĩnh lại hoặc làm ai bình tĩnh lại","example":"Take a deep breath and calm down before you reply.","exampleTranslation":"Hãy hít sâu và bình tĩnh lại trước khi trả lời.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể dùng không tân ngữ hoặc tách: calm the child down."},"open up":{"definition":"bắt đầu chia sẻ suy nghĩ hoặc cảm xúc riêng","example":"After a few weeks, he opened up about his worries.","exampleTranslation":"Sau vài tuần, anh ấy bắt đầu chia sẻ những lo lắng của mình.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp trong nghĩa này; không tách."},"make up":{"definition":"bịa ra một câu chuyện hoặc lời giải thích","example":"The child made up a story about a friendly dragon.","exampleTranslation":"Đứa trẻ bịa ra câu chuyện về một con rồng thân thiện.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể tách: make a story up; đại từ đứng giữa: make it up."},"fall out":{"definition":"cãi nhau và trở nên không còn thân thiết","example":"The two friends fell out over a misunderstanding.","exampleTranslation":"Hai người bạn cãi nhau vì một hiểu lầm.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"get over":{"definition":"hồi phục sau bệnh tật hoặc vượt qua chuyện buồn","example":"It took him a week to get over the flu.","exampleTranslation":"Anh ấy mất một tuần để khỏi cúm.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Trong ví dụ này là hồi phục sau bệnh; tân ngữ đứng sau over."},"ask out":{"definition":"mời ai đi hẹn hò","example":"Kai plans to ask out a classmate for coffee after class.","exampleTranslation":"Kai dự định mời một bạn cùng lớp đi uống cà phê sau giờ học.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Có thể tách: ask someone out; đại từ đứng giữa."},"back down":{"definition":"nhượng bộ hoặc rút lại lập trường sau bất đồng","example":"Neither side backed down during the negotiations.","exampleTranslation":"Không bên nào nhượng bộ trong cuộc đàm phán.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"stand up for":{"definition":"bênh vực hoặc bảo vệ một người hay điều mình tin","example":"Maya stood up for her colleague when the criticism was unfair.","exampleTranslation":"Maya bênh vực đồng nghiệp khi lời chỉ trích không công bằng.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Cụm ba từ; người hoặc điều được bảo vệ đứng sau for."},"get along":{"definition":"có mối quan hệ hòa thuận với ai","example":"Our new neighbors get along well with everyone on the floor.","exampleTranslation":"Những người hàng xóm mới hòa thuận với mọi người trong tầng.","topicId":"curated-communication","topicTitle":"Giao tiếp và các mối quan hệ","spellingNote":"Cấu trúc: Thường dùng get along with someone; tân ngữ theo sau with."},"set off":{"definition":"bắt đầu một chuyến đi","example":"We set off for the airport before sunrise to avoid traffic.","exampleTranslation":"Chúng tôi khởi hành đến sân bay trước lúc mặt trời mọc để tránh tắc đường.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp trong nghĩa này; không tách."},"drive off":{"definition":"lái xe rời khỏi một nơi","example":"The driver drove off before I could ask for directions.","exampleTranslation":"Tài xế lái xe đi trước khi tôi kịp hỏi đường.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"get in":{"definition":"vào trong ô tô hoặc taxi","example":"Get in the car quickly; it's starting to rain.","exampleTranslation":"Mau vào ô tô đi; trời bắt đầu mưa rồi.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Dùng get in a car; không có tân ngữ trực tiếp."},"get out":{"definition":"ra khỏi ô tô hoặc taxi","example":"We got out of the taxi in front of the hotel.","exampleTranslation":"Chúng tôi xuống taxi trước khách sạn.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Dùng get out of a car/taxi; không có tân ngữ trực tiếp."},"get on":{"definition":"lên xe buýt, tàu hoặc máy bay","example":"The bus has just arrived at our stop, so we got on.","exampleTranslation":"Xe buýt vừa đến trạm của chúng tôi nên chúng tôi đã lên xe.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Dùng get on a bus/train/plane; không có tân ngữ trực tiếp."},"get off":{"definition":"xuống xe buýt, tàu hoặc máy bay","example":"Please get off the train at Central Station.","exampleTranslation":"Vui lòng xuống tàu ở ga Trung tâm.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Dùng get off a bus/train/plane; không có tân ngữ trực tiếp."},"check in":{"definition":"làm thủ tục nhận phòng hoặc xác nhận chuyến đi","example":"We checked in at the hotel shortly after noon.","exampleTranslation":"Chúng tôi làm thủ tục nhận phòng khách sạn ngay sau buổi trưa.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp trong nghĩa làm thủ tục."},"check out":{"definition":"trả phòng và hoàn tất thủ tục rời khách sạn","example":"Guests must check out by eleven in the morning.","exampleTranslation":"Khách phải trả phòng trước mười một giờ sáng.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp trong nghĩa trả phòng."},"pull over":{"definition":"tấp xe vào lề và dừng lại","example":"The driver pulled over to let the ambulance pass.","exampleTranslation":"Tài xế tấp vào lề để nhường xe cứu thương đi qua.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"pull up":{"definition":"dừng xe sát một nơi hoặc người nào đó","example":"A taxi pulled up outside the station.","exampleTranslation":"Một chiếc taxi dừng trước nhà ga.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"head back":{"definition":"bắt đầu quay trở lại một nơi","example":"We headed back to the hotel before it got dark.","exampleTranslation":"Chúng tôi bắt đầu quay về khách sạn trước khi trời tối.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Thường dùng head back to a place."},"come back":{"definition":"trở lại nơi người nói đang ở hoặc nhắc đến","example":"I'll wait here, so come back when you have the signed form.","exampleTranslation":"Tôi sẽ đợi ở đây, vậy hãy quay lại khi bạn có biểu mẫu đã ký.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"go back":{"definition":"quay trở lại một nơi đã rời đi","example":"I need to go back to the shop for my umbrella.","exampleTranslation":"Tôi cần quay lại cửa hàng lấy ô.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Thường dùng go back to a place."},"turn around":{"definition":"đổi hướng để quay về phía ngược lại","example":"Turn around at the next street and follow the signs.","exampleTranslation":"Hãy quay đầu ở con phố tiếp theo rồi đi theo biển chỉ dẫn.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"speed up":{"definition":"tăng tốc độ di chuyển hoặc tiến trình","example":"The train began to speed up after leaving the station.","exampleTranslation":"Tàu bắt đầu tăng tốc sau khi rời ga.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp trong ví dụ này."},"slow down":{"definition":"giảm tốc độ di chuyển hoặc tiến trình","example":"Slow down near the school crossing.","exampleTranslation":"Hãy giảm tốc độ khi đến gần lối sang đường của trường học.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Có thể dùng với tân ngữ: slow the car down."},"grow up":{"definition":"lớn lên từ lúc còn nhỏ đến khi trưởng thành","example":"She grew up in a small town near the coast.","exampleTranslation":"Cô ấy lớn lên ở một thị trấn nhỏ gần bờ biển.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"give up":{"definition":"ngừng cố gắng hoặc từ bỏ việc đang làm","example":"Don't give up when the first attempt fails.","exampleTranslation":"Đừng bỏ cuộc khi lần thử đầu tiên thất bại.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Có thể dùng với danh từ: give up the plan; đại từ đứng giữa: give it up."},"take up":{"definition":"bắt đầu một sở thích hoặc hoạt động mới","example":"He took up swimming to improve his fitness.","exampleTranslation":"Anh ấy bắt đầu tập bơi để cải thiện thể lực.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Có thể tách: take swimming up; đại từ đứng giữa khi thay thế tân ngữ."},"start over":{"definition":"bắt đầu lại từ đầu","example":"I deleted the wrong file, so I had to start over.","exampleTranslation":"Tôi xóa nhầm tệp nên phải bắt đầu lại từ đầu.","topicId":"curated-travel","topicTitle":"Di chuyển và thay đổi","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"carry on":{"definition":"tiếp tục làm việc đang làm","example":"The power went out, but the class carried on by candlelight.","exampleTranslation":"Điện bị mất nhưng lớp học vẫn tiếp tục dưới ánh nến.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; không tách."},"move on":{"definition":"chuyển sang việc hoặc giai đoạn tiếp theo","example":"After discussing the budget, we moved on to the schedule.","exampleTranslation":"Sau khi thảo luận ngân sách, chúng tôi chuyển sang lịch trình.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp trong nghĩa chuyển sang việc tiếp theo."},"end up":{"definition":"cuối cùng rơi vào một kết quả hoặc tình huống","example":"We took the wrong road and ended up at the lake.","exampleTranslation":"Chúng tôi đi nhầm đường và cuối cùng đến hồ.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Thường theo sau là trạng thái, địa điểm hoặc động từ thêm -ing."},"turn out":{"definition":"hóa ra là hoặc cuối cùng có kết quả như thế nào","example":"The repair turned out to be cheaper than we expected.","exampleTranslation":"Hóa ra việc sửa chữa rẻ hơn chúng tôi dự tính.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Trong ví dụ này theo sau là to be; không có tân ngữ trực tiếp."},"break down":{"definition":"hỏng và ngừng hoạt động (máy móc hoặc xe cộ)","example":"Our washing machine broke down during the night.","exampleTranslation":"Máy giặt nhà tôi hỏng trong đêm.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Ở nghĩa này không có tân ngữ trực tiếp; máy bị hỏng."},"wear out":{"definition":"mòn hoặc hỏng do sử dụng nhiều","example":"These running shoes wear out after about a year.","exampleTranslation":"Đôi giày chạy này bị mòn sau khoảng một năm.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Có thể dùng có tân ngữ: wear the shoes out; đại từ đứng giữa: wear them out."},"break up":{"definition":"kết thúc một mối quan hệ tình cảm","example":"They broke up after realizing they wanted different things.","exampleTranslation":"Họ chia tay sau khi nhận ra mình muốn những điều khác nhau.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Ở nghĩa chia tay, không có tân ngữ trực tiếp."},"run into":{"definition":"tình cờ gặp một người","example":"I ran into my former teacher at the bookshop.","exampleTranslation":"Tôi tình cờ gặp giáo viên cũ ở hiệu sách.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Nghĩa khác: gặp vấn đề; ở cả hai nghĩa, tân ngữ đứng sau into."},"come across":{"definition":"tình cờ tìm thấy hoặc bắt gặp điều gì","example":"She came across an old photo while clearing the drawer.","exampleTranslation":"Cô ấy tình cờ tìm thấy một bức ảnh cũ khi dọn ngăn kéo.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Tân ngữ đứng sau across; không tách."},"look into":{"definition":"điều tra hoặc tìm hiểu kỹ một vấn đề","example":"The manager promised to look into the billing error.","exampleTranslation":"Người quản lý hứa sẽ tìm hiểu lỗi tính phí.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Tân ngữ đứng sau into; không tách."},"rule out":{"definition":"loại trừ một khả năng sau khi cân nhắc","example":"The doctor ruled out an allergy after reviewing the test results.","exampleTranslation":"Bác sĩ đã loại trừ khả năng dị ứng sau khi xem kết quả xét nghiệm.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Có thể tách: rule an allergy out; đại từ đứng giữa: rule it out."},"narrow down":{"definition":"thu hẹp nhiều lựa chọn thành một số ít","example":"We narrowed down the search to three apartments.","exampleTranslation":"Chúng tôi thu hẹp danh sách tìm kiếm còn ba căn hộ.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Có thể tách: narrow the choices down; đại từ đứng giữa: narrow them down."},"sort out":{"definition":"giải quyết hoặc sắp xếp ổn thỏa một vấn đề","example":"The support team sorted out the account problem by noon.","exampleTranslation":"Nhóm hỗ trợ giải quyết xong vấn đề tài khoản trước buổi trưa.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Có thể tách: sort the problem out; đại từ đứng giữa: sort it out."},"work out":{"definition":"tìm ra cách giải quyết cho một vấn đề cụ thể","example":"We worked out a way to share the room fairly.","exampleTranslation":"Chúng tôi tìm ra cách chia sẻ căn phòng công bằng.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Nghĩa khác: tập thể dục hoặc có kết quả; ví dụ này là tìm giải pháp."},"deal with":{"definition":"xử lý một vấn đề hoặc tình huống","example":"I deal with customer complaints each morning.","exampleTranslation":"Mỗi sáng tôi xử lý khiếu nại của khách hàng.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Tân ngữ đứng sau with; không tách."},"get by":{"definition":"xoay xở với số tiền hoặc nguồn lực hạn chế","example":"They can get by on one income for a few months.","exampleTranslation":"Họ có thể xoay xở với một nguồn thu nhập trong vài tháng.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Thường dùng get by on/with; không có tân ngữ trực tiếp."},"get away":{"definition":"đi khỏi nơi thường ngày để nghỉ ngơi","example":"We hope to get away for a few days in June.","exampleTranslation":"Chúng tôi hy vọng đi nghỉ vài ngày vào tháng Sáu.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Thường dùng get away for/to; không có tân ngữ trực tiếp."},"put up with":{"definition":"chịu đựng một điều khó chịu mà không phản ứng","example":"I can't put up with the constant noise from the construction site.","exampleTranslation":"Tôi không thể chịu nổi tiếng ồn liên tục từ công trường.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Cụm ba từ; tân ngữ đứng sau with, không tách."},"come apart":{"definition":"rời ra thành các bộ phận hoặc mảnh","example":"The handle came apart when I tried to open the jar.","exampleTranslation":"Tay cầm rời ra khi tôi cố mở chiếc lọ.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Không có tân ngữ trực tiếp; vật tự rời ra."},"hold up":{"definition":"làm chậm hoặc trì hoãn ai hay việc gì","example":"Roadworks held up the bus for nearly twenty minutes.","exampleTranslation":"Công trình đường bộ làm xe buýt chậm gần hai mươi phút.","topicId":"curated-problem-solving","topicTitle":"Giải quyết tình huống","spellingNote":"Cấu trúc: Có thể tách: hold the bus up; đại từ đứng giữa: hold it up."}},"wordCount":1952,"topicCount":16},{"id":"subordinating-conjunctions-v1","title":"Cấu trúc câu & từ nối","description":"Tổng hợp 71 mục gồm liên từ, trạng từ liên kết, mẫu giới từ và các mẫu cấu trúc câu; học qua ví dụ và bài chọn đáp án.","lessons":[{"id":"subordinating-conjunctions-v1-time","title":"Thời điểm và mốc thời gian","focus":"Phân biệt việc xảy ra ngay khi, đúng lúc, hoặc đã hoàn tất trước một mốc.","questions":[{"term":"as soon as","prompt":"Don't wait for the plane to reach the gate; text me immediately _____ you see its landing lights turn on.","choices":["as soon as","even though","provided that","in order that"]},{"term":"by the time","prompt":"The rescue team had been waiting at the village for two hours _____ the ambulance arrived.","choices":["by the time","in case","even if","so that"]},{"term":"just as","prompt":"The striker kicked the ball _____ the referee blew the whistle to start the match.","choices":["just as","even if","in order that","provided that"]},{"term":"now when","prompt":"I used to ignore the old school bell, but _____ I hear it, I remember my first day.","choices":["now when","in case","provided that","so that"]},{"term":"now that","prompt":"_____ the final repair is complete, the library can reopen; the safety issue that forced it to close is gone.","choices":["now that","in case","as if","even if"]},{"term":"as long as","prompt":"You may borrow my compass _____ you return it before sunset.","choices":["as long as","in case","even though","just as"]}]},{"id":"subordinating-conjunctions-v1-conditions","title":"Điều kiện và nhượng bộ","focus":"Nhận ra điều kiện, sự đề phòng, giả định và sự thật trái ngược.","questions":[{"term":"in case","prompt":"Save the emergency number in your phone _____ you need help.","choices":["in case","if only","even if","so that"]},{"term":"even if","prompt":"The snow forecast is uncertain. _____ it snows tonight, the airport will remain open.","choices":["even if","even though","in case","by the time"]},{"term":"even though","prompt":"_____ the road was icy, the bus still arrived on time.","choices":["even though","in case","provided that","so that"]},{"term":"provided that","prompt":"The lab will accept your sample _____ it is sealed before noon.","choices":["provided that","even though","if only","in case"]},{"term":"if only","prompt":"_____ I had kept the receipt! I could have returned these headphones yesterday.","choices":["if only","even if","as though","by the time"]},{"term":"as much as","prompt":"_____ I like the idea, I cannot approve the budget without figures.","choices":["as much as","provided that","in case","as though"]}]},{"id":"subordinating-conjunctions-v1-meaning","title":"Cách thức, lý do và mục đích","focus":"Dựa vào ý nghĩa của mệnh đề sau để chọn cụm chỉ so sánh, lý do hoặc mục đích.","questions":[{"term":"as if","prompt":"The child spoke to the author _____ they had known each other for years.","choices":["as if","so that","in case","provided that"]},{"term":"as though","prompt":"The dog stared at the empty bowl _____ it were still full.","choices":["as though","as long as","so that","provided that"]},{"term":"as far as","prompt":"_____ I can tell from the map, the footpath ends at the river; I have not checked beyond it.","choices":["as far as","provided that","in order that","even though"]},{"term":"inasmuch as","prompt":"The form cannot be approved _____ it lacks two required signatures; that is the reason it must be returned.","choices":["inasmuch as","as though","by the time","so that"]},{"term":"in order that","prompt":"The guide repeated each step slowly _____ every visitor could follow.","choices":["in order that","even if","as if","in case"]},{"term":"so that","prompt":"Nora labeled every jar _____ nobody would confuse the spices.","choices":["so that","inasmuch as","as far as","even though"]}]},{"id":"linking-adverbs-v1-contrast","title":"Nguyên nhân, kết quả và trình tự","focus":"Nhận ra cách điều chỉnh theo tình huống, kết quả của một nguyên nhân và bước tiếp theo.","questions":[{"term":"accordingly","prompt":"The opening hours changed, so we adjusted our schedule _____.","choices":["accordingly","however","meanwhile","instead"]},{"term":"consequently","prompt":"Leo left his passport at home; _____, he could not board the flight.","choices":["consequently","meanwhile","nonetheless","rather"]},{"term":"hence","prompt":"The bridge is closed; _____, we must take another route.","choices":["hence","indeed","similarly","meanwhile"]},{"term":"therefore","prompt":"Every safety test passed; _____, the device is ready to ship.","choices":["therefore","however","likewise","rather"]},{"term":"then","prompt":"Finish labeling each jar first; _____, place it on the correct shelf.","choices":["then","however","indeed","meanwhile"]},{"term":"finally","prompt":"The signature was hidden on the final page; after an hour of checking every sheet, we _____ found it at last.","choices":["finally","meanwhile","similarly","instead"]}]},{"id":"linking-adverbs-v1-addition-time","title":"Bổ sung và so sánh","focus":"Phân biệt ý bổ sung, sự nhấn mạnh và hai trường hợp có điểm tương đồng.","questions":[{"term":"furthermore","prompt":"The bike is affordable; _____, its battery lasts all day.","choices":["furthermore","instead","then","hence"]},{"term":"moreover","prompt":"The museum is free; _____, it is open every Sunday.","choices":["moreover","meanwhile","rather","therefore"]},{"term":"meanwhile","prompt":"The rice is cooking; _____, chop the vegetables while it simmers.","choices":["meanwhile","rather","however","indeed"]},{"term":"indeed","prompt":"The hike was demanding; _____, we climbed for six hours without a break, confirming how strenuous it was.","choices":["indeed","instead","accordingly","similarly"]},{"term":"likewise","prompt":"Mai volunteered at the shelter; _____, her brother gave up weekends to help.","choices":["likewise","then","however","consequently"]},{"term":"similarly","prompt":"The first class improved its scores. _____, the second class made progress.","choices":["similarly","meanwhile","instead","therefore"]}]},{"id":"linking-adverbs-v1-result-action","title":"Đối lập, nhượng bộ và thay thế","focus":"Phân biệt ý trái với dự đoán, kết quả bất chấp trở ngại, và cách sửa hoặc thay thế ý.","questions":[{"term":"however","prompt":"The forecast promised sunshine; _____, it rained all afternoon.","choices":["however","accordingly","likewise","indeed"]},{"term":"nevertheless","prompt":"The path was steep; _____, the hikers continued to the summit.","choices":["nevertheless","hence","meanwhile","therefore"]},{"term":"nonetheless","prompt":"The instructions looked complicated; _____, Ava built the desk.","choices":["nonetheless","moreover","then","accordingly"]},{"term":"instead","prompt":"The café had no tables, so we ordered takeaway _____ of waiting for a seat.","choices":["instead","meanwhile","consequently","indeed"]},{"term":"rather","prompt":"The problem was not the price; _____, the delivery was too slow.","choices":["rather","accordingly","finally","likewise"]}]},{"id":"sentence-structure-patterns-v1-paired-conjunctions","title":"Cặp liên từ và cấu trúc song hành","focus":"Chọn đúng cặp liên từ và giữ hai vế song song về ngữ pháp, ý nghĩa.","questions":[{"term":"either … or","prompt":"For this assignment, each student must _____ write an individual reflection _____ submit one joint report—not both.","choices":["either … or","neither … nor","not only … but also","whether … or"]},{"term":"neither … nor","prompt":"The old plan provided _____ enough time to inspect the site _____ a safe route to the entrance; it lacked both, so the team rejected it.","choices":["neither … nor","both … and","either … or","not only … but also"]},{"term":"not only … but also","prompt":"To emphasize both advantages, complete: “The reading app is _____ easy to use _____ available offline.”","choices":["not only … but also","either … or","neither … nor","whether … or"]}]},{"id":"sentence-structure-patterns-v1-condition-result","title":"Điều kiện, nhượng bộ và kết quả","focus":"Phân biệt nhượng bộ bất kể mức độ, kết quả so sánh và mức độ dẫn đến kết quả.","questions":[{"term":"no matter how","prompt":"_____ carefully the team checked the measurements, the old scale still produced inconsistent results.","choices":["no matter how","as long as","provided that","even though"]},{"term":"so … that","prompt":"The archive was _____ vast _____ the researchers needed several weeks to catalogue its contents.","choices":["so … that","such … that","too … to","as … as"]},{"term":"the more … the more","prompt":"_____ evidence the team examined, _____ confident its conclusion became.","choices":["the more … the more","as … as","so … that","not only … but also"]}]},{"id":"sentence-structure-patterns-v1-inversion-emphasis","title":"Đảo ngữ và câu nhấn mạnh","focus":"Nhận diện đảo trợ động từ sau cụm nhấn mạnh và câu chẻ làm nổi bật thông tin.","questions":[{"term":"not only did","prompt":"In last year's pilot, _____ the revised schedule reduce delays, but it also lowered operating costs.","choices":["not only did","not only does","not only has","not only was"]},{"term":"no sooner … than","prompt":"_____ had the train left _____ the storm reached the station.","choices":["no sooner … than","hardly … than","not until … than","as soon as … than"]},{"term":"it was … that","prompt":"_____ a simple water filter _____ the research team designed, not a costly pump.","choices":["it was … that","there was … which","it had … when","there were … where"]}]},{"id":"sentence-structure-patterns-v1-reduction-substitution","title":"Mệnh đề rút gọn, thay thế và lược bỏ","focus":"Dùng phân từ hoàn thành, câu đáp đồng tình và one/ones để tránh lặp.","questions":[{"term":"having completed","prompt":"_____ the final inspection, the engineer signed the safety certificate.","choices":["having completed","completed having","to have complete","having been complete"]},{"term":"so do I","prompt":"“I enjoy reading historical biographies.” “_____,” Minh replied, agreeing that he enjoyed them too.","choices":["so do I","neither do I","so have I","neither I do"]},{"term":"neither have I","prompt":"“I haven't visited the new gallery yet.” “_____,” Lan replied.","choices":["neither have I","so have I","neither I have","I haven't neither"]},{"term":"one / ones","prompt":"Choose the pair that replaces repeated count nouns: “the smaller _____” (one item) and “the cheaper _____” (several items).","choices":["one / ones","it / them","this / those","some / any"]}]},{"id":"sentence-structure-patterns-v1-preposition-patterns","title":"Giới từ trong cụm thường gặp","focus":"Nhận diện cụm giới từ thông dụng và giới từ đi kèm động từ, tính từ, danh từ.","questions":[{"term":"in advance","prompt":"To secure a seat, please register _____ rather than waiting until the day of the event.","choices":["in advance","at advance","on advance","by advance"]},{"term":"at risk of","prompt":"Without urgent repairs, the old bridge will be _____ collapse.","choices":["at risk of","in risk of","on risk of","at risk to"]},{"term":"on behalf of","prompt":"I am writing _____ the residents' committee to thank the volunteers.","choices":["on behalf of","at behalf of","by behalf of","on behalf to"]},{"term":"rely on","prompt":"During the field study, the researchers had to _____ local guides for accurate directions.","choices":["rely on","rely to","rely for","rely with"]},{"term":"apologize for","prompt":"The supplier chose to _____ the delay and offer a full refund.","choices":["apologize for","apologize of","apologize with","apologize from"]},{"term":"be responsible for","prompt":"As project lead, Mai will _____ checking each citation before publication.","choices":["be responsible for","be responsible of","be responsible with","be responsible from"]},{"term":"be familiar with","prompt":"Please read the guide so you can _____ the new application process.","choices":["be familiar with","be familiar on","be familiar from","be familiar over"]},{"term":"access to","prompt":"Every student should have _____ reliable internet during the course.","choices":["access to","access for","access with","access on"]},{"term":"prevent someone from","prompt":"A clear warning can _____ using the equipment incorrectly.","choices":["prevent someone from","prevent someone to","prevent someone of","prevent someone with"]},{"term":"take part in","prompt":"Several local schools will _____ the regional science fair.","choices":["take part in","take part at","take part of","take part by"]}]},{"id":"sentence-structure-patterns-v1-in-on-at","title":"Phân biệt in, on và at","focus":"Chọn in, on hoặc at theo khoảng thời gian, ngày cụ thể, không gian, bề mặt, địa điểm và cụm cố định.","questions":[{"term":"in September","prompt":"The new term begins _____, at the start of the autumn semester.","choices":["in September","on September","at September","in the September"]},{"term":"on 2 June","prompt":"The conference opens _____, the second day of the month.","choices":["on 2 June","in 2 June","at 2 June","on the 2 June"]},{"term":"at 8:30 a.m.","prompt":"The guided tour starts _____, so please arrive ten minutes early.","choices":["at 8:30 a.m.","in 8:30 a.m.","on 8:30 a.m.","on the 8:30 a.m."]},{"term":"in the morning","prompt":"The bakery is open _____, from sunrise until just before noon.","choices":["in the morning","on the morning","at the morning","in morning"]},{"term":"at night","prompt":"Unlike during the day, the park closes to visitors _____.","choices":["at night","in night","on night","at the night"]},{"term":"in a small drawer","prompt":"The spare key is kept _____ in the kitchen, not left out in the open.","choices":["in a small drawer","on a small drawer","at a small drawer","over a small drawer"]},{"term":"on the desk","prompt":"Leave the signed form _____, resting on the desk's top surface rather than inside a drawer.","choices":["on the desk","in the desk","at the desk","under the desk"]},{"term":"at the main entrance","prompt":"I'll wait for you _____, outside the building; then we can go inside together.","choices":["at the main entrance","in the main entrance","on the main entrance","through the main entrance"]},{"term":"in Singapore","prompt":"They have lived _____ since 2020, though they grew up in Canada.","choices":["in Singapore","on Singapore","at Singapore","through Singapore"]},{"term":"believe in","prompt":"Many people _____ the value of learning a little every day.","choices":["believe in","believe on","believe at","believe for"]},{"term":"focus on","prompt":"The report should _____ the causes of the delay, not assign blame.","choices":["focus on","focus in","focus at","focus for"]},{"term":"good at","prompt":"My sister is _____ solving logic puzzles, even under pressure.","choices":["good at","good in","good on","good for"]},{"term":"interested in","prompt":"Tariq is _____ marine biology and reads about it every evening.","choices":["interested in","interested on","interested at","interested for"]}]}],"entriesByTerm":{"as if":{"term":"as if","definition":"Như thể, như là; mô tả điều gì đó có vẻ đúng hoặc được hình dung như thật, nhưng không khẳng định tình huống ấy là sự thật. Ghi chú: Gần nghĩa với as though; thường thay được khi nói “như thể”. As if thông dụng hơn; cả hai mô tả vẻ ngoài hoặc tình huống được hình dung, không tự nêu điều kiện.","example":"The child spoke to the author as if they had known each other for years.","exampleTranslation":"Đứa trẻ nói chuyện với tác giả như thể hai người đã quen nhau nhiều năm.","pos":"conj","subPos":"subordinating"},"as long as":{"term":"as long as","definition":"Miễn là; đặt điều kiện để việc ở mệnh đề chính được chấp nhận hoặc tiếp tục. Cụm này cũng có thể chỉ khoảng thời gian kéo dài. Ghi chú: Gần nghĩa với provided that khi nêu điều kiện; provided that thường trang trọng hoặc chính thức hơn. As long as còn có thể chỉ khoảng thời gian kéo dài.","example":"You may borrow my compass as long as you return it before sunset.","exampleTranslation":"Bạn có thể mượn la bàn miễn là trả lại trước khi mặt trời lặn.","pos":"conj","subPos":"subordinating"},"as much as":{"term":"as much as","definition":"Dù ... đến đâu; ở đầu mệnh đề, cụm này nhượng bộ một điều (thường là điều người nói thực sự cảm thấy) trước khi nêu ý trái ngược. Ghi chú: Ở đầu mệnh đề, cụm này nhượng bộ, gần nghĩa với although (“mặc dù/dù ... đến đâu”). Trong cấu trúc chỉ số lượng, as much as lại có nghĩa “nhiều bằng”.","example":"As much as I like the idea, I cannot approve the budget without figures.","exampleTranslation":"Dù rất thích ý tưởng đó, tôi không thể duyệt ngân sách khi chưa có số liệu.","pos":"conj","subPos":"subordinating"},"as soon as":{"term":"as soon as","definition":"Ngay khi; việc ở mệnh đề chính xảy ra ngay sau khi mốc được nêu ở mệnh đề sau. Ghi chú: Nhấn mạnh việc ở mệnh đề chính xảy ra ngay sau khi mốc vừa đến. Khác by the time (đến mốc thì việc khác đã xảy ra, hoàn tất hoặc đang kéo dài) và just as (hai việc cùng lúc hoặc gần như cùng lúc).","example":"Text me as soon as you see the plane's landing lights; do not wait for it to reach the gate.","exampleTranslation":"Hãy nhắn cho tôi ngay khi thấy đèn hạ cánh của máy bay; đừng đợi máy bay tới cổng.","pos":"conj","subPos":"subordinating"},"as far as":{"term":"as far as","definition":"Theo như, trong phạm vi mà thông tin hoặc hiểu biết cho phép; giới hạn nhận định đang nêu, không diễn tả điều kiện. Ghi chú: Trong as far as I know/can tell, cụm này giới hạn nhận định theo thông tin hoặc hiểu biết hiện có. Khác just as (“đúng lúc/đúng như”) và as long as (“miễn là”).","example":"As far as I can tell from the map, the footpath ends at the river.","exampleTranslation":"Theo như tôi có thể nhận định từ bản đồ, lối mòn kết thúc ở con sông.","pos":"conj","subPos":"subordinating"},"as though":{"term":"as though","definition":"Như thể, dường như; mô tả một ấn tượng hoặc tình huống được hình dung, chứ không xác nhận tình huống ấy là thật. Ghi chú: Gần nghĩa với as if; thường thay được khi nói “như thể”. As though đôi khi trang trọng hoặc thiên về văn viết hơn; cả hai mô tả vẻ ngoài hoặc tình huống được hình dung, không tự nêu điều kiện.","example":"The dog stared at the empty bowl as though it were still full.","exampleTranslation":"Con chó nhìn chằm chằm vào chiếc bát trống như thể bát vẫn còn đầy.","pos":"conj","subPos":"subordinating"},"by the time":{"term":"by the time","definition":"Đến lúc ... thì; nêu một mốc mà trước hoặc ngay tại đó, việc khác đã xảy ra, hoàn tất hoặc kéo dài đến mốc ấy. Ghi chú: Nêu mốc mà khi tới đó việc khác đã xảy ra, hoàn tất hoặc đang kéo dài; thường đi với thì hoàn thành. Khác as soon as (“ngay sau khi”) và just as (“cùng lúc”).","example":"The rescue team had been waiting at the village for two hours by the time the ambulance arrived.","exampleTranslation":"Đến lúc xe cứu thương đến, đội cứu hộ đã chờ ở làng được hai tiếng.","pos":"conj","subPos":"subordinating"},"inasmuch as":{"term":"inasmuch as","definition":"Bởi vì, xét theo mức độ mà; cách nói trang trọng, dùng để nêu lý do hoặc giới hạn phạm vi. Ghi chú: Gần nghĩa với because/since khi nêu lý do, nhưng trang trọng hơn; đôi khi có nghĩa “xét theo mức độ/trong phạm vi mà”. Không đồng nghĩa provided that (đặt điều kiện).","example":"Inasmuch as two signatures are missing, we cannot approve the form.","exampleTranslation":"Vì còn thiếu hai chữ ký, chúng tôi chưa thể duyệt biểu mẫu.","pos":"conj","subPos":"subordinating"},"in order that":{"term":"in order that","definition":"Để, nhằm để; giới thiệu mục đích, thường dùng trong văn phong trang trọng và hay đi với can, could, may hoặc might. Ghi chú: Gần nghĩa với so that khi nêu mục đích; in order that thường trang trọng và nhấn mạnh mục đích hơn, hay đi với can/could/may/might. So that thông dụng hơn và còn có thể nêu kết quả.","example":"The guide repeated each step slowly in order that every visitor could follow.","exampleTranslation":"Người hướng dẫn lặp lại từng bước chậm rãi để mọi khách tham quan có thể theo kịp.","pos":"conj","subPos":"subordinating"},"in case":{"term":"in case","definition":"Phòng khi; nói về việc chuẩn bị hoặc biện pháp để ứng phó nếu một khả năng xảy ra, không đơn thuần nêu điều kiện như if. Ghi chú: Nêu việc chuẩn bị trước để phòng một khả năng xảy ra; khác if, vốn đặt điều kiện để hành động hoặc kết quả xảy ra.","example":"Save the emergency number in your phone in case you need help.","exampleTranslation":"Hãy lưu số khẩn cấp vào điện thoại phòng khi bạn cần trợ giúp.","pos":"conj","subPos":"subordinating"},"now that":{"term":"now that","definition":"Giờ đây vì, vì hiện tại; nêu hoàn cảnh hiện tại làm lý do cho việc ở mệnh đề chính. Hoàn cảnh đó không nhất thiết vừa mới thay đổi. Ghi chú: Gần nghĩa với since/because khi hoàn cảnh hiện tại là lý do cho việc khác; hoàn cảnh đó không nhất thiết vừa mới thay đổi. Khác now when (đặt sự việc vào thời điểm hiện tại, đôi khi lặp lại).","example":"Now that the final repair is complete, the library can reopen; the safety issue that forced it to close is gone.","exampleTranslation":"Giờ việc sửa chữa cuối cùng đã xong, thư viện có thể mở cửa lại vì vấn đề an toàn khiến nơi này phải đóng cửa đã được xử lý.","pos":"conj","subPos":"subordinating"},"now when":{"term":"now when","definition":"Giờ đây khi, giờ đây mỗi khi; đặt sự việc ở mệnh đề sau vào bối cảnh hiện tại, có thể nói về một lần cụ thể hoặc việc lặp lại; không nêu lý do như now that. Ghi chú: Đặt một sự việc vào thời điểm hiện tại (“giờ đây khi”) hoặc diễn tả sự việc lặp lại (“giờ đây mỗi khi”); khác now that, vốn nêu lý do (“vì giờ đây ...”). Cách dùng này ít phổ biến hơn when/whenever.","example":"I used to ignore the old school bell, but now when I hear it, I remember my first day.","exampleTranslation":"Trước đây tôi thường bỏ qua tiếng chuông trường cũ, nhưng giờ mỗi khi nghe thấy, tôi lại nhớ ngày đầu tiên đi học.","pos":"conj","subPos":"subordinating"},"even if":{"term":"even if","definition":"Ngay cả nếu, ngay cả khi; nêu một điều kiện hoặc khả năng chưa xác định, trong khi kết quả vẫn đúng dù điều kiện ấy có xảy ra hay không. Ghi chú: Nêu điều kiện hoặc khả năng chưa xác định mà kết quả vẫn đúng dù điều đó có xảy ra hay không; khác even though, vốn nhượng bộ điều được trình bày như thật hoặc đã biết.","example":"The forecast is uncertain. Even if it snows tonight, the airport will remain open.","exampleTranslation":"Dự báo chưa chắc chắn. Ngay cả khi tối nay có tuyết, sân bay vẫn mở cửa.","pos":"conj","subPos":"subordinating"},"even though":{"term":"even though","definition":"Mặc dù, dẫu cho; nhượng bộ một sự việc được trình bày như thật hoặc đã biết, trái với điều thường được mong đợi. Ghi chú: Nhượng bộ điều được trình bày như thật hoặc đã biết; khác even if, vốn nêu điều kiện hoặc khả năng chưa xác định.","example":"Even though the road was icy, the bus still arrived on time.","exampleTranslation":"Mặc dù mặt đường phủ băng, xe buýt vẫn đến đúng giờ.","pos":"conj","subPos":"subordinating"},"provided that":{"term":"provided that","definition":"Với điều kiện là, miễn là; đặt điều kiện cần để mệnh đề chính đúng. Thường trang trọng hoặc chính thức hơn if. Ghi chú: Gần nghĩa với as long as khi nêu điều kiện; provided that thường trang trọng hoặc chính thức hơn và nhấn mạnh điều kiện cần đáp ứng.","example":"The lab will accept your sample provided that it is sealed before noon.","exampleTranslation":"Phòng thí nghiệm sẽ nhận mẫu với điều kiện mẫu được niêm phong trước buổi trưa.","pos":"conj","subPos":"subordinating"},"if only":{"term":"if only","definition":"Giá mà; mở đầu lời ước hoặc tiếc nuối. Khi nói về quá khứ, thường diễn tả điều người nói mong đã xảy ra nhưng thực tế không xảy ra. Ghi chú: Mở đầu lời ước hoặc tiếc nuối; với việc trong quá khứ, thường nói về điều đã không xảy ra. Khác only if (“chỉ nếu”), vốn nêu điều kiện.","example":"If only I had kept the receipt! I could have returned these headphones yesterday.","exampleTranslation":"Giá mà tôi đã giữ hóa đơn! Hôm qua tôi đã có thể trả lại chiếc tai nghe này.","pos":"conj","subPos":"subordinating"},"just as":{"term":"just as","definition":"Đúng lúc, ngay khi; trong nghĩa chỉ thời gian, nêu hai việc xảy ra cùng lúc hoặc gần như cùng lúc. Ghi chú: Trong nghĩa chỉ thời gian, just as nói hai việc xảy ra cùng lúc hoặc gần như cùng lúc; khác as soon as (việc sau xảy ra ngay sau mốc) và as if/as though (“như thể”).","example":"The striker kicked the ball just as the referee blew the whistle to start the match.","exampleTranslation":"Tiền đạo sút bóng đúng lúc trọng tài thổi còi khai cuộc.","pos":"conj","subPos":"subordinating"},"so that":{"term":"so that","definition":"Để, để cho; thường nêu mục đích và thông dụng hơn in order that. Tùy ngữ cảnh, cụm này cũng có thể nêu kết quả. Ghi chú: Gần nghĩa với in order that khi nêu mục đích nhưng thông dụng hơn. So that cũng có thể nêu kết quả tùy ngữ cảnh; in order that thường trang trọng và thiên về mục đích hơn.","example":"Nora labeled every jar so that nobody would confuse the spices.","exampleTranslation":"Nora dán nhãn lên từng lọ để không ai nhầm các loại gia vị.","pos":"conj","subPos":"subordinating"},"accordingly":{"definition":"Theo đó; điều chỉnh hành động cho phù hợp với tình huống. Ghi chú: Khác therefore/consequently, vốn chỉ kết quả hoặc kết luận; accordingly nhấn mạnh cách ta thay đổi cho thích hợp.","example":"The opening hours changed, so we adjusted our schedule accordingly.","exampleTranslation":"Giờ mở cửa đã thay đổi, vì vậy chúng tôi điều chỉnh lịch trình cho phù hợp."},"consequently":{"definition":"Do đó; nêu kết quả trực tiếp của sự việc trước. Ghi chú: Gần nghĩa với therefore/hence; consequently thường nhấn mạnh hệ quả trực tiếp, còn therefore thường trình bày kết luận.","example":"Leo left his passport at home; consequently, he could not board the flight.","exampleTranslation":"Leo để quên hộ chiếu ở nhà; vì vậy, cậu ấy không thể lên máy bay."},"hence":{"definition":"Vì vậy; nối một lý do với kết luận hoặc kết quả. Ghi chú: Gần nghĩa với therefore/consequently; hence thường ngắn gọn, hơi trang trọng. Khác instead, vốn chỉ phương án thay thế.","example":"The bridge is closed; hence, we must take another route.","exampleTranslation":"Cây cầu đã đóng; vì vậy, chúng ta phải đi đường khác."},"therefore":{"definition":"Do đó; đưa ra kết luận hợp lý từ thông tin trước. Ghi chú: Gần nghĩa với hence/consequently; therefore thường nhấn mạnh suy luận hoặc kết luận, còn accordingly nhấn mạnh hành động được điều chỉnh.","example":"Every safety test passed; therefore, the device is ready to ship.","exampleTranslation":"Mọi bài kiểm tra an toàn đều đạt; vì vậy, thiết bị đã sẵn sàng để giao."},"then":{"definition":"Sau đó; chỉ bước tiếp theo trong một trình tự. Ghi chú: Khác meanwhile, chỉ hai việc diễn ra đồng thời; khác finally, nhấn mạnh bước cuối của cả chuỗi.","example":"Label each jar; then, place it on the correct shelf.","exampleTranslation":"Hãy dán nhãn từng lọ; sau đó, đặt lọ lên đúng kệ."},"finally":{"definition":"Cuối cùng; chỉ bước cuối hoặc kết quả ở cuối một chuỗi. Ghi chú: Then chỉ bước tiếp theo, không nhất thiết là bước cuối.","example":"We checked every page and finally found the missing signature.","exampleTranslation":"Chúng tôi kiểm tra từng trang và cuối cùng tìm thấy chữ ký còn thiếu."},"furthermore":{"definition":"Hơn nữa; bổ sung một lý do hoặc thông tin hỗ trợ. Ghi chú: Gần như đồng nghĩa với moreover; hai từ thường thay được. Cả hai thêm ý hỗ trợ, không nêu kết quả như therefore.","example":"The bike is affordable; furthermore, its battery lasts all day.","exampleTranslation":"Chiếc xe đạp có giá phải chăng; hơn nữa, pin dùng được cả ngày."},"moreover":{"definition":"Hơn nữa; thêm một ý hỗ trợ cho nhận định trước. Ghi chú: Gần như đồng nghĩa với furthermore; moreover đôi khi nhấn mạnh ý bổ sung hơn, nhưng khác biệt này không cố định.","example":"The museum is free; moreover, it is open every Sunday.","exampleTranslation":"Bảo tàng miễn phí; hơn nữa, nơi này mở cửa vào mỗi Chủ nhật."},"meanwhile":{"definition":"Trong lúc đó; hai việc diễn ra đồng thời. Ghi chú: Khác then, vốn nêu việc xảy ra tiếp theo; meanwhile thường mang nghĩa “trong cùng khoảng thời gian”.","example":"The rice is cooking; meanwhile, chop the vegetables.","exampleTranslation":"Cơm đang nấu; trong lúc đó, hãy cắt rau củ."},"however":{"definition":"Tuy nhiên; nêu một ý trái với điều người đọc có thể mong đợi. Ghi chú: Gần nghĩa với nevertheless/nonetheless; however thường báo hiệu sự tương phản, còn hai từ kia nhấn mạnh kết quả vẫn xảy ra bất chấp trở ngại.","example":"The forecast promised sunshine; however, it rained all afternoon.","exampleTranslation":"Dự báo nói trời sẽ nắng; tuy nhiên, trời mưa suốt buổi chiều."},"nevertheless":{"definition":"Dù vậy; nhấn mạnh kết quả vẫn xảy ra bất chấp trở ngại. Ghi chú: Gần như đồng nghĩa với nonetheless; cả hai cũng gần nghĩa với however, nhưng thường nhấn mạnh sự việc vẫn tiếp diễn dù có trở ngại.","example":"The path was steep; nevertheless, the hikers continued to the summit.","exampleTranslation":"Con đường dốc; dù vậy, nhóm đi bộ vẫn tiếp tục lên đỉnh."},"nonetheless":{"definition":"Mặc dù thế; cho biết sự việc vẫn xảy ra dù có trở ngại. Ghi chú: Gần như đồng nghĩa với nevertheless; khác however ở sắc thái nhấn mạnh kết quả bất chấp trở ngại, dù trong nhiều câu có thể thay nhau.","example":"The instructions looked complicated; nonetheless, Ava built the desk.","exampleTranslation":"Hướng dẫn trông có vẻ phức tạp; mặc dù thế, Ava vẫn lắp được chiếc bàn."},"instead":{"definition":"Thay vào đó; chọn một hành động khác để thay thế. Ghi chú: Khác rather trong câu sửa lại nhận định (“không phải X, mà đúng hơn là Y”); instead nêu phương án thay thế.","example":"The café had no tables, so we ordered takeaway instead.","exampleTranslation":"Quán cà phê không còn bàn, vì vậy chúng tôi gọi đồ mang đi thay vào đó."},"rather":{"definition":"Đúng hơn là; sửa lại hoặc nói chính xác hơn ý vừa nêu. Ghi chú: Khác instead, vốn thay một lựa chọn/hành động bằng lựa chọn khác; rather thường hiệu chỉnh cách diễn đạt hoặc nhận định trước.","example":"The problem was not the price; rather, the delivery was too slow.","exampleTranslation":"Vấn đề không nằm ở giá; đúng hơn là khâu giao hàng quá chậm."},"indeed":{"definition":"Quả thật; nhấn mạnh hoặc củng cố ý vừa nêu, thường đưa bằng chứng cụ thể. Ghi chú: Khác moreover/furthermore, vốn thêm một ý mới thay vì xác nhận hoặc củng cố ý trước.","example":"The hike was demanding; indeed, we climbed for six hours.","exampleTranslation":"Chuyến đi bộ thật vất vả; quả thật, chúng tôi đã leo suốt sáu tiếng."},"likewise":{"definition":"Tương tự như vậy; nối một trường hợp có cách làm giống trường hợp trước. Ghi chú: Gần nghĩa với similarly; likewise thường nhấn mạnh hành động tương ứng hoặc “cũng vậy”, nhưng nhiều ngữ cảnh có thể thay nhau.","example":"Mai volunteered at the shelter; likewise, her brother gave up weekends to help.","exampleTranslation":"Mai tình nguyện ở mái ấm; tương tự, anh trai cô cũng dành cuối tuần để giúp đỡ."},"similarly":{"definition":"Tương tự; chỉ ra rằng trường hợp tiếp theo có điểm giống trường hợp trước. Ghi chú: Gần nghĩa với likewise; similarly thường giới thiệu phép so sánh giữa hai trường hợp, còn likewise hay nhấn mạnh hành động tương ứng.","example":"The first class improved its scores. Similarly, the second class made progress.","exampleTranslation":"Lớp đầu tiên cải thiện điểm số. Tương tự, lớp thứ hai cũng tiến bộ."},"either … or":{"definition":"Cặp liên từ nối hai phương án để chọn một trong hai theo ngữ cảnh. Hai vế sau either và or nên cùng dạng ngữ pháp; nếu muốn nói cả hai đều không đúng, dùng neither … nor.","example":"For this assignment, each student must either write an individual reflection or submit one joint report.","exampleTranslation":"Với bài tập này, mỗi học viên phải chọn viết bài cảm nhận cá nhân hoặc nộp một báo cáo chung."},"neither … nor":{"definition":"Cặp liên từ phủ định cả hai khả năng, nghĩa là “không… cũng không…”. Hai thành phần nối với nhau cần song song; động từ thường hòa hợp với chủ ngữ đứng gần nor.","example":"The old plan provided neither enough time to inspect the site nor a safe route to the entrance.","exampleTranslation":"Kế hoạch cũ không dành đủ thời gian để kiểm tra địa điểm, cũng không có lối đi an toàn tới lối vào."},"not only … but also":{"definition":"Cặp liên từ nhấn mạnh rằng cả hai đặc điểm hoặc hành động đều đúng. Giữ hai vế nối với not only và but also cùng dạng; nếu Not only đứng đầu một mệnh đề, đảo trợ động từ lên trước chủ ngữ.","example":"The reading app is not only easy to use but also available offline.","exampleTranslation":"Ứng dụng đọc này không chỉ dễ sử dụng mà còn dùng được khi ngoại tuyến."},"no matter how":{"definition":"Nghĩa là “dù… đến mức nào”. Dùng no matter how + tính từ/trạng từ + chủ ngữ + động từ; kết quả ở mệnh đề chính vẫn không thay đổi dù mức độ ra sao.","example":"No matter how carefully the team checked the measurements, the old scale produced inconsistent results.","exampleTranslation":"Dù nhóm kiểm tra các số đo cẩn thận đến đâu, chiếc cân cũ vẫn cho kết quả không nhất quán."},"so … that":{"definition":"Cấu trúc chỉ mức độ dẫn đến kết quả: so + tính từ/trạng từ + that + mệnh đề. Khác such … that, vốn thường đi với cụm danh từ.","example":"The archive was so vast that the researchers needed several weeks to catalogue its contents.","exampleTranslation":"Kho lưu trữ rộng lớn đến mức các nhà nghiên cứu cần vài tuần để lập danh mục nội dung."},"the more … the more":{"definition":"Cấu trúc so sánh kép diễn tả hai yếu tố thay đổi cùng chiều: “càng… thì càng…”. Mỗi vế bắt đầu bằng the more; sau đó có thể là danh từ rồi đến chủ ngữ và động từ, hoặc tính từ/trạng từ trong một mệnh đề.","example":"The more evidence the team examined, the more confident its conclusion became.","exampleTranslation":"Nhóm càng xem xét nhiều bằng chứng thì càng tự tin vào kết luận của mình."},"not only did":{"definition":"Khi Not only đứng đầu mệnh đề quá khứ đơn để nhấn mạnh, dùng Not only + did + chủ ngữ + động từ nguyên mẫu; không dùng động từ quá khứ sau did. Mệnh đề song hành thường tiếp tục bằng but (also).","example":"Not only did the revised schedule reduce delays, but it also lowered operating costs.","exampleTranslation":"Lịch trình sửa đổi không chỉ giảm chậm trễ mà còn hạ chi phí vận hành."},"no sooner … than":{"definition":"Diễn tả việc thứ hai xảy ra ngay sau việc thứ nhất. Khi No sooner đứng đầu câu, dùng No sooner + had + chủ ngữ + quá khứ phân từ, rồi than + chủ ngữ + động từ quá khứ đơn.","example":"No sooner had the train left than the storm reached the station.","exampleTranslation":"Tàu vừa rời đi thì cơn bão đã tới nhà ga."},"it was … that":{"definition":"Câu chẻ It was + thành phần cần nhấn mạnh + that + phần còn lại của câu. Ở ví dụ này, that nối phần được nhấn mạnh (vật được thiết kế) với mệnh đề còn lại; với người, đôi khi có thể dùng who thay that.","example":"It was a simple water filter that the research team designed, not a costly pump.","exampleTranslation":"Thứ nhóm nghiên cứu thiết kế là một bộ lọc nước đơn giản, chứ không phải máy bơm đắt tiền."},"having completed":{"definition":"Cụm phân từ hoàn thành having + quá khứ phân từ cho biết hành động ở mệnh đề rút gọn đã xong trước hành động ở mệnh đề chính. Chủ thể ngầm của hai mệnh đề phải giống nhau.","example":"Having completed the final inspection, the engineer signed the safety certificate.","exampleTranslation":"Sau khi hoàn tất đợt kiểm tra cuối cùng, kỹ sư đã ký giấy chứng nhận an toàn."},"so do I":{"definition":"Dùng So + trợ động từ + chủ ngữ để đồng tình với câu khẳng định. Lấy trợ động từ phù hợp với động từ và thì của câu trước; ở đây do thay cho enjoy reading. Trật tự là trợ động từ rồi đến chủ ngữ.","example":"“I enjoy reading historical biographies.” “So do I,” Minh replied.","exampleTranslation":"“Tôi thích đọc tiểu sử lịch sử.” “Tôi cũng vậy,” Minh đáp."},"neither have I":{"definition":"Dùng Neither + trợ động từ + chủ ngữ để đồng tình với câu phủ định. Lấy trợ động từ phù hợp với động từ và thì của câu trước; hiện tại hoàn thành dùng have/has. Trật tự là trợ động từ rồi đến chủ ngữ.","example":"“I haven't visited the new gallery yet.” “Neither have I,” Lan replied.","exampleTranslation":"“Tôi vẫn chưa đến phòng trưng bày mới.” “Tôi cũng chưa,” Lan đáp."},"one / ones":{"definition":"One thay cho danh từ đếm được số ít đã nhắc; ones thay cho danh từ đếm được số nhiều. Dùng chúng để tránh lặp danh từ, thường sau mạo từ hoặc tính từ.","example":"I prefer the blue one to the red ones because the blue jacket is in better condition.","exampleTranslation":"Tôi thích chiếc màu xanh hơn những chiếc màu đỏ vì chiếc áo khoác xanh còn tốt hơn."},"in advance":{"definition":"Cụm trạng ngữ nghĩa là “trước” hoặc “trước thời điểm cần thiết”, thường dùng khi chuẩn bị, đặt chỗ hoặc thông báo sớm.","example":"To secure a seat, please register in advance rather than waiting until the day of the event.","exampleTranslation":"Để giữ chỗ, vui lòng đăng ký trước thay vì chờ đến ngày diễn ra sự kiện."},"at risk of":{"definition":"Cụm at risk of + danh từ hoặc V-ing diễn tả nguy cơ gặp phải điều không mong muốn.","example":"Without urgent repairs, the old bridge is at risk of collapse.","exampleTranslation":"Nếu không được sửa chữa khẩn cấp, cây cầu cũ có nguy cơ sập."},"on behalf of":{"definition":"Cụm giới từ nghĩa là “thay mặt cho” hoặc “vì lợi ích của”, dùng khi nói hay hành động đại diện cho một người hoặc nhóm.","example":"I am writing on behalf of the residents' committee to thank the volunteers.","exampleTranslation":"Tôi viết thư thay mặt ban đại diện cư dân để cảm ơn các tình nguyện viên."},"rely on":{"definition":"Rely on + người/vật nghĩa là dựa vào hoặc tin cậy người hay điều đó để được hỗ trợ; giới từ on đi với động từ rely trong nghĩa này.","example":"During the field study, the researchers had to rely on local guides for accurate directions.","exampleTranslation":"Trong chuyến khảo sát thực địa, các nhà nghiên cứu phải dựa vào hướng dẫn viên địa phương để có chỉ đường chính xác."},"apologize for":{"definition":"Apologize for + danh từ hoặc V-ing dùng để xin lỗi về điều gì hay hành động nào; apologize to + người nhận lời xin lỗi.","example":"The supplier chose to apologize for the delay and offer a full refund.","exampleTranslation":"Nhà cung cấp quyết định xin lỗi vì sự chậm trễ và đề nghị hoàn tiền đầy đủ."},"be responsible for":{"definition":"Be responsible for + danh từ hoặc V-ing nghĩa là chịu trách nhiệm hoặc phụ trách việc đó; trong ngữ cảnh khác, responsible for cũng có thể chỉ nguyên nhân gây ra điều gì.","example":"As project lead, Mai is responsible for checking each citation before publication.","exampleTranslation":"Với vai trò trưởng dự án, Mai chịu trách nhiệm kiểm tra từng trích dẫn trước khi xuất bản."},"be familiar with":{"definition":"Be familiar with + người/vật/quy trình nghĩa là quen thuộc hoặc hiểu biết về đối tượng đó.","example":"Please read the guide so you can become familiar with the new application process.","exampleTranslation":"Vui lòng đọc hướng dẫn để làm quen với quy trình nộp đơn mới."},"access to":{"definition":"Access to + danh từ nghĩa là quyền hoặc khả năng tiếp cận, sử dụng thứ gì; danh từ access thường đi với giới từ to.","example":"Every student should have access to reliable internet during the course.","exampleTranslation":"Mọi học viên đều nên có quyền tiếp cận Internet ổn định trong suốt khóa học."},"prevent someone from":{"definition":"Prevent someone from + V-ing nghĩa là ngăn ai làm việc gì; sau from dùng danh động từ, không dùng to + động từ.","example":"A clear warning can prevent someone from using the equipment incorrectly.","exampleTranslation":"Một cảnh báo rõ ràng có thể ngăn ai đó sử dụng thiết bị sai cách."},"take part in":{"definition":"Take part in + hoạt động/sự kiện nghĩa là tham gia; giới từ in đi cùng cụm động từ take part.","example":"Several local schools will take part in the regional science fair.","exampleTranslation":"Một số trường địa phương sẽ tham gia hội chợ khoa học cấp vùng."},"in September":{"definition":"Dùng in với tháng, năm, mùa và những khoảng thời gian dài hơn một ngày: in September, in 2026, in winter. Hãy nghĩ đến một khoảng thời gian bao quanh sự việc.","example":"The new term begins in September.","exampleTranslation":"Học kỳ mới bắt đầu vào tháng Chín."},"on 2 June":{"definition":"Dùng on với ngày trong tuần và ngày tháng cụ thể: on Monday, on 2 June. Ngày cụ thể được xem như một mốc trên lịch.","example":"The conference opens on 2 June.","exampleTranslation":"Hội nghị khai mạc vào ngày 2 tháng Sáu."},"at 8:30 a.m.":{"definition":"Dùng at với giờ cụ thể và một số mốc thời gian chính xác: at 8:30 a.m., at noon, at midnight. Tuy nhiên, cách nói thông dụng là at night.","example":"The guided tour starts at 8:30 a.m.","exampleTranslation":"Chuyến tham quan có hướng dẫn bắt đầu lúc 8 giờ 30 sáng."},"in the morning":{"definition":"Dùng in the với các khoảng trong ngày: in the morning, in the afternoon, in the evening. Đây là các khoảng thời gian, khác với at night.","example":"The bakery is open in the morning.","exampleTranslation":"Tiệm bánh mở cửa vào buổi sáng."},"at night":{"definition":"Dùng at night để nói chung về ban đêm; đây là cách dùng cố định khác với in the morning, in the afternoon và in the evening.","example":"The park closes to visitors at night.","exampleTranslation":"Công viên đóng cửa với khách tham quan vào ban đêm."},"in a small drawer":{"definition":"Dùng in khi vật nằm bên trong một không gian có ranh giới, như phòng, hộp hoặc ngăn kéo. Với địa điểm rộng như thành phố và quốc gia, in cũng là lựa chọn phổ biến.","example":"The spare key is kept in a small drawer in the kitchen.","exampleTranslation":"Chìa khóa dự phòng được cất trong một ngăn kéo nhỏ ở nhà bếp."},"on the desk":{"definition":"Dùng on khi vật tiếp xúc hoặc được đặt trên một bề mặt; bề mặt có thể nằm ngang như bàn hoặc thẳng đứng như tường.","example":"Leave the signed form on the desk.","exampleTranslation":"Hãy để tờ đơn đã ký trên bàn."},"at the main entrance":{"definition":"Dùng at để xem một nơi như điểm đến hoặc điểm hẹn cụ thể, chẳng hạn at the entrance, at the bus stop. Khác với in (bên trong không gian) và on (trên bề mặt).","example":"I'll wait for you at the main entrance.","exampleTranslation":"Tôi sẽ đợi bạn ở lối vào."},"in Singapore":{"definition":"Dùng in với thành phố, quốc gia và khu vực rộng để nói một việc xảy ra trong phạm vi địa lý đó.","example":"They have lived in Singapore since 2020.","exampleTranslation":"Họ đã sống ở Singapore từ năm 2020."},"believe in":{"definition":"Believe in + người, ý tưởng hoặc giá trị nghĩa là tin tưởng người đó, hoặc tin điều/ý tưởng đó có thật hay đáng tin; in đi với believe trong các nghĩa này. Không nhầm với believe someone (tin lời ai nói).","example":"Many people believe in the value of learning a little every day.","exampleTranslation":"Nhiều người tin vào giá trị của việc học một chút mỗi ngày."},"focus on":{"definition":"Focus on + chủ đề hoặc việc cần làm nghĩa là tập trung vào điều đó; on là giới từ đi với focus trong nghĩa này.","example":"The report should focus on the causes of the delay.","exampleTranslation":"Bản báo cáo nên tập trung vào những nguyên nhân gây chậm trễ."},"good at":{"definition":"Good at + danh từ hoặc V-ing diễn tả giỏi hoặc có năng khiếu trong lĩnh vực/hoạt động đó; khác good for, nghĩa là có ích hoặc phù hợp.","example":"My sister is good at solving logic puzzles.","exampleTranslation":"Chị tôi giỏi giải các câu đố logic."},"interested in":{"definition":"Interested in + danh từ hoặc V-ing nghĩa là quan tâm hoặc hứng thú với điều gì; tính từ interested thường đi với in.","example":"Tariq is interested in marine biology.","exampleTranslation":"Tariq quan tâm đến ngành sinh học biển."}},"progressPrefixes":["subordinating-conjunctions-v1","linking-adverbs-v1","sentence-structure-patterns-v1"]},{"id":"ielts-topic-vocabulary-v1","title":"IELTS","description":"Học 6.432 từ vựng phổ biến và học thuật qua 38 chủ đề IELTS. Ưu tiên chính tả Anh-Anh; các dạng Anh-Mỹ hữu ích được ghi chú là biến thể.","lessons":[{"id":"ielts-topic-vocabulary-v1-society-lesson-2","title":"Bài 43","focus":"Cộng đồng, dân số, phúc lợi, quan hệ xã hội và thay đổi xã hội.","topicId":"society","topicTitle":"Xã hội và cộng đồng","questions":[{"term":"societal","prompt":"The study looks at _____ changes over time.","choices":["societal","fern","finch","fish"]},{"term":"society","prompt":"We all have certain duties towards our local _____.","choices":["society","literary","traditional","customary"]},{"term":"social","prompt":"_____ inequality can limit access to education and healthcare.","choices":["social","urchin","usher","venue"]},{"term":"socialise","prompt":"Children _____ easily at the park.","choices":["socialise","develop","developed","developing"]},{"term":"socialism","prompt":"Many people study scientific _____ in college.","choices":["socialism","chill","choke","cigarette"]},{"term":"socialist","prompt":"He is a _____ who cares about fairness.","choices":["socialist","death","deficiency","dehydration"]},{"term":"socialization","prompt":"School supports _____ through play and talk.","choices":["socialization","neuro","neurologist","neurology"]},{"term":"socialize","prompt":"The city plans to _____ the local bus system.","choices":["socialize","graze","hoeing","hogs"]},{"term":"socially","prompt":"Volunteering helps people connect _____ with their neighbors.","choices":["socially","educator","learned","learner"]},{"term":"equal","prompt":"Their scores were _____ at the end.","choices":["equal","positively","possibility","possibly"]},{"term":"equaled","prompt":"The new plan _____ the old one.","choices":["equaled","determine","differentiate","distinguish"]},{"term":"equalise","prompt":"The teacher will _____ the scores before lunch.","choices":["equalise","breezily","bright","brilliant"]},{"term":"equalization","prompt":"The reform aimed at _____ of school fees.","choices":["equalization","uncertainty","uplift","urge"]},{"term":"equalize","prompt":"They _____ the game in the final minute.","choices":["equalize","fore","foremost","forever"]},{"term":"equalized","prompt":"The technician _____ the levels on both speakers.","choices":["equalized","dart","defeat","dive"]},{"term":"equally","prompt":"He moved _____ through the crowd.","choices":["equally","migration","immigrating","immigration"]},{"term":"poverty","prompt":"Extreme _____ can affect many people in this region.","choices":["poverty","legislator","administration","administrator"]},{"term":"urban","prompt":"Many people prefer living in an _____ environment.","choices":["urban","swim","swimsuit","swing"]},{"term":"urbanisation","prompt":"The rapid _____ of rural areas has changed the landscape.","choices":["urbanisation","dryness","dust","eruption"]},{"term":"urbanise","prompt":"New roads can _____ a quiet village.","choices":["urbanise","traffic","vehicle","road"]},{"term":"urbanize","prompt":"The village began to _____ after the road opened.","choices":["urbanize","visitor","attraction","sightseeing"]},{"term":"population","prompt":"The _____ of the town is growing fast.","choices":["population","empowered","inclusive","inclusively"]},{"term":"community","prompt":"Most Libyan policemen were members of the _____ where they worked.","choices":["community","observable","observe","oceanographic"]},{"term":"culture","prompt":"Education is essential for the _____ of mind.","choices":["culture","agricultural","farmable","farmed"]},{"term":"ethic","prompt":"A strong _____ of fairness should guide every public decision.","choices":["ethic","groundwork","guess","heed"]},{"term":"ethical","prompt":"We discussed the _____ side of the decision.","choices":["ethical","stagger","stag","stall"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-topic-vocabulary-v1-society-lesson-3","title":"Bài 44","focus":"Cộng đồng, dân số, phúc lợi, quan hệ xã hội và thay đổi xã hội.","topicId":"society","topicTitle":"Xã hội và cộng đồng","questions":[{"term":"ethics","prompt":"Good _____ guide honest work.","choices":["ethics","inbuilt","innovate","intelligent"]},{"term":"welfare","prompt":"The government works for the _____ of citizens.","choices":["welfare","declare","enforce","entitle"]},{"term":"migration","prompt":"Bird _____ begins when the weather turns cold.","choices":["migration","hardship","improvement","purchase"]},{"term":"immigrating","prompt":"They are _____ for better job opportunities.","choices":["immigrating","pamper","perceive","persevere"]},{"term":"immigration","prompt":"_____ changed the city quickly.","choices":["immigration","requirement","retention","role"]},{"term":"divers","prompt":"He hid the treasures in _____ places around town.","choices":["divers","hull","ingredient","insecticide"]},{"term":"diversion","prompt":"A loud noise caused a _____ in the crowd.","choices":["diversion","blemish","blur","bolster"]},{"term":"diversity","prompt":"Racial _____ is very low in Japan and very high in Toronto.","choices":["diversity","knock","knot","lace"]},{"term":"discriminating","prompt":"She is _____ between similar answers.","choices":["discriminating","decentralization","defence","defense"]},{"term":"discrimination","prompt":"We must fight against all forms of _____.","choices":["discrimination","pond","province","proximity"]},{"term":"discriminative","prompt":"She gave a _____ answer to each point.","choices":["discriminative","impose","independence","independently"]},{"term":"discriminator","prompt":"The _____ separated the two signals.","choices":["discriminator","causal","chronologically","cite"]},{"term":"discriminatory","prompt":"The test seemed _____ and unfair.","choices":["discriminatory","deposit","distribute","distribution"]},{"term":"gender","prompt":"The company does not care about your _____.","choices":["gender","manager","manpower","miller"]},{"term":"family","prompt":"My parents and my two brothers are my _____.","choices":["family","contest","contestant","dart"]},{"term":"child","prompt":"Success is often the _____ of hard work.","choices":["child","decline","deficit","demand"]},{"term":"childhood","prompt":"_____ can shape a person's habits.","choices":["childhood","headache","hydrate","hygienist"]},{"term":"childless","prompt":"They lived _____ but happily together.","choices":["childless","incapable","inherent","injured"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-topic-vocabulary-v1-society-lesson-4","title":"Bài 45","focus":"Cộng đồng, dân số, phúc lợi, quan hệ xã hội và thay đổi xã hội.","topicId":"society","topicTitle":"Xã hội và cộng đồng","questions":[{"term":"generation","prompt":"The _____ of new ideas took time.","choices":["generation","measurement","mechanism","meter"]},{"term":"youth","prompt":"He spent many happy days of _____ by the sea.","choices":["youth","drama","dress","exhibit"]},{"term":"youthful","prompt":"She looks very _____ for her seventy years.","choices":["youthful","arouse","aspiration","aspire"]},{"term":"elder","prompt":"He is my _____ brother from the city.","choices":["elder","pertinent","plausible","positive"]},{"term":"elderly","prompt":"The hospital had a number of _____ patients who had been there for many years.","choices":["elderly","tease","temperament","tempt"]},{"term":"citizen","prompt":"Every _____ has basic rights.","choices":["citizen","naturalism","naturalist","naturalization"]},{"term":"citizenship","prompt":"She values _____ and community service.","choices":["citizenship","chant","chord","church"]},{"term":"human","prompt":"Every _____ deserves to live a happy life.","choices":["human","accidental","airborne","naval"]},{"term":"humanisation","prompt":"The teacher praised the _____ of the lesson.","choices":["humanisation","mismatch","mixed","moderate"]},{"term":"humanise","prompt":"Good teachers _____ the classroom with care.","choices":["humanise","industrialize","enhance","enrich"]},{"term":"humanism","prompt":"She studied _____ in college.","choices":["humanism","revert","revitalization","revival"]},{"term":"humanist","prompt":"The _____ cared about art, books, and people.","choices":["humanist","seclusion","secularism","separation"]},{"term":"humanity","prompt":"We must work together for the sake of _____.","choices":["humanity","productivity","entrepreneur","management"]},{"term":"humanization","prompt":"The school program helped with _____.","choices":["humanization","tots","tough","tremendous"]},{"term":"humanize","prompt":"They tried to _____ the cold industrial process.","choices":["humanize","summed","sums","suppose"]},{"term":"humanly","prompt":"She did everything that was _____ possible today.","choices":["humanly","shadowy","shaggy","shake"]},{"term":"humanness","prompt":"The robot lacked the _____ of a real speaker.","choices":["humanness","margin","mark","marker"]},{"term":"relationship","prompt":"We need to improve the _____ between departments.","choices":["relationship","village","settlement","accommodation"]},{"term":"relationships","prompt":"Building strong interpersonal _____ is key to effective teamwork.","choices":["relationships","settlement","accommodation","aisle"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-topic-vocabulary-v1-society-reading-lesson-1","title":"Reading · Bài 1","focus":"Cộng đồng, dân số, phúc lợi, quan hệ xã hội và thay đổi xã hội.","topicId":"society","topicTitle":"Xã hội và cộng đồng","questions":[{"term":"accept","prompt":"Please _____ my sincere apology for the mistake.","choices":["accept","intrusion","jail","judgment"]},{"term":"acceptable","prompt":"This behavior is not _____ in our office.","choices":["acceptable","affirmative","alphabetic","concise"]},{"term":"acceptance","prompt":"The class showed _____ of the new rule.","choices":["acceptance","weaken","weep","weird"]},{"term":"accompany","prompt":"Please _____ me to the station.","choices":["accompany","elaborate","erect","erection"]},{"term":"acknowledge","prompt":"You must _____ your mistake before moving on.","choices":["acknowledge","thermal","agricultural","farm"]},{"term":"activist","prompt":"The _____ organized a local cleanup.","choices":["activist","noisy","notable","notably"]},{"term":"address","prompt":"Please _____ the letter to the correct person.","choices":["address","trainer","ship","shipment"]},{"term":"alien","prompt":"His strange behavior feels very _____ to me.","choices":["alien","undertake","undertaken","waitress"]},{"term":"alienate","prompt":"Her rude words _____ many classmates.","choices":["alienate","miner","multitasking","overtime"]},{"term":"alienation","prompt":"He felt a sense of _____ from his friends.","choices":["alienation","portion","preference","preparation"]},{"term":"archbishop","prompt":"The _____ visited the school today.","choices":["archbishop","clock","compatible","component"]},{"term":"assist","prompt":"Can you _____ me in moving these heavy boxes?","choices":["assist","blame","brave","bride"]},{"term":"assistance","prompt":"Can you give me some _____ with my homework?","choices":["assistance","pathology","perspiration","pharmacist"]},{"term":"assistant","prompt":"The _____ organized the books on the shelf.","choices":["assistant","sexuality","minor