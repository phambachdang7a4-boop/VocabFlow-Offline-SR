}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-31","title":"Bài 196","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"attend an orientation","prompt":"All new staff must _____ next Monday morning.","choices":["attend an orientation","amend tax returns","approve a tax exemption","approve tax exemption"],"componentWords":[{"term":"orientation","definition":"Sự định hướng."}]},{"term":"conduct a seminar","prompt":"The marketing head will _____ on leadership skills.","choices":["conduct a seminar","talk down to","dial a telephone extension","transfer to an extension"],"componentWords":[]},{"term":"coordinate staff training","prompt":"Our department will _____ for the new software upgrade.","choices":["coordinate staff training","run up against","monitor sales performance","adjust sales target"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-32","title":"Bài 197","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"develop leadership potential","prompt":"Special training modules help to _____ in our employees.","choices":["develop leadership potential","process payroll tax","process the payroll tax","review tax incentives"],"componentWords":[{"term":"leadership","definition":"Sự lãnh đạo."}]},{"term":"improve core competencies","prompt":"The workshop helps employees _____ for their jobs.","choices":["improve core competencies","boil down to","expand brand awareness","improve brand awareness"],"componentWords":[{"term":"core","definition":"Lõi, hạch (quả táo, quả lê... )."},{"term":"competencies","definition":"năng lực; năng lực chuyên môn"}]},{"term":"organise a seminar","prompt":"We will _____ on effective leadership skills.","choices":["organise a seminar","differentiate the product","deliver a product","discontinue a product line"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-33","title":"Bài 198","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"organise a workshop","prompt":"The training lead will _____ on time management.","choices":["organise a workshop","monitor staff attendance","screen an applicant","sign a partnership agreement"],"componentWords":[]},{"term":"monitor staff attendance","prompt":"The system helps us _____ more effectively.","choices":["monitor staff attendance","screen an applicant","organise a workshop","negotiate vendor terms"],"componentWords":[{"term":"attendance","definition":"Sự dự, sự có mặt."}]},{"term":"screen an applicant","prompt":"The team will _____ to assess their qualifications.","choices":["screen an applicant","organise a workshop","monitor staff attendance","arrange overseas shipping"],"componentWords":[{"term":"screen","definition":"Che chở, che giấu."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-34","title":"Bài 199","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"complete an assessment","prompt":"Candidates must _____ before being considered.","choices":["complete an assessment","draft a policy","performance appraisal","assess candidate qualifications"],"componentWords":[]},{"term":"performance appraisal","prompt":"Each employee will receive a formal _____ once a year.","choices":["performance appraisal","draft a policy","complete an assessment","sample the appetizers"],"componentWords":[{"term":"appraisal","definition":"Sự đánh giá; sự định giá."}]},{"term":"draft a policy","prompt":"The board will _____ regarding remote work arrangements.","choices":["draft a policy","performance appraisal","complete an assessment","reset the password"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-35","title":"Bài 200","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"offer a bonus","prompt":"The company will _____ for employees who meet their targets.","choices":["offer a bonus","brush up on","gang up on","track a delivery route"],"componentWords":[]},{"term":"brush up on","prompt":"I need to _____ my French before the business trip to Paris.","choices":["brush up on","offer a bonus","gang up on","restructure the organisation"],"componentWords":[{"term":"brush","definition":"Chải, quét."}]},{"term":"gang up on","prompt":"It is unacceptable for teammates to _____ a new employee.","choices":["gang up on","offer a bonus","brush up on","forecast annual budget"],"componentWords":[{"term":"gang","definition":"Họp thành bọn; kéo bè kéo bọn ((cũng) to gang up)."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-36","title":"Bài 201","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"accept a position","prompt":"After careful thought, I decided to _____ with your team.","choices":["accept a position","delay a payment","miss a payment","process a payment"],"componentWords":[]},{"term":"hire a professional","prompt":"The startup plans to _____ for the marketing department.","choices":["hire a professional","pre-book a table","prepare a reservation","arrange a seat"],"componentWords":[]},{"term":"offer a position","prompt":"We are pleased to _____ to the most suitable candidate.","choices":["offer a position","conduct a focus group","conduct exhaustive research","cultivate brand loyalty"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-37","title":"Bài 202","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"conduct an interview","prompt":"The HR department will _____ with every qualified applicant.","choices":["conduct an interview","accept a job offer","issue a pay cheque","miss the connection"],"componentWords":[]},{"term":"accept a job offer","prompt":"He decided to _____ from the leading marketing firm.","choices":["accept a job offer","issue a pay cheque","conduct an interview","arrange the furniture"],"componentWords":[]},{"term":"issue a pay cheque","prompt":"The finance department will _____ every two weeks.","choices":["issue a pay cheque","accept a job offer","conduct an interview","manage the operational cost"],"componentWords":[{"term":"cheque","definition":"Séc."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-38","title":"Bài 203","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"earn a promotion","prompt":"Hard work often helps employees _____ within the company.","choices":["earn a promotion","abide by the terms","enforce contract compliance","renegotiate vendor contracts"],"componentWords":[{"term":"earn","definition":"Kiếm được (tiền... ); giành được (phần thưởng, sự khen ngợi... )."}]},{"term":"manage an team","prompt":"He was hired to _____ during the project implementation.","choices":["manage an team","analyse consumer behaviour","boost sales performance","conduct a focus group"],"componentWords":[]},{"term":"set a performance goal","prompt":"Managers usually _____ during the annual review.","choices":["set a performance goal","report to a supervisor","restructure the organisation","analyse customer feedback"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-39","title":"Bài 204","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"advertise a post","prompt":"They will _____ in the local newspaper.","choices":["advertise a post","improve service quality","update service terms","upsell premium services"],"componentWords":[{"term":"advertise","definition":"Báo cho biết, báo cho ai biết trước."}]},{"term":"post a vacancy","prompt":"The company decided to _____ on the online job portal yesterday.","choices":["post a vacancy","post a staff notice","read the staff notice","talk down to"],"componentWords":[]},{"term":"shortlist a candidate","prompt":"The manager will _____ based on their relevant experience.","choices":["shortlist a candidate","assess asset condition","cut operating expenses","manage payroll expenses"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-40","title":"Bài 205","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"verify credentials","prompt":"It is standard practice to _____ before making an offer.","choices":["verify credentials","file a complaint","check a reference","check the baggage allowance"],"componentWords":[{"term":"credentials","definition":"Số nhiều của credential"}]},{"term":"check a reference","prompt":"It is standard practice to _____ before hiring.","choices":["check a reference","file a complaint","verify credentials","allocate budget resources"],"componentWords":[]},{"term":"file a complaint","prompt":"Employees can _____ with the human resources department.","choices":["file a complaint","check a reference","verify credentials","select a vendor"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-41","title":"Bài 206","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"letter of resignation","prompt":"He handed in his _____ to the HR department this morning.","choices":["letter of resignation","attend a workshop","brief the team","call a conference"],"componentWords":[]},{"term":"resign from a position","prompt":"She decided to _____ to pursue other interests.","choices":["resign from a position","conduct a phone screening","extend a job offer","manage the recruitment pipeline"],"componentWords":[{"term":"resign","definition":"Từ chức, xin thôi."}]},{"term":"submit a resignation","prompt":"You must _____ at least two weeks in advance.","choices":["submit a resignation","evaluate project outcomes","secure funding sources","accept a business proposal"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-42","title":"Bài 207","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"terminate a contract","prompt":"The firm has the right to _____ if standards are not met.","choices":["terminate a contract","increase a wage","negotiate a salary","summarize financial records"],"componentWords":[]},{"term":"increase a wage","prompt":"The union managed to _____ for all production workers.","choices":["increase a wage","terminate a contract","submit a formal proposal","address a client inquiry"],"componentWords":[]},{"term":"negotiate a salary","prompt":"Candidates are welcome to _____ during the second interview.","choices":["negotiate a salary","terminate a contract","schedule follow-up appointment","break out in"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-43","title":"Bài 208","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"offer a raise","prompt":"The director might _____ to retain talented staff.","choices":["offer a raise","on-the-job training","advertise a vacancy","assess the property value"],"componentWords":[{"term":"raise","definition":"Sự nâng lên; sự tăng lên."}]},{"term":"on-the-job training","prompt":"New recruits will receive _____ for the first month.","choices":["on-the-job training","advertise a vacancy","offer a raise","modify the work schedule"],"componentWords":[]},{"term":"advertise a vacancy","prompt":"The HR department will _____ in the local newspaper tomorrow.","choices":["advertise a vacancy","offer a raise","on-the-job training","submit an application"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-1","title":"Bài 209","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"amortise an asset","prompt":"We will _____ over its useful life of five years.","choices":["amortise an asset","request a price quote","request a quotation","calculate total freight"],"componentWords":[{"term":"amortise","definition":"Truyền lại, để lại (tài sản)."}]},{"term":"audit bookkeeping records","prompt":"The external team arrived to _____ for the last three years.","choices":["audit bookkeeping records","claim expense reimbursements","control operating expenses","manage the payroll expenses"],"componentWords":[{"term":"audit","definition":"Kiểm tra (sổ sách)."},{"term":"bookkeeping","definition":"Kế toán; nội dịch (vận hành tiên khởi)."}]},{"term":"audit internal records","prompt":"An external team will arrive next week to _____.","choices":["audit internal records","finalize a deal","finalize the deal","finalize the leasing deal"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-2","title":"Bài 210","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"audit inventory levels","prompt":"We conduct a monthly check to _____.","choices":["audit inventory levels","verify the date","lock the drawer","cancel the subscription"],"componentWords":[]},{"term":"audit the bookkeeping records","prompt":"We need to _____ to identify any errors.","choices":["audit the bookkeeping records","complete a renovation","conduct a renovation","improve the exterior"],"componentWords":[]},{"term":"audit the books","prompt":"Independent auditors will _____ early next week.","choices":["audit the books","adjust the payment schedule","amend payment schedules","approve a payment request"],"componentWords":[{"term":"books","definition":"Sách."}]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-3","title":"Bài 211","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"audit the internal records","prompt":"The team will _____ to detect any accounting errors.","choices":["audit the internal records","maintain the lift","maintain the lobby","obtain a repair estimate"],"componentWords":[]},{"term":"balance account statements","prompt":"The assistant spent the morning to _____ for the retail division.","choices":["balance account statements","clear the cache","empty the recycle bin","reset the password"],"componentWords":[{"term":"balance","definition":"Cái cân."},{"term":"statements","definition":"Sự bày tỏ, sự trình bày, sự phát biểu."}]},{"term":"depreciate fixed assets","prompt":"The company decided to _____ over a period of ten years.","choices":["depreciate fixed assets","restart the server","allocate a workstation","book a workspace"],"componentWords":[{"term":"depreciate","definition":"Làm sụt giá, làm giảm giá."},{"term":"fixed","definition":"Đóng, gắn, lắp, để, đặt."},{"term":"assets","definition":"tích sản"}]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-4","title":"Bài 212","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"external accounting firm","prompt":"We hired an _____ to review our books.","choices":["external accounting firm","check flight arrival times","check the gate number","collect a boarding pass"],"componentWords":[{"term":"external","definition":"Ở ngoài, bên ngoài (hiện tượng... )."},{"term":"accounting","definition":"Sự tính toán."},{"term":"firm","definition":"Hãng, công ty."}]},{"term":"maintain financial records","prompt":"All businesses are required to _____ for seven years.","choices":["maintain financial records","manage restaurant bookings","pre-book a table","prepare a reservation"],"componentWords":[]},{"term":"maintain financial transparency","prompt":"The audit is designed to _____ for our investors.","choices":["maintain financial transparency","check clinic availability","maintain clinic standards","claim dental benefits"],"componentWords":[{"term":"transparency","definition":"Tính trong suốt; độ trong suốt."}]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-5","title":"Bài 213","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"monitor the account balance","prompt":"Users can _____ via the mobile application.","choices":["monitor the account balance","on-the-job training","advertise a vacancy","add up to"],"componentWords":[]},{"term":"reconcile accounts","prompt":"The accountant needs to _____ at the end of every month.","choices":["reconcile accounts","check the references","conduct a phone screening","extend a job offer"],"componentWords":[{"term":"reconcile","definition":"Giải hòa, giảng hòa, làm cho hòa thuận, làm cho hài hòa."},{"term":"accounts","definition":"Sự tính toán."}]},{"term":"reconcile payment records","prompt":"The clerk will _____ with the central bank reports.","choices":["reconcile payment records","coordinate the delivery","delay the delivery schedule","delivery is scheduled"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-6","title":"Bài 214","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"standard accounting practice","prompt":"Our reports follow every _____ required by law.","choices":["standard accounting practice","issue a meal voucher","book a breakfast package","book a suite room"],"componentWords":[{"term":"practice","definition":"Thực hành, thực tiễn."}]},{"term":"update an audit trail","prompt":"It is essential to _____ to ensure full accountability.","choices":["update an audit trail","expand service offerings","guarantee a service","improve service delivery"],"componentWords":[{"term":"trail","definition":"Vạch, vệt dài."}]},{"term":"update the audit trail","prompt":"Internal auditors require us to _____ for every transaction.","choices":["update the audit trail","review an employment application","submit a reference","submit supporting documents"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-7","title":"Bài 215","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"verify accounting entries","prompt":"The accountant must _____ before closing the books for the month.","choices":["verify accounting entries","add up to","amortise the asset","calculate freight charges"],"componentWords":[{"term":"entries","definition":"Sự đi vào."}]},{"term":"add up to","prompt":"These small daily expenses _____ a significant amount by the end of the month.","choices":["add up to","amortise the asset","verify accounting entries","sort the business correspondence"],"componentWords":[]},{"term":"amortise the asset","prompt":"Companies _____ value over its useful life.","choices":["amortise the asset","verify accounting entries","add up to","request a replacement"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-8","title":"Bài 216","focus":"Ngân 