]},{"term":"dive into","prompt":"Let's _____ the details of the new project proposal.","choices":["dive into","die down","order bulk supplies","process the order"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-24","title":"Bài 24","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"divvy out","prompt":"The manager will _____ the project tasks among the team members.","choices":["divvy out","do with","draw back","provide a locker"],"componentWords":[{"term":"divvy","definition":"Tiền lãi cổ phần."}]},{"term":"do with","prompt":"We could really _____ some extra help on this project.","choices":["do with","divvy out","draw back","screen a tenant"],"componentWords":[]},{"term":"draw back","prompt":"The company had to _____ from its planned expansion due to market instability.","choices":["draw back","divvy out","do with","cruise through"],"componentWords":[{"term":"draw","definition":"Kéo."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-25","title":"Bài 25","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"draw out","prompt":"The long discussions only serve to _____ the decision-making process.","choices":["draw out","drum up","hear about","help out"],"componentWords":[]},{"term":"draw up","prompt":"The legal department needs to _____ a new contract for the vendor.","choices":["draw up","drum up","request a sample","track order status"],"componentWords":[]},{"term":"drum up","prompt":"We need to launch a marketing campaign to _____ more interest in our new product line.","choices":["drum up","draw out","draw up","level out"],"componentWords":[{"term":"drum","definition":"Đánh trống."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-26","title":"Bài 26","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"ease off","prompt":"The workload should _____ after the holiday season.","choices":["ease off","embark on","embark upon","print the ticket"],"componentWords":[{"term":"ease","definition":"Làm thanh thản, làm yên tâm."}]},{"term":"embark on","prompt":"The firm is about to _____ a major expansion project.","choices":["embark on","ease off","set the rent","utility bills"],"componentWords":[{"term":"embark","definition":"Cho lên tàu (lính, hàng... ) ((từ Mỹ, nghĩa Mỹ) (cũng) imbark)."}]},{"term":"embark upon","prompt":"The company is ready to _____ a new expansion strategy next month.","choices":["embark upon","ease off","fend off","ferret out"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-27","title":"Bài 27","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"end in","prompt":"The negotiation did not _____ a signed agreement.","choices":["end in","enter for","enter into","brush up"],"componentWords":[{"term":"end","definition":"kết thúc"}]},{"term":"enter for","prompt":"Our firm decided to _____ the international design competition.","choices":["enter for","end in","investment risk","investment strategy"],"componentWords":[{"term":"enter","definition":"Đi vào."}]},{"term":"enter into","prompt":"Both companies decided to _____ a long-term partnership agreement.","choices":["enter into","end in","sign away","splash out"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-28","title":"Bài 28","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"face off","prompt":"The two largest corporations are set to _____ in the upcoming tender for the city project.","choices":["face off","fall back","fall through","submit a notice"],"componentWords":[{"term":"face","definition":"Đương đầu, đối phó."}]},{"term":"fall back","prompt":"When sales dropped, we had to _____ on our emergency reserves.","choices":["fall back","face off","reach out","reason out"],"componentWords":[{"term":"fall","definition":"Rơi, rơi xuống, rơi vào ((nghĩa đen) & (nghĩa bóng))."}]},{"term":"fall through","prompt":"The deal might _____ if we cannot agree on the price.","choices":["fall through","face off","reject the order","return the items"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-29","title":"Bài 29","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"fall under","prompt":"This department does not _____ the direct authority of the CEO.","choices":["fall under","fend off","feed off","pull apart"],"componentWords":[]},{"term":"feed off","prompt":"The marketing team members often _____ each other to generate new ideas.","choices":["feed off","fend off","fall under","hang on"],"componentWords":[{"term":"feed","definition":"Cho ăn (người, súc vật)."}]},{"term":"fend off","prompt":"The company used legal action to _____ a hostile takeover attempt.","choices":["fend off","feed off","fall under","fit in"],"componentWords":[{"term":"fend","definition":"Đánh lui, đẩy lui, đẩy xa."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-30","title":"Bài 30","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"ferret out","prompt":"We need to _____ the reason behind the sudden drop in sales.","choices":["ferret out","fiddle about","figure on","book a flight"],"componentWords":[{"term":"ferret","definition":"Đi săn bằng chồn sương."}]},{"term":"fiddle about","prompt":"We cannot afford to _____ with minor details when the deadline is so close.","choices":["fiddle about","ferret out","figure on","clear customs"],"componentWords":[{"term":"fiddle","definition":"Kéo viôlông (bài gì)."}]},{"term":"figure on","prompt":"We _____ completing the audit by the end of this month.","choices":["figure on","fiddle about","ferret out","fire away"],"componentWords":[{"term":"figure","definition":"Hình dáng."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-31","title":"Bài 31","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"finish off","prompt":"Let's _____ this project before the weekend starts.","choices":["finish off","fire away","fire up","hack into"],"componentWords":[{"term":"finish","definition":"Hoàn thành, kết thúc, làm xong."}]},{"term":"fire away","prompt":"If you have any questions about the new contract, _____.","choices":["fire away","finish off","answer for","argue out"],"componentWords":[{"term":"fire","definition":"Đốt cháy, đốt (lò... )."}]},{"term":"fire up","prompt":"We need to _____ the team for the final phase of the campaign.","choices":["fire up","finish off","confirm delivery dates","delay the delivery"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-32","title":"Bài 32","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"firm up","prompt":"We need to _____ the details of the itinerary before booking the flights.","choices":["firm up","fit in","fizzle out","shipment is delayed"],"componentWords":[{"term":"firm","definition":"Là