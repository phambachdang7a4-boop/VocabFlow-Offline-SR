oeic-basic-collocations-v1-general-business-lesson-54","title":"Bài 54","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"nail down","prompt":"We need to _____ the meeting agenda before inviting all the department heads.","choices":["nail down","nut out","make an offer","set a price"],"componentWords":[{"term":"nail","definition":"Đóng đinh; ghìm chặt."}]},{"term":"make an offer","prompt":"They are ready to _____ for the acquisition of the company.","choices":["make an offer","nail down","nut out","warm up"],"componentWords":[{"term":"offer","definition":"Đề nghị."}]},{"term":"nut out","prompt":"We need to _____ a strategy for entering the Asian market.","choices":["nut out","nail down","make an offer","sift through"],"componentWords":[{"term":"nut","definition":"To go nutting đi lấy quả hạch."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-55","title":"Bài 55","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"occur to","prompt":"It did not _____ me that the project would require more funding.","choices":["occur to","control expenses","opt for","press release"],"componentWords":[{"term":"occur","definition":"Xảy ra, xảy đến."}]},{"term":"control expenses","prompt":"The manager implemented new rules to _____ for the quarter.","choices":["control expenses","occur to","opt for","check out early"],"componentWords":[{"term":"control","definition":"Điều khiển, chỉ huy, làm chủ."},{"term":"expenses","definition":"Sự tiêu; phí tổn."}]},{"term":"opt for","prompt":"Many companies _____ cloud-based solutions to reduce IT costs.","choices":["opt for","occur to","control expenses","stick out"],"componentWords":[{"term":"opt","definition":"Chọn, chọn lựa."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-56","title":"Bài 56","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"opt in","prompt":"Customers can _____ to receive our weekly newsletter by email.","choices":["opt in","update personal details","local pharmacy","check pharmacy stocks"],"componentWords":[]},{"term":"opt into","prompt":"Employees can _____ the company's new health insurance plan starting next month.","choices":["opt into","annual banquet","exhibition booth","draft the proposal"],"componentWords":[]},{"term":"opt out","prompt":"Employees can _____ of the company health plan during the enrollment period.","choices":["opt out","figure on","finish off","fire away"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-57","title":"Bài 57","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"pair up","prompt":"Please _____ with a partner for the training workshop.","choices":["pair up","pan out","pass on","sign on with"],"componentWords":[{"term":"pair","definition":"Ghép đôi, ghép cặp."}]},{"term":"pan out","prompt":"We are waiting to see how the new marketing strategy will _____.","choices":["pan out","pair up","pass on","provide urgent care"],"componentWords":[{"term":"pan","definition":"Đãi (vàng ở trong cát, bằng cái giần)."}]},{"term":"pass on","prompt":"Please _____ the meeting minutes to the department head.","choices":["pass on","pair up","pan out","finish off"],"componentWords":[{"term":"pass","definition":"Đi, đi lên; đi qua, đi ngang qua."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-58","title":"Bài 58","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"pass up","prompt":"Don't _____ this career opportunity to work in our international office.","choices":["pass up","peter out","perk up","toy with"],"componentWords":[]},{"term":"perk up","prompt":"The sales figures started to _____ after the new marketing campaign.","choices":["perk up","pass up","peter out","verify account details"],"componentWords":[{"term":"perk","definition":"Ngẩng đầu lên, vểnh lên, vểnh mặt lên (tự đắc, hỗn xược... ) ((cũng) to-up)."}]},{"term":"peter out","prompt":"Interest in the project seemed to _____ after the funding was cut.","choices":["peter out","perk up","pass up","payment method"],"componentWords":[{"term":"peter","definition":"Đã khai thác hết (vỉa than, quặng)."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-59","title":"Bài 59","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"phase out","prompt":"The company plans to _____ the old software system by the end of the year.","choices":["phase out","pick up on","pitch for","box up"],"componentWords":[{"term":"phase","definition":"Thực hiện (chương trình... ) từng giai đoạn."}]},{"term":"pick up on","prompt":"I would like to _____ the point you made earlier about budget constraints.","choices":["pick up on","phase out","pitch for","track the order"],"componentWords":[{"term":"pick","definition":"Cuốc (đất... ); đào, khoét (lỗ... )."}]},{"term":"pitch for","prompt":"Our design agency is going to _____ the new advertising account next week.","choices":["pitch for","pick up on","phase out","ring off"],"componentWords":[{"term":"pitch","definition":"Quét hắc ín, gắn bằng hắc ín."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-60","title":"Bài 60","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"play along","prompt":"Even if you disagree, you should _____ during the client meeting.","choices":["play along","press for","beef up","belong to"],"componentWords":[{"term":"play","definition":"Chơi, nô đùa, đùa giỡn."}]},{"term":"play down","prompt":"The manager tried to _____ the potential risks of the new investment project.","choices":["play down","press for","validate a passport","miss a flight"],"componentWords":[]},{"term":"press for","prompt":"The stakeholders continue to _____ better performance results from the management team.","choices":["press for","play down","play along","go by"],"componentWords":[{"term":"press","definition":"Ép, nép, bóp, ấn."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-61","title":"Bài 61","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"press on","prompt":"Despite the delay, we must _____ with the project schedule.","choices":["press on","review product line","pull apart","scroll down"],"componentWords":[]},{"term":"review product line","prompt":"We plan to _____ performance at the end of the year.","choices":["review product line","pull apart","press on","strike upon"],"componentWords":[{"term":"product","definition":"Sản vật, sản phẩm, vật phẩm."},{"term":"line","definition":"Dây, dây thép."}]},{"term":"pull apart","prompt":"The board began to _____ the merger proposal to identify potential risks.","choices":["pull apart","press on","review product line","issue digital tickets"],"componentWords":[{"term":"pull","definition":"Lôi, kéo, giật."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-62","title":"Bài 62","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"pull back","prompt":"The company had to _____ its expansion plans due to a lack of capital.","choices":["pull back","sign for","stock up","verify supplier invoices"],"componentWords":[]},{"term":"pull off","prompt":"Despite the tight deadline, the team managed to _____ the project successfully.","choices":["pull off","clear out","clear up","close down"],"componentWords":[]},{"term":"pull together","prompt":"We need to _____ to meet the project deadline by Friday.","choices":["pull together","occupy a seat","overbook the flight","fuel up"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-63","title":"Bài 63","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"put across","prompt":"He was able to _____ his ideas clearly during the board meeting.","choices":["put across","ramp up","gear up","get together"],"componentWords":[{"term":"put","definition":"Để, đặt, bỏ, đút, cho vào (ở đâu, vào cái gì... )."}]},{"term":"put up","prompt":"The team _____ a great performance during the business presentation.","choices":["put up","ramp up","sign on with","single out"],"componentWords":[]},{"term":"ramp up","prompt":"The company needs to _____ production to meet the increasing market demand.","choices":["ramp up","put across","put up","select the venue"],"componentWords":[{"term":"ramp","definition":"Dốc thoai thoải."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-64","title":"Bài 64","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"ratchet up","prompt":"The marketing team aims to _____ the brand's visibility in the market.","choices":["ratchet up","reach out","reason out","go off"],"componentWords":[{"term":"ratchet","definition":"Lắp bánh cóc vào."}]},{"term":"reach out","prompt":"We should _____ to the potential client to discuss the contract.","choices":["reach out","reason out","ratchet up","order bulk supplies"],"componentWords":[{"term":"reach","definition":"Chìa ra, đưa (tay) ra."}]},{"term":"reason out","prompt":"The team needs to _____ a solution to the supply chain delay.","choices":["reason out","reach out","ratchet up","figure on"],"componentWords":[{"term":"reason","definition":"Sự suy luận, suy lý, lý luận."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-65","title":"Bài 65","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"reel in","prompt":"The marketing team created a new campaign to _____ more customers.","choices":["reel in","result in","rely on","recover from illness"],"componentWords":[{"term":"reel","definition":"Quấn (chỉ, dây, phím) vào ống, quấn vào cuộn ((cũng) to reel in, to reel up)."}]},{"term":"rely on","prompt":"We _____ our suppliers to deliver materials on time.","choices":["rely on","result in","reel in","host a seminar"],"componentWords":[{"term":"rely","definition":"dựa vào; tin cậy"}]},{"term":"result in","prompt":"A failure to follow safety protocols will _____ a formal warning.","choices":["result in","rely on","reel in","boarding pass"],"componentWords":[{"term":"result","definition":"Do bởi, do mà ra."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-66","title":"Bài 66","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"ride on","prompt":"Our reputation depends on how this project turns out; our success will _____ this final presentation.","choices":["ride on","roll in","make out","make up for"],"componentWords":[{"term":"ride","definition":"Đi ngựa, cưỡi ngựa."}]},{"term":"ride out","prompt":"We have enough cash reserves to _____ this economic downturn.","choices":["ride out","roll in","hire the caterer","host a ceremony"],"componentWords":[]},{"term":"roll in","prompt":"Applications for the new positions started to _____ this morning.","choices":["roll in","ride out","ride on","submit personal details"],"componentWords":[{"term":"roll","definition":"Lăn, vần."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-67","title":"Bài 67","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"roll out","prompt":"The company plans to _____ its new software update next month.","choices":["roll out","root for","root out","schedule the delivery"],"componentWords":[]},{"term":"root for","prompt":"Colleagues always _____ their teammates to achieve great results.","choices":["root for","roll out","secure the premises","shared facilities"],"componentWords":[{"term":"root","definition":"Làm bén rễ, làm bắt rễ (cây... )."}]},{"term":"root out","prompt":"Management is trying to _____ inefficiencies in the supply chain.","choices":["root out","roll out","order a meal","prepare a buffet"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-68","title":"Bài 68","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"rope in","prompt":"We need to _____ some experts to help with this project.","choices":["rope in","run across","run down","go ahead with"],"componentWords":[{"term":"rope","definition":"Trói (cột, buộc) bằng dây thừng."}]},{"term":"run across","prompt":"I happened to _____ this useful document while searching the archive.","choices":["run across","rope in","level off","level out"],"componentWords":[{"term":"run","definition":"Chạy."}]},{"term":"run down","prompt":"We are trying to _____ the causes of the current production error.","choices":["run down","rope in","register for training","track learning outcomes"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-69","title":"Bài 69","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"run for","prompt":"She decided to _____ the position of board director in the upcoming election.","choices":["run for","rush into","sail through","order from stock"],"componentWords":[]},{"term":"rush into","prompt":"We should not _____ signing the contract before reviewing all the terms.","choices":["rush into","sail through","run for","pay a rent"],"componentWords":[{"term":"rush","definition":"Xông lên, lao vào."}]},{"term":"sail through","prompt":"With enough preparation, you will _____ the final examination.","choices":["sail through","rush into","run for","scrape through"],"componentWords":[{"term":"sail","definition":"Chạy bằng buồm, chạy bằng máy (tàu)."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-70","title":"Bài 70","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"scale up","prompt":"The company plans to _____ its production capacity to meet global demand.","choices":["scale up","scout around","see about","hang together"],"componentWords":[{"term":"scale","definition":"Đánh vảy, lột vảy."}]},{"term":"scout around","prompt":"We need to _____ for better suppliers to reduce our production costs.","choices":["scout around","see about","scale up","rein in"],"componentWords":[{"term":"scout","definition":"Theo dõi, theo sát, do thám."}]},{"term":"see about","prompt":"I will _____ arranging a meeting for tomorrow morning.","choices":["see about","scout around","scale up","place an order"],"componentWords":[{"term":"see","definition":"Thấy, trông thấy, nhìn thấy; xem, quan sát, xem xét."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-71","title":"Bài 71","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"see through","prompt":"We are committed to _____ this contract until the end of the year.","choices":["see through","send out","sell out","receive a payment"],"componentWords":[]},{"term":"sell out","prompt":"Tickets for the conference are expected to _____ quickly.","choices":["sell out","send out","see through","set a deadline"],"componentWords":[{"term":"sell","definition":"Bán, đổi (hàng hoá) để lấy tiền; chuyển giao, trao tay, trao đổi, chuyển, trao, giao cái gì đó để lấy tiền."}]},{"term":"send out","prompt":"Please _____ the meeting agenda to all participants by this afternoon.","choices":["send out","see through","sell out","settle up"],"componentWords":[{"term":"send","definition":"Gửi, chuyển (đi) cái gì đó; thu xếp, xếp đặt, sắp đặt, sắp xếp cho cái gì đó đến, tới hoặc được mang, được đem, được dẫn, được đưa, được trao, được giao đến, tới một nơi nào khác, nhất là bằng đường bưu điện"}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-72","title":"Bài 72","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"set about","prompt":"We need to _____ preparing the annual report as soon as possible.","choices":["set about","bear out","beat out","beef up"],"componentWords":[{"term":"set","definition":"Để, đặt."}]},{"term":"set apart","prompt":"Our innovative technology helps to _____ our services from the competitors.","choices":["set apart","butt in","call on","call out"],"componentWords":[]},{"term":"set back","prompt":"Technical issues will _____ the project completion by a week.","choices":["set back","provide identification papers","cancel the booking","cancel the trip"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-73","title":"Bài 73","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"set forth","prompt":"The guidelines _____ the expectations for all employees.","choices":["set forth","confirm a guest","offer valet parking","provide a locker"],"componentWords":[{"term":"forth","definition":"Về phía trước, ra phía trước, lộ ra."}]},{"term":"set out","prompt":"The CEO _____ a clear vision for the company's growth in the coming years.","choices":["set out","request a bid","sign a bid","win a bid"],"componentWords":[]},{"term":"set to","prompt":"The team is _____ start the audit process early tomorrow morning.","choices":["set to","wear down","weed out","skilled workforce"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-74","title":"Bài 74","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"shake up","prompt":"The new CEO plans a major _____ of the company structure.","choices":["shake up","shape up","shoot for","report net profit"],"componentWords":[{"term":"shake","definition":"Rung, lắc, làm rung, lúc lắc, lung lay, lay động; giũ."}]},{"term":"shape up","prompt":"The new team member is starting to _____ after two months of training.","choices":["shape up","shoot for","shake up","rent out"],"componentWords":[{"term":"shape","definition":"Nặn, đẽo, gọt, tạo thành hình."}]},{"term":"shoot for","prompt":"Our sales team is going to _____ a ten percent increase in revenue this year.","choices":["shoot for","shape up","shake up","sail through"],"componentWords":[{"term":"shoot","definition":"Vụt qua, vọt tới, chạy qua."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-75","title":"Bài 75","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"side with","prompt":"The director decided to _____ the marketing department in the budget dispute.","choices":["side with","sign with","sign off on","fit in"],"componentWords":[{"term":"side","definition":"Đứng về phe, đứng về phía; ủng hộ."}]},{"term":"sign off on","prompt":"The director needs to _____ the project proposal before we proceed.","choices":["sign off on","side with","go in with","go on to"],"componentWords":[{"term":"sign","definition":"Đánh dấu; (tôn giáo) làm dấu."}]},{"term":"sign with","prompt":"Our agency decided to _____ a new logistics provider for better shipping rates.","choices":["sign with","side with","hold out for","show enthusiasm"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-76","title":"Bài 76","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"sink in","prompt":"The news of the merger took a few days to _____ among the staff.","choices":["sink in","sit in","sit on","evaluate the event"],"componentWords":[{"term":"sink","definition":"Chìm."}]},{"term":"sit in","prompt":"I have been invited to _____ on the interview panel for the new candidate.","choices":["sit in","sink in","restock supplies","verify stock levels"],"componentWords":[{"term":"sit","definition":"Ngồi."}]},{"term":"sit on","prompt":"The committee decided to _____ the proposal until more financial data is available.","choices":["sit on","sink in","overbook the flight","fuel up"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-77","title":"Bài 77","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"sit out","prompt":"Due to budget cuts, the department had to _____ the marketing campaign this quarter.","choices":["sit out","size up","sleep on","work off"],"componentWords":[]},{"term":"size up","prompt":"Before making an investment, it is important to _____ the market competition.","choices":["size up","sleep on","sit out","get together"],"componentWords":[{"term":"size","definition":"Sắp xếp theo cỡ to nhỏ."}]},{"term":"sleep on","prompt":"I will need to _____ your offer before giving you an answer.","choices":["sleep on","size up","sit out","move up"],"componentWords":[{"term":"sleep","definition":"Ngủ."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-78","title":"Bài 78","focus":"Hợp đồng, đàm phán, chiến lược, khách hàng, tiếp thị và hoạt động doanh nghiệp.","topicId":"general-business","topicTitle":"Kinh doanh chung · General Business","questions":[{"term":"soldier on","prompt":"Despite the budget cuts, the team decided to _____ to finish the project on time.","choices":["soldier on","sound out","speak out","receive the shipment"],"componentWords":[{"term":"soldier","definition":"Đi lính."}]},{"term":"sound out","prompt":"I need to _____ the client to see if they are interested in our new proposal.","choices":["sound out","speak out","soldier on","order from stock"],"componentWords":[{"term":"sound","definition":"Kêu, vang tiếng, kêu vang."}]},{"term":"speak out","prompt":"Employees are encouraged to _____ regarding workplace safety concerns.","choices":["speak out","sound out","soldier on","request medical records"],"componentWords":[{"term":"speak","definition":"Nói."}]}]},{"id":"toeic-basic-collocations-v1-general-business-lesson-79","title"