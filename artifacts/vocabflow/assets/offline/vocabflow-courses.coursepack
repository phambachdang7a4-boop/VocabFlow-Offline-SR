ices.","pos":"Phrase","subPos":null}]},{"term":"improve inventory turnover","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-general-business-lesson-10"]},"senses":[{"definition":"Cải thiện vòng quay hàng tồn kho","example":"New tracking software helped improve inventory turnover for retailers.","pos":"Phrase","subPos":null}]},{"term":"improve product quality","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-general-business-lesson-10"]},"senses":[{"definition":"Cải thiện chất lượng sản phẩm","example":"Feedback from tests helped us improve product quality significantly.","pos":"Phrase","subPos":null}]},{"term":"improve product reliability","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-general-business-lesson-4"]},"senses":[{"definition":"Cải thiện độ tin cậy của sản phẩm","example":"Engineers are working to improve product reliability before the release.","pos":"Phrase","subPos":null}]},{"term":"improve productivity","courseIds":["toeic-basic-collocations-v1"],"lessonIdsByCourse":{"toeic-basic-collocations-v1":["toeic-basic-collocations-v1-personnel-lesson-1"]},"senses":[{"definition":"Cải thiện năng suất","example":"The training programme is designed to improve productivity across departments.","pos":"Phrase","subPos":null}]},{"term":"improve service delivery","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-general-business-lesson-11"]},"senses":[{"definition":"Cải thiện việc cung cấp dịch vụ","example":"Feedback from customers is used to improve service delivery.","pos":"Phrase","subPos":null}]},{"term":"improve service quality","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-general-business-lesson-11"]},"senses":[{"definition":"cải thiện chất lượng dịch vụ","example":"Management is focusing on efforts to improve service quality this year.","pos":"Phrase","subPos":null}]},{"term":"improve supply chain","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-general-business-lesson-11"]},"senses":[{"definition":"Cải thiện chuỗi cung ứng","example":"Adopting new technology will improve supply chain speed.","pos":"Phrase","subPos":null}]},{"term":"improve the exterior","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-real-estate-lesson-4"]},"senses":[{"definition":"Cải thiện bên ngoài","example":"The landscaping team will improve the exterior of the office block.","pos":"Phrase","subPos":null}]},{"term":"improve workplace safety","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-health-medical-lesson-4"]},"senses":[{"definition":"cải thiện an toàn nơi làm việc","example":"The committee aims to improve workplace safety for everyone.","pos":"Phrase","subPos":null}]},{"term":"improvement","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-development-reading-lesson-1"]}},{"term":"improvise","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-reading-lesson-5"]}},{"term":"impulse","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-psychology-reading-lesson-8"]}},{"term":"In a bind","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"In a jam","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"In a nutshell","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"In a pinch","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"In a rut","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"in a small drawer","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["sentence-structure-patterns-v1-in-on-at"]},"senses":[{"definition":"Dùng in khi vật nằm bên trong một không gian có ranh giới, như phòng, hộp hoặc ngăn kéo. Với địa điểm rộng như thành phố và quốc gia, in cũng là lựa chọn phổ biến.","example":"The spare key is kept in a small drawer in the kitchen.","pos":null,"subPos":null}]},{"term":"in advance","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["sentence-structure-patterns-v1-preposition-patterns"]},"senses":[{"definition":"Cụm trạng ngữ nghĩa là “trước” hoặc “trước thời điểm cần thiết”, thường dùng khi chuẩn bị, đặt chỗ hoặc thông báo sớm.","example":"To secure a seat, please register in advance rather than waiting until the day of the event.","pos":null,"subPos":null}]},{"term":"in case","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-conditions"]},"senses":[{"definition":"Phòng khi; nói về việc chuẩn bị hoặc biện pháp để ứng phó nếu một khả năng xảy ra, không đơn thuần nêu điều kiện như if. Ghi chú: Nêu việc chuẩn bị trước để phòng một khả năng xảy ra; khác if, vốn đặt điều kiện để hành động hoặc kết quả xảy ra.","example":"Save the emergency number in your phone in case you need help.","pos":"conj","subPos":"subordinating"}]},{"term":"In charge of","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"in due course","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"In full swing","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-039"]}},{"term":"In high gear","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"In hot water","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"In my book","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"In my element","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"in order that","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-meaning"]},"senses":[{"definition":"Để, nhằm để; giới thiệu mục đích, thường dùng trong văn phong trang trọng và hay đi với can, could, may hoặc might. Ghi chú: Gần nghĩa với so that khi nêu mục đích; in order that thường trang trọng và nhấn mạnh mục đích hơn, hay đi với can/could/may/might. So that thông dụng hơn và còn có thể nêu kết quả.","example":"The guide repeated each step slowly in order that every visitor could follow.","pos":"conj","subPos":"subordinating"}]},{"term":"in September","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["sentence-structure-patterns-v1-in-on-at"]},"senses":[{"definition":"Dùng in với tháng, năm, mùa và những khoảng thời gian dài hơn một ngày: in September, in 2026, in winter. Hãy nghĩ đến một khoảng thời gian bao quanh sự việc.","example":"The new term begins in September.","pos":null,"subPos":null}]},{"term":"In seventh heaven","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-040"]}},{"term":"in Singapore","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["sentence-structure-patterns-v1-in-on-at"]},"senses":[{"definition":"Dùng in với thành phố, quốc gia và khu vực rộng để nói một việc xảy ra trong p