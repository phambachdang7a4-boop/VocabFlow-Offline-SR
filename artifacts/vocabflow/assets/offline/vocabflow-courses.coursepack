l a flight"],"componentWords":[{"term":"print","definition":"Chữ in."},{"term":"label","definition":"Một miếng vật liệu nhỏ để dính vào vật và cho biết thông tin về vật đó."}]},{"term":"print a report","prompt":"He will _____ for the upcoming quarterly review.","choices":["print a report","print the label","set a reminder","schedule a cleaning"],"componentWords":[{"term":"report","definition":"Bản báo cáo; biên bản."}]},{"term":"set a reminder","prompt":"I will _____ to call the client tomorrow.","choices":["set a reminder","print the label","print a report","pay the utility"],"componentWords":[{"term":"reminder","definition":"Cái nhắc nhở, cái làm nhớ lại (một điều gì)."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-3","title":"Bài 101","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"update the schedule","prompt":"Please _____ to reflect the changes.","choices":["update the schedule","act up","back up","stand for"],"componentWords":[{"term":"update","definition":"Làm cho cập nhật, hiện đại hoá."},{"term":"schedule","definition":"Bản danh mục, bảng liệt kê; bản phụ lục."}]},{"term":"act up","prompt":"The office printer began to _____ right before the deadline.","choices":["act up","update the schedule","back up","live with"],"componentWords":[]},{"term":"back up","prompt":"It is important to _____ your files every day.","choices":["back up","update the schedule","act up","sign off on"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-4","title":"Bài 102","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"barge in","prompt":"Please knock before you _____ on a private meeting.","choices":["barge in","be in","beaver away","make over"],"componentWords":[{"term":"barge","definition":"Barge in xâm nhập, đột nhập."}]},{"term":"be in","prompt":"The manager will _____ by 9 AM to review the report.","choices":["be in","beaver away","barge in","support charity events"],"componentWords":[]},{"term":"beaver away","prompt":"The marketing team has been _____ at the new project for the past week.","choices":["beaver away","barge in","be in","pull back"],"componentWords":[{"term":"beaver","definition":"Con hải ly."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-5","title":"Bài 103","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"blank out","prompt":"I started to _____ during the long board meeting because I was so tired.","choices":["blank out","bone up","boot up","break in"],"componentWords":[{"term":"blank","definition":"Tẩy trống."}]},{"term":"bone up","prompt":"I need to _____ on the latest software updates before the meeting starts.","choices":["bone up","blank out","boot up","request a repair"],"componentWords":[{"term":"bone","definition":"Gỡ xương (ở cá, ở thịt)."}]},{"term":"boot up","prompt":"It takes several minutes for the secure workstation to _____ in the morning.","choices":["boot up","bone up","blank out","lie with"],"componentWords":[{"term":"boot","definition":"Đi giày ống cho."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-6","title":"Bài 104","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"box up","prompt":"We need to _____ all the office files before we move to the new building.","choices":["box up","brush off","breeze through","head for"],"componentWords":[{"term":"box","definition":"Bỏ vào hộp."}]},{"term":"breeze through","prompt":"With her experience, she should _____ the training program.","choices":["breeze through","brush off","box up","keep up with"],"componentWords":[{"term":"breeze","definition":"Thổi nhẹ."}]},{"term":"brush off","prompt":"He tended to _____ the complaints from the customers, which was a big mistake.","choices":["brush off","box up","breeze through","retrieve luggage"],"componentWords":[{"term":"brush","definition":"Chải, quét."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-7","title":"Bài 105","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"butt in","prompt":"Please do not _____ while the director is speaking.","choices":["butt in","call on","call out","step in"],"componentWords":[{"term":"butt","definition":"Húc vào; húc đầu vào."}]},{"term":"call on","prompt":"The CEO will _____ the department heads to present their findings during the quarterly meeting.","choices":["call on","butt in","building regulations","building structure"],"componentWords":[]},{"term":"call out","prompt":"Managers should _____ bad behavior when they see it in the office.","choices":["call out","butt in","yield to","open a window"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-8","title":"Bài 106","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"chase up","prompt":"I need to _____ the supplier regarding the overdue payment.","choices":["chase up","check off","check over","offer a beverage"],"componentWords":[{"term":"chase","definition":"Săn, săn đuổi."}]},{"term":"check off","prompt":"Please _____ each task on the agenda as we complete them during the meeting.","choices":["check off","chase up","feed off","fend off"],"componentWords":[{"term":"check","definition":"Cản, cản trở; chặn, ngăn chặn; kìm, kiềm chế, nén, dằn (lòng)."}]},{"term":"check over","prompt":"Could you _____ this contract for any spelling errors before we send it?","choices":["check over","chase up","book a taxi","book a train"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-9","title":"Bài 107","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"chuck out","prompt":"It is time to _____ those old, non-functional office files.","choices":["chuck out","clean off","clear away","stock up"],"componentWords":[{"term":"chuck","definition":"Cục cục (gà mái)."}]},{"term":"clean off","prompt":"Please _____ the whiteboard after the meeting.","choices":["clean off","clear away","chuck out","rush out"],"componentWords":[{"term":"clean","definition":"Lau chùi, rửa sạch, cạo sạch, đánh sạch, tẩy sạch, vét sạch, quét sạch."}]},{"term":"clear away","prompt":"Please _____ all documents from the desk before the cleaners arrive.","choices":["clear away","chuck out","clean off","verify an invoice"],"componentWords":[{"term":"clear","definition":"Làm trong sạch, lọc trong; làm đăng quang, làm sáng sủa, làm sáng tỏ."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-10","title":"Bài 108","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"clear out","prompt":"We need to _____ the old files from the storage room.","choices":["clear out","close down","shut down","shut off"],"componentWords":[]},{"term":"clear up","prompt":"We need to _____ the confusion regarding the meeting schedule.","choices":["clear up","close down","report a profit","report net profit"],"componentWords":[]},{"term":"close down","prompt":"The factory had to _____ due to a lack of raw materials.","choices":["close down","clear out","clear up","show the appreciation"],"componentWords":[{"term":"close","definition":"Đóng, khép."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-11","title":"Bài 109","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"close up","prompt":"We usually _____ the office at 6 PM sharp.","choices":["close up","come off","come on","go through with"],"componentWords":[]},{"term":"come off","prompt":"The label started to _____ the shipping box during transit.","choices":["come off","close up","baggage claim","belt up"],"componentWords":[]},{"term":"come on","prompt":"The automatic sprinklers will _____ if the fire alarm is triggered.","choices":["come on","close up","scale back","scale down"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-12","title":"Bài 110","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"come through","prompt":"The official confirmation for the contract should _____ by Friday.","choices":["come through","cope with","cover for","travel expenses"],"componentWords":[]},{"term":"cope with","prompt":"She is well-trained to _____ high-pressure deadlines.","choices":["cope with","cover for","come through","departure time"],"componentWords":[{"term":"cope","definition":"Khoác áo lễ (cho giáo sĩ)."}]},{"term":"cover for","prompt":"Could you _____ me during my lunch break while I attend a quick meeting?","choices":["cover for","cope with","come through","skilled workforce"],"componentWords":[{"term":"cover","definition":"Che, phủ, bao phủ, bao trùm, bao bọc."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-13","title":"Bài 111","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"cover up","prompt":"The manager tried to _____ the accounting error.","choices":["cover up","crank up","cross off","lose out"],"componentWords":[]},{"term":"crank up","prompt":"Please _____ the air conditioning; it is getting very hot in the office.","choices":["crank up","cross off","cover up","price in"],"componentWords":[]},{"term":"cross off","prompt":"I can finally _____ the last task from my to-do list.","choices":["cross off","cover up","crank up","office relocation"],"componentWords":[{"term":"cross","definition":"Qua, đi qua, vượt, đi ngang qua; đưa (ai cái gì... ) đi ngang qua."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-14","title":"Bài 112","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"cross out","prompt":"Please _____ the incorrect figures and write the right ones.","choices":["cross out","dash off","cruise through","review the proposal"],"componentWords":[]},{"term":"cruise through","prompt":"If you prepare well, you can _____ the assessment.","choices":["cruise through","dash off","cross out","syphon off"],"componentWords":[{"term":"cruise","definition":"Đi chơi biển (bằng tàu thuỷ)."}]},{"term":"dash off","prompt":"I need to _____ a quick email to the client regarding the meeting time.","choices":["dash off","cross out","cruise through","watch out"],"componentWords":[{"term":"dash","definition":"Đập vỡ, làm tan nát."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-15","title":"Bài 113","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"dig out","prompt":"I need to _____ the old invoices from the archive for the audit.","choices":["dig out","review the proposal","sign a form","order office supplies"],"componentWords":[{"term":"dig","definition":"Đào bới, xới, cuốc (đất... )."}]},{"term":"review the proposal","prompt":"The committee will _____ at the next meeting.","choices":["review the proposal","dig out","step in","stick around"],"componentWords":[]},{"term":"sign a form","prompt":"Please _____ at the reception desk upon arrival.","choices":["sign a form","dig out","book a suite","clean the room"],"componentWords":[{"term":"form","definition":"Hình, hình thể, hình dạng, hình dáng."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-16","title":"Bài 114","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"dress down","prompt":"Our office allows employees to _____ on Fridays.","choices":["dress down","drone on","drown in","shut down"],"componentWords":[{"term":"dress","definition":"Mặc (quần áo... ), ăn mặc."}]},{"term":"drone on","prompt":"The speaker continued to _____ during the conference, making it hard to stay focused.","choices":["drone on","drown in","dress down","divvy up"],"componentWords":[{"term":"drone","definition":"Kêu o o, kêu vo ve; kêu ò è (như tiếng kèn túi)."}]},{"term":"drown in","prompt":"Employees often _____ paperwork before the quarterly audit.","choices":["drown in","dress down","drone on","break into"],"componentWords":[{"term":"drown","definition":"Chết đuối."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-17","title":"Bài 115","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"fall apart","prompt":"The project plan began to _____ when the lead contractor withdrew.","choices":["fall apart","fill out","fasten down","recruitment process"],"componentWords":[]},{"term":"fasten down","prompt":"Please _____ the loose cables to prevent tripping hazards.","choices":["fasten down","fill out","fall apart","offer a package"],"componentWords":[{"term":"fasten","definition":"Buộc chặt, trói chặt."}]},{"term":"fill out","prompt":"Please _____ this form before you enter the meeting room.","choices":["fill out","fasten down","fall apart","cater for"],"componentWords":[{"term":"fill","definition":"Làm đầy, chứa đầy, đổ đầy; đắp đầy, rót đầy."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-18","title":"Bài 116","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"filter out","prompt":"The software is designed to _____ spam emails automatically.","choices":["filter out","finish up","flag up","count down"],"componentWords":[{"term":"filter","definition":"Lọc."}]},{"term":"finish up","prompt":"Let us _____ this report before we leave the office today.","choices":["finish up","filter out","flag up","update a policy"],"componentWords":[]},{"term":"flag up","prompt":"Please _____ any potential issues with the project timeline immediately.","choices":["flag up","filter out","finish up","pop out"],"componentWords":[{"term":"flag","definition":"Lát bằng đá phiến."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-19","title":"Bài 117","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"flare up","prompt":"Tensions tend to _____ when the deadline for the final report approaches.","choices":["flare up","flick through","flesh out","settle for"],"componentWords":[{"term":"flare","definition":"Sáng rực lên, loé sáng, cháy bùng lên."}]},{"term":"flesh out","prompt":"We need to _____ the business plan with more detailed financial projections.","choices":["flesh out","flick through","flare up","delay the delivery"],"componentWords":[{"term":"flesh","definition":"Kích thích (chó săn)."}]},{"term":"flick through","prompt":"I had a moment to _____ the report before the meeting started.","choices":["flick through","flare up","flesh out","provide a service"],"componentWords":[{"term":"flick","definition":"Đánh nhẹ, vụt nhẹ, gõ nhẹ, búng."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-20","title":"Bài 118","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"free up","prompt":"We need to automate these reports to _____ more time for the team to focus on clients.","choices":["free up","freeze up","frown on","maintain the premises"],"componentWords":[{"term":"free","definition":"Thả, phóng thích, giải phóng, trả tự do."}]},{"term":"freeze up","prompt":"My computer started to _____ right when I was saving the report.","choices":["freeze up","frown on","free up","include the tip"],"componentWords":[{"term":"freeze","definition":"Đóng băng."}]},{"term":"frown on","prompt":"The management tends to _____ personal calls during work hours.","choices":["frown on","free up","freeze up","main entree"],"componentWords":[{"term":"frown","definition":"Cau mày, nhăn mặt."}]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-21","title":"Bài 119","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"get to","prompt":"Let's _____ the main agenda items before the end of the meeting.","choices":["get to","give off","go about","skilled workforce"],"componentWords":[]},{"term":"give off","prompt":"This old printer starts to _____ a burning smell when used for too long.","choices":["give off","go about","get to","pick up on"],"componentWords":[]},{"term":"go about","prompt":"How should we _____ resolving the communication issues within the team?","choices":["go about","give off","get to","gloss over"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-22","title":"Bài 120","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"go around","prompt":"There are not enough copies of the report to _____ for every attendee.","choices":["go around","international conference","prepare the agenda","provide event brochures"],"componentWords":[]},{"term":"go off","prompt":"The alarm in the office will _____ if there is a fire.","choices":["go off","patch together","pencil in","pile up"],"componentWords":[]},{"term":"go on","prompt":"The alarm system will _____ automatically at 7 PM.","choices":["go on","stand around","start on","stay away"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-23","title":"Bài 121","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"grey out","prompt":"The submit button will _____ until all required fields are filled.","choices":["grey out","hand back","hack into","check over"],"componentWords":[{"term":"grey","definition":"Tô màu xám, quét màu xám."}]},{"term":"hack into","prompt":"Cybercriminals often attempt to _____ corporate databases.","choices":["hack into","hand back","grey out","upgrade the room"],"componentWords":[{"term":"hack","definition":"Đốn, đẽo, chém, chặt mạnh."}]},{"term":"hand back","prompt":"Please _____ the office keys to the reception before you leave.","choices":["hand back","grey out","hack into","dispense medication"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-24","title":"Bài 122","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"hang on","prompt":"Could you please _____ for a moment while I check the schedule?","choices":["hang on","head off","hear out","speak out"],"componentWords":[]},{"term":"head off","prompt":"The manager took action to _____ a potential conflict in the team.","choices":["head off","hear out","hang on","reject the delivery"],"componentWords":[{"term":"head","definition":"Làm đầu, làm chóp (cho một cái gì)."}]},{"term":"hear out","prompt":"Please _____ the employee before making a final decision regarding their resignation.","choices":["hear out","hang on","head off","send out"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-25","title":"Bài 123","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"hunker down","prompt":"We need to _____ and focus on meeting our deadlines this week.","choices":["hunker down","hunt out","hunt up","do with"],"componentWords":[{"term":"hunker","definition":"co mình; ẩn mình"}]},{"term":"hunt out","prompt":"I need to _____ the original contract from our filing cabinet.","choices":["hunt out","hunker down","wave off","book a package"],"componentWords":[{"term":"hunt","definition":"Săn bắn."}]},{"term":"hunt up","prompt":"I need to _____ some documents regarding our previous partnership.","choices":["hunt up","hunker down","straighten up","string together"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-26","title":"Bài 124","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"jump in","prompt":"Please feel free to _____ if you have any questions during the presentation.","choices":["jump in","keep away","keep back","result in"],"componentWords":[]},{"term":"keep away","prompt":"Please _____ from the restricted area while maintenance work is ongoing.","choices":["keep away","jump in","show enthusiasm","knuckle down"],"componentWords":[]},{"term":"keep back","prompt":"Staff must _____ from the loading dock during delivery hours.","choices":["keep back","jump in","talk out","talk up"],"componentWords":[]}]},{"id":"toeic-basic-collocations-v1-office-issues-lesson-27","title":"Bài 125","focus":"Thiết bị, cuộc họp, email, tài liệu, báo cáo và lịch làm việc.","topicId":"office-issues","topicTitle":"Văn phòng · Office Issues","questions":[{"term":"keep off","prompt":"Please _____ the grass while the