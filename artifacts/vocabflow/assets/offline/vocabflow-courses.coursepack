ions-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-travel-transportation-lesson-4"]},"senses":[{"definition":"đến sân ga","example":"We should arrive at the platform ten minutes before the scheduled time.","pos":"Phrase","subPos":null}]},{"term":"arrive at the station","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-travel-transportation-lesson-1"]},"senses":[{"definition":"Đến nhà ga","example":"Make sure to arrive at the station before the train leaves.","pos":"Phrase","subPos":null}]},{"term":"arrive at the terminal","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-travel-transportation-lesson-3"]},"senses":[{"definition":"đến nhà ga","example":"It takes an hour to arrive at the terminal by bus.","pos":"Phrase","subPos":null}]},{"term":"arrive at the venue","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-entertainment-events-lesson-4"]},"senses":[{"definition":"đến địa điểm","example":"Guests are expected to arrive at the venue at seven o'clock.","pos":"Phrase","subPos":null}]},{"term":"arrive on time","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-travel-transportation-lesson-4"]},"senses":[{"definition":"đến đúng giờ","example":"The train is expected to arrive on time despite the heavy rain.","pos":"Phrase","subPos":null}]},{"term":"arrow","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-2"]}},{"term":"artful","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-lesson-2"]}},{"term":"artfully","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-reading-lesson-1"]}},{"term":"article","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-media-reading-lesson-1"]}},{"term":"articulate","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-language-lesson-28"]}},{"term":"articulation","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-language-reading-lesson-1"]}},{"term":"artifact","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-history-lesson-1"]}},{"term":"artificial","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-technology-lesson-3"]}},{"term":"artificially","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-technology-lesson-3"]}},{"term":"artillery","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-government-reading-lesson-1"]}},{"term":"artisan","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-culture-lesson-17"]}},{"term":"artist","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-lesson-2"]}},{"term":"artistic","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-lesson-2"]}},{"term":"artless","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-lesson-2"]}},{"term":"arts","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-culture-lesson-2"]}},{"term":"As busy as a bee","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"as cool as a cucumber","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"As easy as ABC","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"As easy as pie","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"as far as","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-meaning"]},"senses":[{"definition":"Theo như, trong phạm vi mà thông tin hoặc hiểu biết cho phép; giới hạn nhận định đang nêu, không diễn tả điều kiện. Ghi chú: Trong as far as I know/can tell, cụm này giới hạn nhận định theo thông tin hoặc hiểu biết hiện có. Khác just as (“đúng lúc/đúng như”) và as long as (“miễn là”).","example":"As far as I can tell from the map, the footpath ends at the river.","pos":"conj","subPos":"subordinating"}]},{"term":"As genuine as a three-dollar bill","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"As happy as a clam","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"as if","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-meaning"]},"senses":[{"definition":"Như thể, như là; mô tả điều gì đó có vẻ đúng hoặc được hình dung như thật, nhưng không khẳng định tình huống ấy là sự thật. Ghi chú: Gần nghĩa với as though; thường thay được khi nói “như thể”. As if thông dụng hơn; cả hai mô tả vẻ ngoài hoặc tình huống được hình dung, không tự nêu điều kiện.","example":"The child spoke to the author as if they had known each other for years.","pos":"conj","subPos":"subordinating"}]},{"term":"as long as","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-time"]},"senses":[{"definition":"Miễn là; đặt điều kiện để việc ở mệnh đề chính được chấp nhận hoặc tiếp tục. Cụm này cũng có thể chỉ khoảng thời gian kéo dài. Ghi chú: Gần nghĩa với provided that khi nêu điều kiện; provided that thường trang trọng hoặc chính thức hơn. As long as còn có thể chỉ khoảng thời gian kéo dài.","example":"You may borrow my compass as long as you return it before sunset.","pos":"conj","subPos":"subordinating"}]},{"term":"as much as","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-conditions"]},"senses":[{"definition":"Dù ... đến đâu; ở đầu mệnh đề, cụm này nhượng bộ một điều (thường là điều người nói thực sự cảm thấy) trước khi nêu ý trái ngược. Ghi chú: Ở đầu mệnh đề, cụm này nhượng bộ, gần nghĩa với although (“mặc dù/dù ... đến đâu”). Trong cấu trúc chỉ số lượng, as much as lại có nghĩa “nhiều bằng”.","example":"As much as I like the idea, I cannot approve the budget without figures.","pos":"conj","subPos":"subordinating"}]},{"term":"As quiet as a mouse","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"As rare as hen’s teeth","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"As right as rain","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"as soon as","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-time"]},"senses":[{"definition":"Ngay khi; việc ở mệnh đề chính xảy ra ngay sau khi mốc được nêu ở mệnh đề sau. Ghi chú: Nhấn mạnh việc ở mệnh đề chính xảy ra ngay sau khi mốc vừa đến. Khác by the time (đến mốc thì việc khác đã xảy ra, hoàn tất hoặc đang kéo dài) và just as (hai việc cùng lúc hoặc gần như cùng lúc).","example":"Text me as soon as you see the plane's landing lights; do not wait for it to reach the gate.","pos":"conj","subPos":"subordinating"}]},{"term":"As the crow flies","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"as though","courseIds":["subordinating-conjunctions-v1"],"lessonIdsByCourse":{"subordinating-conjunctions-v1":["subordinating-conjunctions-v1-meaning"]},"senses":[{"definition":"Như thể, dường như; mô tả một ấn tượng hoặc tình huống được hình dung, chứ không xác nhận tình huống ấy là thật. Ghi chú: Gần nghĩa với as if; thường thay được khi nói “như thể”. As though đôi khi trang trọng hoặc thiên về văn viết hơn; cả hai mô tả vẻ ngoài hoặc tình huống được hình dung, không tự nêu điều kiện.","example":"The dog stared at the empty bowl as though it were still full.","pos":"conj","subPos":"subordinating"}]},{"term":"As white as a sheet/as white as a ghost","courseIds":["idioms-v1"],"lessonIdsByCourse":{"idioms-v1":["idioms-v1-lesson-006"]}},{"term":"ascend","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-geography-lesson-55"]}},{"term":"ascent","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-2"]}},{"term":"ascribe","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-psychology-lesson-42"]}},{"term":"ashlar","courseIds":["ielts-advanced-vocabulary-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-architecture-lesson-36"]}},{"term":"aside","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-general-reading-reading-lesson-2"]}},{"term":"ask","courseIds":["basic-vocabulary-a1-a2-v1"],"lessonIdsByCourse":{"basic-vocabulary-a1-a2-v1":["basic-vocabulary-a1-a2-v1-daily-actions-lesson-2"]}},{"term":"ask about","courseIds":["phrasal-verbs-v1","toeic-basic-collocations-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-034"],"toeic-basic-collocations-v1":["toeic-basic-collocations-v1-general-business-lesson-1"]}},{"term":"ask after","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-072"]}},{"term":"ask around","courseIds":["phrasal-verbs-v1","toeic-basic-collocations-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-034"],"toeic-basic-collocations-v1":["toeic-basic-collocations-v1-general-business-lesson-1"]}},{"term":"ask for","courseIds":["phrasal-verbs-v1","toeic-basic-collocations-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-089"],"toeic-basic-collocations-v1":["toeic-basic-collocations-v1-general-business-lesson-1"]}},{"term":"ask for a recommendation","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-dining-hospitality-lesson-1"]},"senses":[{"definition":"Hỏi về món ăn được gợi ý","example":"Guests often ask for a recommendation from the chef.","pos":"Phrase","subPos":null}]},{"term":"ask for the bill","courseIds":["toeic-advanced-collocations-v1"],"lessonIdsByCourse":{"toeic-advanced-collocations-v1":["toeic-advanced-collocations-v1-dining-hospitality-lesson-3"]},"senses":[{"definition":"yêu cầu thanh toán hóa đơn","example":"Once you have finished your dessert, you can ask for the bill.","pos":"Phrase","subPos":null}]},{"term":"ask in","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-007"]}},{"term":"ask out","courseIds":["ielts-advanced-vocabulary-v1","phrasal-verbs-v1"],"lessonIdsByCourse":{"ielts-advanced-vocabulary-v1":["ielts-advanced-vocabulary-v1-language-lesson-30"],"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-004"]}},{"term":"ask over","courseIds":["phrasal-verbs-v1"],"lessonIdsByCourse":{"phrasal-verbs-v1":["phrasal-verbs-v1-lesson-007"]}},{"term":"ask the panel","courseIds":["toeic-basic-collocations-v1"],"lessonIdsByCourse":{"toeic-basic-collocations-v1":["toeic-basic-collocations-v1-personnel-lesson-1"]},"senses":[{"definition":"hỏi hội đồng phỏng vấn","example":"Feel free to ask the panel about the company's culture.","pos":"Phrase","subPos":null}]},{"term":"asked","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-language-reading-lesson-1"]}},{"term":"asking","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-language-reading-lesson-1"]}},{"term":"asks","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-language-reading-lesson-1"]}},{"term":"aspect","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-academic-methods-reading-lesson-1"]}},{"term":"aspiration","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-psychology-reading-lesson-1"]}},{"term":"aspire","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-psychology-reading-lesson-1"]}},{"term":"assassinate","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-crime-reading-lesson-1"]}},{"term":"assemble","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-technology-reading-lesson-1"]}},{"term":"assembly","courseIds":["ielts-topic-vocabulary-v1"],"lessonIdsByCourse":{"ielts-topic-vocabulary-v1":["ielts-topic-vocabulary-v1-technology-reading-lesson-1"]}},{"term":"assert","courseIds":["ielts-topic-vocabulary-v1"],"less