e"]}],"chapterId":"people-society","chapterTitle":"Con người & xã hội","chapterNumber":1},{"id":"ielts-topic-vocabulary-v1-family-reading-lesson-1","title":"Reading · Bài 1","focus":"Nuôi dạy trẻ, quan hệ gia đình, tuổi tác và thay đổi thế hệ.","topicId":"family","topicTitle":"Gia đình và các thế hệ","questions":[{"term":"adolescent","prompt":"The _____ girl enjoys playing the piano.","choices":["adolescent","subjective","subtle","sympathetic"]},{"term":"adopt","prompt":"They decided to _____ a new strategy for the project.","choices":["adopt","unemployment","abandonment","action"]},{"term":"adoption","prompt":"Their _____ gave the child a loving home.","choices":["adoption","decimation","dinosaur","doomsday"]},{"term":"aged","prompt":"They _____ the cheese in a cool room.","choices":["aged","prevalent","priest","prince"]},{"term":"ageing","prompt":"_____ can change the color of the fabric.","choices":["ageing","imprecise","inaccurate","inconsistent"]},{"term":"baby","prompt":"I used to be a _____ but now I am an adult.","choices":["baby","controller","desktop","detector"]},{"term":"brother","prompt":"My _____ is taller than me by two inches.","choices":["brother","prove","questionable","random"]},{"term":"couple","prompt":"A _____ of girls are waiting for us.","choices":["couple","contrary","correctly","countless"]},{"term":"cousin","prompt":"The king greeted his _____ politely.","choices":["cousin","remnant","restoration","restorer"]},{"term":"cuddle","prompt":"The child wanted a warm _____ before bed.","choices":["cuddle","chef","chief","chore"]},{"term":"daughter","prompt":"Their _____ loves to read at night.","choices":["daughter","enterprise","estimate","excess"]},{"term":"descend","prompt":"The hill will _____ sharply after the bridge.","choices":["descend","parliament","parliamentary","senator"]},{"term":"foster","prompt":"Parents should _____ a child with love and care.","choices":["foster","capacity","catalyst","centimetre"]},{"term":"grandmother","prompt"