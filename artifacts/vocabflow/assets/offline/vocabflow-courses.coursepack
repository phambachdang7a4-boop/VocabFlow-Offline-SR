mpt":"The _____ refused any modern changes.","choices":["purist","clump","creature","cutin"]},{"term":"queen","prompt":"The _____ bee lives in the center of the hive.","choices":["queen","nineties","nobody","noise"]},{"term":"rapping","prompt":"He was _____ softly on the door.","choices":["rapping","neglect","neighbour","noble"]}],"chapterId":"culture-media","chapterTitle":"Văn hóa & truyền thông","chapterNumber":7},{"id":"ielts-topic-vocabulary-v1-culture-reading-lesson-8","title":"Reading · Bài 8","focus":"Nghệ thuật, âm nhạc, văn học, lễ hội và bản sắc văn hóa.","topicId":"culture","topicTitle":"Văn hóa và nghệ thuật","questions":[{"term":"realism","prompt":"The novel shows _____ in everyday life.","choices":["realism","supervision","supervisor","tactic"]},{"term":"realistic","prompt":"Her story felt _____ and honest.","choices":["realistic","spark","special","specially"]},{"term":"rehearse","prompt":"Please _____ your speech before class.","choices":["rehearse","benign","bite","blind"]},{"term":"renowned","prompt":"The city is _____ for its music.","choices":["renowned","undertake","undertaken","waitress"]},{"term":"repertoire","prompt":"Her _____ includes songs and dance.","choices":["repertoire","cancel","cast","catch"]},{"term":"retro","prompt":"She loves wearing _____ clothes from the sixties.","choices":["retro","contribution","controversy","cooperate"]},{"term":"revelation","prompt":"The letter was a shocking _____.","choices":["revelation","sprang","spray","spread"]},{"term":"rhyme","prompt":"The _____ made the poem easy to remember.","choices":["rhyme","imminent","impenetrable","imperfect"]},{"term":"rhythm","prompt":"Dance helps improve the _____ of your steps.","choices":["rhythm","ownership","payment","percent"]},{"term":"ritually","prompt":"She answered _____ and smiled.","choices":["ritually","omission","omit","outline"]},{"term":"romance","prompt":"He kept the _____ in a drawer.","choices":["romance","spectacular","spectacularly","spell"]},{"term":