rd.","choices":["push","splash","splendidly","split"]},{"term":"puts","prompt":"She _____ the keys on the table.","choices":["puts","string","strip","stuff"]}],"chapterId":"academic-reading","chapterTitle":"Đọc hiểu học thuật","chapterNumber":10},{"id":"ielts-topic-vocabulary-v1-general-reading-reading-lesson-33","title":"Reading · Bài 33","focus":"Từ vựng học thuật và các từ thường gặp trong bài đọc IELTS.","topicId":"general-reading","topicTitle":"Đọc hiểu tổng hợp","questions":[{"term":"quarter","prompt":"A _____ of a century passed very quickly.","choices":["quarter","unspectacular","unstuck","unsuitable"]},{"term":"quest","prompt":"They went on a _____ for the lost treasure.","choices":["quest","retiring","internal","jobless"]},{"term":"quick","prompt":"The insult stung him to the _____ today.","choices":["quick","retreat","reunion","reverence"]},{"term":"quickly","prompt":"Please close the door _____. You'll let the cat out.","choices":["quickly","chore","clerk","collaborate"]},{"term":"quiet","prompt":"This young person is very _____ now because she is reading a book.","choices":["quiet","conceivable","concentrate","confident"]},{"term":"quietly","prompt":"I read the note _____.","choices":["quietly","fibre","fibrous","filler"]},{"term":"rapid","prompt":"There was a _____ decline in his health.","choices":["rapid","consistent","contradictory","critical"]},{"term":"rapidly","prompt":"She answered _____ and smiled.","choices":["rapidly","gravel","gums","hair"]},{"term":"readily","prompt":"When I needed help carrying my bag of groceries, a young man came over _____ to help.","choices":["readily","sustainable","habitat","climate change"]},{"term":"ready","prompt":"Is dinner _____ for us to eat now?","choices":["ready","religion","belief","acted"]},{"term":"reassemble","prompt":"He had to _____ the broken watch carefully.","choices":["reassemble","conveyor","crew","crossing"]},{"term":"receive","prompt":"Did you _____ the news about the party?","choices":["receive","similar","similarity","simplicity"]},{"term":"recency","prompt":"The _____ of the event surprised everyone.","choices":["recency","musical","literary","traditional"]},{"term":"recommend","prompt":"can you _____ me a good English dictionary?","choices":["recommend","pronounce","punctuate","relate"]},{"term":"recommendation","prompt":"I wrote a letter of _____ for him.","choices":["recommendation","therein","thereof","thick"]},{"term":"reddish","prompt":"The fruit had a _____ skin.","choices":["reddish","plied","pluck","plummet"]},{"term":"regain","prompt":"He tried to _____ consciousness after the fall.","choices":["regain","localized","lying","meddle"]},{"term":"regard","prompt":"He has a high _____ for his teacher.","choices":["regard","guard","scheme","society"]},{"term":"regular","prompt":"She takes a _____ bus to work every morning.","choices":["regular","quietly","rapid","rapidly"]},{"term":"reintroduce","prompt":"We _____ the topic in next class.","choices":["reintroduce","rough","roughened","roughly"]},{"term":"reject","prompt":"The shop sold the _____ at a discount.","choices":["reject","wood","afternoon","date"]},{"term":"rejection","prompt":"The machine caused _____ of the faulty parts.","choices":["rejection","requirement","retention","role"]},{"term":"release","prompt":"The sudden _____ of prisoners surprised the town.","choices":["release","tern","tiger","toad"]},{"term":"relentless","prompt":"The team showed _____ effort to win the game.","choices":["relentless","importable","important","wealthy"]},{"term":"remarkable","prompt":"He made a _____ recovery after the illness.","choices":["remarkable","command","commission","committee"]}],"chapterId":"academic-reading","chapterTitle":"Đọc hiểu học thuật","chapterNumber":10},{"id":"ielts-topic-vocabulary-v1-general-reading-reading-lesson-34","title":"Reading · Bài 34","focus":"Từ vựng học thuật và các từ thường gặp trong bài đọc IELTS.","topicId":"general-reading","topicTitle":"Đọc hiểu tổng hợp","questio