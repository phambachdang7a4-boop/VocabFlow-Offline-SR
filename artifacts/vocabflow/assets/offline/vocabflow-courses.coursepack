ubborn","subjective"]},{"term":"flesh","prompt":"She started to put on _____ after the surgery.","choices":["flesh","tortuous","total","totally"]},{"term":"genus","prompt":"This _____ includes many common trees.","choices":["genus","stag","stall","stamp"]},{"term":"geneticist","prompt":"A _____ explained the family traits.","choices":["geneticist","embarrassment","emptiness","enthusiasm"]},{"term":"germ","prompt":"The scientist studied the _____ under a microscope.","choices":["germ","theorize","truthful","uncritical"]},{"term":"gill","prompt":"Jack and _____ are famous nursery rhyme characters.","choices":["gill","conjecture","consequence","consideration"]},{"term":"gland","prompt":"The lachrymal _____ helps produce tears when crying.","choices":["gland","unforeseen","unfortunately","unimpeded"]},{"term":"graft","prompt":"The gardener used _____ to join the two branches.","choices":["graft","sporting","athletic","competitive"]},{"term":"head","prompt":"He examined her from _____ to foot carefully.","choices":["head","continent","earthquake","geologist"]},{"term":"heart","prompt":"She held his hand close to her _____.","choices":["heart","style","suit","symbol"]}],"chapterId":"science-technology","chapterTitle":"Khoa học & công nghệ","chapterNumber":5},{"id":"ielts-topic-vocabulary-v1-biology-reading-lesson-4","title":"Reading · Bài 4","focus":"Tế bào, di truyền, tiến hóa, miễn dịch và sinh lý học.","topicId":"biology","topicTitle":"Sinh học","questions":[{"term":"heartbeat","prompt":"I could hear my _____ after the run.","choices":["heartbeat","culturally","artful","artless"]},{"term":"heel","prompt":"The horse lifted its _____ in the mud.","choices":["heel","deduction","delve","demonstration"]},{"term":"hormonal","prompt":"_____ changes can make her feel tired.","choices":["hormonal","appeal","assassinate","attack"]},{"term":"hormone","prompt":"This _____ helps the body grow.","choices":["hormone","killer","lawyer","offensive"]},{"term":"humor","prompt":"The docto