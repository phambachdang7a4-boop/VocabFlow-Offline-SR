ords":[{"term":"access","definition":"truy cập"},{"term":"employee","definition":"người làm, người làm công."},{"term":"perks","definition":"Ngẩng đầu lên, vểnh lên, vểnh mặt lên (tự đắc, hỗn xược... ) ((cũng) to-up)."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-4","title":"Bài 169","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"choose a pension scheme","prompt":"Employees can _____ that fits their retirement goals.","choices":["choose a pension scheme","request an aisle seat","board the aircraft","carry valid identification"],"componentWords":[{"term":"choose","definition":"Chọn, lựa chọn, kén chọn."},{"term":"pension","definition":"Lương hưu."},{"term":"scheme","definition":"Sự sắp xếp theo hệ thống, sự phối hợp."}]},{"term":"enroll in benefits","prompt":"New hires should _____ during their first week.","choices":["enroll in benefits","cancel a ship order","follow the delivery route","notify the logistics department"],"componentWords":[{"term":"enroll","definition":"Tuyển (quân... )."},{"term":"benefits","definition":"Lợi, lợi ích."}]},{"term":"offer dental insurance","prompt":"Our benefits include medical and _____ for family.","choices":["offer dental insurance","disclose financial information","examine financial audits","prepare a balance sheet"],"componentWords":[{"term":"offer","definition":"Đưa ra đề nghị."},{"term":"dental","definition":"(Thuộc) răng."},{"term":"insurance","definition":"Sự bảo hiểm."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-5","title":"Bài 170","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"offer professional development","prompt":"We _____ to all full-time staff members.","choices":["offer professional development","accept an offer","approve a new hire","annual financial statement"],"componentWords":[{"term":"development","definition":"Sự trình bày, sự bày tỏ, sự thuyết minh (vấn đề, luận điểm, ý kiến... )."}]},{"term":"accept an offer","prompt":"He decided to _____ from the logistics firm.","choices":["accept an offer","offer professional development","install an alarm","install central heating"],"componentWords":[]},{"term":"approve a new hire","prompt":"The finance department must _____ before the contract is sent.","choices":["approve a new hire","offer professional development","catch up with","build customer loyalty"],"componentWords":[{"term":"hire","definition":"Sự thuê; sự cho thuê."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-6","title":"Bài 171","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"expand the workforce","prompt":"The factory plans to _____ to meet rising demand.","choices":["expand the workforce","finalise a business plan","update the business plan","approve a proposal"],"componentWords":[{"term":"workforce","definition":"Lực lượng lao động."}]},{"term":"finalise hiring decisions","prompt":"The directors will meet tomorrow to _____.","choices":["finalise hiring decisions","implement a policy","pursue a goal","set long-term goals"],"componentWords":[{"term":"hiring","definition":"Sự thuê; sự cho thuê."},{"term":"decisions","definition":"Sự giải quyết (một vấn đề... ); sự phân xử, sự phán quyết (của toà án)."}]},{"term":"hire a new recruit","prompt":"The team decided to _____ to support the project.","choices":["hire a new recruit","order the daily specials","recommend a dish","recommend a signature dish"],"componentWords":[{"term":"recruit","definition":"Lính mới."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-7","title":"Bài 172","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"issue an offer letter","prompt":"HR will _____ to the chosen applicant by Friday.","choices":["issue an offer letter","obtain medical clearance","undergo routine examination","consult general practitioner"],"componentWords":[]},{"term":"join the workforce","prompt":"Many graduates are eager to _____ as soon as possible.","choices":["join the workforce","launch a corporate campaign","launch a product","target a niche segment"],"componentWords":[]},{"term":"onboard new recruits","prompt":"Our mentorship program helps to _____ smoothly.","choices":["onboard new recruits","achieve the sales quota","align corporate goals","allocate resources"],"componentWords":[{"term":"onboard","definition":"hướng dẫn người mới hòa nhập"},{"term":"recruits","definition":"Lính mới."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-8","title":"Bài 173","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"process recruitment paperwork","prompt":"The administrative assistant will _____ today.","choices":["process recruitment paperwork","answer interview questions","issue a detailed invoice","issue an invoice"],"componentWords":[{"term":"recruitment","definition":"Sự tuyển mộ (lính), sự lấy thêm, sự tuyển thêm (người vào một tổ chức... )."}]},{"term":"sign an employment agreement","prompt":"Please read carefully before you _____.","choices":["sign an employment agreement","answer interview questions","calculate the property tax","commercial real estate"],"componentWords":[]},{"term":"answer interview questions","prompt":"Practice your ability to _____ clearly and concisely.","choices":["answer interview questions","sign an employment agreement","process recruitment paperwork","accept a meal voucher"],"componentWords":[{"term":"interview","definition":"Sự gặp gỡ, sự gặp mặt; cuộc nói chuyện riêng."},{"term":"questions","definition":"Câu hỏi."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-9","title":"Bài 174","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"arrange an interview","prompt":"Could you _____ with the regional director?","choices":["arrange an interview","expand service offerings","guarantee a service","improve service delivery"],"componentWords":[{"term":"arrange","definition":"Sắp xếp, sắp đặt, sửa soạn."}]},{"term":"attend an interview","prompt":"Three candidates will _____ this afternoon.","choices":["attend an interview","hire a professional","offer a position","conduct an interview"],"componentWords":[]},{"term":"demonstrate relevant experience","prompt":"Candidates should _____ during the meeting.","choices":["demonstrate relevant experience","manage the equipment","order new equipment","replace the printer cartridge"],"componentWords":[{"term":"demonstrate","definition":"Chứng minh, giải thích."},{"term":"relevant","definition":"Thích đáng, thích hợp; xác đáng."},{"term":"experience","definition":"Kinh nghiệm."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-10","title":"Bài 175","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"evaluate a candidate","prompt":"We use a scoring system to _____ during interviews.","choices":["evaluate a candidate","renegotiate vendor contracts","secure long-term contracts","settle an account"],"componentWords":[{"term":"candidate","definition":"Người ứng cử."}]},{"term":"evaluate communication skills","prompt":"We focus heavily on how candidates _____ during the interview.","choices":["evaluate communication skills","achieve the sales quota","align corporate goals","allocate resources"],"componentWords":[{"term":"communication","definition":"Sự truyền đạt, sự thông tri, sự thông tin; tin tức truyền đạt"},{"term":"skills","definition":"Sự khéo léo, sự khéo tay, sự tinh xảo; kỹ năng, kỹ xảo."}]},{"term":"hold an interview","prompt":"We will _____ in the conference room at 2 PM.","choices":["hold an interview","update an audit trail","update the audit trail","verify accounting entries"],"componentWords":[{"term":"hold","definition":"Cầm, nắm, giữ, nắm giữ, giữ vững."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-11","title":"Bài 176","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"interview a candidate","prompt":"The director will _____ for the vacancy tomorrow.","choices":["interview a candidate","authorise a purchase","obtain a quotation","prepare a quotation"],"componentWords":[]},{"term":"interview an applicant","prompt":"We plan to _____ on Tuesday morning.","choices":["interview an applicant","issue an offer letter","join the workforce","onboard new recruits"],"componentWords":[{"term":"applicant","definition":"Người xin việc; người thỉnh cầu."}]},{"term":"schedule an evaluation session","prompt":"The HR team will _____ for all shortlisted candidates.","choices":["schedule an evaluation session","transfer to an extension","walk in on","confirm the work schedule"],"componentWords":[{"term":"evaluation","definition":"Sự ước lượng."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-12","title":"Bài 177","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"calculate overtime pay","prompt":"Payroll needs to _____ accurately this month.","choices":["calculate overtime pay","cancel an appointment","confirm the invitation","extend a deadline"],"componentWords":[{"term":"overtime","definition":"Quá giờ, ngoài giờ (quy định)."},{"term":"pay","definition":"Trả (tiền lương... ); nộp, thanh toán."}]},{"term":"deduct an amount","prompt":"They will _____ for taxes from your monthly paycheck.","choices":["deduct an amount","forecast annual expenditure","revise the business plan","write a feasibility report"],"componentWords":[{"term":"deduct","definition":"Lấy đi, khấu đi, trừ đi."},{"term":"amount","definition":"Số lượng, số nhiều."}]},{"term":"deduct social security","prompt":"The system will automatically _____ from your monthly income.","choices":["deduct social security","identify market risks","assess potential liabilities","manage risk exposure"],"componentWords":[{"term":"social","definition":"Có tính chất xã hội, có tính chất thành viên của một tập thể, sống thành xã hội."},{"term":"security","definition":"an ninh, an toàn"}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-13","title":"Bài 178","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"distribute pay slips","prompt":"The manager will _____ at the end of the work day.","choices":["distribute pay slips","formulate growth strategies","leverage competitive advantage","maintain competitive edge"],"componentWords":[{"term":"slips","definition":"Sự trượt chân."}]},{"term":"handle payment discrepancies","prompt":"Payroll officers are trained to _____ immediately.","choices":["handle payment discrepancies","serve a buffet breakfast","accommodate a large group","accommodate the guests"],"componentWords":[{"term":"discrepancies","definition":"Sự khác nhau, sự không nhất quán, sự không thống nhất, sự trái ngược nhau (của một câu chuyện... )."}]},{"term":"issue a paycheck","prompt":"Finance will _____ to every worker at the end of the day.","choices":["issue a paycheck","delay a scheduled delivery","reject a flawed delivery","update delivery schedules"],"componentWords":[{"term":"paycheck","definition":"phiếu lương; tiền lương"}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-14","title":"Bài 179","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"manage the payroll","prompt":"The accounting team will _____ for all branches.","choices":["manage the payroll","provide catering on board","wait at the gate","check hotel availability"],"componentWords":[{"term":"payroll","definition":"Bảng lương."}]},{"term":"prepare a payroll","prompt":"The HR department will _____ for the temporary staff.","choices":["prepare a payroll","address a client inquiry","address a complaint","handle a public relations"],"componentWords":[]},{"term":"prepare payroll reports","prompt":"The finance team must _____ for the tax authority.","choices":["prepare payroll reports","print a paper receipt","confirm a hotel booking","finalize the details"],"componentWords":[{"term":"reports","definition":"Bản báo cáo; biên bản."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-15","title":"Bài 180","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"process a salary","prompt":"The system will automatically _____ payment on Friday.","choices":["process a salary","conduct an evaluation","manage an employee","submit a price estimate"],"componentWords":[{"term":"salary","definition":"Tiền lương."}]},{"term":"conduct an evaluation","prompt":"It is standard practice to _____ every six months.","choices":["conduct an evaluation","process a salary","answer interview questions","arrange an interview"],"componentWords":[]},{"term":"manage an employee","prompt":"The new supervisor will _____ in the warehouse.","choices":["manage an employee","process a salary","fax a copy","order office stationery"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-16","title":"Bài 181","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"set a performance target","prompt":"Employees will _____ with their manager.","choices":["set a performance target","adjust working hours","assign a project","repair a water leak"],"componentWords":[]},{"term":"adjust working hours","prompt":"You may request to _____ due to personal reasons.","choices":["adjust working hours","set a performance target","increase the investment budget","liquidate an investment"],"componentWords":[{"term":"working","definition":"Sự làm việc; việc, công việc, công tác."},{"term":"hours","definition":"Giờ, tiếng (đồng hồ)."}]},{"term":"assign a project","prompt":"The supervisor will _____ to the new intern next week.","choices":["assign a project","set a performance target","verify the figures","edit the slides"],"componentWords":[{"term":"assign","definition":"Phân (việc... ), phân công."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-17","title":"Bài 182","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"follow company protocol","prompt":"All applicants must _____ during the selection process.","choices":["follow company protocol","announce a promotion","reserve the equipment","test the equipment"],"componentWords":[{"term":"protocol","definition":"Nghi thức ngoại giao, lễ tân."}]},{"term":"notify the staff","prompt":"Management will _____ about the holiday schedule today.","choices":["notify the staff","announce a promotion","miss out on","avoid a deadlock"],"componentWords":[{"term":"notify","definition":"Báo, khai báo; thông báo, cho hay, cho biết."}]},{"term":"announce a promotion","prompt":"The director will _____ at the monthly assembly.","choices":["announce a promotion","follow company protocol","notify the staff","quote a competitive price"],"componentWords":[{"term":"promotion","definition":"Sự thăng chức, sự thăng cấp, sự đề bạt; sự cho lên lớp."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-18","title":"Bài 183","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"discuss career prospects","prompt":"We will _____ during your annual appraisal.","choices":["discuss career prospects","confirm a hotel booking","finalize the details","hire catering staff"],"componentWords":[{"term":"discuss","definition":"Thảo luận, bàn cãi, tranh luận (một vấn đề gì); nói đến (ai)."},{"term":"career","definition":"Nghề, nghề nghiệp."}]},{"term":"discuss promotion criteria","prompt":"The manager sat down to _____ with the staff.","choices":["discuss promotion criteria","edit the draft","archive the files","file the paperwork"],"componentWords":[{"term":"criteria","definition":"Tiêu chuẩn, chỉ tiêu."}]},{"term":"grant a promotion","prompt":"The board decided to _____ to the manager.","choices":["grant a promotion","resend a calendar invite","send a calendar invite","update the calendar invite"],"componentWords":[{"term":"grant","definition":"Sự cho, sự ban cho, sự cấp cho."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-19","title":"Bài 184","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"identify internal candidates","prompt":"We should _____ before posting the vacancy publicly.","choices":["identify internal candidates","order new equipment","replace the printer cartridge","restart the server"],"componentWords":[{"term":"candidates","definition":"Người ứng cử."}]},{"term":"promote a member","prompt":"The director intends to _____ of the sales team.","choices":["promote a member","examine liquid assets","monitor the asset value","monitored asset values"],"componentWords":[{"term":"member","definition":"Chân, tay, chi."}]},{"term":"promote internal talent","prompt":"It is our policy to _____ whenever possible.","choices":["promote internal talent","present sponsorship awards","renew sponsorship deals","secure a corporate sponsor"],"componentWords":[{"term":"talent","definition":"Tài, tài ba, tài năng, tài cán."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-20","title":"Bài 185","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"recognise career milestones","prompt":"It is important to _____ for long-term employees.","choices":["recognise career milestones","prepare the speaker bios","process attendee registration","register for the seminar"],"componentWords":[{"term":"recognise","definition":"Công nhận, thừa nhận, chấp nhận."},{"term":"milestones","definition":"Cột kilômét cọc."}]},{"term":"seek a promotion","prompt":"Many employees work hard when they _____.","choices":["seek a promotion","submit a business proposal","assess a business strategy","develop a marketing strategy"],"componentWords":[{"term":"seek","definition":"Tìm, đi tìm, tìm kiếm, cố tìm cho được."}]},{"term":"support staff development","prompt":"The company aims to _____ through mentorship.","choices":["support staff development","manage the inventory","prepare the ingredients","apply a service charge"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-21","title":"Bài 186","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"announce a vacancy","prompt":"We will _____ in the marketing department tomorrow.","choices":["announce a vacancy","weigh in on","zero in on","check the mail"],"componentWords":[{"term":"vacancy","definition":"Tình trạng trống rỗng."}]},{"term":"assess a candidate","prompt":"The manager will _____ based on their past work experience.","choices":["assess a candidate","get on with","hammer away at","hit it off"],"componentWords":[]},{"term":"assess candidate qualifications","prompt":"We need to carefully _____ for this senior role.","choices":["assess candidate qualifications","adjust working hours","assign a project","follow company protocol"],"componentWords":[{"term":"qualifications","definition":"Sự cho là; sự gọi là; sự định tính chất, sự định phẩm chất."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-22","title":"Bài 187","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"check the references","prompt":"We always _____ before finalising a hiring decision.","choices":["check the references","pay a baggage fee","pay a luggage surcharge","pre-book a seat"],"componentWords":[{"term":"references","definition":"Sự chuyển đến (một người, một tổ chức có thẩm quyền) để xem xét, sự giao cho giải quyết (một vấn đề gì); thẩm quyền giải quyết."}]},{"term":"conduct a phone screening","prompt":"Recruiters will _____ before scheduling in-person interviews.","choices":["conduct a phone screening","print a boarding pass","submit a customs declaration","apply for a travel permit"],"componentWords":[{"term":"phone","definition":"Điện thoại, máy điện thoại, dây nói, phôn."},{"term":"screening","definition":"Bình phong, màn che."}]},{"term":"extend a job offer","prompt":"The manager decided to _____ to the most qualified candidate.","choices":["extend a job offer","cancel an appointment","confirm the invitation","extend a deadline"],"componentWords":[{"term":"job","definition":"việc, việc làm, công việc; việc làm thuê, việc làm khoán."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-23","title":"Bài 188","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"manage the recruitment pipeline","prompt":"The HR department uses software to _____ effectively.","choices":["manage the recruitment pipeline","implement a contingency plan","manage an asset liability","mitigate potential risks"],"componentWords":[{"term":"pipeline","definition":"Ống dẫn dầu."}]},{"term":"recruit new graduates","prompt":"Many firms prefer to _____ for entry-level positions.","choices":["recruit new graduates","cover medical costs","cover medical fees","enroll in a plan"],"componentWords":[{"term":"graduates","definition":"Grad."}]},{"term":"shortlist an applicant","prompt":"The panel decided to _____ who meets all the requirements.","choices":["shortlist an applicant","issue medical certificate","schedule follow-up visit","access patient portal"],"componentWords":[{"term":"shortlist","definition":"danh sách rút gọn"}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-24","title":"Bài 189","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"verify a reference","prompt":"We always _____ before making a formal job offer.","choices":["verify a reference","accept a voluntary resignation","notify of food allergies","provide a dietary substitute"],"componentWords":[]},{"term":"verify an applicant's background","prompt":"It is standard procedure to _____ before hiring.","choices":["verify an applicant's background","accept a voluntary resignation","calculate travel expenses","pay a transit fee"],"componentWords":[{"term":"background","definition":"Phía sau."}]},{"term":"accept a voluntary resignation","prompt":"The board decided to _____ from the director.","choices":["accept a voluntary resignation","verify an applicant's background","verify a reference","minimise risk assessment"],"componentWords":[{"term":"voluntary","definition":"Tự ý, tự nguyện, tự giác."},{"term":"resignation","definition":"Sự từ chức; đơn xin từ chức."}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-25","title":"Bài 190","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"complete an exit interview","prompt":"HR will ask every employee to _____.","choices":["complete an exit interview","run a restaurant","clear the dishes","clear the restaurant table"],"componentWords":[{"term":"exit","definition":"Sự đi vào (của diễn viên)."}]},{"term":"confirm the notice period","prompt":"Before you quit, please _____ as stated in your contract.","choices":["confirm the notice period","coordinate departmental activities","expand production capacity","improve inventory turnover"],"componentWords":[{"term":"period","definition":"Kỷ, kỳ, thời kỳ, giai đoạn, thời gian."}]},{"term":"hand over responsibilities","prompt":"Please _____ to your successor before you depart.","choices":["hand over responsibilities","approve the meeting minutes","write the meeting minutes","monitor the progress"],"componentWords":[{"term":"hand","definition":"Đưa, trao tay, chuyển giao; truyền cho."},{"term":"responsibilities","definition":"trách nhiệm"}]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-26","title":"Bài 191","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"process final settlement","prompt":"The finance department will _____ for the departing staff member.","choices":["process final settlement","adjust annual compensation","adjust the salary","archive the files"],"componentWords":[{"term":"final","definition":"Cuối cùng."}]},{"term":"adjust annual compensation","prompt":"Inflation has forced us to _____ for the entire staff.","choices":["adjust annual compensation","process final settlement","arrange a training","assess skill levels"],"componentWords":[{"term":"compensation","definition":"Sự đền bù, sự bồi thường (thiệt hại); vật đền bù, vật bồi thường."}]},{"term":"adjust the salary","prompt":"The company decided to _____ based on annual reviews.","choices":["adjust the salary","process final settlement","introduce a new service","assess financial exposure"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-27","title":"Bài 192","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"calculate a fair wage","prompt":"We strive to _____ for every role in the firm.","choices":["calculate a fair wage","handle a public relations","increase customer retention","maintain a client database"],"componentWords":[{"term":"fair","definition":"Hội chợ, chợ phiên."},{"term":"wage","definition":"Tiền lương, tiền công."}]},{"term":"issue a bonus","prompt":"The management will _____ to high-performing staff this year.","choices":["issue a bonus","hit it off with","hone in on","link up with"],"componentWords":[{"term":"bonus","definition":"Tiền thưởng."}]},{"term":"negotiate a wage","prompt":"Employees have the right to _____ during the hiring process.","choices":["negotiate a wage","scan a photograph","update the software","upgrade the hardware"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personnel-lesson-28","title":"Bài 193","focus":"Tuyển dụng, phỏng vấn, lương thưởng, quyền lợi và đào tạo.","topicId":"personnel","topicTitle":"Nhân sự · Personnel","questions":[{"term":"offer a signing bonus","prompt":"We decided to _____ to attract top talent.","choices":["offer a signing bonus","discontinue an obsolete product","diversify product offerings","update a product catalogue"],"componentWords":[{"term":"signing","definition":"Dấu, dấu hiệu, ký hiệu; mật hiệu."}]},{"term":"receive a pay rise","prompt":"He was delighted to _____ this year.","choices":["receive a pay rise","execute strategic initiatives","formulate business strategy","formulate growth strategies"],"componentWords":[{"term":"receive","definition":"Nhận, lĩnh, thu."},{"term":"rise","definition":"Sự lên, sự đưa lên, sự kéo lên, sự dâng; lên, sự tăng lên."}]},{"term":"request a pay rise","prompt":"It is standard to _____ during a performance review.","choices":["request a pay rise","update service terms","upsell premium services","shy away from"],"componentWords":[]}]},{"id":"toeic-advanced-collocations-v1-personn