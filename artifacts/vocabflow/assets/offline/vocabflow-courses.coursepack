Words":[]}]},{"id":"toeic-basic-collocations-v1-dining-hospitality-lesson-6","title":"Bài 367","focus":"Nhà hàng, thực đơn, phục vụ, đặt bàn, khách và lưu trú.","topicId":"dining-hospitality","topicTitle":"Ăn uống và dịch vụ lưu trú · Dining & Hospitality","questions":[{"term":"manage the buffet","prompt":"Staff must _____ to ensure all food trays remain replenished throughout the service.","choices":["manage the buffet","request a bid","sign a bid","win a bid"],"componentWords":[{"term":"manage","definition":"Quản lý, trông nom."},{"term":"buffet","definition":"Quán giải khát (ở ga)."}]},{"term":"order a platter","prompt":"The guests decided to _____ of appetizers for the table.","choices":["order a platter","return the items","track the order","verify an order"],"componentWords":[{"term":"platter","definition":", (từ Mỹ, nghĩa Mỹ) đĩa gỗ (đựng thức ăn)."}]},{"term":"organise event catering","prompt":"We need to _____ for the upcoming summit.","choices":["organise event catering","cancel the agreement","extend the contract","adjust delivery schedule"],"componentWords":[{"term":"event","definition":"Sự việc, sự kiện."},{"term":"catering","definition":"Cung cấp thực phẩm, lương thực."}]}]},{"id":"toeic-basic-collocations-v1-dining-hospitality-lesson-7","title":"Bài 368","focus":"Nhà hàng, thực đơn, phục vụ, đặt bàn, khách và lưu trú.","topicId":"dining-hospitality","topicTitle":"Ăn uống và dịch vụ lưu trú · Dining & Hospitality","questions":[{"term":"prepare a kitchen","prompt":"The staff must _____ for the upcoming catering event.","choices":["prepare a kitchen","gain media coverage","invite the media","manage media coverage"],"componentWords":[{"term":"kitchen","definition":"Phòng bếp, nhà bếp."}]},{"term":"prepare a picnic","prompt":"The hotel offers to _____ for guests planning a day at the beach.","choices":["prepare a picnic","work overtime","pass over","check attendance"],"componentWords":[{"term":"picnic","definition":"Cuộc đi chơi và ăn ngoài trời."}]},{"ter