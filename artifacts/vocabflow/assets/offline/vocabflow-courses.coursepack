ư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"approve tax exemption","prompt":"The authority might _____ for this charitable donation.","choices":["approve tax exemption","clear the table","offer a local dish","accommodate the crowd"],"componentWords":[]},{"term":"approve the tax exemption","prompt":"The government did not _____ for this particular sector.","choices":["approve the tax exemption","expand brand awareness","improve brand awareness","buff up on"],"componentWords":[]},{"term":"calculate tax withholdings","prompt":"The payroll department needs to _____ for every employee correctly.","choices":["calculate tax withholdings","undergo routine examination","consult general practitioner","discharge a patient"],"componentWords":[{"term":"withholdings","definition":"Sự từ chối không làm; sự từ chối không cho."}]}]},{"id":"toeic-advanced-collocations-v1-finance-accounting-lesson-54","title":"Bài 262","focus":"Ngân sách, hóa đơn, thanh toán, kế toán, thuế và đầu tư.","topicId":"finance-accounting","topicTitle":"Tài chính và kế toán · Finance & Accounting","questions":[{"term":"claim a tax deduction","prompt":"You may _____ for your business-related travel expenses.","choices":["claim a tax deduction","post a staff notice","read the staff notice","talk down to"],"componentWords":[{"term":"deduction","definition":"Sự lấy đi, sự khấu đi, sự trừ đi."}]},{"term":"claim capital allowance","prompt":"We can _____ on the new equipment purchases this year.","choices":["claim capital allowance","confirm an invitation","finalize an agenda","join a session"],"componentWords":[{"term":"allowance","definition":"Sự cho phép."}]},{"term":"claim the capital allowance","prompt":"Businesses often _____ for machinery purchases.","choices":["claim the capital allowance","calculate risk coefficients","identify systemic operational risks","mitigate operational threats"],"componentWords":[]}]},{"id":"toeic-advanced-collo